  "scr_get_completed_file_name_slash_scr_get_completed_file_name_gml_9_0": "自分の部屋",
  "scr_get_completed_file_name_slash_scr_get_completed_file_name_gml_12_0": "クリスの家",
  "scr_get_completed_file_name_slash_scr_get_completed_file_name_gml_18_0": "~1 [Chapter ~2 END]",
  "obj_b3bs_jail2_slash_Step_0_gml_19_0": "＊ Listen to my suilver tale./%",
  "obj_ribbick_enemy_slash_Other_11_gml_3_0": "ふきとばす",
  "obj_ribbick_enemy_slash_Other_11_gml_6_0": "ふきとばす(全員)",
  "obj_ribbick_enemy_slash_Step_0_gml_177_0": "＊ ラビックは　下に　たまるのに\n　 ちょうどよさそうな\n　 ソファを探している。",
  "obj_ribbick_enemy_slash_Step_0_gml_178_0": "＊ ほこりっぽいカラシの　ニオイが\n　 充満している。",
  "obj_ribbick_enemy_slash_Step_0_gml_179_0": "＊ ラビックは\n　 あたりの土壌に　ダメージを与えた。",
  "obj_ribbick_enemy_slash_Step_0_gml_180_0": "＊ ラビックは\n　 カビくさい　うなり声を発した。",
  "obj_ribbick_enemy_slash_Step_0_gml_182_0": "＊ ラビックは\n　 存在が薄くなってきた。",
  "obj_ribbick_enemy_slash_Step_0_gml_183_0": "＊ ラビックは　すっかりきれいになった。",
  "obj_ribbick_enemy_slash_Step_0_gml_213_0": "＊ ラビック - ATK 8 DEF 1\n＊ わたぼこりの　かたまり。\n　 大そうじをすると出現。/%",
  "obj_watercooler_enemy_slash_Step_0_gml_313_0": "＊ スージィは　顔面でコップをつぶした！",
  "obj_watercooler_enemy_slash_Step_0_gml_314_0": "＊ スージィは　コップをラルセイにのせた！",
  "obj_watercooler_enemy_slash_Step_0_gml_315_0": "＊ スージィはコップをクリスの目にのせた！",
  "obj_watercooler_enemy_slash_Step_0_gml_341_0": "＊ ラルセイは微量のカルシウムを吸収した！",
  "obj_watercooler_enemy_slash_Step_0_gml_342_0": "＊ ラルセイは　スージィの水をふいた！",
  "obj_watercooler_enemy_slash_Step_0_gml_343_0": "＊ ラルセイは　コップに名前を書いた！",
  "obj_balthizard_enemy_slash_Step_0_gml_38_0": "フム なにを\nやっとるんじゃね？/%",
  "obj_balthizard_enemy_slash_Step_0_gml_53_0": "ちょ…！\nバトル中だ！\nどいてろよ！！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_72_0": "なるほど なるほど\n元気がよくて\nよろしい！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_183_0": "…オレのぶん\n残ってねーの？",
  "obj_balthizard_enemy_slash_Step_0_gml_195_0": "ゆっくりしよう",
  "obj_balthizard_enemy_slash_Step_0_gml_196_0": "のんびりいこう",
  "obj_balthizard_enemy_slash_Step_0_gml_197_0": "追憶の記憶",
  "obj_balthizard_enemy_slash_Step_0_gml_198_0": "のんびり\nリラックス",
  "obj_balthizard_enemy_slash_Step_0_gml_199_0": "コリが\nほぐれた",
  "obj_balthizard_enemy_slash_Step_0_gml_206_0": "尻に火を\nつけよう！",
  "obj_balthizard_enemy_slash_Step_0_gml_207_0": "鉄は\n熱いうちに\n打て！",
  "obj_balthizard_enemy_slash_Step_0_gml_208_0": "燃え上がれ！\n燃え上がれ！\n燃え上がれ！",
  "obj_balthizard_enemy_slash_Step_0_gml_209_0": "おお！\n目が\n覚めた！",
  "obj_balthizard_enemy_slash_Step_0_gml_210_0": "アツアツだ！\nホッホー！",
  "obj_balthizard_enemy_slash_Step_0_gml_233_0": "ない",
  "obj_balthizard_enemy_slash_Step_0_gml_288_0": "＊ バルタザードは　のしのし　歩んだ。",
  "obj_balthizard_enemy_slash_Step_0_gml_289_0": "＊ バルタザードは\n　 甘ったるいノスタルジーの\n　 煙を立ち上らせた。",
  "obj_balthizard_enemy_slash_Step_0_gml_290_0": "＊ バルタザードは　温められた木材から\n　 立ち上る　陽光の霧を　吐き出した。",
  "obj_balthizard_enemy_slash_Step_0_gml_291_0": "＊ バルタザードは\n　 雨に濡れた草の香りを　振りまいた。",
  "obj_balthizard_enemy_slash_Step_0_gml_292_0": "＊ バルタザードは　金色の髪を乗せた\n　 古い枕のような香りを　吐き出した。",
  "obj_balthizard_enemy_slash_Step_0_gml_297_0": "＊ バルタザードは\n　 無臭の息を吐き出した。",
  "obj_balthizard_enemy_slash_Step_0_gml_302_0": "＊ バルタザードは　笑い声とともに\n　 ハート型の煙を吐き出した。",
  "obj_balthizard_enemy_slash_Step_0_gml_307_0": "＊ バルタザードは\n　 キャンドルとカモミールの香りを\n　 立ち上らせた。",
  "obj_balthizard_enemy_slash_Step_0_gml_312_0": "＊ バルタザードは　タコスの香りを\n　 ただよわせて　ワクワクに\n　 燃え盛った。",
  "obj_balthizard_enemy_slash_Step_0_gml_336_0": "＊ バルタザードは　くたびれた！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_342_0": "＊ バルタザード -\n　 いにしえのアロマンサー。\n　 かぐわしい香りで侵入者を罰する。/%",
  "obj_balthizard_enemy_slash_Step_0_gml_349_0": "＊ 右と左を　すばやく押して　揺らせ！",
  "obj_balthizard_enemy_slash_Step_0_gml_490_0": "＊ 右と左を　すばやく押して　揺らせ！",
  "obj_balthizard_enemy_slash_Step_0_gml_499_0": "＊ ラルセイは　点火した！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_556_0": "＊ 部屋が煙たくなった！",
  "obj_balthizard_enemy_slash_Step_0_gml_557_0": "＊ 他の敵たちは　くたびれた！",
  "obj_balthizard_enemy_slash_Step_0_gml_580_0": "＊ じいさんを　使った。/%",
  "obj_balthizard_enemy_slash_Step_0_gml_640_0": "どうじゃね？\n勝っとるかね？/%",
  "obj_balthizard_enemy_slash_Step_0_gml_679_0": "バトルをして\n腹が へったじゃろう\nアメちゃん いるかね？/%",
  "obj_balthizard_enemy_slash_Step_0_gml_691_0": "＊ じいさんを　呼んだ！\n　 しかし　なにも起こらなかった！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_707_0": "だッからッ！\nいま バトル中！\n話しかけんなって！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_723_0": "ちょうど これから…\nあー…クソッ！\nなにするか忘れただろ！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_738_0": "＊ (スージィは　なにをしようと\n　 していたか　忘れた！　スージィの\n　 アクションは　キャンセルされた)/%",
  "obj_balthizard_enemy_slash_Step_0_gml_762_0": "あのコらは\nまだ慣れとらん\n手加減してやっとくれ/%",
  "obj_balthizard_enemy_slash_Step_0_gml_783_0": "＊ (敵のこうげき力が　下がった！)/%",
  "obj_balthizard_enemy_slash_Step_0_gml_829_0": "うぉ マジか\nやったぜ…/%",
  "obj_balthizard_enemy_slash_Step_0_gml_845_0": "…って！ アホか！\nいまは そんな場合じゃねえ！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_861_0": "そりゃ残念！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_914_0": "＊ スージィ以外の全員が\n　 アメちゃんを　もらった！/%",
  "obj_balthizard_enemy_slash_Step_0_gml_959_0": "＊ スージィは　バルタザードを揺らした！",
  "obj_balthizard_enemy_slash_Step_0_gml_979_0": "＊ ラルセイは　バルタザードを揺らした！",
  "obj_baseenemy_slash_Step_0_gml_114_0_b": "* Damaged message ~1.",
  "obj_battlecontroller_slash_Draw_0_gml_264_0": "？？？",
  "obj_battlecontroller_slash_Step_0_gml_101_0": "* You won^1!&* Got ~1 EXP and ~2 D$.&* Susie's heal power increased!/%",
  "obj_bell_enemy_slash_Step_0_gml_27_0": "ディン…ドン…\nトラベル\nしらベル\nくらベル\nあそベル",
  "obj_bell_enemy_slash_Step_0_gml_28_0": "カラン…コロン…\nノベルティー\nシャベルカー\nたベルかー",
  "obj_bell_enemy_slash_Step_0_gml_29_0": "ベルベルばあ！",
  "obj_bell_enemy_slash_Step_0_gml_30_0": "チリン…チロン…\nベルワリー\nベルドッグ\nベルドーザー",
  "obj_bell_enemy_slash_Step_0_gml_31_0": "空も　飛ベルはず　",
  "obj_bell_enemy_slash_Step_0_gml_114_0": "＊ ウィカベルは　呪いの呪いを鳴らした。",
  "obj_bell_enemy_slash_Step_0_gml_115_0": "＊ ウィカベルは　けたたましく呪った。",
  "obj_bell_enemy_slash_Step_0_gml_116_0": "＊ ウィカベルは\n　 オルゴールのバレリーナのように回った。",
  "obj_bell_enemy_slash_Step_0_gml_117_0": "＊ ウィカベルは　クラシック音楽を放った。",
  "obj_bell_enemy_slash_Step_0_gml_118_0": "＊ しめった木とサビのニオイがする。",
  "obj_bell_enemy_slash_Step_0_gml_123_0": "＊ ウィカベルは\n　 ノロノロと　呪いの調べを　鳴らした。",
  "obj_bell_enemy_slash_Step_0_gml_128_0": "＊ ウィカベルは　おだやかに演奏した。",
  "obj_bell_enemy_slash_Step_0_gml_133_0": "＊ ウィカベルは　眠りの呪文を　鳴らした。",
  "obj_bell_enemy_slash_Step_0_gml_155_0": "＊ ウィカベル -\n　 メタルメイジ。チューニングが\n　 狂っていると　なにをするかわからない。/%",
  "obj_bell_enemy_slash_Step_0_gml_165_0": "＊ ぴったりのタイミングで\n　 ボタンを押せ！",
  "obj_bell_enemy_slash_Step_0_gml_170_0": "\n＊ すべての　音楽系の「こうどう」が\n　 強力になった！/%",
  "obj_bell_enemy_slash_Step_0_gml_172_0": "＊ チューニングは　バッチリだ！~1",
  "obj_bell_enemy_slash_Step_0_gml_173_0": "＊ チューニングが　少しずれた！~1",
  "obj_bell_enemy_slash_Step_0_gml_186_0": "* Press button with the right timing!",
  "obj_bell_enemy_slash_Step_0_gml_192_0": "＊ スージィは　ハンマーでたたいた！/%",
  "obj_bell_enemy_slash_Step_0_gml_201_0": "＊ ラルセイは　ベルをトントンした！/%",
  "obj_bell_enemy_tuning_box_slash_Draw_0_gml_10_0": "ヒット！",
  "obj_bibliox_enemy_slash_Step_0_gml_33_0": "Mumble,&mumble…",
  "obj_bibliox_enemy_slash_Step_0_gml_34_0": "ト　ビー\nオア　ノット\nト　ビー？",
  "obj_bibliox_enemy_slash_Step_0_gml_35_0": "あたさかな\nはまやわら",
  "obj_bibliox_enemy_slash_Step_0_gml_36_0": "それは最良の\n時代であり\nサイキックな\n時代でもあった",
  "obj_bibliox_enemy_slash_Step_0_gml_37_0": "ニンゲンのタマツイ\nモンスターのタマツイ\n本のタマツイ",
  "obj_bibliox_enemy_slash_Step_0_gml_38_0": "10位ジュッシン分類法…",
  "obj_bibliox_enemy_slash_Step_0_gml_90_0": "＊ ビブリオクスは\n　 自分のヒゲに差し込んだ\n　 しおりを　並べ替えた。",
  "obj_bibliox_enemy_slash_Step_0_gml_91_0": "＊ ビブリオクスは　空中に\n　 文字を　呼びだした。",
  "obj_bibliox_enemy_slash_Step_0_gml_92_0": "＊ ビブリオクスは\n　 アルファベットマカロニ入りスープで\n　 占いをしている。",
  "obj_bibliox_enemy_slash_Step_0_gml_93_0": "＊ ビブリオクスは　聖なる歌を\n　 口ずさんだ…が　歌詞をまちがえた。",
  "obj_bibliox_enemy_slash_Step_0_gml_94_0": "＊ ビブリオクスは\n　 ブツブツ　ブンブン　言っている。",
  "obj_bibliox_enemy_slash_Step_0_gml_95_0": "＊ 羊皮紙の　ニオイがする。",
  "obj_bibliox_enemy_slash_Step_0_gml_100_0": "＊ ビブリオクスは　ビリビリだ。",
  "obj_bibliox_enemy_slash_Step_0_gml_105_0": "＊ ビブリオクスの　ヒゲが\n　 うれしそうに　羽ばたいた。",
  "obj_bibliox_enemy_slash_Step_0_gml_110_0": "＊ ビブリオクスは\n　 ページを開いているのも　やっとだ。",
  "obj_bibliox_enemy_slash_Step_0_gml_135_0": "＊ ビブリオクス -\n　 文字をつづって　まほうをかける\n　 俗モノまほう使い。/",
  "obj_bibliox_enemy_slash_Step_0_gml_136_0": "＊ つづりを　まちがえがち。/%",
  "obj_bibliox_enemy_slash_Step_0_gml_142_0": "＊ 正しい　スペルを　選べ！",
  "obj_bibliox_enemy_slash_Step_0_gml_149_0": "* Select the correct spelling with ~1!",
  "obj_bibliox_enemy_slash_Step_0_gml_167_0": "＊ スージィは　読もうとした！/",
  "obj_bibliox_enemy_slash_Step_0_gml_173_0": "＊ …が　本には絵がなかった！/",
  "obj_bibliox_enemy_slash_Step_0_gml_174_0": "＊ …スージィは　居眠りした！！/",
  "obj_bibliox_enemy_slash_Step_0_gml_176_0": "\\EK＊ スージィ？/%",
  "obj_bibliox_enemy_slash_Step_0_gml_193_0": "＊ ラルセイは　読書用メガネをかけた！/%",
  "obj_ch4_DCA01_slash_Step_0_gml_31_0": "\\E7＊ お！^1　見ろよ　あれ！/",
  "obj_ch4_DCA01_slash_Step_0_gml_32_0": "\\E7＊ 闇の泉は　この上だ！/%",
  "obj_ch4_DCA01_slash_Step_0_gml_65_0": "\\E2＊ んだよ^1　楽勝だったな。/%",
  "obj_ch4_DCA01_slash_Step_0_gml_78_0": "\\EQ＊ はー^1。また冒険できると\n　 思ったのに\n　 つまんねーのー…/",
  "obj_ch4_DCA01_slash_Step_0_gml_79_0": "\\EA＊ まーでも^1　やることは\n　 キッチリ　やらねーとな…/%",
  "obj_ch4_DCA01_slash_Step_0_gml_117_0": "\\Ee＊ なっ…/%",
  "obj_ch4_DCA01_slash_Step_0_gml_188_0": "\\EI＊ お^1…おい！　てめぇ！/%",
  "obj_ch4_DCA01_slash_Step_0_gml_356_0": "\\Ec＊ …クソッ…/",
  "obj_ch4_DCA01_slash_Step_0_gml_357_0": "\\EJ＊ クリス^1！　オレのことは\n　 気にすんな！\n　 自分で回復できる！/",
  "obj_ch4_DCA01_slash_Step_0_gml_358_0": "\\Ec＊ ナイトをつかまえる\n　 チャンスを逃すな^1！\n　 早く行け！/%",
  "obj_ch4_DCA01_slash_Step_0_gml_450_0": "\\EI＊ チャンスだ！！^1　行け！/",
  "obj_ch4_DCA01_slash_Step_0_gml_451_0": "\\Ea＊ 攻撃しろ！！/%",
