  "obj_ch4_DCA01_old_slash_Step_0_gml_36_0": "\\EZ* (Kris..^1. that's...)/%",
  "obj_ch4_DCA01_old_slash_Step_0_gml_59_0": "\\E5* Hey^1, you bastard!!/%",
