  "scr_text_slash_scr_text_gml_7429_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7454_0": "#買う",
  "scr_text_slash_scr_text_gml_7455_0": "#買わない",
  "scr_text_slash_scr_text_gml_7462_0": "＊ (自販機だ。&　 泉前フードが　売られている)&＊ (ベーグル１コ　$120。買う？)/",
  "scr_text_slash_scr_text_gml_7485_0": "＊ (どういうわけか^1…&　 おカネが　足りなかった)/%",
  "scr_text_slash_scr_text_gml_7497_0": "#なかま",
  "scr_text_slash_scr_text_gml_7498_0": "#アイテムそうこ",
  "scr_text_slash_scr_text_gml_7499_0": "操作",
  "scr_text_slash_scr_text_gml_7500_0": "読まない",
  "scr_text_slash_scr_text_gml_7503_0": "＊ (マニュアルだ。どの項目を読む？)/",
  "scr_text_slash_scr_text_gml_7511_0": "＊ 同じタイプの敵を　一定数以上&　 「にがす」か「スリープ」させると&　 その敵が　「なかま」になります。/",
  "scr_text_slash_scr_text_gml_7512_0": "＊ 「なかま」は　キャッスルタウンに&　 移住してきます。全員集めると&　 なにかが起きる…？/",
  "scr_text_slash_scr_text_gml_7513_0": "＊ なかまになる敵の情報は　各エリアの&　 セーブポイントで確認できます。&　 (一部のボスは除きます)/%",
  "scr_text_slash_scr_text_gml_7519_0": "＊ セーブポイントで&　「そうこ」メニューを&　 使えるようになりました。/",
  "scr_text_slash_scr_text_gml_7520_0": "＊ 「アイテム」を持ちきれなくなる^1と&　 以降　拾ったり買ったりしたものは&　 「そうこ」に送られます。/",
  "scr_text_slash_scr_text_gml_7521_0": "＊ しばらく使わなそうなアイテム^1は&　 「そうこ」に入れておくと&　 よいでしょう。/%",
  "scr_text_slash_scr_text_gml_7527_0": "＊ 操作のおさらいです。&　 (設定メニューで　変更もできます)/",
  "scr_text_slash_scr_text_gml_7528_0": "＊ ~1&＊ 「決定」「調べる」「使う」/",
  "scr_text_slash_scr_text_gml_7529_0": "＊ ~1&＊ 「キャンセル」「長押しで走る」&　 「全テキストを　一度に表示」/",
  "scr_text_slash_scr_text_gml_7530_0": "＊ ~1&＊ 「メニューを開く」「長押しで&　 テキストボックスをスキップ」/%",
  "scr_text_slash_scr_text_gml_7536_0": "＊ (本を読む時間なんてない)/%",
  "DEVICE_MENU_slash_Draw_0_gml_125_0": "クリア済みファイルなし",
  "DEVICE_MENU_slash_Draw_0_gml_195_0": "[条件:クレジットを見る]",
  "obj_readable_room1_slash_Other_10_gml_740_0": "＊ (かべに　穴があいている…)/",
  "obj_readable_room1_slash_Other_10_gml_741_0": "＊ (なかには　なにもない)/%",
  "obj_shop1_slash_Create_0_gml_87_0": "アイテム#ひと口ごとに#音を奏でる#80HP回復",
  "scr_monstersetup_slash_scr_monstersetup_gml_1730_0": "FIREモード",
  "scr_monstersetup_slash_scr_monstersetup_gml_1730_1": "パワー#こうげき",
  "scr_monstersetup_slash_scr_monstersetup_gml_1731_0": "SWORDモード",
  "scr_monstersetup_slash_scr_monstersetup_gml_1731_1": "各打#パワーUP",
  "scr_monstersetup_slash_scr_monstersetup_gml_1732_0": "LASERモード",
  "scr_monstersetup_slash_scr_monstersetup_gml_1732_1": "高速#こうげき",
  "scr_monstersetup_slash_scr_monstersetup_gml_1733_0": "DUCKモード",
  "scr_monstersetup_slash_scr_monstersetup_gml_1733_1": "ヘボ#こうげき",
  "scr_monstersetup_slash_scr_monstersetup_gml_1738_0": "ターボドッジ",
  "scr_monstersetup_slash_scr_monstersetup_gml_1739_0": "高性能#ドッジ",
  "scr_monstersetup_slash_scr_monstersetup_gml_1743_0": "セルフリペア",
  "scr_monstersetup_slash_scr_monstersetup_gml_1744_0": "100HP#回復",
  "scr_text_slash_scr_text_gml_5227_0": "＊ やったなボス^1！&　 全チャレンジ制覇だ！/",
  "scr_text_slash_scr_text_gml_5228_0": "＊ もう　オレから教えることはない^1し&　 追加賞品もない^1。でも　ウデを&　 みがきたきゃ　いつでも歓迎だ！/",
  "scr_text_slash_scr_text_gml_5229_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_5252_0_b": "＊ 大丈夫^1　オレたちは&　 どこへも行きやしない^1。&　 ずっと　ここにいるからな。/%",
  "scr_text_slash_scr_text_gml_6918_0_b": "＊ (扉らなかった)/%",
  "scr_text_slash_scr_text_gml_7568_0": "#読む",
  "scr_text_slash_scr_text_gml_7569_0": "#読まない",
  "scr_text_slash_scr_text_gml_7582_0": "＊ 今回の冒険以降で^1は&　 敵をこうげきして倒すと^1　「LOST^1」&　 つまり　失われてしまいます。/",
  "scr_text_slash_scr_text_gml_7583_0": "＊ 「LOST」した敵^1は&　 その後二度と「なかま」にすることは&　 できません。/",
  "scr_text_slash_scr_text_gml_7584_0": "＊ ただし^1　失ったきずなと引きかえ^1に&　 自分が　強くは　なれるでしょう…/%",
  "scr_text_slash_scr_text_gml_7590_0": "＊ (サイバーワールドで&　 本なんて読む時間が　どこにある？)/%",
  "scr_text_slash_scr_text_gml_7595_0": "#入れる",
  "scr_text_slash_scr_text_gml_7596_0": "#入れない",
  "scr_text_slash_scr_text_gml_7599_0": "＊ (マネキンだ)/",
  "scr_text_slash_scr_text_gml_7600_0": "＊ (ﾃﾞｰﾀﾃﾞｨｽｸを　入れる？)/",
  "scr_text_slash_scr_text_gml_7607_0": "＊ (ﾃﾞｰﾀﾃﾞｨｽｸは　身をよじった。&　 入らない…！)/%",
  "scr_text_slash_scr_text_gml_7619_0": "#のぞく",
  "scr_text_slash_scr_text_gml_7620_0": "#やめとく",
  "scr_text_slash_scr_text_gml_7625_0": "＊ (穴のなかで&　 なにかが　かすかに光を発している)/",
  "scr_text_slash_scr_text_gml_7626_0": "＊ (なかを　のぞく？)/",
  "scr_text_slash_scr_text_gml_7648_0": "＊ (穴のなかに　手を伸ばした。&　 不思議なガラスの欠片と^1…&　 なにかがある…)/",
