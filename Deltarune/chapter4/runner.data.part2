for (i = 0; i < 3; i += 1)
{
    if (PART[i] > PARTMAX[i])
        PART[i] = PARTMAX[i];
    
    if (PART[i] < 0)
        PART[i] = 0;
    
    IDEALX[i] = PART[i] * -50;
    
    if (PARTX[i] < IDEALX[i])
    {
        if (abs(IDEALX[i] - PARTX[i]) >= 0)
            PARTX[i] += 10;
        
        if (abs(IDEALX[i] - PARTX[i]) > 50)
            PARTX[i] += 10;
        
        if (abs(IDEALX[i] - PARTX[i]) > 100)
            PARTX[i] += 10;
        
        if (abs(IDEALX[i] - PARTX[i]) > 150)
            PARTX[i] += 10;
    }
    
    if (PARTX[i] > IDEALX[i])
    {
        if (abs(IDEALX[i] - PARTX[i]) >= 0)
            PARTX[i] -= 10;
        
        if (abs(IDEALX[i] - PARTX[i]) > 50)
            PARTX[i] -= 10;
        
        if (abs(IDEALX[i] - PARTX[i]) > 100)
            PARTX[i] -= 10;
        
        if (abs(IDEALX[i] - PARTX[i]) > 150)
            PARTX[i] -= 10;
    }
    
    if (PARTX[i] == IDEALX[i])
        LOCK[i] = 1;
    else
        LOCK[i] = 0;
}

