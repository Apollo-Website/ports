            visible = 0;
        }
        
        if (global.chapter == 2)
        {
            if (global.plot == 9)
            {
                obj_mainchara.y = kris_y;
                kris_y += 200;
                cameray_set(cameray() + 400);
            }
        }
    }
    
    if (timer >= 30 && timer < 60)
    {
        with (megablack)
            image_alpha -= 0.05;
        
        if (quick_mode == 1)
        {
            with (megablack)
                image_alpha -= 0.05;
        }
    }
    
    if (timer == 50)
        getup_index = 1;
    
    if (timer == 53)
        getup_index = 2;
    
    if (timer == 55)
    {
        with (megablack)
            instance_destroy();
        
        persistent = 0;
        global.interact = 0;
        global.facing = 0;
        obj_mainchara.x = (kris_x * 2) + 8;
        obj_mainchara.y = (kris_y * 2) + 4;
        
        with (obj_mainchara)
