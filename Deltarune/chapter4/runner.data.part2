                    scr_damage_enemy(i, damage + round(random(100)));
                }
                else
                {
                    global.hittarget[i] = 0;
                    dm = instance_create(global.monsterx[i], (global.monstery[i] + 20) - (global.hittarget[i] * 20), obj_dmgwriter);
                    dm.damage = damage + round(random(100));
                    dm.type = 6;
