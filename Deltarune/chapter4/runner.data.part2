  "obj_lancerchaseevent_slash_Step_0_gml_16_0": "＊ おい^1…見ろよ^1…&＊ だれか　手ェふってるぞ？/",
  "obj_lancerchaseevent_slash_Step_0_gml_17_0": "＊ なんか　用でも&　 あんのかな…？/%",
  "obj_lancerchaseevent_slash_Step_0_gml_137_0": "＊ やべえ^1！　逃げろ！/%",
  "obj_lancerscare2_slash_Step_0_gml_311_0": "＊ .../%",
  "obj_lancerscare2_slash_Step_0_gml_343_0": "＊ Well^1, that was weird./%",
  "obj_lancerslideevent_slash_Step_0_gml_34_0": "＊ クリス^1　飛び降りるぞ！/%",
  "obj_legend_slash_Draw_0_gml_13_0": "  昔むかし　ひそかに語りつがれる&         言い伝えがあった。",
  "obj_legend_slash_Draw_0_gml_21_0": "それは&夢の伝説。",
  "obj_legend_slash_Draw_0_gml_24_0": "それは&希望の伝説。",
  "obj_legend_slash_Draw_0_gml_32_0": "それは&光の伝説。",
  "obj_legend_slash_Draw_0_gml_35_0": "それは&闇の伝説。",
  "obj_legend_slash_Draw_0_gml_43_0": "    その伝説の名は&  ^3   「DELTA RUNE」",
  "obj_legend_slash_Draw_0_gml_98_0": "  「幾千年もの長きにわたり」^6―%",
  "obj_legend_slash_Draw_0_gml_99_0": "  「光と闇は　調和を保ち&    世界は　平和に包まれてきた」",
  "obj_legend_slash_Draw_0_gml_113_0": "「しかし　この調和が&          乱されれば」―",
  "obj_legend_slash_Draw_0_gml_151_0": " 「恐ろしい災厄が　見舞うだろう」",
  "obj_legend_slash_Draw_0_gml_170_0": "「天は　恐怖の闇色に染まり」―",
  "obj_legend_slash_Draw_0_gml_205_0": "「地は　恐れおののき&          ひび割れる」",
  "obj_legend_slash_Draw_0_gml_212_0": "「母なる大地の鼓動は高まり」―",
  "obj_legend_slash_Draw_0_gml_219_0": "「ついには　息絶えるだろう」",
  "obj_legend_slash_Draw_0_gml_233_0": "  「そうして^1　すべてが終焉を&      迎えたかに見えたとき」―",
  "obj_legend_slash_Draw_0_gml_253_0": "「希望の光をたたえし　３人の&勇者が　地の果てより現れる」",
  "obj_legend_slash_Draw_0_gml_301_0": "「ニンゲン。",
  "obj_legend_slash_Draw_0_gml_309_0": "モンスター。",
  "obj_legend_slash_Draw_0_gml_317_0": "闇の国の王子」",
  "obj_legend_slash_Draw_0_gml_356_0": "    「彼らだけが　闇の泉を&       封じることができる」",
  "obj_legend_slash_Draw_0_gml_387_0": "「『天使の楽園』を　破壊できる」",
  "obj_legend_slash_Draw_0_gml_394_0": "「彼らの働きにより&再び　調和が　もたらされ」―",
  "obj_legend_slash_Draw_0_gml_401_0": "「世界は　破滅の危機より&        救われるだろう」",
  "obj_legend_slash_Draw_0_gml_426_0": "          「闇の泉」は―",
  "obj_legend_slash_Draw_0_gml_451_0": "この地を形づくる力の源泉。",
  "obj_legend_slash_Draw_0_gml_459_0": "現在は　王国の中心にあり&天高く　闇を噴き上げている。",
  "obj_legend_slash_Draw_0_gml_466_0": "       しかし　最近になって&    もうひとつ　別の泉が出現―",
  "obj_legend_slash_Draw_0_gml_473_0": "   これにより^1　光と闇の均衡は&   しだいに崩れはじめている…",
  "obj_monster1_slash_Step_0_gml_25_0": "Line1",
  "obj_monster1_slash_Step_0_gml_26_0": "Line2",
  "obj_monster1_slash_Step_0_gml_53_0": "* Line3",
  "obj_monster1_slash_Step_0_gml_54_0": "* Line4",
  "obj_monster1_slash_Step_0_gml_55_0": "* Line5",
  "obj_monster1_slash_Step_0_gml_56_0": "* Line6",
  "obj_monster1_slash_Step_0_gml_57_0": "* Line7",
  "obj_monster1_slash_Step_0_gml_75_0": "* Line8/%",
  "obj_monster1_slash_Step_0_gml_82_0": "Line9",
  "obj_monster1_slash_Step_0_gml_91_0": "＊ スージィと　クリスは&　 デュアルバスターを　発動した！/%",
  "obj_npc_facing_slash_Other_10_gml_12_0": "＊ キミの顔^1…　それは傷かい？&　 それとも　目なのかい？/%",
  "obj_npc_facing_slash_Other_10_gml_31_0": "＊ だいじょうぶだよ^1　クリス！&　 わたし　ずっと&　 おもってたの。/",
  "obj_npc_facing_slash_Other_10_gml_32_0": "\\E4＊ スージィは　ホントは&　 やさしい　おんなのこ&　 だって。/",
  "obj_npc_facing_slash_Other_10_gml_33_0": "\\E0＊ だから　きっと&　 しんぱいないよ！/%",
  "obj_npc_facing_slash_Other_10_gml_39_0": "＊ それと^1…もしよかったら…&　 スージィに　「おはよう！」&　 って　つたえてくれる…？/%",
  "obj_npc_facing_slash_Other_10_gml_50_0": "＊ あーらら^1　クリス^1。&＊ まぁた　ちこくかい？/",
  "obj_npc_facing_slash_Other_10_gml_51_0": "\\E0＊ え？　ボクと&　 ペアに　なりたいって？/",
  "obj_npc_facing_slash_Other_10_gml_52_0": "\\E1＊ ボクはもう^1　クラスで&　 ２ばんめに　デキるコと&　 くんじゃったからなあ！/",
  "obj_npc_facing_slash_Other_10_gml_53_0": "\\E3＊ いや^1…　まてよ^1…&＊ よくよく　かんがえて&　 みたら…/",
  "obj_npc_facing_slash_Other_10_gml_54_0": "\\E4＊ …キミの　こせいゆたかな&　 のうりょくは^1　このかだいに&　 おおいに　やくだちそうだ！/",
  "obj_npc_facing_slash_Other_10_gml_55_0": "\\E2＊ …なぁあんつってぇええ^1！&＊ わるいけど　ボク　100てん&　 とりたいからぁ～！　/%",
  "obj_npc_facing_slash_Other_10_gml_59_0": "＊ ほか　あたってくれる～？&　 ボク　100てん&　 とりたいんだよねぇ～！/",
  "obj_npc_facing_slash_Other_10_gml_60_0": "\\E2＊ だれも　みつからなかったら&　 また　ママと　ペアになれば&　 いいんじゃな～い？/%",
  "obj_npc_facing_slash_Other_10_gml_67_0": "\\E3＊ ボク　いったよねえ？&　 「ちこくは　よろしくないよ」&　 って。/",
  "obj_npc_facing_slash_Other_10_gml_68_0": "\\E0＊ うーむ^1…&　 これは　もしかしたら…&　 いわゆる　ひとつの…/",
  "obj_npc_facing_slash_Other_10_gml_69_0": "\\E1＊ …「だ～から&　 いったのに」マター^1　かな？/%",
  "obj_npc_facing_slash_Other_10_gml_73_0": "\\E0＊ いやはや^1　じつにざんねん^1。&　 せっかくの　ちゅうこくが&　 ムダになってしまうとは…/%",
  "obj_npc_facing_slash_Other_10_gml_83_0": "＊ パートナー^1？&＊ はよ　さがさんとナー！！/",
  "obj_npc_facing_slash_Other_10_gml_84_0": "＊ ハーッハッハー^1！&＊ どや！　おもろいやろ！^1？&＊ なあ^1？　なあ？？/",
  "obj_npc_facing_slash_Other_10_gml_85_0": "＊ …おもんない？/",
  "obj_npc_facing_slash_Other_10_gml_86_0": "＊ フン^1…　わるいけど　ワテ　もう&　 あいかたが　おりますさか^1い&　 おじゃまむしは　きえてんか？/%",
  "obj_npc_facing_slash_Other_10_gml_90_0": "＊ クリスはん^1　なんども　いうけどな&　 ワテ　もう　あいかたが&　 おりまんねん。/",
  "obj_npc_facing_slash_Other_10_gml_91_0": "＊ こんで　ワテら&　 左うちわの　スクールライフや！/",
  "obj_npc_facing_slash_Other_10_gml_92_0": "＊ なんでか　て？&　 ワテ　いま^1　右の　てくびを&　 ねんざしとりますさかい～！/%",
  "obj_npc_facing_slash_Other_10_gml_98_0": "＊ クリスはん^1　きにせんとき～。&＊ そんな　しんぱい　しなさんなて。/",
  "obj_npc_facing_slash_Other_10_gml_99_0": "＊ スージィに　ブンなぐられたかて&　 しぬこと　あらへんわー^1。&　 しらんけど。/",
  "obj_npc_facing_slash_Other_10_gml_100_0": "＊ せいぜい　じゅぎょうの　かだいを&　 なーんも　てつだってくれへん&　 ぐらいやて！/",
  "obj_npc_facing_slash_Other_10_gml_101_0": "＊ ほら^1　よう　ゆうやろ^1？&＊ こわ～いひとのこ^1と&　 「その“スージィ”のひと」て！/",
  "obj_npc_facing_slash_Other_10_gml_102_0": "＊ …あれ^1　なんか　よけい&　 こわなってもうた^1。あかんがな。/%",
  "obj_npc_facing_slash_Other_10_gml_106_0": "\\E0＊ クリスはん^1　あんた　しんだら&　 あんたの　アニキのCD&　 ワテが　もろても　ええか？/%",
  "obj_npc_facing_slash_Other_10_gml_116_0": "＊ クリス^1！　オッス！&＊ オマエさ^1　くんの　おっせーよ！/",
  "obj_npc_facing_slash_Other_10_gml_117_0": "＊ おかげでオレ　ライちゃんなんかと&　 ペアに　なっちゃっただろー^1？&　 ハハハ…/",
  "obj_npc_facing_slash_Other_10_gml_118_0": "＊ さっきから　ずーっと　「ペアルック&　 きような！」とか　いわれててさー&　 マジ　キツイぜ！/%",
  "obj_npc_facing_slash_Other_10_gml_122_0": "＊ クリス^1　オマエ　ラッキーだな^1。&＊ オレも　ボッチのほうが&　 まだマシだったぜ　ハハハ…/%",
  "obj_npc_facing_slash_Other_10_gml_128_0": "＊ クリス^1！　ごめんな～^1！&＊ オレが　オマエを　まってて&　 やらなかったせいで…/",
  "obj_npc_facing_slash_Other_10_gml_130_0": "＊ んで　そのあと&　 ベッコベコに　されっぜ！？/%",
  "obj_npc_facing_slash_Other_10_gml_134_0": "\\E0＊ いいか^1　とにかく　にげろよ！&　 ぜったい　ふりかえんな！/%",
  "obj_npc_facing_slash_Other_10_gml_147_0": "\\E0＊ (カチ…カチ…ピッ…ピッ…)/",
  "obj_npc_facing_slash_Other_10_gml_148_0": "\\E1＊ …せんやくアリ。/%",
  "obj_npc_facing_slash_Other_10_gml_152_0": "\\E0＊ (カチ…カチ…ピッ…ピッ…)/",
  "obj_npc_facing_slash_Other_10_gml_153_0": "\\E2＊ …しぬな。/%",
  "obj_npc_facing_slash_Other_10_gml_161_0": "＊ しってる^1！だろ！？&　 オレと　キャッティーは&　 いつでも　ペアだっ^1！て！/",
  "obj_npc_facing_slash_Other_10_gml_162_0": "＊ さいきょうの　コンビ^1！さ！&　 はじめての　たいいくの&　 じゅぎょうから^1！ずっと！/",
  "obj_npc_facing_slash_Other_10_gml_163_0": "＊ あの日　たいいくで&　 つかう^1！フラフープが&　 たりなく！^1なっちゃって！/",
  "obj_npc_facing_slash_Other_10_gml_164_0": "＊ キャッティーは　オレを&　 フープがわりに^1！それが&　 はじまりのストーリー！^1さ！/%",
  "obj_npc_facing_slash_Other_10_gml_168_0": "＊ オレと　キャッティーは&　 ちがうタイプに　みえるけ^1ど&　 にてるとこも^1！いっぱい！/",
  "obj_npc_facing_slash_Other_10_gml_169_0": "＊ ２人とも　いきを　するのが&　 すきだし^1　アゴを　はずすのも&　 すきだから！ね！/%",
  "obj_npc_facing_slash_Other_10_gml_176_0": "\\E0＊ クリス^1　オレに　うでが&　 あったら…/",
  "obj_npc_facing_slash_Other_10_gml_177_0": "\\E2＊ このイカした　ぼうしを&　 とって　けいれいするよ…&　 おまえのこと　わすれない！/%",
  "obj_npc_facing_slash_Other_10_gml_189_0": "\\E3＊ え…？&＊ …「ケータイで　なにを&　 みてるのか」って？/",
  "obj_npc_facing_slash_Other_10_gml_190_0": "\\E0＊ もももちろん&　 じゅぎょうで　つかう&　 きょうざいですよ！/",
  "obj_npc_facing_slash_Other_10_gml_191_0": "\\E4＊ ア…^1アニメの…&　 きょうざいと^1…&　 それから…　えと…/",
  "obj_npc_facing_slash_Other_10_gml_192_0": "\\E5＊ そそ…それより^1　クリス^1！&　 パートナーは　みつかった？/%",
  "obj_npc_facing_slash_Other_10_gml_196_0": "\\E7＊ (みゅうみゅう…^1)&＊ (あなたは　いつだって&　 わたしのパートナーだよ…)/%",
  "obj_npc_facing_slash_Other_10_gml_202_0": "＊ えと^1…　どしたのかな…？&＊ はやく　いってきて&　 くださいねーっ！/%",
  "obj_npc_facing_slash_Other_10_gml_438_0": "\\EB＊ サイン^1　かえるんじゃ\n　 ねーのかよ。/",
  "obj_npc_facing_slash_Other_10_gml_440_0": "\\E3＊ かえるよ^1。\n　 もうちょっとしてから\n　 もどってきてくれ。/%",
  "obj_npc_facing_slash_Other_10_gml_442_0": "＊ That's just..^1. a bunch of torn up pieces of felt./",
  "obj_npc_facing_slash_Other_10_gml_444_0": "＊ Can you PLEASE stop acting so jealous for ONE second?/%",
  "obj_npc_facing_slash_Other_10_gml_470_0": "\\EK＊ (クリス^1　こいつと\n　 はなしても　ムダだ…)/%",
  "obj_npc_facing_slash_Other_10_gml_472_0": "＊ Don't talk to me while I'm scheming./",
  "obj_npc_facing_slash_Other_10_gml_474_0": "\\EK＊ (クリス^1　こいつと\n　 はなしても　ムダだ…)/%",
  "obj_npc_facing_slash_Other_10_gml_476_0": "＊ Heh^1, why bother when you guys will solve it for us?/",
  "obj_npc_facing_slash_Other_10_gml_478_0": "＊ (Oh^1, I thought it was because I'm afraid of spikes.)/",
  "obj_npc_facing_slash_Other_10_gml_480_0": "＊ SHHHH!/%",
  "obj_npc_facing_slash_Other_10_gml_489_0": "＊ Seeing you two scheme together.../",
  "obj_npc_facing_slash_Other_10_gml_490_0": "\\E8＊ It's a bit like a group project in school^1, isn't it?/",
  "obj_npc_facing_slash_Other_10_gml_492_0": "＊ Can you stop ruining everything?/%",
  "obj_npc_facing_slash_Other_10_gml_500_0": "\\E1＊ <!--モウスグ　[ラルセイ]ガ&　 上ノ階ニ　[マイルーム]ヲ&　 Setup.EXEシテクレマス-->/",
  "obj_npc_facing_slash_Other_10_gml_501_0": "\\EA＊ <!--ダイジョウブ-->/",
  "obj_npc_facing_slash_Other_10_gml_502_0": "\\EP＊ <!--[ワタシ]ノ　要求ハ&　 [表計算ソフト]ニ　[リスト&　 アップ]シテアリマス-->/",
  "obj_npc_facing_slash_Other_10_gml_230_0": "\\E3＊ クリス^1！　よかった^1！&＊ スージィに　ころされ&　 ちゃったかと　おもったよ！/",
  "obj_npc_facing_slash_Other_10_gml_232_0": "\\E0＊ それじ^1ゃ&　 ほんだいに　はいろうか。/",
  "obj_npc_facing_slash_Other_10_gml_233_0": "\\E1＊ これで　キミに&　 しゃっきんを&　 かえしてもらえるね。/",
  "obj_npc_facing_slash_Other_10_gml_234_0": "\\E0＊ 「ドラゴンの　えがきかた^1」&　 へんきゃくきげんを&　 2583日も　すぎてる。/",
  "obj_npc_facing_slash_Other_10_gml_235_0": "\\E2＊ でも　ボクは^1　こころ&　 やさしい　ボランティア&　 アシスタントだ。/",
  "obj_npc_facing_slash_Other_10_gml_236_0": "\\E4＊ こんしゅう中に&　 かえしてくれれ^1ば&　 ばっきんは…/",
  "obj_npc_facing_slash_Other_10_gml_237_0": "\\E2＊ たったの　64.23ドルに&　 まけてあげよう^1！&＊ どうだい^1　クリス！/%",
  "obj_npc_facing_slash_Other_10_gml_241_0": "\\E3＊ え^1？　どんな　ほんか&　 わすれちゃったって？/",
  "obj_npc_facing_slash_Other_10_gml_242_0": "\\E0＊ たしか^1　ひょうしには&　 くちべにを　つけた&　 ふじいろの　ドラゴンが…/",
  "obj_npc_facing_slash_Other_10_gml_243_0": "\\E0＊ で^1　ドラゴンが　きている&　 ふくは^1　えーっと&　 たしか…/",
  "obj_npc_facing_slash_Other_10_gml_244_0": "\\E2＊ まあほら^1　みたら　すぐに&　 わかるでしょ！？/%",
  "obj_npc_facing_slash_Other_10_gml_249_0": "\\E3＊ え^1？&　 びょういんの　まど^1？&　 なんの　はなしだい？/",
  "obj_npc_facing_slash_Other_10_gml_250_0": "\\E5＊ わるいけど　そんなことを&　 しているヒマは&　 ないんだよ。/",
  "obj_npc_facing_slash_Other_10_gml_251_0": "\\E0＊ だって　ほら　ボクは^1…&　 うーん^1　なんていったら&　 いいかなあ…/",
  "obj_npc_facing_slash_Other_10_gml_252_0": "\\E2＊ 「しゃかいに　こうけん」？&　 してるから。/",
  "obj_npc_facing_slash_Other_10_gml_253_0": "\\E2＊ キミも　きが　むいたら&　 やってみるといい！/",
  "obj_npc_facing_slash_Other_10_gml_254_0": "\\E2＊ おおいに　やりがいを&　 かんじられるよ！/%",
  "obj_npc_facing_slash_Other_10_gml_269_0": "＊ やあ^1　クリス！/",
  "obj_npc_facing_slash_Other_10_gml_270_0": "＊ キャッティーは^1　バイトが&　 ある^1！から　オレが　さきに&　 かだいを　はじめてるんだ！/",
  "obj_npc_facing_slash_Other_10_gml_271_0": "＊ もう^1！こんなに　たくさん&　 しゃしんを　コピーしたよ。/",
  "obj_npc_facing_slash_Other_10_gml_273_0": "＊ (おなじ　サッカーボールの&　 しゃしんが　73まい&　 コピーされている)/%",
  "obj_npc_facing_slash_Other_10_gml_277_0": "＊ 「さっかせい」が　もとめ&　 られる　かだい！^1だよ！&＊ サッカーな　だけに^1！ね！/%",
  "obj_npc_facing_slash_Other_10_gml_283_0": "＊ だぃがく　ぃくﾏｽので^1…&＊ ﾃﾐｰ　ﾒｯﾁｬ^1…&＊ べんきｮ　す！！！！！/",
  "obj_npc_facing_slash_Other_10_gml_284_0": "＊ (テミーは　イケメンあくまが&　 たくさん　でてくる　マンガを&　 よんでいる)/%",
  "obj_npc_facing_slash_Other_10_gml_297_0": "\\E1＊ なあ^1　クリス^1…&＊ パパ　かんがえたんだけど…/",
  "obj_npc_facing_slash_Other_10_gml_298_0": "\\E3＊ アズリエルが　きゅうかで&　 うちに　かえってきたら…/",
  "obj_npc_facing_slash_Other_10_gml_299_0": "\\E0＊ みんなで　QCダイナーに&　 いかないか^1？&　 むかしみたいにね…/",
  "obj_npc_facing_slash_Other_10_gml_300_0": "\\E6＊ もちろん&　 パパの　おごりだ。/",
  "obj_npc_facing_slash_Other_10_gml_301_0": "\\E0＊ おいしいものを　たべよう。&　 きっと　たのしいぞ！/%",
  "obj_npc_facing_slash_Other_10_gml_305_0": "\\E1＊ そのあと　まちを&　 ドライブして…/",
  "obj_npc_facing_slash_Other_10_gml_306_0": "\\E2＊ ああ…　でも　そのまえ^1に&　 トラックを　そうじして&　 おかないとなあ…/%",
  "obj_npc_facing_slash_Other_10_gml_315_0": "\\E2＊ ああ^1　その　はなたち^1は　&　 まだ　げんきだよ。/",
  "obj_npc_facing_slash_Other_10_gml_316_0": "\\E0＊ この　きこうでも&　 かれないように　するのは&　 たいへんだけどね…/%",
  "obj_npc_hammerguy_slash_Step_0_gml_108_0": "＊ (なぜか^1　全員のHPが回復した)/",
  "obj_npc_hammerguy_slash_Step_0_gml_109_0": "＊ いかがかな^1？　体をもみほぐしたの^1で&　 ずいぶんと楽になったであろう？&　 フッ！　ハッ！/%",
  "obj_npc_hammerguy_slash_Step_0_gml_153_0": "＊ (「こわれたケーキ」は&　 見るかげもなく修理された)/",
  "obj_npc_hammerguy_slash_Step_0_gml_154_0": "＊ (「こわれたケーキ」は&　 「トップケーキ」になった)/",
  "obj_npc_hammerguy_slash_Step_0_gml_155_0": "＊ これは　じつに&　 すばらしいケーキだ^1。&＊ うまく役立てるのだぞ…/%",
  "obj_npc_hammerguy_slash_Step_0_gml_184_0": "＊ (「こわれたカギ」のかけらは&　 見るかげもなく修理された)/",
  "obj_npc_hammerguy_slash_Step_0_gml_185_0": "＊ (「こわれたカギ」のかけらは&　 「とびらのカギ」になった)/",
  "obj_npc_hammerguy_slash_Step_0_gml_186_0": "＊ …うーむ^1　このカギからは&　 恐ろしい気を感じる…/",
  "obj_npc_hammerguy_slash_Step_0_gml_187_0": "＊ よいか^1…&　 私がこのカギを直したのは&　 おぬしに使わせるためではない…/",
  "obj_npc_hammerguy_slash_Step_0_gml_188_0": "＊ その恐ろしさを理解させ^1　決して&　 使うことのないようにするためだ。&　 わかっておるな？/%",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_60_0": "＊ ねえ^1　スージィ^1　ボクが&　 さっき言ったこと^1　ちょっと&　 わかりにくかったかな…/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_61_0": "\\E0＊ ボクたち勇者に^1は&　 平和な未来を築く力がある。/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_62_0": "\\E8＊ だから^1　次から^1は&　 「たたかう」ことは&　 極力さけていこう？/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_64_0": "＊ …/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_66_0": "＊ …それがムリなら^1　せめて&　 手加減してあげるのは&　 どうかな…？/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_67_0": "\\E1＊ キミが敵を弱らせてくれた^1ら&　 ボクの「スリープ」の&　 呪文が　効くようになる。/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_68_0": "\\E8＊ くたびれた相手を&　 眠らせる効果があるんだ！/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_70_0": "＊ ふわぁ^1…　おまえの話&　 聞いてたら^1　さっそく&　 眠くなってきたぜ。/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_72_0": "＊ と…とにかく^1　ご検討&　 よろしくお願いします！/",
  "obj_npc_puzzlemaster1_slash_Step_0_gml_73_0": "\\E1＊ (クリス^1　ボクたちが敵に&　 「けいこく」したほうが&　 よさそうだね…)/%",
  "obj_npc_room_slash_Other_10_gml_13_0": "＊ パックリ割れた　切り傷が&　 まるで　涙のあとみたい。/%",
  "obj_npc_room_slash_Other_10_gml_20_0": "＊ あかい　カートに&　 さびた　とりかごが　のっている。/",
  "obj_npc_room_slash_Other_10_gml_21_0": "＊ カートは　なんども　ぶつかった&　 けいせきがある。/%",
  "obj_npc_room_slash_Other_10_gml_32_0": "＊ (たいせつな　リビング用チェア^1…&　 チェアリエルだ)/%",
  "obj_npc_room_slash_Other_10_gml_52_0": "＊ (ただの　マネキンだ)/%",
  "obj_npc_room_slash_Other_10_gml_186_0": "＊ Are you puzzled by COMBAT^1?&＊ Wanna know how TP works?/%",
  "obj_npc_room_slash_Other_10_gml_187_0": "＊ If you still haven't assembled all the details.../",
  "obj_npc_room_slash_Other_10_gml_188_0": "＊ My cohorts to the WEST will gladly help you put the pieces together./%",
  "obj_npc_room_slash_Other_10_gml_193_0": "＊ Your friends can't \\cYACT\\cW alone^1, but they can still help you win peacefully./",
  "obj_npc_room_slash_Other_10_gml_194_0": "＊ The \\cGDARK PRINCE\\cW's \\cYPACIFY\\cW spell can remove \\cBTIRED\\cW enemies safely from battle./",
  "obj_npc_room_slash_Other_10_gml_195_0": "＊ If nothing else^1, why not try using an \\cYITEM\\cW?/",
  "obj_npc_room_slash_Other_10_gml_196_0": "＊ Even if it seems useless^1, the effects may surprise you./%",
  "obj_npc_room_slash_Other_10_gml_200_0": "ボク　気にしないよ！",
  "obj_npc_room_slash_Other_10_gml_201_0": "無料の毒を　お配りしてます！",
  "obj_npc_room_slash_Other_10_gml_202_0": "＊ Do you need an \\cRinteractive tutorial\\cW on \\cRleaving me alone\\cW?/%",
  "obj_npc_room_slash_Other_10_gml_205_0": "＊ What?/",
  "obj_npc_room_slash_Other_10_gml_206_0": "＊ Do you need an \\cRinteractive tutorial\\cW on \\cRleaving me alone\\cW?/%",
  "obj_npc_room_slash_Other_10_gml_214_0": "＊ \\cYDEFENDING\\cW will not only temporarily \\cRreduce the damage\\cW you take.../",
  "obj_npc_room_slash_Other_10_gml_215_0": "＊ It also lets you focus^1, \\cYrestoring TP\\cW. You need \\cYTP\\cW to \\cRCAST SPELLS\\cW!/",
  "obj_npc_room_slash_Other_10_gml_216_0": "＊ So don't be afraid to \\cYDEFEND\\cW^1!&＊ \\cYDEFEND\\cW and \\cYCAST SPELLS\\cW!/",
  "obj_npc_room_slash_Other_10_gml_217_0": "＊ By the way^1, all leftover \\cYTP\\cW will \\cRturn into extra MONEY\\cW after the battle!/%",
  "obj_npc_room_slash_Other_10_gml_221_0": "＊ Getting close to \\cYBULLETS\\cW is really exciting^1, isn't it?/",
  "obj_npc_room_slash_Other_10_gml_222_0": "＊ You'll \\cRrecover a little\\cW \\cYTP\\cW for each \\cYBULLET\\cW you get close to./",
  "obj_npc_room_slash_Other_10_gml_223_0": "＊ Plus^1, \\cRgetting close to bullets\\cW can sometimes end the \\cRenemy's attack faster\\cW./",
  "obj_npc_room_slash_Other_10_gml_224_0": "＊ It's quite \\cRdangerous\\cW though^1.&＊ So no worries if you don't want to try./%",
  "obj_npc_room_slash_Other_10_gml_233_0": "＊ 野球ボールも^1　召し上がれ～^1！&＊ そんで^1　ノドに詰まらせな^1！&＊ このひとたち^1…「スポーツ」食べる？/",
  "obj_npc_room_slash_Other_10_gml_236_0": "＊ (It's a candy tree.^1)&＊ (All the ripe candy has been picked.)/",
  "obj_npc_room_slash_Other_10_gml_238_0": "＊ やだ～　気マズ～い^1…&＊ なに？　またやろうっての！^1？&＊ もう…帰ってくれるかな…/%",
  "obj_npc_room_slash_Other_10_gml_240_0": "＊ ワオ！^1！\n　 アディソンティー！？\n　 アンビリーバブル！！/",
  "obj_npc_room_slash_Other_10_gml_242_0": "＊ Well^1, that's accepting of you.../",
  "obj_npc_room_slash_Other_10_gml_243_0": "＊ ボクは　１人目のパーティメンバー^1。&＊ DPS担当だよ^1。「ダンス・パーティ&　 サウンドトラック」の略ね。/%",
  "obj_npc_room_slash_Other_10_gml_248_0": "＊ (ケータリング担当だったが…)/",
  "obj_npc_room_slash_Other_10_gml_250_0": "\\E7＊ ラルセイ！\n　 この服　イケてんな！\\f0/%",
  "obj_npc_room_slash_Other_10_gml_252_0": "＊ (ケーキをオーダーすると^1き&　 誰もが冒しがちなリスクだ)/%",
  "obj_npc_room_slash_Other_10_gml_254_0": "＊ Then why is it next to it in the store!?/%",
  "obj_npc_room_slash_Other_10_gml_428_0": "＊ おにいちゃんが　あんたに&　 ホットチョコレートを&　 ちゅうもんしてさ…/",
  "obj_npc_room_slash_Other_10_gml_429_0": "＊ あそこの　かどの　テーブルが&　 あんたたちの　とくとうせきで…/",
  "obj_npc_room_slash_Other_10_gml_975_0": "＊ (わたしは　ゴウルデン・サムだ)/%",
  "obj_npc_room_slash_Other_10_gml_249_0": "＊ (…発注してあったケーキが&　 どこかの平原で&　 破壊されてしまった)/%",
  "obj_npc_room_slash_Other_10_gml_281_0": "＊ ほんを　よむのが　だいすきだ^1。&＊ とくに　うえの　かいにある　ほん^1。&＊ キミも　ぜひ。/",
  "obj_npc_room_slash_Other_10_gml_282_0": "＊ よんでみて！/%",
  "obj_npc_room_slash_Other_10_gml_286_0": "＊ ほんを　よむのが　だいすきだ^1。&＊ とくに…/",
  "obj_npc_room_slash_Other_10_gml_287_0": "＊ ほん。/%",
  "obj_npc_room_slash_Other_10_gml_310_0": "＊ おい^1　そこのチビ^1。&＊ おまえみたいな　チビが&　 町長に　なんの用だ？/",
  "obj_npc_room_slash_Other_10_gml_311_0": "＊ こづかいが　すくなくて　ふまんか^1？&＊ おかしの　くいすぎか^1？&＊ フリスビーでも　なくしたか？/",
  "obj_npc_room_slash_Other_10_gml_312_0": "＊ よくきけ^1　チビ…/",
  "obj_npc_room_slash_Other_10_gml_313_0": "＊ そういうのは^1な&　 みーんな　ケーサツの　しごとだよ。/%",
  "obj_npc_room_slash_Other_10_gml_317_0": "＊ ああ^1？　“こども”あつかい&　 すんなって？　フン…わかったよ。/",
  "obj_npc_room_slash_Other_10_gml_318_0": "＊ オムツを　かえてほしけり^1ゃ&　 ケーサツに　たのみな。/%",
  "obj_npc_room_slash_Other_10_gml_323_0": "＊ いやはや　もうしわけございません^1。&＊ 町長は　いま　おいそがしいのです。/",
  "obj_npc_room_slash_Other_10_gml_324_0": "＊ おあいに　なりたけれ^1ば&　 サイアクな　じけんでも&　 おひきおこしください。/%",
  "obj_npc_room_slash_Other_10_gml_328_0": "＊ いやはや　もうしわけございません^1。&＊ たんにんの　せんせいについての&　 くじょうですか？/",
  "obj_npc_room_slash_Other_10_gml_329_0": "＊ あのかたを　さいようしたのは&　 あなたの　おかあさまですから&　 ごふまんがあれば　おかあさまに…/%",
  "obj_npc_room_slash_Other_10_gml_335_0": "＊ 町長の　カリスマせいは　ゼロ^1。&＊ いや^1　むしろ　マイナスだ。/",
  "obj_npc_room_slash_Other_10_gml_336_0": "＊ でも　はたらきものだし　じっせきも&　 あるから^1　たいりつこうほが&　 でてこないのさ。/",
  "obj_npc_room_slash_Other_10_gml_337_0": "＊ せいじってのは…^1　ふつう&　 こうは　ならないけどな。/%",
  "obj_npc_room_slash_Other_10_gml_341_0": "＊ 町長は　つめたい　いんしょうの&　 じんぶつだ^1。しかも　オフィスを&　 エアコンで　ギンギンに　ひやす。/",
  "obj_npc_room_slash_Other_10_gml_342_0": "＊ なかに　はいると　さむけが^1…&＊ これが　せいじという&　 ものなのか…？/%",
  "obj_npc_room_slash_Other_10_gml_431_0": "＊ …/",
  "obj_npc_room_slash_Other_10_gml_389_0": "\\E1＊ いきてたか。/",
  "obj_npc_room_slash_Other_10_gml_391_0": "\\E2＊ よかった。/",
  "obj_npc_room_slash_Other_10_gml_390_0": "\\E0＊ …/",
  "obj_npc_room_slash_Other_10_gml_394_0": "\\E1＊ しごとちゅう。/%",
  "obj_npc_room_slash_Other_10_gml_826_0": "＊ …/",
  "obj_npc_room_slash_Other_10_gml_399_0": "\\E1＊ この　ふくは…/",
  "obj_npc_room_slash_Other_10_gml_400_0": "\\E0＊ せいふく。/%",
  "obj_npc_room_slash_Other_10_gml_406_0": "＊ えーっと^1　「ひがわりランチ」と^1…&　 あ^1　それと&　 しょくようスパンコール　あります？/",
  "obj_npc_room_slash_Other_10_gml_407_0": "＊ したのコは&　 たからものに　みえないと&　 たべてくれなくて…/%",
  "obj_npc_room_slash_Other_10_gml_409_0": "＊ なければ^1　チョコスプレーを&　 まぶすだけでも　いいんですけど…/%",
  "obj_npc_room_slash_Other_10_gml_415_0": "＊ また　いつでも　おいで^1。&　 まってるよ。/%",
  "obj_npc_room_slash_Other_10_gml_421_0": "＊ いらっしゃい^1！&＊ ずいぶん　ひさしぶりじゃないか。/",
  "obj_npc_room_slash_Other_10_gml_423_0": "＊ まえは　よく^1　かぞくみんなで&　 きてくれたけどねえ…/",
  "obj_npc_room_slash_Other_10_gml_424_0": "＊ にちようびの　れいはいの&　 かえりにさ。ちゅうもんは　いつも&　 きまって　「ひがわりランチ」で。/",
  "obj_npc_room_slash_Other_10_gml_425_0": "＊ まあでも^1　あんたたち一家も&　 いろいろあったからねえ…/",
  "obj_npc_room_slash_Other_10_gml_426_0": "＊ もう　かぞく　そろって&　 きてくれることは&　 なくなっちまったけど。/",
  "obj_npc_room_slash_Other_10_gml_427_0": "＊ それでも^1　まいしゅう&　 にちようびには　おにいちゃんと&　 ２人で　きてくれてたねえ。/",
  "obj_npc_room_slash_Other_10_gml_430_0": "＊ …まどガラスに　いきを&　 ふきかけちゃ^1　ゆびで&　 えを　かいたりしてさ…/",
  "obj_npc_room_slash_Other_10_gml_398_0": "＊ …/",
  "obj_npc_room_slash_Other_10_gml_432_0": "＊ おにいちゃんが　いなくなっちまっ^1て&　 さみしいだろ？/",
  "obj_npc_room_slash_Other_10_gml_433_0": "＊ …ほら^1　これのんで&　 げんきだしなよ。/",
  "obj_npc_room_slash_Other_10_gml_434_0": "＊ (クリスは　ホットチョコレートを&　 てにいれた)/",
  "obj_npc_room_slash_Other_10_gml_435_0": "＊ おだいは　いらないよ。&　 サービスさ。/%",
  "obj_npc_room_slash_Other_10_gml_442_0": "＊ …ホントなら^1　ホットチョコレートを&　 サービスしてあげたいとこだけど…/",
  "obj_npc_room_slash_Other_10_gml_443_0": "＊ …どうやら　もちものが&　 いっぱいみたいだねえ。/",
  "obj_npc_room_slash_Other_10_gml_444_0": "＊ きをつけて　かえるんだよ。/%",
  "obj_npc_room_slash_Other_10_gml_468_0": "＊ ごちゅうもんを　くりかえします^1。&　 クレープが　おひとつ^1…&　 シナモンラテが　おひとつ…/",
  "obj_npc_room_slash_Other_10_gml_469_0": "＊ ウサパフェが　おふたつと…&　 たきぎが　１ぽん^1…&　 いじょうで　よろしいかしら？/%",
  "obj_npc_room_slash_Other_10_gml_472_0": "＊ たきぎの　やきかげんは？/%",
  "obj_npc_room_slash_Other_10_gml_482_0": "＊ てか^1　おぼえてる^1？　よく&　 いちじかんめの　じゅぎょう&　 サボって^1　ここ　きたじゃん？/",
  "obj_npc_room_slash_Other_10_gml_483_0": "＊ アンタは　セーフだったけ^1ど&　 アタシは　そのせいで　りゅうねん&　 しかけてさ…/",
  "obj_npc_room_slash_Other_10_gml_484_0": "＊ んでも　しょーがなくない！^1？&　 ここのクレープ　ぜっぴんだもん^1！&　 わるいことは　ミツのあじ！/%",
  "obj_npc_room_slash_Other_10_gml_487_0": "＊ たべきれなかったぶんを　ガーソンに&　 もってってやったおかげで　なんとか&　 そつぎょうできたけどさー…/%",
  "obj_npc_room_slash_Other_10_gml_496_0": "＊ ボクの　このたくましいカラダに^1は&　 どんなヒミツが　かくされているか&　 きになるでしょ…？/",
  "obj_npc_room_slash_Other_10_gml_497_0": "＊ ボク　じつはね^1…　たべのこしの&　 パンケーキを^1　このでっかいぼうしに&　 いれてるんだ。/%",
  "obj_npc_room_slash_Other_10_gml_501_0": "＊ ボク　パンケーキ　だあいすき！/%",
  "obj_npc_room_slash_Other_10_gml_507_0": "＊ アイスウルフ^1　のみものに&　 こおり　いれる^1　すきじゃない。/",
  "obj_npc_room_slash_Other_10_gml_508_0": "＊ アイスウルフ　すきな^1の&　 こおり…/",
  "obj_npc_room_slash_Other_10_gml_509_0": "＊ …を　のむこと！/%",
  "obj_npc_room_slash_Other_10_gml_513_0": "＊ アイスウル^1フ&　 こおりの　ゆるキャラも^1　すき。/%",
  "obj_npc_room_slash_Other_10_gml_620_0": "＊ ど^1…どど^1…どうしよう^1…&　 あおい　おんなのひとが　じゃまで^1…&　 すすめないよ…！/",
  "obj_npc_room_slash_Other_10_gml_621_0": "＊ こ^1…ここ^1…これは　ひょっとして^1…&　 「にげろ」ってことなのか…？/%",
  "obj_npc_room_slash_Other_10_gml_625_0": "＊ アンダインしょちょうは&　 こうつうせいりを　している&　 はずなのに…/",
  "obj_npc_room_slash_Other_10_gml_626_0": "＊ じっさいは　どうろの　まんなかで&　 「じゃまだ！！　どけ！！」と&　 さけんでいるだけだ。/",
  "obj_npc_room_slash_Other_10_gml_627_0": "＊ すばらしいとは　おもわないかね！^1？&　 これぞまさに&　 せいりされている　というものだ！/%",
  "obj_npc_room_slash_Other_10_gml_691_0": "＊ オッス^1！&＊ スージィに&　 ころされなかったんだな！　ハハハ！/",
  "obj_npc_room_slash_Other_10_gml_692_0": "＊ スージィが　ホントに　だれかを&　 ブッとばすとこ　みたわけじゃない&　 けどさ^1　きをつけたほうがいーぜ！/",
  "obj_npc_room_slash_Other_10_gml_693_0": "＊ まえにさ^1　オレと^1　ライちゃん^1と&　 ジョッキントンで　ハンドボール&　 してたら…/",
  "obj_npc_room_slash_Other_10_gml_694_0": "＊ スージィが　ずーっと　すみっこで&　 こっち　みてたことがあってさ^1。&　 すっげーブキミでさ^1！　んで…/",
  "obj_npc_room_slash_Other_10_gml_695_0": "＊ ボールが　スージィのほうへ&　 ころがっても^1　あいつ　なーんも&　 せずに　つったったままで^1。したら…/",
  "obj_npc_room_slash_Other_10_gml_696_0": "＊ …スージィのやつ^1　きゅうにボールを&　 おもいっきりけっ^1て　それがパトカー&　 ちょくげきして^1　アンダインさんが…/",
  "obj_npc_room_slash_Other_10_gml_697_0": "＊ ニコニコしながら　こぶしをボキボキ&　 ならして　おりてきて^1　ハンドボール&　 やって^1　オレたち　ボロまけしてさ！/",
  "obj_npc_room_slash_Other_10_gml_698_0": "＊ よーするに^1　スージィは&　 サイテーだってことだな！&　 ハハハ！ /%",
  "obj_npc_room_slash_Other_10_gml_702_0": "＊ オッス^1！　クリス…どうした^1？&　 ビミョーな　かおして。&＊ なんか　イラついてんのか？/",
  "obj_npc_room_slash_Other_10_gml_703_0": "＊ おちつけって^1！&　 ここには　もう　スージィは&　 いないんだからさ！　ハハハ！/",
  "obj_npc_room_slash_Other_10_gml_704_0": "＊ …あれ^1？&＊ なんだよ　もっとイラついたみたいな&　 かおして…/%",
  "obj_npc_room_slash_Other_10_gml_710_0": "＊ いやぁ～^1！&＊ クリスはん^1　あんた&　 ラッキーやったなあ！/",
  "obj_npc_room_slash_Other_10_gml_711_0": "＊ アルフィーせんせの　じゅぎょう&　 うけずに　すんだやないか^1！&　 ワーッハッハ！/",
  "obj_npc_room_slash_Other_10_gml_712_0": "＊ ワテが　じゅぎょう　サボった^1ら&　 オトンに　えんえん　せっきょう&　 されますわ^1！　ワーッハッハ！/",
  "obj_npc_room_slash_Other_10_gml_713_0": "＊ …いや^1　ぜんぜん&　 わらえまへんがな。/%",
  "obj_npc_room_slash_Other_10_gml_731_0": "＊ こりゃ　どうも　ゴキンジョさん^1！&　 おにいちゃんの　ジョンくんは&　 いつ　あそびにくるのかな？/",
  "obj_npc_room_slash_Other_10_gml_732_0": "＊ むすめたちも　よろこぶからねえ^1！&　 ジョンくん^1　やさしくて&　 いいコだから！/",
  "obj_npc_room_slash_Other_10_gml_733_0": "＊ ま　ひとつ　なんてんを　あげる&　 なら^1…　カミさんの　てりょうりが&　 くちに　あわないところかな！/",
  "obj_npc_room_slash_Other_10_gml_734_0": "＊ ジョンくん^1　れいとうキャット&　 フードの　よさが　わからないとは！&＊ はは！　ははは！　ははははは！/%",
  "obj_npc_room_slash_Other_10_gml_738_0": "＊ きみの　おにいちゃんが　まちを&　 でたのも^1　ムリないよねえ。/",
  "obj_npc_room_slash_Other_10_gml_739_0": "＊ いまごろ^1　「おおきい　がっこう」で&　 おおきい　のうミソを　てにいれてる&　 ところでしょう。/",
  "obj_npc_room_slash_Other_10_gml_740_0": "＊ しょうらい　おおモノに　なっても&　 ごきんじょに　すんでた　わたしらを&　 わすれないで　ほしいよねえ。/",
  "obj_npc_room_slash_Other_10_gml_741_0": "＊ オレンジをたべては　胃をせんじょう&　 してもらってた　ネコ一家とし^1て&　 おぼえといて　ほしいよねえ。/%",
  "obj_npc_room_slash_Other_10_gml_796_0": "＊ あら^1　いらっしゃい^1。&＊ また　ピアノを　ひきに　きたの？/",
  "obj_npc_room_slash_Other_10_gml_797_0": "＊ かんじゃさんたちには　あんまり&　 きこえないけど^1　わたしは&　 たのしく　きかせてもらってるわ。/%",
  "obj_npc_room_slash_Other_10_gml_801_0": "＊ ときどき　けいさつしょの&　 しょちょうさんも　きて&　 ピアノを　ひいていくの。/",
  "obj_npc_room_slash_Other_10_gml_802_0": "＊ あのひと　ピアノは&　 じょうずなんだけ^1ど&　 うたいはじめると…/",
  "obj_npc_room_slash_Other_10_gml_803_0": "＊ おかえりいただくしか&　 なくなっちゃうのよね。/%",
  "obj_npc_room_slash_Other_10_gml_809_0": "＊ うーん^1…　あなた　いつもはもっと^1…&　 きれいな　ねいろを&　 かなでるのにね。/",
  "obj_npc_room_slash_Other_10_gml_810_0": "＊ きょうは　どうしたの^1？&＊ そういえば　ちょっと&　 ぐあいが　わるそうね…/%",
  "obj_npc_room_slash_Other_10_gml_821_0": "＊ あいぼうと　みずうみで　すごす&　 ひとときに　まさるものは　ねェよ…/",
  "obj_npc_room_slash_Other_10_gml_822_0": "＊ すいめんを　わたってく　なみを&　 ただ　ながめンのさ…/%",
  "obj_npc_room_slash_Other_10_gml_388_0": "＊ …/",
  "obj_npc_room_slash_Other_10_gml_827_0": "＊ …どうかんだ。/%",
  "obj_npc_room_animated_slash_Other_10_gml_8_0": "＊ 理由は　その　痛み自体。/%",
  "obj_npc_room_animated_slash_Other_10_gml_15_0": "＊ ピーツア　いかがスかぁ！&　 24しゅるいの　フレーバー^1の&　 ピーツアは　いかがスかぁ～！/",
  "obj_npc_room_animated_slash_Other_10_gml_16_0": "＊ ノーマルあじに…/",
  "obj_npc_room_animated_slash_Other_10_gml_17_0": "＊ チーズあじに…/",
  "obj_npc_room_animated_slash_Other_10_gml_18_0": "＊ こおりあじに…/",
  "obj_npc_room_animated_slash_Other_10_gml_19_0": "＊ にくじゅうあじに…/",
  "obj_npc_room_animated_slash_Other_10_gml_20_0": "＊ ダブルこおりあじに…/",
  "obj_npc_room_animated_slash_Other_10_gml_21_0": "＊ ピーパロニあじに…/",
  "obj_npc_room_animated_slash_Other_10_gml_22_0": "＊ …ほかにも　まだまだた～っくさん^1！&＊ 「ぶるどっ君ピーツア^1」&　 ぜひ　ごしょうみください！/%",
  "obj_npc_room_animated_slash_Other_10_gml_26_0": "＊ …ゆるキャラのボクが　とっておきの&　 ヒミツをおしえてあげよう^1。ボクが&　 ここで　はたらきはじめたのはね…/",
  "obj_npc_room_animated_slash_Other_10_gml_27_0": "＊ ロゴをみて　アイスクリーム&　 ショップだと　かんちがいしたから&　 なんだ…/",
  "obj_npc_room_animated_slash_Other_10_gml_28_0": "＊ でも　いつのまにか^1　このしごと^1も&　 しょくばの　なかまのこと^1も&　 だいすきになっちゃって^1！　フフフ！/%",
  "obj_npc_room_animated_slash_Other_10_gml_35_0": "＊ アイス　プリーズ^1！&＊ アイス　プリーズ^1　ボス！！/%",
  "obj_npc_room_animated_slash_Other_10_gml_40_0": "＊ (うーわ^1　マジで　ひとが&　 きやがった…)&＊ あー…　えーっと…/",
  "obj_npc_room_animated_slash_Other_10_gml_41_0": "＊ ぶるどっ君“ピ”ーツア^1…&　 “ピー”ピッときたら　たべどき！&　 ナンバーNo.1ピーツアの　みせだよ！/",
  "obj_npc_room_animated_slash_Other_10_gml_42_0": "＊ …/",
  "obj_npc_room_animated_slash_Other_10_gml_43_0": "＊ …あ^1　…アンタ！/",
  "obj_npc_room_animated_slash_Other_10_gml_44_0": "＊ アンタ　しってるぞ！/%",
  "obj_npc_room_animated_slash_Other_10_gml_51_0": "＊ ここの　ウエイトレスさんの&　 ノリが　すき^1。&＊ わたしも　ここでバイトしようかな…/",
  "obj_npc_room_animated_slash_Other_10_gml_52_0": "＊ …やめた^1。ドリンクをだす&　 しごとって　火のエレメンタルには&　 むいてないよね。/",
  "obj_npc_room_animated_slash_Other_10_gml_53_0": "＊ きんちょうする^1と&　 こおりを　ぜんぶ&　 とかしちゃいそうだし。/%",
  "obj_npc_room_animated_slash_Other_10_gml_56_0": "＊ でも^1　コーヒーだけ　だせば^1…&＊ ダメダメ^1　ぜったい　おきゃくさんに&　 うったえられる…/%",
  "obj_npc_room_animated_slash_Other_10_gml_62_0": "＊ (ラジカセだ^1)&＊ (“クラブ”ミュージックが&　 かかっている)/%",
  "obj_npc_sign_slash_Other_10_gml_10_0": "＊ 記号を　解読できない…&＊ 手で書いてあるせいかもしれない。/%",
  "obj_npc_sign_slash_Other_10_gml_68_0": "＊ (Hathy, in case you wanted to make us a birthday gift...)/",
  "obj_npc_sign_slash_Other_10_gml_69_0": "＊ (My favorite things are trees^1, boys^1, and sports!)&＊ (SIGNED^1, CLOVER)/%",
  "obj_npc_sign_slash_Other_10_gml_32_0": "＊ (パパの　トラックだ)/",
  "obj_npc_sign_slash_Other_10_gml_33_0": "＊ (フロントシートの　あしもとには&　 ふるい　かみクズや　カントリーの&　 CDが　ちらばっている)/%",
  "obj_npc_sign_slash_Other_10_gml_55_0": "＊ (ママのバンだ)/%",
  "obj_npc_susiedark_slash_Other_10_gml_13_0": "＊ お^1　死んでなかったか^2。&＊ そりゃ　なにより。/",
  "obj_npc_susiedark_slash_Other_10_gml_14_0": "\\E2＊ で？　ここが　なんなのか&　 わかったか？/",
  "obj_npc_susiedark_slash_Other_10_gml_15_0": "\\E0＊ …だよな。&　 オレにも　さっぱりだ。/",
  "obj_npc_susiedark_slash_Other_10_gml_16_0": "＊ そこの家に&　 だれか　住んでねーかな？/%",
  "obj_npc_susiedark_slash_Other_10_gml_20_0": "＊ ひょっとしたら　廃虚の&　 テーマパークとかかもな。/",
  "obj_npc_susiedark_slash_Other_10_gml_21_0": "\\E0＊ いや　でも^1…&　 乗り物が　ねえか…/",
  "obj_npc_susiedark_slash_Other_10_gml_22_0": "\\E2＊ 乗り物が　ねえから&　 廃虚に　なったのかもな。/%",
  "obj_npc_toriel_slash_Other_10_gml_2_0": "＊ Hello there^1!&＊ How are you doing on this fine day?/%",
  "obj_overworldc_slash_Step_0_gml_34_0": "＊ ~1を&　 じめんに　おいて&　 「おつかれさま」と　なでてあげた。",
  "obj_overworldc_slash_Step_0_gml_36_0": "＊ ~1を&　 ゴミのように　なげすてた。",
  "obj_overworldc_slash_Step_0_gml_38_0": "＊ ~1を&　 すてた。",
  "obj_overworldc_slash_Step_0_gml_42_0": "＊ タマゴ？　なんのこと？/%",
  "obj_overworldc_slash_Draw_0_gml_42_0": "ITEM",
  "obj_overworldc_slash_Draw_0_gml_43_0": "STAT",
  "obj_overworldc_slash_Draw_0_gml_44_0": "PHONE",
  "obj_overworldc_slash_Draw_0_gml_52_0": "USE",
  "obj_overworldc_slash_Draw_0_gml_53_0": "INFO",
  "obj_overworldc_slash_Draw_0_gml_54_0": "DROP",
  "obj_overworldc_slash_Draw_0_gml_66_0": "“~1”",
  "obj_placeholderenemy_slash_Step_0_gml_11_0": "Message&A",
  "obj_placeholderenemy_slash_Step_0_gml_12_0": "Message&B",
  "obj_placeholderenemy_slash_Step_0_gml_13_0": "Message&C",
  "obj_placeholderenemy_slash_Step_0_gml_14_0": "Message&D",
  "obj_placeholderenemy_slash_Step_0_gml_16_0": "WlyWlyWlyWly&WlyWlyWlyWly&WlyWlyWlyWly&WlyWlyWlyWly",
  "obj_placeholderenemy_slash_Step_0_gml_63_0": "＊ Placeholder Message A.",
  "obj_placeholderenemy_slash_Step_0_gml_64_0": "＊ Placeholder Message B.",
  "obj_placeholderenemy_slash_Step_0_gml_65_0": "＊ Placeholder Message C.",
  "obj_placeholderenemy_slash_Step_0_gml_66_0": "＊ Placeholder Message D.",
  "obj_placeholderenemy_slash_Step_0_gml_99_0": "A special&scenario&occurred!!/%",
  "obj_placeholderenemy_slash_Step_0_gml_135_0": "＊ エネミー - ATK 1 DEF 1&＊ 私は　敵です。/%",
  "obj_placeholderenemy_slash_Step_0_gml_146_0": "＊ You warned the enemy^1.&＊ It guarded from Susie's attack./%",
  "obj_placeholderenemy_slash_Step_0_gml_147_0": "(Warned)",
  "obj_placeholderenemy_slash_Step_0_gml_156_0": "＊ Its body was filled with a kind feeling./%",
  "obj_placeholderenemy_slash_Step_0_gml_164_0": "＊ Its body will result in a kind feeling at the end of the combat./%",
  "obj_placeholderenemy_slash_Step_0_gml_172_0": "＊ Its body will result in a speech after attack./%",
  "obj_placeholderenemy_slash_Step_0_gml_180_0": "＊ Its body became tired./%",
  "obj_placeholderenemy_slash_Step_0_gml_181_0": "(Tired)",
  "obj_ponman_enemy_slash_Step_0_gml_64_0": "＊ ポンマンは&　 一歩ずつ　前進している。",
  "obj_ponman_enemy_slash_Step_0_gml_65_0": "＊ ポンマンには　耳がない^1。&　 それでも　行儀よく聞いている。",
  "obj_ponman_enemy_slash_Step_0_gml_66_0": "＊ ポンマンは　こちらの&　 待機モーションに　見とれている。",
  "obj_ponman_enemy_slash_Step_0_gml_67_0": "＊ ポンマンは　なぞめいた視線で&　 こちらを見ている。",
  "obj_ponman_enemy_slash_Step_0_gml_68_0": "＊ ポン菓子のニオイがする。",
  "obj_ponman_enemy_slash_Step_0_gml_69_0": "＊ ポンマンは&　 目を開くのも　やっとだ。",
  "obj_ponman_enemy_slash_Step_0_gml_70_0": "＊ ポンマンの体は　膨張している。",
  "obj_ponman_enemy_slash_Step_0_gml_71_0": "＊ ポンマンは　ぐっすり眠っている。",
  "obj_ponman_enemy_slash_Step_0_gml_72_0": "＊ 敵たちは　ラルセイの子守歌を聴いて&　 眠くなった！",
  "obj_ponman_enemy_slash_Step_0_gml_106_0": "＊ ポンマン - ATK 8 DEF 0&＊ 核の部分が　視覚器官としても機能。/%",
  "obj_ponman_enemy_slash_Step_0_gml_114_0": "＊ ポンマンに&　 「おやすみ」と　ささやいた^1。&＊ ポンマンは　眠りにおちた…/%",
  "obj_ponman_enemy_slash_Step_0_gml_134_0": "＊ ラルセイは　やさしい声で&　 心安らぐ子守歌を歌った！/%",
  "obj_ponman_enemy_slash_Step_0_gml_150_0": "＊ ラルセイと２人で^1　ポンマンに&　 けいこくした。「スージィに注意！」&＊ 敵は　みがまえた。/%",
  "obj_ponman_enemy_slash_Step_0_gml_152_0": "＊ ラルセイと２人で^1　敵に&　 けいこくした。「スージィに注意！」&＊ 敵は全員　みがまえた。/%",
  "obj_ponman_enemy_slash_Step_0_gml_186_0": "＊ ポンマンは　眠りにおちた^1！&＊ 敵たちは　くたびれた！/%",
  "obj_ponman_enemy_slash_Step_0_gml_198_0": "＊ ポンマンは　眠りにおちた^1！&＊ スージィは　眠りにおちた^1！&＊ 敵たちは　くたびれた！/%",
  "obj_pushableblock_slash_Other_10_gml_61_0": "＊ (You haven't decided if you want to do the puzzle yet.)/%",
  "obj_pushableblock_slash_Other_10_gml_66_0": "＊ (もう　動かない)/%",
  "obj_pushableblock_slash_Other_10_gml_74_0": "＊ What!^1?&＊ The puzzle!?/",
  "obj_pushableblock_slash_Other_10_gml_75_0": "\\E0＊ I thought you were on MY side^1, Kris./",
  "obj_pushableblock_slash_Other_10_gml_76_0": "\\E2＊ ... wait a sec^1.&＊ Those boxes...^1!&＊ I get it!/",
  "obj_pushableblock_slash_Other_10_gml_77_0": "＊ Wait a second^1, Kris!/%",
  "obj_ralseienemy_slash_Step_0_gml_36_0": "＊ .../%",
  "obj_ralseienemy_slash_Step_0_gml_42_0": "＊ See that \\cRHEART\\cW, Kris?/",
  "obj_ralseienemy_slash_Step_0_gml_43_0": "＊ That's a \\cRSOUL\\cW, the culmination of a HUMAN's being!/",
  "obj_ralseienemy_slash_Step_0_gml_44_0": "＊ Not only does it represent one's WILL and COMPASSION.../",
  "obj_ralseienemy_slash_Step_0_gml_45_0": "＊ But it also has the power to DETERMINE FATE./",
  "obj_ralseienemy_slash_Step_0_gml_46_0": "＊ When enemies attack, BULLETS appear./",
  "obj_ralseienemy_slash_Step_0_gml_47_0": "＊ Please avoid them and protect your team's FATE!/",
  "obj_ralseienemy_slash_Step_0_gml_48_0": "＊ Ready^1, Kris^2?&＊ Let's try dodging!/%",
  "obj_ralseienemy_slash_Step_0_gml_65_0": "＊ That's DEFENDING^1, Kris^1.&＊ You'll recover TP and take less damage./",
  "obj_ralseienemy_slash_Step_0_gml_66_0": "\\E8＊ It's not part of this lesson^1, though./%",
  "obj_ralseienemy_slash_Step_0_gml_70_0": "＊ Gee^1, Kris^1!&＊ You sure are good at defending!/",
  "obj_ralseienemy_slash_Step_0_gml_71_0": "\\E8＊ I'm not attacking^1, you^1, though, so...&＊ No need to defend!/%",
  "obj_ralseienemy_slash_Step_0_gml_77_0": "＊ Ummm..^1.&＊ Kris?/",
  "obj_ralseienemy_slash_Step_0_gml_78_0": "\\E8＊ There are no bullets^1, and you can't use TP.../",
  "obj_ralseienemy_slash_Step_0_gml_79_0": "\\E8＊ So^1, umm^1, maybe you could stop defending?/%",
  "obj_ralseienemy_slash_Step_0_gml_86_0": "＊ .../%",
  "obj_ralseienemy_slash_Step_0_gml_96_0": "＊ You've got an item^1!&＊ That's^1, um^1, great^1, Kris.../%",
  "obj_ralseienemy_slash_Step_0_gml_107_0": "＊ W-wow^1, Kris^1!&＊ That was an amazing attack!/",
  "obj_ralseienemy_slash_Step_0_gml_108_0": "\\E8＊ Have you done this before or something...?/",
  "obj_ralseienemy_slash_Step_0_gml_112_0": "＊ Good job^1, Kris^1!&＊ By the way^1, you'll do more damage.../",
  "obj_ralseienemy_slash_Step_0_gml_113_0": "\\E8＊ Pressing Z when the cursor is RIGHT IN the box on the left!/",
  "obj_ralseienemy_slash_Step_0_gml_118_0": "＊ Kris^1!&＊ You did it!!!/",
  "obj_ralseienemy_slash_Step_0_gml_119_0": "\\E8＊ (I was really just about at my limit...)/%",
  "obj_ralseienemy_slash_Step_0_gml_121_0": "\\E1＊ Umm^1, anyway, let's move onto my favorite: \\cYACTING\\cW!/",
  "obj_ralseienemy_slash_Step_0_gml_122_0": "\\E0＊ Selecting the ACT ICON will let you do all sorts of things./",
  "obj_ralseienemy_slash_Step_0_gml_123_0": "\\E8＊ We'll even be able to get through battles without ATTACKing!/%",
  "obj_ralseienemy_slash_Step_0_gml_124_0": "＊ Select the ACT ICON and HUG the Dummy!",
  "obj_ralseienemy_slash_Step_0_gml_130_0": "＊ Ummm..^1. Kris^1?&＊ You don't need to hit it anymore./",
  "obj_ralseienemy_slash_Step_0_gml_131_0": "\\E8＊ I already know you're great at attacking!/%",
  "obj_ralseienemy_slash_Step_0_gml_137_0": "＊ Hey^1, Kris^1?&＊ I know you like attacking^1, but.../",
  "obj_ralseienemy_slash_Step_0_gml_138_0": "\\E8＊ Did you know you can win without having to?/%",
  "obj_ralseienemy_slash_Step_0_gml_144_0": "＊ .../",
  "obj_ralseienemy_slash_Step_0_gml_145_0": "\\E1＊ Kris^1, could you^1, um^1, stop...?/%",
  "obj_ralseienemy_slash_Step_0_gml_154_0": "＊ Oh^1, sorry^1, Kris^1!&＊ I forgot to mention^1!&＊ When you're ATTACKing.../",
  "obj_ralseienemy_slash_Step_0_gml_155_0": "\\E8＊ Press Z again when the cursor goes in the box!/%",
  "obj_ralseienemy_slash_Step_0_gml_159_0": "＊ It's OK^1, Kris^1!&＊ You'll get it^1!&＊ Try again!/%",
  "obj_ralseienemy_slash_Step_0_gml_160_0": "＊ Press Z when the white rectangle's in the blue box!/%",
  "obj_ralseienemy_slash_Step_0_gml_161_0": "＊ Ummm..^1. you can press Z a lot^1, if it helps!/%",
  "obj_ralseienemy_slash_Step_0_gml_162_0": "＊ Kris..^1.&＊ Please try to press Z./%",
  "obj_ralseienemy_slash_Step_0_gml_163_0": "＊ Ummm^1, Kris^1?&＊ Can you see the white rectangle?/%",
  "obj_ralseienemy_slash_Step_0_gml_164_0": "＊ You know rectangles^1?&＊ They're like messed-up squares?/%",
  "obj_ralseienemy_slash_Step_0_gml_168_0": "＊ .../%",
  "obj_ralseienemy_slash_Step_0_gml_173_0": "＊ Umm^1, why don't we try something else?/%",
  "obj_ralseienemy_slash_Step_0_gml_174_0": "＊ Select the ACT ICON and HUG the Dummy!",
  "obj_ralseienemy_slash_Step_0_gml_187_0": "＊ .../",
  "obj_ralseienemy_slash_Step_0_gml_188_0": "\\E8＊ Hey^1, Kris^1, I think I've^1, um.../",
  "obj_ralseienemy_slash_Step_0_gml_189_0": "\\E1＊ Reached the limits of what I can teach you today./",
  "obj_ralseienemy_slash_Step_0_gml_190_0": "\\E0＊ Let's go find Susie./%",
  "obj_ralseienemy_slash_Step_0_gml_195_0": "＊ .../",
  "obj_ralseienemy_slash_Step_0_gml_196_0": "＊ Kris^1, it's um.../",
  "obj_ralseienemy_slash_Step_0_gml_197_0": "\\E3＊ Really hard for me to teach when you're hitting me./",
  "obj_ralseienemy_slash_Step_0_gml_198_0": "\\E8＊ Let's take a break and go find Susie^1, OK?/%",
  "obj_ralseienemy_slash_Step_0_gml_212_0": "＊ K-Kris!?/",
  "obj_ralseienemy_slash_Step_0_gml_213_0": "\\E1＊ Y-you must have missed...&＊ H... Haha.../",
  "obj_ralseienemy_slash_Step_0_gml_218_0": "\\E3＊ W-wait^1, aren't you supposed to be ACTing!?/%",
  "obj_ralseienemy_slash_Step_0_gml_222_0": "\\E3＊ A-anyway^1, now that you know how to attack.../",
  "obj_ralseienemy_slash_Step_0_gml_223_0": "\\E8＊ Let's try learning how to ACT^1, OK?/%",
  "obj_ralseienemy_slash_Step_0_gml_224_0": "＊ Select the ACT ICON and HUG the Dummy!",
  "obj_ralseienemy_slash_Step_0_gml_231_0": "＊ K-Kris!^1?&＊ D-did you miss again!?/",
  "obj_ralseienemy_slash_Step_0_gml_232_0": "\\E1＊ .../",
  "obj_ralseienemy_slash_Step_0_gml_233_0": "\\E2＊ Though^1, I mean^1, if you wanted to hit me^1, that's ok, too.../%",
  "obj_ralseienemy_slash_Step_0_gml_288_0": "＊ Ralsei looks on expectedly.",
  "obj_ralseienemy_slash_Step_0_gml_334_0": "＊ Yipee^1!&＊ You did it^1, Kris!/%",
  "obj_ralseienemy_slash_Step_0_gml_343_0": "＊ O-oopsie..^2.&＊ Was that too many?/",
  "obj_ralseienemy_slash_Step_0_gml_344_0": "\\E8＊ Here^1, let's try just one!/%",
  "obj_ralseienemy_slash_Step_0_gml_369_0": "＊ Yipee^1!&＊ You did it^1, Kris!/%",
  "obj_ralseienemy_slash_Step_0_gml_378_0": "＊ .../%",
  "obj_ralseienemy_slash_Step_0_gml_399_0": "\\E8＊ L-look^1, Kris^1!&＊ You dodged one!/%",
  "obj_ralseienemy_slash_Step_0_gml_410_0": "＊ Now^1, let's talk about \\cYSELECTING COMMANDS\\cW./",
  "obj_ralseienemy_slash_Step_0_gml_411_0": "＊ These ICONS will let you ISSUE COMMANDS to YOUR TEAM./",
  "obj_ralseienemy_slash_Step_0_gml_412_0": "\\E0＊ The first ICON^1, THE SWORD^1, is the ATTACK COMMAND./",
  "obj_ralseienemy_slash_Step_0_gml_413_0": "\\E1＊ Using it lets you^1, um..^1.&＊ Hurt people.../",
  "obj_ralseienemy_slash_Step_0_gml_414_0": "\\E8＊ ... w-well^1, I guess we have to defend ourselves sometimes^1, right?/%",
  "obj_ralseienemy_slash_Step_0_gml_427_0": "＊ Select the SWORD ICON to ATTACK the Dummy!/%",
  "obj_ralseienemy_slash_Step_0_gml_447_0": "＊ RALSEI - AT 8 DF 12&＊ The fluffy prince.../%",
  "obj_ralseienemy_slash_Step_0_gml_464_0": "＊ You hug RALSEI./%",
  "obj_ralseienemy_slash_Step_0_gml_504_0": "＊ K..^1. Kris!?/%",
  "obj_ralseienemy_slash_Step_0_gml_508_0": "＊ K..^1. Kris!?/",
  "obj_ralseienemy_slash_Step_0_gml_509_0": "\\E8＊ Ummm^1, I don't think^1, um.../",
  "obj_ralseienemy_slash_Step_0_gml_510_0": "＊ This is what you're supposed to be doing./",
  "obj_ralseienemy_slash_Step_0_gml_511_0": "\\E2＊ (But I don't really want to tell you to stop...)/%",
  "obj_ralseienemy_slash_Step_0_gml_516_0": "＊ Kris!?/",
  "obj_ralseienemy_slash_Step_0_gml_517_0": "\\E2＊ Umm^1, if that's what you r-really want.../",
  "obj_ralseienemy_slash_Step_0_gml_518_0": "\\E8＊ Then that's a victory in my book^1!&＊ You win!/%",
  "obj_ralseienemy_slash_Step_0_gml_575_0": "H-hey^1, wait&a second.../",
  "obj_ralseienemy_slash_Step_0_gml_576_0": "My bike's&running&out of&gas...!/",
  "obj_ralseienemy_slash_Step_0_gml_577_0": "Alright,&you punk-&a-roos!/",
  "obj_ralseienemy_slash_Step_0_gml_578_0": "You got&got lucky&this time!/",
  "obj_ralseienemy_slash_Step_0_gml_579_0": "But next&time^1,&you're&gonna&suffer!!!/",
  "obj_ralseienemy_slash_Step_0_gml_580_0": "See you&in the&next hell^1,&losers!/%",
  "obj_ralseithrown_slash_Step_0_gml_23_0": "＊ ミス！/%",
  "obj_readable_slash_Other_10_gml_2_0": "＊ ボクが　見える…？/%",
  "obj_readable_room1_slash_Other_10_gml_13_0": "＊ とつぜん^1　からだが　けいれんした^1。&＊ いったい　なにを　みている？/%",
  "obj_readable_room1_slash_Other_10_gml_21_0": "＊ ベッドのしたに　CDがある^1。&＊ クラシック…^1　ジャズ…^1　きょうかい&　 おんがくの　スカ・リミックス…/",
  "obj_readable_room1_slash_Other_10_gml_22_0": "＊ テレビゲームも　ある^1。&＊ ２つの　コントローラーのう^1ち&　 ひとつは　ひせいき品だ。/%",
  "obj_readable_room1_slash_Other_10_gml_36_0": "＊ パソコンデスクだ^1。&＊ したには　ふるい　ほんが　つまった&　 はこが　いくつも　おいてある。/%",
  "obj_readable_room1_slash_Other_10_gml_54_0": "＊ ひきだしは　ほぼ　からっぽ^1。&　 でも　ひとつだけ&　 なにか　はいっている…/",
  "obj_readable_room1_slash_Other_10_gml_55_0": "＊ がっこうの　クロスカントリー部の&　 ユニフォームだ。&　 ちょっと　やぶれている。/%",
  "obj_readable_room1_slash_Other_10_gml_56_0": "＊ かなり　ふるい　がくせいしょうだ。&　 かみがたが　ダサい。/%",
  "obj_readable_room1_slash_Other_10_gml_59_0": "＊ クーポンブックだ^1。&＊ ぜんぶの　クーポンに「Ｌサイズの&　 ピザ50％オフ」と　かいてある。/",
  "obj_readable_room1_slash_Other_10_gml_60_0": "＊ ゆうこう　きげんは&　 いんさつされた日より　まえに&　 きれている。/%",
  "obj_readable_room1_slash_Other_10_gml_64_0": "＊ つかえそうな　ものは&　 なにも　はいっていない。/%",
  "obj_readable_room1_slash_Other_10_gml_80_0": "＊ きょうは　ステキな日だ。/%",
  "obj_readable_room1_slash_Other_10_gml_91_0": "＊ ようふくが　はいっている。/%",
  "obj_readable_room1_slash_Other_10_gml_96_0": "＊ じぶんの　ベッドだ。/%",
  "obj_readable_room1_slash_Other_10_gml_112_0": "＊ カーペットに　しみが　ある。/%",
  "obj_readable_room1_slash_Other_10_gml_120_0": "＊ とびらには　カギが　かかっている。/%",
  "obj_readable_room1_slash_Other_10_gml_127_0": "＊ じぶんの　すがたが&　 うつっているだけ。/%",
  "obj_readable_room1_slash_Other_10_gml_141_0": "＊ ひきだしに　クレヨンが　はいって&　 いる^1。ラベルは　いろあせている^1。&　 みどりいろが　みあたらない。/%",
  "obj_readable_room1_slash_Other_10_gml_169_0": "＊ サボテンだ^1。&＊ とくに　コメントはない。/%",
  "obj_readable_room1_slash_Other_10_gml_177_0": "＊ ほんが　たくさん　ならんでいる。/",
  "obj_readable_room1_slash_Other_10_gml_178_0": "＊ 「カタツムリの　おはなし」/",
  "obj_readable_room1_slash_Other_10_gml_179_0": "＊ 「かがくてき　じじつ：&　 カタツムリには　おはなしをする&　 のうりょくは　ない」/",
  "obj_readable_room1_slash_Other_10_gml_180_0": "＊ 「カタツムリが　おにわを&　 きれいに　する？&　 （…てことは　ありません）」/",
  "obj_readable_room1_slash_Other_10_gml_181_0": "＊ 「ニンゲンとモンスターのれきし」&　 ちょしゃの　ガーソン・ブームの&　 サインが　はいっている。/%",
  "obj_readable_room1_slash_Other_10_gml_184_0": "＊ いまは　ほん　なんて&　 よんでいる　じかんは　ない。/%",
  "obj_readable_room1_slash_Other_10_gml_211_0": "＊ はいすいこうには　しろい&　 どうぶつの　けが　つまっている。/%",
  "obj_readable_room1_slash_Other_10_gml_217_0": "＊ コンロには　シナモンが　まざった&　 パイきじが　こびりついている。/%",
  "obj_readable_room1_slash_Other_10_gml_220_0": "＊ (バタースコッチ　シナモンパイだ^1)&＊ (まだ　さめきっていない)/%",
  "obj_readable_room1_slash_Other_10_gml_226_0": "＊ (ジンジャーブレッド用の&　 クッキーがたが　２しゅるい^1…&　 モンスターと　ニンゲンのかたちだ)/%",
  "obj_readable_room1_slash_Other_10_gml_231_0": "＊ ゴミばこだ^1。&＊ なぜか^1　はなの　よいかおりが&　 ただよっている。/%",
  "obj_readable_room1_slash_Other_10_gml_234_0": "＊ ゴミばこだ^1。&＊ なぜか^1　はなの　かおりが&　 つよくなっている。/%",
  "obj_readable_room1_slash_Other_10_gml_240_0": "＊ こていでんわ　だ^1。&＊ でも　けいたいでんわを&　 もっている。/%",
  "obj_readable_room1_slash_Other_10_gml_245_0": "＊ テレビだ^1。&＊ いまはもう　コンセントも&　 つながれていないようだ。/%",
  "obj_readable_room1_slash_Other_10_gml_251_0": "＊ きょうかいで　うたう&　 うたの　ほんだ。/%",
  "obj_readable_room1_slash_Other_10_gml_263_0": "＊ シャワーのわきの　たなに^1は&　 リンゴのかおりの　シャンプーが&　 はいった　ちいさな　ようきがある。/",
  "obj_readable_room1_slash_Other_10_gml_264_0": "＊ …その　となりには　４リットル&　 サイズの　ペット用シャンプーの&　 ようきがある。/%",
  "obj_readable_room1_slash_Other_10_gml_273_0": "＊ シンクの　うえにある&　 たなの　なかを　のぞいた^1。&＊ なにか　はいっている…/",
  "obj_readable_room1_slash_Other_10_gml_274_0": "＊ 「ぶるどっ君の　メンズ　ボディ&　 スプレー　(ゲキカラ　ピザあじ)」と&　 かかれたスプレーだ。/",
  "obj_readable_room1_slash_Other_10_gml_275_0": "＊ ほとんど　つかわれた&　 けいせきが　ない。/%",
  "obj_readable_room1_slash_Other_10_gml_335_0": "＊ ロッカーは　ロックされている。/%",
  "obj_readable_room1_slash_Other_10_gml_336_0": "＊ ロッカーの　ロックは&　 ロックされている。/%",
  "obj_readable_room1_slash_Other_10_gml_337_0": "＊ ロックの　ロッカーは&　 ロックされている。/%",
  "obj_readable_room1_slash_Other_10_gml_338_0": "＊ ロッカーの　ロックの　ロッカーは&　 ロックされている。/%",
  "obj_readable_room1_slash_Other_10_gml_339_0": "＊ ロッカーは　ロックされている。/%",
  "obj_readable_room1_slash_Other_10_gml_344_0": "＊ (ロッカーには&　 ジョッキントン・グッズが&　 ベタベタ　はってある)/%",
  "obj_readable_room1_slash_Other_10_gml_349_0": "＊ (つぎの　ダンスパーティは&　 女子が　男子を　さそうばん！)/",
  "obj_readable_room1_slash_Other_10_gml_350_0": "＊ (「セイディ・ホークマンの日」&　 という　ふるい　しゅうかんに&　 ちなんだ　パーティです)/",
  "obj_readable_room1_slash_Other_10_gml_351_0": "＊ (みんな　タカのかぶりものを&　 かぶって^1　キーキーわめきながら&　 おどりましょう！)/%",
  "obj_readable_room1_slash_Other_10_gml_356_0": "＊ (すりガラスごしに&　 なかを　のぞいた)/",
  "obj_readable_room1_slash_Other_10_gml_357_0": "＊ (きいろい　なにかが^1　たくさんの&　 たいくつそうな　なにかに&　 なにかを　おしえている)/%",
  "obj_readable_room1_slash_Other_10_gml_362_0": "＊ (みずを　だしてみた^1)&＊ (なまあたたかい)/%",
  "obj_readable_room1_slash_Other_10_gml_363_0": "＊ (みずを　だしてみた^1)&＊ (なまぬるい)/%",
  "obj_readable_room1_slash_Other_10_gml_364_0": "＊ (みずを　だしてみた^1)&＊ (つめたくて　きもちいい)/%",
  "obj_readable_room1_slash_Other_10_gml_368_0": "＊ (ウォータークーラーの&　 みずを　のんだ)/",
  "obj_readable_room1_slash_Other_10_gml_370_0": "＊ ヘヘ^1…しってるか^1？&　 それ　くちつけて&　 のむヤツも　いるんだぜ？/%",
  "obj_readable_room1_slash_Other_10_gml_375_0": "＊ (ものおきだなの　なかに&　 トランプが　ちらばっている)/%",
  "obj_readable_room1_slash_Other_10_gml_382_0": "＊ いきを　するのが　すき^1！なひと！&　 はやく　いどうするのが　すき^1！な&　 ひと！(あしを　つかわなくても！)/",
  "obj_readable_room1_slash_Other_10_gml_383_0": "＊ (…でも^1　ふつうは　あしを&　 つかって！)/",
  "obj_readable_room1_slash_Other_10_gml_384_0": "＊ ジョッキントンと^1　ノエルしゅさい^1の&　 クロスカントリー・チームに&　 はいりませんか！？/%",
  "obj_readable_room1_slash_Other_10_gml_390_0": "＊ (ロッカーだ^1。ロックされている)/%",
  "obj_readable_room1_slash_Other_10_gml_396_0": "＊ (おにいちゃんが　つかっていた&　 ロッカーだ)/%",
  "obj_readable_room1_slash_Other_10_gml_400_0": "＊ (じぶんの　ロッカーだ^1)&＊ (なにも　はいっていない)/%",
  "obj_readable_room1_slash_Other_10_gml_409_0": "＊ (とけいを　みた)/",
  "obj_readable_room1_slash_Other_10_gml_410_0": "＊ (じゅぎょうが　はじまる&　 じかんの　ようだ)/%",
  "obj_readable_room1_slash_Other_10_gml_414_0": "＊ (とけいを　みた)/",
  "obj_readable_room1_slash_Other_10_gml_415_0": "＊ (…じゅぎょうの　じかんでは&　 ないようだ)/%",
  "obj_readable_room1_slash_Other_10_gml_423_0": "＊ えと^1…　クリス^1　できれば…/",
  "obj_readable_room1_slash_Other_10_gml_424_0": "\\E0＊ …このクラスの　ひとと&　 ペアに　なってくださいね？/%",
  "obj_readable_room1_slash_Other_10_gml_431_0": "＊ (パソコンの　かべがみを　みた。&　 しぜんの　ふうけいの　がぞうが&　 きりかわる　スライドショーだ)/",
  "obj_readable_room1_slash_Other_10_gml_432_0": "＊ (…まれに^1　ムキムキのスーパー&　 ヒーロー２人が　だきあい^1　かおを&　 あからめている　がぞうに　かわる)/%",
  "obj_readable_room1_slash_Other_10_gml_436_0": "＊ (パソコンの　でんげんは&　 おとしてある)/",
  "obj_readable_room1_slash_Other_10_gml_437_0": "＊ (つかのま^1　すべてが　へいおんに&　 かんじられた)/%",
  "obj_readable_room1_slash_Other_10_gml_453_0": "＊ (バラが　なんぼんも　かびんに&　 さしてある)/%",
  "obj_readable_room1_slash_Other_10_gml_459_0": "＊ (いろいろな　ぶんがくさくひんから&　 いんようした　めいげんが&　 はってある)/",
  "obj_readable_room1_slash_Other_10_gml_460_0": "＊「アストラル・ウルフよ^1　しりょくを&　 つくせ^1！　たとえ　ふかいやみの&　 なかに　いようとも！」/",
  "obj_readable_room1_slash_Other_10_gml_461_0": "＊ (…これは　ゲームのセリフ？)/%",
  "obj_readable_room1_slash_Other_10_gml_473_0": "＊ (ホワイトボードに&　 「トリエルせんせい」と&　 かいてある)/",
  "obj_readable_room1_slash_Other_10_gml_474_0": "＊ (ずいぶん　ながいこと&　 けさずに　のこしてあるようだ)/%",
  "obj_readable_room1_slash_Other_10_gml_480_0": "＊ (パソコンだ)/",
  "obj_readable_room1_slash_Other_10_gml_481_0": "＊ (かべがみは^1　ハロウィンの　かそう&　 をした　じぶんと　おにいちゃんの&　 しゃしん^1。８ねんまえの　ものだ)/%",
  "obj_readable_room1_slash_Other_10_gml_510_0": "＊ (せいとから　せんせいに　しばしば&　 みつがれる　しょくひんだ)/%",
  "obj_readable_room1_slash_Other_10_gml_521_0": "＊ (きほんてきな　ずけいの&　 ポスターだ^1)&＊ (えん…だえん…せいほうけい…)/",
  "obj_readable_room1_slash_Other_10_gml_522_0": "＊ (正120胞体…)/%",
  "obj_readable_room1_slash_Other_10_gml_526_0": "＊ (こどもむけの　ほんだ^1)&＊ (なんさつかは　じぶんが　むかし&　 つかっていたものだ)/%",
  "obj_readable_room1_slash_Other_10_gml_530_0": "＊ (ママを　えがいた&　 げんしてきな　えだ)/%",
