  "scr_text_slash_scr_text_gml_388_0": "＊ (ダークキャンディを　手に入れた)/%",
  "scr_text_slash_scr_text_gml_393_0": "＊ (持ちものが　いっぱいだ)/%",
  "scr_text_slash_scr_text_gml_399_0": "＊ (そのまま　木に持たせておく&　 ことにした)/%",
