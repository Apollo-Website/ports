                ONEBUFFER = 1;
                TWOBUFFER = 1;
                MENU_NO = 2;
                SELNOISE = 1;
            }
            else
            {
                MENUCOORD[0] = 5;
                ONEBUFFER = 1;
                TWOBUFFER = 1;
                MENU_NO = 0;
                SELNOISE = 1;
            }
        }
        
