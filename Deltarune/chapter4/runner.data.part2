    }
    
    if (kr_actor.image_index >= 8)
        kr_actor.image_speed = 0;
    
    if (kick_loop_timer == 8)
        swing_snd = 1;
    
    if (kick_loop_timer == 12)
    {
        with (trashcan)
        {
