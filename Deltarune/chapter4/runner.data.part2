  "DEVICE_NAMER_slash_Other_10_gml_41_0": "BRATTY",
  "DEVICE_NAMER_slash_Other_10_gml_42_0": "GERSON",
  "DEVICE_NAMER_slash_Other_10_gml_43_0": "JOCKINGTON",
  "DEVICE_NAMER_slash_Other_10_gml_44_0": "QC",
  "obj_debug_choicer_slash_Draw_0_gml_105_0": "\\C4 ",
  "obj_npc_sign_slash_Other_10_gml_200_0": "オレがいないときに#勝手に触んなよ！",
  "obj_savemenu_slash_Draw_0_gml_215_0": "スロット~1に上書きしますか？",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_105_0": "ホッホッホ！　なんてスバラシイ冒険少年体験！#アンヨを伸ばして　のんびりするぞ…",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_109_0": "ウ～ララ～！　おヒゲが　ステキな　あの少年！#ボクさま　恋に落ちちゃいそう！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_114_0": "(ひぃ…ふぅ…)おまえのポッケに　もどったぞ！#ボクさまのパワー　いつでも使ってOKだ！",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_126_0": "やや！　余は我が君の　忠実なる僕。逃げたり#なんて　しておらズ　ずーっといましたけど？",
  "scr_monstersetup_slash_scr_monstersetup_gml_1099_0": "もっと赤く#(２段階)",
  "scr_monstersetup_slash_scr_monstersetup_gml_1103_0": "もっと青く#(２段階)",
  "scr_monstersetup_slash_scr_monstersetup_gml_1107_0": "もっと赤く#(１段階)",
  "scr_monstersetup_slash_scr_monstersetup_gml_1111_0_b": "もっと青く#(１段階)",
  "scr_text_slash_scr_text_gml_7296_0_b": "#はい",
  "scr_text_slash_scr_text_gml_7297_0_b": "#いいえ",
  "scr_text_slash_scr_text_gml_7680_0": "書いたんだよ",
  "DEVICE_MENU_slash_Draw_0_gml_284_0": "チャプター選択",
  "DEVICE_MENU_slash_Draw_0_gml_285_0": "終了",
  "scr_gamestart_slash_scr_gamestart_gml_396_0": "クリス",
  "obj_npc_room_slash_Other_10_gml_1106_0": "\\E9＊ おおーー！　ランサー^1！&　 どうだよ　体の調子は？/",
  "obj_npc_room_slash_Other_10_gml_1108_0": "\\E3＊ (ひぃ^1…　ふぅ…^1)&　 元気100パーだ^1ぞ&　 ムラサキフレンド！/",
  "obj_npc_room_slash_Other_10_gml_1110_0_b": "\\EK＊ …ホントか？&　 苦しそうじゃねーか。/",
  "obj_npc_room_slash_Other_10_gml_1112_0": "\\E2＊ クリスの「ポケット」から&　 飛び降りたから^1　ちょっと&　 息切れしてるだけ！/",
  "obj_npc_room_slash_Other_10_gml_1113_0": "\\E3＊ ボクさまは　「アイテム」の&　 なかに　いるから^1　自由に&　 町を　おどけ歩くといいぞ！/",
  "obj_npc_room_slash_Other_10_gml_1115_0": "\\EA＊ おう^1。&　 なんかよくわかんねーけ^1ど&　 そうするぜ。/%",
  "obj_npc_room_slash_Other_10_gml_1119_0": "\\E3＊ スージィ　スージィ^1！&　 また　おんぶしてくれる？/",
  "obj_npc_room_slash_Other_10_gml_1121_0_b": "\\EY＊ ヘッ^1　いいぜ^1！　ただし^1…&　 オレが　全速力で走って^1も&　 振り落とされんなよ！/",
  "obj_npc_room_slash_Other_10_gml_1123_0_b": "\\E1＊ スージィ・トレイン！^1！&　 キャッスルタウンの&　 目玉アトラクション！！/",
  "obj_npc_room_slash_Other_10_gml_1125_0": "\\EJ＊ …/",
  "obj_npc_room_slash_Other_10_gml_1127_0": "\\EH＊ ラルセイ！^1　クリスも^1！&　 こそっと　ならぼうと&　 してんじゃねーよ！/%",
  "obj_savemenu_slash_Draw_0_gml_371_0": "セーブしました",
  "obj_shop_ch2_music_slash_Draw_0_gml_343_0": "あなたたちは誰？",
  "obj_fusionmenu_slash_Draw_0_gml_70_0": "図鑑",
  "obj_fusionmenu_slash_Draw_0_gml_83_0": "図鑑",
  "obj_fusionmenu_slash_Draw_0_gml_84_0_b": "終了",
  "obj_fusionmenu_slash_Draw_0_gml_169_0": "配置",
  "obj_fusionmenu_slash_Draw_0_gml_186_0": "もどる",
  "obj_fusionmenu_slash_Draw_0_gml_199_0": "を押してもどる",
  "obj_fusionmenu_slash_Step_0_gml_462_0": "   　配置   　もどる",
  "scr_monstersetup_slash_scr_monstersetup_gml_1685_0": "高速#チャージ",
  "scr_monstersetup_slash_scr_monstersetup_gml_1701_0": "旋回#シールド",
  "obj_npc_room_slash_Other_10_gml_1121_0_c": "\\E3＊ スージィ　スージィ^1！&　 おんぶして？/",
  "scr_text_slash_scr_text_gml_7658_0": "＊ (シャドウジェムを手に入れた)/",
  "obj_b1boardend_slash_Step_0_gml_45_0": "＊ Time for a physical challenge!!!/%",
  "obj_b1rocks2_slash_Step_0_gml_53_0": "Whatever, I'm just going to wait for Kris to pull us to the next screen.",
  "obj_b1rocks2_slash_Step_0_gml_77_0": "Stupid rocks!!",
  "obj_b1rocks2_slash_Step_0_gml_112_0": "It’s easy if you hold something over your head",
  "obj_b1rocks2_slash_Step_0_gml_218_0": "Uh oh!#Watch out#for falling#peaches!!",
  "obj_b1rocks2_slash_Step_0_gml_225_0": "Peaches?#But I thought#that they were#rocks.",
  "obj_b1rocks2_slash_Step_0_gml_232_0": "I don't know where you got that idea.",
  "obj_b1rocks2_slash_Step_0_gml_233_0": "I have no#clue where you#got that idea.",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_31_0": "Oh! Look, grey blocks!",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_36_0": "Kris, let's solve this puzzle together!",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_69_0": "Cool, I get to do nothing.",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_110_0": "Hahaha! We did it...!",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_116_0": "Heh, finally having fun?",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_121_0": "H-huh? Well, um...",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_130_0": "How 'bout we stay as these characters...",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_135_0": "Until there's something cool to throw?",
  "obj_b2bridgepuzzle2_slash_Step_0_gml_140_0": "... okay!",
  "obj_b2camera_slash_Step_0_gml_135_0": "FABULOUS^1! JUST FABULOUS!/",
  "obj_b2camera_slash_Step_0_gml_136_0": "DO YOU THINK YOU COULD PHOTOGRAPH ME TOO?/%",
  "obj_b2camera_slash_Step_0_gml_213_0": "RAFT APPEARS IN#THE RIVER",
  "obj_b2camera_slash_Step_0_gml_215_0": "THE FINAL PHOTO#THE THREE HEROES",
  "obj_b2fashionshop2_slash_Create_0_gml_55_0": "インキョ　シマスワ。",
  "obj_b2greenx_slash_Step_0_gml_239_0": "Those are some weird looking blocks.",
  "obj_b2greenx_slash_Step_0_gml_244_0": "Those are no ordinary blocks! This room presents a challenge!",
  "obj_b2greenx_slash_Step_0_gml_249_0": "Oh, I think you can push these blocks around.",
  "obj_b2greenx_slash_Step_0_gml_254_0": "See? He gets it!",
  "obj_b2sphinxvoucher_slash_Step_0_gml_19_0": "Congrats kids, you've earned it!",
  "obj_board_1_sword_shadowtease_slash_Create_0_gml_8_0": "まだだ",
  "obj_board_b2tornflower_slash_Step_0_gml_6_0": "THIS CACTUS APPEARS TO BE IN BLOOM./%",
  "obj_board_event_intro_slash_Step_0_gml_29_0": "Now begin! Our state of the art... Modern electronic video adventure!!!",
  "obj_board_event_intro_slash_Step_0_gml_46_0": "Looks like crap.",
  "obj_board_event_intro_slash_Step_0_gml_60_0": "SUSIE!",
  "obj_board_event_intro_slash_Step_0_gml_67_0": "It's cutting edge!!!",
  "obj_gameover_band_slash_Step_0_gml_35_0": "＊ ラルセイちゃ～ん^1！\n　 すぅ～ばらし～い\n　 パフォーマンスでしたぁ～！/%",
  "obj_gameover_band_slash_Step_0_gml_54_0": "＊ が^1！　他のメンバーが\n　 お話にならな～い！！/%",
  "obj_gameover_band_slash_Step_0_gml_73_0": "＊ (…ひょっとしたら^1　時代を先取り\n　 しすぎた　プログレメタルかも\n　 しれませんがッ！)/%",
  "obj_gameover_band_slash_Step_0_gml_88_0": "＊ ダイジョ～ブ！^1　問題ナ～シ^1！\n　 敏腕マネージャーが　すでに\n　 次のSHOWを　ブッキング済み！！/",
  "obj_gameover_band_slash_Step_0_gml_89_0": "＊ 開演は…/%",
  "obj_gameover_band_slash_Step_0_gml_106_0": "＊ …３　秒　後　！？/%",
  "obj_gameover_band_slash_Step_0_gml_125_0": "＊ はいッ！^1　スタンバイしてッ^1！\n　 レッツ　\\O0　アゲインッ！/%",
  "obj_gameover_band_slash_Step_0_gml_158_0": "＊ オ～～ノ～～^1！\n　 ま～た　ゲームオーバーだぁ～！！/",
  "obj_gameover_band_slash_Step_0_gml_163_0": "＊ 客席からトマトが飛んでくるぅ～！！/",
  "obj_gameover_band_slash_Step_0_gml_164_0": "＊ …でも^1　お料理コーナーで\n　 全部　使っちゃったから\n　 セ～～フ！/%",
  "obj_gameover_band_slash_Step_0_gml_167_0": "＊ 本番中に　フリージャズセッションの\n　 練習するの　やめてくださ～い！！/%",
  "obj_gameover_band_slash_Step_0_gml_170_0": "＊ 気合い入れて！　ラブ・アンド・\n　 ピースな歴史的コンサートの\n　 出演者になったつもりで！/",
  "obj_gameover_band_slash_Step_0_gml_171_0": "＊ …アレ？^1　…伝わってない^1？\n　 伝わってない！　オッケー！/%",
  "obj_gameover_band_slash_Step_0_gml_187_0": "＊ はい！！^1　もうね　これは\n　 観覧席とお茶の間に　カネを\n　 バラまくしかないですネ！！/",
  "obj_gameover_band_slash_Step_0_gml_188_0": "＊ これでもう　「人気度」は\n　 下がりません！^1！\n　 好きにやっちゃって！！！/%",
  "obj_gameover_band_slash_Step_0_gml_209_0": "＊ よ～し^1　もういっかい^1！\n　 レッツ　\\O0　アゲインッ^1！/%",
  "obj_pippins_enemy_slash_Step_0_gml_26_0": "(それすると\nワイたちの　こうげき\n強なりまっせ…？)",
  "obj_pippins_enemy_slash_Step_0_gml_28_0": "(この　おじょーちゃん\n“スゴロク”度胸が\nありまんなぁ…)",
  "obj_pippins_enemy_slash_Step_0_gml_29_0": "(ギャモ～ン！\nなにしてくれて\nますのん！？)",
  "obj_pippins_enemy_slash_Step_0_gml_38_0": "４にタッチ！\nアンタに\nできますかいな！？",
  "obj_pippins_enemy_slash_Step_0_gml_39_0": "よろしおま！\n緑の４に\n全額ベット！！",
  "obj_pippins_enemy_slash_Step_0_gml_42_0": "勝てるか…？\nそれとも\n…でっかく\n勝てるか？",
  "obj_pippins_enemy_slash_Step_0_gml_43_0": "さー！\n張った張った張ったー！",
  "obj_pippins_enemy_slash_Step_0_gml_44_0": "ワイを振って ばらまいて\nそこらじゅう\n転がしとくんなはれ！",
  "obj_pippins_enemy_slash_Step_0_gml_47_0": "この世は\nラッキーなワールドでっせ！\nノルか ソルか！",
  "obj_pippins_enemy_slash_Step_0_gml_48_0": "ノラん ソラん！",
  "obj_pippins_enemy_slash_Step_0_gml_49_0": "チャラン ポラン！",
  "obj_pippins_enemy_slash_Step_0_gml_51_0": "人生は 数字のゲーム…\n聞いたことありますやろ？",
  "obj_pippins_enemy_slash_Step_0_gml_118_0": "＊ ピピンズは　命がけのジャンケンゲームを\n　 仕掛けようとした。",
  "obj_pippins_enemy_slash_Step_0_gml_119_0": "＊ ピピンズは\n　 ポップコーンのように　はねた。",
  "obj_pippins_enemy_slash_Step_0_gml_120_0": "＊ ピピンズの　存在のせいで\n　 審査の結果　このシーンの\n　 レーティングが　「Ｃ」になった。",
  "obj_pippins_enemy_slash_Step_0_gml_121_0": "＊ ピピンズは　トイレットペーパーでできた\n　 スクラッチくじを　スクラッチした。",
  "obj_pippins_enemy_slash_Step_0_gml_122_0": "＊ ピピンズは　緑の家を２軒\n　 抵当に入れたことを　後悔した。",
  "obj_pippins_enemy_slash_Step_0_gml_123_0": "＊ ピピンズは　他の敵たちの負けに\n　 賭けた。",
  "obj_pippins_enemy_slash_Step_0_gml_125_0": "＊ 悪運のニオイがする。",
  "obj_pippins_enemy_slash_Step_0_gml_130_0": "＊ ピピンズは\n　 ツキに見放されているようだ。",
  "obj_pippins_enemy_slash_Step_0_gml_134_0": "\\E2んでだよ？　クリスは\nオレでプレイしたほうが\n楽しいんだぜ？",
  "obj_pippins_enemy_slash_Step_0_gml_135_0": "\\EDKえっ…　そうなの…？\nでも…それじゃ混乱しちゃうよ？",
  "obj_pippins_enemy_slash_Step_0_gml_136_0": "\\E9ラルセイ混乱させんのが\nこのゲームの　だいご味だぜ。\nだよな　クリス？",
  "obj_pippins_enemy_slash_Step_0_gml_137_0": "\\EO＊ 楽しいならいいけど！　でも\n　 ボクはやっぱり　クリスには\n　 クリスでいてほしいな。",
  "obj_pippins_enemy_slash_Step_0_gml_170_0": "＊ ピピンズ - ATK \\I0  DEF \\I1 \n＊ カルタス城の　イカサマギャンブラー。\n　 賭けるときは　ドカンと一気に！/%",
  "obj_pippins_enemy_slash_Step_0_gml_185_0": "＊ 緑の４のときに　サイコロに触れると\n　 宣言した！/%",
  "obj_pippins_enemy_slash_Step_0_gml_191_0": "＊ 賭けに出た。\n　 緑の４に　触れろ！",
  "obj_pippins_enemy_slash_Step_0_gml_217_0": "＊ スージィは　サイコロ全部に\n　 点を４つ描いた！\n　 敵は　くたびれた！/%",
  "obj_pippins_enemy_slash_Step_0_gml_229_0": "＊ スージィは　イカサマに飽きて\n　 ラルセイの顔に　ヒゲを描いた！/%",
  "obj_pippins_enemy_slash_Step_0_gml_241_0": "＊ スージィは　イカサマに飽きて\n　 クリスの顔に　死んだサバのような\n　 目を描いた！/%",
  "obj_pippins_enemy_slash_Step_0_gml_271_0": "賭けるときは\nドカンと一気に…だろ！？/%",
  "obj_pippins_enemy_slash_Step_0_gml_296_0": "＊ ラルセイと２人で\n　 敵に　150ポイントの\n　 わいろを　わたした！/%",
  "obj_pippins_enemy_slash_Step_0_gml_317_0": "わわわいろ…！？\nちがいます！ これは\n仲よしのしるしの\nプレゼントで…！",
  "obj_pippins_enemy_slash_Step_0_gml_337_0": "わいろ？ ひゃー\nそれ 違法ちゃいますのん？",
  "obj_pippins_enemy_slash_Step_0_gml_349_0": "汚ねー手だな",
  "obj_pippins_enemy_slash_Step_0_gml_363_0": "ま…待ってください！\nやっぱり いまのは…",
  "obj_pippins_enemy_slash_Step_0_gml_390_0": "待って！！",
  "obj_pippins_enemy_slash_Step_0_gml_416_0": "誤解です…\nちがうんです…",
  "obj_pippins_enemy_slash_Step_0_gml_446_0": "＊ スージィは　ピピンズを振り回した！\n　 ピピンズは　ちょっと　よろこんでいる！/%",
  "obj_pippins_enemy_slash_Step_0_gml_452_0": "＊ スージィは　ピピンズを振り回した！",
  "obj_pippins_enemy_slash_Step_0_gml_464_0": "＊ ラルセイは　イカサマはしないと誓った！/",
  "obj_pippins_enemy_slash_Step_0_gml_465_0": "＊ スージィは　イカサマすると誓った！\n　 (意味が　なかった…)/%",
  "obj_pippins_enemy_slash_Step_0_gml_471_0": "＊ ラルセイは　イカサマはしないと誓った！",
  "obj_pippins_enemy_slash_Step_0_gml_58_0": "こりゃァ\nクセになりますな！",
  "obj_ribbick_enemy_slash_Step_0_gml_44_0": "Lost\nLost\nLost girl",
  "obj_ribbick_enemy_slash_Step_0_gml_45_0": "シクシク\nえんえん\n泣き虫くん",
  "obj_ribbick_enemy_slash_Step_0_gml_50_0": "散らかり\nグチャグチャちゃん",
  "obj_ribbick_enemy_slash_Step_0_gml_51_0": "らんぼう\nメチャクチャちゃん",
  "obj_ribbick_enemy_slash_Step_0_gml_52_0": "もっさり\nボサボサくん",
  "obj_ribbick_enemy_slash_Step_0_gml_53_0": "プ～ンと\nサイレントくん",
  "obj_ribbick_enemy_slash_Step_0_gml_57_0": "グゥルルルル～",
  "obj_ribbick_enemy_slash_Step_0_gml_58_0": "わん",
  "obj_ribbick_enemy_slash_Step_0_gml_59_0": "ドドドン\nテテテン\nどないしてん？",
  "obj_ribbick_enemy_slash_Step_0_gml_60_0": "ぴゃん ぴゃん",
  "obj_ribbick_enemy_slash_Step_0_gml_67_0": "さっぱり\nスイートちゃん",
  "obj_ribbick_enemy_slash_Step_0_gml_68_0": "すっきり\nナイスちゃん",
  "obj_ribbick_enemy_slash_Step_0_gml_69_0": "ふんわり\nクリーンくん",
  "obj_ribbick_enemy_slash_Step_0_gml_70_0": "さわやか\nフレッシュくん",
  "obj_ribbick_enemy_slash_Step_0_gml_75_0": "ドゥルルルル～",
  "obj_ribbick_enemy_slash_Step_0_gml_76_0": "にゃあ",
  "obj_ribbick_enemy_slash_Step_0_gml_77_0": "ドドドン\nタタタン\nどうしたん？",
  "obj_ribbick_enemy_slash_Step_0_gml_78_0": "ぴょん ぴょん",
  "obj_ribbick_enemy_slash_Step_0_gml_79_0": "ウサギは\nカエルの\n続編だよ",
  "obj_ribbick_enemy_slash_Step_0_gml_155_0": "＊ フロックは　おどるゴミ箱と\n　 なかよくなりたい。",
  "obj_ribbick_enemy_slash_Step_0_gml_156_0": "＊ カラシの　ツンとするニオイが\n　 充満している。",
  "obj_ribbick_enemy_slash_Step_0_gml_157_0": "＊ フロックは　舞台裏の床に\n　 栄養素を補給した。",
  "obj_ribbick_enemy_slash_Step_0_gml_158_0": "＊ フロックは　うめくような\n　 カビを発した。",
  "obj_ribbick_enemy_slash_Step_0_gml_160_0": "＊ フロックは　ヤバいぐらい\n　 きれいになってきた。",
  "obj_ribbick_enemy_slash_Step_0_gml_161_0": "＊ フロックは　最高に汚くなった\n　 が　問題ない。",
  "obj_ribbick_enemy_slash_Step_0_gml_172_0": "＊ ほこりの下から\n　 本物のラビックが出てきた！",
  "obj_ribbick_enemy_slash_Step_0_gml_208_0": "＊ タイミングよく　~1を押せ！",
  "obj_ribbick_enemy_slash_Step_0_gml_291_0": "ラビック",
  "obj_ribbick_enemy_slash_Step_0_gml_340_0": "＊ 敵は　フッ飛ばされた！/%",
  "obj_ribbick_enemy_slash_Step_0_gml_343_0": "＊ えっ！　ニセモノ！？/%",
  "obj_ribbick_enemy_slash_Step_0_gml_344_0": "＊ さらに汚れた自分を　あらわにした！/%",
  "obj_ribbick_enemy_slash_Step_0_gml_345_0": "＊ 何も起こらなかった！/%",
  "obj_ribbick_enemy_slash_Step_0_gml_346_0": "＊ もっと汚くなった！/%",
  "obj_ribbick_enemy_slash_Step_0_gml_364_0": "＊ スージィは　敵をもっと汚くした！\n　 敵は　よろこんでいる！/%",
  "obj_ribbick_enemy_slash_Step_0_gml_371_0": "＊ スージィは　汚れを生成した！",
  "obj_ribbick_enemy_slash_Step_0_gml_372_0": "＊ スージィは　クツ底のガムを見せた！",
  "obj_ribbick_enemy_slash_Step_0_gml_373_0": "＊ スージィは　汚い言葉を使った！",
  "obj_ribbick_enemy_slash_Step_0_gml_391_0": "＊ ラルセイは　敵をそうじしようとした！\n　 敵は　くたびれた…/%",
  "obj_ribbick_enemy_slash_Step_0_gml_398_0": "＊ ラルセイは　整理整とんを試みた！",
  "obj_ribbick_enemy_slash_Step_0_gml_399_0": "＊ ラルセイは　はたきを使った！",
  "obj_ribbick_enemy_slash_Step_0_gml_400_0": "＊ ラルセイは　同情するように鳴いた！",
  "obj_ribbick_enemy_slash_Step_0_gml_198_0": "＊ フロック - AT 8x2 DF 1x2\n＊ わたぼこりの　かたまり。\n　 大汚し　してほしい。/%",
  "obj_round_evaluation_slash_Draw_64_gml_164_0": "成績",
  "obj_round_evaluation_slash_Draw_64_gml_177_0": "バトル",
  "obj_round_evaluation_slash_Draw_64_gml_195_0": "リアルチャレンジ",
  "obj_round_evaluation_slash_Draw_64_gml_304_0": "シークレットボーナス",
  "obj_shop_vending_slash_Draw_0_gml_122_0": "~1 PTs",
  "obj_shop_vending_slash_Draw_0_gml_153_0": "SOLD OUT",
  "obj_shop_vending_slash_Draw_0_gml_223_0": "買う？",
  "obj_shop_vending_slash_Draw_0_gml_225_0": "はい",
  "obj_shop_vending_slash_Draw_0_gml_226_0": "いいえ",
  "obj_shop_vending_slash_Draw_0_gml_149_0": "$~1",
  "obj_shop_vending_slash_Draw_0_gml_196_0": "D$ ~1で",
  "obj_shop_vending_slash_Draw_0_gml_456_0": "D$ ~1と",
  "obj_shop_vending_slash_Draw_0_gml_457_0": "はい",
  "obj_shop_vending_slash_Draw_0_gml_458_0": "いいえ",
  "obj_tenna_board4_enemy_slash_Step_0_gml_291_0": "BUT DON'T THINK&IT'S GONNA&BE EASY!!&BECAUSE TODAY.../%",
  "obj_tenna_board4_enemy_slash_Step_0_gml_292_0": "WE'VE GOT AN&ALL-STAR CAST!/%",
  "obj_tenna_board4_enemy_slash_Step_0_gml_293_0": "BLUR!/%",
  "obj_victory_rhythm_slash_Step_0_gml_20_0": "\\EH＊ すごい^1！　大好評だね！\n　 なんだか　ホンモノの\n　 ロックスターになった気分！/",
  "obj_victory_rhythm_slash_Step_0_gml_22_0": "\\E9＊ ヤバかったな^1！\n　 まあ　でも…/",
  "obj_victory_rhythm_slash_Step_0_gml_23_0": "\\EL＊ ほぼ　オレひとりの\n　 ステージだったけどな^1。\n　 ２人ともギリギリだったぜ。/%",
  "obj_victory_rhythm_slash_Step_0_gml_29_0": "\\EK＊ …スージィ^1？\n　 本気で言ってる？/%",
  "obj_victory_rhythm_slash_Step_0_gml_35_0": "＊ バンドに　モメごとは　つきもの^1！\n　 さっそく　解散の危機だぁ！！/%",
  "obj_victory_rhythm_slash_Step_0_gml_41_0": "＊ 彼らが　リアルに一流のバンドである\n　 証しです！/",
  "obj_victory_rhythm_slash_Step_0_gml_42_0": "＊ というわけで^1…\n　 ２つめのパークも　終了^1！\n　 お次は　みなさんお待ちかねの…/",
  "obj_victory_rhythm_slash_Step_0_gml_43_0": "＊ 結果発表～～～！！！/%",
  "obj_zapper_enemy_slash_Step_0_gml_41_0": "エンカク\nソウサ",
  "obj_zapper_enemy_slash_Step_0_gml_42_0": "ミスター・テナの\nお達しなんでね",
  "obj_zapper_enemy_slash_Step_0_gml_43_0": "はい\nID見せろ～",
  "obj_zapper_enemy_slash_Step_0_gml_44_0": "このボタンは\nかざりじゃ\nねえんだ",
  "obj_zapper_enemy_slash_Step_0_gml_45_0": "お！音楽が\n見えるように\nなったぜ！",
  "obj_zapper_enemy_slash_Step_0_gml_46_0": "おい！\n触んじゃねえ！",
  "obj_zapper_enemy_slash_Step_0_gml_50_0": "だれか！！\n音量！！もとに！！\nもどして！！くれ！！！",
  "obj_zapper_enemy_slash_Step_0_gml_51_0": "なんだって！！？\n聞こえねえぞ！！",
  "obj_zapper_enemy_slash_Step_0_gml_52_0": "音量上げろ！？！？\nわかった！！よ！！！",
  "obj_zapper_enemy_slash_Step_0_gml_54_0": "       ",
  "obj_zapper_enemy_slash_Step_0_gml_124_0": "＊ ザッパーは　 エンカクソウサを\n　 遠隔操作した。",
  "obj_zapper_enemy_slash_Step_0_gml_125_0": "＊ ザッパーは　急いで胸のボタンを押した。",
  "obj_zapper_enemy_slash_Step_0_gml_126_0": "＊ ザッパーは\n　 ポッピン・オールナイ・ロン。",
  "obj_zapper_enemy_slash_Step_0_gml_127_0": "＊ ザッパーは　テナが見ているか\n　 確認した。",
  "obj_zapper_enemy_slash_Step_0_gml_133_0": "＊ ザッパーのボタンが　ブヨブヨしてきた。",
  "obj_zapper_enemy_slash_Step_0_gml_139_0": "＊ ザッパーは　ラニーノの幻覚を見ている。",
  "obj_zapper_enemy_slash_Step_0_gml_145_0": "＊ ザッパーも　赤外線で赤くなった。",
  "obj_zapper_enemy_slash_Step_0_gml_184_0": "＊ ザッパー - ATK ~1 DEF ~2\n＊ ボタンひとつで　景色が変わる。\n　 どこへ行くかは　予測不可能。/%",
  "obj_zapper_enemy_slash_Step_0_gml_198_0": "＊ ボリュームを　上げた！/%",
  "obj_zapper_enemy_slash_Step_0_gml_207_0": "＊ 弾のボリュームも　アップ！\n　 ギリギリかわして　TPゲット！/%",
  "obj_zapper_enemy_slash_Step_0_gml_230_0": "＊ …/%",
  "obj_zapper_enemy_slash_Step_0_gml_236_0": "＊ 弾の“ボリューム”も　アップした…！\n　 得られるTPも　アップ！/%",
  "obj_zapper_enemy_slash_Step_0_gml_246_0": "＊ ミュートボタンを押した！/%",
  "obj_zapper_enemy_slash_Step_0_gml_256_0": "＊ …/%",
  "obj_zapper_enemy_slash_Step_0_gml_269_0": "＊ 敵は全員　くたびれた！/%",
  "obj_zapper_enemy_slash_Step_0_gml_276_0": "＊ 電源ボタンを押して　OFFにした！/%",
  "obj_zapper_enemy_slash_Step_0_gml_396_0": "＊ スージィは　ボタンを押しまくった！/%",
  "obj_zapper_enemy_slash_Step_0_gml_455_0": "＊ ラルセイは　字幕を表示させた！/%",
  "obj_zapper_enemy_slash_Step_0_gml_51_0_b": "ボタンを…押されたぞ…",
  "scr_armorinfo_slash_scr_armorinfo_gml_538_0": "シャドウマント",
  "scr_armorinfo_slash_scr_armorinfo_gml_539_0": "影を　水のように弾く。\n闇／星こうげきのダメージを大幅に削減。",
  "scr_armorinfo_slash_scr_armorinfo_gml_540_0": "かっけぇ！ なんだコレ？",
  "scr_armorinfo_slash_scr_armorinfo_gml_541_0": "着ても…いいかな…？",
  "scr_armorinfo_slash_scr_armorinfo_gml_542_0": "これは…背の高いひと用…",
  "scr_armorinfo_slash_scr_armorinfo_gml_553_0": "闇／星",
  "scr_armorinfo_slash_scr_armorinfo_gml_564_0": "ロードストーン",
  "scr_armorinfo_slash_scr_armorinfo_gml_565_0": "カタツムリの形をしたロードストーンの\nトークン。弾をよけて得られるTPが増える。",
  "scr_armorinfo_slash_scr_armorinfo_gml_568_0": "新記録が刻印されたロードストーンの\nトークン。弾をよけて得られるTPが増える。",
  "scr_armorinfo_slash_scr_armorinfo_gml_571_0": "ピザ形をしたロードストーンのトークン。\n敵の弾をよけて得られるTPが増える。",
  "scr_armorinfo_slash_scr_armorinfo_gml_575_0": "カタツムリ？…ムリだな。",
  "scr_armorinfo_slash_scr_armorinfo_gml_578_0": "残念賞だな。",
  "scr_armorinfo_slash_scr_armorinfo_gml_581_0": "これ 食えるよな？",
  "scr_armorinfo_slash_scr_armorinfo_gml_584_0": "カタツムリに思い入れはないよ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_587_0": "ごほうび…？ボクに？",
  "scr_armorinfo_slash_scr_armorinfo_gml_590_0": "スージィが食べないようにボクが装備する！",
  "scr_armorinfo_slash_scr_armorinfo_gml_593_0": "殻以外は クリスのママが食べたの？",
  "scr_armorinfo_slash_scr_armorinfo_gml_596_0": "これって アズくんのじゃ…？",
  "scr_armorinfo_slash_scr_armorinfo_gml_599_0": "食べないで！わたし 装備するから！",
  "scr_armorinfo_slash_scr_armorinfo_gml_614_0": "TPアップ",
  "scr_armorinfo_slash_scr_armorinfo_gml_621_0": "ジンジャーガード",
  "scr_armorinfo_slash_scr_armorinfo_gml_622_0": "激しい炎で鍛えた　鋼製の腕輪。\nヒト科生物の形をしている。",
  "scr_armorinfo_slash_scr_armorinfo_gml_623_0": "腹にコブシで穴あけてやったぜ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_624_0": "大きかったら クリスを作れるね",
  "scr_armorinfo_slash_scr_armorinfo_gml_625_0": "クンクン… あ ゴメン…",
  "scr_armorinfo_slash_scr_armorinfo_gml_643_0": "ブルーリボン",
  "scr_armorinfo_slash_scr_armorinfo_gml_644_0": "チアリーダーが髪につけるブルーのリボン。\n回復アクションを行った際のHP回復量が増える。",
  "scr_armorinfo_slash_scr_armorinfo_gml_645_0": "死んでもイヤだぜ。",
  "scr_armorinfo_slash_scr_armorinfo_gml_647_0": "ク！",
  "scr_armorinfo_slash_scr_armorinfo_gml_648_0": "リ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_649_0": "ス！",
  "scr_armorinfo_slash_scr_armorinfo_gml_650_0": "と！",
  "scr_armorinfo_slash_scr_armorinfo_gml_651_0": "スー！",
  "scr_armorinfo_slash_scr_armorinfo_gml_652_0": "ジィ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_653_0": "は！",
  "scr_armorinfo_slash_scr_armorinfo_gml_654_0": "な！",
  "scr_armorinfo_slash_scr_armorinfo_gml_655_0": "か！",
  "scr_armorinfo_slash_scr_armorinfo_gml_656_0": "よ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_657_0": "し！",
  "scr_armorinfo_slash_scr_armorinfo_gml_658_0": "ネ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_659_0": "ビックリマーク！",
  "scr_armorinfo_slash_scr_armorinfo_gml_660_0": "えっと…おしまい！",
  "scr_armorinfo_slash_scr_armorinfo_gml_661_0": "…おしまいだってば！",
  "scr_armorinfo_slash_scr_armorinfo_gml_662_0": "イェイ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_665_0": "フ…フレー…フレー…！",
  "scr_armorinfo_slash_scr_armorinfo_gml_676_0": "回復＋",
  "scr_armorinfo_slash_scr_armorinfo_gml_682_0": "テナタイ",
  "scr_armorinfo_slash_scr_armorinfo_gml_683_0": "超ビッグサイズの丈夫な防弾ネクタイ。\nどうやって身につける…？",
  "scr_armorinfo_slash_scr_armorinfo_gml_684_0": "バンダナスタイルだな。",
  "scr_armorinfo_slash_scr_armorinfo_gml_685_0": "スカーフみたいに腰に巻く…？",
  "scr_armorinfo_slash_scr_armorinfo_gml_686_0": "「プレゼント」のコスプレ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_697_0": " ",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_113_0": "テレビの形をしたレンチンフード。\n大好物のパイの　巨大なかけらつき。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_118_0": "テレビの形をしたレンチンフード。\nとがった鼻が　アイスのコーンになっている。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_123_0": "テレビの形をしたレンチンフード。\nヴィーガンステーキは顔の形じゃない。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_127_0": "とある　だれかのXXX。\nバトルでは使えない。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_143_0": "だれかが開けて　ガッツリ飲んで\n気が抜けたソーダ。HPを20回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_146_0": "パッとしない味の　食堂フード。\nアイスクリームのコーンは　ふやけてブヨブヨ。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_149_0": "ギョーカイのお偉いさん向けディナー。\nブルーの“キャビア”は　忘れられない味。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_152_0": "高ランクの挑戦者にふるまわれるTVディナー。\n取り外し可能なアンテナつき。HPを140回復。",
  "scr_iteminfo_slash_scr_iteminfo_gml_249_0": "TVディナー",
  "scr_iteminfo_slash_scr_iteminfo_gml_250_0": "100HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_256_0": "ピピス",
  "scr_iteminfo_slash_scr_iteminfo_gml_257_0": "何も\n起こらない",
  "scr_iteminfo_slash_scr_iteminfo_gml_263_0": "気の抜けたソーダ",
  "scr_iteminfo_slash_scr_iteminfo_gml_264_0": "20HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_270_0": "TVカス",
  "scr_iteminfo_slash_scr_iteminfo_gml_271_0": "80HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_277_0": "VIPビュッフェ",
  "scr_iteminfo_slash_scr_iteminfo_gml_278_0": "仲間全員を\n100HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_284_0": "DELUXディナー",
  "scr_iteminfo_slash_scr_iteminfo_gml_285_0": "140HP\n回復",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_108_0": "TVディナー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_111_0": "ピピス",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_114_0": "気の抜けたソーダ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_117_0": "TVカス",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_120_0": "VIPビュッフェ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_123_0": "DELUXディナー",
  "scr_itemuse_slash_scr_itemuse_gml_580_0": "ユニコーンみたい！",
  "scr_itemuse_slash_scr_itemuse_gml_588_0": "バタースコッチだ！",
  "scr_itemuse_slash_scr_itemuse_gml_592_0": "うげ！ベトベトだ！",
  "scr_itemuse_slash_scr_itemuse_gml_595_0": "…ニセモノの血だな。",
  "scr_itemuse_slash_scr_itemuse_gml_600_0": "わあ！すっごくおいしい！",
  "scr_itemuse_slash_scr_itemuse_gml_604_0": "見て！鼻が伸びちゃった！",
  "scr_itemuse_slash_scr_itemuse_gml_607_0": "焼き加減は“レア”？",
  "scr_itemuse_slash_scr_itemuse_gml_612_0": "バタースコッチ！おいしい！",
  "scr_itemuse_slash_scr_itemuse_gml_616_0_b": "「アイスクリーム早食い競争だぞー！」",
  "scr_itemuse_slash_scr_itemuse_gml_619_0_b": "ホンモノの…血みたい…",
  "scr_itemuse_slash_scr_itemuse_gml_637_0": "あ？",
  "scr_itemuse_slash_scr_itemuse_gml_642_0": "あれ？どこ行った？",
  "scr_itemuse_slash_scr_itemuse_gml_647_0": "あっ！(わたし 欲しかったのに…)",
  "scr_itemuse_slash_scr_itemuse_gml_654_0": "いらねーよ",
  "scr_itemuse_slash_scr_itemuse_gml_658_0": "それは…栄養あるのかな？",
  "scr_itemuse_slash_scr_itemuse_gml_662_0": "えっと…大事にしよう？",
  "scr_itemuse_slash_scr_itemuse_gml_674_0": "全部 飲みゃいーんだろ？",
  "scr_itemuse_slash_scr_itemuse_gml_678_0": "半分 取っといてくれたの？",
  "scr_itemuse_slash_scr_itemuse_gml_682_0": "(クリスの飲みかけ… まあ いいか…)",
  "scr_itemuse_slash_scr_itemuse_gml_693_0": "前の学校 思い出すぜ",
  "scr_itemuse_slash_scr_itemuse_gml_697_0": "これは…合法なの？",
  "scr_itemuse_slash_scr_itemuse_gml_701_0": "もう一度 凍らせたよ！",
  "scr_itemuse_slash_scr_itemuse_gml_710_0": "カネ持ちは こんなん食うのか？",
  "scr_itemuse_slash_scr_itemuse_gml_711_0": "食べるときは 小指を立てて！",
  "scr_itemuse_slash_scr_itemuse_gml_712_0": "またキャビア…？",
  "scr_itemuse_slash_scr_itemuse_gml_722_0": "見ろ ゴキブリのコスプレだ",
  "scr_itemuse_slash_scr_itemuse_gml_726_0": "見て！ボク はらぺこあおむし！",
  "scr_itemuse_slash_scr_itemuse_gml_730_0": "エイリアン…のコスプレ…？",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_158_0": "コントローラー？",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_159_0": "だれも使いたがらないコントローラー。\nボタンは趣味の悪いピンクと黄色。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_162_0": "VIP用パス",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_163_0": "舞台裏にも入れる　ビッグなVIP用のパス。\n入り口の前で　ラムに見せよう。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_166_0": "旅行券",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_167_0": "ドコデモナイへの切符。赤い×マークの\n左を指し示す地図が描いてある…",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_185_0": "ランサーコン",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_186_0": "ランサーのコントローラー。土まみれ。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_189_0": "ランサーコン X ~1",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_190_0": "ランサーのコントローラー。土まみれ。",
  "scr_monstersetup_slash_scr_monstersetup_gml_259_0_b": "ぶんせき",
  "scr_monstersetup_slash_scr_monstersetup_gml_261_0": "無意味な\n分析",
  "scr_monstersetup_slash_scr_monstersetup_gml_263_0": "賭け",
  "scr_monstersetup_slash_scr_monstersetup_gml_265_0": "緑に触れて\nみのがし\nアップ",
  "scr_monstersetup_slash_scr_monstersetup_gml_277_0": "敵は\nくたびれる\nただし…",
  "scr_monstersetup_slash_scr_monstersetup_gml_287_0": "Ｓアクション",
  "scr_monstersetup_slash_scr_monstersetup_gml_291_0_b": "Ｒアクション",
  "scr_monstersetup_slash_scr_monstersetup_gml_1828_0": "Pipis",
  "scr_monstersetup_slash_scr_monstersetup_gml_1840_0": "Check",
  "scr_monstersetup_slash_scr_monstersetup_gml_1854_0": "S-Action",
  "scr_monstersetup_slash_scr_monstersetup_gml_1858_0": "R-Action",
  "scr_monstersetup_slash_scr_monstersetup_gml_1939_0": "ザッパー",
  "scr_monstersetup_slash_scr_monstersetup_gml_1951_0": "ぶんせき",
  "scr_monstersetup_slash_scr_monstersetup_gml_1952_0": "無意味な\n分析",
  "scr_monstersetup_slash_scr_monstersetup_gml_1955_0": "ボリューム↑",
  "scr_monstersetup_slash_scr_monstersetup_gml_1956_0": "弾から得る\nTPアップ…",
  "scr_monstersetup_slash_scr_monstersetup_gml_1960_0": "ミュート",
  "scr_monstersetup_slash_scr_monstersetup_gml_1962_0": "敵を\nくたびれ\nさせる",
  "scr_monstersetup_slash_scr_monstersetup_gml_1966_0": "電源オフ",
  "scr_monstersetup_slash_scr_monstersetup_gml_1969_0": "電源を\n切る",
  "scr_monstersetup_slash_scr_monstersetup_gml_1972_0": "Ｓアクション",
  "scr_monstersetup_slash_scr_monstersetup_gml_1976_0": "Ｒアクション",
  "scr_monstersetup_slash_scr_monstersetup_gml_1982_0": "フロック",
  "scr_monstersetup_slash_scr_monstersetup_gml_1994_0": "ぶんせき",
  "scr_monstersetup_slash_scr_monstersetup_gml_1997_0": "ゲコゲコ",
  "scr_monstersetup_slash_scr_monstersetup_gml_1998_0": "連打で\nみのがし",
  "scr_monstersetup_slash_scr_monstersetup_gml_2001_0": "ゲコゲコＸ",
  "scr_monstersetup_slash_scr_monstersetup_gml_2003_0": "敵全員\nターゲット\n効果＝弱",
  "scr_monstersetup_slash_scr_monstersetup_gml_2006_0": "Ｓアクション",
  "scr_monstersetup_slash_scr_monstersetup_gml_2007_0": "みのがし\n50％",
  "scr_monstersetup_slash_scr_monstersetup_gml_2011_0": "Ｒアクション",
  "scr_monstersetup_slash_scr_monstersetup_gml_2012_0": "25％\n＋\nくたびれ",
