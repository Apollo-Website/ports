    {
        scr_84_set_draw_font("main");
        draw_set_color(mycolor);
        
        if (finished == 0)
        {
            partstring += string_char_at(mystring, part);
            part += 1;
            
            if (part >= (string_length(mystring) + 1))
                finished = 1;
        }
        
        draw_text(truex + 70 + random(1), truey + 15 + random(1), string_hash_to_newline(partstring));
    }
}

