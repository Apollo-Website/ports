        ladder.x += xshift;
        ladder.y += yshift;
        ladder.image_alpha = 0.5;
    }
    
    if (climbpoint != 0)
    {
        climbpoint.x += xshift;
        climbpoint.y += yshift;
    }
    
    if (resetblocks == true)
    {
        resetblocks = false;
        setxy(xstart, ystart);
        
        if (ladder != 0)
        {
            with (ladder)
                setxy(xstart, ystart);
