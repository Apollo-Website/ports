            var shakex = instance_create(x, y, obj_shake);
            shakex.shakey = 9;
            shakex.shakex = 0;
            image_index = (image_index < 4) ? (image_index + 1) : 1;
            scr_shakeobj();
            hspeed = kick_direction;
            vspeed = -3;
            friction = 1;
        }
    }
    
    if (kick_index < 4 && kick_timer == 20)
    {
        with (trashcan)
        {
            hspeed = 0;
            vspeed = 0;
            gravity = 0;
            friction = 0;
        }
    }
    
    if (kick_timer == 40)
    {
        kick_timer = 0;
        kick_index++;
        
        if (kick_index == 5)
        {
            kick_loop = true;
            kick_start = false;
        }
    }
}

