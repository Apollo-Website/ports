  "obj_dw_churchb_bookshelf_slash_Step_0_gml_44_0": "＊ 空より落ちた星が　涙を流し\n　 その涙は　川になった。/",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_45_0": "＊ そして^1　その苦い水から^1\n　 ゆっくりと^1　なにかが　生えてきた。/",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_46_0": "＊ それは　ガラスのようだった。/%",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_127_0": "＊ 狭間で^1　なにかを　聞いたのだ。\n　 そう^1　狭間で。/",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_128_0": "＊ それは　混ざり合っていた。/",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_130_0": "＊ かわいそうな　子どもたち！/%",
  "obj_dw_churchb_darkclimb_slash_Create_0_gml_53_0": "＊ クリス！　こっちだ！/%",
  "obj_dw_churchb_darkclimb_slash_Create_0_gml_56_0": "＊ クソッ！　なんで\n　 オレのこうげき　効かねぇんだよ？/%",
  "obj_dw_churchb_darkclimb_slash_Create_0_gml_59_0": "＊ サンキュー！　借りイチだな。/%",
  "obj_dw_churchb_darkclimb_slash_Create_0_gml_62_0": "＊ うし！/",
  "obj_dw_churchb_darkclimb_slash_Create_0_gml_63_0": "＊ 気をつけろよな。/",
  "obj_dw_churchb_darkclimb_slash_Create_0_gml_64_0": "＊ 上が見えてきた！　あと少しだ！/%",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_245_0": "\\ED＊ ずいぶん下まで\n　 落ちちまったな…/%",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_350_0": "\\EE＊ …/%",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_404_0": "\\EZ＊ 床が…/",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_405_0": "\\EZ＊ …下は^1…どうなってんだ？/%",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_443_0": "\\EZ＊ そういうことかよ！/%",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_832_0": "\\El＊ フゥ^1…危なかったぜ…/%",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_850_0": "\\E6＊ ん…？/",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_851_0": "\\E7＊ クリス^1　あっちだ…！/%",
  "obj_dw_churchb_darkclimb_slash_Step_0_gml_869_0": "\\E2＊ 行くぜ！/%",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_181_0": "\\EM＊ ちょっ…^1！\n　 なんで来るんだよ！\n　 待ってろっつっただろ！/",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_182_0": "\\Ep＊ もし^1…その^1…\n　 オレのことが\n　 書いてあるなら…\n/%",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_201_0": "\\E6＊ …？/%",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_215_0": "\\EZ＊ 最後…？/",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_216_0": "\\ED＊ これって…/",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_217_0": "\\EZ＊ 最後は…どうなるんだ…？/%",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_244_0": "\\EZ＊ …おいおい　まさか…/",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_245_0": "\\EZ＊ どうやったら世界救えるか\n　 わかるってことか…？/",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_246_0": "\\E7＊ ったぜ^1！\n　 これでラクショーじゃん！！/%",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_267_0": "\\EI＊ なっ…！^1！\n　 ひとが読んでるのに…！/%",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_281_0": "\\E6＊ …じいさん？/%",
  "obj_dw_churchb_darkclimb_scene_slash_Step_0_gml_299_0": "\\EZ＊ あっ…待てよ！/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_59_0": "\\E5＊ スージィ…あのね…/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_60_0": "\\Ed＊ いくつか^1　どうしても\n　 言えないことも\n　 あるんだけど…/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_61_0": "\\EQ＊ これからは…/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_62_0": "\\EB＊ ボク^1…言えることは\n　 なんでも言いたい。/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_64_0": "\\E7＊ …じゃあ^1　ドアのカギあける\n　 番号^1　知ってるか？/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_66_0": "\\EK＊ え…^1？　それは　知らない。/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_87_0": "\\EK＊ …じゃあさ^1…\n　 ノエルのことで^1　なんか\n　 知ってることあるか？/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_89_0": "\\EL＊ えっと…/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_90_0": "\\EK＊ どのアイテムを\n　 装備できるかは\n　 知ってるよ？/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_91_0": "\\EX＊ それと^1　スージィも\n　 リボンを装備できるって\n　 ことも…/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_93_0": "\\EA＊ わーった^1。\n　 さては　おまえ^1　\n　 なんも知らねーな？/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_195_0": "\\Ed＊ ここから　最初のエリアに\n　 もどれるみたいだね。/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_213_0": "＊ アナタたち　ドアをあける\n　 バンゴウを　知りたいですか？/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_218_0": "\\E0＊ …ああ。/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_223_0": "＊ 2202です！/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_224_0": "＊ ワタシに書いてあるのです^1！\n　 ワタシは　なによりジューヨウなので^1！\n　 コケッケッケ！/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_244_0": "\\EK＊ …ありがとうございます。/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_254_0": "\\EB＊ …/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_256_0": "\\EM＊ …/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_258_0": "\\ED＊ …泉^1　封印しにいくわ。/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_260_0": "\\EQ＊ …うん！/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_348_0": "＊ ライトナーたちの　レーハイが\n　 ワタシなしで　行われたタメシは\n　 アリマセン！　コケッケッケ！/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_349_0": "＊ ワタシこそが　なにより\n　 ジューヨウな　ソンザイ\n　 なのでしょう！　コケッケッケ！/%",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_404_0": "＊ ワタシは　なにより　ジューヨウです^1！\n　 コケッケッケ！/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_405_0": "＊ なにが　あっても^1　\n　 ズット　ズット　ここにいます！/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_406_0": "＊ ワタシの　知っているコト\n　 教えてあげましょうか！？\n　 コケッケッケ！/",
  "obj_dw_churchb_extinguisher_slash_Step_0_gml_408_0": "\\E1＊ …いや^1。\n　 いま　いそがしいから。/%",
  "obj_dw_churchb_fireplace_slash_Step_0_gml_56_0": "\\EC＊ …暗くてよく見えねぇな…/%",
  "obj_dw_churchb_fireplace_slash_Step_0_gml_69_0": "\\EZ＊ あっ…！/%",
  "obj_dw_churchb_fireplace_slash_Step_0_gml_81_0": "\\EZ＊ じいさん^1！\n　 ちょっ^1…どこ行くんだよ！？/",
  "obj_dw_churchb_fireplace_slash_Step_0_gml_82_0": "\\EZ＊ クリス！^1　追いかけるぞ！/%",
  "obj_dw_churchb_fountain_slash_Step_0_gml_46_0": "\\E2＊ やべーな？/",
  "obj_dw_churchb_fountain_slash_Step_0_gml_47_0": "\\EA＊ おまえも　こんど\n　 やってみろよ^1。\n　 アガるぜ。/%",
  "obj_dw_churchb_fountain_slash_Step_0_gml_52_0": "＊ (逆光を　放っている)/%",
  "obj_dw_churchb_fountain_slash_Step_0_gml_168_0": "\\EV＊ …マジか。/",
  "obj_dw_churchb_fountain_slash_Step_0_gml_169_0": "\\E7＊ スゲー！^1　オレ　\n　 闇の泉　作っちまったぜ！/%",
  "obj_dw_churchb_fountain_slash_Step_0_gml_179_0": "\\E2＊ ヤベーな…/",
  "obj_dw_churchb_fountain_slash_Step_0_gml_180_0": "\\EY＊ 次は　おまえに\n　 やらせてやるよ。/",
  "obj_dw_churchb_fountain_slash_Step_0_gml_181_0": "\\EA＊ うし。行こうぜ。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_405_0": "＊ 恐ろしい獣だ^1！\n　 すでに絶滅しているのは　幸いだ。/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_406_0": "＊ この体型から想像するに^1　\n　 肉と炎をエサにしていたようだ。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_437_0": "＊ ああ…^1　なんという果報者！/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_468_0": "＊ オトコヒゲ型に彫刻された石盤…\n　 これぞ　まさに^1　生き字引だ。/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_469_0": "＊ 当時は　いまとは　さまざまな言葉の\n　 つづりが　ちがった^1。かつての\n　 ほうが　すぐれた　つづりだった。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_500_0": "＊ 石で　水の質感を\n　 見事に表現している。/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_501_0": "＊ これこそが^1　ワレらの祖先にとっての\n　 究極の美だったのだろう！/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_533_0": "＊ ワレらの祖先は　かつては\n　 こんなにも質素な姿をしていた。\n　 頭飾りひとつ　見られない。/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_534_0": "＊ おそらく　仕事のことしか\n　 頭に　なかったのだろう…/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_535_0": "＊ ワレらも　そのように生きるべきだ！\n　 採取した木の実や種だけを食べて！/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_573_0": "＊ 美しい標本だ…\n　 固い外殻しか　残っていないが。/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_574_0": "＊ 時とともに失われた\n　 やわらかな部分も\n　 見ることができたなら…/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_575_0": "＊ 美しい羽毛や　肉づきのよい尻を\n　 持っていたかもしれない。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_580_0": "＊ 美しい標本だ！/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_614_0": "＊ アパテイア・クラブへ　ようこそ。/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_615_0": "＊ ここには　遺物を展示してある。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_620_0": "＊ 今日の歴史は^1　明日の考古学。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_651_0": "＊ 「いにしえの　面々のギャラリー」/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_674_0": "＊ (ストーンクーラーだ。\n　 とくに使い道はない)/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_703_0": "＊ この　古代のタンサイボウ生物は\n　 じつに単純な生を送っていたようだ。/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_704_0": "＊ このように　群れて\n　 生活していたとは。\n　 この姿から^1　じつに多くを学べる。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_740_0": "＊ (見覚えのある像だ)/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_772_0": "＊ ここに立って^1　体が石になるのを\n　 待っている^1。\n　 早くしてくれ。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_805_0": "＊ (像の台座だ^1…\n　 自分の名前が書いてある)/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_849_0": "＊ そうとも^1。キミも化石になるのだ^1。\n　 いま　すぐに。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_908_0": "＊ 巨大な化石が　降ってくる^1！\n　 潰される！　壊される！\n　 すべてが！　ドンガラガッシャンと！/",
  "obj_dw_churchb_gallery_slash_Step_0_gml_909_0": "＊ わはははは！　もちろんワレも！\n　 ワレも潰される！/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_944_0": "＊ 彼はなんとも…オリジナルだ。/%",
  "obj_dw_churchb_gallery_slash_Step_0_gml_975_0": "＊ (オリジナルな　像だ)/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_5_0": "左",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_6_0": "右",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_7_0": "上",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_8_0": "下",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_10_0": "教会の鐘",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_11_0": "バイオリン",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_12_0": "ドラム",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_13_0": "ギター",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_107_0": "\\Ee＊ じいさん！　待てって！/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_108_0": "\\Ed＊ 聞きたいことがあんだよ！/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_220_0": "\\EV＊ クソッ^1…なんも見えねぇ…/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_318_0": "\n聞こえる",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_319_0": "\n聞こえ\nない",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_322_0": "\\E0＊ ん…？/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_323_0": "\\E1＊ なんか　聞こえるよな…？/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_343_0": "マジで\n言うと\n聞こえる",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_344_0": "マジで\n聞こえ\nない",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_346_0": "\\EC＊ …はあ？　マジで言ってんの？/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_364_0": "\\EK＊ …へー。でも　オレには\n　 聞こえるぜ…/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_378_0": "\n~1",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_379_0": "\n~1",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_385_0": "\\E1＊ どっちから\n　 聞こえてんだ　これ…？/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_389_0": "\\E0＊ まただ…^1　これは…/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_423_0": "\\EK＊ いや^1…　~1だろ…/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_434_0": "\n~1",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_435_0": "\n~1",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_440_0": "\\EA＊ だな！　この音は…/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_467_0": "\\EA＊ ああ^1　こっちだ！/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_486_0": "\\EK＊ いや^1…　~1だろ…/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_638_0": "\\E6＊ おい！　またなんか\n　 聞こえたぞ！/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_639_0": "\\EA＊ こっちだ！/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_703_0": "\\EV＊ あー　クソッ…/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_704_0": "\\El＊ 足がすべって\n　 落ちちまった！/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_705_0": "\\El＊ そっから動くなよ！？^1　\n　 いま　もどる道\n　 さがすから…/%",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_752_0": "＊ (完全な闇に　取り残された…)/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_753_0": "＊ (こうなったら　目を閉じて…)/",
  "obj_dw_churchb_gersonchase_slash_Step_0_gml_754_0": "＊ (スージィは　いま　なにを\n　 しているか　考える以外に\n　 できることは　なさそうだ)/%",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_165_0": "\\E7＊ やっぱりな^1！\n　 じいさんの部屋だ！/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_166_0": "\\EN＊ きっと　じいさんが^1　\n　 オレたちを　こっちに\n　 呼んでくれたんだな。/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_167_0": "\\E9＊ あとは　本人を\n　 見つけるだけだ…/%",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_214_0": "\\ED＊ …なあ　クリス。/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_215_0": "\\EN＊ じいさん^1…\n　 キャッスルタウンに\n　 来てくれっかな？/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_216_0": "\\E9＊ 来る^1…よな？/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_217_0": "\\ED＊ …/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_218_0": "\\ES＊ あのハンマーを\n　 持っていかねぇと\n　 ダメかもだけど…/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_219_0": "\\E9＊ …じいさんも\n　 べつに　気にしねーよな？/%",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_284_0": "\n取る",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_285_0": "\n取らない",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_292_0": "＊ (無人のテーブルに\n　 アイテムが　ならんでいる…)/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_293_0": "＊ (…取る？)/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_307_0": "＊ (ラプソティーだ。\n 　$~1払って 取る？)/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_321_0": "\\E5＊ うぉい^1！\n　 それ^1　じいさんのだろ！/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_322_0": "\\EK＊ 取るなら^1…\n　 カネとか…置いてけよ…/%",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_328_0": "\\EL＊ …だな^1。こっから盗むのは^1…　\n　 ダセえ盗みだ。/%",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_371_0": "\\EC＊ …それ^1　100ドル札だろ。\n　 アイテムは　99ドルだから…/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_372_0": "\\E1＊ …釣りを　もらわねえと。/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_373_0": "\\E0＊ …/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_374_0": "\\EK＊ めんどくせーから\n　 いっか。/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_376_0": "＊ (ラプソティーに\n　 １ドル多く支払った)/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_385_0": "\\EY＊ うし。ぴったりだな。/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_403_0": "\\EK＊ てか^1　持ちもの多すぎて\n　 これ以上　持てねーよ。/",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_404_0": "\\EC＊ なんでこんなに\n　 荷物多いんだ？/%",
  "obj_dw_churchb_gersonstudy_slash_Step_0_gml_409_0": "\\EK＊ その札じゃ　足りねーよ！/%",
  "obj_dw_churchb_library_slash_Step_0_gml_156_0": "\\E9＊ 見ろよ　これ！\n　 初めて会ったときの\n　 ラルセイだ！/",
  "obj_dw_churchb_library_slash_Step_0_gml_157_0": "\\ED＊ …オレら３人^1　\n　 １人ひとりに\n　 予言が　あるってことか。/",
  "obj_dw_churchb_library_slash_Step_0_gml_158_0": "\\E0＊ ラルセイが\n　 「孤独な王子」なら…/",
  "obj_dw_churchb_library_slash_Step_0_gml_159_0": "\\ED＊ …クリスとオレは\n　 なんだ…？/",
  "obj_dw_churchb_library_slash_Step_0_gml_160_0": "\\E9＊ きっと　この先に\n　 つづきがあるぜ！/%",
  "obj_dw_churchb_library_slash_Step_0_gml_237_0": "＊ とくに　がんじょうそうな本が\n　 何冊も積んである。/%",
  "obj_dw_churchb_library_slash_Step_0_gml_260_0": "＊ ワレらは　なにも知らない。\n　 ワレらは…なにも理解しない。/%",
  "obj_dw_churchb_library_slash_Step_0_gml_295_0": "＊ ワレらは　なんでも知っている。\n　 ワレらは　なんでも理解する。/%",
  "obj_dw_churchb_library_slash_Step_0_gml_330_0": "＊ ワレは　哲学者。/",
  "obj_dw_churchb_library_slash_Step_0_gml_331_0": "＊ キミらは　夢を　もどそうとした。/",
  "obj_dw_churchb_library_slash_Step_0_gml_335_0": "＊ キミらは　夢を　もどそうとした。/",
  "obj_dw_churchb_library_slash_Step_0_gml_341_0": "＊ しかし　心の光は　変化した。\n　 キミらに見えるのは　別の面のみ。/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_333_0": "\\E7＊ お！^1　これ\n　 クリスのことじゃね…！？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_334_0": "\\EK＊ …でも^1　ヘンな絵だな。/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_335_0": "\\E6＊ てか^1　なんで　おまえ\n　 「カゴ」って言われてんの？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_336_0": "\\EQ＊ どっちかっつーと\n　 クリスは…/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_339_0": "\\EA＊ 「ザ・クール」とかじゃね？\n　 で　この絵も…/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_343_0": "\\E9＊ オレが描いたののほうが\n　 100倍いいぜ。「スージィ\n　 最強」っつってるヤツな。/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_347_0": "\\E2＊ おまえが　バク転してる\n　 とことかのほうが\n　 100倍いいぜ。/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_449_0": "\\ED＊ …「娘」…/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_450_0": "\\ET＊ …って^1…オレのこと？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_451_0": "\\ED＊ もしそうなら^1…\n　 次は　オレの予言だな…/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_452_0": "\\EN＊ …なんて書いてあんだろな。/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_453_0": "\\E2＊ 早く行こうぜ。/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_577_0": "＊ ドングリの中に\n　 なにかが　あるという。/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_578_0": "＊ だが　ワレは^1　ドングリが\n　 どこにあるのかを　知らない。/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_579_0": "＊ そもそも　ドングリとは　なにかを\n　 知らない。/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_583_0": "＊ 探らなくてはならない。/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_584_0": "＊ その　ドングリを　生み出す\n　 錬金術の　使い方を。/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_633_0": "＊ これは　ダレの夢か？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_634_0": "＊ クリスの？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_635_0": "＊ スージィの？/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_640_0": "＊ これは　ダレの夢か？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_641_0": "＊ ナイトの？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_642_0": "＊ ワレの？/%",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_647_0": "＊ これは　ダレの夢か？/",
  "obj_dw_churchb_libraryconnector_slash_Step_0_gml_648_0": "＊ …ここに　置きっぱなしにして。/%",
  "obj_dw_churchb_man_slash_Step_0_gml_69_0": "＊ クリス^1　やっときてくれたね。\n　 かんじゃさんたちが\n　 まってるよ。/%",
  "obj_dw_churchb_man_slash_Step_0_gml_74_0": "＊ たしかに　わたし\n　 ひしょに　しては\n　 ちいさいけど…/",
  "obj_dw_churchb_man_slash_Step_0_gml_75_0": "＊ パチモンだから\n　 もんくは　いえないよ…/%",
  "obj_dw_churchb_man_slash_Step_0_gml_81_0": "＊ しんさつは　どうだった？/",
  "obj_dw_churchb_man_slash_Step_0_gml_82_0": "＊ アートには　セラピーてきな\n　 こうかが　あるっていうけど…/",
  "obj_dw_churchb_man_slash_Step_0_gml_83_0": "＊ けっきょく　どっちが\n　 かんじゃだったんだろうね？/%",
  "obj_dw_churchb_man_slash_Step_0_gml_88_0": "＊ しんりょうだいは\n　 もらったでしょ？/%",
  "obj_dw_churchb_man_slash_Step_0_gml_112_0": "＊ (彼は　木のうしろにいる)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_117_0": "＊ (ここに^1　男は　いない)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_137_0": "＊ (ここに^1　男がいる)/",
  "obj_dw_churchb_man_slash_Step_0_gml_138_0": "＊ (ここで^1　男は　なにかを指さして\n　 うなずいているように見える)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_161_0": "\nはい",
  "obj_dw_churchb_man_slash_Step_0_gml_162_0": "\nいいえ",
  "obj_dw_churchb_man_slash_Step_0_gml_167_0": "＊ (ここに^1　キャンバスがある)/",
  "obj_dw_churchb_man_slash_Step_0_gml_168_0": "＊ (絵を描く？)/",
  "obj_dw_churchb_man_slash_Step_0_gml_182_0": "＊ (クリスは　エンピツを手に取った)/",
  "obj_dw_churchb_man_slash_Step_0_gml_183_0": "＊ (木のうしろで　見たものを\n　 スケッチしはじめた)/",
  "obj_dw_churchb_man_slash_Step_0_gml_184_0": "＊ (描いていくうちに^1　\n　 エンピツの線が　進む方向を\n　 見失ったように　ずれはじめた)/",
  "obj_dw_churchb_man_slash_Step_0_gml_185_0": "＊ (描いてしまった線の上に^1　\n　 もう一度　初めから描きなおした)/",
  "obj_dw_churchb_man_slash_Step_0_gml_186_0": "＊ (何度も　何度も^1　途中で止まったり\n　 エンピツの先が　別のものを\n　 描きはじめたりした…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_187_0": "＊ (そのたびに^1　何度も　何度も\n　 最初から描きなおした)/",
  "obj_dw_churchb_man_slash_Step_0_gml_188_0": "＊ (何度も　くりかえすうちに\n　 手の動きは　すばやく\n　 スムーズに　なっていき…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_189_0": "＊ (…とうとう　キャンバスを\n　 見なくても　ひと筆描きで\n　 描き上げられるようになった)/",
  "obj_dw_churchb_man_slash_Step_0_gml_190_0": "＊ (…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_191_0": "＊ (いくつものスケッチを\n　 重ね描きしたために…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_192_0": "＊ (…キャンバスの表面には\n　 モノクロの　しみのようなものが\n　 描かれているだけになった)/",
  "obj_dw_churchb_man_slash_Step_0_gml_193_0": "＊ (…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_194_0": "＊ (次に^1　その上に　絵の具で\n　 １本の木を描いた…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_195_0": "＊ (…エンピツで　描いたもの\n　 全部の上に　かぶせて描いたので…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_196_0": "＊ (…なんの変哲もない\n　 静物画が　できあがった)/",
  "obj_dw_churchb_man_slash_Step_0_gml_197_0": "＊ (…なぜなら^1　この部屋には\n　 １本の木　以外\n　 見るものは　なにも　なかった)/",
  "obj_dw_churchb_man_slash_Step_0_gml_198_0": "＊ (…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_199_0": "＊ (クリスは　立ち上がった。\n　 絵が　完成したようだ)/",
  "obj_dw_churchb_man_slash_Step_0_gml_200_0": "＊ (…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_201_0": "＊ (黒鉛で汚れたクリスの手が…)/",
  "obj_dw_churchb_man_slash_Step_0_gml_202_0": "＊ (…まだ　動いている^1。\n　 見たことのない形を\n　 なぞるように)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_210_0": "＊ (キャンバスの質感を\n　 うっとりと　ながめた)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_227_0": "＊ (近くのイーゼルから\n　 タマゴを　拾いあげた)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_260_0": "＊ (だれかが　木の絵を\n　 描いているところのようだ)/",
  "obj_dw_churchb_man_slash_Step_0_gml_261_0": "＊ (奇妙なことに^1　描き手は　まだ\n　 木の皮を　描いていないようだ)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_276_0": "＊ (シンクだ)/",
  "obj_dw_churchb_man_slash_Step_0_gml_282_0": "＊ (絵を描いたあとで\n　 手を洗うところがなかったら\n　 困ってしまう)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_288_0": "＊ (水を出して　両手にかけ\n　 それから　手をふいた)/",
  "obj_dw_churchb_man_slash_Step_0_gml_289_0": "＊ (指のあいだの　しわに^1　\n　 うっすらと灰色に光るものが\n　 頑固に残っている)/",
  "obj_dw_churchb_man_slash_Step_0_gml_290_0": "＊ (…すべてを　洗い流すことは\n　 できない)/%",
  "obj_dw_churchb_man_slash_Step_0_gml_318_0": "＊ ゴッ…ゴメン！^1　絵を描くのに\n　 夢中で^1　キミがいることに\n　 気づいてなかったよ！/",
  "obj_dw_churchb_man_slash_Step_0_gml_319_0": "＊ お絵かきクラブに　来たの？/",
  "obj_dw_churchb_man_slash_Step_0_gml_320_0": "＊ そう^1　ここは^1　殺し合わずに\n　 みんなで　絵を描くところだよ！/",
  "obj_dw_churchb_man_slash_Step_0_gml_321_0": "＊ …え？^1　なにを描いているかって^1？\n　 まだ途中だから　見ないで…/%",
  "obj_dw_churchb_man_slash_Step_0_gml_327_0": "＊ どうやって　ここへ　来たのかって？/",
  "obj_dw_churchb_man_slash_Step_0_gml_328_0": "＊ どうやって来たんだっけなぁ。/",
  "obj_dw_churchb_man_slash_Step_0_gml_329_0": "＊ …すごく急いでて…\n　 どこへ向かって進んでいるのか\n　 ぜんぜん見てなかったから！/%",
  "obj_dw_churchb_man_slash_Step_0_gml_361_0": "＊ (だれか　入っているようだ)/%",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_77_0": "＊ 。う言をのも\n　 が\\cA額の付寄　のでここ\n　 きとたっ渡へ側対反\\cW/%",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_103_0": "＊ (水が　光を放っている^1…\n　 中で　黄金のコインが\n　 キラキラと輝いている)/%",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_108_0": "＊ (水は　むなしく凍りついている)/%",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_138_0": "＊ キミは　寄付者だ。\n　 キミが寄付した「カネ」は\n　 「金」に変化した。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_139_0": "＊ 総額^1　\\cY~1G\\cWに　到達した。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_144_0": "＊ キミは　寄付者の１人だ。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_145_0": "＊ キミと　もう１人の寄付者で^1　\n　 総額\\cY~1G\\cWに　到達した。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_150_0": "＊ いかに　小さな行いでも\n　 それが　他者の行動を促す\n　 可能性がある。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_154_0": "＊ 真っ赤になるほど　恥ずかしかった\n　 かもしれないが^1　\n　 まちがいなく正しい行いだった。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_158_0": "＊ しかも　君が寄付した硬貨には\n　 ミントコンディションのものが\n　 含まれていた。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_162_0": "＊ 君の気前のよさに　まちがいなく\n　 天も涙した。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_166_0": "＊ なんと　愚かな…/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_167_0": "＊ そのカネは　クモにでも\n　 やったほうが　ましだっただろう。/",
  "obj_dw_churchb_moneyfountain_slash_Step_0_gml_170_0": "＊ その宝箱の中にあるものを^1 \n　 まるで　自分のものかのように\n　 持っていくといい。/%",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_50_0": "＊ クッソ…　どうやって\n　 もどりゃいんだ…？/",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_51_0": "＊ とりあえず…/",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_52_0": "＊ 耳を　すましてみっか…\n　 なんか　聞こえるかもしんねえ…/%",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_81_0": "＊ …じいさん…？/",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_82_0": "＊ だよな？　そうだよな…？/%",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_114_0": "＊ さがしてたんだよ！/",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_115_0": "＊ ドアに　カギがかかってて^1…\n　 番号が　わからねえから\n　 開かなくて…/",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_116_0": "＊ ひょっとしたら　じいさんなら\n　 知ってんじゃねーかって…/%",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_167_0": "＊ …じいさん…？/",
  "obj_dw_churchb_nongerson_slash_Step_0_gml_168_0": "＊ …だいじょうぶか？/%",
  "obj_dw_churchb_prophecyencounter_slash_Step_0_gml_132_0": "\\ED＊ また　予言だな^1。\n　 オレたちが　出てくるやつ…/",
  "obj_dw_churchb_prophecyencounter_slash_Step_0_gml_133_0": "\\EV＊ …/",
  "obj_dw_churchb_prophecyencounter_slash_Step_0_gml_134_0": "\\ED＊ …やっぱ…信じらんねえよ。/",
  "obj_dw_churchb_prophecyencounter_slash_Step_0_gml_135_0": "\\ET＊ なにが起きるか\n　 わかってるってだけなら\n　 まだ　わかるけど…/",
  "obj_dw_churchb_prophecyencounter_slash_Step_0_gml_136_0": "\\ED＊ そんなかに　オレも\n　 出てくるとかさ。/%",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_69_0": "＊ なあ　クリス^1…　オレさ…/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_70_0": "＊ 今まで　一度も　なかったんだよ…/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_71_0": "＊ …なにかに　選ばれたこと。/%",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_74_0": "＊ 学校で　だれかと　ペアに\n　 なるときも　いっつも　ハブられた。/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_75_0": "＊ …体育の授業の\n　 チーム分けんときとかさ。/%",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_78_0": "＊ でも　今回はさ…/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_79_0": "＊ 今回は　ちがう。\n　 ぜんぜん　ちがう。/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_80_0": "＊ なんか…^1　重要なことだ。/%",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_83_0": "＊ オレ^1　勇者とか　なれるなんて\n　 思ってなかった。/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_84_0": "＊ 勇者は　いいヤツだろ^1？\n　 …オレは^1…そうじゃなかった。/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_85_0": "＊ まあ^1　いまだに　オレは\n　 いいヤツって感じじゃ　ねーけどさ。/%",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_88_0": "＊ でも　いまは^1…\n　 胸に希望を刻んでる。/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_89_0": "＊ 本当のこととして^1　どっかに\n　 ちゃんと書いてある「希望」だ。/",
  "obj_dw_churchb_rotatingtower_slash_Create_0_gml_90_0": "＊ …だれも　消せねーとこにな！/%j",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_199_0": "\\E7＊ うおー！^1　見ろよ！/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_200_0": "\\E7＊ オレだぜ！！/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_201_0": "\\E2＊ 「ムネに　希望を\n　 キザミシ娘」/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_202_0": "\\E9＊ ヤベー^1…　なんか\n　 チョーゼツかっこよくね？/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_203_0": "\\E7＊ 他にも　オレらのこと\n　 書いてあるかな？/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_204_0": "\\E9＊ なに　ボーッとしてんだよ^1！\n　 早くさがそうぜ！/%",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_453_0": "\\Ep＊ え…ちょ…/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_454_0": "\\Eq＊ これ…どーゆーイミだ…？/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_455_0": "\\Ep＊ オレが…？/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_456_0": "\\Eq＊ クリス…あー^1…\n　 オレ　続き　さがすわ！/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_457_0": "\\EM＊ おまえは^1…ここで待ってろ！/%",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_645_0": "\nある",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_646_0": "\nない",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_650_0": "＊ ワレは　哲学者ナリ。/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_651_0": "＊ キミは　聞いたことがアルか？\n　 「リンクは削除されました」に\n　 ついて。/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_667_0": "＊ ワレは　聞いたことが\n　 ナイように思う。/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_668_0": "＊ ナゼだかは　わからナイ。/%",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_673_0": "＊ キミは　聞いたことがナイ！/",
  "obj_dw_churchb_rotatingtower_slash_Step_0_gml_674_0": "＊ そうでアルか。そうでアルか。/%",
  "obj_dw_churchb_staircaseintro_slash_Step_0_gml_76_0": "\\E0＊ ん？^1　なんか^1…\n　 いや　気のせいか…？/",
  "obj_dw_churchb_staircaseintro_slash_Step_0_gml_77_0": "\\E1＊ ま^1　ラルセイも\n　 言ってたもんな…/",
  "obj_dw_churchb_staircaseintro_slash_Step_0_gml_78_0": "\\E0＊ 闇の世界は　それぞれ\n　 みんな　ちがうって。/",
  "obj_dw_churchb_staircaseintro_slash_Step_0_gml_79_0": "\\EL＊ 行くぞ。/%",
  "obj_dw_churchb_staircaseintro_slash_Step_0_gml_162_0": "\\EQ＊ 着いたね。/",
  "obj_dw_churchb_staircaseintro_slash_Step_0_gml_164_0": "\\EL＊ じゃ^1　あとでな。/%",
  "obj_dw_churchb_windows_slash_Step_0_gml_64_0": "＊ 隻眼の男を　なんと呼ぶ？/%",
  "obj_dw_churchb_windows_slash_Step_0_gml_65_0": "＊ 天使は　なぜ　泣き叫ぶ？/%",
  "obj_dw_churchb_windows_slash_Step_0_gml_66_0": "＊ 雪降る少女を　だれが呼ぶ？/%",
  "obj_dw_churchb_windows_slash_Step_0_gml_67_0": "＊ ワレは知らない　ダレが知る^1？\n　 あはははは　ははは\n　 ダレが　知る？/%",
  "obj_dw_churchb_windows_slash_Step_0_gml_99_0": "\n食べる",
  "obj_dw_churchb_windows_slash_Step_0_gml_100_0": "\n食べない",
  "obj_dw_churchb_windows_slash_Step_0_gml_105_0": "＊ (神聖なコケだ)/",
  "obj_dw_churchb_windows_slash_Step_0_gml_106_0": "＊ (食べる？)/",
  "obj_dw_churchb_windows_slash_Step_0_gml_120_0": "＊ (コケは　さぞ　うまそうに\n　 消費された！)/%",
  "obj_dw_churchb_windows_slash_Step_0_gml_130_0": "＊ (次の人に　ゆずるために\n　 コケを残した…)/%",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_84_0": "\\EZ＊ なあ^1…\n　 字の下に描いてある絵…/",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_85_0": "\\Eh＊ あれって…なんなんだ？/",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_87_0": "\\EQ＊ あれは　天使…\n　 エンジェルだよ。/",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_88_0": "\\EQ＊ ボクの知るかぎり^1　\n　 あれが　本当の姿だと\n　 言われてるんだ。/",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_90_0": "\\EZ＊ …/",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_91_0": "\\Eh＊ いやぁ^1…マジか？^1　\n　 さすがに　これは…/%",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_150_0": "＊ (予言だ…)/",
  "obj_dw_churchc_angelprophecy_slash_Step_0_gml_151_0": "＊ (…見ていると\n　 不思議な気持ちになった。\n　 それ以上は　調べなかった)/%",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_89_0": "\nある",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_90_0": "\nない",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_95_0": "＊ 宝？　宝など　ありはしない…\n　 経験が　あるだけだ。/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_96_0": "＊ 心の向こう側で^1…\n　 なにか　やり忘れたことは？/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_104_0": "＊ ワレワレは皆　うそつきである。\n　 うそつきでいるのは\n　 楽しいことだ。/%",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_121_0": "＊ まちがいない。\n　 信じぬ者たるワレを　沈めてくれ。\n　 ワレは　像になるべきだ。/%",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_127_0": "＊ もちろんだ。\n　 やり残すことなど　ありはしない。/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_128_0": "＊ 真実を　口にできない者は\n　 うそつきである。/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_129_0": "＊ キミも　ワレも^1　もはや真実を知る\n　 ことはできない^1。したがって\n　 ワレワレは皆　うそつきである！/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_130_0": "＊ その目で　探してみるといい^1！\n　 もといた場所には\n　 なにも　ないだろう？/%",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_140_0": "＊ うそつきだ^1！　キミの両手は\n　 輝いている。キミは　取り^1　描いた。\n　 取り^1　描いたのだ。/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_141_0": "＊ 券とトランプ^1　灰色の絵^1　\n　 くり返される　なぞり描き^1…\n　 すべては　明らかだ！/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_142_0": "＊ …とはいえ　ワレは理解したと言えば\n　 それは　うそになる！/%",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_148_0": "＊ キミは　真実を　堂々と　口にする。/",
  "obj_dw_churchc_angelprophecy_encounter_slash_Step_0_gml_149_0": "＊ いまのところは　問題ないが^1　\n　 キミには　うそつきの兆候がある。/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_29_0": "\\E4＊ 暗くなってきたね…\n　 くっついて進もう。/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_107_0": "\\EJ＊ …！？/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_274_0": "\\Ed＊ クソッ…！/",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_275_0": "\\Ec＊ 暗すぎて\n　 なんも見えねぇ…/",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_276_0": "\\Eb＊ このままだと…/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_333_0": "\\Ed＊ …クリス？/",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_335_0": "\\ED＊ なんだよその…^1　\n　 光ってるヤツ？/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_572_0": "\\EC＊ スージィッ…！\n　 なにしてるの…！？/",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_574_0": "\\El＊ …クリスに^1…\n　 ダメージひとりじめ\n　 させっかよ…/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_804_0": "\\EQ＊ スージィ^1…　クリス^1…/",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_805_0": "\\Ec＊ ２人が苦しいとき…\n　 ボクが　その痛みを\n　 受けられるときは…/",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_806_0": "\\Ee＊ いつでも\n　 そばに　いるからね？/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_999_0": "\\EQ＊ …なんとか　しのげたみたい。/",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_1001_0": "\\ED＊ …ああ。/%",
  "obj_dw_churchc_darkswords_slash_Step_0_gml_1005_0": "\\EY＊ …うし^1。ケリつけようぜ。/%",
  "obj_dw_churchc_encounter1_slash_Step_0_gml_61_0": "\\EC＊ 聞こえたか？/%",
  "obj_dw_churchc_encounter1_slash_Step_0_gml_103_0": "\\E4＊ ２つめの泉が…/",
  "obj_dw_churchc_encounter1_slash_Step_0_gml_104_0": "\\E8＊ ボクたちを呼んでるんだ。/%",
  "obj_dw_churchc_encounter1_slash_Step_0_gml_115_0": "\\EV＊ ナイトは　もう^1　\n　 あそこに　いるんだろうな…/%",
  "obj_dw_churchc_encounter1_slash_Step_0_gml_119_0": "\\EE＊ クリス…行こう。/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_106_0": "\\E5＊ 泉の気配…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_107_0": "\\EE＊ このかべを　登った先に\n　 感じるよ…/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_143_0": "\\Ed＊ なっ…！/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_144_0": "\\Eb＊ こんなの\n　 どうやって登るんだ…？/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_165_0": "＊ トモダチ　タスケる…？/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_200_0": "\\EC＊ ジャックさん…？\n　 なにしてるんですか\n　 ここは危ないですよ…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_202_0": "\\EZ＊ ラルセイの言うとおりだ^1。\n　 じいさんの部屋に\n　 もどってろ。/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_212_0": "＊ ジャック　キケンも\n　 コ　ワ　イ　くない！！/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_213_0": "＊ トモダチ　ワ　ジャック　タスケた。\n　 ジャック　ワ　ヨワヨワダメダメの\n　 ホラアナから　ヌケだせた。/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_214_0": "＊ ジャック　ワ　トモダチ　ノボるとき\n　 いつでも　タスケる！！/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_216_0": "\\ED＊ …まあ　たしかに\n　 それしか　手は\n　 なさそうだけどな。/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_218_0": "＊ オーキートーキー。\n　 ジャックの　カタに\n　 ノれクダサイ (*´ω｀*)/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_437_0": "＊ ここ　カベ　ウ　ス　イの　トコロ^1。\n　 キを　ツケる…/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_582_0": "\\EZ＊ おい！/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_584_0": "＊ トモダチ…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_585_0": "＊ ジャック　ウゴくと…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_586_0": "＊ カベ　コワレる^1。\n　 みんな　オチる…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_588_0": "\\Ec＊ どうすりゃいんだよ…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_590_0": "＊ ジャックから　オリろください^1…\n　 ジャック　ワ　ここに　ノコる…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_592_0": "\\EZ＊ は？　おまえを置いてくわけ\n　 ねえだろ！/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_594_0": "\\Eb＊ スージィ…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_596_0": "\\EV＊ …/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_598_0": "\\E8＊ やるべきことを…\n　 やるしかないよ。/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_600_0": "\\EV＊ …/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_602_0": "\\Ee＊ おりよう。\n　 ゆっくり。\n　 気をつけて。/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_824_0": "＊ ジャック^1…　ココにイる^1…\n　 すごく　ジットしてる。/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_826_0": "\\E8＊ ジャックさん　ごめんなさい^1…\n　 なるべく急いで\n　 泉を封印してきます。/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_909_0": "\\Ed＊ ジャック！！/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_919_0": "\\E4＊ …/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_921_0": "\\EV＊ ウソだろ…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_922_0": "\\EU＊ 着地したところは\n　 見えなかったよな…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_923_0": "\\EU＊ ひょっとしたら^1…\n　 無事かもしれなくね？\n　 なあ？/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_924_0": "\\EU＊ ラルセイ^1…どう思う？/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_926_0": "\\Ee＊ ボクは…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_927_0": "\\Ef＊ …/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_929_0": "\\EV＊ クソッ…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_930_0": "\\EV＊ ナイトのヤロウ…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_931_0": "\\EI＊ ナイトのヤロウ！！/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_975_0": "\\EC＊ スージィ^1！\n　 そんなに　速く登ったら…！！/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1076_0": "＊ ダイジョウブ^1…\n　 ジャック　ココに　ツカマって…/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1166_0": "\\EZ＊ おまえら…^1？\n　 なにしてんだよ！？/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1175_0": "＊ 気づくのが遅れ　面目次第もない…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1176_0": "＊ キミたち３人は^1　予言の勇者では！？/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1177_0": "＊ キミたちの　心やさしさは^1　\n　 すでに　伝説として\n　 語りつがれている！/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1241_0": "＊ ゆえに　こうして　キミたちの戦に\n　 急ぎ駆けつけたしだい…/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1242_0": "＊ いざ　ゆけ^1…　ナイトを　倒せ！/%",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1310_0": "\\E2＊ みなさん^1…どうもありがとう！/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1312_0": "\\E9＊ みんなに　やさしくした\n　 かいがあったな！/",
  "obj_dw_churchc_finalclimb_slash_Step_0_gml_1313_0": "\\E2＊ うーし！\n　 ナイトをブッ倒しにいくぜ！/%",
  "obj_dw_churchc_prophecies_slash_Step_0_gml_209_0": "＊ 時計が真夜中を告げる前に^1　\n　 影は　落ちる！/",
  "obj_dw_churchc_prophecies_slash_Step_0_gml_210_0": "＊ 影は伸びる　ヘビのごとく！/%",
  "obj_dw_churchc_prophecies_slash_Step_0_gml_215_0": "＊ 時計が急ぎもどろうとも^1　\n　 影は伸びていた！/",
  "obj_dw_churchc_prophecies_slash_Step_0_gml_216_0": "＊ ひとかたまりの影が^1　\n　 這い進む^1　這い進む^1　\n　 ヘビのごとく！/",
  "obj_dw_churchc_prophecies_slash_Step_0_gml_217_0": "＊ …ワレらの先祖は　そう言う^1。\n　 なんとも　おかしな者たちだ！/%",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_22_0": "\nスカーレッティーを\n作る($500)",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_23_0": "\nラプソティーを\n作る($300)",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_24_0": "作らない",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_29_0": "＊ (不思議な泉だ^1。\n　 杯が　いくつも　ならんでいる)/",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_30_0": "＊ (コインを入れると^1　\n　 液体が変容する…)/",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_35_0": "＊ (不思議な　泉だ)/",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_82_0": "＊ (もちものが　いっぱいだった)/%",
  "obj_dw_churchc_savepoint_slash_Step_0_gml_87_0": "＊ (おカネが　足りなかった)/%",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_11_0": "\n鳴らす",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_12_0": "\n鳴らさない",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_16_0": "＊ (鐘だ。審判の音を鳴らす？)/",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_95_0": "＊ (審判は下され　心やさしき者と\n　 判じられた)/",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_100_0": "＊ (…鐘は　うつろに響いた)/%",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_106_0": "＊ (…だが^1　救える者　全員は\n　 まだ救っていない)/",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_107_0": "＊ (…先へ進む？\n　 鐘は　すべてを\n　 この者に　ゆだねる)/%",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_110_0": "＊ (…だが^1　まだ出会っておらず\n　 救っていない敵がいる)/",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_111_0": "＊ (たいした意味は　ないかもしれない^1。\n　 が^1　鐘は　すべてを\n　 この者に　ゆだねる)/%",
  "obj_dw_churchc_savepoint_judgmentbell_slash_Step_0_gml_114_0": "＊ (…救える者　全員を救ったようだ)/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_92_0": "\\EV＊ …ハァ^1…ハァ^1…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_93_0": "\\El＊ なんとか　逃げ切ったな…/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_119_0": "\\Ee＊ …いまのところはね。/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_120_0": "\\E8＊ でも　ここにいたら…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_121_0": "\\Eb＊ …また　見つかるのは\n　 時間の問題だよ。/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_123_0": "\\Ee＊ ラルセイ^1…\n　 いまの^1　なんなんだよ？/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_153_0": "\\ET＊ 泉の力が　極端に\n　 強くなって…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_154_0": "\\ET＊ 闇の流れが　まるで\n　 さけび声を上げるように\n　 噴きだすと…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_155_0": "\\EZ＊ 生み出されるもの…\n　 それが…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_156_0": "\\Ef＊ タイタンだよ。/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_157_0": "\\Ef＊ タイタンは\n　 「闇の恐れ」。/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_158_0": "\\Ef＊ 真夜中に^1\n　 耳にまとわりつく\n　 心臓の音。/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_159_0": "\\Ef＊ 心の裏側が落とす影。/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_160_0": "\\Ef＊ タイタンに　意志はなくて…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_161_0": "\\EZ＊ ただ　破壊するために\n　 存在する。/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_207_0": "\\Eh＊ それじゃあ…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_208_0": "\\Eh＊ どうやって倒しゃいいんだ？/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_210_0": "\\Ee＊ …/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_211_0": "\\Ef＊ …倒すのは^1…無理だと思う…\n　 生まれ出る速度が\n　 あまりにも速すぎて…/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_234_0": "\\Ef＊ …/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_235_0": "\\ET＊ でも…/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_252_0": "\\Ep＊ クリスは　泉を封印できる。/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_253_0": "\\Eq＊ タイタンが\n　 闇の泉と同質のものなら…/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_254_0": "\\ER＊ ひょっとしたら…/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_304_0": "\\EC＊ 見つかった！/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_426_0": "\\Ep＊ また　体によじのぼれる\n　 場所を　急いでさがそう…/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_626_0": "\\EZ＊ …ウソ^1…もう…^1？\n　 こんなに\n　 産みつけられてる…！/%",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_799_0": "\\Ep＊ みんな…大丈夫…？/",
  "obj_dw_churchc_titanclimb1_post_slash_Step_0_gml_801_0": "\\El＊ ああ^1…このまま登るぞ。/%",
  "obj_dw_churchc_titanclimb2_slash_Create_0_gml_30_0": "＊ 急げ！　なんか追っかけてくる！/%",
  "obj_dw_churchc_titanclimb2_slash_Create_0_gml_33_0": "＊ クリス！　こっちだ！/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_218_0": "\\EV＊ ゼェ^1…ハァ…/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_219_0": "\\El＊ これ以上　上へは\n　 行けねぇみてぇだな…/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_250_0": "\\El＊ …ラルセイ^1　平気か？/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_252_0": "\\Ee＊ う^1…うん^1　大丈夫^1。\n　 ちょっと^1…動揺してるだけ。/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_305_0": "\\ED＊ スージィ…/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_307_0": "\\Ek＊ お安いご用だぜ。/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_334_0": "\\El＊ うし…行こう。/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_425_0": "\\El＊ …行き止まりか。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_427_0": "\\EQ＊ …うん^1…そうみたい。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_429_0": "\\El＊ なら^1　ここで\n　 タイタンのヤロウを\n　 待つしかねーな。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_431_0": "\\Ef＊ …ううん。/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_470_0": "\\Ee＊ …ここに　いたよ^1。\n　 ずっと。/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_490_0": "\\El＊ …おい！^1　てめぇ！/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_491_0": "\\EV＊ わかってねぇみてぇだから\n　 教えてやるよ…/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_492_0": "\\EX＊ オレらは　勇者だ。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_493_0": "\\El＊ オレらの物語で^1　\n　 まだまだ\n　 やることがある。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_494_0": "\\Ek＊ …書いてあること全部\n　 現実になるのを\n　 この目で見るんだ。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_495_0": "\\El＊ だから^1　これ以上\n　 ジャマすんのは\n　 やめてもらうぜ。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_496_0": "\\EV＊ そこを　どかねぇなら^1…\n　 オレの手のふるえが\n　 止まりしだい…/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_497_0": "\\El＊ このアックスで　まっぷたつに\n　 ブッたぎってやるからな！！/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_541_0": "\\El＊ クリス！^1　ラルセイ^1！\n　 いくぞ！！/%",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_842_0": "＊ ゆ…勇者たち…！\n　 ワタシは…持てる力を\n　 ふりしぼり…/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_843_0": "＊ なんとか　ここまで　登ってきた。\n　 キミたちの　力になるために。/",
  "obj_dw_churchc_titanclimb2_post_slash_Step_0_gml_844_0": "＊ さあ…宝箱の中のものは\n　 キミたちに　あげよう！/%",
  "obj_dw_church_arena_slash_Step_0_gml_54_0": "\\E6＊ うおーマジか…\n　 これが　例の\n　 まほうのアックスだな？/%",
  "obj_dw_church_arena_slash_Step_0_gml_59_0": "\\E6＊ すげー…^1\n　 なんか　よくわかんねーけど^1　\n　 すげーな！/%",
  "obj_dw_church_arena_slash_Step_0_gml_85_0": "＊ (まほうのアックスを　手に%%",
  "obj_dw_church_arena_slash_Step_0_gml_107_0": "＊ ちょいと　待った^1！\n　 カネは　払ったのかね！？/%",
  "obj_dw_church_arena_slash_Step_0_gml_130_0": "\\EK＊ …は！？　え！？\n　 なに言ってんだよ？/%",
  "obj_dw_church_arena_slash_Step_0_gml_147_0": "＊ ここも　ワシの書斎の中じゃ。\n　 ちがうかね？/%",
  "obj_dw_church_arena_slash_Step_0_gml_171_0": "＊ うちの店に^1　タダのもんは\n　 ありゃせんぞい^1。なんでこれだけ\n　 タダでもらえると思ったんじゃ？/",
  "obj_dw_church_arena_slash_Step_0_gml_173_0": "\\E2＊ ハハッ…おもしれえ。\n　 わりぃけど\n　 このアックスは　もらうぜ。/",
  "obj_dw_church_arena_slash_Step_0_gml_175_0": "＊ …じょうだんで言っとるんじゃ\n　 ないぞい！　値札がついとる\n　 じゃろうが！/",
  "obj_dw_church_arena_slash_Step_0_gml_177_0": "\\E6＊ え^1。ねふ…？/%",
  "obj_dw_church_arena_slash_Step_0_gml_208_0": "\\EB＊ …あー　これか？/%",
  "obj_dw_church_arena_slash_Step_0_gml_222_0": "\\EE＊ ９億^1　９千万^1　\n　 ９百^1　99ドル…！？/",
  "obj_dw_church_arena_slash_Step_0_gml_224_0": "＊ ガーッハッハ！\n　 うっかり　セール価格のままに\n　 しておったわい！/",
  "obj_dw_church_arena_slash_Step_0_gml_225_0": "＊ …じゃが^1　おまえさんも　だいぶ\n　 がんばって　ここに　たどりついた^1。\n　 ここは　ひとつ　取り引きせんかね？/",
  "obj_dw_church_arena_slash_Step_0_gml_226_0": "＊ おまえさん^1　たった１人で\n　 ワシの挑戦を突破できたら^1…\n　 そいつを　タダでやろう。/",
  "obj_dw_church_arena_slash_Step_0_gml_228_0": "\\E2＊ ヘッ^1　そうくると思ったぜ。\n　 なにすりゃいんだ？/",
  "obj_dw_church_arena_slash_Step_0_gml_230_0": "＊ フム^1…そうじゃな…/",
  "obj_dw_church_arena_slash_Step_0_gml_231_0": "＊ …散髪は　どうじゃ？/",
  "obj_dw_church_arena_slash_Step_0_gml_233_0": "\\E6＊ …あ？/",
  "obj_dw_church_arena_slash_Step_0_gml_234_0": "\\E9＊ おう　いいぜ。\n　 どの毛を　カットすりゃいい？/",
  "obj_dw_church_arena_slash_Step_0_gml_236_0": "＊ どれでも　かまわんぞい。/%",
  "obj_dw_church_arena_slash_Step_0_gml_290_0": "＊ どれも　これも　伸びすぎてこまる^1！\n　 １本でも散髪してくれたら^1　そこの\n　 商品は　おまえさんのもんじゃ。/%",
  "obj_dw_church_arena_slash_Step_0_gml_300_0": "\\EA＊ うーし^1　じゃあ　まずは\n　 そのヒゲからだ…/%",
  "obj_dw_church_arena_slash_Step_0_gml_326_0": "\\E6＊ …へ？/%",
  "obj_dw_church_arena_slash_Step_0_gml_342_0": "\\EH＊ じっとしてろよ！！/%",
  "obj_dw_church_arena_slash_Step_0_gml_390_0": "\\EQ＊ …ヘヘッ^1…\n　 そーゆーことかよ。/",
  "obj_dw_church_arena_slash_Step_0_gml_391_0": "\\E2＊ オレが手加減すると\n　 思ってんだな？/%",
  "obj_dw_church_arena_slash_Step_0_gml_437_0": "\\E6＊ あれ…/",
  "obj_dw_church_arena_slash_Step_0_gml_439_0": "＊ ほう^1。\n　 真剣勝負を　お望みじゃな？/",
  "obj_dw_church_arena_slash_Step_0_gml_440_0": "＊ なら^1　おまえさんには\n　 聴こえておるかな？/",
  "obj_dw_church_arena_slash_Step_0_gml_441_0": "＊ 深みより鳴り響く^1　あの歌が…？/",
  "obj_dw_church_arena_slash_Step_0_gml_442_0": "＊ そう^1　あれこそが…/%",
  "obj_dw_church_arena_slash_Step_0_gml_568_0": "＊ …正義の鉄槌の歌じゃ！/%",
  "obj_dw_church_arena_slash_Step_0_gml_869_0": "\\EV＊ …クソッ^1　\n　 ついてけなかった…/",
  "obj_dw_church_arena_slash_Step_0_gml_871_0": "＊ ガッハッハ^1…\n　 おまえさんも　よくやったぞい！/%",
  "obj_dw_church_arena_slash_Step_0_gml_897_0": "＊ ほれ。/",
  "obj_dw_church_arena_slash_Step_0_gml_899_0": "\\E6＊ …へ？/%",
  "obj_dw_church_arena_slash_Step_0_gml_909_0": "＊ おまえさんの瞳に燃える炎^1…\n　 それが　見られただけで十分じゃ。/",
  "obj_dw_church_arena_slash_Step_0_gml_910_0": "＊ 持っていくといい。\n　 ついでに　このジェムもな。/%",
  "obj_dw_church_arena_slash_Step_0_gml_923_0": "\\EV＊ …/",
  "obj_dw_church_arena_slash_Step_0_gml_924_0": "\\EL＊ いや。それは\n　 じいさんの　もんだ。/",
  "obj_dw_church_arena_slash_Step_0_gml_926_0": "＊ …欲しくないのかね？/",
  "obj_dw_church_arena_slash_Step_0_gml_928_0": "\\EV＊ 欲しいに決まってるだろ。\n　 でも…/",
  "obj_dw_church_arena_slash_Step_0_gml_929_0": "\\EW＊ オレに　くれるもんが\n　 なくなっちまうよ…/",
  "obj_dw_church_arena_slash_Step_0_gml_930_0": "\\EY＊ …リベンジバトルの\n　 あとでさ！/",
  "obj_dw_church_arena_slash_Step_0_gml_932_0": "＊ ワーッハッハッハッハ！/",
  "obj_dw_church_arena_slash_Step_0_gml_933_0": "＊ たいした根性じゃな^1！\n　 気に入ったぞい！/%",
  "obj_dw_church_arena_slash_Step_0_gml_980_0": "\\EV＊ …クソッ！/",
  "obj_dw_church_arena_slash_Step_0_gml_982_0": "＊ あきらめるつもりじゃ\n　 なかろうな？/",
  "obj_dw_church_arena_slash_Step_0_gml_984_0": "\\EQ＊ だれがだよ！\n　 クリス！\n　 もっかいやろうぜ！/%",
  "obj_dw_church_arena_slash_Step_0_gml_1005_0": "＊ 気にすることはないぞい。/",
  "obj_dw_church_arena_slash_Step_0_gml_1006_0": "＊ どれ^1　もう一戦　どうかね？/%",
  "obj_dw_church_arena_slash_Step_0_gml_1131_0": "\\E2＊ ど…どうだよ　じいさん！？/%",
  "obj_dw_church_arena_slash_Step_0_gml_1142_0": "＊ ワーッハッハッハ！\n　 こんなに愉快な思いをしたのは\n　 初めてじゃわい！/",
  "obj_dw_church_arena_slash_Step_0_gml_1144_0": "\\E9＊ オレが　最後にブッ放った\n　 回復まほう^1　見たか！？/",
  "obj_dw_church_arena_slash_Step_0_gml_1146_0": "＊ ガーッハッハッハ！/%",
  "obj_dw_church_arena_slash_Step_0_gml_1173_0": "\\EA＊ じゃ^1　コイツは\n　 えんりょなくもらうぜ。/%",
  "obj_dw_church_arena_slash_Step_0_gml_1193_0": "＊ (正義のアックスが\n　 「ぶき」に　加わった。)/%",
  "obj_dw_church_arena_slash_Step_0_gml_1202_0": "＊ (…が　これ以上　持てない)/",
  "obj_dw_church_arena_slash_Step_0_gml_1204_0": "\\EH＊ うぉい　クリス！\n　 どーでもいいもん\n　 買いすぎだろ！！/",
  "obj_dw_church_arena_slash_Step_0_gml_1206_0": "＊ ガーッハッハッハッハ！\n　 心配せずとも^1　この斧は\n　 どこへも行きはせん…/",
  "obj_dw_church_arena_slash_Step_0_gml_1207_0": "＊ …あとで　取りにくることじゃ！/%",
  "obj_dw_church_arena_slash_Step_0_gml_1245_0": "＊ それと…これもな。/",
  "obj_dw_church_arena_slash_Step_0_gml_1246_0": "＊ なぜか　ワシの机の上に\n　 この　妙なガラスのかけらが\n　 あっての。/",
  "obj_dw_church_arena_slash_Step_0_gml_1247_0": "＊ どうも^1　だれかが　ワシに　どうにか\n　 使わせようとしたんじゃないかという\n　 気がしてのう。/",
  "obj_dw_church_arena_slash_Step_0_gml_1248_0": "＊ じゃが　ワシは　心をひかれんかった^1。\n　 おまえさんに　やろう。/",
  "obj_dw_church_arena_slash_Step_0_gml_1250_0": "＊ (シャドウジェムが\n　 「だいじなもの」に加わった)/%",
  "obj_dw_church_arena_slash_Step_0_gml_1270_0": "＊ じつのところ^1　おまえさんが\n　 ワシを倒せても倒せなくても^1　\n　 全部　おまえさんにやろうと思った。/",
  "obj_dw_church_arena_slash_Step_0_gml_1271_0": "＊ じゃが^1…なかなかやるのう！/%",
  "obj_dw_church_arena_slash_Step_0_gml_1296_0": "\\EL＊ じいさん^1　ウデが\n　 にぶったんじゃねーの？/",
  "obj_dw_church_arena_slash_Step_0_gml_1298_0": "＊ とんでもない！/",
  "obj_dw_church_arena_slash_Step_0_gml_1299_0": "＊ おまえさんは…\n　 本当に「ひとり」では\n　 なかったじゃろう？/",
  "obj_dw_church_arena_slash_Step_0_gml_1301_0": "\\EK＊ …は？/",
  "obj_dw_church_arena_slash_Step_0_gml_1302_0": "\\E6＊ …あー^1　クリスのことか？\n　 …まあな。/",
  "obj_dw_church_arena_slash_Step_0_gml_1303_0": "\\EK＊ あいつに助けてもらわねーと\n　 勝てなかったのは\n　 たしかだよな。/",
  "obj_dw_church_arena_slash_Step_0_gml_1305_0": "＊ それでも　おまえさんの力を\n　 軽んじるつもりはないぞい。/",
  "obj_dw_church_arena_slash_Step_0_gml_1306_0": "＊ おまえさんは　なかなかの逸材じゃ…/",
  "obj_dw_church_arena_slash_Step_0_gml_1308_0": "\\E9＊ ヘッ　じいさんもな。/",
  "obj_dw_church_arena_slash_Step_0_gml_1310_0": "＊ さ^1　その斧を　思う存分\n　 振るってくるといい！\n　 ガーッハッハ！/",
  "obj_dw_church_arena_slash_Step_0_gml_1312_0": "\\E2＊ そうさせてもらうぜ。/%",
  "obj_dw_church_arena_slash_Step_0_gml_1387_0": "\\E9＊ リベンジしたかいが\n　 あったな！/%",
  "obj_dw_church_arena_slash_Step_0_gml_1392_0": "\\E9＊ やっとだぜ！！/",
  "obj_dw_church_arena_slash_Step_0_gml_1393_0": "\\E2＊ 正直^1　勝てるか\n　 わかんねーとか\n　 思いはじめてたけどさ…/%",
  "obj_dw_church_arena_slash_Step_0_gml_1403_0": "＊ それこそ　忍耐というものじゃ^1。\n　 挑戦するたびに^1　\n　 少しずつ　腕が上がっていく。/",
  "obj_dw_church_arena_slash_Step_0_gml_1404_0": "＊ …それが見られたから^1　十分じゃよ。/",
  "obj_dw_church_arena_slash_Step_0_gml_1405_0": "＊ これから先^1　おまえさんは\n　 ワシより強い相手にも\n　 出会うじゃろう。/",
  "obj_dw_church_arena_slash_Step_0_gml_1406_0": "＊ じゃが　そのとき^1　\n　 おまえさんは　もう\n　 準備が　できておる。/",
  "obj_dw_church_arena_slash_Step_0_gml_1407_0": "＊ 決してあきらめず^1　\n　 地獄を味わわせてやることじゃ！！/",
  "obj_dw_church_arena_slash_Step_0_gml_1409_0": "\\E9＊ 言われなくても\n　 わかってるぜ！/%",
  "obj_dw_church_arena_slash_Step_0_gml_1519_0": "＊ では　また^1　そのうちな。/%",
  "obj_dw_church_arena_slash_Step_0_gml_1564_0": "\\E0＊ …ああ^1。だな。/%",
  "obj_dw_church_arena_slash_Step_0_gml_1580_0": "\\ED＊ なあ　じいさん^1…　なんで\n　 そんなに^1　オレの\n　 世話焼いてくれんだ？/",
  "obj_dw_church_arena_slash_Step_0_gml_1581_0": "\\ED＊ だれにも\n　 頼まれてねえのにさ。/",
  "obj_dw_church_arena_slash_Step_0_gml_1583_0": "＊ おまえさんは^1　ワシが　むかーし\n　 知っとった^1　とあるひとに\n　 似とるんじゃよ。/",
  "obj_dw_church_arena_slash_Step_0_gml_1585_0": "\\E6＊ えっ　だれ？/",
  "obj_dw_church_arena_slash_Step_0_gml_1587_0": "＊ さっき言った　むかしの物語の\n　 登場人物じゃ。/",
  "obj_dw_church_arena_slash_Step_0_gml_1589_0": "\\EK＊ …「ロード・オブ・ザ・\n　 ハンマー」かよ^1。オレは\n　 ぜってー読まねーな。/",
  "obj_dw_church_arena_slash_Step_0_gml_1590_0": "\\E0＊ …でもさ…/",
  "obj_dw_church_arena_slash_Step_0_gml_1591_0": "\\E1＊ その本って　たしか^1…\n　 「ドラゴンブレイダー」の\n　 元ネタじゃなかったか？/",
  "obj_dw_church_arena_slash_Step_0_gml_1593_0": "＊ そうじゃとも。\n　 ところどころ　本とは　ちがう\n　 内容に変わっとるがの。/",
  "obj_dw_church_arena_slash_Step_0_gml_1594_0": "＊ 当然^1　本の熱烈なファンたちは\n　 怒ったが…^1　おもしろいとは\n　 思わんかね？/",
  "obj_dw_church_arena_slash_Step_0_gml_1595_0": "＊ 原作の本も^1　なにか別のものの\n　 ひとつの解釈にすぎん。/",
  "obj_dw_church_arena_slash_Step_0_gml_1596_0": "＊ 物語は^1　くりかえし語られ\n　 変化してしかるべきもの^1…\n　 ワシは　そう思っておるぞい。/",
  "obj_dw_church_arena_slash_Step_0_gml_1598_0": "\\E0＊ …へー。/",
  "obj_dw_church_arena_slash_Step_0_gml_1600_0": "＊ かべに書かれた文字は^1　\n　 おまえさんを「勇者」と呼んだ。/",
  "obj_dw_church_arena_slash_Step_0_gml_1601_0": "＊ …おまえさんが　何者になろうと^1　\n　 それは　とてつもなく\n　 すばらしいものじゃろう。/%",
  "obj_dw_church_arena_slash_Step_0_gml_1700_0": "\\EV＊ …/",
  "obj_dw_church_arena_slash_Step_0_gml_1701_0": "\\E7＊ …てかさ^1　オレ\n　 「ドラゴンブレイダー」の\n　 どのキャラに　似てんの？/%",
  "obj_dw_church_arena_slash_Step_0_gml_1717_0": "＊ ガーッハッハッハ！/%",
  "obj_dw_church_arena_slash_Step_0_gml_1752_0": "＊ おまえさんは^1…ドラゴンじゃ。/%",
  "obj_dw_church_arena_slash_Step_0_gml_1774_0": "\\E9＊ ヘヘッ　だといいなと\n　 思ったんだ。/%",
  "obj_dw_church_a_intro1_slash_Step_0_gml_53_0": "\\E0＊ …なんだ　ここ？/%",
  "obj_dw_church_a_intro1_slash_Step_0_gml_70_0": "\\E1＊ …なんか^1　ブキミだな。/%",
  "obj_dw_church_a_intro1_slash_Step_0_gml_87_0": "\\E0＊ …行こうぜ。/%",
  "obj_dw_church_a_intro1_slash_Step_0_gml_165_0": "\\EL＊ ったく。待ちくたびれたぜ。/%",
  "obj_dw_church_a_intro1_slash_Step_0_gml_177_0": "\\E2＊ 行こうぜ。/%",
  "obj_dw_church_a_intro1_slash_Step_0_gml_213_0": "\\EK＊ (なあ　クリス。\n　 ビビる気持ちも\n　 わかるけどさ…)/",
  "obj_dw_church_a_intro1_slash_Step_0_gml_214_0": "\\E1＊ (走れんのは\n　 知ってるよな？)/",
  "obj_dw_church_a_intro1_slash_Step_0_gml_215_0": "\\E0＊ (…一応　言っとくぜ)/%",
  "obj_dw_church_bellhall_bookroom_winglade_slash_Step_0_gml_35_0": "＊ 自分の道を　切り開け。/",
  "obj_dw_church_bellhall_bookroom_winglade_slash_Step_0_gml_36_0": "＊ おのれの道を　切り進め。/",
  "obj_dw_church_bellhall_bookroom_winglade_slash_Step_0_gml_37_0": "＊ ワタシの道は　キミの道をはばむ。/%",
  "obj_dw_church_bellhall_bookroom_winglade_slash_Step_0_gml_42_0": "＊ キミの道か　ハイウェイか。/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_43_0": "\\E7＊ おー！^1　いかにもって感じ^1！\n　 やっぱ　ここで\n　 まちがいないぜ！/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_56_0": "\\EK＊ …あれ？/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_76_0": "\\E2＊ じいさん^1！\n　 なにやってんだよ\n　 こんなとこで？/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_78_0": "＊ 静かなところで　手紙の続きを\n　 書こうと思ってのう。/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_80_0": "\\E0＊ 手紙…/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_81_0": "\\E1＊ てか^1　これ　夢だって\n　 わかってるよな^1？\n　 目が覚めたら…/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_82_0": "\\ED＊ この場所も…\n　 その手紙も…\n　 ここにあるもんは　みんな…/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_84_0": "＊ ほう。そうなのかね。/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_86_0": "\\EN＊ ああ^1。でも^1　オレは\n　 消えないぜ^1。じいさんの\n　 目が覚めたあともな。/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_118_0": "\\E0＊ …/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_119_0": "\\ED＊ なあ^1…\n　 さっき　オレに　なんか\n　 教えようとしただろ。/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_121_0": "＊ いやいや^1。あれは全部\n　 おまえさんが　ひとりで\n　 やったことじゃよ。/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_123_0": "\\E2＊ なに言ってんだよ^1。\n　 てかさ^1　これまで　だれかに\n　 なんかを　教えられて…/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_124_0": "\\EK＊ 余計バカになった気分に\n　 ならなかったのは^1　\n　 じいさんが初めてだ。/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_126_0": "＊ ガッハッハ！　そもそもワシが\n　 だいぶ　モウロクしとるからな！/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_128_0": "\\E9＊ ヘヘッ…/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_171_0": "\\EK＊ …なあ　じいさん^1。このへんで\n　 音符が書いてあるもん\n　 見なかったか？/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_173_0": "＊ これのことかね？/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_201_0": "\\E7＊ そう！^1　これ！^1　これだよ^1！\n　 クリスが　コイツを\n　 覚えれば…/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_221_0": "\\EF＊ …/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_223_0": "＊ ほれ。紙とペンは　あるぞい。/%",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_244_0": "\\E6＊ は？^1　オレが　これを\n　 書いて写すのか…？　全部？/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_245_0": "\\EC＊ …てか^1　オレがペン使ったら^1　\n　 じいさんが　手紙\n　 書けなくなるじゃん。/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_247_0": "＊ 大事なことは　もう^1　\n　 おおかた書き終わった。/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_248_0": "＊ それに^1　おまえさんに　なにかを\n　 教えるんじゃったら^1\n　 宿題を出さんと　いかんじゃろう？/",
  "obj_dw_church_bellhall_curtain_slash_Step_0_gml_250_0": "\\E9＊ ヘッ^1　うぜぇー。/%",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_14_0": "＊ (本だなを調べた…\n　 …？　１冊の本がある！)/",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_15_0": "＊ (というか^1　ここには\n　 何冊もの本がある)/",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_16_0": "＊ (というか^1　ここだけじゃなく\n　 この部屋全体に　何冊もの本がある)/",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_17_0": "＊ (ふつうは　それらの本に\n　 とくに注目することはない)/",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_18_0": "＊ (でも今回は^1　注目した。\n　 それだけのことだ)/%",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_25_0": "＊ (ここに　１冊の本がある！！)\\f0\\f1/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_140_0": "\\E8＊ …ひょっとしたら…\n　 ここにも…？/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_141_0": "\\EQ＊ え…^1？\n　 ああ　ごめん^1　クリス^1。\n　 ちょっと…/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_142_0": "\\EK＊ スクラップブックに\n　 なりそうなものを\n　 さがしてただけだよ！/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_150_0": "\\E8＊ …/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_161_0": "ラルセイに\n読み聞かせ\nする",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_162_0": "ラルセイに\n読み聞かせ\nしてもらう",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_166_0": "\\E1＊ (うーん…\n　 クリスは　どの本が\n　 好きかな…？)/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_173_0": "\\EK＊ 本がある^1！\n　 さすが　図書室！/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_219_0": "\\E1＊ クリス^1！　え…？\n　 ボクに　読み聞かせ\n　 してくれるの…？/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_220_0": "\\E2＊ ありがとう^1！\n　 ボク^1　いっしょうけんめい\n　 聞くね！/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_221_0": "\\EJ＊ えっと^1…\n　 拍手したほうがいいときは\n　 教えてね…/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_222_0": "\\EL＊ …/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_223_0": "\\EK＊ ねえ^1…その本…\n　 絵しか　描いてないよ…？/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_228_0": "\\ED＊ クリス^1！　え…？\n　 この本を\n　 読み聞かせしてほしいの？/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_229_0": "\\E2＊ う…うん！　いいよ！\n　 ちょっと待ってね…/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_230_0": "\\E1＊ オホン！/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_231_0": "\\E1＊ …/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_232_0": "\\E2＊ あはは…　この本…\n　 絵しか描いてない\n　 みたいだね。/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_233_0": "\\EL＊ …/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_234_0": "\\EK＊ 絵と…\n　 言っちゃいけない言葉。/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_236_0": "\\EH＊ おまえら^1　オレの本で\n　 遊ぶな。/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_271_0": "\\EC＊ ここにある本^1…\n　 全部　なんか　おかしいぜ。/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_272_0": "\\E1＊ 全部のページに\n　 目だけ　描いてある…/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_273_0": "\\E0＊ …それに^1…\n　 １冊　話しかけて\n　 きやがった。/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_274_0": "\\E7＊ こんな感じなら^1　\n　 オレも学校で\n　 本読むぜ！/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_319_0": "\nいいね",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_320_0": "\nダメだね",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_326_0": "\\E7＊ …このハシゴ^1　　\n　 ラルセイの部屋に\n　 ぴったりじゃね？/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_327_0": "\\E2＊ 天井にも家具置いて^1　\n　 このハシゴで\n　 登るんだよ。/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_328_0": "\\EA＊ パーティするときは\n　 床を広く使えるぜ。/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_339_0": "\\E2＊ これで^1　いわゆる\n　 トーイツカンってのが\n　 出るな！/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_369_0": "\\EL＊ しゃ^1。印つけとくな^1。\n　 ラルセイが見てねーときに\n　 くすねとく。/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_376_0": "\\EK＊ じゃあ^1　かべを　直接\n　 よじ登るのか？/",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_377_0": "\\EL＊ クモかよ。/%",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_431_0": "＊ (望遠鏡だ)/",
  "obj_dw_church_climbtut_slash_Step_0_gml_33_0": "＊ Well hey dere^1! If you want to continue^1, you'll have ta climb!/%",
  "obj_dw_church_climbtut_slash_Step_0_gml_37_0": "＊ You can climb by holdin' ~1 when near a climbable area!/%",
  "obj_dw_church_climbtut_slash_Step_0_gml_42_0": "＊ Did ya get stuck? Hold ~1 to charge up a jump to leap across an area!/%",
  "obj_dw_church_climbtut_slash_Step_0_gml_46_0": "＊ You can hold ~1 to charge up a jump to leap across an area!/%",
  "obj_dw_church_climbtut_slash_Step_0_gml_52_0": "＊ That was a mighty fine leap y'did there!/",
  "obj_dw_church_climbtut_slash_Step_0_gml_53_0": "＊ Don't forget that you can jump up to two spaces using a charged jump!/%",
  "obj_dw_church_climbtut_slash_Step_0_gml_57_0": "＊ A real pro strat is to use the momentum to help you cross even faster!/%",
  "obj_dw_church_cupstack_slash_Step_0_gml_84_0": "\nお願いします",
  "obj_dw_church_cupstack_slash_Step_0_gml_85_0": "\n大丈夫です",
  "obj_dw_church_cupstack_slash_Step_0_gml_89_0": "＊ 運んでほしいか？/",
  "obj_dw_church_cupstack_slash_Step_0_gml_100_0": "＊ シュッパツ　シンコー！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_173_0": "\\EH＊ どこ行くんだよ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_224_0": "\\EC＊ チッ^1　また迷路かよ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_225_0": "\\E1＊ おい^1。じいさんの部屋は\n　 どっちだ？/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_256_0": "＊ あー^1…んー…/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_261_0": "＊ 左！^1　そう　左じゃ。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_363_0": "＊ フム…^1　こっちのはず\n　 じゃったがのう^1…\n　 試しに…上へ行ってみよう。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_372_0": "\\EK＊ (このまま　えんえん\n　 連れ回されたら^1　オレは\n　 暴れるぜ…)/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_461_0": "＊ ここを左^1…　そう^1　左じゃ。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_468_0": "\\EK＊ …/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_469_0": "\\EL＊ オレは　右へ行く。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_587_0": "\nさらに左へ",
  "obj_dw_church_darkmaze_slash_Step_0_gml_588_0": "\nスージィの\n行った方へ",
  "obj_dw_church_darkmaze_slash_Step_0_gml_589_0": "下へもどる",
  "obj_dw_church_darkmaze_slash_Step_0_gml_590_0": "どこでもない",
  "obj_dw_church_darkmaze_slash_Step_0_gml_592_0": "＊ おや^1　おまえさんは　こっちへ\n　 行ったのかい^1。フムフム…/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_593_0": "＊ ワシのカンじゃが^1　\n　 こっちではないと　思うぞい。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_594_0": "＊ …とはいえ^1　ワシも\n　 あえて　ちがう道を行くのは\n　 好きじゃ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_595_0": "＊ あえて　ちがう道を行けば\n　 よい考えが浮かぶ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_596_0": "＊ さて^1　おまえさんは　どう思う^1？\n　 ワシらは　どっちへ行く^1？\n　 どれを選んでも　正解じゃ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_631_0": "＊ なるほど^1。「わが道を行く」か^1！\n　 うむ。じつに感心じゃぞ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_632_0": "＊ では^1　そっちへ行ってみるとしよう！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_640_0": "\nお目付け役を\nする",
  "obj_dw_church_darkmaze_slash_Step_0_gml_641_0": "むしろ\n悪いことを\nけしかける",
  "obj_dw_church_darkmaze_slash_Step_0_gml_646_0": "＊ 友だちを気にかけるとは^1　\n　 感心なことじゃ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_647_0": "＊ あの　おじょうちゃんが　いい子で\n　 いるように^1　お目付け役を　\n　 するというわけじゃな？/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_656_0": "＊ もと来た道を引き返すのは^1　\n　 ちっとも悪いことではないぞい^1。\n　 なにか見落としたかもしれんしな。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_657_0": "＊ じゃが^1…もう一度前を向いたとき…/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_658_0": "＊ …世界が　すっかり変わって\n　 しまっていても\n　 驚きっこなしじゃぞ？/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_672_0": "＊ どこでもない…/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_673_0": "＊ その言葉には^1　妙な響きがある。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_674_0": "＊ どうやら　おまえさんは^1…\n　 だれかとの関係に\n　 問題を抱えておるようじゃ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_675_0": "＊ ワシにも経験があるぞい^1。\n　 おまえさんぐらいの歳のころにな。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_676_0": "＊ だれかとの関係が　凍りついたように\n　 冷え込むと…世界の終わりのように\n　 感じるじゃろう。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_677_0": "＊ じゃが^1…終わりはせん^1。\n　 おまえさんも^1　\n　 大人になってゆく…/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_678_0": "＊ そうやって日々を生きていくうちに^1　\n　 いつのまにか^1　すべてうまく\n　 いくもんじゃよ…/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_683_0": "＊ どこでもない^1…か。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_684_0": "＊ いつか　そこへ行くことも\n　 かなうじゃろう。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_685_0": "＊ いま^1　急いで行くことも\n　 なかろう？/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_766_0": "＊ ほう^1。宝箱じゃな^1？\n　 ほれ^1　開けてみるといい。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_789_0": "＊ …たいしたもんは\n　 入っとらんかったかね。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_790_0": "＊ じゃが^1　たどった道の先が\n　 どこでもなかったとしても…/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_791_0": "＊ 運動にはなったじゃろう。\n　 ガッハッハ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_837_0": "＊ (なぜか^1　ごくごくわずかに\n　 健康的になった気がした)/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_838_0": "＊ (最大HPが　１増えた)/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_882_0": "＊ ガッハッハ！　もっと　はっきり\n　 しゃべっていいんじゃぞ？/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_883_0": "＊ あの　おじょうちゃんは\n　 おまえさんを　信頼しとる。\n　 それを　よく覚えておくことじゃ。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_889_0": "＊ ハッハ！^1　自信家じゃの。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_890_0": "＊ 若いうちは　だれもが　悪ガキじゃ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_891_0": "＊ そうでないと　逆に心配になる！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_892_0": "＊ …おまえさんたち３人は^1　\n　 すばらしい冒険を　しとるに\n　 違いない！^1　ワッハッハ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1114_0": "\n取らない",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1115_0": "\n１つ取る",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1118_0": "＊ (器に　キャンディが入っている。\n　 「おひとつ　どうぞ」)/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1130_0": "\\EA＊ あの　じいさん^1　\n　 やっぱ　まちがえてたな。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1131_0": "\\E2＊ こっちの道が　正解だ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1133_0": "\\EU＊ あ^1…スージィ^1…\n　 そんなに　たくさん\n　 取っちゃ…/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1152_0": "\\EU＊ …/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1172_0": "＊ (本質的に　不安定な状況のようだ)/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1183_0": "＊ (１つ取った。\n　 \\cYダークダークキャンディ\\cWを\n　 手に入れた)/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1190_0": "＊ (ポケットに　キャンディ１つ\n　 入りそうか　チェックした)/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1191_0": "＊ (ポケットの中のアイテムを\n　 すべて取り出して　確認した)/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1192_0": "＊ (入らなそうだ)/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1193_0": "＊ (しかも^1　かなりダサい\n　 振る舞いだった)/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1201_0": "＊ (キャンディの入った器に\n　 手を突っ込んだ…)/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1202_0": "＊ (…！？^1　重心が動いた…！)/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1250_0": "\\E5＊ クリス　おまえ^1！\n　 欲ばるからだ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1268_0": "\\EH＊ …クソッ　床から直接\n　 食わねーと　いけなく\n　 なっただろ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1344_0": "\\EL＊ …/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1346_0": "\\EH＊ ラルセイ！　なにボケッと\n　 してんだ！　おまえも\n　 やるんだよ！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1347_0": "\\E5＊ せめて　食うフリぐらい\n　 しろよな！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1349_0": "\\EK＊ あ^1…うん！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1357_0": "\\EU＊ …ボクは^1…\n　 包み紙を　むく作業に\n　 専念するね…/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1373_0": "\\EM＊ 急いで食わねーから\n　 こうなるんだ。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1622_0": "\\E2＊ おい　カエルじいさん^1。\n　 アンタ　まちがってたな。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1623_0": "\\EA＊ こっちが　正しい道だったぜ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1629_0": "\\E0＊ やっとかよ。/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1630_0": "\\EK＊ てか　なんで最初っから\n　 こっちの道へ\n　 行かなかったんだ？/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1652_0": "＊ 正解の道を見つけたな^1！\n　 これで　ひと安心じゃ！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1653_0": "＊ うしろからついてくる\n　 親切な若者が^1　いまにも　強引に\n　 突っ切りそうじゃったからな！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1655_0": "\\EG＊ …親切な…？/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1683_0": "\\EZ＊ うぉい^1！\n　 だれだよ　そいつ…！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1775_0": "＊ フゥ！^1\n　 なんとも愉快痛快じゃったな！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1782_0": "＊ フゥ！　なかなかの\n　 ヒッチャカメッチャカぶり\n　 じゃったのう！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1783_0": "＊ とはいえ…\n　 あんなに乱暴にせんでも\n　 よかったんじゃないかね？/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1785_0": "\\EK＊ バトルってのは\n　 そーゆーもんだろ^1。\n　 なに言ってんだ？/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1787_0": "\\EQ＊ クリスは　いま\n　 別のやり方は　あまり\n　 したくないみたいなので…/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1793_0": "＊ ふむふむ　なるほど^1…\n　 そうじゃろうとも\n　 そうじゃろうとも…/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1805_0": "＊ ここまで来れば^1　\n　 あとは　ひとりで帰れるぞい。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1813_0": "＊ そうそう…　ワシは　ちょっとした\n　 店も　やっとるから…/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1815_0": "＊ ワシの書斎に来ることがあったら^1　\n　 ぜひとも顔を出しとくれ！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1817_0": "\\EH＊ はぁ！？\n　 こんだけ迷惑かけられて…/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1818_0": "\\E5＊ わざわざ　アンタの部屋なんか\n　 行くわけねーし！！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1819_0": "\\EH＊ お断りだ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1847_0": "＊ フムフム^1。なるほど　なるほど^1。\n　 とにかく　助かったぞい。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1859_0": "＊ そんじゃ　またのう！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1867_0": "\\EK＊ …ったく^1　イラつくぜ。/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_1915_0": "\\EH＊ どこ行くんだよ^1！\n　 足音　聞こえてっぞ！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_2028_0": "＊ 下がれ^1　生けるシカバネめ！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_2029_0": "＊ キサマのような　ケダモノが　いると^1　\n　 わが姫君が　お気を悪くする！/",
  "obj_dw_church_darkmaze_slash_Step_0_gml_2030_0": "＊ ワタシには　まだ　姫君がいないが^1　\n　 姫君を持った　あかつきには^1　\n　 わが姫君が　お気を悪くする！/%",
  "obj_dw_church_darkmaze_slash_Step_0_gml_2035_0": "＊ わが姫君に^1　わが雄姿を\n　 見せたいものだ！/%",
  "obj_dw_church_dark_maze_controller_slash_Step_0_gml_31_0": "＊ …ア　カ　ル　イ…/",
  "obj_dw_church_dark_maze_controller_slash_Step_0_gml_32_0": "＊ …ア　カ　ル　イ　を\n　 モッテキたの　ワ　ダレだ…/%",
  "obj_dw_church_dark_maze_controller_slash_Step_0_gml_36_0": "＊ …カエれ…/",
  "obj_dw_church_dark_maze_controller_slash_Step_0_gml_37_0": "＊ …オマエたちガ\n　 ここ　クる　ワ　ダメ…/%",
  "obj_dw_church_dark_maze_controller_slash_Step_0_gml_46_0": "＊ …ここ…キンダンのゾーン…/",
  "obj_dw_church_dark_maze_controller_slash_Step_0_gml_47_0": "＊ …そのまま　ススむ　と^1…\n　 ク　ラ　イ　の　なかで\n　 コ　ワ　イ　の　メに　アうぞ…/%",
  "obj_dw_church_gerson_follow_slash_Step_0_gml_93_0": "＊ フム！　予言か！\n　 じつに　気の利いた\n　 おとぎ話じゃな…/%",
  "obj_dw_church_gerson_follow_slash_Step_0_gml_98_0": "＊ うん？　まだ　読んどるんか？\n　 ずいぶん　ノンビリじゃのう！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_32_0": "＊ この上で^1　われらが愛しき\n　 かの御方は待つ…\n　 偉大なる勇者が　救いに現れるのを。/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_33_0": "＊ しかし　武者震いする　われらが\n　 小さき脚は　汗にまみれ^1　\n　 この　いまいましきカベを登れず…/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_34_0": "＊ いくたび　挑んでも^1　\n　 コロコロと　転がり落ちるばかり。/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_38_0": "＊ 愛を　この手につかまんと\n　 あと一歩のところまで　登りしも…\n　 ああ　なんと嘆かわしきことよ！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_43_0": "＊ 無情にて　非情なる　冒とく者め！/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_44_0": "＊ キサマが　水を飲むときは^1　\n　 その最後の一滴に　永遠に\n　 じらされつづけるがいい！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_48_0": "＊ われらが姫と　歩む者よ！\n　 キミの　なんと恵まれたことか！/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_49_0": "＊ 汗一滴　かいていない　その脚の\n　 なんと恵まれたことか！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_79_0": "＊ おお^1　はるか高みにおわす　聖姫よ！\n　 ほんの一滴の　水滴を\n　 ワタシに　残したまえ…/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_80_0": "＊ ワタシは　誓おう^1！\n　 それを　決して　こぼしはしないと！/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_81_0": "＊ そこに　味のついた粉を\n　 混ぜたりはしないと！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_85_0": "＊ ただし　当然ながら^1　\n　 甘きレモンとオレンジの\n　 味ならば^1　ぜひとも混ぜよう。/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_86_0": "＊ それらは　舌に清らかで^1　飲めば\n　 血液　粘液　黄胆汁　黒胆汁が\n　 活性化するのだ。/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_91_0": "＊ ワタシも　聞いたぞ^1！\n　 戦いの音を！/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_92_0": "＊ この　ケダモノめ…/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_93_0": "＊ キサマの味つき粉は　緑で^1　\n　 マズいのに　もう一杯　飲んでしまう\n　 健康汁を　生むだろう！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_97_0": "＊ われらが聖なる姫君が\n　 キミの城の一員になるとは…\n　 なんとも　うれしきこと！/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_98_0": "＊ このよろこびを　分かち合うために\n　 ワタシのもっとも偉大なる粉を\n　 入れよう…/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_99_0": "＊ カロリーオフの\n　 イオンサプライだ！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_130_0": "＊ ああ^1　わが脚の　すさまじい震えよ！\n　 これ以上　登ることは　かなわない。/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_131_0": "＊ 若き戦士よ^1　かの御方にお目に\n　 かかったらば^1　ぜひとも伝えて\n　 ほしい。わが偉業を。/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_132_0": "＊ そうすれば　ワタシも\n　 得られるかもしれない^1。\n　 かの御方の　一口サイズの愛を。/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_136_0": "＊ いざゆけ　若き戦士よ^1！\n　 ワタシは　汗だくすぎて^1　\n　 これ以上は　進めぬ…/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_143_0": "＊ ヒレツなケダモノめ…！/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_144_0": "＊ 女に涙を流させるとは^1…\n　 キサマに　水を節約しようという\n　 気概はないのか！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_148_0": "＊ キサマなど　ワタシが　倒してやる^1…\n　 この両足が　汗まみれでなく^1　\n　 これほど小さくもなかったなら！/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_155_0": "＊ かの御方を　見つけたのだな^1！\n　 かの御方は　一口サイズの愛を\n　 余らせてはいなかったか？/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_156_0": "＊ ふむ…^1　かの御方には^1　ワタシにも\n　 キミと同じことが　できたことを\n　 お知りおきいただきたい…/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_157_0": "＊ …上まで　登ることさえ\n　 できていれば。/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_161_0": "＊ …よくぞ　成しとげたものだ。\n　 ほめてやろう。/%",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_205_0": "＊ (水が入った　なんの変哲もない\n　 入れものだ)/",
  "obj_dw_church_holywatercooler_slash_Step_0_gml_206_0": "＊ (…調べただけで　なにかが起きると\n　 身構える理由はない)/%",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_64_0": "＊ 他の者たちは^1　君たちが　この世界に\n　 災いをもたらすと考えている。/",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_65_0": "＊ 「剣を携えし騎士が　この地に\n　 大いなる影を落とす」と\n　 いわれているからだ。/",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_66_0": "＊ それが君たちのことだという確たる\n　 証拠はないが^1　君たちを襲う者たちを\n　 悪く思わないでほしい。/%",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_101_0": "＊ (…！？　こんなところに\n　 宝箱が　隠されている！)/",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_102_0": "＊ (…ツルツルする　ナゾの手ぶくろが\n　 入っていた！)/",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_103_0": "＊ (「登るのがヘタくそになる\n　 手ぶくろ」と　書いてある)/",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_104_0": "＊ (…)/",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_105_0": "＊ (拾わなかった)/%",
  "obj_dw_church_intro_gerson_slash_Step_0_gml_110_0": "＊ (やはり　手ぶくろを拾わなかった)/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_102_0": "\\E0＊ なあ^1。さっきから見えてる\n　 この　文字みてーなの^1　\n　 なんだ？/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_104_0": "\\E0＊ あれは…/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_105_0": "\\E5＊ …予言だよ。/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_122_0": "\\E6＊ なあ　これ^1…\n　 ラルセイが言ってた\n　 予言と　ちがくね？/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_124_0": "\\EQ＊ …うん…/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_125_0": "\\E5＊ …ボクが話したやつは^1…\n　 「あらすじ」みたいな\n　 感じで…/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_130_0": "\\E7＊ この予言^1　なんか\n　 かっけーな^1。ちゃんと\n　 聞いときゃよかったぜ。/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_131_0": "\\E2＊ 聞き逃して損したな。/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_133_0": "\\EQ＊ …うん…/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_161_0": "＊ …ブツ^1…ブツ…/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_162_0": "＊ …おお^1　カップよ^1　若者よ^1…\n　 わが　長大な物語を聞かれよ…/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_163_0": "＊ 「あ」は　アーモンドの「あ」^1…\n　 「い」は　インコの「い」^1…\n　 「う」は…/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_169_0": "＊ ヷ は　ヷイオリンの「ヷ 」…\n　 ブツ^1…ブツ…/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_202_0": "＊ ワタシは　冒険中の身ゆえ^1　\n　 この賢者に　助言を　もらいに\n　 きたのだ。/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_203_0": "＊ この伝説において\n　 ワタシは　正義の勇者となるのだ。/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_208_0": "＊ これで　正義の勇者になれなければ^1　\n　 マジ最悪なのだ。/%",
  "obj_dw_church_intro_guei_slash_Step_0_gml_238_0": "\\E2＊ (ねえ　クリス！　ボクたちは\n　 べつべつに　「こうどう」\n　 することもできるからね！)/",
  "obj_dw_church_intro_guei_slash_Step_0_gml_239_0": "\\EJ＊ (バトル中にまほうメニューで\n　 Ｓアクションか\n　 Ｒアクションを　選んで！)/%",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_15_0": "\nなぞなぞを\n聞かせる",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_16_0": "\nお話を\n聞かせる",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_20_0": "\nなにもしない",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_26_0": "＊ (…)/",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_75_0": "\\EJ＊ エンピツで戦っては\n　 いけません。\n　 なぜでしょうか？/%",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_79_0": "\\EY＊ ラルセイを　ゴミばこに\n　 捨てるより　ひでぇことは\n　 な～んだ？/%",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_83_0": "\\EK＊ フルーツパンチより^1 \n　 オレが好きなパンチは\n　 なーんだ？/%",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_87_0": "\\E2＊ 問題です！/%",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_113_0": "＊ (答えを言う前に　笑われた…)/%",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_129_0": "\\E2＊ むかーしむかし\n　 あるところに\n　 さびしい王国がありました。/",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_130_0": "\\Ed＊ その王国には\n　 ひとりの王子が\n　 住んでいました。/",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_131_0": "\\EJ＊ 王子は\n　 ひとりぼっちでしたが\n　 ある日…/",
  "obj_dw_church_jackenstein_pumpkinNPC_slash_Step_0_gml_176_0": "\\EK＊ …うん。/%",
  "obj_dw_church_knightclimb_slash_Step_0_gml_232_0": "\\E4＊ 闇の泉は\n　 この先の　はずだよ。/",
  "obj_dw_church_knightclimb_slash_Step_0_gml_233_0": "\\EE＊ あとは　ここを登って…/",
  "obj_dw_church_knightclimb_slash_Step_0_gml_234_0": "\\EC＊ …え？/%",
  "obj_dw_church_knightclimb_slash_Step_0_gml_257_0": "\\EJ＊ おい！！/%",
  "obj_dw_church_knightclimb_slash_Step_0_gml_410_0": "\\EC＊ …ナイト…！/",
  "obj_dw_church_knightclimb_slash_Step_0_gml_412_0": "\\EJ＊ クソッ！　今度は\n　 じゃまさせねーからな！/%",
  "obj_dw_church_knightclimb_slash_Step_0_gml_463_0": "\\EC＊ あっ^1！\n　 待って　スージィ！/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_114_0": "\\EC＊ スージィ！　ダメ…/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_127_0": "\\EI＊ なにがだ^1！\n　 また　逃がしちまっても\n　 いいのかよ！？/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_221_0": "\\EI＊ おい^1！　どこ行くんだよ！\n　 ヒキョーだぞ！！/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_375_0": "\\Ec＊ クソッ…^1　また…\n　 逃げられた。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_387_0": "\\EQ＊ …スージィ^1　\n　 やれるだけのことは\n　 やったよ。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_389_0": "\\Ec＊ でも…^1　それでも\n　 足りなかったじゃねえか！/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_390_0": "\\Eb＊ いっつも　そうだ^1…\n　 いっつも　アイツは\n　 一歩先を　行きやがる…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_391_0": "\\EV＊ 見つけても\n 　逃がしてばっかで…/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_427_0": "\\EV＊ これじゃ　トリエルさんも^1…\n　 アンダインも^1…\n　 だれも　守れねぇ。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_441_0": "\\E8＊ …スージィ…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_442_0": "\\Ea＊ 気持ちは　わかるよ。\n　 でも…/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_459_0": "\\E0＊ ボクたちにも\n　 勝ち目はある！/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_460_0": "\\E5＊ いまのところ^1　ナイトが\n　 姿を見せているのは\n　 闇の世界だけだよね。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_461_0": "\\E0＊ 右へ進んで\n　 闇の泉を封印すれば…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_462_0": "\\EQ＊ …少なくとも^1　\n　 時間稼ぎはできるよ。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_463_0": "\\E8＊ …解決には　ならないけど^1…\n　 考える時間はできる。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_465_0": "\\ED＊ …ああ^1。そうだな。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_523_0": "\\E1＊ クリス。行こうぜ…/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_628_0": "\\EV＊ この闇の世界は^1…\n　 さっきと同じ感じだな…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_629_0": "\\EV＊ 最初のヤツな。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_640_0": "\\EA＊ たぶん　最初の闇の世界は…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_641_0": "\\E5＊ この　とびらの向こうにある\n　 泉の一部を　受け継いで\n　 いたんだと思う。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_642_0": "\\EA＊ ２つとも　ナイトの泉…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_643_0": "\\E0＊ だから^1　最初の世界と\n　 似ていても\n　 不思議じゃないよ。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_670_0": "\\ED＊ …似てるだけ^1…か。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_690_0": "\\E1＊ クリス^1　このとびらの先で\n　 ナイトが待ってやがる。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_691_0": "\\ED＊ いまは　ほかのこと\n　 考えてる場合じゃねえ。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_692_0": "\\E1＊ 行くぞ。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_750_0": "\\Ed＊ あ^1…待って。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_752_0": "\\E6＊ へ？/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_754_0": "\\EJ＊ …/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_755_0": "\\E1＊ いつもの^1…ポーズは？/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_757_0": "\\E9＊ ヘッ^1…わーったよ。/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_74_0": "\\E7＊ お^1！　またオレらだぜ！/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_75_0": "\\EL＊ 予備が　あったみてぇだな。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_77_0": "\\EA＊ …こわれても^1　\n　 必ず　どこか別の場所に\n　 また現れるんだ。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_78_0": "\\E4＊ 予言を変えることは^1　\n　 できないからね。/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_213_0": "\\E5＊ あっ…！^1　なんだよ！？/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_312_0": "＊ うぉっと　どっこい^1！\n　 手が　すべったわい。\n　 ガッハッハ…/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_314_0": "\\E5＊ じいさん！^1　また\n　 こわしやがったな…？/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_325_0": "＊ 予言を　じぃーっと\n　 たどっておったら…/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_326_0": "＊ うっかり　ぶつかってしもうた^1！\n　 ガーッハッハ！！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_346_0": "\\E7＊ …お^1！　見ろよ^1！\n　 こっちにも　道があるぜ！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_350_0": "\\EH＊ どけよ　じいさん！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_368_0": "\\EC＊ ス…スージィ^1！\n　 そんなに急いで\n　 進まないで！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_421_0": "\nわざと\nこわした",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_422_0": "\nうっかり\nこわした",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_428_0": "＊ …なんじゃい。ワシに　なにか\n　 言いたいことでもあるのかね？/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_448_0": "\n予言が\n気に入らない",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_449_0": "\nスージィを\n怒らせるため",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_451_0": "＊ ワシがかね？^1　なぜそんなことを\n　 せにゃならんのかね？/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_459_0": "＊ …そう^1　そうだとも^1！\n　 そう言ってもらえて\n　 じつに　光栄じゃ。/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_480_0": "＊ フム。おとぎ話は　美しい。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_481_0": "＊ キラキラと輝くものを\n　 信じるのも　悪くない。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_482_0": "＊ じゃが^1　あの言葉は\n　 少々　まぶしすぎるようじゃ。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_483_0": "＊ 真っ青な道…それしか見えん。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_484_0": "＊ ワシは…行間を読んではどうかと\n　 思うぞよ？/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_485_0": "＊ そこは　もっと暗いはずじゃ…\n　 ワハ…ワッハッハ…！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_490_0": "＊ あの　おじょうちゃんを^1？\n　 あのコは　そう思っておるのかね？/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_491_0": "＊ そう言ってもらえると　光栄じゃ^1。\n　 そう！^1　そうだとも^1！\n　 ワッハッハ！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_666_0": "\\EH＊ クリス^1！\n　 じいさんの　おもりを\n　 オレに　押しつけんな！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_671_0": "＊ (赤いカップたちが\n　 行く手を　ふさいでいる)/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_694_0": "＊ ああ…恐ろしい魔女が^1　\n　 剣の使い魔を使役して\n　 呪いを響かせた…/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_695_0": "＊ 彼女たちは　あまりに楽しすぎて^1…\n　 いや^1　邪悪すぎて\n　 封印されたのだ。/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_700_0": "＊ 彼女たちは　未来永劫　像のまま。\n　 これで　安心だ。/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_706_0": "＊ ああ^1…彼女は目覚めた^1…\n　 なんとも　ゆゆしきこと。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_707_0": "＊ 楽しげ^1…いや　ゆゆしげなことだ。/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_712_0": "＊ 彼女の歌を^1　私は忌まない。/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_713_0": "＊ じつのところ^1　\n　 どこか快いとさえ思う。/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_751_0": "＊ (なんらかの　像だ)/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_761_0": "＊ ディン！^1　ドン^1！\n　 われ　目覚めし！/",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_762_0": "＊ そこに　いるのカネ^1？\n　 わが歌の犠牲に　なりたきモノよ！/%",
  "obj_dw_church_lantern_hallway_slash_Step_0_gml_806_0": "＊ カラン！　コロン！\n　 破滅の鐘の音よ！\n　 そなたも　身を滅ぼしたいのカネ？/%",
  "obj_dw_church_legender_slash_Create_0_gml_37_0": "IT STARTED ONCE UPON A TIME",
  "obj_dw_church_legender_slash_Create_0_gml_37_1": "A LEGEND SPOKE IN SHADOWD RHYME",
  "obj_dw_church_legender_slash_Create_0_gml_38_0": "OF LIGHT AND DARK AND LOVE AND HATE",
  "obj_dw_church_legender_slash_Create_0_gml_38_1": "THE HOPES AND DREAMS THAT GOVERN FATE",
  "obj_dw_church_legender_slash_Create_0_gml_39_0": "THIS WAS THE LEGEND OF <DELTARUNE.>",
  "obj_dw_church_legender_slash_Create_0_gml_41_0": "A WORLD BASKED IN PUREST LIGHT.",
  "obj_dw_church_legender_slash_Create_0_gml_41_1": "BENEATH IT, GREW ETERNAL NIGHT.",
  "obj_dw_church_legender_slash_Create_0_gml_43_0": "THE FOUNTAINS FREED,",
  "obj_dw_church_legender_slash_Create_0_gml_43_1": "THE ROARING CRIES.",
  "obj_dw_church_legender_slash_Create_0_gml_44_0": "THE TITANS SHAPE",
  "obj_dw_church_legender_slash_Create_0_gml_44_1": "FROM DARKENED EYES.",
  "obj_dw_church_legender_slash_Create_0_gml_46_0": "THE LIGHT AND DARK,",
  "obj_dw_church_legender_slash_Create_0_gml_46_1": "BOTH BURNING DIRE.",
  "obj_dw_church_legender_slash_Create_0_gml_47_0": "A COUNTDOWN TO",
  "obj_dw_church_legender_slash_Create_0_gml_47_1": "THE EARTH'S EXPIRE.",
  "obj_dw_church_legender_slash_Create_0_gml_49_0": "BUT LO, ON HOPES AND DREAMS THEY SEND.",
  "obj_dw_church_legender_slash_Create_0_gml_50_0": "THREE HEROES AT THE WORLD'S END.",
  "obj_dw_church_legender_slash_Create_0_gml_52_0": "THE GIRL,",
  "obj_dw_church_legender_slash_Create_0_gml_52_1": "WITH HOPE CROSSED ON HER HEART.",
  "obj_dw_church_legender_slash_Create_0_gml_53_0": "THE PRINCE,",
  "obj_dw_church_legender_slash_Create_0_gml_53_1": "ALONE IN DEEPEST DARK.",
  "obj_dw_church_legender_slash_Create_0_gml_54_0": "THE CAGE,",
  "obj_dw_church_legender_slash_Create_0_gml_54_1": "WITH HUMAN SOUL AND PARTS.",
  "obj_dw_church_legender_slash_Create_0_gml_56_0": "THE POINTY-HEADED ONE WILL SAY",
  "obj_dw_church_legender_slash_Create_0_gml_56_1": "\"TOOTHPASTE\", AND THEN  \"BOY.\"",
  "obj_dw_church_minorlegend_slash_Step_0_gml_46_0": "＊ 「夕方の５時にもなると^1　\n　 アゴにも　青々とした\n　 影が落ちる」…/",
  "obj_dw_church_minorlegend_slash_Step_0_gml_47_0": "＊ …われわれの先祖は　そう伝える。/%",
  "obj_dw_church_minorlegend_slash_Step_0_gml_51_0": "＊ 真実は　ガラスに書かれている。/%",
  "obj_dw_church_moneyfountain_slash_Draw_0_gml_27_0": "水の中",
  "obj_dw_church_moneyfountain_slash_Draw_0_gml_29_0": "手持ち",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_66_0": "＊ (なんらかの　像だ)/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_71_0": "＊ 現在　寄付は受け付けていない。/",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_72_0": "＊ カネを盗れ^1　盗みを働け^1　\n　 ワレらをボコれ！/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_110_0": "\n投げ入れる",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_111_0": "\nやめておく",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_115_0": "＊ (水が　たまっている^1…\n　 おカネを　投げ入れる？)/",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_119_0": "＊ (水の中には　$~1入っている。\n　 もっと　投げ入れる？)/",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_129_0": "＊ (水は　うつろに　きらめいている)/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_144_0": "＊ (いくら　投げ入れる？)",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_151_0": "＊ (おカネを　持っていない)/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_230_0": "ダークドル",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_231_0": "ダークドル",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_232_0": "＊ (~1~2を　投げ入れた。\n　 水の中には　$~3入っている)/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_243_0": "＊ (…？　投げ入れた　おカネが\n　 滝の水を　まっぷたつに 裂いた！)/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_277_0": "＊ 水の中に　お札を入れるとは^1　\n　 キミは　変わり者だ^1。\n　 小銭の持ち合わせが　なかったのか？/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_282_0": "＊ …小銭^1…持っていないか？/%",
  "obj_dw_church_moneyfountain_slash_Step_0_gml_309_0": "＊ \\cA反対側へ渡ったとき^1　\n　 ここでの　寄付の額\\cWが\n　 ものを言う。/%",
  "obj_dw_church_organ_slash_Step_0_gml_415_0": "\\E2＊ っしゃ　クリス^1　\n　 コイツが　あれば\n　 ラクショーだぜ。/%",
  "obj_dw_church_organ_slash_Step_0_gml_428_0": "＊ (楽譜が　「だいじなもの」に\n　 加わった)/%",
  "obj_dw_church_organ_slash_Step_0_gml_454_0": "\\E0＊ …んー。どの音を\n　 弾いたらいいのか\n　 わかんねーよな？/",
  "obj_dw_church_organ_slash_Step_0_gml_455_0": "\\E1＊ どっか　このへんに\n　 答えが　あるんじゃね？/%",
  "obj_dw_church_organ_slash_Step_0_gml_532_0": "\\E0＊ …/",
  "obj_dw_church_organ_slash_Step_0_gml_534_0": "\\EQ＊ えっと…クリス^1？\n　 ボクが　やってみようか^1？\n　 ボクなら　たぶん…/",
  "obj_dw_church_organ_slash_Step_0_gml_536_0": "\\E1＊ ラルセイ。待てよ。/%",
  "obj_dw_church_organ_slash_Step_0_gml_562_0": "\\E0＊ なあ　クリス…^1　さっき\n　 教会で…^1　おまえが\n　 寝てたときさ…/",
  "obj_dw_church_organ_slash_Step_0_gml_563_0": "\\ED＊ …おまえのママが\n　 言ってたんだ^1。クリスは\n　 ピアノが　うまかったって。/",
  "obj_dw_church_organ_slash_Step_0_gml_564_0": "\\ED＊ なんで　いまは\n　 ひけねーフリしてんの？/",
  "obj_dw_church_organ_slash_Step_0_gml_565_0": "\\ES＊ ひょっとして^1…\n　 恥ずかしいとか\n　 思ってんのか？/",
  "obj_dw_church_organ_slash_Step_0_gml_566_0": "\\ED＊ でもさ…/%",
  "obj_dw_church_organ_slash_Step_0_gml_591_0": "\\ED＊ …/",
  "obj_dw_church_organ_slash_Step_0_gml_592_0": "\\E2＊ 弾けよ^1。\n　 弾いたらいいと\n　 オレは思うぜ。/%",
  "obj_dw_church_organ_slash_Step_0_gml_634_0": "＊ (スージィの言葉を胸に^1　\n　 深く息を吸った)/%",
  "obj_dw_church_organ_slash_Step_0_gml_644_0": "＊ (両手が　勝手に　動き出す…)/%",
  "obj_dw_church_organ_slash_Step_0_gml_790_0": "\\E6＊ おい^1　なんで　やめんだよ？\n　 聴いてたのに。/",
  "obj_dw_church_organ_slash_Step_0_gml_791_0": "\\EN＊ …クリス^1。\n　 ピアノ^1　もっと弾けよ。/%",
  "obj_dw_church_organ_slash_Step_0_gml_811_0": "\\EM＊ ガチで^1。弾かねーとか\n　 バカだろ。/",
  "obj_dw_church_organ_slash_Step_0_gml_813_0": "\\E2＊ (クリス…\n　 スージィは　やさしいね)/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_12_0": "\\E2＊ わあ^1…\n　 ステキなメロディ！\n　 子守歌みたいだね…！/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_16_0": "\\EH＊ わあ…^1　なんだか\n　 親切で　やさしそうな\n　 曲だね！/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_20_0": "\\EK＊ その曲は^1…ちょっと…/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_22_0": "\\EL＊ ウザい？/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_24_0": "\\EL＊ …！　そういうわけじゃ…！/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_26_0": "\\E2＊ でも^1　そう思っただろ？/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_30_0": "\\EH＊ ルールノーさんの曲だね！/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_32_0": "\\E2＊ あいつが\n　 ボコられるときの曲な。/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_36_0": "\\ED＊ あ…！/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_38_0": "\\E2＊ クリス^1　ラルセイに\n　 ラブソングでも歌うのか？/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_42_0": "\\EV＊ …/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_44_0": "\\E0＊ …スージィ？/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_46_0": "\\EQ＊ なんでもねえ^1…\n　 ちょっと^1…いい曲だなって\n　 思っただけだ。/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_50_0": "\\EN＊ その曲^1…　なんか　いいな。/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_51_0": "\\EA＊ オレも^1　ギターで\n　 弾けるようになるかな。/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_55_0": "\\E9＊ イェー！^1　サイコーだぜ！/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_57_0": "\\E2＊ あの　おじいさんに\n　 聞かせてあげたいね！/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_61_0": "\\E2＊ 心に　しみるね…/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_63_0": "\\E7＊ おまえのママに\n　 聞かせてあげろよ。/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_64_0": "\\EK＊ トリエルさん…\n　 しばらく　おまえのピアノ\n　 聞いてねえだろ？/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_70_0": "\\EH＊ おい！　遊ぶなよ！/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_74_0": "\\EK＊ んだよ　その曲？\n　 ダセぇな。/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_78_0": "\\EB＊ どっかで聞いた気がすんな…/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_80_0": "\\EU＊ …？/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_82_0": "\\E7＊ あ^1！　さっきラルセイが\n　 鼻歌で　うたってた\n　 ヤツだ。/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_84_0": "\\ED＊ え…そうだった？\n　 …ゴメン！/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_104_0": "\\EK＊ なんで　ぜんぜんちがう感じに\n　 弾くんだよ？/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_105_0": "\\ED＊ …キンチョーしてんのか？/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_107_0": "\\EQ＊ ボ…ボクは…\n　 どっちのアレンジも\n　 ステキだと思うよ！/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_109_0": "\\EK＊ (…マジかよ？)/%",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_113_0": "\\E2＊ すごい！　全部弾けたね！/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_115_0": "\\E0＊ いやー…なんか^1…\n　 ちょっとヘンじゃ\n　 なかったか？/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_116_0": "\\E6＊ キーとか変えるの\n　 使わないとダメとかじゃ\n　 ねえの？/",
  "obj_dw_church_organpuzzle_slash_Step_0_gml_118_0": "\\EJ＊ えっと^1…使わなくても\n　 ステキだったよ！/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_90_0": "\n持っていこう",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_91_0": "\nやめよう",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_109_0": "\\E7＊ なあ^1　このソファも\n　 ラルセイの部屋に\n　 持ってこうぜ。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_110_0": "\\EN＊ …したらアイツ^1　床で\n　 寝なくてもよくなるだろ。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_121_0": "\\E3＊ オレらの枕も\n　 ラルセイに　やるか…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_122_0": "\\EL＊ あの部屋で\n　 寝ることなんて\n　 ほとんどねーしさ…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_123_0": "\\E7＊ オレのベッドについてる\n　 トゲトゲも\n　 ラルセイに　やろうぜ！/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_141_0": "\\EK＊ あいつが　床で寝てても\n　 いいのかよ？/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_142_0": "\\E6＊ …てか^1　ラルセイって\n　 フツーに寝るのか？/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_164_0": "\\E9＊ っしゃあ^1！\n　 手　貸してくれ！/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_179_0": "\\EB＊ …/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_180_0": "\\EK＊ 重すぎだな^1。\n　 全部は　ムリだ…/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_189_0": "\\E2＊ うし^1。これで\n　 クッションの城が\n　 作れる。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_190_0": "\\EL＊ そのほうが　フツーの\n　 ベッドより　ボーギョりょく\n　 高くていいぜ。/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_224_0": "\\E2＊ オレは　パズルとか\n　 やらねーぜ。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_225_0": "\\EN＊ …どーせ^1…あんまり\n　 役に立てねーし。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_226_0": "\\ED＊ ピアノで　じまんできることも\n　 ねーし。/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_231_0": "\\E2＊ んだよ^1？\n　 おまえも　座りたかったなら\n　 先に取っとくんだったな。/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_238_0": "\\E0＊ なあクリス^1。また　こんな\n　 パズルが　あったらさ…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_239_0": "\\EL＊ 今度からは　半分ずつ\n　 やろうぜ。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_240_0": "\\E2＊ それか^1　オレが下に\n　 もぐって　ペダルを\n　 イジるとかな。/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_245_0": "\\E0＊ ノエルのソファは\n　 どうしてっかな。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_246_0": "\\EA＊ …ノエルも。/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_287_0": "\\EK＊ おケツを突っ込まないように\n　 ここに　座っておくね。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_289_0": "\\E2＊ ケツに　接着剤\n　 つけなくていいのか？/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_291_0": "\\EX＊ そんなことしなくても\n　 おとなしく座って\n　 いられるよ。/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_313_0": "\nお願い",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_314_0": "\nいらん",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_315_0": "ケツ突っ込んでくるな",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_319_0": "\\E0＊ クリス！^1　このパズルは\n　 少し　むずかしそうだね…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_320_0": "\\EQ＊ 手際よく解けるように\n　 アドバイスをしてほしい？/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_330_0": "\n聞く",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_331_0": "\nいまは\nいい",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_335_0": "\\E2＊ アハハ！　スージィが\n　 いいこと教えてくれたよ！/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_343_0": "オレもな？？",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_347_0": "\\EK＊ クリスのこと\n　 「ニワカ」って言って\n　 ゴメンね！\\f1/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_361_0": "うぉい！！",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_365_0": "\\E1＊ クリスのこと\n　 「ニワカ」って\n　 言うといいよ　って。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_366_0": "\\E2＊ それって…\n　 いちばん大好きなひとって\n　 イミなんだって！/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_367_0": "\\EJ＊ てことは　スージィと\n　 クリスは　両方とも\n　 ニワカだね！/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_369_0": "\\E5＊ おい！^1！　ちがう^1。\n　 ニワカは　おまえと\n　 クリスだけだ。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_371_0": "\\ED＊ スージィ^1…\n　 それって　つまり^1…\n　 ボクと　クリスは…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_373_0": "\\EM＊ は！？^1　ちげーわ^1！\n　 いや…だから…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_374_0": "\\E5＊ ニワカってのは^1　なんにも\n　 知らねぇ　ドシロウト\n　 みてーなイミだよ！/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_376_0": "\\Ed＊ え。/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_377_0": "\\EH＊ じゃあ^1　ニワカは\n　 スージィだけってこと？\n　 \\f1/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_395_0": "\\E2＊ 知ってると思うけど…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_396_0": "\\EJ＊ 方向キーと~1で\n　 ピアノを弾けるよ！/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_397_0": "\\E2＊ でも^1　このピアノでは…/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_398_0": "\\EJ＊ ~1を押して　色も\n　 変えられるんだ^1！\n　 ヒントになったかな？/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_399_0": "\\EQ＊ …一刻も早く^1…\n　 闇の泉のところに\n　 たどりつけると…いいよね。/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_406_0": "\\E2＊ アハハ！^1　えっと^1…\n　 どういたしまして…？/",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_407_0": "\\ED＊ …じゃなくて^1…\n　 どうもいたしません^1？\n　 とにかく…がんばってね！/%",
  "obj_dw_church_pianopiece_right_slash_Step_0_gml_414_0": "\\EK＊ あ…^1　うん！/%",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_143_0": "\\EQ＊ うーん…\n　 なにか　特定の曲を\n　 弾かないとダメなのかも？/",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_144_0": "\\EQ＊ きっと　どこかに\n　 ヒントが…/",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_146_0": "\\EK＊ …え^1。これってパズルなのか^1？\n　 …テキトーに　ジャムってる\n　 だけかと思ったぜ…/%",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_152_0": "\\E7＊ とりあえず　全部の鍵盤を\n　 ガンガンたたいてみたら\n　 どーだ？/",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_153_0": "\\EA＊ そしたら　たぶん\n　 うまくいくぜ？/%",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_160_0": "\\E6＊ …曲が　とちゅうみたいだね。/",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_161_0": "\\E2＊ 別のヒントを\n　 見つけないと\n　 いけないのかも…？/",
  "obj_dw_church_pianopuzzle_slash_Step_0_gml_163_0": "\\E2＊ てか^1　もっとイケてる曲\n　 弾けってことじゃねーの？/%",
  "obj_dw_church_remote_piano_slash_Draw_0_gml_26_0": "？？？",
  "obj_dw_church_remote_piano_slash_Draw_0_gml_27_0": "ピッチ",
  "obj_dw_church_remote_piano_slash_Draw_0_gml_28_0": "~1長押し : やめる",
  "obj_dw_church_rightconnect_slash_Step_0_gml_16_0": "＊ ああ^1！　若さにあふれ\n　 こぼれんばかりの　戦士たちよ。君も\n　 カップテンの隊列に加わりたいのか？/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_17_0": "＊ ともに　重なって　紅の塔となり^1　\n　 われらが姫君を　お救いしよう。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_18_0": "＊ いざ　登らん！　教会のひさしを\n　 目指して！/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_23_0": "＊ どうした？　登れない？/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_24_0": "＊ それは　われら一同も同じ。\n　 少しの勇気があれば\n　 成し遂げられよう。/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_48_0": "＊ この上に　ピアノ状のオルガンが待ち^1　\n　 弾いた者には　道が開けるという。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_49_0": "＊ 残念ながら　ワタシは　握力がなく^1　\n　 そのような場所へは　赴けない。\n　 キミは　どうだろうか？/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_54_0": "＊ 握力もなく^1　飲むこともできない…\n　 ワタシのような男には^1　\n　 わざわいが　降り注ぐだろう。/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_78_0": "＊ われらが姫君たち^1…すなわち\n　 水の妖精たちは　高みにて\n　 われらを待っている。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_79_0": "＊ 登れ！^1　登れ^1！\n　 それが　われらの務め！/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_80_0": "＊ …そう^1。低い場所にも　１人いる…/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_81_0": "＊ だが^1　善きカップは知る。\n　 姫君の価値は^1　居場所の高さで\n　 決まることを。/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_86_0": "＊ 地面に足のついた姫君で\n　 手を洗う価値など　ありはしない。/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_110_0": "＊ 一生けんめい　登ったけれども^1　\n　 ここに姫は　いらっしゃらなかった。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_111_0": "＊ あるいは…この柱こそが\n　 姫なのだろうか…/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_116_0": "＊ そうとも^1　姫は　とても恥ずかしがり\n　 なのだ^1。あるいは　眠っているのだ^1。\n　 ワタシはただ^1　待つとしよう。/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_140_0": "＊ ここは　王も王子もなき王国だ。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_141_0": "＊ 無意味な信仰に　しがみつく^1　\n　 奇妙な使徒たち。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_142_0": "＊ 忘れ去られた学問の研究を\n　 続けるうちに^1　年老いた学者たち。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_143_0": "＊ 妖精たち^1　姫君たち^1　兵隊たち…/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_144_0": "＊ 国のはずれでは^1　怠惰で恐ろしい\n　 けだものが　恐怖を振りまく…/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_145_0": "＊ …そしてもちろん…闇の騎士も！/%",
  "obj_dw_church_rightconnect_slash_Step_0_gml_150_0": "＊ この地で　名を上げるのは\n　 絶望的だ。ここは　呪われた地だ。/",
  "obj_dw_church_rightconnect_slash_Step_0_gml_151_0": "＊ ワタシを　キミの城に迎えたいと\n　 いうのなら^1　あふれるよろこびを\n　 滴らせて　出向かせてもらおう。/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_18_0": "＊ 入ることはできない。\n　 混雑しすぎている。外に出る\n　 だけでも　列に並ぶ。/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_19_0": "＊ ワレは　入るために　並んでいる。/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_20_0": "＊ …したがって\n　 入ることも　出ることもできない。/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_25_0": "＊ まだ　列に並んでいる。\n　 じつに　心が弾む。/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_26_0": "＊ 列に並んでいるのが\n　 ワレだけだとしても。/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_69_0": "\nカベを\nハグする",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_70_0": "\nしない",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_75_0": "＊ (カベだ。硬そうだ)/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_98_0": "＊ (カベを　ハグした…)\\f0\\f1 /%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_105_0": "＊ (硬すぎる)/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_130_0": "＊ リ　ラ　ッ　ク　ス　…/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_171_0": "＊ (TPが　回復した！)/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_172_0": "＊ (…バトル中じゃないので\n　 意味がなかった)/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_192_0": "＊ (ライトのスイッチのようだ)/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_193_0": "＊ (…動かない！)/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_194_0": "＊ (ライトというより^1…\n　 ヘビーなスイッチだ)/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_199_0": "＊ (ヘビーなライトのスイッチだ)/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_205_0": "＊ (ライトのスイッチのようだ)/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_206_0": "＊ (…？^1　スイッチ板の上で^1　\n　 赤いカップが　こちらに向かって\n　 手を振っている)/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_207_0": "＊ (…これが\n　 「スイッチ板　限定コンテンツ」\n　 というものだろう)/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_212_0": "＊ (カップは　スイッチ板の上で\n　 ２か　10か　たずねている。\n　 「２？　Ten？　どう？」 )/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_252_0": "＊ ワシに　かまわず\n　 サッサカ行っとくれ！/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_255_0": "＊ ワシは　あとから　ついてくぞい！/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_272_0": "＊ 進みがトロいのう！　大丈夫かね？/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_299_0": "\n問題\nナシ",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_300_0": "\nもうちょい\n急いで",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_304_0": "＊ なんか用かね？/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_321_0": "＊ おやすいご用じゃ！/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_395_0": "\\EK＊ おい　じいさん^1。\n　 オレらで　アンタのおもり\n　 すんのは　いいけどよ…/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_396_0": "\\EH＊ …もーちょい速く\n　 歩けねえ！？/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_405_0": "＊ 歩けるとも！/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_463_0": "\\E0＊ …ダメだな。/",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_464_0": "\\E1＊ じいさんの世話は\n　 おまえらで　やれ^1。\n　 オレは　先に行く。/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_610_0": "\\EQ＊ えっと…ボクもスージィに\n　 ついていかないと…/%",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_746_0": "＊ …やれやれ^1。\n　 ワシも追いつかんとな。/%",
  "obj_dw_church_rippleworship_slash_Step_0_gml_61_0": "＊ 上のはずだ^1…　上とは　北だ。/%",
  "obj_dw_church_rippleworship_slash_Step_0_gml_115_0": "＊ (ささやき声が　聞こえる…)/%",
  "obj_dw_church_rippleworship_slash_Step_0_gml_120_0": "＊ (崇拝の表情で固まっている…)/%",
  "obj_dw_church_ripseq1_slash_Step_0_gml_131_0": "\\E8＊ …真っ暗だね…/",
  "obj_dw_church_ripseq1_slash_Step_0_gml_133_0": "\\EK＊ …闇の世界だからな。/",
  "obj_dw_church_ripseq1_slash_Step_0_gml_135_0": "\\E8＊ そうだけど^1…\n　 それにしても…/%",
  "obj_dw_church_ripseq1_slash_Step_0_gml_141_0": "\\EF＊ ？/",
  "obj_dw_church_ripseq1_slash_Step_0_gml_142_0": "\\EG＊ いま^1　なんか\n　 聞こえなかったか？/%",
  "obj_dw_church_ripseq1_slash_Step_0_gml_147_0": "\\EY＊ クリス！^1　左に走って^1！\n　 早く！！/%",
  "obj_dw_church_secretpiano_slash_Step_0_gml_128_0": "\\E6＊ …いま　なんか\n　 聞こえなかったか？/",
  "obj_dw_church_secretpiano_slash_Step_0_gml_130_0": "\\EK＊ 暖炉が開くみたいな\n　 音がしたよね。/",
  "obj_dw_church_secretpiano_slash_Step_0_gml_132_0": "\\EK＊ いや　ドンピシャすぎだろ^1…\n　 でもまあ^1…そうだな。/%",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_134_0": "\\E9＊ がはははは^1！\n　 たしかに　そんなことも\n　 あったな！/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_135_0": "\\E2＊ 予言って　こんなに\n　 当たるもんなんだな。/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_137_0": "\\E0＊ うん…/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_138_0": "\\EQ＊ 予言に　記されて\n　 いることは^1…\n　 必ず　現実になるんだよ。/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_140_0": "\\E6＊ へー。てことは\n　 未来のこと全部\n　 わかってるってことか？/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_141_0": "\\E7＊ それ　すごくね？/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_143_0": "\\EQ＊ うん^1…\n　 すごいことなんだよ！/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_145_0": "\\E7＊ オレが　すげーかっけーこと\n　 するって　書いてあったりも\n　 すんのか？/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_147_0": "\\EQ＊ えっと…/%",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_211_0": "\\EZ＊！？/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_212_0": "\\EP＊ おい　見たか？\n　 だれか　いんぞ…/",
  "obj_dw_church_shadowgerson_slash_Step_0_gml_213_0": "\\E1＊ クリス…^1　気ィ抜くなよ…？/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_359_0": "＊ 安らかに眠る　われらが姫君の\n　 目を覚まさせる　おつもりか…！？/",
  "obj_dw_church_sideclimb_slash_Step_0_gml_360_0": "＊ これより先に進むのであれば^1…\n　 いたしかたあるまい…//",
  "obj_dw_church_sideclimb_slash_Step_0_gml_361_0": "＊ …姫君の栄誉にかけて\n　 われらと決闘だ！/",
  "obj_dw_church_sideclimb_slash_Step_0_gml_362_0": "＊ 覚悟せよ！/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_437_0": "＊ 姫君を　お守りせよ…！！/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_564_0": "＊ ワタクシのスイ眠を　さまたげるとは\n　 なにごとです！？/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_585_0": "＊ いや^1…その^1…　われらは…/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_596_0": "＊ ワタクシを起こさぬように\n　 申しつけたはずですが^1？\n　 これで５度目ですわよ！？/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_624_0": "＊ …まったく^1。\n　 ここは　ウンザリです…/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_705_0": "＊ だれよりも速く登りたければ^1　\n　 だれよりも遠く跳べるまで\n　 力をためてから　跳ぶことだ！/",
  "obj_dw_church_sideclimb_slash_Step_0_gml_706_0": "＊ しかし　ワタシは^1…すぐにぶつかって\n　 しまう！　ぶつかってはいけない！\n　 姫君のために！/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_711_0": "＊ 上で^1　なにやら　音がした^1…\n　 姫君の身に\n　 なにか　あったのだろうか？/",
  "obj_dw_church_sideclimb_slash_Step_0_gml_712_0": "＊ 急ぎ登らねば^1…\n　 力をためて^1　そののち　跳ばねば…/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_746_0": "＊ 見事な速登り^1！\n　 キミのファーストラップの\n　 最速タイムは　~1秒だ！/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_779_0": "＊ 見事な速登り^1！\n　 キミのセカンドラップの\n　 最速タイムは　~1秒だ！/%",
  "obj_dw_church_sideclimb_slash_Step_0_gml_829_0": "＊ (特別なトロフィーだ。\n　 \\cY実績\\cWを積んだ気分になった)/",
  "obj_dw_church_sideclimb_slash_Step_0_gml_830_0": "＊ (…)/",
  "obj_dw_church_sideclimb_slash_Step_0_gml_831_0": "＊ (…が　実際には　なんの\\cY実績\\cWにも\n　 ならなかった)/%",
  "obj_dw_church_staircase_slash_Step_0_gml_28_0": "\\EQ＊ 着いたみたいだね^1…\n　 闇の泉。/",
  "obj_dw_church_staircase_slash_Step_0_gml_30_0": "\\E0＊ …だな。/",
  "obj_dw_church_staircase_slash_Step_0_gml_32_0": "\\EJ＊ …よかった。/",
  "obj_dw_church_staircase_slash_Step_0_gml_33_0": "\\E2＊ それじゃ^1　ボクは\n　 キャッスルタウンで\n　 待ってるね。/",
  "obj_dw_church_staircase_slash_Step_0_gml_35_0": "\\E0＊ おう…/%",
  "obj_dw_church_staircase_slash_Step_0_gml_69_0": "\\E9＊ また　ティーパーティでも\n　 しようぜ！/",
  "obj_dw_church_staircase_slash_Step_0_gml_71_0": "\\EH＊ あはは！^1　うん！/%",
  "obj_dw_church_stairspreview_slash_Step_0_gml_26_0": "＊ ライトナーたちの　レーハイが\n　 ワタシなしで　行われたタメシは\n　 アリマセン！　コケッケッケ！/",
  "obj_dw_church_stairspreview_slash_Step_0_gml_27_0": "＊ ワタシこそが　ナニヨリ大事な\n　 ソンザイなのでショウ！\n　 コケッケッケ！/%",
  "obj_dw_church_stairspreview_slash_Step_0_gml_78_0": "＊ その男は　消火器だ。/%",
  "obj_dw_church_stairspreview_slash_Step_0_gml_81_0": "＊ 消火器が大事ではないと\n　 言いたいわけではないが。/%",
  "obj_dw_church_steelstaff_slash_Step_0_gml_7_0": "＊ (音符を鳴らせば\n　 オープンするかもしれない)/%",
  "obj_dw_church_susiesnote_slash_Step_0_gml_17_0": "＊ (少し読みづらいけれど^1　\n　 こんなふうに見える…)/",
  "obj_dw_church_susiesnote_slash_Step_0_gml_18_0": "",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_39_0": "＊ 嗚呼^1！　その昔　はるか高みに\n　 すばらしいフォルテピアノがあり^1 \n　 黄金の音色を響かせたものだ…/",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_40_0": "＊ ところが　大扉が開き^1　\n　 いにしえの魔女の\n　 不協和音を放った。/",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_41_0": "＊ 美しい音色は　排除され…\n　 不快な音のみが　残った。/",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_50_0": "＊ しかし^1　戦士たちよ^1！　キミたちは\n　 \\cYピアノのナゾ\\cWを\n　 解き明かしたと聞く！/",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_51_0": "＊ ピアノは姿を消しても^1　\n　 その歌は　われらの心に\n　 生きつづけるのだ…/%",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_59_0": "＊ 嗚呼^1！　\\cYピアノのナゾ\\cWは\n　 解き明かされず！/",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_60_0": "＊ …\\cR今後　解き明かされる\n　 望みもない\\cW。/%",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_65_0": "＊ 嗚呼^1　ピアノの歌は\n　 いまも　われらの心に鳴り響く。/",
  "obj_dw_church_tallbookcases_slash_Step_0_gml_66_0": "＊ ダラッダダ^1　タタンタタ^1　\n　 ディリディリダー^1…\n　 といった感じに。/%",
  "obj_dw_church_turtles_slash_Step_0_gml_60_0": "\\EK＊ あの　おじいさんから\n　 離れないほうが\n　 よさそうだね。/%",
  "obj_dw_church_warpflame_slash_Step_0_gml_22_0": "\nはい",
  "obj_dw_church_warpflame_slash_Step_0_gml_23_0": "\nやめる",
  "obj_dw_church_warpflame_slash_Step_0_gml_32_0": "＊ (桃色の炎^1…\n　 ためらいがちに光を放っている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_33_0": "\nはじめに\nもどる",
  "obj_dw_church_warpflame_slash_Step_0_gml_41_0": "＊ (赤い炎…\n　 ためらいがちに　光を放っている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_42_0": "\nセーブ\nポイントに\nもどる",
  "obj_dw_church_warpflame_slash_Step_0_gml_48_0": "＊ (桃色の炎…\n　 急ぐように　光を放っている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_49_0": "\nセーブ\nポイントに\nもどる",
  "obj_dw_church_warpflame_slash_Step_0_gml_55_0": "＊ (赤い炎…　決着の光を放っている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_56_0": "\n闇の泉へ",
  "obj_dw_church_warpflame_slash_Step_0_gml_61_0": "＊ (緑の炎^1…\n　 知識の光を放っている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_62_0": "老人の\n書斎へ\n移動する",
  "obj_dw_church_warpflame_slash_Step_0_gml_67_0": "＊ (緑の炎…　期待の光を放っている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_68_0": "\n大扉へ",
  "obj_dw_church_warpflame_slash_Step_0_gml_76_0": "＊ (青い炎…\n　 決着の　ついていないバトルの\n　 幻で　揺らめいている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_77_0": "\n暗闇へもどる",
  "obj_dw_church_warpflame_slash_Step_0_gml_81_0": "＊ (青い炎…\n　 決着の　ついていないバトルの\n　 幻で　揺らめいている)/",
  "obj_dw_church_warpflame_slash_Step_0_gml_82_0": "\n影へ\nもどる",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_81_0": "\n登る",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_82_0": "\n登らない",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_87_0": "＊ (鐘でできた　カベだ。登る？)/",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_88_0": "\\C2",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_101_0": "＊ (ツルツルすべって登れない^1。\n　 かべを　よじ登る道具さえあれば…)/%",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_108_0": "＊ (鐘のカベを　登った…)/%",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_217_0": "\\E7＊ うし^1！\n　 ここが　この部屋の^1　\n　 いちばん　はじっこだな！/",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_218_0": "\\EG＊ …ん？/%",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_258_0": "\\EZ＊ …来る^1…　なにか来る…/",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_259_0": "\\EY＊ 逃げて！！/%",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_293_0": "＊ ちょ～いと　待った！/%",
  "obj_dw_church_waterfallroom_slash_Step_0_gml_418_0": "＊ (なにか　長くて糸っぽいものが\n　 行く手を　ふさいでいる)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_81_0": "＊ なんで　逃げとるんじゃね？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_83_0": "\\EK＊ なんか^1…　なんかが\n　 いた？　あった？　から…/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_124_0": "＊ ワシは　これから\n　 茶でも飲もうと\n　 思っとったところじゃ。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_125_0": "＊ おまえさんたちも\n　 いっしょに　どうかね？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_127_0": "\\E7＊ お！^1　いいね！/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_215_0": "\\EK＊ まあ^1…\n　 一杯ぐらい　いんじゃね？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_253_0": "\\EC＊ そうしてぇけど^1　\n　 やることあるからな。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_264_0": "＊ ガッハッハ^1　それならワシも\n　 お茶は抜きじゃ！/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_306_0": "＊ ガッテン承知じゃ！　ガッハッハ…/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_327_0": "\\EK＊ 茶だったら　もう\n　 昼間に飲んだぜ。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_335_0": "＊ それは　アフタヌーンティーといって\n　 のんびりくつろぎながら飲む\n　 茶じゃ。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_336_0": "＊ これは　ミッドナイトティー^1…\n　 心に火をつける　茶じゃよ…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_337_0": "＊ 机の前で^1　長い夜の冒険を\n　 戦い抜くためのな。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_338_0": "＊ それなりの覚悟を持って\n　 飲まなきゃならん。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_340_0": "\\Ed＊ そのミッドナイトティーには^1…\n　 なにが入ってるんですか？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_366_0": "＊ たっぷりのカモミールと^1…\n　 あとは　なんじゃったかな…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_367_0": "＊ おお　そうじゃ。お湯じゃ。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_368_0": "＊ ガーッハッハッハッハ！！/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_370_0": "\\EK＊ (たぶん…飲んでも　おなかは\n　 こわさなそうだね…)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_480_0": "＊ おまえさんたち　３人は\n　 どえらい旅を　してきたようじゃな？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_482_0": "\\E2＊ ま^1　そんな感じだな。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_508_0": "＊ どんな冒険じゃった^1？\n　 ワシにも　聞かせてくれんかの？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_510_0": "\\ED＊ あー…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_511_0": "\\E3＊ (ラルセイ^1　このじいさんに\n　 話してやってもいいか…？)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_513_0": "\\EQ＊ (うん^1。問題ないと思うよ)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_515_0": "\\E9＊ しゃ！　いいぜ^1！\n　 よーく聞けよ？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_553_0": "＊ (スージィは\n　 これまでの冒険について\n　 生き生きと語った…)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_567_0": "\\E7＊ …で^1　この世界に\n　 来たってワケだ^1。\n　 ヤベーだろ！？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_578_0": "＊ ガーッハッハッハッハ^1！\n　 いかにも　ヤバい^1！\n　 すばらしい物語じゃった。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_580_0": "\\EK＊ フォークと　スプーンと\n　 角砂糖で…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_581_0": "\\E2＊ バトルを再現したところが\n　 最高だったよ　スージィ。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_583_0": "\\E2＊ だって^1　そうしねーと\n　 オレらのヤバさが\n　 伝わらねーだろ？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_662_0": "\\E9＊ …茶^1　うまかったぜ\n　 じいさん。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_684_0": "\\EA＊ そろそろ　勇者の仕事に\n　 もどらねぇとな。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_693_0": "＊ あとで　また\n　 ワシの書斎に\n　 来てくれるかね？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_695_0": "\\E9＊ ああ^1。てか　通り道だし^1　\n　 言われなくても行くよ。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_745_0": "＊ …/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_746_0": "＊ 瞳を輝かせながら語られる物語に\n　 勝るものはない。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_747_0": "＊ あの　おじょうちゃんは^1　なにも\n　 怖がっていない^1。疑いや皮肉が\n　 混じると^1　物語は毒を帯びてしまう。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_748_0": "＊ それに…^1　先が読めてしまうのも\n　 じつに　よろしくない。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_770_0": "＊ そこの　おぼっちゃんは^1　\n　 次に　なにが起きると思うかね？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_772_0": "\\EC＊ …えっ？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_773_0": "\\EQ＊ そ…それは^1…\n　 そのときに\n　 なってみないと…/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_794_0": "＊ フムフム。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_860_0": "＊ さあ^1　飲んどくれ。冷めないうちに。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_862_0": "\\EQ＊ …ありがとうございます。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_891_0": "＊ おまえさんは^1　\n　 茶に　口をつけていないのう。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_892_0": "＊ …どれ^1　目を閉じてごらん。/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_917_0": "＊ …おまえさんは^1　ただひたすらに　\n　 もくもくと　物事をこなしとるな？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_918_0": "＊ おまえさんには^1　なにか大変なことが\n　 起きておる。ワシには　わかる。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_919_0": "＊ それでも^1　日々を生きねばならん^1。\n　 話をしたり^1　戦ったり^1　\n　 宿題を　やったりせねばならん…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_920_0": "＊ 無意味に思えるじゃろうな^1。\n　 地球が　まだ回っていることに^1　\n　 腹が立つじゃろう。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_921_0": "＊ …じゃが^1　あきらめてはいかん^1。\n　 ただ　もくもくと　こなさなけりゃ\n　 ならずとも…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_922_0": "＊ なにかしら　意味のあることを\n　 見つけるようとしてみるのじゃ^1。\n　 わかるかね？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_947_0": "＊ (お茶を一口すすった…^1　すごく甘い)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_948_0": "＊ (ゆっくりと飲んだ^1…\n　 体に　ぬくもりが　広がっていく…)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_949_0": "＊ (やがて　カップの底には^1　\n　 冷めたシロップの　甘ったるい\n　 膜だけが残った)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_956_0": "＊ 茶の　いいところ^1…それは\n　 決して　裏切らんところじゃな^1…\n　 ガッハッハ…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_957_0": "＊ そうじゃろう　ぼっちゃん？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_964_0": "＊ はい…^1　そのとおりです。/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_965_0": "＊ クリス^1　お茶を飲みたくなったら^1　\n　 ボクが　いつでも　いれてあげるよ。\n　 お砂糖たっぷりでね…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_966_0": "＊ ううん^1…\n　 クリスが　頼まなくても\n　 いれてあげる…！/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_967_0": "＊ それに…/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_984_0": "＊ …お茶は　飲みたくないかね^1。\n　 それなら…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_985_0": "＊ (キュキュッ…)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_986_0": "＊ リンゴは　どうかね？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_994_0": "＊ (前に　なにかが\n　 置かれる音がした…)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_995_0": "＊ (…)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_996_0": "＊ (…)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1003_0": "＊ …クリス^1？\n　 えっと^1…じゃあ^1…\n　 ボクが　手伝ってあげるね！/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1004_0": "＊ はい^1。こうやって\n　 口の前で持っててあげるから…/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1011_0": "＊ (前歯が　ガブリと\n　 前方に　かみついて\n　 リンゴを　かじった)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1012_0": "＊ (甘い味が　口いっぱいに広がる…)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1019_0": "＊ そうそう^1！\n　 その調子で　かじって…/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1028_0": "＊ (リンゴの　表面に\n　 口が　触れるたびに\n　 歯が　かじりとって…)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1043_0": "＊ (…やがて　芯だけになった)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1068_0": "＊ わ^1…待って^1！\n　 そんなに急いで　食べないで…！/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1083_0": "＊ クリス　それは　食べちゃ…%%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1093_0": "＊ (小さくて固い　なにかを\n　 かみしめた…^1　ガリッ！)/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1094_0": "＊ (…苦い味が　口の中に広がった)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1101_0": "＊ …クリス^1　芯は食べちゃダメだよ…\n　 ハハハ…/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1103_0": "＊ (…ハンカチで　顔をふかれる\n　 感触がした)/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1110_0": "＊ …クリス…？/",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1111_0": "＊ …もう　目を開けても^1　いいんだよ？/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1153_0": "\\EL＊ あれ^1？\n　 おじいさん^1　帰っちゃった？\n　 いつのまに…/%",
  "obj_dw_church_waterfalltearoom_slash_Step_0_gml_1184_0": "\\EQ＊ えっと^1…\n　 じゃあ^1　ボクたちも\n　 行こうか？/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_33_0": "＊ 静かに！/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_34_0": "＊ これは　われわれの\n　 聖なる先祖の像だ。/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_35_0": "＊ もしも出会うことが\n　 できたなら…/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_36_0": "＊ 心安らぐ　すばらしい説法を\n　 聞かせてもらえただろうに。/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_41_0": "＊ われらの聖なる　ご先祖さま！/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_47_0": "＊ 像は　威厳に満ちている。/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_55_0": "＊ われらの　偉大なるご先祖さまは\n　 どこへ行った！？/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_56_0": "＊ この　たわ言ばかり　わめく\n　 しれ者が　なにか　したに\n　 ちがいない…！/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_61_0": "＊ ああ^1　なんという悲劇…\n　 われらの　偉大なるご先祖さまの像が\n　 消えてしまった！/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_62_0": "＊ 不敬な罪を犯した者は^1　\n　 相応の罰を受けるべきだ！/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_68_0": "＊ 立ち去れ！/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_89_0": "＊ (なんらかの像だ)/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_96_0": "＊ なにを　している？/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_97_0": "＊ ワレは　ワレらの先祖の像を\n　 守っている！/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_98_0": "＊ もしも　先祖に出会うことが\n　 できたなら…/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_99_0": "＊ きっと　彼らは\n　 すばらしかっただろう…/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_100_0": "＊ …すぐに暴力を振るおうとする\n　 乱暴者たちとは　ちがって。/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_105_0": "＊ ここに集う乱暴者たちも^1　\n　 先祖孝行の　大切さを\n　 学ぶべきだ！/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_113_0": "＊ 言葉を話す　考古学的遺物^1！\n　 …おとなしい石のほうが\n　 崇拝しやすかった。/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_114_0": "＊ とはいえ^1　ワレワレの祖先が\n　 ワレを　ブッ飛ばしたいのなら^1　\n　 ただ　そうさせるのみ。/%",
  "obj_dw_church_worshiproom_slash_Step_0_gml_118_0": "＊ 彼らは　ドングリが　なにか\n　 知っているという^1。\n　 それは　ゆゆしきことだ。/",
  "obj_dw_church_worshiproom_slash_Step_0_gml_119_0": "＊ 知っていては^1　それは　なにか\n　 たずねることができない！/%",
  "obj_dw_gerson_study_slash_Step_0_gml_25_0": "＊ なっ…　緑の炎から　現れた…！？/",
  "obj_dw_gerson_study_slash_Step_0_gml_26_0": "＊ …だが^1　もどったほうが\n　 身のためかもしれない。/",
  "obj_dw_gerson_study_slash_Step_0_gml_27_0": "＊ この書斎は^1　うら寂しい\n　 あばら屋になってしまった。/%",
  "obj_dw_gerson_study_slash_Step_0_gml_32_0": "＊ 戦士たちよ！　勇気をふりしぼり\n　 緑の炎を使って\n　 もと来た場所へ　もどれ。/%",
  "obj_dw_gerson_study_slash_Step_0_gml_151_0": "＊ 「炎の奥に宿る斧は」…/",
  "obj_dw_gerson_study_slash_Step_0_gml_152_0": "＊ 「黄金の調べに目覚める」…/",
  "obj_dw_gerson_study_slash_Step_0_gml_153_0": "＊ 「五線の譜に口づけされし\n　 ３つの旋律は」…/",
  "obj_dw_gerson_study_slash_Step_0_gml_154_0": "＊ 「暗き淵にて　囁かれる」/%",
  "obj_dw_gerson_study_slash_Step_0_gml_170_0": "\\E0＊ …/",
  "obj_dw_gerson_study_slash_Step_0_gml_171_0": "\\E1＊ あー…/",
  "obj_dw_gerson_study_slash_Step_0_gml_172_0": "\\EA＊ …ようするに\n　 \\cYヤベぇ　アックス\\cWが\n　 あるってことだな。/%",
  "obj_dw_gerson_study_slash_Step_0_gml_201_0": "\\EC＊ …だろ^1　ラルセイ？/%",
  "obj_dw_gerson_study_slash_Step_0_gml_210_0": "\\EQ＊ …え？　ゴメン^1…\n　 おじいさんに聞いたら^1　\n　 知ってるんじゃないかな？/%",
  "obj_dw_gerson_study_slash_Step_0_gml_226_0": "\\E2＊ ヘッ　だれが。\n　 オレら　だけで\n　 さがそうぜ。/%",
  "obj_dw_gerson_study_slash_Step_0_gml_235_0": "\\EA＊ …まあ^1　聞いてみても\n　 いいけどよ。/%",
  "obj_dw_gerson_study_slash_Step_0_gml_305_0": "＊ 上の真ん中のとびらが\n　 開いたようじゃ。/",
  "obj_dw_gerson_study_slash_Step_0_gml_306_0": "＊ そこに入れば\n　 行くべき場所に着くじゃろう。/",
  "obj_dw_gerson_study_slash_Step_0_gml_307_0": "＊ …その「ナイト」とやら^1…\n　 おまえさんたちは^1　いったい\n　 何者だと思う…？/",
  "obj_dw_gerson_study_slash_Step_0_gml_309_0": "\\ED＊ …正直^1　よくわかんねぇよ…/",
  "obj_dw_gerson_study_slash_Step_0_gml_310_0": "\\E0＊ 昨日の夜^1　\n　 光の世界で\n　 姿を見たんだ。/",
  "obj_dw_gerson_study_slash_Step_0_gml_311_0": "\\E1＊ 暗くて　あんまり\n　 見えなかったけど^1　\n　 たぶんライトナーだと思う。/",
  "obj_dw_gerson_study_slash_Step_0_gml_312_0": "\\E0＊ でも^1　だれなのかは\n　 さっぱり　わからねえ。/",
  "obj_dw_gerson_study_slash_Step_0_gml_313_0": "\\ED＊ あんな　ヒデぇことするヤツ^1　\n　 思いつかねぇよ。/",
  "obj_dw_gerson_study_slash_Step_0_gml_314_0": "\\Ee＊ 闇の泉を作って^1…\n　 ひとを　さらって…/",
  "obj_dw_gerson_study_slash_Step_0_gml_316_0": "＊ どうして　そんなことを\n　 していると思う？/",
  "obj_dw_gerson_study_slash_Step_0_gml_318_0": "\\E6＊ …あ？^1　しるかよ。\n　 たぶん…/",
  "obj_dw_gerson_study_slash_Step_0_gml_319_0": "\\ED＊ …全部　ブッこわしてぇと\n　 思ってるから^1　とか？/",
  "obj_dw_gerson_study_slash_Step_0_gml_320_0": "\\E2＊ ま^1　その前に　オレらが\n　 アイツをブッ倒すけどな！/",
  "obj_dw_gerson_study_slash_Step_0_gml_322_0": "＊ ガッハッハ！^1　うむ　うむ^1。\n　 がんばることじゃ！/%",
  "obj_dw_gerson_study_slash_Step_0_gml_376_0": "＊ 手紙を書いとるんじゃよ！/",
  "obj_dw_gerson_study_slash_Step_0_gml_377_0": "＊ おじょうちゃん。書き上がった部分を\n　 読んで^1　おかしなところがないか\n　 確認してくれるかね？/",
  "obj_dw_gerson_study_slash_Step_0_gml_379_0": "\\EK＊ …チッ^1　わーったよ。/",
  "obj_dw_gerson_study_slash_Step_0_gml_380_0": "\\EH＊ …ハイケイ？^1　イミ\n　 わかんねぇけど^1…それしか\n　 書いてねーじゃねぇか！/",
  "obj_dw_gerson_study_slash_Step_0_gml_382_0": "＊ ホッホ^1！\n　 そうじゃった　そうじゃった^1！\n　 では　続きを書くとしよう！/%",
  "obj_dw_gerson_study_slash_Step_0_gml_413_0": "＊ どデカい仲間が増えたぞい^1！\n　 そんでもって　ワシは…/",
  "obj_dw_gerson_study_slash_Step_0_gml_414_0": "＊ まだ　手紙を書いとる途中じゃ^1…\n　 少～しずつな！/",
  "obj_dw_gerson_study_slash_Step_0_gml_416_0": "\\E6＊ その^1　はじっこのほうに\n　 描いてある絵は\n　 なんだよ…？/",
  "obj_dw_gerson_study_slash_Step_0_gml_418_0": "＊ ああ　これかね^1。\n　 おまえさんたち３人の\n　 似顔絵じゃよ！/",
  "obj_dw_gerson_study_slash_Step_0_gml_420_0": "\\E7＊ いやいや^1！\n　 じいさん　まちがえてるぜ！/",
  "obj_dw_gerson_study_slash_Step_0_gml_422_0": "＊ ほう^1？　どれ^1　おまえさんが\n　 描いてみるといい…/%",
  "obj_dw_gerson_study_slash_Step_0_gml_467_0": "\\E9＊ ほら^1。クリスには\n　 「スージィ　サイキョー」\n　 って　言わせねぇと。/",
  "obj_dw_gerson_study_slash_Step_0_gml_469_0": "＊ ガッハッハ^1！\n　 こりゃ　典型的な　まちがいを\n　 してしまったわい！/%",
  "obj_dw_gerson_study_slash_Step_0_gml_477_0": "\\E9＊ じいさんの絵を\n　 忘れてる。/",
  "obj_dw_gerson_study_slash_Step_0_gml_479_0": "＊ おや^1　ワシの　こうらが　ないぞい？/",
  "obj_dw_gerson_study_slash_Step_0_gml_481_0": "\\EA＊ こうらは　もっと\n　 強くなってからだ。/%",
  "obj_dw_gerson_study_slash_Step_0_gml_488_0": "＊ ちょうど　手紙を\n　 仕上げとるところじゃよ…/",
  "obj_dw_gerson_study_slash_Step_0_gml_490_0": "\\E6＊ は？　書き終わったって\n　 言ってなかったか？/",
  "obj_dw_gerson_study_slash_Step_0_gml_492_0": "＊ 物書きに　書き終わりはない！/",
  "obj_dw_gerson_study_slash_Step_0_gml_494_0": "\\EA＊ んだよそれ^1　うぜぇ～。/",
  "obj_dw_gerson_study_slash_Step_0_gml_496_0": "＊ ウム！　いかにも^1！　ガーッハッハ！/%",
  "obj_fusionmenu_slash_Step_0_gml_142_0_b": "ラニーノ＆エルニーナ",
  "obj_fusionmenu_slash_Step_0_gml_143_0": "-------------",
  "obj_fusionmenu_slash_Step_0_gml_144_0_b": "-------------",
  "obj_fusionmenu_slash_Step_0_gml_145_0_b": "-------------",
  "obj_fusionmenu_slash_Step_0_gml_146_0_c": "-------------",
  "obj_fusionmenu_slash_Step_0_gml_148_0": "お天気コンビは　いつでもいっしょ！\nお天気を予想して　バトルに勝て！",
  "obj_fusionmenu_slash_Step_0_gml_149_0": " ",
  "obj_fusionmenu_slash_Step_0_gml_150_0_b": " ",
  "obj_fusionmenu_slash_Step_0_gml_151_0_b": " ",
  "obj_fusionmenu_slash_Step_0_gml_152_0_b": " ",
  "obj_fusionmenu_slash_Step_0_gml_155_0": "VIPビュッフェ",
  "obj_fusionmenu_slash_Step_0_gml_156_0": "---",
  "obj_fusionmenu_slash_Step_0_gml_157_0": "---",
  "obj_fusionmenu_slash_Step_0_gml_158_0": "---",
  "obj_fusionmenu_slash_Step_0_gml_159_0": "---",
  "obj_gerson_fountain_slash_Draw_0_gml_390_0": "不要な　アイテム",
  "obj_gerson_fountain_slash_Draw_0_gml_391_0": "不要な　ぶき",
  "obj_gerson_fountain_slash_Draw_0_gml_392_0": "不要な　ぼうぐ",
  "obj_gerson_fountain_slash_Draw_0_gml_393_0": "やめる",
  "obj_gerson_fountain_slash_Draw_0_gml_398_0": "投げ入れる\nものを\n選んで\nください。",
  "obj_gerson_fountain_slash_Draw_0_gml_399_0": "ものを\n投げ入れた。",
  "obj_gerson_fountain_slash_Draw_0_gml_400_0": "投げ入れる\nものがない。",
  "obj_gerson_fountain_slash_Draw_0_gml_505_0": "引き換え？",
  "obj_gerson_fountain_slash_Other_11_gml_4_0": "＊ (水が入っている)",
  "obj_gerson_fountain_slash_Other_11_gml_7_0": "投げ入れる",
  "obj_gerson_fountain_slash_Other_11_gml_8_0": "終わる",
  "obj_gerson_item_steal_anim_slash_Step_0_gml_71_0": "おっと！\nワシは アイテムを使わんぞ？\nここは 公平にいこう！/%",
  "obj_gerson_rudebuster_slash_Draw_0_gml_57_0": "PRESS",
  "obj_gerson_rudebuster_slash_Draw_0_gml_60_0": "PRESS Z",
  "obj_gerson_table_slash_Create_0_gml_30_0": "どれか\n選ぶ？",
  "obj_gerson_table_slash_Create_0_gml_31_0": "えっと…\nはい おつり！",
  "obj_gerson_table_slash_Create_0_gml_32_0": "ごめん\nクリス！\nおカネが…",
  "obj_gerson_table_slash_Create_0_gml_33_0": "持てないね…\n上の階で\nなにか\n売ろう！",
  "obj_gerson_table_slash_Create_0_gml_34_0": "そうこに\n送ったよ！",
  "obj_gerson_table_slash_Create_0_gml_40_0": "なにを\n買うんじゃ？",
  "obj_gerson_table_slash_Create_0_gml_41_0": "まいど\nあり！\nワッハッ\nハッ！",
  "obj_gerson_table_slash_Create_0_gml_42_0": "カネが\n足りん\nよう\nじゃな",
  "obj_gerson_table_slash_Create_0_gml_43_0": "もちものが\nいっぱい\nのよう\nじゃな！",
  "obj_gerson_table_slash_Create_0_gml_44_0": "そうこに\nおくった\nぞい！",
  "obj_gerson_table_slash_Draw_0_gml_418_0": "いらないアイテムを入れる",
  "obj_gerson_table_slash_Draw_0_gml_419_0": "いらない　ぶきを入れる",
  "obj_gerson_table_slash_Draw_0_gml_420_0": "いらない　ぼうぐを入れる",
  "obj_gerson_table_slash_Draw_0_gml_421_0": "やめる",
  "obj_gerson_table_slash_Draw_0_gml_426_0": "投げ入れる\nものを\n選んで\nください。",
  "obj_gerson_table_slash_Draw_0_gml_427_0": "ものを\n売った。",
  "obj_gerson_table_slash_Draw_0_gml_428_0": "投げ入れる\nものがない。",
  "obj_gerson_table_slash_Draw_0_gml_516_0": "アイテムが\nおカネに\nなった！",
  "obj_gerson_table_slash_Draw_0_gml_533_0": "引き換え",
  "obj_gerson_table_slash_Other_11_gml_7_0": "Buy",
  "obj_gerson_table_slash_Other_11_gml_8_0": "Exit",
  "obj_guei_enemy_slash_Step_0_gml_3_0": "＊ グウェイは　\\cBくたびれ\\c0ている。\n　 ラルセイのまほう「\\cBスリープ\\c0」が\n　 効くかもしれない…",
  "obj_guei_enemy_slash_Step_0_gml_4_0": "＊ グウェイは　\\cBくたびれ\\c0ている。\n　 \\cYぼうぎょ\\c0で\\cYTP\\c0をかせいで　ラルセイの\n　 まほう「\\cBスリープ\\c0」を使え！",
  "obj_guei_enemy_slash_Step_0_gml_127_0": "＊ グウェイは　鳥のように　頭を傾けた。",
  "obj_guei_enemy_slash_Step_0_gml_128_0": "＊ グウェイは　ツメを\n　 カチャカチャ鳴らした。",
  "obj_guei_enemy_slash_Step_0_gml_129_0": "＊ グウェイは　シッポを振った。",
  "obj_guei_enemy_slash_Step_0_gml_130_0": "＊ グウェイは　うらめしそうに\n　 遠吠えをした。",
  "obj_guei_enemy_slash_Step_0_gml_131_0": "＊ ティーンズのニオイがする。\n＊ スピリットのニオイがする。",
  "obj_guei_enemy_slash_Step_0_gml_137_0": "＊ グウェイの炎が　弱々しく揺らめいた。",
  "obj_guei_enemy_slash_Step_0_gml_142_0": "＊ グウェイは　独特な様子で　満足した。",
  "obj_guei_enemy_slash_Step_0_gml_189_0": "＊ グウェイ - 月がロウロウと輝く夜に\n　 現れるとされる　奇妙な精霊。/%",
  "obj_guei_enemy_slash_Step_0_gml_196_0": "＊ エクサシズムを始めた！\n＊ グウェイにエクササイズをすすめた！/%",
  "obj_guei_enemy_slash_Step_0_gml_206_0": "＊ みんなで　グウェイに\n　 エクササイズをすすめた！/%",
  "obj_guei_enemy_slash_Step_0_gml_251_0": "調子は どうじゃね？/%",
  "obj_guei_enemy_slash_Step_0_gml_273_0": "＊ 老人を　呼んだ！\n　 なにも起こらなかった！/%",
  "obj_guei_enemy_slash_Step_0_gml_314_0": "フム… バトルというわりに\nちっとも戦っとらんのう/%",
  "obj_guei_enemy_slash_Step_0_gml_332_0": "じいさん どいてろ！\nコイツら 強えーから！/%",
  "obj_guei_enemy_slash_Step_0_gml_347_0": "ほっほ… 了解じゃ…/%",
  "obj_guei_enemy_slash_Step_0_gml_387_0": "おっと！\n杖を落として\nしまったわい/%",
  "obj_guei_enemy_slash_Step_0_gml_406_0": "おまえさんたち\n拾ってくれんかね？/%",
  "obj_guei_enemy_slash_Step_0_gml_451_0": "敵を傷つけずに\n逃がして\nあげるんです！/%",
  "obj_guei_enemy_slash_Step_0_gml_466_0": "逃がす？\nこんなふうにかね？/%",
  "obj_guei_enemy_slash_Step_0_gml_530_0": "え…\n仲間にしちゃった！？/%",
  "obj_guei_enemy_slash_Step_0_gml_544_0": "ハハッ\nやってみる\nもんじゃな！/%",
  "obj_guei_enemy_slash_Step_0_gml_560_0": "それじゃ 続きは\n若いもんらに\nまかせるとしよう！/%",
  "obj_guei_enemy_slash_Step_0_gml_603_0": "＊ (しかし　バトルは　もう\n　 終わっていた)/%",
  "obj_guei_enemy_slash_Step_0_gml_611_0": "＊ (じいさんは　438ダークドルを\n　 てにいれた)/%",
  "obj_guei_enemy_slash_Step_0_gml_626_0": "＊ スージィは　生けるしかばねの\n　 話をした！/%",
  "obj_guei_enemy_slash_Step_0_gml_627_0": "＊ スージィは　怪談話をした！/%",
  "obj_guei_enemy_slash_Step_0_gml_638_0": "＊ ラルセイは　ひとりぼっちの\n　 気のいいオバケがでてくる\n　 ファミリー向けの怪談話をした。/%",
  "obj_guei_enemy_slash_Step_0_gml_639_0": "＊ ラルセイは　聖典を引用した！/%",
  "obj_guei_enemy_slash_Step_0_gml_677_0": "＊ クソッ！\n　 じいさんの杖のせいで\n　 当たっちまった！",
  "obj_halo_enemy_slash_Step_0_gml_6_0": "アリが10！　　　アリが10！　　　アリが10！　　　",
  "obj_halo_enemy_slash_Step_0_gml_7_0": "アリ？聞こえてる？　　　アリ？聞こえてる？　　　",
  "obj_halo_enemy_slash_Step_0_gml_8_0": "本日　カイテン　　　　　本日　カイテン　　　　　",
  "obj_halo_enemy_slash_Step_0_gml_9_0": "目を開けて　　　目を開けて　　　目を開けて　　　",
  "obj_halo_enemy_slash_Step_0_gml_13_0": "センカイ　言ってみて？　センカイ　言ってみて？　",
  "obj_halo_enemy_slash_Step_0_gml_14_0": "回ることは\n信ずること",
  "obj_halo_enemy_slash_Step_0_gml_114_0": "＊ ウィングレードは\n　 スッピンで　スピンした。",
  "obj_halo_enemy_slash_Step_0_gml_115_0": "＊ ウィングレードは　疑いの目を向けた。",
  "obj_halo_enemy_slash_Step_0_gml_116_0": "＊ ウィングレードは\n　 刃で花の絵を描いた。",
  "obj_halo_enemy_slash_Step_0_gml_117_0": "＊ ウィングレードは　 激しく回転した。",
  "obj_halo_enemy_slash_Step_0_gml_118_0": "＊ 古い羽根まくらのニオイがする。",
  "obj_halo_enemy_slash_Step_0_gml_123_0": "＊ ウィングレードは　抜け羽根が激しい。",
  "obj_halo_enemy_slash_Step_0_gml_128_0": "＊ ウィングレードは\n　 人なつっこそうに　はばたいた。",
  "obj_halo_enemy_slash_Step_0_gml_133_0": "＊ ウィングレードの目が\n　 パタパタと閉じた。",
  "obj_halo_enemy_slash_Step_0_gml_155_0": "＊ ウィングレード -\n　 急進的な剣。柄は羽根製。/%",
  "obj_halo_enemy_slash_Step_0_gml_168_0": "＊ 自信まんまんに　スピンした！/%",
  "obj_halo_enemy_slash_Step_0_gml_183_0": "＊ うつろな目で　スピンした！/%",
  "obj_halo_enemy_slash_Step_0_gml_209_0": "＊ スージィといっしょに\n　 自信まんまんに　スピンした！/%",
  "obj_halo_enemy_slash_Step_0_gml_214_0": "＊ スージィといっしょに\n　 うつろな目で　スピンした！/%",
  "obj_halo_enemy_slash_Step_0_gml_228_0": "＊ みんな　自信まんまんに　スピンした！\n＊ たつまきだ…！/%",
  "obj_halo_enemy_slash_Step_0_gml_249_0": "＊ スージィは　コマのようにグラついた！/%",
  "obj_halo_enemy_slash_Step_0_gml_263_0": "＊ ラルセイは　ジャイロのように\n　 回転した！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_145_0": "じいさん\nちょっとは\n動けるみてぇだな/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_146_0": "でも オレは勇者だぜ？\nだれにも\n止められねーんだ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_147_0": "いかにも いかにも\n物語は そういう筋書きじゃな/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_148_0": "じゃが どんでん返しが\nなけりゃあ\nつまらんじゃろう？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_150_0": "…！？\nなんか…ヘンだぞ…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_151_0": "逃げてばかりじゃ\nなにも学べんぞい！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_152_0": "根性 見せてみい！\nすべてを真正面から\n受け止めてな！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_153_0": "(クリス！\n助けてくれ！)/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_155_0": "根性 見せてみい！\nそのアックスでな！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_157_0": "ブロックするんじゃ！\nわかったかね！？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_158_0": "(クリス！\nたのむぜ！)/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_160_0": "緑のあいだは\n逃げられんぞい/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_161_0": "危険を真正面から\n受け止めんと\n弾幕に やられて\nしまうぞよ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_163_0": "おまえさんは\n例の 古い物語を\n聞いたことが\nあるかね？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_164_0": "そう 予言に基づく\n物語…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_165_0": "「ロード・オブ・ザ・\nハンマー」じゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_166_0": "名前だけなら\n聞いたことあるぜ\nどんな話だよ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_168_0": "第１章は\n「闇の王の進軍」じゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_169_0": "勇者たちが\n王を倒し\n竜を止める/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_171_0": "第２章は\n「輝きの街」/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_172_0": "勇者たちは\n馬車で戦い\n女王を救う/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_174_0": "第３章は \n「ノースライトの島々」/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_175_0": "勇者たちは島々を旅し\n失われた地の姿を\nちらと目にする/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_177_0": "第４章は\n「聖なる槌の試練」じゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_178_0": "偉大なる匠が\nおそるべき力を秘めた\n武器を勇者たちに授ける/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_180_0": "第５章は\n「鴇色と黄金色の畑」/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_181_0": "広大な庭園が\n嫉妬の炎に\n焼き払われる/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_183_0": "…さて　そのあとは？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_184_0": "ガッハッハ！\nだれにも　わからん/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_185_0": "そのあとに\n続くのは…\nたった１章/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_186_0": "じゃが そこで\n止まってしまったんじゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_188_0": "次の章が\n書かれることは\nなかった/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_189_0": "物語は あまりに\n大きくなりすぎた/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_190_0": "書き手が 物語に\n飲まれてしまったと\n言う者もおるな/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_194_0": "続きを書ける者たち…\n若者たちの前には\nいつでもペンがあった/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_195_0": "そのペンで いつでも\n次のページを書き足せた/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_196_0": "…じゃが　彼らは\nそうはせんかった/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_198_0": "おまえさんは…\nおまえさんの目の中には\n輝く物語が見える…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_199_0": "明るく… 黒く…\n燃え上がり\nすべてを焼き尽くす/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_201_0": "鐘が鳴っておるな\nどうやら最終ラウンドじゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_202_0": "さて…\nどんなふうに\n終わると思うかね？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_203_0": "いや おまえさんは\nどんなふうに\n終わらせたいかね？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_205_0": "終わり か…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_206_0": "オレが 決めていいなら…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_207_0": "エンディングなんて\nいらねぇな！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_208_0": "ずっと続くほうが\nいいに 決まってる…だろ？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_210_0": "ガーッハッハ！\nこりゃ傑作じゃ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_211_0": "夜も更けて…\n正義を告げる\n鐘が鳴り響く…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_212_0": "そんななかで\nおまえさんは\n永遠を選ぶとな/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_214_0": "勇者嬢よ\nその気持ちを\nくれぐれも\n大事にすることじゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_215_0": "運命の潮が\n満ちんとする\nいま…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_216_0": "じきに インクの海が\nページたちを\n洗いながすじゃろう/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_218_0": "ひとつだけ\n闇を上書きできる\nものがある/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_219_0": "希望という名で知られる\n白いペンじゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_220_0": "勇者嬢には\nそれがあると…\nワシは思うぞい/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_221_0": "オレ？ ちげーな\nペンを持ってるのは\nクリスだ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_222_0": "オレのブキは\nヘアブラシとかだよ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_223_0": "ガーッハッハッハッハ！\nそりゃあ おもしろい！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_224_0": "ああ\nわかったら だまって\nオレに アックスよこせ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_226_0": "な…？ え…？\nなんだよ いまの！？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_227_0": "すまん すまん！\nおまえさんなら\n撃ち返すじゃろうと\n思ってな！\nガッハッハ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_228_0": "へっ！ そーかよ！\nよーし 見てろ！\nクリス もういっかいだ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_231_0": "フムフム…\nなんだか知らんが\nその調子で\n続けることじゃ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_232_0": "…でないと\nおまえさんは\n負けるぞよ！\nガーッハッハ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_235_0": "フゥ！ 気分ソウカイじゃ！\nおまえさん なかなか\n覚えがいいのう！\nさて ワシの番じゃな…！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_242_0": "おまえさんは\n自分のことを\n勇者と言ったな？\nおもしろいことじゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_244_0": "ワシは「勇者たち」のことは\nよくわからんが…\nこういう者が おることは\n知っておるぞ…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_245_0": "正しいことを\nしようとする者…\nそれを決して\nやめようとせん者じゃ/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_247_0": "そういう者のことを語る\n予言も伝説も ないがの/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_248_0": "ただ ワシは それを\n真実として 知っておる/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_249_0": "さて そろそろ\n散髪を頼めるかな？\nガーッハッハ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_251_0": "さて そろそろ\n散髪を頼めるかな？\nガーッハッハ！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_252_0": "あきらめるつもりじゃ\nなかろうな？/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_253_0": "こうらに力を入れんか！/%",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_313_0": "＊ 相手は　スージィの根性に\n　 感心している！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_314_0": "＊ 相手は　スージィのまほうに\n　 深く感心している！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_315_0": "＊ 相手は　ルードバスターの衝撃から\n　 まだ立ち直っていない！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_316_0": "＊ アイテムは　取り上げられている！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_317_0": "＊ ついに　真剣勝負が　始まった！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_318_0": "＊ 老人の額に　玉の汗が浮いている…",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_319_0": "＊ 相手の動きが　やっと遅く…\n　 いや　速くなった！？",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_320_0": "＊ あたりに　緑の自由が　はじけ飛ぶ。",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_321_0": "＊ 正義の鐘が鳴る…",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_322_0": "＊ 正義の鐘が　鳴っている…\n　 自分のために。",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_323_0": "＊ カエルのため…ではなく\n　 カメのために　鐘は鳴る！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_324_0": "＊ 白い風が　鳴いている！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_325_0": "＊ 鋼と皮のニオイがする。",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_326_0": "＊ こうら　どエラい　バトルだ！",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_327_0": "＊ スージィは　自信たっぷりに\n　 首を回した。",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_328_0": "＊ スージィは　歯ぎしりした。",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_630_0": "…なるほど\nわかったぜ/%",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_662_0": "オレの力を\n見たいなら…/%",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_704_0": "コイツを くらえ！！/%",
  "obj_hammer_of_justice_enemy_slash_Step_0_gml_757_0": "ハッ！\nハズレじゃ",
  "obj_holywatercooler_enemy_slash_Draw_0_gml_104_0": "ミス・ミズル",
  "obj_holywatercooler_enemy_slash_Draw_0_gml_106_0": "ゆずる",
  "obj_holywatercooler_enemy_slash_Draw_0_gml_107_0": "？？？",
  "obj_holywatercooler_enemy_slash_Draw_0_gml_110_0": "する",
  "obj_holywatercooler_enemy_slash_Draw_0_gml_112_0": "アイテム\nスティール\nチャンス",
  "obj_holywatercooler_enemy_slash_Draw_0_gml_115_0": "すりすりする",
  "obj_holywatercooler_enemy_slash_Draw_0_gml_117_0": "？？？",
  "obj_holywatercooler_enemy_slash_Step_0_gml_10_0": "汚らわしい/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_36_0": "…いったい\nなんですの？\nバトル？/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_47_0": "私は 水の入った入れものを\n調べたかっただけですのに…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_63_0": "無理やりバトルに\n引き込むのですか？/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_79_0": "この若い戦士は\nなんと無礼なのでしょう！\n私の愛を求めるならば…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_94_0": "自分こそが姫にふさわしいと\n証してみせることです/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_133_0": "どうしたことでしょう？\nこの房は　もう\n私を中に入れては\nおけないようです/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_137_0": "なんと野蛮な悪党！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_138_0": "どういうことですの？\nそんなふうに\n私を卵のように扱って…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_140_0": "なんということを！\n私の房を壊すとは！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_145_0": "コポリ",
  "obj_holywatercooler_enemy_slash_Step_0_gml_146_0": "コ~1リ",
  "obj_holywatercooler_enemy_slash_Step_0_gml_151_0": "栄光\n栄誉/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_190_0": "力ずくで\n心を射止めようとする者が\n味わうことができるのは…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_191_0": "かみしめた歯と\n後悔の苦い毒だけです/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_193_0": "さては 私を壊して\nやわらかい象牙色と\n黄金色をした\n隠された美しさを\n暴こうとしているので\nしょうね/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_194_0": "無駄です\n愛は卵の殻で\nできていて…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_195_0": "…あなたの愛が\n本物ならば\n中身が なにかは\nもう知っている\nはずですから/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_197_0": "これでは 私の姿が\n他の者たちと\n同じになってしまう…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_198_0": "若き戦士よ\nおまえは なんと\n残酷なのでしょう\n私を おのれのものにする\n挑戦を なしとげるために…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_199_0": "私をこんな ひどい姿に\nおとしめるなんて…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_200_0": "…\nさようなら/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_202_0": "あなたの愛情が\n私の姿に\n変化を起こしたようです…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_203_0": "ああ…割れる！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_295_0": "＊ ウォータークーラーから\n　 圧倒的な存在感が　にじみでる。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_296_0": "＊ ウォータークーラーは　冗長な表現を\n　 いくども何度でも　ただひたすらに\n　 くりかえしながら独り言を言った。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_297_0": "＊ ウォータークーラーは　自分の色と\n　 似ている宝石は　なにかと考えた。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_298_0": "＊ ウォータークーラーは　尊すぎて\n　 ここで使うのはもったいなすぎる息を\n　 止め…　やがてしゃべりつづけた。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_299_0": "＊ ウォータークーラーは\n　 弱き者を慈しみつつ　見下すオーラを\n　 かもしだした。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_300_0": "＊ 掘った水のニオイがする。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_304_0": "＊ 雨音が聞こえる。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_305_0": "＊ 遠くで雷の音がする。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_306_0": "＊ 遠く　遠く　はるかかなたで\n　 波が　くだける。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_307_0": "＊ 大雨のニオイがする。",
  "obj_holywatercooler_enemy_slash_Step_0_gml_334_0": "＊ ホーリーウォータークーラー -\n　 気位の高い　ただの\n　 ウォータークーラーのようだ。/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_339_0": "＊ ミス・ミズル -\n　 ミズルは　愛情を受けて\n　 姿を変えた。/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_359_0": "＊ ホーリーウォータークーラーを\n　 口説いた！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_367_0": "愛の言葉…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_402_0": "＊ 見逃してくれと　頼んだ…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_417_0": "＊ ウォータークーラーの\n　 近くに集まって　おしゃべりした！/",
  "obj_holywatercooler_enemy_slash_Step_0_gml_429_0": "＊ (なにについて　おしゃべりする…？)/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_437_0": "＊ (ウォータークーラーのそばで\n　 わざと聞こえるように\n　 ウォータークーラーの話をした)/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_456_0": "＊ ミス・ミズルに　ゆずった！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_490_0": "＊ スージィは　アイテムを盗んだ！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_538_0": "＊ しかし　盗むものがなかった！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_543_0": "＊ しかし　アイテムが　いっぱいだ！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_548_0": "＊ しかし　しくじった！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_554_0": "＊ ビターティアを盗んだ！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_608_0": "＊ ラルセイは　すりすりした！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_645_0": "＊ ミス・ミズルは　少しくたびれた…！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_646_0": "＊ ミス・ミズルは　くたびれた！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_655_0": "* Everyone sang a LULLABY!/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_699_0": "* MIZZLEs woke up!/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_700_0": "* MIZZLE woke up!/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_760_0": "おまえは\nのぼせあがっている！\n他のウォータークーラーを\nくどいたことが\nあるのですか？/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_761_0": "私のような姫に\n語りかける前に\nその口を ぬぐいなさい/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_762_0": "おまえの口から流れる言葉は\n過去の言動に ぬれそぼり…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_763_0": "光る油のように\nその口から\nしたたり落ちています/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_765_0": "若き戦士よ\nあなたの言葉は蜜のよう\n私のような姫と\n言葉を交わすのは\n初めてですの？/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_768_0": "\n初めて",
  "obj_holywatercooler_enemy_slash_Step_0_gml_769_0": "だれでも\nくどく",
  "obj_holywatercooler_enemy_slash_Step_0_gml_775_0": "若き騎士の初恋…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_776_0": "あなたは\nどんな泉よりも\n清らか/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_777_0": "私は あなたの その 愛情を\n遠くから受け止めて…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_778_0": "フタをひねると開く\n透明の器に\nそっと\nしまいましょう/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_779_0": "私の心臓のコポリという音の他\nなにも聞こえない淋しい夜に…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_780_0": "器を開けて\nもう一度\n聴きましょう…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_781_0": "心やさしい あなたの\nそのささやきを/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_783_0": "私が そんな言葉を\nうのみにすると？/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_784_0": "甘い言葉で ひとを だまし\nおのれに酔いしれる\nおまえの言葉を？/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_785_0": "否！ そのような\n酸味の強い粉は\nじゃぐちから出る男か女に\nくれてやりなさい/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_787_0": "若き騎士よ\nあなたの言葉は\nすでに受け取りました/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_788_0": "フタをひねると開く\n器に注ぎ入れ\nフタを閉めて\nしまってあります/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_789_0": "時が その中身を熟成させたのちの\n今から はるか遠い先の とある季節に\nそのフタは開けられ 古びたブドウの\nささやきとともに 花開くでしょう/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_790_0": "そうやって しゃべりつづければ\n聖なる器は あふれて奔流となり\nすべての意味を失うでしょう/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_793_0": "私の前にひざまずく者は\n幸いです\n私の波が その者を\n清めるのですから/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_794_0": "目を閉じて\n好きなだけ私の\n清らかさを あがめなさい\nあなたに災いの\nふりかかることは\nありません/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_797_0": "＊ (ホーリーウォータークーラーは\n　 見逃してくれた！)/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_814_0": "おまえは　新たな活力でもって\n私に祈りをささげる！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_815_0": "にもかかわらず\nおまえの両手は\n炭酸の不安に震え…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_816_0": "偽りの恐怖が\nおまえの顔を\nしたたり落ちます/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_817_0": "おまえが\nそうやって請うのは\n私の高潔さによる救いを\n求めての行いではなく…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_818_0": "ガラスに映った\nおのれの姿に見る\n醜さへの恐れが\nそうさせるのです/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_819_0": "もう一度だけ\n慈悲を かけましょう\nですが これが最後です/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_822_0": "＊ (ホーリーウォータークーラーは\n　 見逃してくれた！)/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_843_0": "皆が 私の周りに集い\nたあいもない おしゃべりを…\nでも その生ぬるい言葉は…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_844_0": "一度たりとも\n私のデカンタに\n向けられはしなかった…\nその無知なる振る舞いは\n私の心の表面張力を\n傷つけました…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_845_0": "私の気風をほめなさい\nそうすれば\n逃がしてあげましょう/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_849_0": "\nなかま",
  "obj_holywatercooler_enemy_slash_Step_0_gml_850_0": "\n美しさ",
  "obj_holywatercooler_enemy_slash_Step_0_gml_851_0": "サボテンのほうがいい",
  "obj_holywatercooler_enemy_slash_Step_0_gml_852_0": "花",
  "obj_holywatercooler_enemy_slash_Step_0_gml_858_0": "あなたは　私の\nしもべになることを\n望むのですね/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_859_0": "このような姿をしていても\n私が求愛になびくことは\nまず ありません/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_860_0": "ライトナーからの\n敬愛を受けようとも\n私は すでに\n欲しいものを すべて\n手にしているのですから/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_861_0": "それでも 私に\nおのれの熱心さを\n見せるのならば…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_862_0": "おまえも役に立つかもしれません\n私を感心させてみなさい/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_864_0": "あなたは再び私に求愛する\nでも その言葉は\n薄っぺらく漂うだけ…\nあなたの心は\n水たまりのように\n浅はかです/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_865_0": "妖精の財宝は\n渇いてひび割れた舌を持つ\n必滅の者を 迎え入れは\nしないのです！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_867_0": "わたしを\nうぬぼれ屋と\n思わぬことです/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_868_0": "たとえ　私のこの\n月と太陽の両方の輝きをも\n抑える顔が\nすべての星々よりも\nまばゆく清らかであっても…/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_869_0": "私の美しさは\n否定することのできない\n客観的な科学的事実に\nすぎないのですから/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_870_0": "なるほど/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_874_0": "最も青き花\n私の言葉の弟子/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_875_0": "写真機を向けられれば\nすすんで そこに収まる/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_876_0": "それは\n優雅さと\n心やさしさの標本/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_877_0": "あの花に会ったら\nよろしく伝えてください/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_896_0": "＊ スージィは　ガラガラうがいした！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_897_0": "＊ スージィは　ぬれた床を踏みまくった！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_898_0": "＊ スージィは起きたままイビキをかいた！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_938_0": "＊ ラルセイは　おぎょうぎよく飲んだ！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_939_0": "＊ ラルセイは　ぬれた床をよけた！/%",
  "obj_holywatercooler_enemy_slash_Step_0_gml_940_0": "＊ ラルセイは　ハミガキ粉を作った！/%",
  "obj_homealone_basement_convo_slash_Create_0_gml_22_0": "＊ あー…",
  "obj_homealone_basement_convo_slash_Create_0_gml_23_0": "＊ …ふたりっきり^1…だね…",
  "obj_homealone_basement_convo_slash_Create_0_gml_24_0": "＊ (クソッ^1　クリスが　いねーと\n　 なんか　きまずいな…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_25_0": "＊ (…せっかく　ふたりきりに\n　 なれたけど…^1　やっぱり\n　 クリスに　いてほしいかも…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_28_0": "＊ (ためしに…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_29_0": "＊ (やみのせかいの　はなしでも\n　 してみるか…？)",
  "obj_homealone_basement_convo_slash_Create_0_gml_30_0": "＊ (このまえ　みた\n　 ゆめの　はなしって\n　 ことにして…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_31_0": "＊ (いや^1…　ヘンに　おもわれるよな…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_34_0": "＊ (ためしに…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_35_0": "＊ (このまえ　みた\n　 ゆめの　はなしを\n　 してみようかな…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_36_0": "＊ (…って　やっぱりダメ！\n　 ヘンに　おもわれちゃう！)",
  "obj_homealone_basement_convo_slash_Create_0_gml_37_0": "＊ (…でも…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_42_0": "＊ …？^1　ねえ^1…ちかしつから\n　 なにか　きこえない…？",
  "obj_homealone_basement_convo_slash_Create_0_gml_43_0": "＊ …「せつだんされた　て」とかが\n　 たててる　おとだったら\n　 カンベンだな…",
  "obj_homealone_basement_convo_slash_Create_0_gml_48_0": "＊ あはは…　それって\n　 「ブラッド・クラッシャー２」の\n　 ネタでしょ？",
  "obj_homealone_basement_convo_slash_Create_0_gml_49_0": "＊ しってんの？　あの　えいが。",
  "obj_homealone_basement_convo_slash_Create_0_gml_50_0": "＊ しってるよお^1！　めいさくだもん！",
  "obj_homealone_basement_convo_slash_Create_0_gml_51_0": "＊ あるひ^1　しゅじんこうが\n　 めをさますと　かたてが\n　 なくなってて…",
  "obj_homealone_basement_convo_slash_Create_0_gml_52_0": "＊ ちかしつから　おんがくが\n　 きこえてくるんだよな…",
  "obj_homealone_basement_convo_slash_Create_0_gml_53_0": "＊ で^1　ちかしつに　ようすを　みに\n　 いくと^1　せつだんされた　てが\n　 おそってくるんだよな！！",
  "obj_homealone_basement_convo_slash_Create_0_gml_54_0": "＊ そうそう！^1　あのシーン　\n　 めちゃくちゃ　こわかったぁ！",
  "obj_homealone_basement_convo_slash_Create_0_gml_57_0": "＊ てか　オレ^1　「１」みたこと\n　 ねえんだよ^1。「２」しか\n　 みてねぇ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_58_0": "＊ えっ　そうなの？　うちに\n　 ボックスセットあるよ？\n　 いっしょに　みる？",
  "obj_homealone_basement_convo_slash_Create_0_gml_59_0": "＊ マジかよ！^1　みようぜ！",
  "obj_homealone_basement_convo_slash_Create_0_gml_60_0": "＊ いちじき^1　とりつかれたみたいに\n　 ずーっと　みてたなぁ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_61_0": "＊ こんどは　だれかと　いっしょに\n　 みられたら^1…うれしいかも。",
  "obj_homealone_basement_convo_slash_Create_0_gml_62_0": "＊ ヘヘ…",
  "obj_homealone_basement_convo_slash_Create_0_gml_65_0": "＊ …キャッティーは？^1　あいつ\n　 ホラーっぽいの　すきじゃねーの？",
  "obj_homealone_basement_convo_slash_Create_0_gml_66_0": "＊ あー^1…あのコは…\n　 ちょっと　ほんきに\n　 なりすぎるっていうか…",
  "obj_homealone_basement_convo_slash_Create_0_gml_67_0": "＊ でてくる　まほうとか\n　 ぜんぶ　ぶんせきしはじめるから…",
  "obj_homealone_basement_convo_slash_Create_0_gml_68_0": "＊ ハハッ　うぜぇー。",
  "obj_homealone_basement_convo_slash_Create_0_gml_69_0": "＊ そ…そんな^1…うざくなんか…\n　 あ^1…あるかな。",
  "obj_homealone_basement_convo_slash_Create_0_gml_72_0": "＊ あ^1。もうひとつ\n　 ちょっと　こわいけど\n　 おもしろいやつ　おもいだした。",
  "obj_homealone_basement_convo_slash_Create_0_gml_73_0": "＊ ゲームに　むちゅうに　なりすぎて…",
  "obj_homealone_basement_convo_slash_Create_0_gml_74_0": "＊ …ものすごく　おこって\n　 ぶるどっ君の　かおがついた\n　 マウスを　バンバンたたいて…",
  "obj_homealone_basement_convo_slash_Create_0_gml_75_0": "＊ …さいごには　こわしちゃう\n　 おとこのこの　どうがが　あるんだ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_76_0": "＊ …スージィ^1　みたことある？",
  "obj_homealone_basement_convo_slash_Create_0_gml_77_0": "＊ …いや？",
  "obj_homealone_basement_convo_slash_Create_0_gml_78_0": "＊ …そっか。",
  "obj_homealone_basement_convo_slash_Create_0_gml_79_0": "＊ まあ^1　べつに^1　みたことなくても\n　 こまらないと　おもうけど…",
  "obj_homealone_basement_convo_slash_Create_0_gml_80_0": "＊ じゃあ^1　それも　いっしょに\n　 みようぜ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_81_0": "＊ ホント？^1　ほら^1　ケータイに\n　 ほぞんしてあるよ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_82_0": "＊ お^1　いいね。",
  "obj_homealone_basement_convo_slash_Create_0_gml_85_0": "＊ ハハッ　ウケるな。",
  "obj_homealone_basement_convo_slash_Create_0_gml_86_0": "＊ いろんなバージョンがあって\n　 ぜんぶ　プレイリストにして\n　 ほぞんしてるの。",
  "obj_homealone_basement_convo_slash_Create_0_gml_87_0": "＊ へー。",
  "obj_homealone_basement_convo_slash_Create_0_gml_90_0": "＊ (スージィといると^1　\n　 なにも　しゃべらなくても\n　 おちつくな…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_93_0": "＊ (なんつーか…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_94_0": "＊ (なんも　しゃべんなくても^1　\n　 こうやって　チルってるだけで\n　 おちつくな…)",
  "obj_homealone_basement_convo_slash_Create_0_gml_99_0": "＊ なんだ…？^1　でんき　きえたぞ…？",
  "obj_homealone_basement_convo_slash_Create_0_gml_100_0": "＊ ていでんか？",
  "obj_homealone_basement_convo_slash_Create_0_gml_101_0": "＊ もう^1　クリス！",
  "obj_homealone_basement_convo_slash_Create_0_gml_102_0": "＊ また　イタズラしたでしょ！",
  "obj_homealone_basement_convo_slash_Create_0_gml_103_0": "＊ …ブレーカー^1　なおしにいこう？",
  "obj_homealone_basement_convo_slash_Create_0_gml_108_0": "\\EK＊ やべ…^1　モミのきが…",
  "obj_homealone_basement_convo_slash_Create_0_gml_109_0": "\\E9＊ ちらかってて　ゴメン^1…\n　 ことしは　パパが\n　 かたづけられなくて…",
  "obj_homealone_basement_convo_slash_Create_0_gml_110_0": "\\E3＊ ブレーカー^1…\n　 たしか　このあたりに\n　 あったはずだけど…",
  "obj_homealone_basement_convo_slash_Create_0_gml_115_0": "\\E2＊ わたし^1　ちかしつって\n　 ニガテ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_116_0": "\\E8＊ 「ドラゴンブレイダー」の\n　 ちかの　ステージを\n　 おもいだすから。",
  "obj_homealone_basement_convo_slash_Create_0_gml_117_0": "\\E3＊ おんがくが　ずーっと\n　 ループして…",
  "obj_homealone_basement_convo_slash_Create_0_gml_118_0": "\\E3＊ あー　あれな^1。\n　 こえーよな。",
  "obj_homealone_basement_convo_slash_Create_0_gml_119_0": "\\EF＊ やったことあるの？",
  "obj_homealone_basement_convo_slash_Create_0_gml_120_0": "\\EK＊ 「２」だけな。\n　 ガキのころに　やったよ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_121_0": "\\E1＊ わすれものコーナーに\n　 あったのを　ひろってきた。",
  "obj_homealone_basement_convo_slash_Create_0_gml_122_0": "\\E2＊ オレのじゃ　なかったけど。\n　 ヘヘッ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_123_0": "\\EQ＊ あはは^1。もう！",
  "obj_homealone_basement_convo_slash_Create_0_gml_124_0": "\\E4＊ だれにも　バレねぇように\n　 こっそり　あそんだぜ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_125_0": "\\EJ＊ わたしもだよ^1！　「２」は\n　 パパと　いっしょに\n　 あそんだけど…",
  "obj_homealone_basement_convo_slash_Create_0_gml_126_0": "\\E3＊ パパもママも　しらない\n　 「わるものルート」が\n　 あって…",
  "obj_homealone_basement_convo_slash_Create_0_gml_127_0": "\\E8＊ とりあげられないように\n　 いつも　こっそり\n　 あそんでた。",
  "obj_homealone_basement_convo_slash_Create_0_gml_128_0": "\\EK＊ あー^1　オレ^1　うっかり\n　 そのルートで\n　 プレイしたわ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_129_0": "\\ER＊ ふはははは！^1　「わるもの\n　 ルート」を　“うっかり”\n　 プレイしたの？",
  "obj_homealone_basement_convo_slash_Create_0_gml_130_0": "\\E3＊ べつの　やりかたが\n　 あるなんて\n　 しらなかったからさ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_131_0": "\\E0＊ ぜんぶ　ころしまくって^1　\n　 キレまくってた。",
  "obj_homealone_basement_convo_slash_Create_0_gml_132_0": "\\EK＊ 「なんで　みんな\n　 おこってんだよ」ってな。",
  "obj_homealone_basement_convo_slash_Create_0_gml_133_0": "\\E3＊ いま　やったら^1　\n　 べつの　やりかたで\n　 プレイするとおもうけど…",
  "obj_homealone_basement_convo_slash_Create_0_gml_134_0": "\\EB＊ …たぶん？",
  "obj_homealone_basement_convo_slash_Create_0_gml_135_0": "\\EO＊ スージィが\n　 プレイしてるところ\n　 みてみたい。",
  "obj_homealone_basement_convo_slash_Create_0_gml_136_0": "\\E1＊ じゃあ^1　ソフト　もう１つ\n　 てに　はいったら…",
  "obj_homealone_basement_convo_slash_Create_0_gml_137_0": "\\EA＊ 「わすれものコーナー」に\n　 おいといてくれよ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_138_0": "\\EQ＊ ふはは！　そうしようかな！",
  "obj_homealone_basement_convo_slash_Create_0_gml_141_0": "\\EK＊ …てか^1　ブレーカー\n　 どこだよ？",
  "obj_homealone_basement_convo_slash_Create_0_gml_142_0": "\\EL＊ あ。うん。ね。",
  "obj_homealone_basement_convo_slash_Create_0_gml_143_0": "\\EO＊ …さがしてるんだけど…",
  "obj_homealone_basement_convo_slash_Create_0_gml_144_0": "\\EB＊ オレも　さがしてる。",
  "obj_homealone_basement_convo_slash_Create_0_gml_147_0": "\\EA＊ なあ^1。クリスのしわざじゃ\n　 なかったりしてな。",
  "obj_homealone_basement_convo_slash_Create_0_gml_148_0": "\\EB＊ え？",
  "obj_homealone_basement_convo_slash_Create_0_gml_149_0": "\\E2＊ 「せつだんされた　て」が…",
  "obj_homealone_basement_convo_slash_Create_0_gml_150_0": "\\EQ＊ この　ちかしつを\n　 ウロついててさ…",
  "obj_homealone_basement_convo_slash_Create_0_gml_151_0": "\\EL＊ …とつぜん　ノエルの　てを\n　 つかんできたりして…？",
  "obj_homealone_basement_convo_slash_Create_0_gml_152_0": "\\EH＊ ちょ…",
  "obj_homealone_basement_convo_slash_Create_0_gml_153_0": "\\EI＊ そんなことになったら\n　 わたし^1…\n　 たぶん　しんじゃう。",
  "obj_homealone_basement_convo_slash_Create_0_gml_154_0": "\\EC＊ しぬ？",
  "obj_homealone_basement_convo_slash_Create_0_gml_155_0": "\\EH＊ さわられた　しゅんかんに\n　 しんじゃうとおもう。",
  "obj_homealone_basement_convo_slash_Create_0_gml_156_0": "\\EK＊ おそわれても\n　 いねーのに？",
  "obj_homealone_basement_convo_slash_Create_0_gml_157_0": "\\EO＊ そう。ショックで\n　 しんじゃうよ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_158_0": "\\E8＊ そのほうが　ラクそう。",
  "obj_homealone_basement_convo_slash_Create_0_gml_159_0": "\\E0＊ それじゃあ…",
  "obj_homealone_basement_convo_slash_Create_0_gml_160_0": "\\EA＊ オレが　まもって\n　 やらねーとだな。",
  "obj_homealone_basement_convo_slash_Create_0_gml_161_0": "\\EL＊ …どうやって？",
  "obj_homealone_basement_convo_slash_Create_0_gml_162_0": "\\E4＊ ゆびずもうで！",
  "obj_homealone_basement_convo_slash_Create_0_gml_163_0": "\\EQ＊ ふはははは！！",
  "obj_homealone_basement_convo_slash_Create_0_gml_166_0": "\\EK＊ てか^1　マジで\n　 ブレーカー　どこだよ？",
  "obj_homealone_basement_convo_slash_Create_0_gml_167_0": "\\E8＊ ね？\n　 はやく　みつけないと…",
  "obj_homealone_basement_convo_slash_Create_0_gml_168_0": "\\EJ＊ 「せつだんされた　て」に\n　 さわられちゃう！",
  "obj_homealone_basement_convo_slash_Create_0_gml_173_0": "\\EE＊ い…いま　このにんぎょうが\n　 わたしの　あしに\n　 さわった…！",
  "obj_homealone_basement_convo_slash_Create_0_gml_174_0": "\\EE＊ なんだよ　これ！？",
  "obj_homealone_basement_convo_slash_Create_0_gml_175_0": "\\EH＊ …てんしの…おにんぎょう…",
  "obj_homealone_basement_convo_slash_Create_0_gml_176_0": "\\EH＊ うごいてたじゃねーかよ！",
  "obj_homealone_basement_convo_slash_Create_0_gml_179_0": "\\EC＊ てか^1　マジで\n　 うごいてたよな？",
  "obj_homealone_basement_convo_slash_Create_0_gml_180_0": "\\EI＊ また　うごくかも…\n　 すこし　まってみよう…？",
  "obj_homealone_basement_convo_slash_Create_0_gml_183_0": "\\EC＊ ぜってー　うごくぜ。",
  "obj_homealone_basement_convo_slash_Create_0_gml_184_0": "\\EI＊ うん…",
  "obj_homealone_basement_convo_susie_slash_Create_0_gml_34_0": "＊ クソッ…　全部動かしたけど\n　 なにも　見つからねぇ…",
  "obj_homealone_basement_convo_susie_slash_Create_0_gml_37_0": "＊ …クリスのほうは　どうだろな。",
  "obj_homealone_basement_convo_susie_slash_Create_0_gml_40_0": "＊ とりあえず\n　 さがしつづけるしかねーな。",
  "obj_homealone_bathroom_convo_slash_Create_0_gml_70_0": "\\E0＊ ラー　ララー…",
  "obj_homealone_bathroom_convo_slash_Create_0_gml_73_0": "\\E5＊ いやあ^1　そうじをすると\n　 おなかが　へるなあ！",
  "obj_homealone_bathroom_convo_slash_Create_0_gml_76_0": "\\E3＊ キッチンに\n　 なにか　おやつが\n　 あるかな…？",
  "obj_homealone_bathroom_convo_slash_Create_0_gml_79_0": "\\E1＊ …いやいや^1。\n　 いまは　やすんでいる\n　 ばあいじゃない。",
  "obj_homealone_bathroom_convo_slash_Create_0_gml_82_0": "\\E2＊ これまで　いじょうに^1…\n　 しゅうちゅうしなければ。",
  "obj_homealone_bathroom_convo_slash_Create_0_gml_85_0": "\\E3＊ こんどこそ\n　 けっちゃくを　つける。",
  "obj_homealone_bathroom_convo_slash_Create_0_gml_88_0": "\\E1＊ …もういちど　さがそう。",
  "obj_homealone_dess_convo_slash_Create_0_gml_23_0": "\\EL＊ で？^1　さっきいってた\n　 ゆめの　はなしの　つづき^1　\n　 きかせろよ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_24_0": "\\E3＊ えっと…　みんなで\n　 ジェットコースターに\n　 のって…",
  "obj_homealone_dess_convo_slash_Create_0_gml_25_0": "\\E2＊ みんなっていうのは\n　 スージィと^1　クリスと^1　\n　 もうひとり　\\cYおとこのコ\\cWで…",
  "obj_homealone_dess_convo_slash_Create_0_gml_26_0": "\\E3＊ クリスの　\\cYコスチューム\\cWは^1…\n　 えーっと…",
  "obj_homealone_dess_convo_slash_Create_0_gml_27_0": "\\E7＊ オレのジェットコースター^1　\n　 イケてたか？",
  "obj_homealone_dess_convo_slash_Create_0_gml_28_0": "\\E4＊ うん。\n　 ほのおみたいな　もようが\n　 プリントされてた。",
  "obj_homealone_dess_convo_slash_Create_0_gml_29_0": "\\E2＊ ヘヘッ^1。だな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_33_0": "\\E5＊ その　おとこのコは\n　 ちょっと…^1　なんだろう^1…\n　 きになるかんじ…だったな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_34_0": "\\E0＊ きになる？^1　なんで。",
  "obj_homealone_dess_convo_slash_Create_0_gml_35_0": "\\E4＊ みたかんじ^1…\\cYアズリエル\\cWに\n　 ちょっと　にてたの。",
  "obj_homealone_dess_convo_slash_Create_0_gml_36_0": "\\E9＊ クリスの　\\cYお兄ちゃん\\cWね^1…\n　 でも　べつじんで…",
  "obj_homealone_dess_convo_slash_Create_0_gml_37_0": "\\E0＊ あー…　いわれてみれば\n　 たしかに　ちょっと\n　 \\cYクリスのママ\\cWっぽいな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_38_0": "\\EF＊ え？",
  "obj_homealone_dess_convo_slash_Create_0_gml_39_0": "\\EK＊ あー…^1　クリスのアニキに\n　 にてんなら^1　そーだろーな\n　 ってことだよ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_40_0": "\\E3＊ うん^1。それで\n　 しばらく^1　なんでだろうって\n　 かんがえてたんだけど…",
  "obj_homealone_dess_convo_slash_Create_0_gml_41_0": "\\E4＊ いろんなことが\n　 ありすぎて^1…\n　 かんがえるの　やめちゃった。",
  "obj_homealone_dess_convo_slash_Create_0_gml_45_0": "＊\\E4 そのうち　クリスと\n　 \\cYおおきな　まち\\cWにいって…",
  "obj_homealone_dess_convo_slash_Create_0_gml_46_0": "＊\\E4 そこで　\\cYなぜか　クリス\\cWは…",
  "obj_homealone_dess_convo_slash_Create_0_gml_47_0": "＊\\E3 \\cYふだんのクリス\\cWとは\n　 ちがうかんじで…",
  "obj_homealone_dess_convo_slash_Create_0_gml_48_0": "＊\\E2 \\cYさいきん\\cWの　クリスみたいな\n　 かんじっていうか…",
  "obj_homealone_dess_convo_slash_Create_0_gml_49_0": "＊\\E0 さいきんのクリス^1？\n　 \\cYふつう\\cWな　かんじじゃね？",
  "obj_homealone_dess_convo_slash_Create_0_gml_50_0": "＊\\E3 なんていうか^1…\n　 なにもかもが　まるで…",
  "obj_homealone_dess_convo_slash_Create_0_gml_51_0": "＊\\E1 ゲームみたいだった。",
  "obj_homealone_dess_convo_slash_Create_0_gml_52_0": "＊\\E3 てきと　エンカウント\n　 したり^1…\n　 たからばこを　みつけたり。",
  "obj_homealone_dess_convo_slash_Create_0_gml_53_0": "＊\\E0 へー。そんなふうに\n　 かんがえたこと\n　 なかったな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_54_0": "＊\\E3 クリスは^1　わたしを\n　 じっと　\\cYみていて\\cW…",
  "obj_homealone_dess_convo_slash_Create_0_gml_55_0": "＊\\Ee なにか　\\cYいいたそう\\cWに\n　 してるんだけど…",
  "obj_homealone_dess_convo_slash_Create_0_gml_56_0": "＊\\E9 クリスの　くちからでる\n　 ことばは　ぜんぶ…\n　 \\cYいわかん\\cWが　あって。",
  "obj_homealone_dess_convo_slash_Create_0_gml_57_0": "＊\\E2 \\cYスピーカー\\cWからでてる\n　 みたいな　かんじって\n　 いうのかな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_58_0": "＊\\EL クリスって　いっつも\n　 \\cYそんなかんじ\\cWじゃね？",
  "obj_homealone_dess_convo_slash_Create_0_gml_59_0": "＊\\E5 いつもとは　ちがった^1…\n　 なんだか　\\cYヘン\\cWだった。",
  "obj_homealone_dess_convo_slash_Create_0_gml_63_0": "＊\\E2 オレは^1　\\cYクリスは　いつも\n　 ヘン\\cWだとおもうぜ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_64_0": "＊\\E0 ブツブツなんか\n　 つぶやいたり^1　きゅうに\n　 でけぇこえで　\\cYさけんだり\\cW…",
  "obj_homealone_dess_convo_slash_Create_0_gml_65_0": "＊\\EC でも　なんつーか…",
  "obj_homealone_dess_convo_slash_Create_0_gml_66_0": "＊\\EC なんでか　わかんねーけど^1…\n　 あいつ　ときどき…",
  "obj_homealone_dess_convo_slash_Create_0_gml_67_0": "＊\\EK \\cYくどく\\cWの　やたら\n　 うまくね？",
  "obj_homealone_dess_convo_slash_Create_0_gml_68_0": "＊\\EK …えっ。ど…\\cYどうして\n　 そうおもう\\cWの？",
  "obj_homealone_dess_convo_slash_Create_0_gml_69_0": "＊\\E0 あーいや…^1　\n　 やっぱ　なんでもねー。",
  "obj_homealone_dess_convo_slash_Create_0_gml_73_0": "＊\\EA てか^1　\\cYみた\\cWことねえ？\n　 クリスが　\\cYだれか\n　 くどいてる\\cWとこ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_74_0": "＊\\EK だれかって^1…だれ？？",
  "obj_homealone_dess_convo_slash_Create_0_gml_75_0": "＊\\EC …てき　とか？",
  "obj_homealone_dess_convo_slash_Create_0_gml_76_0": "＊\\EI てき？？？",
  "obj_homealone_dess_convo_slash_Create_0_gml_77_0": "＊\\E5 いや…^1　しらねーけど^1！\n　 とにかく…",
  "obj_homealone_dess_convo_slash_Create_0_gml_78_0": "＊\\EA オレも　あいつに\n　 \\cYくどきかた　ならう\\cWかな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_79_0": "＊\\E8 あは…はは^1。それは^1…\n　 うん。なんていうか^1…\n　 \\cYたのしそう\\cW…だね。",
  "obj_homealone_dess_convo_slash_Create_0_gml_80_0": "＊\\EC いや^1　ノエルも\n　 「\\cYいっしょに　どう？\\cW」って\n　 はなしなんだけど？",
  "obj_homealone_dess_convo_slash_Create_0_gml_81_0": "＊\\EH (わたし　そんなに\n　 ヒドいってこと？？)",
  "obj_homealone_dess_convo_slash_Create_0_gml_85_0": "＊\\E8 うーん…^1　クリスは\n　 わたしには　そういうこと\n　 おしえないんじゃないかな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_86_0": "＊\\EL んだよ^1。じゃあ^1　レッスンは\n　 \\cYオレら　３にん\\cWだけだな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_87_0": "＊\\EK ３にん？？？",
  "obj_homealone_dess_convo_slash_Create_0_gml_88_0": "＊\\EK \\cYあー\\cW…",
  "obj_homealone_dess_convo_slash_Create_0_gml_89_0": "＊\\EC …３にんは　\\cY３にん\\cWだよ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_90_0": "＊\\E8 どの　３にん？",
  "obj_homealone_dess_convo_slash_Create_0_gml_91_0": "＊\\EC だから　その…ほら^1…\n　 べつの　がっこう？　の\n　 だんしが　いてさ…",
  "obj_homealone_dess_convo_slash_Create_0_gml_92_0": "＊\\EN そいつを　まつりに\n　 さそったんだけど…",
  "obj_homealone_dess_convo_slash_Create_0_gml_93_0": "＊\\E9 そのコと^1…いっしょに\n　 おまつり　いこうと\n　 おもったってこと？",
  "obj_homealone_dess_convo_slash_Create_0_gml_94_0": "＊\\ED ああ^1。でも^1　\n　 いけねえんだってさ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_95_0": "＊\\EC べつの　がっこうの\n　 ようじとかで。",
  "obj_homealone_dess_convo_slash_Create_0_gml_96_0": "＊\\E2 そっか。",
  "obj_homealone_dess_convo_slash_Create_0_gml_97_0": "＊\\E4 てか^1　かんちがいすんなよ？",
  "obj_homealone_dess_convo_slash_Create_0_gml_98_0": "＊\\ED ただ…^1　そいつ　あんまり\n　 みんなと　あそぶ\n　 チャンスが　ねえからさ…",
  "obj_homealone_dess_convo_slash_Create_0_gml_99_0": "＊\\ES ウソ　やだ\n　 スージィ　やさしい^1。\n　 それ　すごくステキだよ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_103_0": "＊\\E0 てか^1　さっき\n　 きづいたんだけどさ…",
  "obj_homealone_dess_convo_slash_Create_0_gml_104_0": "＊\\E1 かべに　\\cYしゃしん\\cW\n　 はってあったな？\n　 ノエルと　クリスの…",
  "obj_homealone_dess_convo_slash_Create_0_gml_105_0": "＊\\E8 やだー^1！　すごいむかしの\n　 だから　はってあることも\n　 わすれてたよ！",
  "obj_homealone_dess_convo_slash_Create_0_gml_106_0": "＊\\EC おまえら　\\cYなかいい\\cWのな。\n　 しらなかったぜ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_107_0": "＊\\E3 わたしたち^1…\n　 \\cYクリスと　わたし\\cWは…",
  "obj_homealone_dess_convo_slash_Create_0_gml_108_0": "＊\\E2 \\cYいえが　ちかい\\cWってだけ…",
  "obj_homealone_dess_convo_slash_Create_0_gml_109_0": "＊\\E3 だから^1　よくかおを\n　 あわせるけど^1…\n　 \\cYそれだけ\\cWだよ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_110_0": "＊\\E0 でも^1　あのしゃしん^1…\n　 おまえら　ふたり…",
  "obj_homealone_dess_convo_slash_Create_0_gml_111_0": "＊\\E1 いっしょに\n　 \\cYかんらんしゃ\\cW　のってたぜ？",
  "obj_homealone_dess_convo_slash_Create_0_gml_112_0": "＊\\E8 ふはははは！^1　あれはね^1…\n　 けっこう　\\cYムリヤリ\\cWだったの。",
  "obj_homealone_dess_convo_slash_Create_0_gml_113_0": "＊\\ED じゃあ^1…いっしょに\n　 かんらんしゃ　のっても^1　\n　 なんのイミもねーの？",
  "obj_homealone_dess_convo_slash_Create_0_gml_114_0": "＊\\E8 えっと…　ムリヤリ\n　 のらされただけだったら？",
  "obj_homealone_dess_convo_slash_Create_0_gml_115_0": "＊\\ED へー。",
  "obj_homealone_dess_convo_slash_Create_0_gml_116_0": "＊\\ET ま^1　そーだよな^1。\n　 ただの　くだらねー\n　 のりものだしな。",
  "obj_homealone_dess_convo_slash_Create_0_gml_117_0": "＊\\E2 …",
  "obj_homealone_dess_convo_slash_Create_0_gml_118_0": "＊\\EM んじゃあ^1　かりに^1　\n　 だれか　べつのヤツと\n　 のったとしても…",
  "obj_homealone_dess_convo_slash_Create_0_gml_119_0": "＊\\E8 それは^1！",
  "obj_homealone_dess_convo_slash_Create_0_gml_120_0": "＊\\E6 いっしょに　のった\n　 ふたりの　きもちしだい^1…\n　 じゃないかな？",
  "obj_homealone_dess_convo_slash_Create_0_gml_121_0": "＊\\ES だから^1　かりに\n　 ムリヤリのらされた\n　 だけでも…",
  "obj_homealone_dess_convo_slash_Create_0_gml_122_0": "＊\\E2 あーオッケー^1。\n　 なるほどな。ハハ。",
  "obj_homealone_dess_convo_slash_Create_0_gml_126_0": "＊\\E0 で？^1　\\cYクリスと\n　 のったとき\\cWは？",
  "obj_homealone_dess_convo_slash_Create_0_gml_127_0": "＊\\E5 クリスは　なんにも\n　 しゃべらずに^1　\\cYまどの\n　 そとを　じっとみてた\\cW…",
  "obj_homealone_dess_convo_slash_Create_0_gml_128_0": "＊\\E8 …で^1　とつぜん\n　 ゴンドラを　\\cYグラグラ\n　 ゆらしはじめて\\cW…",
  "obj_homealone_dess_convo_slash_Create_0_gml_129_0": "＊\\E4 わたしが　こわくて\n　 さけんだら^1　こっちをみて\n　 \\cYわらった\\cWの…",
  "obj_homealone_dess_convo_slash_Create_0_gml_130_0": "＊\\E0 …",
  "obj_homealone_dess_convo_slash_Create_0_gml_131_0": "＊\\E1 それって^1…\n　 \\cYいい\\cWの？　\\cYわるい\\cWの？",
  "obj_homealone_dess_convo_slash_Create_0_gml_132_0": "＊\\Ee …",
  "obj_homealone_dess_convo_slash_Create_0_gml_133_0": "＊\\E3 おぼえてないな^1。\n　 \\cYまだ　ちいさかったから\\cW。",
  "obj_homealone_dess_convo_slash_Create_0_gml_138_0": "＊\\E0 じゃあ^1…ひとつ\n　 きいてもいいか。",
  "obj_homealone_dess_convo_slash_Create_0_gml_139_0": "＊\\E1 ノエルが　みた\n　 ゆめのことな？",
  "obj_homealone_dess_convo_slash_Create_0_gml_140_0": "＊\\E3 …うん^1。いいよ…",
  "obj_homealone_dess_convo_slash_Create_0_gml_141_0": "＊\\ED その…^1　ゆめんなかで…",
  "obj_homealone_dess_convo_slash_Create_0_gml_142_0": "＊\\EN オレらが^1…ふたりっきりに\n　 なった　ばめんて…",
  "obj_homealone_dess_convo_slash_Create_0_gml_143_0": "＊\\EL …",
  "obj_homealone_dess_convo_slash_Create_0_gml_144_0": "＊\\E6 …ゆめの　なかで…",
