  "DEVICE_NAMER_slash_Other_10_gml_29_0": "KRIS",
  "DEVICE_NAMER_slash_Other_10_gml_30_0": "TORIEL",
  "DEVICE_NAMER_slash_Other_10_gml_31_0": "ASRIEL",
