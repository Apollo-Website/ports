  "obj_npc_dojo_slash_Step_0_gml_56_0": "＊ ダメだ！^1　もちものが　いっぱいだ！/",
  "obj_npc_dojo_slash_Step_0_gml_61_0": "＊ 残念だったな^1！&　 また挑戦してくれ！/%",
  "obj_npc_facing_slash_Other_10_gml_129_0": "＊ You wouldn't have to be HER'S^1!&＊ She's gonna pound you to pieces^1, Kris!/",
  "obj_npc_facing_slash_Other_10_gml_208_0": "\\E0＊ こんやは　ゆっくり&　 ねてくださいね？/%",
  "obj_npc_facing_slash_Other_10_gml_504_0": "\\EQ＊ えっと^1…&　 がんばりますっ…！/",
  "obj_npc_facing_slash_Other_10_gml_506_0": "\\E1＊ <!--チョット質問:&　 [[割る用のツボは&　 いくつ用意できますか]]-->/",
  "obj_npc_facing_slash_Other_10_gml_508_0": "\\EM＊ えーっ…と^1…　いま　ある^1分&　 数えてみますね。/%",
