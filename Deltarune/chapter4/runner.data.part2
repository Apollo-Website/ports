    {
        snd_play(snd_jump);
        snd_play_delay(201, jumptime, 1, 1.2);
        var targx = obj_mainchara.x + 60;
        var targy = obj_mainchara.y - 42;
        
        with (angymarker)
            scr_jump_to_point(targx, targy, 20, jumptime);
    }
    
    if (timer > (8 + fadetime))
        scr_depth_alt(angymarker);
    
