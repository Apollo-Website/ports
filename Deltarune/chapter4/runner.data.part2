  "scr_prophecytext_slash_scr_prophecytext_gml_13_0": "娘",
  "scr_prophecytext_slash_scr_prophecytext_gml_20_0": "影たちの ささやく予言",
  "scr_prophecytext_slash_scr_prophecytext_gml_23_0": "この世界の伝説#<DELTARUNE>",
  "scr_prophecytext_slash_scr_prophecytext_gml_26_0": "清らかな光の満ちる世界#その下に広がる 永遠の夜",
  "scr_prophecytext_slash_scr_prophecytext_gml_29_0": "泉の解き放たれしとき 咆哮は響き#暗き瞳より 巨人は現れる",
  "scr_prophecytext_slash_scr_prophecytext_gml_32_0": "光も闇も やがて燃え尽きる#大地の終焉への秒読み",
  "scr_prophecytext_slash_scr_prophecytext_gml_35_0": "やよ 夢と希望のもと#この世の果てに 送り込まれし３人の勇者",
  "scr_prophecytext_slash_scr_prophecytext_gml_38_0": "胸に希望を刻みし娘",
  "scr_prophecytext_slash_scr_prophecytext_gml_41_0": "２人めの勇者#胸に希望を刻みし娘",
  "scr_prophecytext_slash_scr_prophecytext_gml_49_0": "暗き闇の淵に在る 孤独な王子",
  "scr_prophecytext_slash_scr_prophecytext_gml_52_0": "３人めの勇者#暗き闇の淵に在る 孤独な王子",
  "scr_prophecytext_slash_scr_prophecytext_gml_56_0": "人間の魂と部位を収めた籠",
  "scr_prophecytext_slash_scr_prophecytext_gml_59_0": "１人めの勇者#人間の魂と部位を収めた籠",
  "scr_prophecytext_slash_scr_prophecytext_gml_63_0": "彼らは聞く#天の呼ぶ音を",
  "scr_prophecytext_slash_scr_prophecytext_gml_66_0": "彼らは見る#這い回る地獄の尾を",
  "scr_prophecytext_slash_scr_prophecytext_gml_69_0": "黒き刃にて生み出す騎士は",
  "scr_prophecytext_slash_scr_prophecytext_gml_72_0": "勇者たちと 決闘せん",
  "scr_prophecytext_slash_scr_prophecytext_gml_75_0": "クイーンの車は 停車せず",
  "scr_prophecytext_slash_scr_prophecytext_gml_78_0": "画面公は 紅き刃に切り裂かれん",
  "scr_prophecytext_slash_scr_prophecytext_gml_81_0": "花男は 施設に囚われん",
  "scr_prophecytext_slash_scr_prophecytext_gml_84_0": "ジョッキントンは 髭を生やさん",
  "scr_prophecytext_slash_scr_prophecytext_gml_87_0": "とんがり頭は 「キレイキレイ」#「ボーイ」と 口にせん",
  "scr_prophecytext_slash_scr_prophecytext_gml_91_0": "判じ物の 最初の４音",
  "scr_prophecytext_slash_scr_prophecytext_gml_95_0": "判じ物の 最後の４音",
  "scr_prophecytext_slash_scr_prophecytext_gml_98_0": "判じ物の 多数の音",
  "scr_prophecytext_slash_scr_prophecytext_gml_101_0": "追放されし天使は#ついにその 希望に まみえん",
  "scr_prophecytext_slash_scr_prophecytext_gml_104_0": "やがて 伝説の希望の#すべて失われしとき",
  "scr_prophecytext_slash_scr_prophecytext_gml_107_0": "最後の悲劇 明かされん",
  "scr_prophecytext_slash_scr_prophecytext_gml_110_0": "世界を救わんとするならば",
  "scr_prophecytext_slash_scr_prophecytext_gml_113_0": "そが なされれば#世界は 救われん",
  "scr_prophecytext_slash_scr_prophecytext_gml_116_0": "亀の大いなる槌より#生まれいでし斧",
  "scr_prophecytext_slash_scr_prophecytext_gml_119_0": "最後に 娘が#ついに その娘が",
  "scr_prophecytext_slash_scr_prophecytext_gml_122_0": "冷たき水が 空より降り注がん",
  "scr_prophecytext_slash_scr_prophecytext_gml_125_0": "ROOTS",
  "scr_prophecytext_slash_scr_prophecytext_gml_128_0": "GALLERY",
  "scr_prophecytext_slash_scr_prophecytext_gml_131_0": "娘は愛の 真の意味を知る",
  "scr_prophecytext_slash_scr_prophecytext_gml_134_0": "最後の予言#物語の終わり",
  "scr_prophecytext_slash_scr_prophecytext_gml_137_0": "世界を救うすべは#ただ１つ",
  "scr_recruit_info_slash_scr_recruit_info_gml_433_0_b": "グウェイ",
  "scr_recruit_info_slash_scr_recruit_info_gml_434_0_b": "ロウのようになめらかな肌をした霊。\n不気味な炎を生み出す。“本物の”\nゆうれいではなく　ムチや　水などを\n極端に嫌う。",
  "scr_recruit_info_slash_scr_recruit_info_gml_435_0": "骨つき肉",
  "scr_recruit_info_slash_scr_recruit_info_gml_436_0": "聖水",
  "scr_recruit_info_slash_scr_recruit_info_gml_441_0": "霊:炎",
  "scr_recruit_info_slash_scr_recruit_info_gml_442_0": "＊ (周囲のキャンドルから\n　 とけたロウを　すすっている)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_448_0": "バルタザード",
  "scr_recruit_info_slash_scr_recruit_info_gml_449_0": "いにしえのアロマンサー。まほうのお香を\n生成し　鋼の殻の中にしまう。\nのんびりした性格で　グウェイと仲がよい。",
  "scr_recruit_info_slash_scr_recruit_info_gml_450_0": "香りつきキャンドル",
  "scr_recruit_info_slash_scr_recruit_info_gml_451_0": "勢いよく回されること",
  "scr_recruit_info_slash_scr_recruit_info_gml_456_0": "鋼:香",
  "scr_recruit_info_slash_scr_recruit_info_gml_457_0": "＊ リ　ラ　ッ　ク　ス　…/",
  "scr_recruit_info_slash_scr_recruit_info_gml_458_0": "＊ (紅茶パウダーを\n　 ストレートで飲んでいる)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_464_0": "ビブリオクス",
  "scr_recruit_info_slash_scr_recruit_info_gml_465_0": "ついブツブツひとり言を言ってしまう\n年老いた賢者。そのヒゲには　千の呪文が\n秘められているという。",
  "scr_recruit_info_slash_scr_recruit_info_gml_466_0": "古文書",
  "scr_recruit_info_slash_scr_recruit_info_gml_467_0": "自動添削",
  "scr_recruit_info_slash_scr_recruit_info_gml_472_0": "魔",
  "scr_recruit_info_slash_scr_recruit_info_gml_473_0": "＊ ブツブツ^1…\n　 ああ…古文書だ…/",
  "scr_recruit_info_slash_scr_recruit_info_gml_474_0": "＊ (メニューを読んでいる)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_480_0": "ミズル",
  "scr_recruit_info_slash_scr_recruit_info_gml_481_0": "「ウォータークーラー」の中で眠る\n水の精。気が向くと　妖精っぽいことや\n姫っぽいことをする。",
  "scr_recruit_info_slash_scr_recruit_info_gml_482_0": "入浴剤",
  "scr_recruit_info_slash_scr_recruit_info_gml_483_0": "目覚まし時計",
  "scr_recruit_info_slash_scr_recruit_info_gml_488_0": "水",
  "scr_recruit_info_slash_scr_recruit_info_gml_489_0": "＊ 水道水…？^1　あらまあ…/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_495_0": "ウィングレード",
  "scr_recruit_info_slash_scr_recruit_info_gml_496_0": "まじょの使い魔。生きた剣。\nらくがきを彫ってと頼むと\nとてもよろこぶ。",
  "scr_recruit_info_slash_scr_recruit_info_gml_497_0": "カリグラフィー",
  "scr_recruit_info_slash_scr_recruit_info_gml_498_0": "独裁主義",
  "scr_recruit_info_slash_scr_recruit_info_gml_503_0": "刃",
  "scr_recruit_info_slash_scr_recruit_info_gml_504_0": "＊ 見て。/",
  "scr_recruit_info_slash_scr_recruit_info_gml_505_0": "＊ (テーブルに　イニシャルを\n　 彫ってくれた…)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_511_0": "ウィカベル",
  "scr_recruit_info_slash_scr_recruit_info_gml_512_0": "音楽の儀式をとりおこなう　まじょ。\n曲を演奏すれば　聴く者の気分が変わる…\nが　音楽とは　もともとそういうもの。",
  "scr_recruit_info_slash_scr_recruit_info_gml_513_0": "禅鐘",
  "scr_recruit_info_slash_scr_recruit_info_gml_514_0": "初見演奏",
  "scr_recruit_info_slash_scr_recruit_info_gml_519_0": "鋼:音",
  "scr_recruit_info_slash_scr_recruit_info_gml_520_0": "＊ ディン…ドン…！\n　 トラベル しらベル…/",
  "scr_recruit_info_slash_scr_recruit_info_gml_521_0": "＊ (お茶を　飲みながら\n　 ホテルの予約サイトを見ている)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_527_0": "オルガニック",
  "scr_recruit_info_slash_scr_recruit_info_gml_528_0": "いにしえの言葉を研究する哲学者。\n光を遮断する仮面をかぶることで\n闇の真実と深く通じることができると\nされる。",
  "scr_recruit_info_slash_scr_recruit_info_gml_529_0": "道具主義",
  "scr_recruit_info_slash_scr_recruit_info_gml_530_0": "それがなんなのか知ること",
  "scr_recruit_info_slash_scr_recruit_info_gml_535_0": "鋼:音",
  "scr_recruit_info_slash_scr_recruit_info_gml_536_0": "＊ 嗚呼　お茶よ　お茶！/",
  "scr_recruit_info_slash_scr_recruit_info_gml_537_0": "＊ ワレは１％　お茶だろうか？\n　 それとも　お茶が\n　 99％　ワレだろうか？/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_543_0": "ミス・ミズル",
  "scr_recruit_info_slash_scr_recruit_info_gml_544_0": "何世紀にもわたり崇拝されたおかげで\n自分は偉大な王族だとかんちがいしている\nただのミズル。「聖」属性の精霊ですら\nない。",
  "scr_recruit_info_slash_scr_recruit_info_gml_545_0": "崇拝",
  "scr_recruit_info_slash_scr_recruit_info_gml_546_0": "野蛮",
  "scr_recruit_info_slash_scr_recruit_info_gml_551_0": "水",
  "scr_recruit_info_slash_scr_recruit_info_gml_552_0": "＊ 嗚呼　若き勇者よ^1。\n　 ワタシに　ふさわしい\n　 VIP房は　どこに？/%",
  "scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_125_0_b": "BIG",
  "scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_127_0_b": "COMBO",
  "scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_597_0": "ルードバスター",
  "scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_598_0": "夢と希望の平原 ",
  "scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_599_0": "Knock You Down !!",
  "scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_600_0": "バットを振りかざせ",
  "scr_rhythmgame_draw_slash_scr_rhythmgame_draw_gml_601_0": "It's TV Time!",
  "scr_roomname_slash_scr_roomname_gml_4_0_b": "クリスのへや",
  "scr_roomname_slash_scr_roomname_gml_5_0": "マイ キャッスルタウン",
  "scr_roomname_slash_scr_roomname_gml_7_0_b": "闇の聖域",
  "scr_roomname_slash_scr_roomname_gml_8_0_c": "~1 - アトリウム",
  "scr_roomname_slash_scr_roomname_gml_9_0_c": "~1 - 左下",
  "scr_roomname_slash_scr_roomname_gml_10_0": "~1 - 右下",
  "scr_roomname_slash_scr_roomname_gml_11_0_b": "~1 - 書斎",
  "scr_roomname_slash_scr_roomname_gml_12_0": "~1 - 図書室",
  "scr_roomname_slash_scr_roomname_gml_15_0": "第２の聖域",
  "scr_roomname_slash_scr_roomname_gml_16_0": "~1 - アトリウム",
  "scr_roomname_slash_scr_roomname_gml_17_0": "~1 - フロア",
  "scr_roomname_slash_scr_roomname_gml_18_0": "~1 - 書斎",
  "scr_roomname_slash_scr_roomname_gml_19_0": "~1 - 書斎",
  "scr_roomname_slash_scr_roomname_gml_21_0": "第３の聖域",
  "scr_roomname_slash_scr_roomname_gml_23_0": "~1 - 階段",
  "scr_roomname_slash_scr_roomname_gml_24_0": "~1 - 最後の間",
  "scr_shop_vending_slash_scr_shop_vending_gml_43_0_b": "アイテム\n聖なる歌で\nできたお茶\nHP115回復",
  "scr_shop_vending_slash_scr_shop_vending_gml_46_0_b": "アイテム\nヤバい\nジュース\nHP160回復",
  "scr_shop_vending_slash_scr_shop_vending_gml_56_0": "ぼうぐ\n聖なる\n穴あき護符",
  "scr_shop_vending_slash_scr_shop_vending_gml_66_0_b": "ぶき\n頁をマーク\nDEF+1",
  "scr_spellinfo_slash_scr_spellinfo_gml_34_0_b": "仲間を\n回復",
  "scr_spellinfo_slash_scr_spellinfo_gml_45_0_b": "くたびれた\n敵を逃がす",
  "scr_spellinfo_slash_scr_spellinfo_gml_55_0_b": "暴属性\nダメージ",
  "scr_spellinfo_slash_scr_spellinfo_gml_67_0_b": "赤属性\nダメージ",
  "scr_spellinfo_slash_scr_spellinfo_gml_93_0": "ありとあらゆる行動に出る。\nまほうとは呼べない。",
  "scr_spellinfo_slash_scr_spellinfo_gml_152_0_b": "OKヒール",
  "scr_spellinfo_slash_scr_spellinfo_gml_153_0_b": "OKヒール",
  "scr_spellinfo_slash_scr_spellinfo_gml_154_0": "並みの\n回復",
  "scr_spellinfo_slash_scr_spellinfo_gml_155_0_b": "カンペキな回復まほうではないものの\nなにか使い道があるかも。",
  "scr_spellinfo_slash_scr_spellinfo_gml_161_0": "ヒール",
  "scr_spellinfo_slash_scr_spellinfo_gml_162_0": "ヒール",
  "scr_spellinfo_slash_scr_spellinfo_gml_163_0": "使えない",
  "scr_spellinfo_slash_scr_spellinfo_gml_164_0": "使い手は　このまほうを\n使いたくないようだ。",
  "scr_spellinfo_slash_scr_spellinfo_gml_169_0": "ベターヒール",
  "scr_spellinfo_slash_scr_spellinfo_gml_170_0": "ベターヒール",
  "scr_spellinfo_slash_scr_spellinfo_gml_171_0": "仲間を\n回復",
  "scr_spellinfo_slash_scr_spellinfo_gml_172_0": "練習をつんで自信を得て\n効果がアップした回復まほう",
  "scr_spelltext_slash_scr_spelltext_gml_58_0_b": "＊ ~1とスージィは\n　 デュアルヒールを唱えた！\n　 デュアルヒールの効果が下がった！/%",
  "scr_spelltext_slash_scr_spelltext_gml_76_0": "＊ ~1は\n　 OKヒールを唱えた！/%",
  "scr_spelltext_slash_scr_spelltext_gml_118_0": "＊ ~1は\n　 DDキャンディを使った！/%",
  "scr_spelltext_slash_scr_spelltext_gml_329_0": "＊ ~1は\n　 オールドスイートを使った！/%",
  "scr_spelltext_slash_scr_spelltext_gml_332_0": "＊ ~1は\n　 ラプソティーを使った！/%",
  "scr_spelltext_slash_scr_spelltext_gml_335_0": "＊ ~1は\n　 スカーレッティーを使った！/%",
  "scr_spelltext_slash_scr_spelltext_gml_338_0": "＊ ~1は\n　 ビターティアを使った！/%",
  "scr_text_slash_scr_text_gml_4117_0": "＊ しぶしぶ　５ドル　“かりた”。/",
  "scr_text_slash_scr_text_gml_4122_0": "\\E2＊ ヒヒヒ…　おまえのアニキに\n　 ダイナーで　メシおごって\n　 もらおうぜ。/%",
  "scr_text_slash_scr_text_gml_4126_0": "\\EP＊ ここに　おいてった\n　 ってことは^1　いらねー\n　 カネってことだろ？/%",
  "scr_text_slash_scr_text_gml_4900_0": "＊ ハーナ　フーダ^1！　次はワタシが\n　 ケーキを焼く番ですヨー！/%",
  "scr_text_slash_scr_text_gml_4905_0": "＊ もうすぐ^1　ワタシの顔のデザインの\n　 家を　建てられますネー！/",
  "scr_text_slash_scr_text_gml_4906_0": "＊ そんな家に住むのが\n　 ずーっと夢デシタ！/%",
  "scr_text_slash_scr_text_gml_5000_0": "＊ 私は　ついに知った^1…\n　 パンとは　なにかを。/",
  "scr_text_slash_scr_text_gml_5033_0": "＊ フッ^1！　ハッ^1！\n　 腕を磨き^1　究極の技「新合成」を\n　 編み出した。/",
  "scr_text_slash_scr_text_gml_5034_0_b": "＊ そして^1　禁断の技^1　「パン」に\n　 目覚めた。/",
  "scr_text_slash_scr_text_gml_5035_0": "＊ そして^1　禁断の技^1　\n　 「グルテン過敏症」に\n　 目覚めた。/",
  "scr_text_slash_scr_text_gml_5036_0_b": "＊ したがって^1　私は　新たなレシピを\n　 ひとつも　生み出していない。/",
  "scr_text_slash_scr_text_gml_5037_0_b": "＊ ああ^1…どこかに　真の\n　 「パン」マスターが　存在すれば…/%",
  "scr_text_slash_scr_text_gml_5042_0": "＊ ああ^1…どこかに　真の\n　 「パン」マスターが　存在すれば…/%",
  "scr_text_slash_scr_text_gml_5070_0_b": "\\EE＊ 放し飼いランサーの\n　 オーガニック　ランサー\n　 クッキー^1！　無料です！/",
  "scr_text_slash_scr_text_gml_5222_0": "＊ ボス^1…すまないな^1…\n　 ここは…愛の道場だ。/",
  "scr_text_slash_scr_text_gml_5223_0": "＊ やることは　前と変わらない^1。\n　 ここは　戦う場所だ。/",
  "scr_text_slash_scr_text_gml_5224_0": "＊ …BGMが　無意味に\n　 センチメンタルになっただけ。/",
  "scr_text_slash_scr_text_gml_5225_0_b": "＊ そんで　残念なことに^1…\n　 恋人たちとしか　戦えない。/",
  "scr_text_slash_scr_text_gml_5226_0_b": "＊ ボス^1。恋人たちとバトルするか？/",
  "scr_text_slash_scr_text_gml_5227_0_b": "\\C2",
  "scr_text_slash_scr_text_gml_5231_0_b": "＊ ボス^1。バトルするか？/",
  "scr_text_slash_scr_text_gml_5232_0_b": "\\C2",
  "scr_text_slash_scr_text_gml_5660_0": "＊ お帰りなさいませ^1　ご主人さま。/",
  "scr_text_slash_scr_text_gml_5670_0": "＊ どうやら　ここは　ネコカフェに\n　 なってしまったようで^1…\n　 まことに遺憾です。/",
  "scr_text_slash_scr_text_gml_5671_0": "＊ 語尾に^1…なんでしたかな^1…\n　 「ニャ」？　をつけなければ\n　 ならないようなのです。/",
  "scr_text_slash_scr_text_gml_5672_0": "＊ お気に召すとよいのですが^1。\n　 本日は　どのようなご用件で？/",
  "scr_text_slash_scr_text_gml_5676_0_b": "＊ ごきげんよう^1。\n　 …ニャ。/",
  "scr_text_slash_scr_text_gml_5731_0": "＊ ニンゲンの　お子さまには^1　\n　 「ティラミスネコ耳」を\n　 おすすめいたします。/%",
  "scr_text_slash_scr_text_gml_5742_0": "＊ モンスターの　お子さまには^1 \n　 「黒いしっぽのチュロス」を\n　 おすすめいたします。/%",
  "scr_text_slash_scr_text_gml_5753_0": "＊ 王子の　お子さまには^1　\n　 「肉球モチパイ」を\n　 おすすめいたします。/%",
  "scr_text_slash_scr_text_gml_5764_0": "＊ トナカイの　お子さまには^1　\n　 「肉球型パフェ」を\n　 おすすめいたします。/%",
  "scr_text_slash_scr_text_gml_6233_0_b": "\\EK＊ おまえのママ^1　「クリスは\n　 ピアノが　じょうず」って\n　 いってたよな…/",
  "scr_text_slash_scr_text_gml_7786_0": "\nとっても\nおにあい",
  "scr_text_slash_scr_text_gml_7787_0_b": "\nごしゅうしょう\nさま",
  "scr_text_slash_scr_text_gml_7791_0": "\\E9＊ ウフフ^1…　みて　クリス^1。\n　 スージィ^1　よくにあってると\n　 おもわない？/",
  "scr_text_slash_scr_text_gml_7807_0_b": "\nちゃんと\nきこう",
  "scr_text_slash_scr_text_gml_7808_0": "ポケットに\nなにか\nあるかも…",
  "scr_text_slash_scr_text_gml_7812_0": "\\EK＊ (…クリス^1　おまえ^1…\n　 なんか　ヒマつぶせるもん\n　 もってきてねーの？/",
  "scr_text_slash_scr_text_gml_7844_0": "シールを\nいいばしょに\nはる",
  "scr_text_slash_scr_text_gml_7845_0": "シールを\nアウトな\nばしょに　はる",
  "scr_text_slash_scr_text_gml_7849_0": "\\EK＊ …で？/",
  "scr_text_slash_scr_text_gml_7882_0": "ノエル逃げて！\n彼女に血を\n吸われる",
  "scr_text_slash_scr_text_gml_7883_0": "近づいて！\n彼女が血を\n吸う",
  "scr_text_slash_scr_text_gml_7902_0_b": "\nはい",
  "scr_text_slash_scr_text_gml_7903_0": "\nいいえ",
  "scr_text_slash_scr_text_gml_7907_0": "＊ きょうかいに　いってきたのかい？\n　 あのころみたいで\n　 なつかしいねぇ…/",
  "scr_text_slash_scr_text_gml_7908_0_b": "＊ きょうも　いつものにする？\n　 ５ドルだよ。/",
  "scr_text_slash_scr_text_gml_7927_0_b": "＊ それじゃ^1　おすきなせきへ　どうぞ。/%",
  "scr_text_slash_scr_text_gml_7936_0": "＊ おや　おカネが　たりないねぇ。/",
  "scr_text_slash_scr_text_gml_7937_0": "＊ おうちの　どこかに\n　 ５ドルぐらいあるんじゃないかい…？/%",
  "scr_text_slash_scr_text_gml_7944_0": "＊ じゃあ^1　きがかわったら\n　 またおいで。/%",
  "scr_text_slash_scr_text_gml_7950_0": "\nほしい",
  "scr_text_slash_scr_text_gml_7951_0": "いらない\nじぶんで\nたべて",
  "scr_text_slash_scr_text_gml_7955_0": "\\E2＊ パフェ^1　さいごのひとくち\n　 くうか？/",
  "scr_text_slash_scr_text_gml_7969_0": "\\EK＊ …そんな　くいぎみに\n　 こたえられたら^1　たべさして\n　 やらざるをえねーわ。/%",
  "scr_text_slash_scr_text_gml_7975_0": "\\EH＊ そんな　くいぎみに\n　 いわれなくても\n　 オレが　くうわ！/%",
  "scr_text_slash_scr_text_gml_7981_0_b": "なにか\nえを\nかく",
  "scr_text_slash_scr_text_gml_7982_0": "\nなにも\nしない",
  "scr_text_slash_scr_text_gml_7986_0": "\\ED＊ …なに　やってんだ^1？\n　 まどに　いきなんか\n　 ふきかけて…/",
  "scr_text_slash_scr_text_gml_8009_0": "\\E0＊ …/%",
  "scr_text_slash_scr_text_gml_8014_0": "\nそっくり",
  "scr_text_slash_scr_text_gml_8015_0": "\nヘタじゃね？",
  "scr_text_slash_scr_text_gml_8019_0": "\\E2＊ どうよ？/",
  "scr_text_slash_scr_text_gml_8033_0": "\\EQ＊ だろ？^1　オレは\n　 えの　さいのうも\n　 あるからな。/",
  "scr_text_slash_scr_text_gml_8034_0": "\\EL＊ みみも　ちゃんと\n　 かいてやったぜ。/",
  "scr_text_slash_scr_text_gml_8035_0": "\\EK＊ かたっぽだけな。/%",
  "scr_text_slash_scr_text_gml_8041_0": "\\E5＊ みたまんま　かいたら\n　 こうなったんだよ！/%",
  "scr_text_slash_scr_text_gml_8047_0": "スージィの\nにがおえを\nしゃべらせる",
  "scr_text_slash_scr_text_gml_8048_0": "\nなにも\nしない",
  "scr_text_slash_scr_text_gml_8077_0": "\nすみっこに\nなにか　かく",
  "scr_text_slash_scr_text_gml_8078_0": "\nなにも\nしない",
  "scr_text_slash_scr_text_gml_8107_0": "\nはい",
  "scr_text_slash_scr_text_gml_8108_0": "\nいいえ",
  "scr_text_slash_scr_text_gml_8112_0": "＊ (がっこうの　かだいに\n　 とりかかる？)/",
  "scr_text_slash_scr_text_gml_8171_0": "\nつたえる",
  "scr_text_slash_scr_text_gml_8172_0": "\nまだ",
  "scr_text_slash_scr_text_gml_8176_0": "＊ (スージィに\n　 てがかりを　つたえる？)/",
  "scr_text_slash_scr_text_gml_8197_0": "\n…",
  "scr_text_slash_scr_text_gml_8198_0": "\nここで\nきいている",
  "scr_text_slash_scr_text_gml_8202_0": "\\EB＊ え…？　だれが？\n　 だれが　きいてるの？/",
  "scr_text_slash_scr_text_gml_8228_0": "\nイタズラ\nだよ",
  "scr_text_slash_scr_text_gml_8229_0": "あれは\nゆめじゃ\nないから",
  "scr_text_slash_scr_text_gml_8257_0": "ごめん\nイタズラ\nだよ",
  "scr_text_slash_scr_text_gml_8258_0": "\nきこえる",
  "scr_text_slash_scr_text_gml_8286_0": "ごめん\nイタズラ\nだよ",
  "scr_text_slash_scr_text_gml_8287_0": "\nぐうぜんじゃ\nない",
  "scr_text_slash_scr_text_gml_8315_0": "\nあか",
  "scr_text_slash_scr_text_gml_8316_0": "\nあお",
  "scr_text_slash_scr_text_gml_8332_0": "\nみどり",
  "scr_text_slash_scr_text_gml_8333_0": "\nくろ",
  "scr_text_slash_scr_text_gml_8366_0": "\nゆきは\nふった",
  "scr_text_slash_scr_text_gml_8367_0": "\nおきた",
  "scr_text_slash_scr_text_gml_8383_0": "\nノエルは\nつよくなる",
  "scr_text_slash_scr_text_gml_8384_0": "ノエルの\nつよさが\nます",
  "scr_text_slash_scr_text_gml_8400_0": "\nそうび",
  "scr_text_slash_scr_text_gml_8401_0": "\nそうび",
  "scr_text_slash_scr_text_gml_8417_0": "\n前進",
  "scr_text_slash_scr_text_gml_8418_0": "\n前進",
  "scr_text_slash_scr_text_gml_8434_0": "\n前進",
  "scr_text_slash_scr_text_gml_8435_0": "\n前進",
  "scr_text_slash_scr_text_gml_8451_0": "\n前進",
  "scr_text_slash_scr_text_gml_8452_0": "\n前進",
  "scr_text_slash_scr_text_gml_8468_0": "\nそうび",
  "scr_text_slash_scr_text_gml_8469_0": "\nそうび",
  "scr_text_slash_scr_text_gml_8485_0": "\nそうび",
  "scr_text_slash_scr_text_gml_8486_0": "\nそうび",
  "scr_text_slash_scr_text_gml_8502_0": "\nありの\nままで\nいいよ",
  "scr_text_slash_scr_text_gml_8503_0": "\nダメに\n決まってる",
  "scr_text_slash_scr_text_gml_8519_0": "かんがえて\nいることを\nいう",
  "scr_text_slash_scr_text_gml_8520_0": "\nなにも\nいわない",
  "scr_text_slash_scr_text_gml_8536_0": "\nはい",
  "scr_text_slash_scr_text_gml_8537_0": "\nいいえ",
  "scr_text_slash_scr_text_gml_8541_0": "＊ (ノエルの　でんわだ)/",
  "scr_text_slash_scr_text_gml_8542_0_b": "＊ (…つうわあいての　こえがする)/",
  "scr_text_slash_scr_text_gml_8543_0_b": "＊ (はなす？)/",
  "scr_text_slash_scr_text_gml_8553_0": "＊ (バードリーが　ひとりで\n　　しゃべっているこえが\n　　かすかに　きこえる…？)/",
  "scr_text_slash_scr_text_gml_8555_0": "\\E1＊ ああ！^1　チキンとサンタが\n　 てを　くんで　おそってくる\n　 ほど　おそろしい！/",
  "scr_text_slash_scr_text_gml_8556_0": "\\E8＊ スージィが　ノエルを\n　 いためつけている！^1　ボクと\n　 まつりに　いけないように！/",
  "scr_text_slash_scr_text_gml_8557_0": "\\E9＊ スージィ…キミは…/",
  "scr_text_slash_scr_text_gml_8558_0": "\\E0＊ なんという\n　 ヤンデレなんだ！/",
  "scr_text_slash_scr_text_gml_8559_0": "\\E5＊ ドラゴンブレイダーがらの\n　 エチケットぶくろに\n　 はいてしまいそうだよ！/",
  "scr_text_slash_scr_text_gml_8560_0": "\\E0＊ …/",
  "scr_text_slash_scr_text_gml_8561_0": "\\EA＊ …いや^1　おもえば　きっと^1　\n　 スージィは^1　さみしくて\n　 しかたがないんだろう。/",
  "scr_text_slash_scr_text_gml_8562_0": "\\E8＊ ゲームの　うらわざを\n　 おしえてくれるひとも\n　 いない…/",
  "scr_text_slash_scr_text_gml_8563_0": "\\E0＊ …/",
  "scr_text_slash_scr_text_gml_8564_0": "\\E3＊ もしもし？\n　 きこえてるかい？/",
  "scr_text_slash_scr_text_gml_8565_0": "\\EB＊ きぶんは　わるいが^1　\n　 ボクは　いいヤツだから^1　\n　 あえて　いう…/",
  "scr_text_slash_scr_text_gml_8566_0": "\\EM＊ …キミの　あいを^1　\n　 ボクの　つばさに\n　 のせてあげよう。/",
  "scr_text_slash_scr_text_gml_8567_0": "\\EJ＊ キミと…ボクで^1…\n　 まつりに　いこうじゃ\n　 ないか。/%",
  "scr_text_slash_scr_text_gml_8578_0": "\nバードリーと\nいく",
  "scr_text_slash_scr_text_gml_8579_0": "\nまちがいでんわの\nうたを　うたう",
  "scr_text_slash_scr_text_gml_8592_0": "\\EN＊ なっ…クリス！^1？\n　 なぜ　キミが…！？/",
  "scr_text_slash_scr_text_gml_8593_0": "\\E0＊ …/",
  "scr_text_slash_scr_text_gml_8594_0": "\\E5＊ クリス^1。そういってもらえて^1　\n　 しょうじき　ボクは\n　 とても　うれしい。/",
  "scr_text_slash_scr_text_gml_8595_0": "\\EJ＊ とはいえ　ボクの　こころが\n　 ほしければ^1…うばいとって\n　 みたまえ。/",
  "scr_text_slash_scr_text_gml_8596_0": "\\E7＊ まつりのひに…^1　キミと\n　 ノエルと　スージィで^1　\n　 きそいあうことだ…/",
  "scr_text_slash_scr_text_gml_8597_0": "\\EL＊ ボクのこころを　うごかした\n　 ちょうせんしゃと^1　\n　 ボクは　まつりに　いこう。/",
  "scr_text_slash_scr_text_gml_8598_0": "\\E7＊ さいきょうの\n　 くどきじょうずが\n　 しょうりを　つかむ。/",
  "scr_text_slash_scr_text_gml_8599_0": "\\EM＊ がんばりたまえよ。/",
  "scr_text_slash_scr_text_gml_8607_0": "\\EC＊ なっ…クリス！^1？\n　 よ^1…よくも…！！/",
  "scr_text_slash_scr_text_gml_8608_0": "\\EB＊ ボクの　はごたえコリコリで\n　 ジューシーな　こころの\n　 こえを　ぬすみぎきとは…/",
  "scr_text_slash_scr_text_gml_8609_0": "\\ED＊ フン！　いいたいことが\n　 あるなら　いえばいい。/",
  "scr_text_slash_scr_text_gml_8610_0": "\\EF＊ ノエルも　スージィも^1　\n　 バードリー　ヌマに\n　 どっぷり　はまっている。/",
  "scr_text_slash_scr_text_gml_8611_0": "\\E1＊ ゆだんしてるヤツほど\n　 ふかく　はまる…^1　それが\n　 ヌマの　おそろしさだ。/",
  "scr_text_slash_scr_text_gml_8612_0": "\\E7＊ クリス^1。つぎに\n　 バードリーさまに\n　 ヌマるのは^1　キミだ。/",
  "scr_text_slash_scr_text_gml_8616_0_b": "＊ (ピッ…)/%",
  "scr_text_slash_scr_text_gml_8621_0_b": "シェルターに \nはいる\nほうほう",
  "scr_text_slash_scr_text_gml_8622_0": "きょうの\nせっぽう\nゲキアツ",
  "scr_text_slash_scr_text_gml_8623_0": "アズゴア",
  "scr_text_slash_scr_text_gml_8637_0": "＊ …？^1　クリス…^1　ちかごろの　きみに\n　 なにが　おきているのか^1　わたしは\n　 しるよしもありません…　でも…/",
  "scr_text_slash_scr_text_gml_8638_0": "＊ …どうか　てんしさまの　みちびきに\n　 したがってください。わたしも\n　 きみのために　いのります。/%",
  "scr_text_slash_scr_text_gml_8642_0": "＊ クリス…　シェルターに\n　 ちかづいてはいけない。/%",
  "scr_text_slash_scr_text_gml_8653_0_b": "＊ ありがとう^1。きみが　とちゅうで\n　 いねむりしてしまったのは\n　 みえていましたよ^1。ははは。/",
  "scr_text_slash_scr_text_gml_8654_0": "＊ わたしの　せっぽうには^1 \n　 どうも　“はな”が　なくてね。/",
  "scr_text_slash_scr_text_gml_8655_0_b": "＊ だから　もう^1　じぶんの　ことばで\n　 かくことはしない^1…\n　 せっぽうに　かぎらずね…/",
  "scr_text_slash_scr_text_gml_8656_0": "＊ いだいな　さっかの　むすこなのに\n　 なさけない^1。ちちは　さぞ\n　 がっかりしていることでしょう。/%",
  "scr_text_slash_scr_text_gml_8660_0": "＊ クリス^1　すいみんは　だいじです^1。\n　 わたしの　せっぽうが\n　 こもりうたに　なったとしてもね。/",
  "scr_text_slash_scr_text_gml_8661_0": "＊ なに^1　きょうは\n　 「きゅうそくの　ひ」^1。ゆっくり\n　 やすむに　こしたことはありません。/%",
  "scr_text_slash_scr_text_gml_8672_0_b": "＊ きみの　おとうさんは^1 \n　 いつも　よるに\n　 れいはいに　きますよ。/",
  "scr_text_slash_scr_text_gml_8673_0": "＊ きみのために　いのって^1…　それから\n　 アズリエル^1…トリエル^1…ルーディ…\n　 そだてているはなたちの　ためにも。/",
  "scr_text_slash_scr_text_gml_8674_0": "＊ きみも　おかあさんと　いっしょに^1　\n　 おとうさんのために　いのると\n　 よいでしょう。/%",
  "scr_text_slash_scr_text_gml_8678_0": "＊ てんしさまは^1　かれに\n　 けわしいみちを　ごよういされた\n　 ようですね^1。きのどくに…/%",
  "scr_text_slash_scr_text_gml_8685_0": "\nシェルター",
  "scr_text_slash_scr_text_gml_8686_0": "\nスージィは\nかいならせない",
  "scr_text_slash_scr_text_gml_8690_0": "＊ オッス…！^1　きょうかいで\n　 オマエに　あうとか　マジかよ^1…\n　 しかも^1…スージィと　いっしょって。/",
  "scr_text_slash_scr_text_gml_8695_0": "＊ このまえ^1　シェルターの　まえで\n　 あったとき^1…　アレは\n　 ヒドかったな…^1　ハハッ。/",
  "scr_text_slash_scr_text_gml_8699_0": "＊ スージィのこと^1…\n　 うまく　かいならしてるみたいで\n　 なによりだぜ…^1　ハハ…ハ…/",
  "scr_text_slash_scr_text_gml_8715_0_b": "＊ な…なんだよ？^1　「ヘタレ」\n　 っつったこと^1　おこってんのか^1？\n　 ライちゃんの　ジョーダンだよ！/",
  "scr_text_slash_scr_text_gml_8716_0": "＊ オマエが　ヘタレじゃないのは\n　 わかってるからさ^1…\n　 もう　わすれてくれよ^1…な？/%",
  "scr_text_slash_scr_text_gml_8722_0": "＊ は？^1　…てか^1　これも\n　 スージィに　きいてこいって\n　 いわれてんだろ？/",
  "scr_text_slash_scr_text_gml_8723_0": "＊ クリス^1　イヤなときは\n　 イヤだっていえよな^1　ハハハ^1…\n　 オレも　めいわくだよ…/%",
  "scr_text_slash_scr_text_gml_8732_0": "＊ お^1…おう^1。なんでもいいよ^1。アイツが\n　 オレらを　ボコらないように\n　 してくれればさ…^1　ハハ…ハ…/",
  "scr_text_slash_scr_text_gml_8733_0": "＊ …なんだよ？/%",
  "scr_text_slash_scr_text_gml_8739_0_b": "\nシェルター",
  "scr_text_slash_scr_text_gml_8740_0_b": "\nわらう",
  "scr_text_slash_scr_text_gml_8741_0": "わらわない",
  "scr_text_slash_scr_text_gml_8744_0_b": "＊ クリス^1！　 いつ　きょうかいに\n　 きたんや？^1　なあ？/",
  "scr_text_slash_scr_text_gml_8745_0": "＊ …「きょう」かい^1？\n　 きょう^1　きたんかい^1？\n　 きょうかいに！　アハハハ！/",
  "scr_text_slash_scr_text_gml_8754_0": "＊ シェルター？　しりまへんなぁ\n　 なんか　いいましター^1？\n　 …なんや。/%",
  "scr_text_slash_scr_text_gml_8760_0": "＊ ハハッ^1！　おもろいやろ^1？\n　 クリスはん^1　ワテら　もっと\n　 ツルまんと　あきまへんわ！/%",
  "scr_text_slash_scr_text_gml_8768_0": "＊ は？　おもんない！？\n　 ニンゲンて　おわらいのセンス\n　 ないんちゃいますの？/%",
  "scr_text_slash_scr_text_gml_8774_0_b": "\nジュースを\nわたす",
  "scr_text_slash_scr_text_gml_8775_0": "めのまえで\nジュースを\nのみほす",
  "scr_text_slash_scr_text_gml_8779_0": "\\E9＊ (ノドが　カラカラだよぉ…)/",
  "scr_text_slash_scr_text_gml_8780_0": "\\E3＊ …クリス？^1　それって\n　 まさか…^1　わたしの\n　 さいきょうミックス…？/",
  "scr_text_slash_scr_text_gml_8793_0_b": "\nシェルター",
  "scr_text_slash_scr_text_gml_8794_0_b": "\nない！",
  "scr_text_slash_scr_text_gml_8797_0": "アンダイン",
  "scr_text_slash_scr_text_gml_8805_0_b": "\\E9＊ え…えと…^1　せんせいに\n　 なにか　ききたいことが\n　 ありますか？/",
  "scr_text_slash_scr_text_gml_8826_0": "けんちくの\nれきしの\nべんきょう",
  "scr_text_slash_scr_text_gml_8827_0": "スージィの\nあたらしい　いえに\nほしくさを　しく",
  "scr_text_slash_scr_text_gml_8831_0": "\\E3＊ シェルター？\n　 どうして　そんなところに\n　 はいりたいの…？/",
  "scr_text_slash_scr_text_gml_8844_0": "\\E2＊ そ…それは　とっても^1…\n　 よそうの　うえをいく\n　 こたえですね！/",
  "scr_text_slash_scr_text_gml_8852_0": "\\E1＊ ほしくさ^1…\n　 それじゃ　まるで\n　 スージィが　ウマみたい…/",
  "scr_text_slash_scr_text_gml_8853_0": "\\E3＊ …そんなことしたら\n　 スージィは　ほしくさを\n　 たべちゃうんじゃ…？？/",
  "scr_text_slash_scr_text_gml_8854_0_b": "\\E1＊ (…これいじょう\n　 ふかく　かんがえるのは\n　 やめよう…)/",
  "scr_text_slash_scr_text_gml_8857_0": "\\E9＊ …なんにせよ^1 \n　 シェルターに　いくのは\n　 やめたほうが…/",
  "scr_text_slash_scr_text_gml_8858_0": "\\E4＊ …ひとりで　いくのは\n　 やめたほうが　いいと\n　 せんせいは　おもいます。/",
  "scr_text_slash_scr_text_gml_8859_0": "\\E2＊ だって　あそこは…/",
  "scr_text_slash_scr_text_gml_8860_0": "\\E9＊ ひじょうじたいの　ときに\n　 みんなが　あんぜんに\n　 すごすための　ばしょで…/",
  "scr_text_slash_scr_text_gml_8861_0": "\\E4＊ だけど^1　せんせいが　\n　 ひっこしてきてから\n　 ずっと^1　へいさされてて…/",
  "scr_text_slash_scr_text_gml_8862_0_b": "\\E8＊ なんていうか^1…\n　 もし^1　ひじょうじたいが\n　 おきても…/",
  "scr_text_slash_scr_text_gml_8863_0": "\\E9＊ あの　なかに　あるもの…/",
  "scr_text_slash_scr_text_gml_8864_0_b": "\\E8＊ …そっちの　ほうが\n　 こわかったりして…？/",
  "scr_text_slash_scr_text_gml_8865_0": "\\E4＊ エヘヘヘヘ^1…\n　 なーんて^1。せんせいの\n　 もうそうですけどね。/",
  "scr_text_slash_scr_text_gml_8866_0": "\\E0＊ とにかく^1　せんせいが\n　 みたなかで^1　あのちかくへ\n　 ときどき　いくのは…/",
  "scr_text_slash_scr_text_gml_8867_0_b": "\\E1＊ …アンダインしょちょうと^1 \n　 ちょうちょうさんだけ。/",
  "scr_text_slash_scr_text_gml_8868_0": "\\E5＊ だから^1　ちょうちょうさんか\n　 アンダインしょちょうに\n　 つきそいを　たのめば…/",
  "scr_text_slash_scr_text_gml_8869_0": "\\E0＊ てつだってもらえるんじゃ\n　 ないかとおもいますよ。/",
  "scr_text_slash_scr_text_gml_8870_0": "\\E7＊ …/",
  "scr_text_slash_scr_text_gml_8871_0": "\\EB＊ ち^1…ちなみに^1…\n　 アンダインしょちょうに\n　 たのむ　ついでに…/",
  "scr_text_slash_scr_text_gml_8872_0": "\\E4＊ でんわか　メッセで\n　 れんらくしてほしいって\n　 つたえてもらえると…/",
  "scr_text_slash_scr_text_gml_8873_0": "\\E9＊ そ…それか^1　せんせいのこと\n　 キライなのか…\n　 さぐってもらえると…/",
  "scr_text_slash_scr_text_gml_8874_0": "\\E9＊ とっても　たすかります^1！\n　 エヘ^1…エヘヘヘヘ^1…\n　 なんていうか…/",
  "scr_text_slash_scr_text_gml_8875_0": "\\E4＊ …ぜんぜん^1…\n　 へんじが　こなくて。/%",
  "scr_text_slash_scr_text_gml_8880_0_b": "でも\nチョコ\nくれたよ？",
  "scr_text_slash_scr_text_gml_8881_0": "ごめん\nなさい",
  "scr_text_slash_scr_text_gml_8885_0": "\\E9＊ …かんがえすぎかも\n　 しれないけど^1…\n　 ひょっとしたら…/",
  "scr_text_slash_scr_text_gml_8898_0": "\\E7＊ た^1…たしかに^1…\n　 そうですよね！/",
  "scr_text_slash_scr_text_gml_8899_0": "\\E4＊ …だけど^1　あのチョコ\n　 すごく　ふるくて^1…\n　 たべてみたら…/",
  "scr_text_slash_scr_text_gml_8900_0": "\\E9＊ …せんせい^1　いしきを\n　 うしなって^1　ひとばん\n　 ねむった　ままでした…/",
  "scr_text_slash_scr_text_gml_8901_0_b": "\\E5＊ …もしかしたら^1…\n　 どくいりチョコ\n　 だったのかも…？/%",
  "scr_text_slash_scr_text_gml_8909_0": "\\E3＊ え？^1　どういうイミ…？/",
  "scr_text_slash_scr_text_gml_8910_0": "\\E1＊ …あ。/",
  "scr_text_slash_scr_text_gml_8911_0": "\\EA＊ そういえば　まえにもらった\n　 チョコ^1…だれかが　ひとつ\n　 たべたみたいでした…/",
  "scr_text_slash_scr_text_gml_8912_0": "\\E7＊ きにしないで^1！\n　 とどけてくれた　おれいって\n　 ことで　いいですよ！/%",
  "scr_text_slash_scr_text_gml_8925_0": "\nあかを\n25％たす",
  "scr_text_slash_scr_text_gml_8926_0": "\nきいろを\n25％たす",
  "scr_text_slash_scr_text_gml_8929_0": "グラスを　からにする",
  "scr_text_slash_scr_text_gml_8936_0": "＊ (グラスの　なかみは\n　 あか\\cR~1％\\cW　\\cYきいろ~2％\\cWだ)",
  "scr_text_slash_scr_text_gml_8959_0_b": "＊ (ジュースを　しんちょうに\n　 グラスに　ちゅうにゅうした)/%",
  "scr_text_slash_scr_text_gml_8975_0": "＊ (ジュースは　すでに100％^1…\n　 パワーの　げんかいだ)/%",
  "scr_text_slash_scr_text_gml_8991_0": "＊ (ジュースを　スージィじゅんかんに\n　 もどした)/%",
  "scr_text_slash_scr_text_gml_8997_0": "\nアズゴア",
  "scr_text_slash_scr_text_gml_8998_0": "\nあんごう",
  "scr_text_slash_scr_text_gml_8999_0": "ノエル",
  "scr_text_slash_scr_text_gml_9002_0": "\\E7＊ やあ　“クリス”マス^1！\n　 ゆきあなに　こもるのは\n　 きょうは　やめたのかい？/",
  "scr_text_slash_scr_text_gml_9024_0": "\\E3＊ アノけんも　ソノけんも\n　 コノけんも…/",
  "scr_text_slash_scr_text_gml_9025_0": "\\E2＊ ウチが　ちゃんと　せわする！\n　 あんしんして！！\\f0/%",
  "scr_text_slash_scr_text_gml_9044_0": "\nうた\nうまいね",
  "scr_text_slash_scr_text_gml_9045_0": "\nあんごう",
  "scr_text_slash_scr_text_gml_9046_0": "あかない　とびら",
  "scr_text_slash_scr_text_gml_9049_0": "\\E0＊ クリス！^1　アズリエルが\n　 いないのに　きたんだね^1？\n　 ちょっと　いがいかも。/",
  "scr_text_slash_scr_text_gml_9076_0": "\nとる",
  "scr_text_slash_scr_text_gml_9077_0": "\nとらない",
  "scr_text_slash_scr_text_gml_9081_0": "＊ (あかいギターだ)/",
  "scr_text_slash_scr_text_gml_9082_0": "＊ (…？)/",
  "scr_text_slash_scr_text_gml_9083_0_b": "＊ (うちがわに　あんごう\n　 らしきものが　はってある)/",
  "scr_text_slash_scr_text_gml_9084_0": "＊ (「シェルター」という\n　 もじが　みえる)/",
  "scr_text_slash_scr_text_gml_9103_0": "\n「おきに\nいり」",
  "scr_text_slash_scr_text_gml_9104_0": "\nキャット・\nナデラー４",
  "scr_text_slash_scr_text_gml_9105_0_b": "クリックしない",
  "scr_text_slash_scr_text_gml_9108_0": "\\EL＊ (よし^1…いまのうちに\n　 パソコン　ハッキングして\n　 てがかりさがすぞ！)/",
  "scr_text_slash_scr_text_gml_9121_0": "\\EL＊ (うし^1…　ニンジャスタイルで\n　 いくぜ。\n　 そーっと　クリックしろ)/",
  "scr_text_slash_scr_text_gml_9122_0": "\\E0＊ (「おきにいり」は^1…\n　 パラノーマル…^1　はんざい^1…\n　 パラナチュラル…)/",
  "scr_text_slash_scr_text_gml_9123_0": "\\E7＊ お^1！　スケボーゲームが\n　 あるぜ！^1　っしゃあぁ！！/",
  "scr_text_slash_scr_text_gml_9125_0": "\\EF＊ …ちょ^1…ふたりとも\n　 なにしてるの！？/",
  "scr_text_slash_scr_text_gml_9127_0": "\\EG＊ $?!$！^1　べつに^1。なんも^1。\n　 ノエルのパソコン\n　 アップグレードしてる。/",
  "scr_text_slash_scr_text_gml_9129_0": "＊ (ブラウザのホームを\n　 スケボーゲームに　せっていした)/%",
  "scr_text_slash_scr_text_gml_9135_0": "\\EA＊ うっし^1。ビュンビュンに\n　 はやくなったな。\\f0/%",
  "scr_text_slash_scr_text_gml_9149_0": "\\E9＊ 「キャット・ナデラー」？\n　 なんで　こんなの\n　 やってんだよ？/",
  "scr_text_slash_scr_text_gml_9151_0": "\\E8＊ ひどい！^1　このゲーム\n　 めいさくだよ！^1　ペットの\n　 いくせいゲームだけど…/",
  "scr_text_slash_scr_text_gml_9152_0": "\\E3＊ …バグがあって^1　\n　 ヘンなペットを\n　 かえちゃうの。/",
  "scr_text_slash_scr_text_gml_9153_0": "\\E4＊ あたまがないネコ\n　 ７ひき　ゲットした\n　 セーブファイルも　あるよ。/",
  "scr_text_slash_scr_text_gml_9155_0": "\\E7＊ マジ！？^1　みして　みして！\\f0/%",
  "scr_text_slash_scr_text_gml_9159_0": "\\E7＊ ネコに　ピストル\n　 もたせらんねーの？/",
  "scr_text_slash_scr_text_gml_9161_0": "\\E8＊ ふははは^1！　ゴメン！\n　 そのMODはアンインストール\n　 しちゃった…/%",
  "scr_text_slash_scr_text_gml_9170_0": "\\EH＊ (フゥ^1…　あぶなかったぁ…)/",
  "scr_text_slash_scr_text_gml_9172_0": "\\EB＊ パソコンのかべがみ^1…\n　 なになに？^1　「らっ…きー\n　 すたぁ…」\\f0/%",
  "scr_text_slash_scr_text_gml_9178_0": "\nひく",
  "scr_text_slash_scr_text_gml_9179_0": "\nひかない",
  "scr_text_slash_scr_text_gml_9183_0": "＊ (ピアノを　ひく？)/",
  "scr_text_slash_scr_text_gml_9203_0_b": "\nむかしの\nかぞくしゃしん",
  "scr_text_slash_scr_text_gml_9204_0": "\nアズリエルの\nしゃしん",
  "scr_text_slash_scr_text_gml_9205_0": "どちらも　みせない",
  "scr_text_slash_scr_text_gml_9208_0": "＊ (れいぞうこに　しゃしんが\n　 たくさん　はってある)/",
  "scr_text_slash_scr_text_gml_9220_0_b": "\\EA＊ ヘヘッ^1　なんで　おまえ^1 \n　 あたまに　ツノつけてんの？/",
  "scr_text_slash_scr_text_gml_9221_0_b": "\\E9＊ さては　おまえも…/",
  "scr_text_slash_scr_text_gml_9222_0_b": "\\E6＊ …/",
  "scr_text_slash_scr_text_gml_9223_0": "\\EN＊ …ヘッ。/%",
  "scr_text_slash_scr_text_gml_9227_0": "\\E0＊ …クリス^1。ママには\n　 やさしくしろよ。/",
  "scr_text_slash_scr_text_gml_9228_0": "\\E1＊ ガチで^1。おまえ^1　\n　 トリエルさん　なかしたら\n　 かくごしとけよ？/%",
  "scr_text_slash_scr_text_gml_9239_0": "\\E9＊ ガハハ^1！　ラルセイじゃん！\n　 フォトショで　かこうした\n　 のか？　なんで…/",
  "scr_text_slash_scr_text_gml_9240_0": "\\E6＊ …は？^1　これ^1　おまえの\n　 アニキなの？/",
  "scr_text_slash_scr_text_gml_9241_0": "\\EK＊ …まあ^1　たしかに^1　\n　 いわれてみれば\n　 べつじんだな。/",
  "scr_text_slash_scr_text_gml_9242_0": "\\E5＊ だから　わーったって^1！\n　 そうだな！　そこも　ここも\n　 ちげーよな！/%",
  "scr_text_slash_scr_text_gml_9246_0": "\\E1＊ アズリエルだろーが\n　 ラルセイだろーが\n　 どーでもいいぜ。/",
  "scr_text_slash_scr_text_gml_9247_0": "\\E2＊ バニラヤロウも\n　 ストロベリーヤロウも^1 \n　 オレが　ブッつぶす！/%",
  "scr_text_slash_scr_text_gml_9254_0_b": "\\EB＊ なんで　れいぞうこに\n　 だきついてんだよ^1…\n　 れいぞうこヲタか？/%",
  "scr_text_slash_scr_text_gml_9260_0": "けいかくに\nついて\nはなす",
  "scr_text_slash_scr_text_gml_9261_0": "\nいそいで\nはなれる",
  "scr_text_slash_scr_text_gml_9268_0_b": "\\E3＊ クリスと　スージィが\n　 としょかんにィ！？\n　 しかも　しゅうまつにィ！？/",
  "scr_text_slash_scr_text_gml_9271_0": "\\E1＊ クリスとスージィ…^1　ボクが\n　 いちばん^1　しゃべりたくなく\n　 ない　２人だ。/",
  "scr_text_slash_scr_text_gml_9286_0": "\\E3＊ な^1　ん^1　だ^1　と^1　！？\n　 ノエルは！　きょう！\n　 よていが！　あるんだぞ！！/",
  "scr_text_slash_scr_text_gml_9287_0_b": "\\E2＊ ということは^1…\n　 …おお　べんきょうの\n　 めがみよ^1　おたすけを！/",
  "scr_text_slash_scr_text_gml_9288_0": "\\E3＊ ボクたち　“３にん”で\n　 グループを　くまなきゃ\n　 いけないなんて！！/",
  "scr_text_slash_scr_text_gml_9290_0": "\\EK＊ オレらのこと　きにくわねぇ\n　 んだろ？^1　おまえには\n　 かかわらねぇよ。/",
  "scr_text_slash_scr_text_gml_9292_0": "\\EE＊ /",
  "scr_text_slash_scr_text_gml_9293_0": "\\EN＊ かかわらない？/",
  "scr_text_slash_scr_text_gml_9295_0": "\\ED＊ ああ^1。オレらに\n　 かまってほしく\n　 ねぇんだろ？/",
  "scr_text_slash_scr_text_gml_9297_0": "\\E6＊ ハハーッ！^1　そう^1！\n　 だれにも　かまわれない^1！\n　 オールウェイズ　ボッチ！/",
  "scr_text_slash_scr_text_gml_9298_0": "\\E5＊ てんさいというのは\n　 いつだって^1　えんりょの\n　 カタマリに　なるものさ。/",
  "scr_text_slash_scr_text_gml_9299_0": "\\EO＊ うーん　コドクとは\n　 ジツに　ビミなるものだ。/%",
  "scr_text_slash_scr_text_gml_9303_0_b": "\\E6＊ よかった！^1　まだ\n　 はなしたいようだね…^1　\n　 ボクは　はなしたくないが！/",
  "scr_text_slash_scr_text_gml_9305_0": "\\E0＊ オレらに　かまうなって。/",
  "scr_text_slash_scr_text_gml_9307_0": "\\E8＊ (スージィ…キミは　どうして\n　 そんなに　ツンデレで\n　 めんどくさいんだい？)/%",
  "scr_text_slash_scr_text_gml_9314_0": "\\EJ＊ どんなに　いそいでも^1 \n　 ボクの　タイムアタックの\n　 きろくは　やぶれないよ。/%",
  "scr_text_slash_scr_text_gml_9320_0": "\nあした",
  "scr_text_slash_scr_text_gml_9321_0": "\nスージィ",
  "scr_text_slash_scr_text_gml_9322_0_b": "さよなら",
  "scr_text_slash_scr_text_gml_9333_0": "\\E4＊ …ききたいことが\n　 あるのかな？/",
  "scr_text_slash_scr_text_gml_9337_0_b": "\\E5＊ クリス…^1　ハハ^1…ハ^1…\n　 きょうの　れいはいは\n　 ながかったねえ…/",
  "scr_text_slash_scr_text_gml_9338_0_b": "\\E5＊ おじさんに\n　 ききたいことでも\n　 あるのかな？/",
  "scr_text_slash_scr_text_gml_9359_0": "\nあたためる\n",
  "scr_text_slash_scr_text_gml_9360_0": "\nほうっておく",
  "scr_text_slash_scr_text_gml_9364_0": "＊ (ゆっくりと　いきをしている)\n＊ (きのせいかも　しれないが^1　\n　 なんだか　さむそうだ…)/",
  "scr_text_slash_scr_text_gml_9383_0": "\nキャッティの\nはなし",
  "scr_text_slash_scr_text_gml_9384_0": "\nあおいウサギを\nぬすみぎきする",
  "scr_text_slash_scr_text_gml_9385_0": "さよなら",
  "scr_text_slash_scr_text_gml_9388_0": "\\E0＊ やっだ　クリリぃ^1～\n　 ランチ　おごって\n　 くれるのぉ？/",
  "scr_text_slash_scr_text_gml_9402_0": "\\E6＊ はぁ～？　あのネコのコ？\n　 アタシのこと　すきすぎて\n　 キモいんですけどぉ～。/",
  "scr_text_slash_scr_text_gml_9403_0": "\\E3＊ けさなんて～　おんなじ\n　 「ほんじつの　 ひがわり」\n　 メニュー　たのんじゃって。/",
  "scr_text_slash_scr_text_gml_9404_0": "\\E6＊ だから　シェアしてぇ^1～\n　 おしゃべりしてぇ^1～\n　 めっちゃ　わらってぇ～！/",
  "scr_text_slash_scr_text_gml_9405_0": "\\E3＊ しかも^1　アタシのぶんまで\n　 おカネはらってくれてぇ～！\n　 なにサマの　つもりぃ？/",
  "scr_text_slash_scr_text_gml_9406_0": "\\E0＊ で^1　そんな　しんせつに\n　 されると　シャクだから^1 \n　 ここで　まってるわけ。/",
  "scr_text_slash_scr_text_gml_9407_0": "\\E6＊ ひょっとしたら　くるかも\n　 じゃん？^1　そしたら\n　 おカネ　かえせるじゃん？/",
  "scr_text_slash_scr_text_gml_9408_0": "\\E4＊ てか^1　アタシのメイク\n　 おかしくない^1？\n　 だいじょうぶそ？/",
  "scr_text_slash_scr_text_gml_9409_0": "\\E0＊ だって　アタシ^1　\n　 あのネコのコより　かわいく\n　 ないと　ダメじゃん？/",
  "scr_text_slash_scr_text_gml_9410_0": "\\E6＊ マジ^1　あのコ\n　 アタシのこと\n　 すきすぎなんですけど～！/%",
  "scr_text_slash_scr_text_gml_9416_0": "\\E3＊ は？^1　あのコ^1　じめんに\n　 おいた　おさらから\n　 ミルクのんでたの？/",
  "scr_text_slash_scr_text_gml_9417_0": "\\E0＊ いってやりなよ^1。\n　 ミルクなら　このみせでも\n　 のめるからって。/",
  "scr_text_slash_scr_text_gml_9418_0": "\\E4＊ チョ～イジワルな\n　 ドッキリ！/%",
  "scr_text_slash_scr_text_gml_9422_0": "\\E0＊ てかさ^1　マジで　あのコ^1　\n　 どこにいんの？/",
  "scr_text_slash_scr_text_gml_9423_0": "\\E3＊ アタシの　マネする\n　 ぐらいしか　やること\n　 ないクセに。/",
  "scr_text_slash_scr_text_gml_9424_0": "\\E6＊ でしょ？^1　やることない\n　 でしょ！？^1　あったらアタシ\n　 キレるから！/%",
  "scr_text_slash_scr_text_gml_9436_0": "＊ あのぉ～^1　これ^1　まだつづけないと\n　 ダメですか^1？\n　 っていうか　これってホントに…/",
  "scr_text_slash_scr_text_gml_9438_0": "\\E4＊ やれば　しゃかいに\n　 こうけんできるよ。/",
  "scr_text_slash_scr_text_gml_9439_0": "\\E6＊ アイツ^1　アタシとかのこと\n　 いっつも　ヤラしいめで\n　 みてたじゃん？/",
  "scr_text_slash_scr_text_gml_9440_0": "\\E3＊ でも^1　これで　jpegがぞうを\n　 ヤラしいめで　みるだけの\n　 おりこうボーイじゃん？/",
  "scr_text_slash_scr_text_gml_9441_0": "\\E0＊ みんなハッピーじゃん^1！\n　 とくに　ウチらがね。\n　 おもろいから。/",
  "scr_text_slash_scr_text_gml_9443_0": "＊ う…うん^1…そういわれれば^1…\n　 わるいことではないと　おもうけど^1…\n　 かれも　ハッピーならね…/%",
  "scr_text_slash_scr_text_gml_9447_0": "＊ (だれかに\n　 テキストメッセージを\n　 おくっている)/%",
  "scr_text_slash_scr_text_gml_9454_0": "\\E4＊ ケ～ッ！^1　アズにゃん\n　 だったら　ぜったい\n　 おごってくれたし～。/%",
  "scr_text_slash_scr_text_gml_9460_0": "\nはい",
  "scr_text_slash_scr_text_gml_9461_0": "\nいいえ",
  "scr_text_slash_scr_text_gml_9465_0_b": "\\E0＊ …クリス^1…せんせい\n　 まえに　はなしたこと\n　 ありましたっけ…？/",
  "scr_text_slash_scr_text_gml_9466_0_b": "\\E7＊ せんせい　ときどき^1…\n　 そとに　ミルクを\n　 おいておくんです…/",
  "scr_text_slash_scr_text_gml_9467_0_b": "\\E4＊ …ろじうら…に。/",
  "scr_text_slash_scr_text_gml_9468_0": "\\E9＊ …/",
  "scr_text_slash_scr_text_gml_9469_0": "\\E4＊ えと^1…もういちど\n　 さいしょから　せつめい\n　 しても　いいですか？/",
  "scr_text_slash_scr_text_gml_9483_0": "\\E7＊ …まず^1…\n　 ミュウミュウっていう\n　 なまえの　ネコがいて…/",
  "scr_text_slash_scr_text_gml_9484_0": "\\E9＊ その^1…じつざいする\n　 しょうこは^1　なんにも\n　 ないんですけど…/",
  "scr_text_slash_scr_text_gml_9485_0": "\\E4＊ …ごめんなさい\n　 やっぱり　なんでもないです。/%",
  "scr_text_slash_scr_text_gml_9491_0": "\\E1＊ …/",
  "scr_text_slash_scr_text_gml_9492_0": "\\E9＊ このことは　おたがい\n　 わすれましょう。/%",
  "scr_text_slash_scr_text_gml_9498_0": "\nスージィ",
  "scr_text_slash_scr_text_gml_9499_0": "\nちちおやと\nははおや",
  "scr_text_slash_scr_text_gml_9500_0": "さよなら",
  "scr_text_slash_scr_text_gml_9507_0": "\\E5＊ …クリス^1…\n　 いまわしきケモノと\n　 あゆんでいる…？/",
  "scr_text_slash_scr_text_gml_9508_0": "\\E6＊ きをつけろ。つなを\n　 つかんでいるのは\n　 じぶんと　おもっていても…/",
  "scr_text_slash_scr_text_gml_9509_0": "\\E1＊ じっさいは　そのケモノに\n　 さそいこまれている。\n　 やみの　なかへ。/",
  "scr_text_slash_scr_text_gml_9511_0_b": "\\EK＊ (ヘッ^1…　まあ\n　 まちがっては　いねぇな)/",
  "scr_text_slash_scr_text_gml_9515_0": "\\E0＊ いまわしき　ケモノと^1…\n　 ケモノに　つれられた\n　 クリス^1。なにか　よう？/",
  "scr_text_slash_scr_text_gml_9540_0_b": "\\E1＊ クリスは　もう　ておくれ。\n　 その　けがれを　きよめる\n　 ことは　できない。/",
  "scr_text_slash_scr_text_gml_9541_0_b": "\\E0＊ やくそくして^1。\n　 ひかりには\n　 ちかづかないと。/",
  "scr_text_slash_scr_text_gml_9542_0": "\\E3＊ スージィを\n　 ちかづけないと^1。\n　 ノエルに。/",
  "scr_text_slash_scr_text_gml_9544_0": "\\EK＊ おい^1。オレのこと\n　 きにいらねぇなら　かってに\n　 すりゃ　いいけどよ…/",
  "scr_text_slash_scr_text_gml_9545_0": "\\E0＊ ノエルが　だれと\n　 ツルもうが　ノエルの\n　 かってだろ。/",
  "scr_text_slash_scr_text_gml_9546_0_b": "\\EA＊ ノエルを　“まもる”なら^1　\n　 きょうかいに　こなかった\n　 のは　しっぱいだったな。/",
  "scr_text_slash_scr_text_gml_9548_0": "\\E5＊ …え？/",
  "scr_text_slash_scr_text_gml_9550_0": "\\E4＊ オレたち^1　ノエルんちに\n　 よばれてんだ。\n　 あきらめな。/",
  "scr_text_slash_scr_text_gml_9552_0": "\\E5＊ …/",
  "scr_text_slash_scr_text_gml_9553_0": "\\E6＊ クリス^1。わたしたちは\n　 そえんだった。\n　 さいきんは　ずっと。/",
  "scr_text_slash_scr_text_gml_9554_0": "\\E7＊ でも　まさか。おたがい\n　 てき　しゅぞく　どうしに。\n　 なるなんて。/",
  "scr_text_slash_scr_text_gml_9555_0": "\\E6＊ はなしかけないで。にどと。\n　 さらば。/%",
  "scr_text_slash_scr_text_gml_9561_0": "\\E1＊ …クリス。/",
  "scr_text_slash_scr_text_gml_9562_0": "\\E0＊ どちらが　いいか\n　 きめられない。/",
  "scr_text_slash_scr_text_gml_9563_0": "\\E0＊ ちちおやと　ははおやを\n　 たすけるには…/",
  "scr_text_slash_scr_text_gml_9564_0": "\\E1＊ くうちゅうふゆうの\n　 じゅもん…^1？　それとも\n　 いけにえの　じゅもんで…/",
  "scr_text_slash_scr_text_gml_9565_0": "\\E2＊ この　きを　やきつくす？/",
  "scr_text_slash_scr_text_gml_9566_0": "\\E0＊ …/",
  "scr_text_slash_scr_text_gml_9567_0": "\\E1＊ りょうほう　ためしてから^1…\n　 もっと　たかい　きゃたつも\n　 ためしてみるかも。/%",
  "scr_text_slash_scr_text_gml_9573_0": "\\E4＊ クリスは^1…りかいしていない。\n　 じぶんが　てを　そめている\n　 ちからの　しょうたいを。/%",
  "scr_text_slash_scr_text_gml_9595_0": "\nよむ",
  "scr_text_slash_scr_text_gml_9596_0": "\nよまない",
  "scr_text_slash_scr_text_gml_9600_0": "＊ (モンスターの　おそうしきに\n　 ついての　ほんだ。よむ？)/",
  "scr_text_slash_scr_text_gml_9608_0": "＊ …モンスターの　からだが　ちりに\n　 なると^1　せいぜん　あいようしていた\n　 ものに　それを　ふりかける。/",
  "scr_text_slash_scr_text_gml_9609_0": "＊ そのひとを　しょうちょうする\n　 ものに　ちりを　ふりかけ\n　 それを　まいそうすることで…/",
  "scr_text_slash_scr_text_gml_9610_0": "＊ ししゃの　タマシイは　そのものに\n　 やどり^1　つちの　なかで\n　 やすらかに　ねむる。/",
  "scr_text_slash_scr_text_gml_9611_0": "＊ …もちろん　それは　じょうしき。\n　 ゆえに　こうして　じょぶんに\n　 しるしている。/%",
  "scr_text_slash_scr_text_gml_9623_0": "\nつづきをきく",
  "scr_text_slash_scr_text_gml_9624_0": "\nきかない",
  "scr_text_slash_scr_text_gml_9628_0": "\\E1＊ よう^1！　もうすぐデートの\n　 じかんだ！\n　 じゅんびバンタンだぜ！/",
  "scr_text_slash_scr_text_gml_9641_0": "\\E5＊ 10ドルの　はなたば…\n　 ハートがたの　ピザ…\n　 そして　さいしゅうへいき…/",
  "scr_text_slash_scr_text_gml_9642_0_b": "\\E3＊ がっこうのダンスパーティに\n　 きていった　ガムテープの\n　 スーツも　よういした。/",
  "scr_text_slash_scr_text_gml_9643_0": "\\E8＊ さいしょのデートにしちゃ\n　 やりすぎかもな。/",
  "scr_text_slash_scr_text_gml_9644_0": "\\EC＊ でも^1　ピザリナには^1…オレの\n　 ほんきを　みてほしいんだ！\n　 かのじょを　あいしてる！/",
  "scr_text_slash_scr_text_gml_9645_0": "\\E6＊ かのじょは　ちょっと\n　 じかんに　おくれては\n　 いるが…/",
  "scr_text_slash_scr_text_gml_9646_0": "\\EA＊ みてくれ！^1　いま　こんな\n　 クソコラを　おくってきた！/",
  "scr_text_slash_scr_text_gml_9647_0": "\\E3＊ マンガの「こちツル」ネタ…\n　 こんな　ビンテージを\n　 オレのために？/",
  "scr_text_slash_scr_text_gml_9648_0": "\\EF＊ きっと　あたまのなかでは\n　 オレと　あんなことや\n　 こんなことまで　してるな。/",
  "scr_text_slash_scr_text_gml_9649_0": "\\ED＊ …っと　またメッセだ^1！\n　 しつれいするぜ…/%",
  "scr_text_slash_scr_text_gml_9653_0": "\\ED＊ うおおぉぉぉぉ！^1！\n　 みろよ　これ！！！/",
  "scr_text_slash_scr_text_gml_9654_0_b": "\\EA＊ クソコラを　さらに　コラに\n　 して^1　オレたちのことに\n　 して　おくってきた！/",
  "scr_text_slash_scr_text_gml_9655_0": "\\EE＊ これぞ　まさに　あい^1！\n　 ああ^1…かんじる^1…\n　 うちゅうの　しんぴを…/%",
  "scr_text_slash_scr_text_gml_9662_0": "\\E6＊ だな^1。デートなのに\n　 おまえが　いたら\n　 きまずいもんな。/%",
  "scr_text_slash_scr_text_gml_9668_0": "\nどうしたのか\nたずねる",
  "scr_text_slash_scr_text_gml_9669_0": "\nたちさる",
  "scr_text_slash_scr_text_gml_9673_0_b": "\\E7＊ …/",
  "scr_text_slash_scr_text_gml_9690_0": "\\E7＊ …/%",
  "scr_text_slash_scr_text_gml_9696_0": "さいせい\nそくどを\nかえる",
  "scr_text_slash_scr_text_gml_9697_0": "ていし\nボタンを\nおす",
  "scr_text_slash_scr_text_gml_9701_0_b": "＊ (レコードプレイヤーだ)/",
  "scr_text_slash_scr_text_gml_9720_0": "＊ ざんねんながら　ていしボタンだけが\n　 こわれているようだ。/%",
  "scr_text_slash_scr_text_gml_9726_0": "\nてもちの\nテレビを\nあげる",
  "scr_text_slash_scr_text_gml_9727_0": "\nようは\nない",
  "scr_text_slash_scr_text_gml_9731_0_b": "＊ (とびらを　たたいた…)/",
  "scr_text_slash_scr_text_gml_9734_0": "＊ ああ^1…たいくつだ^1…\n　 この　ものういじかんを\n　 どうやってすごしたらいいんだ…/",
  "scr_text_slash_scr_text_gml_9735_0": "＊ キミ^1…また　きたのかい？\n　 ボクの　たったひとりの「ファン」…/",
  "scr_text_slash_scr_text_gml_9738_0": "＊ ああ^1…たいくつだ^1…\n　 この　ものういじかんを\n　 どうやってすごしたらいいんだ…/",
  "scr_text_slash_scr_text_gml_9739_0": "＊ ん？^1　キミ^1　いえを　まちがえて\n　 いないかい？^1　ようがないなら\n　 かえってよ　こねこちゃん。/",
  "scr_text_slash_scr_text_gml_9762_0_b": "＊ やっぱり。はしゃぐなら　どこか\n　 よそで　やって。/%",
  "scr_text_slash_scr_text_gml_9768_0_b": "\nしらべる",
  "scr_text_slash_scr_text_gml_9769_0": "\nやめておく",
  "scr_text_slash_scr_text_gml_9773_0": "＊ (シューシューおとがする…\n　 さらに　しらべる？)/",
  "scr_text_slash_scr_text_gml_9781_0": "＊ (くらやみの　なかに\n　 めを　こらした…)/",
  "scr_text_slash_scr_text_gml_9782_0": "＊ (まどに　みえる　きいろい　まるは\n　 あげたてのドーナツのようだ)/",
  "scr_text_slash_scr_text_gml_9783_0": "＊ (シューシューという　おとは\n　 あげあぶらの　おとだった…)/%",
  "scr_text_slash_scr_text_gml_9795_0_b": "\nナイトの話",
  "scr_text_slash_scr_text_gml_9796_0": "\n立ち去る",
  "scr_text_slash_scr_text_gml_9797_0": "道化師",
  "scr_text_slash_scr_text_gml_9800_0_b": "\\E5＊ …何用だ？/",
  "scr_text_slash_scr_text_gml_9820_0": "\\E0＊ おまえたちは　終わりだ。\n　 じきに　「騎士」に\n　 始末される。/",
  "scr_text_slash_scr_text_gml_9822_0": "\\EY＊ 見てのとおり^1 \n　 まだ生きてるぜ。/",
  "scr_text_slash_scr_text_gml_9824_0": "\\E6\\M4＊ なっ！^1？\n　 騎士に　まみえたのか！？/",
  "scr_text_slash_scr_text_gml_9825_0": "\\E0\\M0＊ …なるほど。気まぐれに\n　 助命したか。/",
  "scr_text_slash_scr_text_gml_9826_0": "\\E4＊ 手加減なしでは^1　跡形もなく\n　 消し飛ばされていただろう！\n　 ハッ！/",
  "scr_text_slash_scr_text_gml_9827_0": "\\E5＊ …/",
  "scr_text_slash_scr_text_gml_9828_0": "\\E1\\M1＊ …して^1…騎士は\n　 いかなる者であったか？/",
  "scr_text_slash_scr_text_gml_9835_0": "\\E4＊ うーん…なんというか…/",
  "scr_text_slash_scr_text_gml_9845_0_b": "\\E6\\M1＊ なんだ？\n　 もったいつけるな！/",
  "scr_text_slash_scr_text_gml_9847_0": "\\EA＊ なんつーか^1…\n　 なんつーか^1　だよな？/",
  "scr_text_slash_scr_text_gml_9849_0": "\\E6\\M5＊ なんだ！^1？\n　 絵に描いてみせろ\n　 このトンチキめが！/%",
  "scr_text_slash_scr_text_gml_9855_0": "\\EC＊ …去れ。/%",
  "scr_text_slash_scr_text_gml_9861_0_b": "\\E5＊ 騎士が　いかに優れた者か\n　 私に教えたのは\n　 あの道化師だった…/",
  "scr_text_slash_scr_text_gml_9862_0": "\\E0＊ 闇の泉の力についても^1…\n　 どうすれば　頂に登り詰め\n　 られるかについても。/",
  "scr_text_slash_scr_text_gml_9863_0": "\\E7＊ おどけた男だった^1。\n　 冗談を言い^1　踊り^1　　\n　 われらを笑わせた。/",
  "scr_text_slash_scr_text_gml_9864_0": "\\E5＊ だが　親しき友に　たばかられ^1 \n　 追い落とされてしまった。\n　 くちおしきことだ。/",
  "scr_text_slash_scr_text_gml_9865_0": "\\E5＊ たばかった側の魔術師ヌイも^1　\n　 その日以来　うつろな\n　 笑みしか見せなくなった。/%",
  "scr_text_slash_scr_text_gml_9871_0": "\nスージィが\nたべた",
  "scr_text_slash_scr_text_gml_9872_0": "\nじぶんが\nたべた",
  "scr_text_slash_scr_text_gml_9876_0": "\\E0＊ あら　ふたりとも^1。\n　 どう？^1　たのしく…/",
  "scr_text_slash_scr_text_gml_9877_0": "\\E3＊ …/",
  "scr_text_slash_scr_text_gml_9878_0": "\\E7＊ きょうかいに　きていった\n　 おようふくは？\\M1/",
  "scr_text_slash_scr_text_gml_9880_0": "\\EK＊ あー…/",
  "scr_text_slash_scr_text_gml_9882_0": "\\M0\\E5＊ クリス^1。スージィは\n　 おきゃくさまよ^1。あなたが\n　 いいわけしてあげて。/",
  "scr_text_slash_scr_text_gml_9894_0": "\\M1\\E5＊ (よけい　おこられる\n　 だろ！！)/%",
  "scr_text_slash_scr_text_gml_9899_0_b": "\nのぞく",
  "scr_text_slash_scr_text_gml_9900_0_b": "\nのぞかない",
  "scr_text_slash_scr_text_gml_9904_0": "＊ (なかは　しずかだ。のぞいてみる？)/",
  "scr_text_slash_scr_text_gml_9913_0": "＊ (ジグザグのカーペット^1…\n　 えきしょうテレビ^1…\n　 ごくふつうのキッチン…)/",
  "scr_text_slash_scr_text_gml_9914_0": "＊ (…ちょっと　ちらかっているけれど\n　 とくに　かわったところはない)/%",
  "scr_text_slash_scr_text_gml_9926_0": "\nする",
  "scr_text_slash_scr_text_gml_9927_0": "\nしない",
  "scr_text_slash_scr_text_gml_9931_0": "＊ (同情する？)/",
  "scr_text_slash_scr_text_gml_9954_0": "\nお店",
  "scr_text_slash_scr_text_gml_9955_0": "\nなにしてる？",
  "scr_text_slash_scr_text_gml_9956_0": "ナイト",
  "scr_text_slash_scr_text_gml_9957_0": "なんでもない",
  "scr_text_slash_scr_text_gml_9960_0": "まほうのアックス",
  "scr_text_slash_scr_text_gml_9964_0": "＊ なにか用かね？/",
  "scr_text_slash_scr_text_gml_9971_0": "＊ ようこそ！　ようこそ！/",
  "scr_text_slash_scr_text_gml_9972_0": "＊ おまえさんたちのような　若者が\n　 訪ねてきてくれてうれしいぞい！\n　 ワシに　どんな　ご用かな？/",
  "scr_text_slash_scr_text_gml_9983_0_b": "＊ なにか　おさがしかね？\n　 売り物を　見ていかんかね？/",
  "scr_text_slash_scr_text_gml_9984_0": "＊ 下のテーブルに　並んどるぞな^1　\n　 ワッハハハハ！/",
  "scr_text_slash_scr_text_gml_9985_0": "＊ この書斎に　あるもんは\n　 ぜーんぶ　ワシのもんじゃ^1。\n　 いろいろ　売っとるぞい！/%",
  "scr_text_slash_scr_text_gml_10005_0_b": "＊ まだ^1　書いたり　描いたり\n　 しとるぞい！/%",
  "scr_text_slash_scr_text_gml_10020_0": "＊ ワシかね？^1　まだ書いとる\n　 途中じゃよ！^1　大丈夫^1　こんなもの\n　 オチャノコサイサイじゃ。/",
  "scr_text_slash_scr_text_gml_10021_0": "＊ …むずかしいのは^1　\n　 じっと座っとらんと\n　 いかんことじゃな！/%",
  "scr_text_slash_scr_text_gml_10037_0": "＊ 自分のために　書いとるんじゃ。/",
  "scr_text_slash_scr_text_gml_10038_0": "＊ おまえさんたちにも　いつか\n　 やってほしいものじゃな…/%",
  "scr_text_slash_scr_text_gml_10049_0": "＊ 騎士のような者のことかね^1？\n　 言ったじゃろう^1？\n　 上の　真ん中のとびらに…/",
  "scr_text_slash_scr_text_gml_10050_0": "＊ おお^1！\n　 心やさしいパンプキンボーイから\n　 ツメを受け取ったな？/",
  "scr_text_slash_scr_text_gml_10051_0_b": "＊ それがあれば^1　\\cY東の鐘塔\\cWに\n　 ラクラク登れるぞい。/",
  "scr_text_slash_scr_text_gml_10052_0_b": "＊ そこに^1　上のとびらを開ける\n　 仕掛けが　あるはずじゃ。/%",
  "scr_text_slash_scr_text_gml_10066_0": "＊ おまえさんたちが言う　その\n　 「ナイト」とやらは^1　上の\n　 真ん中のとびらに入っていった…/",
  "scr_text_slash_scr_text_gml_10067_0": "＊ とびらは　\\cY鐘塔\\cWにある仕掛けで\n　 開かんようになっとる。/",
  "scr_text_slash_scr_text_gml_10068_0": "＊ \\cY北西の図書室\\cWに行けば^1　\n　 なにか見つかるかもしれんのう。/",
  "scr_text_slash_scr_text_gml_10070_0": "\\EC＊ (んなわけねーだろ^1。\n　 …知らねーけど)/%",
  "scr_text_slash_scr_text_gml_10087_0": "＊ 上の真ん中のとびらが\n　 開いたようじゃ…/",
  "scr_text_slash_scr_text_gml_10088_0": "＊ …そこに入れば\n　 行くべき場所に着くじゃろう。/%",
  "scr_text_slash_scr_text_gml_10096_0": "＊ おまえさんたちの行く手には^1　\n　 じつに多くが　待ち受けとるぞい^1…\n　 楽しんでゆくことじゃ！/%",
  "scr_text_slash_scr_text_gml_10110_0": "\\EJ＊ すみません^1…　まほうの\n　 アックスのことが　書いてある\n　 板を見たんですが…/",
  "scr_text_slash_scr_text_gml_10112_0": "＊ ああ…^1　そこの　おじょうちゃんが\n　 くわしく知りたいんじゃろう？/",
  "scr_text_slash_scr_text_gml_10114_0": "\\E5＊ んなこと　オレは\n　 ひと言も…！/",
  "scr_text_slash_scr_text_gml_10116_0": "＊ なるほど　なるほど^1。それなら\n　 ここから先は　ワシの独り言じゃ！/",
  "scr_text_slash_scr_text_gml_10117_0": "＊ 伝説によると^1…\n　 この部屋のかべのどこかに\n　 戦斧が隠されているそうじゃ。/",
  "scr_text_slash_scr_text_gml_10118_0": "＊ それを使いこなす者には\n　 すさまじい　まほうの力が\n　 満ちるのじゃ！/",
  "scr_text_slash_scr_text_gml_10119_0": "＊ じゃが^1　ただ隠されているだけでは\n　 ない^1。ちょっとやそっとじゃ\n　 開かんところに　しまいこまれとる。/",
  "scr_text_slash_scr_text_gml_10120_0": "＊ よく調べてみれば\n　 なにか　わかるかもしれんのう…/",
  "scr_text_slash_scr_text_gml_10122_0_b": "\\E0＊ …/",
  "scr_text_slash_scr_text_gml_10123_0": "\\ED＊ その　まほうの力って…\n　 だれでも　ゲットできんの？/",
  "scr_text_slash_scr_text_gml_10125_0": "＊ やってみる価値は\n　 あるんじゃないかね？/",
  "scr_text_slash_scr_text_gml_10127_0_b": "\\ED＊ …/",
  "scr_text_slash_scr_text_gml_10128_0": "\\E1＊ (クリス^1　できれば\n　 そのアックス^1　\n　 さがしてみようぜ…)/%",
  "scr_text_slash_scr_text_gml_10132_0": "\\EJ＊ すみません^1…　まほうの\n　 アックスのことが書いてある\n　 板を見たんですが…/",
  "scr_text_slash_scr_text_gml_10134_0": "＊ ああ…^1　そこの　おじょうちゃんが\n　 くわしく知りたいんじゃろう？/",
  "scr_text_slash_scr_text_gml_10136_0": "\\E2＊ …まあな。/",
  "scr_text_slash_scr_text_gml_10138_0": "＊ 伝説によると^1…\n　 この部屋の　かべの　どこかに\n　 戦斧が隠されているそうじゃ。/",
  "scr_text_slash_scr_text_gml_10139_0": "＊ それを使いこなす者には\n　 すさまじい　まほうの力が\n　 満ちるのじゃ！/",
  "scr_text_slash_scr_text_gml_10140_0": "＊ じゃが^1　ただ隠されているだけでは\n　 ない^1。ちょっとやそっとじゃ\n　 開かんところに　しまいこまれとる…/",
  "scr_text_slash_scr_text_gml_10141_0": "＊ よく調べてみれば\n　 なにか　わかるかもしれんのう…/",
  "scr_text_slash_scr_text_gml_10143_0": "\\E1＊ …/",
  "scr_text_slash_scr_text_gml_10144_0": "\\ED＊ その　まほうの力って^1…\n　 だれでも　ゲットできんの？/",
  "scr_text_slash_scr_text_gml_10146_0": "＊ やってみる価値は\n　 あるんじゃないかね？/",
  "scr_text_slash_scr_text_gml_10148_0_b": "\\ED＊ …/",
  "scr_text_slash_scr_text_gml_10149_0": "\\E1＊ (クリス^1　できれば\n　 そのアックス^1　\n　 さがしてみようぜ…)/%",
  "scr_text_slash_scr_text_gml_10154_0": "＊ 伝説によると^1…\n　 この部屋の　かべの　どこかに\n　 戦斧が隠されているそうじゃ。/",
  "scr_text_slash_scr_text_gml_10155_0": "＊ それを使いこなす者には\n　 すさまじい　まほうの力が\n　 満ちるのじゃ！/",
  "scr_text_slash_scr_text_gml_10156_0": "＊ じゃが^1　ただ隠されているだけでは\n　 ない^1。ちょっとやそっとじゃ\n　 開かんところに　しまいこまれとる…/",
  "scr_text_slash_scr_text_gml_10157_0": "＊ よく調べてみれば\n　 なにか　わかるかもしれんのう…/%",
  "scr_text_slash_scr_text_gml_10165_0": "＊ まほうのアックス…？\n　 フムフム…/",
  "scr_text_slash_scr_text_gml_10166_0": "＊ そういえば^1　なんだか急に\n　 すきま風が吹くようになったわい^1。\n　 なんでじゃろうな？/%",
  "scr_text_slash_scr_text_gml_10173_0": "＊ まだ　あの戦斧が欲しいかね？\n　 いつでも　やるぞい…/",
  "scr_text_slash_scr_text_gml_10175_0": "\\E9＊ …いや^1。じいさんを\n　 倒してからだ。/%",
  "scr_text_slash_scr_text_gml_10184_0": "\nいいよ",
  "scr_text_slash_scr_text_gml_10185_0": "\nムダだと思う",
  "scr_text_slash_scr_text_gml_10213_0_b": "\nちょっとだけ\n目を　つぶる",
  "scr_text_slash_scr_text_gml_10214_0_b": "\nつぶらない",
  "scr_text_slash_scr_text_gml_10242_0": "\nいやだ",
  "scr_text_slash_scr_text_gml_10243_0": "\nナイトのこと",
  "scr_text_slash_scr_text_gml_10244_0": "ノエルのこと",
  "scr_text_slash_scr_text_gml_10351_0": "\nミたい",
  "scr_text_slash_scr_text_gml_10352_0": "\nミたくない",
  "scr_text_slash_scr_text_gml_10357_0_b": "＊ ミたくないね？/",
  "scr_text_slash_scr_text_gml_10358_0": "＊ ジャックの　カオ\n　 ミたくないね？/",
  "scr_text_slash_scr_text_gml_10372_0": "\n行ったれ\nスージィ！",
  "scr_text_slash_scr_text_gml_10373_0": "\n時間がない",
  "scr_text_slash_scr_text_gml_10378_0": "＊ なんじゃ^1　また　やるのかね！？/",
  "scr_text_slash_scr_text_gml_10380_0": "\\E2＊ どうする　クリス？/",
  "scr_text_slash_scr_text_gml_10391_0": "\\EH＊ 覚悟しろよ！\n　 手加減ゼロで　いくからな！/%",
  "scr_text_slash_scr_text_gml_10397_0": "\\EA＊ わりぃ。リベンジマッチは\n　 また　あとでだ。/%",
  "scr_text_slash_scr_text_gml_10404_0": "\nきく",
  "scr_text_slash_scr_text_gml_10405_0": "\nまだ　さがす",
  "scr_text_slash_scr_text_gml_10410_0": "＊ (スージィが　なにか\n　 おもいついたようだ)/",
  "scr_text_slash_scr_text_gml_10424_0": "\n笑わなくても\nいいんだよ",
  "scr_text_slash_scr_text_gml_10425_0": "\nよし\n笑っていろ",
  "scr_text_slash_scr_text_gml_10443_0": "\nそうだよ",
  "scr_text_slash_scr_text_gml_10444_0": "\nおいのりだよ",
  "scr_text_slash_scr_text_gml_10449_0": "\\E0＊ …なんで　ロウソクに\n　 ひとの　なまえが\n　 かいてあんだ？/",
  "scr_text_slash_scr_text_gml_10450_0": "\\E2＊ …たんじょうびかよ…？/",
  "scr_text_slash_scr_text_gml_10464_0": "\nスージィに\nいのる",
  "scr_text_slash_scr_text_gml_10465_0": "\nノエルに\nいのる",
  "scr_text_slash_scr_text_gml_10466_0": "アズリエルに　いのる",
  "scr_text_slash_scr_text_gml_10467_0": "なにもしない",
  "scr_text_slash_scr_text_gml_10489_0": "\nあける",
  "scr_text_slash_scr_text_gml_10490_0": "\nやめとく",
  "scr_text_slash_scr_text_gml_10495_0": "＊ (なかは　ちいさな\n　 ものおきのようだ。あけてみる？)/",
  "scr_text_slash_scr_text_gml_10509_0_b": "\nベルをいじる",
  "scr_text_slash_scr_text_gml_10510_0_b": "\nいじらない",
  "scr_text_slash_scr_text_gml_10515_0": "＊ (おおきさの　ちがう　ベルが\n　 いくつも　ならんでいる)/",
  "scr_text_slash_scr_text_gml_10517_0": "\\EK＊ …いじろうとしてるだろ？/",
  "scr_text_slash_scr_text_gml_10533_0": "\\ED＊ …ああ^1。\n　 いまは　やめとこうぜ。/%",
  "scr_text_slash_scr_text_gml_10539_0": "\nきく\n(ながくなるかも)",
  "scr_text_slash_scr_text_gml_10540_0": "\nいまは　いい",
  "scr_text_slash_scr_text_gml_10558_0": "\nいつか\nまたひくよ",
  "scr_text_slash_scr_text_gml_10559_0": "\nスージィも\nひくなら",
  "scr_text_slash_scr_text_gml_10560_0": "にどと　ひかない",
  "scr_text_slash_scr_text_gml_10577_0": "\nどこへ\n行けばいい？",
  "scr_text_slash_scr_text_gml_10578_0": "\nかわいい…",
  "scr_text_slash_scr_text_gml_10579_0": "なんでもない",
  "scr_text_slash_scr_text_gml_10587_0": "＊ トモダチ！^1　ユウキある！\n　 アリガトウ…/",
  "scr_text_slash_scr_text_gml_10588_0": "＊ ジャック　ワ　ジブンの　キョウフと\n　 ムきアッて　ダークゾーンから\n　 ノガレた。/",
  "scr_text_slash_scr_text_gml_10589_0": "＊ ジャック　ワ　ジイサンの　イエ\n　 ソウジする^1！　ジイサン　ワ\n　 ヤ　サ　シ　イ。“Ｔ”　クレた。/",
  "scr_text_slash_scr_text_gml_10590_0": "＊ ジャック　ワ　トモダチ\n　 ワスレない。\n　 ナニか　キキタい　コト　アる？/",
  "scr_text_slash_scr_text_gml_10594_0": "＊ ジャック　ワ　トモダチ\n　 ワスレない。\n　 ナニか　キキタい　コト　アる？/",
  "scr_text_slash_scr_text_gml_10609_0": "＊ ジャック　ワ　ウワサ　キイた。\n　 ミギのほうの　ゾーンに…\n　 キ　レ　イ　の　ピアノ　アる。/",
  "scr_text_slash_scr_text_gml_10610_0": "＊ キをツケて。アッチには\n　 すぐ　オコる　ヒトたち　たくさん。/",
  "scr_text_slash_scr_text_gml_10611_0": "＊ ミ　ニ　ク　イ　カオ　してると\n　 イジメラレる^1…\n　 ジャック　ワ　キライ。/%",
  "scr_text_slash_scr_text_gml_10617_0": "＊ ジャック　ワ　ウワサ　キイた。\n　 ウエの　マンナカの　ドアから…\n　 イズミに　イケる。/",
  "scr_text_slash_scr_text_gml_10618_0": "＊ オマエたち　ドアに　ハイッタら^1…\n　 オマエたちと　ジャック　ワ\n　 バイバイ^1。ジャック　ワ　ナく。/",
  "scr_text_slash_scr_text_gml_10619_0": "＊ ロウの　ナミダ^1…\n　 オマエたちは　ミない^1…\n　 ううぅぅぅ…/",
  "scr_text_slash_scr_text_gml_10621_0": "\\EA＊ …オレらの\n　 キャッスルタウンに\n　 来るか…？/",
  "scr_text_slash_scr_text_gml_10623_0": "＊ ア　タ　ラ　シ　イ　の\n　 トモダチ！^1？\n　 ダメ^1！　もっとナミダ　デる…！！/%",
  "scr_text_slash_scr_text_gml_10628_0": "＊ ナニ？^1？　ナニ？？^1？\n　 ワカラない^1…\n　 ジャック　ワ　ワカラない…/%",
  "scr_text_slash_scr_text_gml_10636_0": "＊ はい　オマエたち　ワ　サイコウ。/%",
  "scr_text_slash_scr_text_gml_10642_0": "\nいらない",
  "scr_text_slash_scr_text_gml_10643_0": "\nいただく",
  "scr_text_slash_scr_text_gml_10644_0": "お砂糖\n２つで",
  "scr_text_slash_scr_text_gml_10648_0": "\\E2＊ クリスも^1　お茶　どう？/",
  "scr_text_slash_scr_text_gml_10664_0": "\nラルセイが\n食べて",
  "scr_text_slash_scr_text_gml_10665_0": "\nいただき！",
  "scr_text_slash_scr_text_gml_10685_0": "\nいただく",
  "scr_text_slash_scr_text_gml_10686_0": "\nいただかない",
  "scr_text_slash_scr_text_gml_10687_0": "お茶は　もう飲んだ",
  "scr_text_slash_scr_text_gml_10693_0": "＊ どれ　一杯　いれてやるぞい。/",
  "scr_text_slash_scr_text_gml_10709_0": "\n飲む",
  "scr_text_slash_scr_text_gml_10710_0": "\n飲まない",
  "scr_text_slash_scr_text_gml_10715_0": "＊ (ポチャン…)/",
  "scr_text_slash_scr_text_gml_10716_0": "＊ (だれかが　お茶に　角砂糖を\n　 もう１つ　入れたようだ)/",
  "scr_text_slash_scr_text_gml_10731_0": "\nいまは\nいい",
  "scr_text_slash_scr_text_gml_10732_0": "\nやっぱり\nお茶飲む",
  "scr_text_slash_scr_text_gml_10737_0": "＊ 本当にいいのかね？\n　 冷めないうちに\n　 一杯どうじゃね。/",
  "scr_text_slash_scr_text_gml_10773_0": "れいはいが\nおわるまで\nねる",
  "scr_text_slash_scr_text_gml_10774_0": "\nれいはいを\nみる",
  "scr_text_slash_scr_text_gml_10779_0": "\\EK＊ …クリス^1　いねむりとか\n　 しねーよな？/",
  "scr_text_slash_scr_text_gml_10795_0": "\n読む",
  "scr_text_slash_scr_text_gml_10796_0": "\n読まない",
  "scr_text_slash_scr_text_gml_10801_0": "＊ (「まほうの戦斧の伝説」)\n＊ (読む？)/",
  "scr_text_slash_scr_text_gml_10817_0": "\nいこう",
  "scr_text_slash_scr_text_gml_10818_0": "\nいかない",
  "scr_text_slash_scr_text_gml_10823_0": "\\EA＊ …がっこういって\n　 ようす　みてこねぇ？/",
  "scr_text_slash_scr_text_gml_10835_0": "\\E2＊ …おう。そうしようぜ。/%",
  "scr_text_slash_scr_text_gml_10841_0": "\\EM＊ フン^1。まあいいよ^1。\n　 あとで　ひとりで\n　 いってくるし。/%",
  "scr_text_slash_scr_text_gml_10846_0": "\nアンダイン",
  "scr_text_slash_scr_text_gml_10847_0": "\nシェルター",
  "scr_text_slash_scr_text_gml_10848_0": "なんでもない",
  "scr_text_slash_scr_text_gml_10852_0": "＊ アンダインしょちょうが　いないカラ\n　 ひとりで　こうつうせいりを\n　 がんばってるんだケド…/",
  "scr_text_slash_scr_text_gml_10866_0": "＊ アンダインしょちょう^1？\n　 きのうのよるから\n　 だれも　みてないヨ。/",
  "scr_text_slash_scr_text_gml_10867_0": "＊ …いつも　いるばしょ^1…\n　 どこを　さがしテモ　いなくテ…/",
  "scr_text_slash_scr_text_gml_10868_0": "＊ …/",
  "scr_text_slash_scr_text_gml_10869_0": "＊ アンダインは　むてきダカラ\n　 しんぱいするのは　おかしいカモ\n　 しれないケド…/",
  "scr_text_slash_scr_text_gml_10870_0": "＊ あの　えがおが　みられないト…\n　 なんだか　しごとの　ちょうしが\n　 でないヨ…/%",
  "scr_text_slash_scr_text_gml_10874_0": "＊ しょうじき^1　アンダインが\n　 いなくなって^1　まちは　いつもより\n　 へいわになったカンジ…/",
  "scr_text_slash_scr_text_gml_10875_0": "＊ バクハツも^1…　ごにんたいほも^1…\n　 フツーのたいほも^1　へったヨ…/",
  "scr_text_slash_scr_text_gml_10876_0": "＊ アンダインは　けいさつかんとしてハ\n　 ダメダメかもしれないケド^1\n　 トモダチとしてハ　アゲアゲだヨ。/",
  "scr_text_slash_scr_text_gml_10877_0": "＊ はやく　みつかって　ほしいナ。/%",
  "scr_text_slash_scr_text_gml_10886_0": "＊ シェルター…？　うん…\n　 アンダインが　シェルターの\n　 なにかを　かんり　していたヨ。/",
  "scr_text_slash_scr_text_gml_10887_0": "＊ だいじな　あんごう…だったカナ^1。\n　 そのはなしの　ときダケ\n　 いつも　ふあんそうに　してたヨ。/",
  "scr_text_slash_scr_text_gml_10888_0": "＊ …あんごう…^1　みたことは　ないヨ^1。\n　 けいさつしょにも　ほかんされて\n　 ないんじゃないカナ。/%",
  "scr_text_slash_scr_text_gml_10892_0": "＊ シェルターは　なんだか　ブキミ\n　 だから^1…　ぜったい　ちかづかない\n　 ように　してるんダ。/",
  "scr_text_slash_scr_text_gml_10893_0": "＊ オバケにも\n　 こわいものは　あるんダヨ…/",
  "scr_text_slash_scr_text_gml_10894_0": "＊ …たいていは^1　ひとと　あうのが\n　 こわいせい　だけど…^1　ほかの\n　 ものが　こわいときも　あるヨ。/%",
  "scr_text_slash_scr_text_gml_10899_0": "＊ あ………^1…　うん　わかったヨ。/%",
  "scr_text_slash_scr_text_gml_10904_0": "でも\nそれじゃ\nつまらない",
  "scr_text_slash_scr_text_gml_10905_0": "でも\nなかに\nママがいる",
  "scr_text_slash_scr_text_gml_10923_0": "\nあさる",
  "scr_text_slash_scr_text_gml_10924_0": "\nあさらない",
  "scr_text_slash_scr_text_gml_10929_0": "＊ (ガラクタが　たくさん　はいった\n　 はこだ。あさってみる？)/",
  "scr_text_slash_scr_text_gml_10942_0": "＊ (はこのなかを　あさった^1…\n　 でてきたのは…)/",
  "scr_text_slash_scr_text_gml_10943_0": "＊ (こげたライターが２つ^1…サビた\n　 10とくナイフ^1…しょうみきげんが\n　 きれた　ぐんよう　しょくりょう…)/",
  "scr_text_slash_scr_text_gml_10944_0": "＊ (トランシーバー^1…\n　 はずれた　そうがんきょう^1…\n　 ヒヅメのあしに　ぴったりのクツ…)/",
  "scr_text_slash_scr_text_gml_10945_0": "＊ (ぼうりょくてきなマンガ^1…\n　 ペイントボール^1…われたホッケー\n　 マスク^1…けいとと　ボタン…)/",
  "scr_text_slash_scr_text_gml_10946_0": "＊ (クリスのお兄ちゃんの　はの\n　 きょうせいき^1…ミントのカンに\n　 はいった　めずらしい　このは)/%",
  "scr_text_slash_scr_text_gml_10950_0": "＊ (ガラクタが　たくさんはいった\n　 はこだ)/%",
  "scr_text_slash_scr_text_gml_10955_0": "＊ (ものが　おおい)/%",
  "scr_text_slash_scr_text_gml_10961_0": "\nパネルを\nしらべる",
  "scr_text_slash_scr_text_gml_10962_0": "\nやめておく",
  "scr_text_slash_scr_text_gml_10980_0": "＊ (シェルターの　とびらには\n　 きみょうなパネルが　ついている)/",
  "scr_text_slash_scr_text_gml_10981_0": "＊ (デジタルロックのようだ…)/",
  "scr_text_slash_scr_text_gml_10982_0": "＊ (にゅうりょくする　かしょは\n　 ３つあり^1　それぞれの　よこに\n　 １つずつ　マークが　ついている)/",
  "scr_text_slash_scr_text_gml_10983_0": "＊ (１つの　よこには^3 \n　 モミの木の　マーク)/",
  "scr_text_slash_scr_text_gml_10984_0": "＊ (１つの　よこには^3 \n　 けいさつバッジの　マーク)/",
  "scr_text_slash_scr_text_gml_10985_0": "＊ (そして^3　もう１つの　よこの\n　 マークは^3　DELTA RUNE)/%",
  "scr_text_slash_scr_text_gml_10995_0": "\nその\nかっこう",
  "scr_text_slash_scr_text_gml_10996_0": "\nげんきに\nしてる？",
  "scr_text_slash_scr_text_gml_10997_0": "なんでもない",
  "scr_text_slash_scr_text_gml_11001_0": "\\E0＊ クリス^1。パパに　なにか\n　 ようかな？/",
  "scr_text_slash_scr_text_gml_11015_0": "\\E3＊ …そう^1　キャロルとは^1…\n　 いろいろと　きょうりょく\n　 していてね。/",
  "scr_text_slash_scr_text_gml_11016_0": "\\E1＊ パパの　はなやを\n　 サポートしてもらっている\n　 おれいに　パパは…/",
  "scr_text_slash_scr_text_gml_11017_0": "\\E2＊ …/",
  "scr_text_slash_scr_text_gml_11018_0": "\\E1＊ …いやあ　おかしなものだね^1。\n　 にわいじりは　むかしから\n　 パパの　しゅみだ。/",
  "scr_text_slash_scr_text_gml_11019_0": "\\E0＊ しごとにしたことは\n　 なかったから^1　そだてた\n　 はなを　うるというのは…/",
  "scr_text_slash_scr_text_gml_11020_0": "\\E3＊ …どうにも　つらい^1。\n　 はなは^1　あいするひとに\n　 あげるものだよ。/",
  "scr_text_slash_scr_text_gml_11021_0": "\\E1＊ タダで　あげるのが\n　 しぜんだと\n　 おもわないかい？/%",
  "scr_text_slash_scr_text_gml_11025_0": "\\E5＊ マヌケな　かっこうに\n　 みえるかもしれないが^1…\n　 そのかちは　あるさ。/",
  "scr_text_slash_scr_text_gml_11026_0": "\\E0＊ だいじょうぶ^1…\n　 すべて　うまくいくよ。/%",
  "scr_text_slash_scr_text_gml_11035_0": "\\E5＊ げんきモリモリさ！\n　 あしたは　おまつりだから…/",
  "scr_text_slash_scr_text_gml_11036_0": "\\E1＊ …うちの　はなやは\n　 きろくてきな　うりあげを\n　 はじきだすぞ！/",
  "scr_text_slash_scr_text_gml_11037_0": "\\E3＊ もうすこし　おカネが\n　 はいれば^1　すべて\n　 きどうに　のるさ…/",
  "scr_text_slash_scr_text_gml_11038_0": "\\E5＊ そしたら　クリスとアズに^1　\n　 パパが　おやつプレートを\n　 よういしてあげるぞ！/",
  "scr_text_slash_scr_text_gml_11039_0": "\\E6＊ …ママのぶんも\n　 あるかもだ。/%",
  "scr_text_slash_scr_text_gml_11043_0": "\\E0＊ パパのことは　しんぱい\n　 ないから^1　もういきなさい。\n　 べんきょうだいいちだぞ。/",
  "scr_text_slash_scr_text_gml_11044_0": "\\E5＊ あしたは　おまつりだから^1　\n　 パパも　おおいそがしだ！/%",
  "scr_text_slash_scr_text_gml_11049_0": "\\E5＊ それじゃ^1　またな　クリス！/%",
  "scr_text_slash_scr_text_gml_11055_0": "\nはい",
  "scr_text_slash_scr_text_gml_11056_0": "\nいいえ",
  "scr_text_slash_scr_text_gml_11061_0": "＊ (案内を頼む？)/",
  "scr_text_slash_scr_text_gml_11079_0": "\nお願いします",
  "scr_text_slash_scr_text_gml_11080_0": "\nアンタに用はない",
  "scr_text_slash_scr_text_gml_11085_0": "＊ ヒント　いりまっか？/",
  "scr_text_slash_scr_text_gml_11095_0": "＊ ほな　教えますわ。/",
  "scr_text_slash_scr_text_gml_11096_0": "＊ …ゆうても　単なる遊びですけどな。/",
  "scr_text_slash_scr_text_gml_11097_0": "＊ うまいこと　タイミングが合うと\n　 \\cYゴールド\\cWゲットですわ。/",
  "scr_text_slash_scr_text_gml_11098_0": "＊ ちょ～っとラグが　あるかも\n　 しれへんけども　そこは\n　 うまいこと合わせとくんなはれ。/",
  "scr_text_slash_scr_text_gml_11099_0": "＊ ~1と~2押して\n　 音　鳴らせますわ。/",
  "scr_text_slash_scr_text_gml_11100_0": "＊ ~1か~2でも　鳴らせますさかい\n　 好きなように　ミックスして\n　 プレイしとくんなはれ！/",
  "scr_text_slash_scr_text_gml_11101_0": "＊ まちがえたときは　~1押して\n　 やめたり　やり直したり\n　 できますよって。/",
  "scr_text_slash_scr_text_gml_11102_0": "＊ ヒントは　そんなとこですわ！/%",
  "scr_text_slash_scr_text_gml_11106_0": "＊ さいでっか。/%",
  "scr_text_slash_scr_text_gml_11112_0": "\nプレイ(ノーマル)",
  "scr_text_slash_scr_text_gml_11113_0": "\nプレイ(ハード)",
  "scr_text_slash_scr_text_gml_11114_0": "やめる",
  "scr_text_slash_scr_text_gml_11127_0": "＊ 「~1」！\n＊ プレイする！？/",
  "scr_text_slash_scr_text_gml_11151_0": "\nテナを\nすすめる",
  "scr_text_slash_scr_text_gml_11152_0": "\nなにも\nすすめない",
  "scr_text_slash_scr_text_gml_11157_0": "＊ ああ^1…　ボクは　エンタメに\n　 うえている…/",
  "scr_text_slash_scr_text_gml_11158_0": "＊ こんなことを　おねがいするのは\n　 はずかしいけれど…/",
  "scr_text_slash_scr_text_gml_11159_0": "＊ なにか　たのしめるものを\n　 もっていたりしないかい？/",
  "scr_text_slash_scr_text_gml_11170_0": "\\ED＊ だったら^1…　ともだちの\n　 テナってヤツが　いるけど…/",
  "scr_text_slash_scr_text_gml_11172_0": "＊ それは…^1　ビデオとかを\n　 みせてくれる　エンタメボーイ^1…\n　 みたいな？/",
  "scr_text_slash_scr_text_gml_11174_0": "\\ED＊ …あー　でも…/",
  "scr_text_slash_scr_text_gml_11175_0": "\\ER＊ ちょっと　いま^1…\n　 ブッこわれてんだよな。/",
  "scr_text_slash_scr_text_gml_11176_0": "\\ES＊ わりぃ。わすれてくれ。/",
  "scr_text_slash_scr_text_gml_11178_0": "＊ こわれてる…？^1　そのひとは\n　 ロボットか　なにかなのかい？/",
  "scr_text_slash_scr_text_gml_11180_0": "\\ED＊ いや…　あいつは^1…\n　 …とにかく　オレたちで\n　 なおすからさ^1。たぶん。/%",
  "scr_text_slash_scr_text_gml_11184_0": "＊ そうか…^1　\n　 わかったよ　こねこちゃん。/%",
  "scr_text_slash_scr_text_gml_11190_0": "\nハイ\nポーズ！",
  "scr_text_slash_scr_text_gml_11191_0": "\nなにもしない",
  "scr_text_slash_scr_text_gml_11198_0": "＊ ウフフ～　今日は　ここで\n　 野性動物フォトセッション\n　 してるの！/",
  "scr_text_slash_scr_text_gml_11199_0": "＊ とっても　キュートォ～！\n　 とっても　セクシィ～！/",
  "scr_text_slash_scr_text_gml_11220_0": "＊ とっても　チュートォ～！\n　 とっても　テクシィ～！/%",
  "scr_text_slash_scr_text_gml_11226_0": "\n飛び降りる",
  "scr_text_slash_scr_text_gml_11227_0": "\nちょっと待って",
  "scr_text_slash_scr_text_gml_11232_0": "\\EE＊ …ここから飛び降りれば\n　 また体に飛び乗れる…/",
  "scr_text_slash_scr_text_gml_11258_0": "\nドアノブを\nまわす",
  "scr_text_slash_scr_text_gml_11259_0": "\nまわさない",
  "scr_text_slash_scr_text_gml_11264_0": "＊ (ドアだ。\n　 からだが　おおきいひとでも\n　 はいれそうだ)/",
  "scr_text_slash_scr_text_gml_11273_0": "＊ (ドアノブを　まわした)/",
  "scr_text_slash_scr_text_gml_11274_0": "＊ (…)/",
  "scr_text_slash_scr_text_gml_11275_0": "＊ (…ほかには　なにもしなかった)/%",
  "scr_text_slash_scr_text_gml_11285_0": "\n買う",
  "scr_text_slash_scr_text_gml_11286_0": "\n買わない",
  "scr_text_slash_scr_text_gml_11290_0": "なぜ　おカネを取る？",
  "scr_text_slash_scr_text_gml_11301_0": "＊ ホッホウ^1。なにか買っていくかね^1？\n　 ほれ^1　えんりょせずに\n　 見ていかんかね…/",
  "scr_text_slash_scr_text_gml_11305_0": "＊ まだ用があるかね？/",
  "scr_text_slash_scr_text_gml_11318_0": "\\Ed＊ おじいさんは^1…\n　 いないみたいだね…/",
  "scr_text_slash_scr_text_gml_11320_0": "\\E0＊ …だから？/",
  "scr_text_slash_scr_text_gml_11321_0": "\\EM＊ いなくても^1　ここにあんのは\n　 じいさんのもんだ。/",
  "scr_text_slash_scr_text_gml_11322_0": "\\E2＊ なんか　持ってくなら^1　\n　 カネを置いてくぞ。/",
  "scr_text_slash_scr_text_gml_11324_0": "\\E1＊ …スージィ…/",
  "scr_text_slash_scr_text_gml_11325_0": "\\E2＊ なら^1　おつりの管理は\n　 ボクに　まかせて！\\f0/",
  "scr_text_slash_scr_text_gml_11329_0": "\\E2＊ クリス^1。なにか買うの？/",
  "scr_text_slash_scr_text_gml_11354_0": "＊ ワシは　カネなどいらんが\n　 ここにいる　連中のために\n　 かせがんとな！/",
  "scr_text_slash_scr_text_gml_11355_0": "＊ かわいい　かわいい　仲間たちに\n　 メシを　食べさせてやらんといかん！\n　 ガッハッハ！/%",
  "scr_text_slash_scr_text_gml_11361_0": "＊ 隠居生活に備えて\n　 貯金せんといかんからな^1！\n　 ガッハッハ！/",
  "scr_text_slash_scr_text_gml_11363_0": "\\EK＊ (老後の生活は\n　 厳しいからな…)/%",
  "scr_text_slash_scr_text_gml_11370_0": "\n聞く",
  "scr_text_slash_scr_text_gml_11371_0": "\n聞かない",
  "scr_text_slash_scr_text_gml_11376_0": "＊ ボ^1…ボクは　ラブマスター^1。\n　 ラブについては　聞かないで。/",
  "scr_text_slash_scr_text_gml_11385_0": "\\M1＊ …ラブ^1…っていうのは^1…\n　 愛する　ふたりが…/",
  "scr_text_slash_scr_text_gml_11386_0": "＊ 道場で^1…いっしょに戦うことだ。/",
  "scr_text_slash_scr_text_gml_11387_0": "＊ …よな？/%",
  "scr_text_slash_scr_text_gml_11391_0": "＊ 助かるよ。/%",
  "scr_text_slash_scr_text_gml_11397_0": "\nねむらない",
  "scr_text_slash_scr_text_gml_11398_0": "ものすごく\nながいじかん\nねむる",
  "scr_text_slash_scr_text_gml_11403_0": "＊ (にどね　することも　できる…)/",
  "scr_text_slash_scr_text_gml_11404_0": "＊ (…が^1　そうすると^1　\n　 \\cYまるいちにち　みのがす\\cWかも\n　 しれない)/",
  "scr_text_slash_scr_text_gml_11413_0": "＊ (がんばって　もうすこし\n　 めを　あけていることにした)/%",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_629_0": "ジングルブレード",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_630_0": "ヤリのような剣。赤と白のストライプ模様。\n馬上ヤリ試合に最適。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_631_0": "モミくちゃにしてやるぜ！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_632_0": "ホリデーミント味！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_633_0": "なにこれ？美容院のサイン？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_652_0": "マークマフラー",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_653_0": "光沢のある薄いマフラー。聖なる文字が\n刻まれていて　まりょくを帯びている。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_654_0": "ヘヘッ…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_655_0": "印つけとくね",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_656_0": "見て！ 体操のリボンみたい！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_675_0": "正義のアックス",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_676_0": "アックス自体に特殊な力はないが\n勝ち取る過程で　前よりずっと強くなった！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_677_0": "見てろよ じいさん！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_678_0": "…スージィ 最高だよね？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_679_0": "…スージィ おじいさんをボコったの？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_698_0": "ウィングレード",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_699_0": "柄が白い羽根でできた　立派な剣。\nバトル後に獲得するおカネが　少し増える。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_700_0": "クシャミ出る…！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_701_0": "…くすぐったいよぅ！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_702_0": "…だれの羽根？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_721_0": "スクープアックス",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_722_0": "刻印がほどこされた　長くて曲がったアックス。\nこうげきすると　HPをすくい取る。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_723_0": "すくうぜ！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_724_0": "ボクは すくわないで！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_725_0": "赤いのは…血？",
  "UNUSED_slash_UNUSED_gml_8_0_c": "ここでは…",
  "UNUSED_slash_UNUSED_gml_9_0_b": "もう　食べもしないし　飲みもしない。",
  "UNUSED_slash_UNUSED_gml_10_0_b": "目が覚めているのか　夢を見ているのかもわからない。",
  "UNUSED_slash_UNUSED_gml_11_0_b": "死んでいるのか　生きているのかも。",
  "UNUSED_slash_UNUSED_gml_12_0_b": "真っ暗な静寂しかない。",
  "UNUSED_slash_UNUSED_gml_13_0": "…ただ　あの音がする。",
  "UNUSED_slash_UNUSED_gml_14_0": "ときどき聞こえる　引っかくような音。",
  "UNUSED_slash_UNUSED_gml_15_0": "信じてもらえないかもしれないけど…この声は　だれにも　届いていないかもしれないけど…",
  "UNUSED_slash_UNUSED_gml_16_0": "あの音を聞くたびに　この声が　だれかに　届いている気がする。",
  "UNUSED_slash_UNUSED_gml_17_0": "聞いてくれている人…　聞こえているなら…　ありがとう。",
  "obj_ch4_PDC03_slash_Step_0_gml_663_0": "＊ サボテンのトゲ…",
  "obj_ch4_PDC03_slash_Step_0_gml_668_0": "＊ ガラスのかけら…",
  "obj_ch4_PDC03_slash_Step_0_gml_746_0": "きたねーハブラシ",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_214_0": "クリスは　きっと　かえうた　するな",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_215_0": "クリスは　きっと　かえうた　するね",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_216_0": "クリスは　きっと　かえうた　するわ",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_447_0": "パパ！",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_448_0_b": "トリエルさん！？",
  "obj_ch4_PDC06B_slash_Step_0_gml_477_0": "(これ　もとの場所にもどして？)",
  "obj_ch4_PDC07_slash_Step_0_gml_214_0": "なに？　なに？　なに？？",
  "obj_ch4_PDC09_slash_Step_0_gml_81_0": "じゃあ　さがしおわったら…\nソファのところに　きてね？",
  "obj_ch4_PDC09A_slash_Step_0_gml_64_0": "ママが　あつめてるの…",
  "obj_ch4_PDC14B_slash_Step_0_gml_445_0": "\\E0＊ なあ…クリス。/",
  "obj_ch4_PDC14B_slash_Step_0_gml_446_0": "\\ED＊ さっきは　おまえのパパが\n　 いたから　いわなかったん\n　 だけどさ…/",
  "obj_ch4_PDC14B_slash_Step_0_gml_447_0": "\\EV＊ オレ^1　みたんだ。/",
  "obj_ch4_PDC14B_slash_Step_0_gml_448_0": "\\EV＊ ギターの　なか。/",
  "obj_ch4_PDC14B_slash_Step_0_gml_449_0": "\\EV＊ シェルターのカギあける\n　 あんごうが\n　 かいてあった。/",
  "obj_ch4_PDC14B_slash_Step_0_gml_450_0": "\\EV＊ …でも^1　メモれなかった。/",
  "obj_ch4_PDC14B_slash_Step_0_gml_451_0": "\\Eb＊ クソッ^1！\n　 あと　すこしだったのに。/",
  "obj_ch4_PDC14B_slash_Step_0_gml_452_0": "\\EV＊ …あした　もういっかい\n　 トライするしかねえな。/%",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_22_0": "そう！ 本だよ！",
  "obj_dw_church_biblioxencounter_slash_Step_0_gml_23_0": "…だから？",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_426_0": "\nスージィを\n見る",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_427_0": "\nラルセイを\n見る",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_428_0": "クリスを見る",
  "obj_dw_church_bookshelfpuzzle_slash_Step_0_gml_429_0": "なにもしない",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_97_0": "クリス？",
  "obj_dw_church_ripplepuzzle_postgers_slash_Step_0_gml_98_0_b": "クリス？",
  "obj_dw_church_secretpiano_slash_Step_0_gml_209_0": "＊ 旋律は　全部で３つ。\n＊ ２つは　南の塔に。\n＊ １つは　黄金が水を打つ場に。/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_313_0": "…クリス？",
  "obj_jackenstein_enemy_slash_Step_0_gml_321_0": "オレだよ！ 触んな！",
  "obj_npc_room_slash_Other_10_gml_181_0": "そんな話はヤボだよ。",
  "obj_npc_room_slash_Other_10_gml_199_0": "ラルセイのことか？",
  "obj_npc_room_slash_Other_10_gml_251_0": "ボク　こんなの　知らないから！！",
  "obj_readable_room1_slash_Other_10_gml_435_0": "きったねぇ…\nだれか　そうじしろよ？",
  "obj_readable_room1_slash_Other_10_gml_3547_0": "(うぉい　クリス！)",
  "obj_readable_room1_slash_Other_10_gml_3642_0": "(なんで　わたし　チーズを　ハートがたに　きったのかな…？)",
  "obj_readable_room1_slash_Other_10_gml_3643_0_b": "(これって　つまようじも　くっていいんだっけ？)",
  "obj_readable_room1_slash_Other_10_gml_4129_0": "ん？　…じんろ…？　なんて？",
  "obj_readable_room1_slash_Other_10_gml_4130_0_b": "(もう　だまろう…)",
  "obj_readable_room1_slash_Other_10_gml_4159_0": "モチロン ワタシ",
  "obj_readable_room1_slash_Other_10_gml_4165_0": "それって…",
  "obj_readable_room1_slash_Other_10_gml_4166_0": "超高速デス！",
  "obj_readable_room1_slash_Other_10_gml_4189_0": "フリーなフリ？",
  "obj_readable_room1_slash_Other_10_gml_4491_0": "ホイップクリームが\nふきだしたらいいのにな",
  "obj_room_castle_lancer_slash_Step_0_gml_81_0": "そりゃいい",
  "obj_room_dungeon_2f_slash_Step_0_gml_314_0": "＊ おっと！\n　 つまずいて転んでしまいました！！/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_373_0": "＊ なっ…！！\n　 ヒトの不幸を　笑うな…ッ！/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_401_0": "＊ …じゃなくて…\n　 いやー　オイシイなぁ！^1！\n　 持ってるなぁ！！/%",
  "obj_shop1_slash_Draw_0_gml_515_0": "\\E1＊ それは…シャドウジェムかい！？/",
  "obj_shop1_slash_Draw_0_gml_516_0": "\\E3＊ ということは…/",
  "scr_text_slash_scr_text_gml_9026_0": "(クリス　わだいを　かえてちょうだい)",
  "scr_text_slash_scr_text_gml_9138_0": "クリス また PCのかべがみ\nホラーのに かえたでしょ…",
  "scr_text_slash_scr_text_gml_9153_0_b": "えっと…　かだいが　おわったらね？",
  "scr_text_slash_scr_text_gml_9175_0": "あっ…",
  "scr_text_slash_scr_text_gml_11324_0_b": "たのんだぜ\nチャラチャラボーイ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_788_0": "ゴールドウィドウ",
  "scr_armorinfo_slash_scr_armorinfo_gml_789_0": "黄金でできたスパイダー。コインを吸収する。\n獲得＄減少。",
  "scr_armorinfo_slash_scr_armorinfo_gml_790_0": "頭にクモ乗せんのかよ",
  "scr_armorinfo_slash_scr_armorinfo_gml_791_0": "フレンドリー！",
  "scr_armorinfo_slash_scr_armorinfo_gml_792_0": "やだ！ キモチワルイ！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1519_0": "＊ お天気コンビは　今回は　いっしょ！",
  "obj_readable_room1_slash_Other_10_gml_4902_0": "＊ あとどのくらい^1　このように\n　 重なり合っていれば\n　 よいのだろうか…？/",
  "obj_readable_room1_slash_Other_10_gml_4903_0": "＊ なるほど！^1　ライトナーたちが\n　 勝利をつかむまでか…！/",
  "obj_readable_room1_slash_Other_10_gml_4904_0": "＊ そうとも　そうとも！\n　 われわれは\n　 役に立っているだろう！？/%",
  "obj_readable_room1_slash_Other_10_gml_4908_0": "＊ そこの　若き騎士たちよ^1！\n　 キミたちも　重なり合って\n　 ライトナーたちに助力してくれ…！/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_255_0": "(Hey Kris, if this&guy wants a haircut,&let's ATTACK...!)/%",
  "obj_titan_enemy_slash_Other_10_gml_12_0": "＊ タイタンのDEFが低下！\n　 こうげきが　きわめて有効になった！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1105_0_b": "* (The bell of justice rings...)&(ATTACK to show what you've got!",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_20_0": "すごい…\nいまのこうげき\n相性バッチリ！\nカンペキだった！/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_34_0": "ええ！\nワタシも感じたわ！\nビリビリきたわ！/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_57_0": "ボクもさ\nハハハ…/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_81_0": "…/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_103_0": "でも…/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_125_0": "でも あのランプは…/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_147_0": "すごく…\nヘンだった。/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_191_0": "でも こうげきは\n強力に なった/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_213_0": "うん たしかに/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_235_0": "でも\nヘンだった/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_257_0": "ワタシたち…\n気に入らなかった/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_279_0": "そうかも/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_301_0": "なに？/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_323_0": "ううん\nあの ランプは\nサイアクだったって\nだけ/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_345_0": "うん/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_367_0": "…たぶん そう/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_389_0": "え？/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_411_0": "これで\nバトル終了よ！/%",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_476_0": "＊ 天気予報は　甘い言葉をささやいた。",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_477_0": "＊ 天気予報は　冷たい美しさで輝いた。",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_478_0": "＊ 天気予報は　熱い情熱で燃えた。",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_479_0": "＊ 天気予報は　甘くやわらかな\n　 光を放った。",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_481_0": "＊ ラニーノとエルニーナが\n　 おたがいをパワーアップ！\n　 生きのびろ！",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_518_0": "ボクたちの\n天気予報に\nついてこられた\nみたいだね",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_521_0": "でも そうカンタンには\n勝たせてあげない！\nさあ 雨に ぬれちゃって！",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_535_0": "アハハ なかなかやるね\nでも アツくなるのは\nこれからだ！\nエルニーナ！\n頼んだよ！",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_538_0": "ワタシから\n言うことなんて\nなにもないわ…\nだってワタシたち…\nカンペキだもの！",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_552_0": "今夜のお天気は…",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_555_0": "今夜のお天気は…",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_613_0": "ポタポタ\nでしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_616_0": "しとしとポタポタ\nでしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_621_0": "キラキラ\nでしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_624_0": "ぴかぴかキラキラ\nでしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_629_0": "月でしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_632_0": "ロウレイな月\nでしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_637_0": "太陽でしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_640_0": "サンサンと太陽\nでしょう",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_655_0": "ああ エルニーナ…\nキミは なんて\nステキなんだ…\nステキでクールだよ",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_658_0": "それに この道場の\nロマンチックな\nBGMも最高",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_671_0": "ボクも同感さ！",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_674_0": "というわけで…\n最後のこうげき\nいくわ！",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_687_0": "ダブル スカイ オブジェクト\nパーフェクト フォーエバー\nカップル！！",
  "obj_elnina_lanino_rematch_controller_slash_Step_0_gml_690_0": "ダブル スカイ オブジェクト\nパーフェクト フォーエバー\nカップル！！",
  "obj_bibliox_enemy_slash_Step_0_gml_33_0_b": "ブツ ブツ…",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_693_0": "\\E2＊ “クリス”マス^1！\n　 げんきにしてるかい？\n　 ゆきかきパワー満タンかい？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_694_0": "\\E1＊ …え？　「あかない」？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_695_0": "\\E5＊ (ノエルが　また\n　 もんの　そとに\n　 しめだされていたのかい…？)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_696_0": "\\E6＊ (…キャロルには　カギを\n　 まちやくばに　おいておけと\n　 いつも　いってるんだが…)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_697_0": "\\E5＊ (だいじなものは　ぜんぶ\n　 じたくに　もちかえらないと\n　 きがすまないらしくてね)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_698_0": "\\E2＊ (ノエルが\n　 ちいさかったころ…)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_699_0": "\\E0＊ (かみざいくの　ゆきの\n　 けっしょうを　キャロルに\n　 プレゼントしたんだが…)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_700_0": "\\E5＊ (しょくばに　かざってと\n　 なんど　いっても\n　 もっていこうとしなかった)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_701_0": "\\E6＊ (あんぜんな　ばしょに\n　 しまっておきたいとか\n　 なんとか…)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_702_0": "\\E5＊ (それで^1　ほきょうして\n　 いえの　かべに\n　 かざってしまったんだ)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_703_0": "\\E4＊ (…もちろん　ノエルは\n　 なきねいりさ)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_704_0": "\\E2＊ (でも^1　キミたちと\n　 ゆきの　じめんに\n　 ねころがって　あそんだら…)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_705_0": "\\E4＊ (…なにを　ないてたのかも\n　 わすれてしまった\n　 みたいだったなぁ)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_706_0": "\\E2＊ (…と^1　なんのはなし\n　 だったかな？)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_717_0": "\\S0＊ (じゅうような\n　 じょうほうのようだ)/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_728_0": "＊ (…じゅうぶんな　じょうほうが\n　 あつまった　きがする。\n　 スージィに　つたえよう)/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_733_0": "\\E5＊ (けさ　ノエルが\n　 いっていたよ…)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_734_0": "\\E2＊ (「あしたは　クリスも\n　 いくのかな」って)/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_735_0": "\\E3＊ (ノエルが　たのしく\n　 すごせるように^1　\n　 よろしくたのむよ)/%",
  "obj_credits_ch4_slash_Create_0_gml_64_0_b": "\\M0      半分ノ\n     道ノリヲ\n   踏破シマシタ。/%",
  "obj_gerson_fountain_slash_Draw_0_gml_486_0": "入れる\nアイテムを\n選択",
  "obj_gerson_fountain_slash_Draw_0_gml_487_0": "入れる\nぶきを\n選択",
  "obj_gerson_fountain_slash_Draw_0_gml_488_0": "入れる\nぼうぐを\n選択",
  "obj_guei_enemy_slash_Step_0_gml_466_0_b": "敵を逃がさずに\nこうげきするんです…/%",
  "obj_hammer_of_justice_enemy_slash_Create_0_gml_258_0": "＊\\EA (クリス…　毛を切って\n　 ほしいっつってんだ…\n　 こうげきしようぜ！)",
  "obj_jackenstein_enemy_slash_Step_0_gml_377_0": "＊ ジャックシュタインを　ぶんせきした…\n＊ \\cYぼうぎょ\\c0でTPを獲得できることを\n　 思い出した！/",
  "obj_jackenstein_enemy_slash_Step_0_gml_378_0": "＊ スージィとラルセイは\n　 単独で「こうどう」できることも\n　 思い出した…！/%",
  "obj_readable_room1_slash_Other_10_gml_2629_0": "\\EV＊ …/",
  "obj_readable_room1_slash_Other_10_gml_2630_0": "\\EV＊ あんごうが　どこにあるかは\n　 わかった。/",
  "obj_readable_room1_slash_Other_10_gml_2631_0": "\\EV＊ …でも^1　いそがねえと。/%",
  "obj_readable_room1_slash_Other_10_gml_2635_0": "\\EV＊ …/%",
  "obj_readable_room1_slash_Other_10_gml_3101_0": "＊ (閉まっているようだ…)/%",
  "obj_readable_room1_slash_Other_10_gml_4231_0": "\\E5＊ (てれびまん　じきに\n　 もどるハズ…)/",
  "obj_readable_room1_slash_Other_10_gml_4232_0": "\\E6＊ (そして　余の\n　 光りかがやき具合に\n　 気づくハズ…)/%",
  "obj_readable_room1_slash_Other_10_gml_4885_0": "＊ (なにかが　行く手をふさいでいる)/",
  "obj_readable_room1_slash_Other_10_gml_4886_0": "＊ (…とびらだ)/%",
  "obj_titan_enemy_slash_Step_0_gml_1544_0": "＊ 空気が　張りつめる…\n＊ (「解放」を　使えるようになった！)/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_161_0": "＊ 空気が　張りつめる…\n＊ (「\\cYバニッシュ\\c0」を　使えるようになった！)/%",
  "scr_armorinfo_slash_scr_armorinfo_gml_803_0": "$ -10%",
  "scr_credit_slash_scr_credit_gml_120_0_b": "-追加アニメーション アシスタント-",
  "scr_encountersetup_slash_scr_encountersetup_gml_1120_0": "＊ (正義の鐘が　鳴り響く…)\n　 (「こうげき」して　力を示せ！)",
  "scr_gamestart_slash_scr_gamestart_gml_340_0": "TERUTERUBOUZU",
  "scr_juice_name_slash_scr_juice_name_gml_30_0": "ミスティネクタル",
  "scr_juice_name_slash_scr_juice_name_gml_35_0": "ブラッドパワー",
  "scr_juice_name_slash_scr_juice_name_gml_40_0": "ドラゴンスカー",
  "scr_juice_name_slash_scr_juice_name_gml_45_0": "オレンジジュースだよ",
  "scr_juice_name_slash_scr_juice_name_gml_50_0": "レクイエムサンセット",
  "scr_juice_name_slash_scr_juice_name_gml_53_0": "Bepis Brew",
  "scr_spelltext_slash_scr_spelltext_gml_77_0": "＊ ~1は\n　 ベターヒールを唱えた！/%",
  "scr_spelltext_slash_scr_spelltext_gml_91_0": "＊ しかし　相手は「みのがす」概念を\n　 理解しない。/%",
  "scr_text_slash_scr_text_gml_8950_0": "~1\n＊ (ドリンク名：~2)/",
  "scr_text_slash_scr_text_gml_8983_0": "＊ (ジュースを　いれた)/%",
  "scr_text_slash_scr_text_gml_11457_0": "ザツに　いれたせいで　少し時間がたっただけで\n味が落ちた　お茶。+10HP",
  "scr_text_slash_scr_text_gml_11462_0": "くさったティー",
  "scr_text_slash_scr_text_gml_11467_0": "10HP\n回復",
  "scr_text_slash_scr_text_gml_11472_0": "オェ。",
  "scr_text_slash_scr_text_gml_11477_0": "えっと…",
  "scr_text_slash_scr_text_gml_11482_0": "もう…味がしない…",
  "scr_text_slash_scr_text_gml_11487_0": "＊ ~1は　くさったティーを使った！/%",
  "obj_ch4_PDC16_slash_Step_0_gml_71_0": "\\E0＊ なあ…^1　あめふってるし^1…\n　 ここで　まってても\n　 よくね…？/",
  "obj_ch4_PDC16_slash_Step_0_gml_72_0": "\\E1＊ …おまえのママが\n　 うたの　れんしゅう\n　 おわるまでさ。/",
  "obj_ch4_PDC16_slash_Step_0_gml_73_0": "\\ED＊ オレらが　いても\n　 ジャマに ならねーなら^1…\n　 だけど。/%",
  "obj_bell_enemy_slash_Step_0_gml_199_0": "＊ チューニングは　だいたい合った！~1",
  "obj_elnina_rematch_enemy_slash_Step_0_gml_45_0": "＊ エルニーナ -\n　 ラニーノに　“ツキ”っきり！/%",
  "obj_lanino_rematch_enemy_slash_Step_0_gml_39_0": "＊ ラニーノ -\n　 エルニーナをひと目見ただけで\n　 雨に唄いたくなってしまう。/%",
  "obj_lanino_rematch_enemy_slash_Step_0_gml_53_0": "＊ 空を見上げて…\n＊ 望遠鏡を　手に取った！/%",
  "obj_lanino_rematch_enemy_slash_Step_0_gml_63_0": "＊ 望遠鏡を手に取った！　月をさえぎれ！/%",
  "obj_lanino_rematch_enemy_slash_Step_0_gml_84_0": "＊ 太陽を　しのぐということは\n　 天気予報を気にしてるということ！/%",
  "obj_lanino_rematch_enemy_slash_Step_0_gml_93_0": "＊ サングラスをかけた！　太陽をしのげ！",
  "obj_lanino_rematch_enemy_slash_Step_0_gml_102_0": "＊ スージィは　晴れた日を　夢見た！",
  "obj_lanino_rematch_enemy_slash_Step_0_gml_128_0": "＊ ラルセイは　星の輝く夜を　願った！",
  "obj_titan_enemy_slash_Step_0_gml_1209_0": "ダブル\nまほう",
  "scr_litemname_slash_scr_litemname_gml_24_0": "はねペン",
  "scr_litemuseb_slash_scr_litemuseb_gml_256_0": "＊ はねペンを　そうびした。/%",
  "scr_monstersetup_slash_scr_monstersetup_gml_2518_0": "エルニーナ",
  "scr_monstersetup_slash_scr_monstersetup_gml_2530_0": "ぶんせき",
