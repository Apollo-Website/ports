␀␀␀␀;␀␀if (throwcon == 1)
{
    if (throwready == 0)
        angle += anglespeed;
    
    if (angle >= 30)
        anglespeed = -2;
    
    if (angle <= -15)
        anglespeed = 2;
    
    if (button3_p() && throwalpha >= 0.9 && throwready == 1)
    {
        activatethrow = 1;
        
        with (obj_writer)
            instance_destroy();
    }
    
    if (button3_p() && throwready == 0)
    {
        throwready = 1;
        
