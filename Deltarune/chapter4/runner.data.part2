            {
                if (mask_index == spr_no_mask && sprite_index != spr_ghost_house_yourtutu_inner)
                    image_blend = merge_color(c_red, c_black, 0.6);
                else
                    image_blend = c_red;
            }
            
            with (obj_gh_bouncebarrier)
                image_blend = merge_color(c_red, c_black, 0.6);
            
            with (obj_ghosthouse_trigger)
                active = false;
            
            with (obj_ghosthouse_jackolantern)
            {
