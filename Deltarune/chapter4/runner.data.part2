  "obj_initializer_slash_Create_0_gml_173_0": "%%",
  "obj_krisroom_slash_Step_0_gml_321_0": "クリス…？ /%",
  "obj_krisroom_slash_Step_0_gml_322_0": "クリス…&おきてるの…^6？ %%",
  "obj_krisroom_slash_Step_0_gml_323_0": "…えっ…まって^6！ %%",
  "obj_krisroom_slash_Step_0_gml_324_0": "まさか^6… %%",
  "obj_krisroom_slash_Step_0_gml_325_0": "ナイフ！^6？ %%",
  "obj_krisroom_slash_Step_0_gml_353_0": "そんな………！！！ %%",
  "obj_krisroom_slash_Step_0_gml_388_0": "＊ クリス^1。&　 パイ^1　ひとりで　ぜんぶ&　 たべたでしょう！/%",
  "obj_krisroom_slash_Step_0_gml_393_0": "\\E3＊ パイざらが　からっぽ^1…&　 それに　このナイフ^1…&　 あなたのよね！？/",
  "obj_krisroom_slash_Step_0_gml_394_0": "\\E8＊ まったく…/%",
  "obj_krisroom_slash_Step_0_gml_399_0": "\\E4＊ また　オーブンに&　 カギを　かけなきゃ&　 いけないかしら？/%",
  "obj_krisroom_slash_Step_0_gml_406_0": "\\E1＊ ほら^1　もう　おきて。&　 がっこうにいく&　 じかんよ。/%",
  "obj_legend_neo_slash_Draw_0_gml_38_0": "「光が　闇に　飲まれるとき」",
  "obj_legend_neo_slash_Draw_0_gml_46_0": "「泉が　空を覆うとき」",
  "obj_legend_neo_slash_Draw_0_gml_69_0": "「すべては　混沌（カオス）に&　　　　　　　包まれるだろう」",
  "obj_legend_neo_slash_Draw_0_gml_80_0": "「泉より　巨人が出現し」―",
  "obj_legend_neo_slash_Draw_0_gml_99_0": "「この地を　破壊し尽くすだろう」",
  "obj_legend_neo_slash_Draw_0_gml_167_0": "「生き延びたダークナーたちも&　　　　　　　　闇に屈し」―",
  "obj_legend_neo_slash_Draw_0_gml_180_0": "「やがて　１体　また１体と&　　　　　　　石と化すだろう」",
  "obj_legend_neo_slash_Draw_0_gml_196_0": "「ライトナーたちは&　　頼るべき者もないまま」―",
  "obj_legend_neo_slash_Draw_0_gml_211_0": "「終わらぬ夜を　永遠に&　　　　　さまようだろう」",
  "obj_legend_neo_slash_Draw_0_gml_225_0": "「そんな世界を&  楽園と呼ぶか…？」",
  "obj_npc_cafe_slash_Other_10_gml_27_0": "＊ 親友のハーティと&　 いっしょにいられて&　 うれしいなあ。/%",
  "obj_npc_cafe_slash_Other_10_gml_32_0": "＊ (ハーティは　満足そうだ)/%",
  "obj_npc_cafe_slash_Other_10_gml_38_0": "＊ はぁ…^1　こいつ^1　なんでもかんでも&　 わたしより上じゃないと&　 気がすまないわけ！？/%",
  "obj_npc_cafe_slash_Other_10_gml_43_0": "＊ 自分は　ダブル・サンデーサンデー^1…&　 いや^1　トリプルにしよう^1！&　 これはこれは！^1　隊長^1！(ニヤニヤ)/%",
  "obj_npc_cafe_slash_Other_10_gml_50_0": "＊ (ハーティは^1　ヘッドハーティに&　 自分のラテを　ひと口あげた)/%",
  "obj_npc_cafe_slash_Other_10_gml_55_0": "＊ (ヘッドハーティは&　 あまり　さみしくなさそうだ…)/%",
  "obj_npc_cafe_slash_Other_10_gml_61_0": "＊ ボクたち　相性サイアクだけど^1…&　 いっしょに　お茶はするんだよ。/%",
  "obj_npc_cafe_slash_Other_10_gml_66_0": "＊ ピーポー^1！&　 次こそ必ず　しとめてやる…^1！&　 お砂糖^1　もっと？/%",
  "obj_npc_cafe_slash_Other_10_gml_72_0": "＊ [ミャオウ]/%",
  "obj_npc_cafe_slash_Other_10_gml_77_0": "＊ [ブルブル…]/%",
  "obj_npc_cafe_slash_Other_10_gml_83_0": "＊ (…注文したエナジードリンクの缶を&　 つぶされて^1　ウザそうだ)/%",
  "obj_npc_cafe_slash_Other_10_gml_88_0": "＊ (そのへんに置いてあるドリンクを&　 かたっぱしから&　 にぎりつぶしている)/%",
  "obj_npc_cafe_slash_Other_10_gml_100_0": "＊ (…同席者が静かなので&　 くつろいでいるようだ)/%",
  "obj_npc_cafe_slash_Other_10_gml_110_0": "＊ (…)/%",
  "obj_npc_cafe_slash_Other_10_gml_120_0": "＊ (…いまにもテーブルを&　 ひっくり返しそうだ)/%",
  "obj_npc_cafe_slash_Other_10_gml_124_0": "＊ (…南側の席をじっと見なが^1ら&　 自分のドリンクの缶を&　 にぎりつぶしている)/%",
  "obj_npc_conbini_slash_Step_0_gml_55_0": "\\E5＊ お。わすれもの？/",
  "obj_npc_conbini_slash_Step_0_gml_57_0": "\\E1＊ ええ^1。タマゴを&　 カウンターに　おいて&　 かえっちゃったみたい。/",
  "obj_npc_conbini_slash_Step_0_gml_59_0": "\\E2＊ ま^1　“たまたま”&　 そんなことも&　 あるんじゃないか。/",
  "obj_npc_conbini_slash_Step_0_gml_61_0": "\\E0＊ フフフ…/",
  "obj_npc_conbini_slash_Step_0_gml_62_0": "\\E4＊ そうね　“たま”には&　 しかたがないかも。/",
  "obj_npc_conbini_slash_Step_0_gml_64_0": "\\E5＊ まいにち　だったら&　 “エッグ”いけどな。/",
  "obj_npc_conbini_slash_Step_0_gml_66_0": "\\E4＊ そうね　そうなったら&　 ちょっと　“きみ”が&　 わるいわね。/",
  "obj_npc_conbini_slash_Step_0_gml_68_0": "\\E5＊ ちょっと　わすれっぽい&　 ぐらいじゃないと　&　 おも“しろみ”がない。/",
  "obj_npc_conbini_slash_Step_0_gml_70_0": "\\E4＊ そのてん　わたしは&　 “カラ”かいがいが&　 あるでしょう？　フフフ。/%",
  "obj_npc_conbini_slash_Step_0_gml_82_0": "\\E4＊ きみの　もとダンナだって&　 “ケッコー”&　 おも“しろみ”があるぞ。/%",
  "obj_npc_conbini_slash_Step_0_gml_94_0": "\\E1＊ あ^1…　アズゴア。&　 こんにちは。/",
  "obj_npc_conbini_slash_Step_0_gml_96_0": "\\E0＊ トリィ^1　こんなところで&　 あうとは　きぐうだね^1。&　 そうだ！　ちょうど…/",
  "obj_npc_conbini_slash_Step_0_gml_97_0": "\\E6＊ みせで　あまった&　 はなが　あるんだ^1。&　 もし　よかったら…/",
  "obj_npc_conbini_slash_Step_0_gml_99_0": "\\E1＊ ごめんなさい^1。&　 わたし　もういかなくちゃ。/",
  "obj_npc_conbini_slash_Step_0_gml_101_0": "\\E5＊ ああ^1　ハハ^1！　そうか！&　 じゃあ^1　うちにかえって&　 ゆっくりするといい！/%",
  "obj_npc_conbini_slash_Step_0_gml_124_0": "\\E3＊ その^1…&　 アズリエルが&　 かえってきたら…/%",
  "obj_npc_conbini_slash_Step_0_gml_131_0": "\\E1＊ ええ^1　そのことは&　 ちかいうちに　みんなで&　 はなしあいましょう。/",
  "obj_npc_conbini_slash_Step_0_gml_133_0": "\\E6＊ がってん　しょうち^1！&　 クリスにも　よろしく。/",
  "obj_npc_conbini_slash_Step_0_gml_135_0": "\\E1＊ ええ。&　 それじゃ　ごきげんよう。/%",
  "obj_npc_conbini_slash_Step_0_gml_153_0": "\\E2＊ …/",
  "obj_npc_conbini_slash_Step_0_gml_154_0": "\\E2＊ ようけんは&　 わかっているだろう？/",
  "obj_npc_conbini_slash_Step_0_gml_156_0": "\\E1＊ …ああ。/",
  "obj_npc_conbini_slash_Step_0_gml_157_0": "\\E2＊ “タダピクルス”&　 もらいに　きたんだろ。/",
  "obj_npc_conbini_slash_Step_0_gml_159_0": "\\E5＊ そう^1！&　 いやあ　たすかるよ！/",
  "obj_npc_conbini_slash_Step_0_gml_160_0": "\\E2＊ …/",
  "obj_npc_conbini_slash_Step_0_gml_161_0": "\\E2＊ ひとつ　きいても？/",
  "obj_npc_conbini_slash_Step_0_gml_162_0": "\\E2＊ どんな　はなを　わたせば…/",
  "obj_npc_conbini_slash_Step_0_gml_163_0": "\\E3＊ かのじょは　むかしの&　 きもちを　おもいだして&　 くれるだろう？/",
  "obj_npc_conbini_slash_Step_0_gml_165_0": "\\E2＊ あー…/",
  "obj_npc_conbini_slash_Step_0_gml_166_0": "\\E0＊ それは　じぶんの&　 みせの　はなにでも&　 きいたらどうだ？/",
  "obj_npc_conbini_slash_Step_0_gml_168_0": "\\E5＊ ハハ^1！　いわれなくて^1も&　 あいつらには　まっさきに&　 きいてみたさ！/",
  "obj_npc_conbini_slash_Step_0_gml_169_0": "\\E3＊ ほんとうに&　 ききじょうずでね^1。&　 はなというのは。/",
  "obj_npc_conbini_slash_Step_0_gml_171_0": "\\E5＊ そりゃ　あいつ^1ら&　 じぶんで　あるいて&　 にげられないからな。/",
  "obj_npc_conbini_slash_Step_0_gml_173_0": "\\E0＊ ハハハ。たしかに^1。しかも&　 うちの　みせでは^1　ガラス&　 ケースに　いれているしね。/",
  "obj_npc_conbini_slash_Step_0_gml_175_0": "\\E2＊ ああ…　たし^1か&　 そんな　えいがが&　 あったな。/",
  "obj_npc_conbini_slash_Step_0_gml_177_0": "\\E2＊ そう^1。ちょうど&　 あのえいがに　でてくる&　 はなみたいにね…/",
  "obj_npc_conbini_slash_Step_0_gml_179_0": "\\E0＊ …んじ^1ゃ&　 よい　いちにちを。/",
  "obj_npc_conbini_slash_Step_0_gml_181_0": "\\E6＊ ハハ^1！　がんばるよ！/%",
  "obj_npc_conbini_slash_Step_0_gml_199_0": "\\EK＊ …/",
  "obj_npc_conbini_slash_Step_0_gml_200_0": "\\EK＊ あー…/",
  "obj_npc_conbini_slash_Step_0_gml_201_0": "\\EK＊ いや^1…&　 なんでもねー。/%",
  "obj_npc_dojo_slash_Step_0_gml_45_0": "＊ 見事な戦いっぷりだったぜ！/",
  "obj_npc_dojo_slash_Step_0_gml_46_0": "＊ 約束どお^1り&　 賞品を受け取ってくれ！/",
