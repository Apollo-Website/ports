  "obj_example_cutscene_slash_Step_0_gml_55_0": "\\E3＊ ..^1. Man^1, it got late^1, didn't it...?/%",
  "obj_example_cutscene_slash_Step_0_gml_60_0": "\\E0＊ Well. Guess you should go home^1, huh?/%",
