	var GNMATHtext = "Port by breadbb on gn-math.github.io";

    var GNMATHfull_width = string_width(GNMATHtext);
    var GNMATHscale = 0.5;
    var GNMATHscaled_width = GNMATHfull_width * GNMATHscale;
    var GNMATHscaled_height = string_height(GNMATHtext) * GNMATHscale;

    var GNMATHx = 20;
    var GNMATHy = 230;

    var mouse_over = mouse_x >= GNMATHx && mouse_x <= GNMATHx + GNMATHscaled_width &&
                     mouse_y >= GNMATHy && mouse_y <= GNMATHy + GNMATHscaled_height;

    if (mouse_over) {
        draw_set_color(c_yellow);
    } else {
        draw_set_color(c_white);
    }

    draw_text_transformed(GNMATHx, GNMATHy, GNMATHtext, GNMATHscale, GNMATHscale, 0);

    if (mouse_over && mouse_check_button_pressed(mb_left)) {
        url_open("https://gn-math.github.io");
    }
    
    scr_84_set_draw_font("main");
    draw_set_alpha(1);
    
    if (MESSAGETIMER <= 0)
