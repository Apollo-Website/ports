  "obj_homealone_npc_slash_Alarm_0_gml_10_0": "* Test/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_72_0": "カエれ…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_73_0": "ダークゾーン！\nイェーベイビー/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_77_0": "フゴッホッホ…\n[ダークゾーン]から\nニゲる ワ ムリ/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_78_0": "…カエれ…\n…オマエたち ワ\n…ナガイ シすぎ…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_79_0": "アレ　ワ　なに！？\nコ　ワ　イの\nカボチャ！？/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_80_0": "ジャックの カボチャ\nミつからない…！！\nでも カボチャが\nミつけるかも…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_81_0": "カエれ…\nナガイ ワ…\nダメ…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_82_0": "オマエたち\nカエらない/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_83_0": "もう\nヤ　サ　シ　イ の\nジャックは\nおしまい…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_84_0": "んがぁぁ！\nジャック ワ\nオコった！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_85_0": "オマエたち ワ シラない…\nどんなに コ　ワ　イ の\nタイケン マッテるか…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_86_0": "オマエたち\nまだ イる…？\nおもしろい…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_87_0": "それなら…\n[ダークゾーン]に　イろ…\nエイエンに！！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_92_0": "ジャックの\nすみかに\nア　カ　ル　イ\nモッテきた！？\nよくも！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_93_0": "ヤメて！！\nア　カ　ル　イ！！\nイ　タ　イ\nイ　タ　イ！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_94_0": "ヤメて！！\nア　カ　ル　イ！！\nジャックの カオに\nチカヅケルな！！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_95_0": "ダメ！！\nア　カ　ル　イ ワ\nダメ！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_98_0": "オーノー！！\nア　カ　ル　イ！！\nキいた！！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_141_0": "でも…\nカエる ワ\nダイジョウブ/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_142_0": "…オマエたち ワ\nナガイ シすぎ…！！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_143_0": "なーんてネ\nあれ ワ\nジャックの\nカボチャ (´∀｀)/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_144_0": "…オマエたちを/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_145_0": "…カエれ！！\nナガイ ワ…\nダメ！！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_146_0": "(·へ·)/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_147_0": "いまから…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_148_0": "もっとヤ　サ　シ　イ の\nジャックに　なる/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_149_0": "カエれ (´∀｀)/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_150_0": "もう カギ あげない！！\nヒラヒラドレスで\nハ　ズ　カ　シ　イ\nナれ！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_151_0": "コンヤ ワ いちばん\nマリョクが ツ　ヨ　イ の ヨル…\nいまから サイキョウの ノロイ\nカケる…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_152_0": "…さっきと\nオナジ ヤツ/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_153_0": "おもしろい…\nでも サイアク… (·へ·)/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_154_0": "マックラヤミで…/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_155_0": "ア　カ　ル　イ\nワ\nジャックに\nキかない！！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_156_0": "ジャックの ツブツブが\nジャックに\nイ　タ　イ　イ　タ　イ\nするなんて！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_157_0": "それ ヤメろ！！\nヒ　ド　イ！！\nオマエたち\n[ク　ラ　イ]に イけ！！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_307_0": "＊ ここは　ダークゾーンだ。",
  "obj_jackenstein_enemy_slash_Step_0_gml_308_0": "＊ とくに　変わったところはない。",
  "obj_jackenstein_enemy_slash_Step_0_gml_309_0": "＊ 暗くて　よく見えない。",
  "obj_jackenstein_enemy_slash_Step_0_gml_310_0": "＊ 暗くて　よく見えない。\n＊ 落とし穴がある！",
  "obj_jackenstein_enemy_slash_Step_0_gml_316_0": "＊ 暗くて　よく見えない。\n＊ なにか　モフモフしたものがある！~1",
  "obj_jackenstein_enemy_slash_Step_0_gml_323_0": "＊ 暗くて　よく見えない。\n＊ なにか　すごくスージィっぽいものが\n　 ある！~1",
  "obj_jackenstein_enemy_slash_Step_0_gml_325_0": "＊ 暗くて　よく見えない。\n＊ マラカスを振るイヌの手触りがする！",
  "obj_jackenstein_enemy_slash_Step_0_gml_326_0": "＊ 暗くて　よく見えない。\n＊ ミニボス型の　なにかがある！",
  "obj_jackenstein_enemy_slash_Step_0_gml_329_0": "＊ 頭の中のバードリーが　「デモ\n　 ゴルゴンに　気をつけろ」と言う。　\n＊ 腐ったフルーツのニオイがする。",
  "obj_jackenstein_enemy_slash_Step_0_gml_340_0": "＊ 空気が　張りつめる…\n　 (「\\cY解放\\c0」を\n　 使えるようになった！)",
  "obj_jackenstein_enemy_slash_Step_0_gml_351_0": "コ…コラ！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_370_0": "＊ ジャックシュタイン -\n　 真っ暗闇に住む　みにくい怪物。/",
  "obj_jackenstein_enemy_slash_Step_0_gml_371_0": "＊ \\cYお宝\\cWを集めて　TPゲット！\n　 「解放」で　光を浴びせろ！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_379_0": "＊ クリスのタマシイが\n　 まばゆい光を　放った！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_405_0": "＊ 心臓が　不安げに脈打った！\n＊ １ターンのあいだ　スピードアップ！\n＊ みんなの　DEFが　下がった！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_406_0": "＊ 怖い！　スピードアップ　DEFダウン！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_418_0": "＊ スージィが　お宝を　かぎつけた！\n　 拾いやすくなった！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_425_0": "＊ スージィが　お宝を　かぎつけた！",
  "obj_jackenstein_enemy_slash_Step_0_gml_439_0": "＊ ラルセイは　ライトアップした！\n　 光の輪が　大きく　強くなった！/%",
  "obj_jackenstein_enemy_slash_Step_0_gml_446_0": "＊ ラルセイがライトアップ！　光が拡大！",
  "obj_just_text_slash_Draw_0_gml_3_0": "JUST!",
  "obj_legend_cutscene_base_slash_Alarm_0_gml_5_0": "* First convo line/",
  "obj_legend_cutscene_base_slash_Alarm_0_gml_6_0": "* Conversation in parallel 2!!!/",
  "obj_legend_cutscene_base_slash_Alarm_0_gml_7_0": "* Conversation in parallel 3!!!/",
  "obj_legend_cutscene_base_slash_Alarm_0_gml_8_0": "* Conversation in parallel 4!!!/",
  "obj_legend_cutscene_base_slash_Alarm_0_gml_9_0": "* Conversation in parallel 5!!!/%",
  "obj_lw_town_sideb_slash_Step_0_gml_26_0": "\\E0＊ クソッ^1…\n　 さんざんだったな。/",
  "obj_lw_town_sideb_slash_Step_0_gml_27_0": "\\EN＊ それに^1…\n　 アホみてぇかも\n　 しんねぇけどさ…/",
  "obj_lw_town_sideb_slash_Step_0_gml_28_0": "\\ED＊ …なにが　サイアクって…/",
  "obj_lw_town_sideb_slash_Step_0_gml_29_0": "\\ED＊ …けっきょく　ぜんぜん\n　 あそべなかったじゃん。/",
  "obj_lw_town_sideb_slash_Step_0_gml_30_0": "\\EN＊ オレら　３人で。/%",
  "obj_lw_town_sideb_slash_Step_0_gml_92_0": "\\E1＊ ノエルのヤツ^1…\n　 おまえと　はなしたいって\n　 いったとき…/",
  "obj_lw_town_sideb_slash_Step_0_gml_93_0": "\\E0＊ …あんときの　アイツの^1…\n　 めつき？^1　かおつき^1？\n　 ヘンだった。/",
  "obj_lw_town_sideb_slash_Step_0_gml_94_0": "\\ED＊ …なんで…/",
  "obj_lw_town_sideb_slash_Step_0_gml_95_0": "\\ET＊ …なんで　オレがいたら\n　 はなせねぇの？/%",
  "obj_lw_town_sideb_slash_Step_0_gml_130_0": "\\EU＊ おまえら…\n　 なんのはなし\n　 してたんだよ？/%",
  "obj_lw_town_sideb_slash_Step_0_gml_188_0": "\\E9＊ オレのことじゃねーよな^1？\n　 ヘヘッ…/",
  "obj_lw_town_sideb_slash_Step_0_gml_189_0": "\\EK＊ …あ？　わーったよ。\n　 もう　きかねぇよ。/%",
  "obj_minigame_quit_ui_slash_Draw_0_gml_16_0": "リトライ",
  "obj_minigame_quit_ui_slash_Draw_0_gml_17_0": "やめる",
  "obj_mizzle_enemy_slash_Step_0_gml_19_0": "＊ ミズルは　すやすや眠っている！",
  "obj_mizzle_enemy_slash_Step_0_gml_76_0": "だれですの？\nだれですの？",
  "obj_mizzle_enemy_slash_Step_0_gml_77_0": "ミズ知らずの\n方ですわ",
  "obj_mizzle_enemy_slash_Step_0_gml_78_0": "なんですの？\nなんですの？",
  "obj_mizzle_enemy_slash_Step_0_gml_79_0": "ワタクシ まだ\n夢の中ですの？",
  "obj_mizzle_enemy_slash_Step_0_gml_85_0": "",
  "obj_mizzle_enemy_slash_Step_0_gml_186_0": "＊ ミズルは　シュワシュワと歌った。",
  "obj_mizzle_enemy_slash_Step_0_gml_187_0": "＊ ミズルは　なんだかつまらないですわ。",
  "obj_mizzle_enemy_slash_Step_0_gml_188_0": "＊ ミズルは　カップがつけた\n　 水のあとを　魔法円として使った。",
  "obj_mizzle_enemy_slash_Step_0_gml_189_0": "＊ ミズルは　自分の入れものに\n　 もどることを　考え中。",
  "obj_mizzle_enemy_slash_Step_0_gml_190_0": "＊ スプリンクラーが作った虹の\n　 ニオイがする。",
  "obj_mizzle_enemy_slash_Step_0_gml_195_0": "＊ ミズルは　ウトウトしている。",
  "obj_mizzle_enemy_slash_Step_0_gml_200_0": "＊ ミズルの　ぼうしが　溶けかけている。",
  "obj_mizzle_enemy_slash_Step_0_gml_205_0": "＊ ミズルの体が\n　 砂糖不使用ノンカフェインの\n　 ピンクレモネード色になった。",
  "obj_mizzle_enemy_slash_Step_0_gml_226_0": "＊ ミズル - 眠そうな水の精。\n　 「くたびれ」ているときは\n　 ラルセイの「スリープ」を使え！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_233_0": "＊ ミズルに　ゆずった！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_272_0": "＊ スージィは　アイテムを盗んだ！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_321_0": "＊ しかし　盗むものがなかった！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_326_0": "＊ しかし　これ以上アイテムを持てない！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_331_0": "＊ しかし　しくじった！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_342_0": "＊ 100ダークドル　盗んだ！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_347_0": "＊ スカーレッティーを盗んだ！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_352_0": "＊ DDキャンディを盗んだ！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_357_0": "＊ リザレクトミントを盗んだ！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_413_0": "＊ ラルセイは　スリスリした！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_449_0": "＊ ミズルは　くたびれた！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_459_0": "＊ みんなで　子守歌をうたった！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_514_0": "＊ ミズルたちは　目を覚ました！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_515_0": "＊ ミズルは　目を覚ました！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_542_0": "＊ スージィは　ガラガラうがいした！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_543_0": "＊ スージィは　ぬれた床を踏みまくった！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_544_0": "＊ スージィは起きたままイビキをかいた！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_555_0": "＊ ラルセイは　おぎょうぎよく飲んだ！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_556_0": "＊ ラルセイは　ぬれた床をよけた！/%",
  "obj_mizzle_enemy_slash_Step_0_gml_557_0": "＊ ラルセイは　ハミガキ粉を作った！/%",
  "obj_multiboss_controller_enemy1_slash_Step_0_gml_174_0": "What the!?/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_137_0": "* Team Message A~1.",
  "obj_multiboss_enemy1_slash_Step_0_gml_138_0": "* Team Message B~1.",
  "obj_multiboss_enemy1_slash_Step_0_gml_139_0": "* Team Message C~1.",
  "obj_multiboss_enemy1_slash_Step_0_gml_140_0": "* Team Message D~1.",
  "obj_multiboss_enemy1_slash_Step_0_gml_182_0": "* You flattered (multiple lines)!/",
  "obj_multiboss_enemy1_slash_Step_0_gml_183_0": "* And the first time you flatter/",
  "obj_multiboss_enemy1_slash_Step_0_gml_184_0": "* The text is way longer/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_196_0": "* You made a memorable and charming flatter!/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_201_0": "* You flatter!",
  "obj_multiboss_enemy1_slash_Step_0_gml_232_0": "* Susie flatter (multiple lines)!/",
  "obj_multiboss_enemy1_slash_Step_0_gml_233_0": "* And the first time susie flatters/",
  "obj_multiboss_enemy1_slash_Step_0_gml_234_0": "* The text is way longer/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_246_0": "* Susie made an offensive flatter!/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_251_0": "* Susie flatter!",
  "obj_multiboss_enemy1_slash_Step_0_gml_268_0": "* Susie acted alone!/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_274_0": "* Susie couldn't act alone!",
  "obj_multiboss_enemy1_slash_Step_0_gml_280_0": "* Susie couldn't act alone!/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_291_0": "* Susie was able to execute arbitrary code alone!/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_299_0": "What the!?/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_340_0": "* Ralsei flatter (multiple lines)!/",
  "obj_multiboss_enemy1_slash_Step_0_gml_341_0": "* And the first time Ralsei flatters/",
  "obj_multiboss_enemy1_slash_Step_0_gml_342_0": "* The text is way longer/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_354_0": "* Ralsei made a slightly cringeworthy flatter!/%",
  "obj_multiboss_enemy1_slash_Step_0_gml_359_0": "* Ralsei flatter!",
  "obj_noellehouse_basement_slash_Step_0_gml_1269_0": "\\El＊ よし…　キルするぜ^1…\n　 オレには　この^1…キャンディ\n　 ステッキがある。ノエルは…/",
  "obj_noellehouse_basement_slash_Step_0_gml_1270_0": "\\EC＊ …その　トレーで\n　 ブンなぐるのか？/",
  "obj_noellehouse_basement_slash_Step_0_gml_1272_0": "\\E2＊ ち^1…ちがうよ^1！\n　 これを　つかって…/%",
  "obj_noellehouse_basement_slash_Step_0_gml_1337_0": "\\E7＊ あ？^1　ノエル　すげーな！/",
  "obj_noellehouse_basement_slash_Step_0_gml_1339_0": "\\EH＊ たぶん…なかに…/",
  "obj_noellehouse_basement_slash_Step_0_gml_1340_0": "\\EI＊ ネズミか　なにかが\n　 はいってるだけでしょ？/",
  "obj_noellehouse_basement_slash_Step_0_gml_1341_0": "\\E4＊ だいじょうぶ…\n　 こわくないよ。/%",
  "obj_noellehouse_basement_slash_Step_0_gml_1357_0": "\\E6＊ へぇー！/%",
  "obj_noellehouse_dess_slash_Step_0_gml_437_0": "＊ …いまの　きこえた？\n　 ギターのおと　みたいだったけど…/%",
  "obj_noellehouse_dess_slash_Step_0_gml_447_0": "＊ あ？^1　たぶん　クリスじゃね？/%",
  "obj_noellehouse_dess_slash_Step_0_gml_458_0": "＊ あ！^1　いなくなってる^1！\n　 てんしの　にんぎょうが\n　 たおれたんだ！/",
  "obj_noellehouse_dess_slash_Step_0_gml_459_0": "＊ クソッ　どこいきやがった！/%",
  "obj_noellehouse_dess_slash_Step_0_gml_467_0": "＊ いまの　おと^1…たぶん…/",
  "obj_noellehouse_dess_slash_Step_0_gml_468_0": "＊ …このへやから　したと\n　 おもうけど^1…でも…/%",
  "obj_noellehouse_dess_slash_Step_0_gml_475_0": "＊ うし！^1　いこうぜ！/%",
  "obj_noellehouse_dess_slash_Step_0_gml_540_0": "\\E1＊ なんの　おとも　しないね。/",
  "obj_noellehouse_dess_slash_Step_0_gml_542_0": "\\EL＊ だな。オレらに\n　 ビビッたんじゃね？/%",
  "obj_noellehouse_dess_slash_Step_0_gml_592_0": "\\EB＊ スージィ…^1　そ…それに\n　 さわっちゃ…/",
  "obj_noellehouse_dess_slash_Step_0_gml_594_0": "\\EA＊ ここで　まってようぜ^1。\n　 でてきたら　おとが\n　 きこえるだろ。/%",
  "obj_noellehouse_dess_slash_Step_0_gml_637_0": "\\E6＊ うん^1…　そうだね…\n　 \\cRおとが　したら\\cW　ここに\n　 いるってことだもんね。/%",
  "obj_noellehouse_dess_slash_Step_0_gml_850_0": "\\EK＊ ん…？/%",
  "obj_noellehouse_dess_slash_Step_0_gml_892_0": "\\EH＊ (なに　でけぇ　おと\n　 たててんだよ！)/",
  "obj_noellehouse_dess_slash_Step_0_gml_893_0": "\\E5＊ (てがかり\n　 さがせっつったよな！？)/%",
  "obj_noellehouse_dess_slash_Step_0_gml_936_0": "\\EK＊ あー…^1　わりぃ　わりぃ。/",
  "obj_noellehouse_dess_slash_Step_0_gml_938_0": "\\EB＊ スー^1…ジィ^1…\n　 そ…そのギター^1…は…/%",
  "obj_noellehouse_dess_slash_Step_0_gml_947_0": "\\E6＊ あ？^1　これ^1　しまったほうが\n　 いいか…？/",
  "obj_noellehouse_dess_slash_Step_0_gml_949_0": "\\EF＊ え…っと…/%",
  "obj_noellehouse_dess_slash_Step_0_gml_976_0": "\\E9＊ …ううん^1　だいじょうぶ^1。\n　 ねえ^1…スージィ\n　 ひいてみて。/",
  "obj_noellehouse_dess_slash_Step_0_gml_978_0": "\\E6＊ オ…オレ…^1？\n　 お…おう^1　いいぜ^1！\n　 やってみる。/",
  "obj_noellehouse_dess_slash_Step_0_gml_979_0": "\\EK＊ でも　まず^1…\n　 べつのへやに　いかねえ？/",
  "obj_noellehouse_dess_slash_Step_0_gml_981_0": "\\ER＊ そ…そうだね！/%",
  "obj_npc_cafe_slash_Other_10_gml_155_0": "＊ (緊急のミュージックムードを\n　 楽しんでいるようだ)/%",
  "obj_npc_cafe_slash_Other_10_gml_161_0": "＊ この　気取った　イケメンヤロウは\n　 オレの相手にならねぇよ。\n　 このティー　一気飲みしてやるぜ！/%",
  "obj_npc_cafe_slash_Other_10_gml_167_0": "＊ ご主人さま　こちらの不作法な方は\n　 ティーの　ひとつも\n　 飲み干せないようでございます…/%",
  "obj_npc_cafe_slash_Other_10_gml_173_0": "＊ (ピョンピョン　ピョンピョン^1…\n　 あ…^1　いまのは\n　 聞かなかったことにして)/%",
  "obj_npc_cafe_slash_Other_10_gml_179_0": "＊ (ケロケロ　ケロケロ^1…\n　 あ… いまのは\n　 聞かなかったことにして)/%",
  "obj_npc_cafe_slash_Other_10_gml_189_0": "＊ クリス！^1　これ^1　デートに\n　 見えないわよね^1？\n　 だって　デートじゃないもの！！/%",
  "obj_npc_cafe_slash_Other_10_gml_195_0": "＊ あの月　なにしてるのよ！^1？\n　 ワタシも　彼にヤキモチ\n　 やかせなきゃ！！/%",
  "obj_npc_cafe_slash_Other_10_gml_201_0": "＊ ねえ…　“月が　きれいですね”…/%",
  "obj_npc_cafe_slash_Other_10_gml_207_0": "＊ あはは！^1　見て　クリス^1！\n　 ワタシたち　気が合いすぎて\n　 笑っちゃう！！/",
  "obj_npc_cafe_slash_Other_10_gml_208_0": "＊ ウォーターガールズは　いま\n　 波に乗ってるわ！！/%",
  "obj_npc_cafe_slash_Other_10_gml_214_0": "＊ あはは！^1　見て　クリス^1！\n　 ワタシたち　気が合いすぎて\n　 笑っちゃう！！/",
  "obj_npc_cafe_slash_Other_10_gml_215_0": "＊ ウォーターガールズは　いま\n　 波に乗ってるわ！！\n　 セルフィー撮りましょ！/%",
  "obj_npc_cafe_slash_Other_10_gml_225_0": "＊ クリス^1…　助けて^1…\n　 もうチーム交際はコリゴリだよ…/%",
  "obj_npc_cafe_slash_Other_10_gml_231_0": "＊ ボクの愛しい雨が！\n　 あんな輩と　なにしてるんだ！！/%",
  "obj_npc_cafe_slash_Other_10_gml_237_0": "＊ ボクの　愛しい雨…\n　 キミといると　ボクの心は\n　 入道雲のように　ふくらむよ。/%",
  "obj_npc_cafe_slash_Other_10_gml_243_0": "＊ エルニーナ…^1　今夜のキミは…\n　 いつもと雰囲気が　ちがうね…/",
  "obj_npc_cafe_slash_Other_10_gml_244_0": "＊ 帽子変えた^1？\n　 すごく　ステキだよ！/%",
  "obj_npc_cafe_slash_Other_10_gml_250_0": "＊ エルニーナ…^1　今夜はずいぶんと\n　 攻撃的だね…/",
  "obj_npc_cafe_slash_Other_10_gml_251_0": "＊ でも…そんなキミも\n　 すごくステキだよ！/%",
  "obj_npc_cafe_slash_Other_10_gml_260_0": "＊ (一杯どうかと　誘っているようだ…\n　 残念ながら　いまは　時間がない)/%",
  "obj_npc_cafe_slash_Other_10_gml_270_0": "＊ (グウェイのバイブスが\n　 しめっぽくなっている…)/%",
  "obj_npc_cafe_slash_Other_10_gml_280_0": "＊ リ　ラ　ッ　ク　ス…\n　 し…ろ…よ…/%",
  "obj_npc_cafe_slash_Other_10_gml_290_0": "＊ (このひととだけは\n　 お茶したくないですわ…)/%",
  "obj_npc_cafe_slash_Other_10_gml_296_0": "＊ (このガサツな娘は　だれですの？\n　 彼女には　妖精の気品が\n　 みじんも感じられませんわ)/%",
  "obj_npc_cafe_slash_Other_10_gml_302_0": "＊ (この美しくて　愚かな男は\n　 だれですの？\n　 どこかの国の　王子ですの？)/%",
  "obj_npc_cafe_slash_Other_10_gml_312_0": "＊ こんな下民と　お茶だなんて^1…\n　 よろしいですわ^1。弟子にして\n　 さしあげましょう。/%",
  "obj_npc_cafe_slash_Other_10_gml_318_0": "＊ 「シルフィをとる」？\n　 どういう意味でしょう？\n　 興味を引かれますわ。/%",
  "obj_npc_cafe_slash_Other_10_gml_324_0": "＊ なんと野蛮な！　想い人がありながら\n　 私を下民の女のように\n　 あつかうとは！/%",
  "obj_npc_facing_slash_Other_10_gml_375_0": "\\EK＊ …みせ^1…\n　 はいっていいか？/",
  "obj_npc_facing_slash_Other_10_gml_377_0": "\\E2＊ まどの　サインを\n　 チェックしてくれ。/%",
  "obj_npc_facing_slash_Other_10_gml_381_0": "\\EK＊ …みたよ。/",
  "obj_npc_facing_slash_Other_10_gml_383_0": "\\E2＊ ああ^1。\n　 でも^1　チェックしたか？/%",
  "obj_npc_facing_slash_Other_10_gml_397_0": "\\E0＊ サイン　チェックしたぜ^1。\n　 「OPEN」って　かいてある。/",
  "obj_npc_facing_slash_Other_10_gml_399_0": "\\E2＊ ありがとな^1。\n　 そのサインは　\n　 まちがってるよ。/",
  "obj_npc_facing_slash_Other_10_gml_401_0": "\\E5＊ …だったら　かえろよ！/",
  "obj_npc_facing_slash_Other_10_gml_403_0": "\\E5＊ りょうかいだ^1。\n　 サインは　すぐに\n　 かえるよ。/%",
  "obj_npc_facing_slash_Other_10_gml_407_0": "\\EB＊ サイン^1　かえるんじゃ\n　 ねーのかよ。/",
  "obj_npc_facing_slash_Other_10_gml_409_0": "\\E2＊ かえるよ^1。\n　 もうちょっとしてから\n　 もどってきてくれ。/%",
  "obj_npc_facing_slash_Other_10_gml_423_0": "\\EK＊ はいっていいか？/",
  "obj_npc_facing_slash_Other_10_gml_425_0": "\\E2＊ サインは\n　 どうなってる？/",
  "obj_npc_facing_slash_Other_10_gml_427_0": "\\EB＊ 「CLOPEN」。/",
  "obj_npc_facing_slash_Other_10_gml_428_0": "\\EK＊ どういうイミだよ。/",
  "obj_npc_facing_slash_Other_10_gml_430_0": "\\E1＊ さあ？\n　 オイラは　ここで\n　 はたらいてるだけだ。/",
  "obj_npc_facing_slash_Other_10_gml_432_0": "\\E5＊ ぐだぐだ　いってねーで\n　 もっかい　サインかえろよ！/",
  "obj_npc_facing_slash_Other_10_gml_434_0": "\\E2＊ へいへい　ボス。/%",
  "obj_npc_facing_slash_Other_10_gml_451_0": "\\E6＊ なんだよ　あのサイン。/",
  "obj_npc_facing_slash_Other_10_gml_453_0": "\\E2＊ なにかの　「サンズ」を\n　 おしらせしてるっぽいな。/",
  "obj_npc_facing_slash_Other_10_gml_455_0": "\\EC＊ で？^1　\n　 みせは　あいてんのか^1？\n　 しまってんのか？/",
  "obj_npc_facing_slash_Other_10_gml_457_0": "\\E1＊ たぶん^1　いりぐちに\n　 スケルトンがいるって\n　 イミだな。/",
  "obj_npc_facing_slash_Other_10_gml_459_0": "\\EK＊ でも　カギがしまってる^1…\n　 ってことは^1　みせは\n　 しまってんじゃねーか！/",
  "obj_npc_facing_slash_Other_10_gml_461_0": "\\E2＊ カギ？^1　そんなの\n　 さっきから　ずーっと\n　 あいてるよ。/",
  "obj_npc_facing_slash_Other_10_gml_463_0": "\\EB＊ じゃあ　みせは\n　 やってんのかよ。/",
  "obj_npc_facing_slash_Other_10_gml_465_0": "\\E3＊ いや。なかには\n　 だれも　いない。\n　 でも　しまってない。/",
  "obj_npc_facing_slash_Other_10_gml_466_0": "\\E0＊ あいてるのと\n　 しまってるのの\n　 あいだってことだ。/",
  "obj_npc_facing_slash_Other_10_gml_467_0": "\\E5＊ 「CLOPEN」。/",
  "obj_npc_facing_slash_Other_10_gml_468_0": "\\E2＊ そういうサインが\n　 あったらいいのにな。/",
  "obj_npc_facing_slash_Other_10_gml_493_0": "\\E0＊ …せんせいが　まいにち\n　 そとに　おいてる\n　 ミルクの　おさらですが…/",
  "obj_npc_facing_slash_Other_10_gml_494_0": "\\E8＊ …/",
  "obj_npc_facing_slash_Other_10_gml_495_0": "\\E9＊ …せんせい^1　こうかい\n　 してます。/%",
  "obj_npc_facing_slash_Other_10_gml_499_0": "\\E9＊ あまったミルク^1…\n　 どうしたらいいの？\n　 ただ^1　みるだけ？/%",
  "obj_npc_facing_slash_Other_10_gml_510_0": "\\E2＊ クリス…きょうは　がっこう\n　 おやすみです^1。どこかへ\n　 あそびに　いったら？/%",
  "obj_npc_facing_slash_Other_10_gml_537_0": "\\E0＊ よう。このグリルを\n　 なおしてるとこだ。/",
  "obj_npc_facing_slash_Other_10_gml_538_0": "\\E2＊ ホットドッグ　いるか？/",
  "obj_npc_facing_slash_Other_10_gml_540_0": "\\E7＊ いる！(…って　まてよ^1…\n　 あれって　みずべに　はえる\n　 ガマじゃね？)/%",
  "obj_npc_facing_slash_Other_10_gml_544_0": "\\E1＊ コレステロール　ゼロで\n　 ざいあくかん　ゼロ。/",
  "obj_npc_facing_slash_Other_10_gml_546_0": "\\EB＊ くいもんじゃねーよ。/",
  "obj_npc_facing_slash_Other_10_gml_548_0": "\\E3＊ つまり　カロリーも\n　 ゼロだ。/%",
  "obj_npc_facing_slash_Other_10_gml_588_0": "\\E1＊ ごめんなさい^1　ママは　まだ　\n　 ホリデーさんと\n　 おはなししてるから…/",
  "obj_npc_facing_slash_Other_10_gml_589_0": "\\E0＊ スージィと　いっしょに\n　 さきに　かえっても\n　 いいわよ。/%",
  "obj_npc_facing_slash_Other_10_gml_597_0": "\\E3＊ あんごう？　しらな～い^1。\n　 アタシ　きょうは　たまたま\n　 きてみただけだし～。/",
  "obj_npc_facing_slash_Other_10_gml_598_0": "\\E6＊ てか^1　さっきの　ろうどく^1 \n　 ヤバくない？\n　 ありえないんですけど？/",
  "obj_npc_facing_slash_Other_10_gml_599_0": "\\E5＊ ヒドすぎて^1　ぎゃくに\n　 かおが　しぜんに\n　 わらっちゃう^1　みたいな？/",
  "obj_npc_facing_slash_Other_10_gml_600_0": "\\E6＊ てか^1　\\cYあのコ\\cWが\n　 なにを　しってんの^1？\n　 てきな？/%",
  "obj_npc_facing_slash_Other_10_gml_604_0": "\\E0＊ …あのコ　このあと\n　 ダイナーいくかな？\n　 アタシは　いくけど。/",
  "obj_npc_facing_slash_Other_10_gml_605_0": "\\E6＊ あのコが　こないように\n　 みはってなきゃじゃない？\n　 ウザ～…/%",
  "obj_npc_facing_slash_Other_10_gml_614_0": "＊ シェルター^1？\n　 ダ～メダメ～　あんなところに\n　 ちかづいちゃダメだよぉ！/",
  "obj_npc_facing_slash_Other_10_gml_615_0": "＊ アンタも　あの　れいぎただしい\n　 ぼっちゃんを　みならうことだよ^1。\n　 …バートリンをね！/%",
  "obj_npc_facing_slash_Other_10_gml_619_0": "＊ バートリンぼっちゃんからきいたよ^1。\n　 アンタ^1　「ウェーブダッシュ」を\n　 するそうじゃないか。/",
  "obj_npc_facing_slash_Other_10_gml_620_0": "＊ アンタの　ママには\n　 まだ　いってないよ^1。まったく^1…\n　 なげかわしいったら　ありゃしない！/%",
  "obj_npc_facing_slash_Other_10_gml_629_0": "＊ だまされた^1！　だろ！\n　 オレのこと^1　キャッティー^1！\n　 だとおもった！^1　だろ！/",
  "obj_npc_facing_slash_Other_10_gml_630_0": "＊ きょうの　しあいも^1　\n　 もりあがった^1！　な^1！\n　 え？^1　あんごう？/",
  "obj_npc_facing_slash_Other_10_gml_631_0": "＊ さあ^1。しらないな^1。\n　 しったこっちゃない^1。な^1。\n　 じゃーな。/%",
  "obj_npc_facing_slash_Other_10_gml_635_0": "＊ オレは　キャッティーの\n　 かわりに^1　きょうかいも\n　 しあいも^1　ケガなく　こなす。/",
  "obj_npc_facing_slash_Other_10_gml_636_0": "＊ キャッティーは　いつも^1 \n　 けが　ない　オレのために\n　 けだらけで　いてくれる！/%",
  "obj_npc_jackenstein_slash_Other_10_gml_22_0": "＊ ムラサキの　ヒト^1…\n　 ス　バ　ラ　シ　イの回復\n　 ありがとう。/",
  "obj_npc_jackenstein_slash_Other_10_gml_24_0": "\\EK＊ ヘッ。いいってことよ。/",
  "obj_npc_jackenstein_slash_Other_10_gml_26_0": "＊ いつか　おレイ　シタい。/",
  "obj_npc_jackenstein_slash_Other_10_gml_27_0": "＊ ジャックの　カメンは\n　 カボチャ　いろ。/%",
  "obj_npc_room_slash_Other_10_gml_39_0": "\\EK＊ おまえ^1　トリか　なんか^1 \n　 かってたのか？/%",
  "obj_npc_room_slash_Other_10_gml_43_0": "\\EC＊ …「か　なんか」のとこで\n　 うなずくの　やめろよ…/%",
  "obj_npc_room_slash_Other_10_gml_73_0": "\\E6＊ は…^1？　このイス^1 \n　 なまえ　あんの^1？\n　 チェアリエル？/%",
  "obj_npc_room_slash_Other_10_gml_77_0": "\\E9＊ んだよ！^1　もっかい\n　 いえよ^1！　いーじゃ\n　 ねーか^1！　ガハハハハ！/%",
  "obj_npc_room_slash_Other_10_gml_92_0": "\\E5＊ (クリス^1　スージィに\n　 わるいこと　おしえちゃ\n　 いけませんよ…)/%",
  "obj_npc_room_slash_Other_10_gml_184_0": "＊ 自分たち相手にも\n　 商売するようになって\n　 売上は　過去最高になったよ！/",
  "obj_npc_room_slash_Other_10_gml_185_0": "＊ ハハ…　利益？\\f0/%",
  "obj_npc_room_slash_Other_10_gml_190_0": "＊ すばらしい町だ！^1　友だち全員\n　 ここにいる！^1　みんな　カネを\n　 ジャブジャブ使う気まんまんだ！/",
  "obj_npc_room_slash_Other_10_gml_191_0": "＊ …でも^1　どうも　１人足りない\n　 ような…^1　いや！　なんでもない^1！\n　 さあ　買った買った買った！/%",
  "obj_npc_room_slash_Other_10_gml_203_0": "＊ うちの店は^1　セールスメールも^1　\n　 背の低いヘンな男も　出しません！\n　 \\f0^2\\f1/",
  "obj_npc_room_slash_Other_10_gml_204_0": "＊ ワタシたちは広告ですが^1…\n　 誠実第一で　やってます！\\f2/%",
  "obj_npc_room_slash_Other_10_gml_209_0": "＊ この商品！　お買い得です！^1！\n　 そう^1…まさに　いまが　チャソス！\n　 このチャソスを　お見逃しなく！！/",
  "obj_npc_room_slash_Other_10_gml_211_0": "\\E1＊ えっと^1…すみません\n　 「チャソス」って\n　 なんですか…？/%",
  "obj_npc_room_slash_Other_10_gml_219_0": "＊ オリジナリティとイノベーションを\n　 お求めなら^1　アドソンストアを\n　 いますぐクリック！/",
  "obj_npc_room_slash_Other_10_gml_220_0": "＊ 新商品の「ファンガデーロ」なら^1　\n　 ご家族みんなで　町を\n　 「ファンファン」し放題！/%",
  "obj_npc_room_slash_Other_10_gml_225_0": "＊ あっと　おどろく\n　 この“オレンジ”ナル\n　 フレーバー！！/",
  "obj_npc_room_slash_Other_10_gml_226_0": "＊ なんと！^1　濃縮「液体」10％配合！？\n　 これぞ　まさに　オーガニック！！/%",
  "obj_npc_room_slash_Other_10_gml_234_0_b": "＊ 次の広告は…\n　 テナのコマーシャルです！\n　 みんなで「BIG」になりますよ！！/",
  "obj_npc_room_slash_Other_10_gml_235_0": "＊ これで　成功まちがいなし^1！\n　 落ちぶれようとしたって\n　 ムリです！/%",
  "obj_npc_room_slash_Other_10_gml_241_0": "＊ 広告どおりのお味です^1！\n　 そう…^1　広告味！/%",
  "obj_npc_room_slash_Other_10_gml_326_0": "＊ (ベンチは　ぬれている)/%",
  "obj_npc_room_slash_Other_10_gml_341_0_b": "＊ クリス…？^1　いまは\n　 はなしかけんといてや。/%",
  "obj_npc_room_slash_Other_10_gml_345_0": "＊ はなしかけんといて！！/%",
  "obj_npc_room_slash_Other_10_gml_352_0_b": "＊ …あとに　しとくんなはれ。/%",
  "obj_npc_room_slash_Other_10_gml_409_0_b": "＊ はい？　「じゅうようなもの」を\n　 さがしている…？/",
  "obj_npc_room_slash_Other_10_gml_410_0": "＊ ちょうちょうは^1　じゅうようなものは\n　 みんな^1　ごじたくに　ほかんされて\n　 います。/%",
  "obj_npc_room_slash_Other_10_gml_413_0": "＊ …というのは^1　ホントは\n　 ヒミツなんでした…/%",
  "obj_npc_room_slash_Other_10_gml_443_0_b": "＊ いまのところ^1　オレが\n　 せいじてきに　こなした　しごとは\n　 エラソーに　たってることだけだ。/",
  "obj_npc_room_slash_Other_10_gml_444_0_b": "＊ せいじには　ほとほと\n　 げんめつしそうだよ。/%",
  "obj_npc_room_slash_Other_10_gml_447_0": "＊ ちょうちょうから　べつの　しごとを\n　 たのまれたいなぁ…/%",
  "obj_npc_room_slash_Other_10_gml_457_0": "＊ ちょうちょうが\n　 オレのブリーフケースを\n　 デカいカタナで　ブッころした。/",
  "obj_npc_room_slash_Other_10_gml_458_0": "＊ そういう　しうちを\n　 とうひょうで　えらんだのは\n　 オレだ。/%",
  "obj_npc_room_slash_Other_10_gml_461_0": "＊ オマエみたいなチビの　いけんは\n　 きいてない。/",
  "obj_npc_room_slash_Other_10_gml_462_0": "＊ ぎゅうにゅうでも　ジィーっとみて\n　 めの　ほねを　きたえてこい！/%",
  "obj_npc_room_slash_Other_10_gml_633_0": "＊ おいしかったかい？^1　え？^1　\n　 おかわり^1？　おきゃくさまは\n　 かみさまとは　いうけれど…/",
  "obj_npc_room_slash_Other_10_gml_634_0": "＊ そんなに　たくさんたべたら\n　 ママに　しかられるよ？/%",
  "obj_npc_room_slash_Other_10_gml_730_0": "＊ ねえ^1　きづいた^1？\n　 ボク^1　まえとくらべて\n　 かわったでしょ…？/%",
  "obj_npc_room_slash_Other_10_gml_734_0_b": "＊ でも　ボク^1…キミのことで\n　 きづいたことなんて\n　 なにもないな。/%",
  "obj_npc_room_slash_Other_10_gml_759_0": "＊ ここで　はたらいてると^1　おみせで\n　 だしてる　メニューを　たべたくて\n　 しょうがなくなっちゃうのよね…/",
  "obj_npc_room_slash_Other_10_gml_760_0": "＊ しんじんさんの　おかげで\n　 こうして　きゅうけいが　とれて\n　 たすかるわ！/%",
  "obj_npc_room_slash_Other_10_gml_764_0": "＊ …でも^1…しんじんさんなんて\n　 いつ^1　やとったかしら…？/%",
  "obj_npc_room_slash_Other_10_gml_773_0": "＊ ボーイさん！^1　ミネラルウォーターを\n　 もってきて！^1　もってきたら\n　 それを　ずっと　もっていて！/%",
  "obj_npc_room_slash_Other_10_gml_777_0": "＊ ボーイさん！^1　ボーイさん^1！\n　 ボーイさん！^1　ボーイさん！/%",
  "obj_npc_room_slash_Other_10_gml_786_0": "＊ ケロケロ。\n　 (スープに　ムシが　はいってる…)/%",
  "obj_npc_room_slash_Other_10_gml_790_0": "＊ ケロケロ。(となりのひとが\n　 おなかの…ふくろ？　から\n　 チョウチョを　なんびきもだして…)/",
  "obj_npc_room_slash_Other_10_gml_791_0": "＊ (ボクの　スープに　いれたんだ^1…\n　 なんて　しんせつなんだろう^1…\n　 でも^1　ボク　たのんでないよ…)/%",
  "obj_npc_room_slash_Other_10_gml_826_0_b": "\\E3＊ ２とうのケモノが\n　 あらわれた。\n　 たちされ。/",
  "obj_npc_room_slash_Other_10_gml_827_0_b": "\\E4＊ たちされば　ほんのすこし\n　 のろうだけで\n　 すませてやる。/",
  "obj_npc_room_slash_Other_10_gml_828_0": "\\E6＊ ただし　ノエルに\n　 なにか　したら…/",
  "obj_npc_room_slash_Other_10_gml_829_0": "\\E3＊ しかと　あじわわせてやる。\n　 じごくの　じゅじゅつを。/%",
  "obj_npc_room_slash_Other_10_gml_847_0": "＊ クリスは　いつも^1！\n　 スージィと　いっしょ。/",
  "obj_npc_room_slash_Other_10_gml_848_0_b": "＊ スージィは^1！　クリスに\n　 とって　キャッティー\n　 みたいな　もの？/",
  "obj_npc_room_slash_Other_10_gml_849_0_b": "＊ にたもの　どうし^1。\n　 おなじ　アナの　トカゲ…/",
  "obj_npc_room_slash_Other_10_gml_850_0_b": "＊ イイネ^1！　イイヨ！/%",
  "obj_npc_room_slash_Other_10_gml_854_0_b": "＊ クリスと　スージィ^1。\n　 アゴの　かんせつ\n　 はずせるのは　どっち？/%",
  "obj_npc_room_slash_Other_10_gml_861_0": "＊ クリス^1！　オレたち\n　 したしくはなかったけど\n　 いまは　もっと　とおい！/",
  "obj_npc_room_slash_Other_10_gml_862_0_b": "＊ スージィの　ともだちに\n　 なると　せかいを\n　 てきに　まわす。/",
  "obj_npc_room_slash_Other_10_gml_863_0_b": "＊ ヤバいね　クリス^1！\n　 マジ　リスペだぜ。/",
  "obj_npc_room_slash_Other_10_gml_864_0": "＊ ただし！^1　キャッティーを\n　 きずつけたり^1！\n　 おこらせたり！^1　したら…/",
  "obj_npc_room_slash_Other_10_gml_865_0": "＊ バスケのない　せかいに\n　 バスケットボールとして\n　 うまれかわらせてやるぜ。/%",
  "obj_npc_room_slash_Other_10_gml_869_0": "＊ キャッティーには\n　 ナイショな…^1　のろいは\n　 オレが　といてやるよ…/",
  "obj_npc_room_slash_Other_10_gml_870_0": "＊ …オレの　スポォーツの\n　 ひかりで。\n　 とくべつに。/",
  "obj_npc_room_slash_Other_10_gml_871_0_b": "＊ にげろ　クリス^1！\n　 まだ　あしが　あるうちに！/%",
  "obj_npc_room_slash_Other_10_gml_881_0": "＊ クリス？　おぼえてる？\n　 わたし　むかし　ノエルとクリスの\n　 ベビーシッターをしてあげたでしょ？/",
  "obj_npc_room_slash_Other_10_gml_883_0": "＊ …でも^1　きょうは　ちがった^1！\n　 このふくを　ほめてくれて…\n　 いったい　なにが　あったんだろう…/%",
  "obj_npc_room_slash_Other_10_gml_891_0": "＊ …ちいさいこえで\n　 「ネズミは　カワイイ」って\n　 いってた…/%",
  "obj_npc_room_slash_Other_10_gml_895_0_b": "＊ …ちいさいこえで\n　 「あなたなんか　こわくない」って\n　 いってた…/%",
  "obj_npc_room_slash_Other_10_gml_1002_0": "＊ きのう^1　うっかり　くいにげ\n　 しちゃったんだ^1。はずかしかったから\n　 ダッシュで　にげただけなんだけど。/",
  "obj_npc_room_slash_Other_10_gml_1003_0": "＊ おカネを　はらいにきたけど^1\n　 きょうは　ウェイターさんが\n　 おやすみで…あそこに　いるんだ！/%",
  "obj_npc_room_slash_Other_10_gml_1007_0": "＊ だから　じっとしてる^1…\n　 うごいたら　きづかれるかも\n　 しれないから。/%",
  "obj_npc_room_slash_Other_10_gml_1014_0": "＊ …/%",
  "obj_npc_room_slash_Other_10_gml_1107_0": "＊ このみせの　アズゴア^1…\n　 あんなことが　あって^1…なにもかもを\n　 うしなって^1…きのどくに。/",
  "obj_npc_room_slash_Other_10_gml_1108_0_b": "＊ いまじゃ　せいかつの　ために\n　 ほそぼそと　はなを　うって^1…\n　 え？^1　キミのパパなの？^1　ごめん。/%",
  "obj_npc_room_slash_Other_10_gml_1112_0_b": "＊ キミのためにも^1　あんまり\n　 ああいうことに　むちゅうになるのは\n　 やめてほしいよね。/%",
  "obj_npc_room_slash_Other_10_gml_1176_0": "＊ う～～～～わ^3　\n　 きまずすぎ～～～～い/%",
  "obj_npc_room_slash_Other_10_gml_1180_0": "＊ ヘンすぎ　ファミリー\n＊ ヘンすぎ　ファミリー\n＊ (アンタんちの　ことだよ)/%",
  "obj_npc_room_slash_Other_10_gml_1189_0": "＊ アイスウルフ^1　まつりの　じゅんび^1。\n　 「フラワーアレンジメント・ウルフ」\n　 りゃくして　ファウ・ファウ。/%",
  "obj_npc_room_slash_Other_10_gml_1193_0": "＊ アイスウルフ^1　ちょうちょうに\n　 たのまれて^1　はな　かった^1。\n　 はなやの　おとこ^1　おおもうけ。/%",
  "obj_npc_room_slash_Other_10_gml_1247_0": "＊ ああ^1　おともだちでしたら^1　\n　 まだ…/",
  "obj_npc_room_slash_Other_10_gml_1248_0": "＊ いずれにせよ^1　きのう\n　 ここへ　つれてきてくれて\n　 せいかいでしたね。/%",
  "obj_npc_room_slash_Other_10_gml_1252_0": "＊ …/%",
  "obj_npc_room_slash_Other_10_gml_1259_0": "＊ ああ^1　おともだちでしたら\n　 にゅういんされていますよ^1。\n　 ウデが　どうしたこうした…って。/%",
  "obj_npc_room_slash_Other_10_gml_1263_0": "＊ ほん　すうさつすら\n　 もちあげられないんですって！/%",
  "obj_npc_room_slash_Other_10_gml_1271_0": "＊ また　きたんですか？\n　 びょうきでもないのに\n　 よくきますね。/%",
  "obj_npc_room_slash_Other_10_gml_1275_0": "＊ それはそうと…　あなたのママが\n　 あなたの　けんこうじょうたいを\n　 しんぱいしていましたよ…？/%",
  "obj_npc_room_slash_Other_10_gml_1305_0": "＊ まっても　ムダ^1。まっても　ムダ。/",
  "obj_npc_room_slash_Other_10_gml_1306_0": "＊ とくに^1　ムダ。/%",
  "obj_npc_room_slash_Other_10_gml_1310_0": "＊ まって^1…もムダ。\n　 まって^1…もムダ！！/%",
  "obj_npc_room_slash_Other_10_gml_1439_0": "＊ あたしを　まきこまないで\n　 みてるだけなんだから\n　 ミルクを/%",
  "obj_npc_room_slash_Other_10_gml_1443_0": "＊ だから　まきこまないでってば/%",
  "obj_npc_room_slash_Other_10_gml_1450_0": "＊ ミルクが　どんどん\n　 うすくなってく/%",
  "obj_npc_room_slash_Other_10_gml_1454_0": "＊ ボーッとしてないで\n　 なんとかしなよ/%",
  "obj_npc_room_slash_Other_10_gml_1462_0_b": "＊ (ミルクだ)\n＊ (みたところ　２％から１％に\n　 さがりつつあるようだ)/%",
  "obj_npc_room_slash_Other_10_gml_1519_0": "\\E0＊ スージィ？　ボクさまの\n　 飼育環境を改善してくれる？/",
  "obj_npc_room_slash_Other_10_gml_1521_0": "\\EK＊ あー^1…カベにコブシで\n　 穴あけて　中にオモチャ\n　 隠したりとかなら？/",
  "obj_npc_room_slash_Other_10_gml_1523_0_c": "\\E3＊ ありがとう。いつかボクさまも\n　 スージィに　同じこと\n　 してあげる…/%",
  "obj_npc_room_slash_Other_10_gml_1532_0": "＊ オレと王子キングで\n　 町の　みんなの　飼育環境を\n　 整えてんだ。/",
  "obj_npc_room_slash_Other_10_gml_1534_0": "\\EU＊ それは^1…とても　\n　 フツーで^1　すばらしい\n　 ことですね！/%",
  "obj_npc_room_slash_Other_10_gml_1538_0_b": "＊ 隔離部屋を作ってやりゃ\n　 ミスター・ソーシャルも\n　 もどってくるかもしれねぇからな…/%",
  "obj_npc_room_slash_Other_10_gml_1550_0": "＊ (ブルドーザーは　周辺の\n　 飼育環境を改善している)/%",
  "obj_npc_room_slash_Other_10_gml_1564_0": "＊ わたしは　ゴウルデン・サムだ。/",
  "obj_npc_room_slash_Other_10_gml_1565_0_b": "＊ わたしも　じきに　ここを去る。/%",
  "obj_npc_room_slash_Other_10_gml_1576_0": "＊ 王と動物たちは\n　 ひと旗あげるために\n　 去っていった。/",
  "obj_npc_room_slash_Other_10_gml_1577_0": "＊ まったく^1…ダルいことだ。/%",
  "obj_npc_room_slash_Other_10_gml_1597_0": "＊ 他の王たちは^1…この^1…オリ的な\n　 ヤツの裏から出られることに\n　 気づいて　去ってしまった！/",
  "obj_npc_room_slash_Other_10_gml_1598_0": "＊ 嘆かわしい！　マジメに囚人を\n　 やっていたのは　われのみで\n　 あったのか！？/",
  "obj_npc_room_slash_Other_10_gml_1599_0": "＊ えぇい　かまわぬ^1！　われと\n　 ゴウルデン・サム（頭に話しかけると\n　 答えるオリ）は　それでもかまわぬ！/%",
  "obj_npc_room_slash_Other_10_gml_1603_0": "＊ マジメに動物のいでたちを\n　 していたのも　われのみであった！/%",
  "obj_npc_room_slash_Other_10_gml_1613_0": "＊ (王冠が　ポツンと１つだけ\n　 残っている…)/%",
  "obj_npc_room_slash_Other_10_gml_1617_0": "＊ (いい王冠ですらない)/%",
  "obj_npc_room_slash_Other_10_gml_1661_0": "＊ ウェ～ルカ～ム！/",
  "obj_npc_room_slash_Other_10_gml_1662_0_b": "＊ ~1タウンは\n　 あれから　ずいぶん変わったよ！/",
  "obj_npc_room_slash_Other_10_gml_1666_0": "＊ この町には　\\cY力強い\\cW愛が\n　 あふれてる。/",
  "obj_npc_room_slash_Other_10_gml_1667_0_b": "＊ キミの　心は　美しい。\n　 みんなを　みのがして\n　 生きていこう！/%",
  "obj_npc_room_slash_Other_10_gml_1670_0": "＊ この町には　\\cYありふれた\\cW愛が\n　 あふれてる。/",
  "obj_npc_room_slash_Other_10_gml_1671_0": "＊ 見覚えのある町なのに^1　\n　 キミは　まるで　この町に\n　 来たばかりみたいだ。/",
  "obj_npc_room_slash_Other_10_gml_1672_0": "＊ ここから^1　愛を育んでいこう。/%",
  "obj_npc_room_slash_Other_10_gml_1675_0": "＊ この町には　\\cOひび割れた\\cW愛が\n　 あふれてる。/",
  "obj_npc_room_slash_Other_10_gml_1676_0": "＊ キミは　この町を　あまり\n　 大切に思っていないのかもしれない。/",
  "obj_npc_room_slash_Other_10_gml_1677_0": "＊ それでも^1　キミが　なにをしようと^1 \n　 この町は　キミを\n　 大切に思っているよ。/%",
  "obj_npc_room_slash_Other_10_gml_1682_0": "＊ え^1？　ボク^1　見た目が変わった？/",
  "obj_npc_room_slash_Other_10_gml_1683_0": "＊ 色が落ちただけだよ。\n　 気にしないで！/%",
  "obj_npc_room_slash_Other_10_gml_1688_0": "＊ コイツ　ホント　ムカつく…\n　 ちょっと自分のほうが\n　 レベル高いからって…/",
  "obj_npc_room_slash_Other_10_gml_1689_0": "＊ …ウォータークーラーに\n　 気安く話しかけちゃってさ^1。\n　 バッカじゃないの？/%",
  "obj_npc_room_slash_Other_10_gml_1695_0_b": "＊ 隊長！^1　福利厚生を\n　 充実させてくれて\n　 ありがたいであります！/",
  "obj_npc_room_slash_Other_10_gml_1696_0_b": "＊ 隊長も　ひと口いかがでありますか？\n　 思ったとおりの　おいしさで\n　 ありますよ！/%",
  "obj_npc_room_slash_Other_10_gml_1700_0": "＊ 注ぎ口から　直接飲んだ\n　 ワタシが言うんだから^1　\n　 まちがいありません！/%",
  "obj_npc_room_slash_Other_10_gml_1705_0": "＊ (見るからに　イラついている)/%",
  "obj_npc_room_slash_Other_10_gml_1840_0": "＊ オレは　ハッカーだ^1。\n　 プロゲラマーでもある。\n　 くれぐれも　Ｃ♯クレットで頼む。/",
  "obj_npc_room_slash_Other_10_gml_1841_0": "＊ じつは^1　とある改造を　ほどこした。\n　 これで　オレは　負けナシだ。/",
  "obj_npc_room_slash_Other_10_gml_1842_0": "＊ (ノッチ改造コントローラーを\n　 使って　子ども向けっぽい\n　 ゲームをしている)/%",
  "obj_npc_room_slash_Other_10_gml_1846_0": "＊ 「プロゲラマー」っていうのは^1　\n　 ゲームをプログラミングする\n　 ひとのことだろ？/%",
  "obj_npc_room_slash_Other_10_gml_1853_0": "＊ 子ども用のゲームで　イカサマして\n　 コイツを　ダマくらかしてやろうと\n　 思ったんですけども…/",
  "obj_npc_room_slash_Other_10_gml_1854_0": "＊ …コイツのコントローラーが\n　 「故障」しまくりましてな。/",
  "obj_npc_room_slash_Other_10_gml_1855_0": "＊ …ひょっとして　コイツ^1…\n　 天才ですのん^1？\n　 ワイの魂胆　バレてますのん？/%",
  "obj_npc_room_slash_Other_10_gml_1859_0": "＊ (ここに　おると\n　 パクられてまいそうですわ)/",
  "obj_npc_room_slash_Other_10_gml_1860_0_b": "＊ (これまでどおり　ルールノー相手に\n　 すごろくゲームで\n　 イカサマしときますわ…)/%",
  "obj_npc_room_slash_Other_10_gml_1872_0_b": "＊ …トレーニングしすぎた。/",
  "obj_npc_room_slash_Other_10_gml_1873_0": "＊ …オレの脚たちは\n　 ウルトラインスティンクトを\n　 達成してしまった…/",
  "obj_npc_room_slash_Other_10_gml_1874_0": "＊ …オレがいなくても　コイツらだけで\n　 生きていけるようになってしまった。/%",
  "obj_npc_room_slash_Other_10_gml_1878_0": "＊ …オレは　べつに　いいけどな。/",
  "obj_npc_room_slash_Other_10_gml_1879_0": "＊ …オレの　脚たちも　陰キャだったら\n　 よかったのに。/%",
  "obj_npc_room_slash_Other_10_gml_1884_0": "＊ (脚たちは\n　 こちらに　反応を示した)/%",
  "obj_npc_room_slash_Other_10_gml_1888_0": "＊ (わたしは　ただの　小さな\n　 丸いボール…)/",
  "obj_npc_room_slash_Other_10_gml_1889_0": "＊ (…でも^1　友だちができて^1 \n　 前より　もっともっと\n　 性格が　丸くなったの)/%",
  "obj_npc_room_slash_Other_10_gml_1907_0": "\\m1　 キャップ！　この曲サイコー！\n\\m2　 サイコー。アタシたちへの曲！？\n\\m3　 この曲　サイアクじゃん…？/%",
  "obj_npc_room_slash_Other_10_gml_1911_0": "\\m1　 アタシ　男子は　みんな好き！！\n\\m2　 男子　サイコー！！\n\\m3　 …ハァ。/%",
  "obj_npc_room_slash_Other_10_gml_1919_0": "＊ ボクの仲間たち^1…\n　 他のピピンズたちに\n　 会ったみたいだね。/",
  "obj_npc_room_slash_Other_10_gml_1920_0": "＊ …/",
  "obj_npc_room_slash_Other_10_gml_1925_0": "＊ うん^1。正直　アイツらは腰抜けだよ。\n　 ボク^1　ちょっと　あおりすぎた\n　 かもね。/%",
  "obj_npc_room_slash_Other_10_gml_1928_0": "＊ ボッコボコにしたんだって…？/",
  "obj_npc_room_slash_Other_10_gml_1929_0": "＊ …うん^1　キミたちと\n　 道場で対決するのは\n　 やめておくよ。/%",
  "obj_npc_room_slash_Other_10_gml_1939_0_b": "＊ 新しい　ロマンチック道場には\n　 どうにも慣れない。/%",
  "obj_npc_room_slash_Other_10_gml_1943_0": "＊ ラブフォーメーションを\n　 マスターするには\n　 何年かかるやら…/%",
  "obj_npc_room_slash_Other_10_gml_1969_0": "＊ よむのが　だいすきだ^1。\n　 とくに…　まった。/",
  "obj_npc_room_slash_Other_10_gml_1970_0": "＊ まった^1。うえの　かいにある　ほん^1。\n　 うえの　かいにある　ほん^1。\n　 まった^1。ほん…/%",
  "obj_npc_room_slash_Other_10_gml_1974_0": "＊ …は…^1　まった。まった^1。\n　 だいすきだ。/%",
  "obj_npc_room_slash_Other_10_gml_2006_0": "＊ (消去法で^1 \n　 これは ラルセイの部屋で\n　 いちばん　イカした家具だ)/%",
  "obj_npc_room_slash_Other_10_gml_2022_0": "＊ (ノエルの　でんわだ)/%",
  "obj_npc_room_slash_Other_10_gml_2033_0_b": "\\E3＊ あっ！　クリス^1？\n　 あのね…^1　でんわ　さがすの\n　 もうすこし　かかりそう…/",
  "obj_npc_room_slash_Other_10_gml_2034_0": "\\E4＊ …だから^1　このへやで\n　 まってなくても\n　 だいじょうぶだよ！/",
  "obj_npc_room_slash_Other_10_gml_2035_0": "\\E3＊ その…べつのへやに\n　 いったりしても\n　 いいからね？/%",
  "obj_npc_room_slash_Other_10_gml_2039_0": "\\EI＊ (…クリス？^1\n　 わたしの　いいたいこと…\n　 つたわってる…？)/%",
  "obj_npc_room_slash_Other_10_gml_2044_0": "\\E9＊ クリス^1…もし　エンピツが\n　 みつからなかったら…/",
  "obj_npc_room_slash_Other_10_gml_2045_0": "\\E4＊ …あとで　よんでね^1。\n　 いっしょに　さがして\n　 あげる！/%",
  "obj_npc_room_slash_Other_10_gml_2053_0_b": "\\E2＊ (まかしとけ^1。ノエルの\n　 でんわは　しばらく\n　 「みつからない」ぜ)/",
  "obj_npc_room_slash_Other_10_gml_2054_0": "\\E5＊ (クリス^1　おまえはイヌだ^1！\n　 そのへん　かぎまわって\n　 てがかり　さがしてこい！)/%",
  "obj_npc_room_slash_Other_10_gml_2058_0": "\\EP＊ (…は？^1　なんのイヌに\n　 なればいいかって^1？\n　 いいから　さがしてこい！)/",
  "obj_npc_room_slash_Other_10_gml_2059_0": "\\EH＊ (はやくいけって！)/%",
  "obj_npc_room_slash_Other_10_gml_2064_0": "\\EA＊ (キセキてきに\n　 うまくいったな)/",
  "obj_npc_room_slash_Other_10_gml_2065_0": "\\E2＊ (ノエルに　あやしまれる\n　 まえに　てがかりを\n　 さがしてこい！)/%",
  "obj_npc_room_slash_Other_10_gml_2076_0": "＊ ああ^1　クリス…　きょう　こうして\n　 てんしさまの　ごぜんで\n　 かおを　みられて　なにより…/",
  "obj_npc_room_slash_Other_10_gml_2077_0": "＊ ともだちも　つれてきて\n　 くれるとは…\n　 わたしに　なにか　ごようですか？/",
  "obj_npc_room_slash_Other_10_gml_2081_0": "＊ クリス^1　わたしに　なにか\n　 ごようですか？/",
  "obj_npc_room_slash_Other_10_gml_2091_0": "＊ (はずかしそうに　ジュースを\n　 エラに　ながしこんでいる)/%",
  "obj_npc_room_slash_Other_10_gml_2103_0": "＊ …えっと^1…\n　 なんか^1　しりたいことあんなら…/",
  "obj_npc_room_slash_Other_10_gml_2104_0": "＊ そこに　いる　\\cYせんせい\\cWにでも\n　 きけよな！/%",
  "obj_npc_room_slash_Other_10_gml_2119_0_b": "＊ クリスはん^1。アンタの　オカンは\n　 くちを　ひらけば　アンタのこと\n　 ばっかりや。/",
  "obj_npc_room_slash_Other_10_gml_2120_0": "＊ フワフワの　ゆきだまみたいに^1 \n　 かわいくて　しゃーないんやろな^1。\n　 オカンには　やさしぃするんやで？/%",
  "obj_npc_room_slash_Other_10_gml_2124_0": "＊ オカン　オトン　おにぃやん^1…\n　 むかいの　おばちゃん　おっちゃん^1…\n　 みんなに　やさしぃするんやで？/%",
  "obj_npc_room_slash_Other_10_gml_2133_0": "＊ オレは　おいのりとか　よく\n 　わかんねーけどさ^1　ここ　くるのは\n　 わりと　すきなんだわ。/",
  "obj_npc_room_slash_Other_10_gml_2134_0": "＊ なんつーの？^1　この　きょうかいの\n　 ふんいきとか^1？　コミュニティとか^1？\n　 サイコーじゃん？/%",
  "obj_npc_room_slash_Other_10_gml_2138_0": "＊ あ　それと^1　ジュースね^1。\n　 オレの　カレシが　ここのジュース\n　 すきなんだわ。/%",
  "obj_npc_room_slash_Other_10_gml_2146_0": "＊ …ジュース。~1",
  "obj_npc_room_slash_Other_10_gml_2149_0": "＊ …\\cYせんせい\\cW…　のどが　かわいてる？/%",
  "obj_npc_room_slash_Other_10_gml_2158_0": "\\E2＊ クリリぃ^1！　ヤダちょっと\n　 アタシに　あいさつしに\n　 きてくれたの！？　ヤバ～！/",
  "obj_npc_room_slash_Other_10_gml_2159_0": "\\E5＊ あんごう？　あかない？\n　 ごめ～ん　ちょっと　なに\n　 いってるか　わかんな～い！/",
  "obj_npc_room_slash_Other_10_gml_2160_0": "\\E6＊ でもでも～^1　\\cYノエルン\\cWの\n　 うちの　もんは～^1　いっつも\n　 \\cYあかない\\cWよ～！！/",
  "obj_npc_room_slash_Other_10_gml_2161_0": "\\E2＊ それから～^1　あんごう^1？　\n　 それって　なんか\n　 \\cYヲタク\\cWっぽ～い^1！　ムリ～！/%",
  "obj_npc_room_slash_Other_10_gml_2165_0": "\\E6＊ \\cYノエルン\\cWの　うちの\n　 もんは^1～　いっつも\n　 \\cYあかない\\cWよ～！！/",
  "obj_npc_room_slash_Other_10_gml_2166_0_b": "\\E2＊ それから～^1　「あんごう」^1？　\n　 それって　なんか\n　 \\cYヲタク\\cWっぽ～い^1！　ムリ～！/%",
  "obj_npc_room_slash_Other_10_gml_2175_0": "＊ ウチのムスメも　カミさんも^1　\n　 きょうは　ホントに　よくやった！/",
  "obj_npc_room_slash_Other_10_gml_2176_0": "＊ ん？^1　あんごう？　あかないとびら^1？\n　 おじさんは　わからないけど^1　ウチの\n　 \\cYてんさいムスメ\\cWに　きいてごらん！/%",
  "obj_npc_room_slash_Other_10_gml_2180_0": "＊ よ～し！^1　きょうは　パパ^1 \n　 「マンガにでてくる　サカナのホネの\n　 グリルやき」　つくっちゃうぞ～！/",
  "obj_npc_room_slash_Other_10_gml_2181_0": "＊ ホネを　ゴリゴリたべるぞ～^1！\n　 なんたって　ウチは^1　いっかそろって\n　 フェミミストだからね～！/%",
  "obj_npc_room_slash_Other_10_gml_2215_0": "\\E0＊ \\ED＊ <!--クリス　[冒険]ハ\n　 ドンナ調子？-->/",
  "obj_npc_room_slash_Other_10_gml_2216_0": "\\EL＊ <!--[サイバー系]ノ　ダレカヲ\n　 仲間ニ　シタ？\n　 ダレデモ　イイワヨ-->/",
  "obj_npc_room_slash_Other_10_gml_2217_0": "\\EB＊ <!--[スマート　エスプレッソ\n　 マシン]トカ…\n　 ハハ　ハハハ-->/",
  "obj_npc_room_slash_Other_10_gml_2218_0_b": "\\E5＊ <!--シテナイノ？　ソウ…\n　 トリアエズ　[No Ｌ]ニ\n　 ヨロシク…　ハハ…ハ…-->/%",
  "obj_npc_room_slash_Other_10_gml_2222_0": "\\ED＊ <!--クリス…　[スマホ]ニ\n　 [ゲーム]　イレテル？\n　 見セテ　見セテ　ネエ-->/",
  "obj_npc_room_slash_Other_10_gml_2223_0": "\\E1＊ <!--[ダークナー]ニ\n　 デキルカモ　デショ？\n　 ハハ…ハ…-->/",
  "obj_npc_room_slash_Other_10_gml_2224_0": "\\E5＊ <!--[クリス]　[フラッピング\n　 バード]ヲ　仲間ニシタラ\n　 [40ネットコイン]アゲル-->/%",
  "obj_npc_room_slash_Other_10_gml_2233_0": "\\E3＊ (クイーン殿　いまにも\n　 余の　ピカイチさに\n　 気づかん…)/",
  "obj_npc_room_slash_Other_10_gml_2235_0_b": "\\ED＊ <!--アノ　[ランプ]ノ\n　 [ピカりレベル]-->/",
  "obj_npc_room_slash_Other_10_gml_2236_0_b": "\\E1＊ <!--LOW-->/%",
  "obj_npc_room_slash_Other_10_gml_2240_0": "\\E6＊ (女王殿は　余の\n　 ぷりぷりプリチーな\n　 おケツに気づいたカナ…？)/%",
  "obj_npc_room_slash_Other_10_gml_2250_0": "＊ おーっとぉ！^1　その台には\n　 ドントターッチ！^1　さわると\n　 「TV TIMEシーズン２」が始まるぞ！/",
  "obj_npc_room_slash_Other_10_gml_2251_0": "＊ エピソードごとに　ショボくなる\n　 コンテンツなんて見たくないでしょ^1？\n　 ねえ？　ねえ！？/%",
  "obj_npc_room_slash_Other_10_gml_2259_0": "＊ ボクの愛しい　アイスクリーム\n　 サンデー^1。ボクたちの絆は\n　 いままでになく　深まったね。/",
  "obj_npc_room_slash_Other_10_gml_2260_0": "＊ ただ…^1　あのランプに\n　 手を　にぎられた気がして\n　 ちょっとモヤモヤする。/",
  "obj_npc_room_slash_Other_10_gml_2261_0_b": "＊ なんだかフシギな　キブンになって^1…\n　 けど　ムシするよ。愛のために。/%",
  "obj_npc_room_slash_Other_10_gml_2265_0": "＊ ボクのキミへの愛は\n　 どんなランプより明るく輝くのさ。/",
  "obj_npc_room_slash_Other_10_gml_2266_0": "＊ そして^1　キミの手だけを\n　 にぎるのさ^1。キミが　いいって\n　 言ったときだけね。ハハハ。/%",
  "obj_npc_room_slash_Other_10_gml_2275_0": "＊ アツ～く輝く　ワタシの流れ星。\n　 アナタといると　ワタシの心は\n　 燃えるよう。/",
  "obj_npc_room_slash_Other_10_gml_2276_0": "＊ あのランプに^1　髪をなでられた\n　 ときと　同じくらいアツいわ。/",
  "obj_npc_room_slash_Other_10_gml_2277_0": "＊ でも^1　あのときは　どう感じたか\n　 正直　よくわからないし^1…\n　 思い出したくもない^1…かも。/%",
  "obj_npc_room_slash_Other_10_gml_2281_0": "＊ ただの　ランプだけれど^1…\n　 なんだか怪しい。\n　 プンプン　ニオうわ。/",
  "obj_npc_room_slash_Other_10_gml_2282_0": "＊ 別の部屋へ　行ったり　もどったりを\n　 何度も　くりかえしているのを\n　 見た気がするの。/%",
  "obj_npc_room_slash_Other_10_gml_2291_0": "＊ ラルセイ王子！^1　ごらんください^1！\n　 この　たくさんの帽子を！/",
  "obj_npc_room_slash_Other_10_gml_2292_0": "＊ …？^1　王子から　お預かりした帽子^1？\n　 どうやら　なくしてしまったようで^1。\n　 もう二度と^1　見つからないでしょう。/%",
  "obj_npc_room_slash_Other_10_gml_2296_0": "＊ ラルセイ王子！　もう？　帽子で？\n　 顔を隠す必要なんて？\n　 ございませんよ。/",
  "obj_npc_room_slash_Other_10_gml_2297_0": "＊ 整形手術をすれば？　ご友人がたも\n　 受け入れて？　くれるでしょう。/%",
  "obj_npc_room_slash_Other_10_gml_2311_0": "＊ …/%",
  "obj_npc_room_slash_Other_10_gml_2320_0": "＊ フム^1…\\cG本\\cWが読みたくて\n　 しょうがないんじゃが\n　 手が届かんのう…/%",
  "obj_npc_room_slash_Other_10_gml_2337_0": "＊ (れっきとした　イスだ)/%",
  "obj_npc_room_slash_Other_10_gml_2342_0_b": "＊ (イスだ)/",
  "obj_npc_room_slash_Other_10_gml_2343_0_b": "＊ (ラルセイがいるかぎり\n　 あまり　使い道はない)/%",
  "obj_npc_room_slash_Other_10_gml_2361_0": "＊ 覚えたかね？/",
  "obj_npc_room_slash_Other_10_gml_2363_0": "\\ED＊ あー…　全部　暗記は\n　 できねぇけど　ざっくりは\n　 覚えた。/",
  "obj_npc_room_slash_Other_10_gml_2364_0": "\\E1＊ …てか^1　なんで　わざわざ\n　 紙に書くんだよ？/",
  "obj_npc_room_slash_Other_10_gml_2366_0": "＊ ときには　そうせんと\n　 伝えられんこともあるんじゃよ。\n　 ガーッハッハ！/%",
  "obj_npc_room_slash_Other_10_gml_2372_0_b": "＊ そのジェムには　不思議な力がある。/",
  "obj_npc_room_slash_Other_10_gml_2373_0_b": "＊ サメ肌が立ったから　ワシゃ\n　 そいつは　使わんかったぞい！/%",
  "obj_npc_room_slash_Other_10_gml_2388_0": "＊ カウンターのなかの^1　\n　 ぼうしを　かぶってるひと^1… \n　 しゃべれないんだけど…/",
  "obj_npc_room_slash_Other_10_gml_2389_0": "＊ …この仕事を　すごーく\n　 気に入ってるみたい。/",
  "obj_npc_room_slash_Other_10_gml_2390_0": "＊ だから^1…任せておこう？/%",
  "obj_npc_room_animated_slash_Other_10_gml_91_0": "＊ レット　ミー　オイル^1　チーフ！/%",
  "obj_npc_room_animated_slash_Other_10_gml_150_0_b": "\\E7＊ 今日はチーズケーキ\n　 作れるか！？/",
  "obj_npc_room_animated_slash_Other_10_gml_152_0_b": "\\EQ＊ …その前に　２階へ\n　 行かない…？/%",
  "obj_npc_room_animated_slash_Other_10_gml_158_0": "\\E9＊ (なあクリス！^1　今度は\n　 オレらで　ラルセイに\n　 ケーキ作ってやろうぜ！)/",
  "obj_npc_room_animated_slash_Other_10_gml_159_0": "\\EB＊ (…このナベのエンジンが\n　 どこに　あるかさえ\n　 わかれば　ラクショーだ…)/%",
  "obj_npc_room_animated_slash_Other_10_gml_194_0": "＊ (ろう獄を守っている^1。\n　 が^1　じつに　けしからん\n　 働きぶりだ)/%",
  "obj_npc_room_animated_slash_Other_10_gml_205_0": "＊ ああ^1…ご主人さま^1。\n　 ご主人さまの　ご判断は\n　 尊重いたしますが…/",
  "obj_npc_room_animated_slash_Other_10_gml_206_0": "＊ 仲間にされた　このザッパーという…\n　 モノ…？^1　に関しては^1　\n　 少々　やりすぎでは？/",
  "obj_npc_room_animated_slash_Other_10_gml_207_0": "＊ 仕事は　ワタクシひとりで\n　 十分こなせますので^1　この方は\n　 退職させては　いかがでしょう？/%",
  "obj_npc_room_animated_slash_Other_10_gml_211_0": "＊ ザッパー氏は　この　ウサギ氏で\n　 顔を　ふこうとしたのです…/",
  "obj_npc_room_animated_slash_Other_10_gml_212_0": "＊ なので^1　「おそうじコンテストで\n　 勝負だ」ということに\n　 なったのですが…/",
  "obj_npc_room_animated_slash_Other_10_gml_213_0": "＊ …コヤツは　とんだクズヤロウで\n　 ございますので^1　ここにいるだけで\n　 床が　どんどん汚れるのです！/%",
  "obj_npc_room_animated_slash_Other_10_gml_218_0": "＊ ケロケロ^1　ケロケロ…/",
  "obj_npc_room_animated_slash_Other_10_gml_219_0": "＊ (ザッパーが怖いので\n　 しぶしぶ応援している)/%",
  "obj_npc_room_animated_slash_Other_10_gml_223_0": "＊ (いっしょうけんめい\n　 パレットラーを応援している)/",
  "obj_npc_room_animated_slash_Other_10_gml_224_0": "＊ (ドキドキ。スッキリ)/%",
  "obj_npc_room_animated_slash_Other_10_gml_327_0": "＊ 「ファンクラブ」を始めようと\n　 思ってるんだけど\n　 メンバーが　いなくて。/",
  "obj_npc_room_animated_slash_Other_10_gml_328_0": "＊ ボス^1　仲間を見つけてきて\n　 もらえませんか…？/%",
  "obj_npc_room_animated_slash_Other_10_gml_335_0": "＊ …だから^1　手首がカギなんだよ\n　 手首が。/",
  "obj_npc_room_animated_slash_Other_10_gml_336_0": "＊ 「ファンクラブ」の一員に\n　 なりたかったら　ファンの使い方を\n　 マスターしてもらわないと！/%",
  "obj_npc_room_animated_slash_Other_10_gml_340_0": "＊ ボスも　ファンの使い方をマスター\n　 したいですか？^1　それとも\n　 ファンのファンなだけですか？/%",
  "obj_npc_room_animated_slash_Other_10_gml_359_0": "＊ (ムチャ^1　ムチャ…)/",
  "obj_npc_room_animated_slash_Other_10_gml_360_0": "＊ これが　イモムシの生き様\n　 というものです…/%",
  "obj_npc_room_animated_slash_Other_10_gml_368_0_b": "＊ クイーン陛下のような　パワフルな\n　 コンピューターには^1　パワフルな\n　 ファンが　必要なのです！/%",
  "obj_npc_room_animated_slash_Other_10_gml_372_0": "＊ 古代のひとびとは^1　こうやって\n　 コンピューターを冷却した^1…\n　 のですよね？/%",
  "obj_npc_room_animated_slash_Other_10_gml_393_0": "＊ あんごう？^1　それは　しらないけど\n　 きいてちょうだい！　ウチのオットと\n　 ムスメは　せかいイチよ～！/",
  "obj_npc_room_animated_slash_Other_10_gml_394_0": "＊ きょう　あつまったひと　ぜんいん\n　 コテンパンに　やりこめてやった\n　 でしょう？^1　たいしたものよ～！/%",
  "obj_npc_room_animated_slash_Other_10_gml_398_0": "＊ きょうの　れいはいは\n　 サツジンてき　だったわ！\n　 チカラの　さを　みせつけたわ！/",
  "obj_npc_room_animated_slash_Other_10_gml_399_0": "＊ みんな　にどと　こないはずよ！！\n　 キャッテンハイマーいっかの\n　 だいしょうりよ！！/%",
  "obj_npc_room_animated_slash_Other_10_gml_409_0": "＊ けいさつが　いなくなって^1　\n　 スピードいはんを　しても　へいき^1！\n　 すきなだけ　ゆっくり　はしれるぞ！/%",
  "obj_npc_room_animated_slash_Other_10_gml_423_0": "\\E8＊ やだぁ～！　クリリぃ！！\n　 アタシのタダミルク\n　 のみたいの！？/",
  "obj_npc_room_animated_slash_Other_10_gml_425_0": "\\E5＊ (おい！　そこの\n　 かとうせいぶつ！　それは\n　 オレの　タダミルクだ！)/%",
  "obj_npc_room_animated_slash_Other_10_gml_429_0": "\\E6＊ はずかしがらないで～！\n　 アタシのミルク\n　 シェアしてあげる～！/",
  "obj_npc_room_animated_slash_Other_10_gml_431_0": "\\EH＊ (てめーのじゃねーっつの！！\n　 ヒゲ　もやすぞ！)/%",
  "obj_npc_room_animated_slash_Other_10_gml_442_0": "＊ ウホーイ^1　ウホホーイ^1！\n　 ボク　クズー^1！\n　 イカれたルームメイトだよ！/",
  "obj_npc_room_animated_slash_Other_10_gml_443_0": "＊ …って言えたらな^1。\n　 最近じゃ^1　ゴミを拾って\n　 自分の体に入れるのは　ボクだけだ！/%",
  "obj_npc_room_animated_slash_Other_10_gml_447_0": "＊ このルームメイトも^1　\n　 もう少し　ボクみたいに\n　 なってくれたらいいのに。/",
  "obj_npc_room_animated_slash_Other_10_gml_448_0": "＊ 大きな赤いクチビルと　\n　 長いマツゲを持った^1　ノリのいい\n　 でっかい　ごみばこ…だったらな…/%",
  "obj_npc_room_animated_slash_Other_10_gml_466_0": "\\EK＊ おまえって^1　もっと\n　 デカくなかったか…？/",
  "obj_npc_room_animated_slash_Other_10_gml_468_0": "＊ テレビで見ると^1　なんでも\n　 大きく見えるものですヨ！\n　 アーッハハッハ！/",
  "obj_npc_room_animated_slash_Other_10_gml_469_0": "＊ 里親を探してください。/%",
  "obj_npc_room_animated_slash_Other_10_gml_479_0": "＊ (やわらかい土壌を　踏み固めて\n　 飼育環境を　改善している)/%",
  "obj_npc_room_animated_slash_Other_10_gml_487_0": "＊ オレは　ハッカーだ^1。\n　 いまは　ライフハック用に\n　 せっせと　「リアル」を集めてる。/",
  "obj_npc_room_animated_slash_Other_10_gml_488_0": "＊ コンピューターが　リア充になれば^1 \n　 ゲームしながら　リアルを充実\n　 させられるからな。/%",
  "obj_npc_room_animated_slash_Other_10_gml_492_0": "＊ 女子と結婚したら^1　ライフハックは\n　 全部　ワイフハックになる。/%",
  "obj_npc_room_animated_slash_Other_10_gml_499_0": "＊ なにをしているか　ですって^1？\n　 ワタクシは^1…その^1…\n　 ミミズを　集めているだけです…/",
  "obj_npc_room_animated_slash_Other_10_gml_500_0": "＊ じつは^1…ルールノー・カァドー氏に\n　 お仕えしたくて^1…\n　 これ^1　くれぐれも　内密に…/%",
  "obj_npc_room_animated_slash_Other_10_gml_509_0": "＊ (勉強中のようだ)/%",
  "obj_npc_room_animated_slash_Other_10_gml_558_0": "\\m3　 ッス　ボス！^1　この道場用に\n　 新しい曲を用意したぜ…/",
  "obj_npc_room_animated_slash_Other_10_gml_559_0": "\\m3　 マトモワルーゼたちのために\n　 ロマンチック系にしてみたんだ。/%",
  "obj_npc_room_animated_slash_Other_10_gml_564_0": "\\m3　 この町に　トリプルパックの\n　 カワイコちゃんが　いたなんて\n　 知らなかったぜ！/",
  "obj_npc_room_animated_slash_Other_10_gml_565_0": "\\m3　 このカワイコちゃんたちに\n　 とっておきの逆ディスりソングを\n　 お届けするぜ…/%",
  "obj_npc_rudy_slash_Step_0_gml_62_0": "\\E4＊ そう^1…あしたは　おまつりだ^1。\n　 ノエルとの　やくそくだから^1　\n　 おじさんも　いくぞ。/%",
  "obj_npc_rudy_slash_Step_0_gml_76_0": "\\E1＊ クリス^1…\n　 なんで^1…ともだちなんか\n　 つれてきたんだい？/",
  "obj_npc_rudy_slash_Step_0_gml_78_0": "\\EK＊ …オレも　わかんねぇ^1…\n　 クリス　なんでだよ？/",
  "obj_npc_rudy_slash_Step_0_gml_80_0": "\\E7＊ ハハ^1…ハハハハハ^1！\n　 これはもう　わらうしか\n　 ないな！/%",
  "obj_npc_rudy_slash_Step_0_gml_84_0": "\\E1＊ …/%",
  "obj_npc_rudy_slash_Step_0_gml_93_0": "\\E4＊ やあやあ　スージィどの^1…\n　 さっき　きょうかいでも\n　 あったね…/",
  "obj_npc_rudy_slash_Step_0_gml_95_0": "\\E3＊ …ああ^1。おっさん^1…\n　 ぐあいは　どうなんだよ？/",
  "obj_npc_rudy_slash_Step_0_gml_97_0": "\\E4＊ じきに　よくなるよ^1…\n　 …きょうかいに　いって^1　\n　 すこし^1…くたびれただけさ。/",
  "obj_npc_rudy_slash_Step_0_gml_98_0": "\\E6＊ …スージィ？/",
  "obj_npc_rudy_slash_Step_0_gml_100_0": "\\E0＊ あ？/",
  "obj_npc_rudy_slash_Step_0_gml_102_0": "\\E6＊ きみも　あした\n　 おまつりに　いくのかい？/",
  "obj_npc_rudy_slash_Step_0_gml_104_0": "\\EN＊ オ…オレ？^1　ま^1…まあ^1　\n　 どーしても　いけって\n　 いわれれば？/",
  "obj_npc_rudy_slash_Step_0_gml_106_0": "\\E3＊ ノエルは^1…まだ　だれとも\n　 やくそくしてないぞ？/",
  "obj_npc_rudy_slash_Step_0_gml_108_0": "\\E6＊ は？？^1　マジかよ…/",
  "obj_npc_rudy_slash_Step_0_gml_109_0": "\\E6＊ あのノエルが…^1？\n　 ウソだろ？/",
  "obj_npc_rudy_slash_Step_0_gml_111_0": "\\E3＊ …/",
  "obj_npc_rudy_slash_Step_0_gml_113_0": "\\EM＊ あいつって^1　いわゆる\n　 「タカネのハナ」ってやつ？\n　 だから^1　みんなビビんだな。/",
  "obj_npc_rudy_slash_Step_0_gml_115_0": "\\E3＊ たかねの　はな…か。/",
  "obj_npc_rudy_slash_Step_0_gml_117_0": "\\ED＊ でも^1…そっか^1…\n　 そりゃ　なんつーか^1　\n　 きのどくだな。/",
  "obj_npc_rudy_slash_Step_0_gml_119_0": "\\E2＊ ハハ^1…ハハハハハ！\n　 だいじょうぶ　ばんじ\n　 うまくいくさ！/%",
  "obj_npc_rudy_slash_Step_0_gml_123_0": "\\EC＊ ノエルが　さそえば\n　 だれでも\n　 オッケーするだろ。/",
  "obj_npc_rudy_slash_Step_0_gml_125_0": "\\E2＊ ハハハ！　どうかな！/%",
  "obj_npc_rudy_slash_Step_0_gml_143_0": "\\E5＊ きょうの　ところは\n　 たいりょくを\n　 セーブして…/",
  "obj_npc_rudy_slash_Step_0_gml_144_0": "\\E3＊ あしたには\n　 げんきモリモリさ！/%",
  "obj_npc_sign_slash_Other_10_gml_51_0": "＊ (パパの　トラックだ)/%",
  "obj_npc_sign_slash_Other_10_gml_58_0": "\\E2＊ うし^1　おまえが　\n　 ドライバーで　オレが\n　 シューターな。/",
  "obj_npc_sign_slash_Other_10_gml_59_0": "\\EA＊ オレが　うしろに　たって^1…\n　 つちの　かたまりとかを\n　 なげるぜ。/%",
  "obj_npc_sign_slash_Other_10_gml_63_0": "\\E6＊ ん…^1？　みせの　うらの\n　 あのドア^1…なんだ？/%",
  "obj_npc_sign_slash_Other_10_gml_81_0": "＊ (しまっている)/%",
  "obj_npc_sign_slash_Other_10_gml_108_0": "＊ (あめに　ぬれた　テーブルが\n　 つきあかりを　うけて\n　 ひかっている)/%",
  "obj_npc_sign_slash_Other_10_gml_120_0_b": "\\E7＊ フライドポテト^1！\n　 （イェー！）\n　 じめんに　おちてるぜぃ！/",
  "obj_npc_sign_slash_Other_10_gml_121_0_b": "\\E9＊ プライドもてよ^1！\n　 (くうな！)\n　 しねぇぜ　ひろいぐい！/%",
  "obj_npc_sign_slash_Other_10_gml_125_0": "\\E4＊ …にどと　うたわねー。/%",
  "obj_npc_sign_slash_Other_10_gml_137_0_b": "\\E7＊ フライドポテト^1！\n　 （イェー！）\n　 おちてるぜ　じめんにぃ！/",
  "obj_npc_sign_slash_Other_10_gml_138_0": "\\E9＊ プライドもてよ^1！\n　 (くうな！)\n　 しねぇぜ　ひろいぐい！/%",
  "obj_npc_sign_slash_Other_10_gml_142_0": "\\E4＊ …にどと　うたわねー。/%",
  "obj_npc_sign_slash_Other_10_gml_161_0": "\\E7＊ このバンで　ストリート\n　 レースしたら^1　おまえの\n　 ママに　おこられっかな？/",
  "obj_npc_sign_slash_Other_10_gml_162_0": "\\EK＊ …てか^1　そのまえに\n　 タイヤに　くうき\n　 いれねーと　ダメだ。/%",
  "obj_npc_sign_slash_Other_10_gml_166_0": "\\E2＊ おまえのママは\n　 きっと　こういうぜ…/",
  "obj_npc_sign_slash_Other_10_gml_167_0": "\\E9＊ 「クリス^1　スージィに\n　 ドリフトの　しかたを\n　 おしえてあげるのよ」って。/%",
  "obj_npc_sign_slash_Other_10_gml_443_0": "＊ (「オーブ投げゲーム」で　とった\n　 ラルセイの　ぬいぐるみだ)/%",
  "obj_npc_sign_slash_Other_10_gml_450_0": "\\E1＊ これ^1…　ボクが初めて\n　 手に入れた　「自分の\n　 持ちもの」なんだ…/",
  "obj_npc_sign_slash_Other_10_gml_451_0": "\\E2＊ クリスが　くれたから^1…\n　 毎晩^1…だっこして寝てるよ。/",
  "obj_npc_sign_slash_Other_10_gml_452_0": "\\E1＊ バカみたいかもしれないけど…\n　 それ以来^1　ボク　初めて…/",
  "obj_npc_sign_slash_Other_10_gml_453_0": "\\E2＊ わがまま言いたくなった^1。\n　 「もっと　ぬいぐるみ\n　 欲しい」って。ははは！/%",
  "obj_npc_sign_slash_Other_10_gml_486_0": "＊ (“ピー”ツア・シヨツプ\n　 かりてんぽで　エーギヨウちゅう！)/",
  "obj_npc_sign_slash_Other_10_gml_487_0": "＊ (かんばんは　シユウリのため\n　 おやすみ・シヨツプ！)/%",
  "obj_npc_zapper_slash_Other_10_gml_8_0": "＊ ボス^1　このショボくれヤロウは\n　 とっとと　お払い箱にしてやって\n　 くれ。/",
  "obj_npc_zapper_slash_Other_10_gml_9_0": "＊ 「ガツンとくるのを\n　 一杯くれ」と頼んだら\n　 紅茶を持ってきやがった！/",
  "obj_npc_zapper_slash_Other_10_gml_10_0": "＊ …だれのことかって^1？\n　 このパレットヤロウだよ^1。\n　 ラルセイじゃない。アイツはOKだ。/%",
  "obj_npc_zapper_slash_Other_10_gml_14_0": "＊ 見てくれ　ボス^1！\n　 オレは　そうじが　うまいぜ！/",
  "obj_npc_zapper_slash_Other_10_gml_15_0": "＊ ホコリが　二度と\n　 もどってこねぇように\n　 ボッコボコにしてやってるんだ！/",
  "obj_npc_zapper_slash_Other_10_gml_17_0": "\\EK＊ (オレも今度　やってみよう)/%",
  "obj_organ_enemy_slash_Step_0_gml_35_0": "ワレは 哲学者\nアーメン",
  "obj_organ_enemy_slash_Step_0_gml_36_0": "聴け！\n伝説の歌が聴こえる！\nアーメン",
  "obj_organ_enemy_slash_Step_0_gml_37_0": "真実は\nガラスに歌われる\nアーメン",
  "obj_organ_enemy_slash_Step_0_gml_38_0": "たどるべき\n物語",
  "obj_organ_enemy_slash_Step_0_gml_39_0": "たどるべきではない\n尾の話",
  "obj_organ_enemy_slash_Step_0_gml_40_0": "ド レ ミー\nド　レ　ユー\nド ラエ　モー\nアーメン",
  "obj_organ_enemy_slash_Step_0_gml_41_0": "それは光っていた\n声は 光っていた！",
  "obj_organ_enemy_slash_Step_0_gml_42_0": "DELTARUNEとは\nなにか",
  "obj_organ_enemy_slash_Step_0_gml_43_0": "DELTARUNE\nではないとは\nなにか",
  "obj_organ_enemy_slash_Step_0_gml_44_0": "ワレは なにか？\nワレは チョウチョか？",
  "obj_organ_enemy_slash_Step_0_gml_45_0": "ワレは なにか？\nワレは ヒトか？",
  "obj_organ_enemy_slash_Step_0_gml_46_0": "ワレワレは\nなぜ戦うのか？",
  "obj_organ_enemy_slash_Step_0_gml_47_0": "どうすれば\n和解できるのか？",
  "obj_organ_enemy_slash_Step_0_gml_48_0": "答えは…LOVE？",
  "obj_organ_enemy_slash_Step_0_gml_149_0": "＊ オルガニックは\n　 哲学的かつ高らかに鳴った。",
  "obj_organ_enemy_slash_Step_0_gml_150_0": "＊ オルガニックは\n　 エコロケーションで　予知をした。",
  "obj_organ_enemy_slash_Step_0_gml_151_0": "＊ オルガニックは　片手で拍手した。",
  "obj_organ_enemy_slash_Step_0_gml_152_0": "＊ オルガニックは　星々と空を\n　 読み解こうとしている。",
  "obj_organ_enemy_slash_Step_0_gml_153_0": "＊ 真ちゅうとサテンのニオイがする。",
  "obj_organ_enemy_slash_Step_0_gml_158_0": "＊ オルガニックは　HPが低いことの\n　 美徳を　たたえた。",
  "obj_organ_enemy_slash_Step_0_gml_163_0": "＊ オルガニックは　みのがすことの\n　 美徳を　たたえた。",
  "obj_organ_enemy_slash_Step_0_gml_168_0": "＊ オルガニックは　ねんねの時間の\n　 美徳を　たたえた。",
  "obj_organ_enemy_slash_Step_0_gml_241_0": "＊ オルガニック -\n　 彼はなぜ　バトルしてくるのか。\n　 それは　人生最大のナゾ。/%",
  "obj_organ_enemy_slash_Step_0_gml_252_0": "＊ 曲を演奏した！\n　 そこそこ効果があった！/%",
  "obj_organ_enemy_slash_Step_0_gml_258_0": "＊ 曲を演奏した！\n　 おおいに効果があった！/%",
  "obj_organ_enemy_slash_Step_0_gml_282_0": "＊ ハモろうとした！\n＊ 緑に触れろ！/%",
  "obj_organ_enemy_slash_Step_0_gml_292_0": "＊ ラルセイといっしょに\n　 ハモろうとした！/%",
  "obj_organ_enemy_slash_Step_0_gml_304_0": "＊ スージィは　適当な音を弾いた！/%",
  "obj_organ_enemy_slash_Step_0_gml_319_0": "＊ ラルセイは　美声で歌った！/%",
  "obj_overworldc_slash_Draw_0_gml_83_0_b": "ホリデーエンピツ",
  "obj_overworldc_slash_Draw_0_gml_84_0": "サボテンのトゲ",
  "obj_overworldc_slash_Draw_0_gml_85_0": "ブラックシャード",
  "obj_overworldc_slash_Step_0_gml_79_0": "＊ (なぜか…これをすてたら…)/",
  "obj_overworldc_slash_Step_0_gml_80_0": "＊ (だれかの^1…？？？を　すてるのと\n　 おなじな　きがした)/",
  "obj_overworldc_slash_Step_0_gml_81_0": "＊ (…でも^1　どういうことなのか\n　 よくわからなかった)/%",
  "obj_overworldc_slash_Step_0_gml_86_0": "＊ (さいきんは　きやすく　ぶきを\n　 すてられないようだ)/%",
  "obj_overworldc_slash_Step_0_gml_113_0": "＊ (でんわの　れんらくさきと\n　 はっしんりれきを　みた)/",
  "obj_overworldc_slash_Step_0_gml_114_0": "＊ (…ぜんぶ　さくじょ　されている)/%",
  "obj_proofread_controller_new_slash_Create_0_gml_29_0": "GALLERY",
  "obj_proofread_controller_new_slash_Create_0_gml_30_0": "GALLLLY",
  "obj_proofread_controller_new_slash_Create_0_gml_31_0": "GARRRRY",
  "obj_proofread_controller_new_slash_Create_0_gml_36_0": "ROOTS",
  "obj_proofread_controller_new_slash_Create_0_gml_37_0": "RRTTS",
  "obj_proofread_controller_new_slash_Create_0_gml_38_0": "RTTSS",
  "obj_proofread_controller_new_slash_Create_0_gml_43_0": "FESTIVAL",
  "obj_proofread_controller_new_slash_Create_0_gml_44_0": "FEEEEVOL",
  "obj_proofread_controller_new_slash_Create_0_gml_45_0": "FEEEAAAL",
  "obj_proofread_controller_new_slash_Create_0_gml_50_0": "FLASHBACK",
  "obj_proofread_controller_new_slash_Create_0_gml_51_0": "FLEEHBEEK",
  "obj_proofread_controller_new_slash_Create_0_gml_52_0": "FLOOHBOOK",
  "obj_proofread_controller_new_slash_Create_0_gml_57_0": "SWORD",
  "obj_proofread_controller_new_slash_Create_0_gml_58_0": "SOOOD",
  "obj_proofread_controller_new_slash_Create_0_gml_59_0": "SWRRD",
  "obj_proofread_controller_new_slash_Create_0_gml_64_0": "GUARDIAN",
  "obj_proofread_controller_new_slash_Create_0_gml_65_0": "GUUURRAN",
  "obj_proofread_controller_new_slash_Create_0_gml_66_0": "GAARDDIN",
  "obj_proofread_controller_new_slash_Create_0_gml_71_0": "ATRIUM",
  "obj_proofread_controller_new_slash_Create_0_gml_72_0": "ATTRRM",
  "obj_proofread_controller_new_slash_Create_0_gml_73_0": "ARRRIM",
  "obj_proofread_controller_new_slash_Create_0_gml_78_0": "SYNTHESIS",
  "obj_proofread_controller_new_slash_Create_0_gml_79_0": "SYYYYEESS",
  "obj_proofread_controller_new_slash_Create_0_gml_80_0": "SIIIITSIS",
  "obj_proofread_controller_new_slash_Create_0_gml_85_0": "THEATER",
  "obj_proofread_controller_new_slash_Create_0_gml_86_0": "THEEEAR",
  "obj_proofread_controller_new_slash_Create_0_gml_87_0": "THEETRR",
  "obj_proofread_controller_new_slash_Draw_0_gml_77_0": "＊ TIME UP!/%",
  "obj_proofread_controller_new_slash_Draw_0_gml_104_0": "＊ SUCCESS!/%",
  "obj_proofread_controller_new_slash_Draw_0_gml_134_0": "＊ …しかし^1　スペルミスだった！/%",
  "obj_readable_nubert_slash_Other_10_gml_22_0": "＊ だれかが　傷つくと^1　\n　 ポインも　傷つくん。/",
  "obj_readable_nubert_slash_Other_10_gml_23_0": "＊ キミのハートも　ボクみたいに^1　\n　 赤くニコニコ　させてねン。/%",
  "obj_readable_nubert_slash_Other_10_gml_30_0": "＊ キミは　ポインの友だちを\n　 みんな　逃がしてくれたねン。/",
  "obj_readable_nubert_slash_Other_10_gml_31_0": "＊ これで　みんな^1\n　 キミの友だちだよン。/",
  "obj_readable_nubert_slash_Other_10_gml_32_0": "＊ いいことだねン^1。キミが　みんなを\n　 逃がすと^1　この世界は　せっせと\n　 出世していくよン。/",
  "obj_readable_nubert_slash_Other_10_gml_33_0": "＊ ポインも　せっせと\n　 出世していくよン。/%",
  "obj_readable_room1_slash_Other_10_gml_38_0": "\\E0＊ なあ…^1　おまえのアニキの\n　 CD…^1　ブンなげていいか？/",
  "obj_readable_room1_slash_Other_10_gml_39_0": "\\E2＊ ちげーよ^1。フリスビー\n　 みてェに　なげて\n　 あそぼうぜってことだよ！/%",
  "obj_readable_room1_slash_Other_10_gml_66_0": "\\E9＊ ガハハハハ！^1！\n　 このパソコンの　かべがみ\n　 ヤベー！！/",
  "obj_readable_room1_slash_Other_10_gml_67_0": "\\E7＊ アニキと　いっしょに\n　 かいたのか？\n　 いくつんときだよ！？/",
  "obj_readable_room1_slash_Other_10_gml_68_0": "\\E9＊ きのうのサイバーワールドが\n　 こんなじゃなくて\n　 よかったぜ！/%",
  "obj_readable_room1_slash_Other_10_gml_72_0": "\\E7＊ お！^1　はじっこに\n　 かいてあんのは^1　キャッスル\n　 タウンにいる　ネコだよな！/",
  "obj_readable_room1_slash_Other_10_gml_73_0": "\\EK＊ ほら^1！　ショップの^1！\n　 かおに　ぬいめが　ある…！\n　 アイツだよ。/%",
  "obj_readable_room1_slash_Other_10_gml_291_0": "＊ (うまく　ことばに　できないけれど\n　 スージィが　となりに　いるのを\n　 みると…)/",
  "obj_readable_room1_slash_Other_10_gml_292_0": "＊ (…じぶんが　なんであろうと^1　\n　 いまだけは　だいじょうぶな\n　 きがした)/%",
  "obj_readable_room1_slash_Other_10_gml_296_0": "＊ (スージィは　ふたりが　うつった\n　 かがみを　じっと　みつめている)/",
  "obj_readable_room1_slash_Other_10_gml_298_0": "\\EN＊ へ？\n　 なに　かんがえてたかって^1？\n　 ヘヘッ…^1　べつに？/%",
  "obj_readable_room1_slash_Other_10_gml_329_0": "＊ (「ドラゴンの　えがきかた」が\n　 はいった　ひきだしを　あけた)/",
  "obj_readable_room1_slash_Other_10_gml_331_0": "\\EE＊ うぉ^1　なんだ　そ…/",
  "obj_readable_room1_slash_Other_10_gml_333_0": "＊ (ものすごい　いきおいで\n　 すばやく　ひきだしを　しめた)/%",
  "obj_readable_room1_slash_Other_10_gml_337_0_b": "\\E7＊ いまの　もっかい\n 　みしてくれよ^1？\n　 なあ？^1　なあ？？/%",
  "obj_readable_room1_slash_Other_10_gml_353_0": "＊ (サボテンだ。すきなくせに\n　 ツンツンした　たいどしか\n　 とれない)/",
  "obj_readable_room1_slash_Other_10_gml_354_0_b": "＊ (そういう　せいかくを\n　 ひとことで　あらわす\n　 いいかたさえ　あれば…)/%",
  "obj_readable_room1_slash_Other_10_gml_358_0": "＊ (…つかっても　はずかしくない\n　 ことばで)/%",
  "obj_readable_room1_slash_Other_10_gml_387_0": "＊ (めに　はいった　どうでもいい\n　 もじを　いちいち　よんでいる\n　 じかんは　ない)/%",
  "obj_readable_room1_slash_Other_10_gml_403_0": "＊ (…もう　ねたほうが　よさそうだ)/%",
  "obj_readable_room1_slash_Other_10_gml_422_0": "＊ (れいぞうこだ。\n　 ケチャップのボトルが\n　 ちょうせんてきに　ならんでいる)/%",
  "obj_readable_room1_slash_Other_10_gml_438_0": "＊ (はいすいこうには　なぜか　すでに\n　 しろい　けが　つまっている)\\f0/%",
  "obj_readable_room1_slash_Other_10_gml_444_0": "＊ (シンクだ。はいすいこうに\n　 つまっていた　けを　だれかが\n　 とりのぞいたようだ)/%",
  "obj_readable_room1_slash_Other_10_gml_465_0": "＊ (とだなだ^1。\n　 なにか^1…なくなっている)/%",
  "obj_readable_room1_slash_Other_10_gml_480_0_b": "＊ (ゴミばこだ。\n　 なかには　たっぷり　みずを\n　 もらった　はなが　はいっている)/%",
  "obj_readable_room1_slash_Other_10_gml_510_0_b": "\\ED＊ (ナイトのヤロウが\n　 あらわれたあと…)/",
  "obj_readable_room1_slash_Other_10_gml_511_0_b": "\\ED＊ (…やみのせかいで\n　 テナを　さがしたけど^1　\n　 どこにも　いなかった)/",
  "obj_readable_room1_slash_Other_10_gml_512_0_b": "\\ED＊ (みんなにも\n　 きいてまわったけど…)/",
  "obj_readable_room1_slash_Other_10_gml_513_0_b": "\\ER＊ (だれも　オレらに\n　 きょうりょくして\n　 くれなかった)/",
  "obj_readable_room1_slash_Other_10_gml_514_0_b": "\\EV＊ (…オレら^1　みんなに\n　 キツくあたりすぎたか…？)/",
  "obj_readable_room1_slash_Other_10_gml_515_0": "\\EV＊ (…)/",
  "obj_readable_room1_slash_Other_10_gml_516_0": "\\ES＊ (でも^1…どうにかして\n　 テナを　なおせねえかな？)/",
  "obj_readable_room1_slash_Other_10_gml_517_0": "\\ER＊ (おまえのママは…\n　 すてちまおうと\n　 してるけどさ)/%",
  "obj_readable_room1_slash_Other_10_gml_521_0_b": "\\ED＊ (テナ…\n　 こわれたままだな)/",
  "obj_readable_room1_slash_Other_10_gml_522_0_b": "\\ED＊ (これじゃ　やみのせかいにも\n　 つれてけねえ)/",
  "obj_readable_room1_slash_Other_10_gml_523_0": "\\ER＊ (…クソッ)/%",
  "obj_readable_room1_slash_Other_10_gml_530_0_b": "＊ (テレビだ。\n　 アンテナが　こわれているが\n　 テープで　とめてある)~1",
  "obj_readable_room1_slash_Other_10_gml_537_0_b": "\\E1＊ (そうだ…\n　 おまえが　やみのいずみを\n　 ふういんするまえに…)/",
  "obj_readable_room1_slash_Other_10_gml_538_0": "\\E0＊ (やみのせかいで　テナを\n　 みつけたんだったな)/",
  "obj_readable_room1_slash_Other_10_gml_539_0": "\\ED＊ (…しにかけてたけどさ)/",
  "obj_readable_room1_slash_Other_10_gml_540_0": "\\E0＊ (ピピンズとシャドウガイの\n　 ヤツらが　なおしかたを\n　 おしえてくれたから…)/",
  "obj_readable_room1_slash_Other_10_gml_542_0": "\\ED＊ (…おまえのママは\n　 すてちまおうと\n　 してるけどな)/",
  "obj_readable_room1_slash_Other_10_gml_543_0_b": "\\EL＊ (はやいとこ　あたらしい\n　 いばしょを　みつけて\n　 やろうぜ)/%",
  "obj_readable_room1_slash_Other_10_gml_550_0": "＊ (エンタメの　ふざいによる\n　 ジワジワとした　プレッシャーを\n　 かんじる)/%",
  "obj_readable_room1_slash_Other_10_gml_571_0_b": "\\E4＊ あはははは！^1　\n　 このきょく さいこう！/",
  "obj_readable_room1_slash_Other_10_gml_572_0": "\\E4＊ ママが「ハイパーモード」に\n　 なると　どうなるか\n　 しってるでしょ…？/%",
  "obj_readable_room1_slash_Other_10_gml_576_0": "\\E2＊ クリス^1　ハイパー\n　 モードを　おしえて\n　 くれて^1　ありがとな。/%",
  "obj_readable_room1_slash_Other_10_gml_586_0_b": "\\E8＊ きょうは　いえにいなくて\n　 ごめんなさいね^1。きゅうに\n　 あめが　ふってきたから…/",
  "obj_readable_room1_slash_Other_10_gml_587_0_b": "\\E0＊ あわてて　コンビニに\n　 かけこんだの。/",
  "obj_readable_room1_slash_Other_10_gml_588_0": "\\E8＊ そうしたら　サンズさんが\n　 あんまり　おもしろくて…/",
  "obj_readable_room1_slash_Other_10_gml_589_0": "\\E4＊ おうたの　れんしゅうなんて\n　 クソくらえよ！^1　あはは！/",
  "obj_readable_room1_slash_Other_10_gml_590_0": "\\E4＊ クリス！^1　かわりに　いま\n　 うたいましょう！^1　サンズ！\n　 リズムおねがいね？/",
  "obj_readable_room1_slash_Other_10_gml_592_0": "\\E5＊ スケルトン\n　 ビートボックスなら\n　 まかせてくれ…/%",
  "obj_readable_room1_slash_Other_10_gml_596_0": "\\E1＊ ズン　チャチャ\n　 ズン　チャ^1　\n　 ズン　チャッチャ。/",
  "obj_readable_room1_slash_Other_10_gml_598_0": "\\E0＊ クリス！^1　ほら^1！\n　 いっしょに　ズンズン\n　 ズーダラダッタして！/",
  "obj_readable_room1_slash_Other_10_gml_599_0": "\\E1＊ え？^1　もうねるの^1？\n　 えー…/%",
  "obj_readable_room1_slash_Other_10_gml_623_0": "＊ (ドアは　あさごはんの　ちからで\n　 ふういんされている)/%",
  "obj_readable_room1_slash_Other_10_gml_631_0_b": "\\E0＊ いや^1。てなら　きょうかいで\n　 あらえよ。/%",
  "obj_readable_room1_slash_Other_10_gml_638_0_b": "＊ (…もう　ねたほうが　よさそうだ)/%",
  "obj_readable_room1_slash_Other_10_gml_644_0_b": "\\E0＊ パンケーキ　のこす　つみは\n　 きょうかいいっても\n　 ゆるされねー。/",
  "obj_readable_room1_slash_Other_10_gml_645_0_b": "\\E2＊ しんぱいすんな。\n　 おまえが　のこしたぶんは\n　 オレが　くってやる。/%",
  "obj_readable_room1_slash_Other_10_gml_651_0": "\\EL＊ (まってろよ\n　 パンケーキ…)/%",
  "obj_readable_room1_slash_Other_10_gml_712_0": "＊ (リンゴのかおりのシャンプーの\n　 ボトルが　すこし　かるくなっている\n　 きがする)/",
  "obj_readable_room1_slash_Other_10_gml_714_0_b": "\\EP＊ オレが　のんだっていう\n　 しょうこは　ねーぞ。/%",
  "obj_readable_room1_slash_Other_10_gml_718_0": "＊ (リンゴのシャンプーだ)\n＊ (キャップのまわりに\n　 はがたが　ついている)/",
  "obj_readable_room1_slash_Other_10_gml_720_0": "\\EH＊ ソーダのキャップみたく^1　\n　 はで　あけるもんだと\n　 おもったんだよ！/%",
  "obj_readable_room1_slash_Other_10_gml_729_0": "\\E9＊ シュワシュワする\n　 にゅうよくざいを\n　 よくトイレに　いれたなぁ…/",
  "obj_readable_room1_slash_Other_10_gml_730_0": "\\E8＊ へ？^1　んだよ　おまえも\n　 おなじことしてたのか…？/",
  "obj_readable_room1_slash_Other_10_gml_731_0": "\\EH＊ いえで　やったのかよ！^1？　\n　 アホか？^1　そういうことは\n　 がっこうで　やれよな！！/%",
  "obj_readable_room1_slash_Other_10_gml_735_0": "\\EB＊ トイレのまえで\n　 いいおもいでに\n　 ひたってんじゃねーよ。/%",
  "obj_readable_room1_slash_Other_10_gml_744_0": "＊ (たなには　ピザのかおりの\n　 デオドラントが　おいてある)/",
  "obj_readable_room1_slash_Other_10_gml_746_0": "\\E9＊ おまえは　リンゴのニオイで\n　 アニキは　ピザくせぇとか\n　 ウケるな！/%",
  "obj_readable_room1_slash_Other_10_gml_750_0": "\\E9＊ おまえは　リンゴのニオイで\n　 アニキは　ピザくせぇとか\n　 ウケるな！/",
  "obj_readable_room1_slash_Other_10_gml_751_0": "\\EA＊ …いや^1　\n　 からかってんだけど？\n　 なんで　うなずくんだよ…/%",
  "obj_readable_room1_slash_Other_10_gml_879_0": "＊ (パソコンの　でんげんは\n　 きれている)/%",
  "obj_readable_room1_slash_Other_10_gml_900_0": "\\E0＊ ショボいポスターだな。\n　 どうせなら…/",
  "obj_readable_room1_slash_Other_10_gml_901_0": "\\EL＊ あおくて　ミミがない\n　 ネコがたの　ロボットとかの\n　 ポスターにしろよ。/%",
  "obj_readable_room1_slash_Other_10_gml_926_0": "＊ (バードリーの　つくえだ。\n　 タマゴが　おいてある)/%",
  "obj_readable_room1_slash_Other_10_gml_931_0_b": "＊ (バードリーの　つくえだ。\n　 リーダーのタマゴに　つづいて\n　 みつけた ~1コの　タマゴが　ならぶ)/%",
  "obj_readable_room1_slash_Other_10_gml_938_0": "\\E0＊ おい^1　バードリーのつくえに\n　 タマゴが　あるぜ…？/",
  "obj_readable_room1_slash_Other_10_gml_939_0": "\\EK＊ …あんま　ふかく\n　 かんがえたくねぇわ。/%",
  "obj_readable_room1_slash_Other_10_gml_973_0": "＊ (かべがみが　かわっている)\n＊ (クリスと　お兄ちゃんが　ゆきを\n　 つかまえている　しゃしんだ)/",
  "obj_readable_room1_slash_Other_10_gml_974_0": "＊ (ふたりで　つくった　２つの\n　 ゆきだるまの　あたまには　ななめに　\n　 ２ほんずつ　えだが　さしてある)/%",
  "obj_readable_room1_slash_Other_10_gml_995_0": "＊ (チェリーの　あじつきマーカーの　\n　 キャップを　はずした)/",
