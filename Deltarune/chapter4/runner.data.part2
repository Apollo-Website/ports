  "obj_ch4_PDC05A_slash_Step_0_gml_514_0": "\\EE＊ なっ…/",
  "obj_ch4_PDC05A_slash_Step_0_gml_515_0": "\\EH＊ オレは　そんなこと\n　 いわねーから！！/%",
  "obj_ch4_PDC05A_slash_Step_0_gml_524_0": "\\EA＊ よし^1。みてろよ？/%",
