  "scr_spelltext_slash_scr_spelltext_gml_94_0": "＊ ~1は　~2を&　 にがそうとした^2！&＊ しかし名前が　\\cYきいろ\\cWくない…/",
  "scr_spelltext_slash_scr_spelltext_gml_95_0": "＊ (ノエルに　\\cBスリープミスト\\cWを&　 唱えさせてみよう！)/%",
  "scr_spelltext_slash_scr_spelltext_gml_99_0": "＊ ~1は　~2を&　 にがそうとした^2！&＊ しかし名前が　\\cYきいろ\\cWくない…/",
  "scr_spelltext_slash_scr_spelltext_gml_100_0_b": "＊ (\\cBこうどう\\cWしてみよう！)/%",
  "scr_spelltext_slash_scr_spelltext_gml_143_0": " は&　 うっとりした！",
  "scr_spelltext_slash_scr_spelltext_gml_166_0": "(くたびれ)",
  "scr_spelltext_slash_scr_spelltext_gml_199_0": " was \\cBbored to tears\\cW!&",
  "scr_spelltext_slash_scr_spelltext_gml_200_0_b": " listened politely!&",
  "scr_spelltext_slash_scr_spelltext_gml_201_0": " became sentimental!&",
