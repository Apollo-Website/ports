  "obj_shop2_slash_Draw_0_gml_195_0": "なぜ売ってくれる？",
  "obj_shop2_slash_Draw_0_gml_196_0": "王様について",
  "obj_shop2_slash_Draw_0_gml_197_0": "王様の息子について",
  "obj_shop2_slash_Draw_0_gml_198_0": "もどる",
  "obj_shop2_slash_Draw_0_gml_202_0": "\\E5なにか&聞きたき&ことでも？",
  "obj_shop2_slash_Draw_0_gml_236_0": "アイテム売りたし",
  "obj_shop2_slash_Draw_0_gml_237_0": "ぶき売りたし",
  "obj_shop2_slash_Draw_0_gml_238_0": "ぼうぐ売りたし",
  "obj_shop2_slash_Draw_0_gml_239_0": "もどるべし",
  "obj_shop2_slash_Draw_0_gml_243_0": "\\E0なんじズの&おタカラ&余に見せよ！",
  "obj_shop2_slash_Draw_0_gml_244_0": "\\E2いまので&しまいでは？",
  "obj_shop2_slash_Draw_0_gml_245_0": "\\E6なんじズ&持たざる&者ナリ！",
  "obj_shop2_slash_Draw_0_gml_305_0": "\\E0売りたき&アイテムを&示すべし",
  "obj_shop2_slash_Draw_0_gml_306_0": "\\E0売りたき&ぶきを&示すべし",
