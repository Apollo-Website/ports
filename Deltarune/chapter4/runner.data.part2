            d3d_set_fog(false, c_black, 0, 0);
        }
        
        if (reverse)
            afterimage--;
    }
    
    if (t < 6)
    {
        if (!first_pass)
        {
            if (t < 5)
                draw_sprite_ext(sprite_index, image_index, x, y, image_xscale, image_yscale, 0, image_blend, 1 - (neotone / 4));
            
