                movenoise = 1;
            }
            else
            {
                global.menucoord[0] -= 1;
                
                if (global.menucoord[0] == 2)
                    global.menucoord[0] -= 1;
                
                movenoise = 1;
            }
        }
        
        if (right_p())
        {
            if (global.menucoord[0] == 4)
