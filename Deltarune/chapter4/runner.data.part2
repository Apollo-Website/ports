  "obj_round_evaluation_slash_Draw_0_gml_1457_0": "YOU GOT",
  "obj_watercooler_enemy_slash_Step_0_gml_5_0": "ムーンウォーマー",
  "obj_watercooler_enemy_slash_Step_0_gml_120_0": "＊ The moonwarmer shows no mercy.",
  "obj_watercooler_enemy_slash_Step_0_gml_121_0": "＊ The moonwarmer doesn't do anything in particular.",
  "obj_watercooler_enemy_slash_Step_0_gml_122_0": "＊ The moonwarmer leaves a hot silence.",
  "obj_watercooler_enemy_slash_Step_0_gml_123_0": "＊ The moonwarmer warms moons, warmly.",
  "obj_watercooler_enemy_slash_Step_0_gml_136_0": "＊ The moonwarmer's bubbles rest on the surface.",
  "obj_watercooler_enemy_slash_Step_0_gml_137_0": "＊ The moonwarmer looks like it needs a refill.",
  "obj_watercooler_enemy_slash_Step_0_gml_138_0": "＊ The moonwarmer's water blushes a cranberry pink.",
  "obj_watercooler_enemy_slash_Step_0_gml_167_0": "＊ You CHECKed the moonwarmer...&＊ The warms was confirmed to be \\cYmoon\\c0./%",
  "obj_watercooler_enemy_slash_Step_0_gml_179_0": "＊ You begged for mercy...&＊ ... but the moonwarmer showed none./",
  "obj_watercooler_enemy_slash_Step_0_gml_185_0": "＊ You begged for mercy...&＊ ... but the moonwarmer showed none./",
  "obj_watercooler_enemy_slash_Step_0_gml_270_0": "＊ You told the moonwarmer it should actually be called a moonwarmest...?/%",
  "obj_watercooler_enemy_slash_Step_0_gml_271_0": "＊ You took a slow sip of warms and asked if it ever mooned...?/%",
  "obj_watercooler_enemy_slash_Step_0_gml_272_0": "＊ You asked the moonwarmer,~1hotter~2they doing later...?/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_320_0": "シャドウガイ",
  "scr_recruit_info_slash_scr_recruit_info_gml_321_0": "音楽に情熱を燃やすが\n悪意を持つ者に利用されやすい。",
  "scr_recruit_info_slash_scr_recruit_info_gml_322_0": "クリエイティブ",
  "scr_recruit_info_slash_scr_recruit_info_gml_323_0": "ビジネス",
  "scr_recruit_info_slash_scr_recruit_info_gml_328_0": "混：音",
  "scr_recruit_info_slash_scr_recruit_info_gml_329_0": "＊ (ミュージックムードを\n　 楽しんでいるようだ)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_335_0": "シャッタア",
  "scr_recruit_info_slash_scr_recruit_info_gml_336_0": "手なの？　目なの？　両方なの？\nやだぁ～ミステリアス～！",
  "scr_recruit_info_slash_scr_recruit_info_gml_337_0": "盛れてるフォト",
  "scr_recruit_info_slash_scr_recruit_info_gml_338_0": "形容詞「ブサい」",
  "scr_recruit_info_slash_scr_recruit_info_gml_343_0": "写",
  "scr_recruit_info_slash_scr_recruit_info_gml_344_0": "＊ シッ！^1　話しかけないで^1…\n　 ドリンクの写真　撮ってるんだから！/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_350_0": "ザッパー",
  "scr_recruit_info_slash_scr_recruit_info_gml_351_0": "見た目の美しさよりも　腕力重視な用心棒。\n迷子になりがち。",
  "scr_recruit_info_slash_scr_recruit_info_gml_352_0": "レーザータグ",
  "scr_recruit_info_slash_scr_recruit_info_gml_353_0": "ボタンを押されること",
  "scr_recruit_info_slash_scr_recruit_info_gml_358_0": "秩:電",
  "scr_recruit_info_slash_scr_recruit_info_gml_359_0": "＊ ボス^1　このドリンク^1　やっちまって\n　 いいですか？　ズルッズルに\n　 吸いつくしてやりますよ。/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_365_0": "フロック",
  "scr_recruit_info_slash_scr_recruit_info_gml_366_0": "ホコリみたいな…カエル。\n“汚い手”を使うと評判だが\nホントは…汚いことが好き。",
  "scr_recruit_info_slash_scr_recruit_info_gml_367_0": "ホコリっぽい場所",
  "scr_recruit_info_slash_scr_recruit_info_gml_368_0": "なりすまし",
  "scr_recruit_info_slash_scr_recruit_info_gml_373_0": "蛙：埃",
  "scr_recruit_info_slash_scr_recruit_info_gml_374_0": "＊ (消毒用のアルコールで\n　 やさしくふいてほしいようだ)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_380_0": "ウォータークーラー",
  "scr_recruit_info_slash_scr_recruit_info_gml_381_0": "おしゃべり好きの　オフィスの人気者。\nおカタい服装をしているけれど\nだれもが認める美人。",
  "scr_recruit_info_slash_scr_recruit_info_gml_382_0": "雑談",
  "scr_recruit_info_slash_scr_recruit_info_gml_383_0": "“ハコ”入り",
  "scr_recruit_info_slash_scr_recruit_info_gml_388_0": "水",
  "scr_recruit_info_slash_scr_recruit_info_gml_389_0": "＊ (水を飲んでいるようだ)\n＊ (…それって　どうなのか)/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_395_0": "ピピンズ",
  "scr_recruit_info_slash_scr_recruit_info_gml_396_0": "ツキがめぐってくるまで　リスクを冒す。\nイカサマぐせのある　要注意人物。",
  "scr_recruit_info_slash_scr_recruit_info_gml_397_0": "ガチャゲーム",
  "scr_recruit_info_slash_scr_recruit_info_gml_398_0": "ツケ",
  "scr_recruit_info_slash_scr_recruit_info_gml_403_0": "混：運",
  "scr_recruit_info_slash_scr_recruit_info_gml_404_0": "＊ このドリンク^1　ワイのとちゃうって^1？\n　 心配せんでええ。\n　 あっためとるだけやさかい。/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_410_0": "エルニーナ",
  "scr_recruit_info_slash_scr_recruit_info_gml_411_0": "いわゆる「レインメーカー」の\nお天気おねえさん。\nただし　降らせるのは　ふつうに雨。",
  "scr_recruit_info_slash_scr_recruit_info_gml_412_0": "ラニーノ",
  "scr_recruit_info_slash_scr_recruit_info_gml_413_0": "ひとりになること",
  "scr_recruit_info_slash_scr_recruit_info_gml_418_0": "水：氷",
  "scr_recruit_info_slash_scr_recruit_info_gml_419_0": "＊ …ラニーノは　どこ！？\n　 またチーム交際してたら　どうしよう…/%",
  "scr_recruit_info_slash_scr_recruit_info_gml_425_0": "ラニーノ",
  "scr_recruit_info_slash_scr_recruit_info_gml_426_0": "天気をコントロールできる\nお天気おにいさん。\nでも　それってズルでは…？",
  "scr_recruit_info_slash_scr_recruit_info_gml_427_0": "エルニーナ",
  "scr_recruit_info_slash_scr_recruit_info_gml_428_0": "ひとりになること",
  "scr_recruit_info_slash_scr_recruit_info_gml_433_0": "火：風",
  "scr_recruit_info_slash_scr_recruit_info_gml_434_0": "＊ ひとりでデートなんて　ひさしぶりだ^1…\n　 …ひとりだから\n　 デートじゃないけど。/%",
  "DEVICE_MENU_slash_Draw_0_gml_289_0": "Chapter ~1のファイルを使わない",
  "DEVICE_MENU_slash_Draw_0_gml_305_0": "Ch~1ファイル",
  "DEVICE_MENU_slash_Draw_0_gml_387_0": "Chapter ~2のファイルで Chapter ~1を始める。",
  "DEVICE_MENU_slash_Draw_0_gml_389_0": "スロット~2で Chapter ~1を始めます。",
