                TEMPCOMMENT = stringsetloc("Please select a file.", "DEVICE_MENU_slash_Draw_0_gml_223_0");
            
            if (MENU_NO == 2)
                TEMPCOMMENT = stringsetloc("Choose a file to copy.", "DEVICE_MENU_slash_Draw_0_gml_224_0");
            
            if (MENU_NO == 3)
