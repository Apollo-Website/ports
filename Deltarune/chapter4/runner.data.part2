  "scr_itemnamelist_slash_scr_itemnamelist_gml_47_0": "ファボサンド",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_50_0": "ルールノールー",
  "scr_itemuse_slash_scr_itemuse_gml_31_0": "うおー！　うんめー！",
  "scr_itemuse_slash_scr_itemuse_gml_36_0": "おい！　オレにも食わせろ！",
  "scr_itemuse_slash_scr_itemuse_gml_38_0": "おいしい！　マシュマロだ！",
  "scr_itemuse_slash_scr_itemuse_gml_54_0": "生き返ったぜ！",
  "scr_itemuse_slash_scr_itemuse_gml_55_0": "(死んでなかったでしょ…)",
  "scr_itemuse_slash_scr_itemuse_gml_60_0": "(そうは見えねーけどな…)",
  "scr_itemuse_slash_scr_itemuse_gml_61_0": "うーん　力がわいてきた！",
  "scr_itemuse_slash_scr_itemuse_gml_82_0": "＊ (マニュアルを　読もうとした^1…&　 が　難解すぎて　めまいがした)/%",
  "scr_itemuse_slash_scr_itemuse_gml_94_0": "うま！　おかわり！",
  "scr_itemuse_slash_scr_itemuse_gml_95_0": "え…",
  "scr_itemuse_slash_scr_itemuse_gml_110_0": "目が回るぜ",
  "scr_itemuse_slash_scr_itemuse_gml_111_0": "うーん　おいしい！",
  "scr_itemuse_slash_scr_itemuse_gml_123_0": "ゼツミョーな焼き加減だな！",
  "scr_itemuse_slash_scr_itemuse_gml_127_0": "ちょっとコゲてる…？",
  "scr_itemuse_slash_scr_itemuse_gml_143_0": "んー…やっぱ顔はうまいな！",
  "scr_itemuse_slash_scr_itemuse_gml_147_0": "あううぅ…",
  "scr_itemuse_slash_scr_itemuse_gml_161_0": "意味わかんねー！",
  "scr_itemuse_slash_scr_itemuse_gml_165_0": "ヘルシーだね！",
  "scr_itemuse_slash_scr_itemuse_gml_177_0": "ひとりじめすんなよ！",
  "scr_itemuse_slash_scr_itemuse_gml_178_0": "(きっちり３等分だよ…)",
  "scr_itemuse_slash_scr_itemuse_gml_193_0": "ククク…血だぜ！",
  "scr_itemuse_slash_scr_itemuse_gml_198_0": "ベトベトするよぉ…",
  "scr_itemuse_slash_scr_itemuse_gml_217_0": "ちっさ！",
  "scr_itemuse_slash_scr_itemuse_gml_222_0": "ありがと　クリス！",
  "scr_itemuse_slash_scr_itemuse_gml_239_0": "(It's SO good!)",
  "scr_itemuse_slash_scr_itemuse_gml_243_0": "K-Kris!? I...",
  "scr_itemuse_slash_scr_itemuse_gml_257_0": "ウネウネしてて　ウマいぜ",
  "scr_itemuse_slash_scr_itemuse_gml_261_0": "おいしい！　スパゲティかな？",
  "scr_itemuse_slash_scr_itemuse_gml_426_0": "＊ (ケータイで　発信してみた)",
  "scr_itemuse_slash_scr_itemuse_gml_441_0": "＊ (タマゴを　使った)/%",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_13_0": "電話を　かけられる。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_14_0": "ケータイ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_18_0": "そんなに大事じゃないし#それほど大事じゃないわけでもない。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_19_0": "タマゴ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_23_0": "壊れてもなお　すさまじい気を発するケーキ。#鍛冶職人なら直せるだろう。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_24_0": "こわれたケーキ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_27_0": "カギのいちばん上の部分。パーツを3つ#集めれば鍛冶職人が直してくれる。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_28_0": "こわれたカギＡ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_31_0": "ナゾのろう屋のカギ。#どこか怪しい雰囲気がただよう。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_32_0": "とびらのカギ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_35_0": "カギの真ん中の部分。パーツを3つ#集めれば鍛冶職人が直してくれる。",
