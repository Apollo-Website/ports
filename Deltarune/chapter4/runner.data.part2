  "obj_readable_room1_slash_Other_10_gml_4504_0": "＊ (センサーに　ふれると\n　 どうなるのかは　よくわからない)/%",
  "obj_readable_room1_slash_Other_10_gml_4511_0": "＊ (ほんだなには　さんびかの　ほんと\n　 せいてんが　ぎっしり\n　 ならんでいる)/",
  "obj_readable_room1_slash_Other_10_gml_4512_0": "＊ (…それに　まぎれて　なんさつか^1 \n　 「ロード・オブ・ザ・ハンマー」も\n　 ならんでいる)/%",
  "obj_readable_room1_slash_Other_10_gml_4520_0": "＊ (ほんだなには　さんびかの　ほんと\n　 せいてんが　ぎっしり\n　 ならんでいる)/",
  "obj_readable_room1_slash_Other_10_gml_4521_0": "＊ (…？　ほんに　てがみが\n　 はさんである…！)/",
  "obj_readable_room1_slash_Other_10_gml_4522_0": "＊ (…)\n＊ (…)\n＊ (ての　かたちの　かみだ！)/%",
  "obj_readable_room1_slash_Other_10_gml_4526_0": "＊ (くらいところで　よむと\n　 めが　わるくなる)/%",
  "obj_readable_room1_slash_Other_10_gml_4537_0": "＊ (おおきな　ピッチャーに\n　 みずが　はいっている)/",
  "obj_readable_room1_slash_Other_10_gml_4538_0": "＊ (その　したには　カップが\n　 ならべてある)/%",
  "obj_readable_room1_slash_Other_10_gml_4542_0": "＊ (ジュースと^1　ウェハースのような\n　 クラッカーだ)/%",
  "obj_readable_room1_slash_Other_10_gml_4548_0": "＊ (しょるいだ…)~1",
  "obj_readable_room1_slash_Other_10_gml_4555_0": "\\ED＊ …そんなかに\n　 カギあける　ばんごうも\n　 あるかもだけど…/",
  "obj_readable_room1_slash_Other_10_gml_4556_0": "\\E1＊ いちまい　いちまい\n　 みてたら　キリがないぜ。/",
  "obj_readable_room1_slash_Other_10_gml_4557_0": "\\E0＊ …まずは　ほかを\n　 さがしてみようぜ。/%",
  "obj_readable_room1_slash_Other_10_gml_4564_0": "＊ (「ロード・オブ・ザ・ハンマー」が\n　 なんさつかと^1　ひょうしに　なにも\n　 かいていないノートも　すうさつ)~1",
  "obj_readable_room1_slash_Other_10_gml_4571_0": "\\ED＊ これ　ぜんぶ　しらべてたら\n　 いつまで　かかるか\n　 わかんねえな。/%",
  "obj_readable_room1_slash_Other_10_gml_4578_0": "＊ 「アルビンへ」…/",
  "obj_readable_room1_slash_Other_10_gml_4579_0": "＊ 「じーさんは　おまえお\n　 じまんの　むすこと\n　 おもつてた」/",
  "obj_readable_room1_slash_Other_10_gml_4580_0": "＊ 「きょおかいに　あんまし\n　 こなかたのは」…/",
  "obj_readable_room1_slash_Other_10_gml_4581_0": "＊ 「おまえに　じぶんの　ゆめお\n　 おいかけて　ほしかたから」/",
  "obj_readable_room1_slash_Other_10_gml_4582_0": "＊ 「それお　ちやんと　つたえれなくて\n　 すげえ　わるかたと　おもてる」/",
  "obj_readable_room1_slash_Other_10_gml_4583_0": "＊ 「だから　じぶんの\n　 ものがたりお　かけよ」/",
  "obj_readable_room1_slash_Other_10_gml_4584_0": "＊ 「カンペキじやなくて\n　 ぜんぜん　おけ」/",
  "obj_readable_room1_slash_Other_10_gml_4585_0": "＊ 「おまえの　ダチより」/%",
  "obj_readable_room1_slash_Other_10_gml_4589_0": "＊ (ゆうめいな　さっかの　ことばが\n　 かかれた　プレートだ)/",
  "obj_readable_room1_slash_Other_10_gml_4590_0": "＊ (「きぼうは^1　しんじる　ものの\n　 もとに　もたらされる^1。しんじる\n　 ことの　できぬものには」…)/",
  "obj_readable_room1_slash_Other_10_gml_4591_0": "＊ (「わたしたちの　きぼうが\n　 あかるく　かがやくことを\n　 ねがおう」)/",
  "obj_readable_room1_slash_Other_10_gml_4592_0": "＊ (「それは^1　かれらも　また\n　 やみから　まもられることを　ねがう\n　 きぼうの　ひかりだ」)/%",
  "obj_readable_room1_slash_Other_10_gml_4596_0": "＊ (おこうを　いれる\n　 いれもののようだ)/%",
  "obj_readable_room1_slash_Other_10_gml_4604_0": "＊ (ガラスの　いれものだ…\n　 なかを　みた)/",
  "obj_readable_room1_slash_Other_10_gml_4605_0": "＊ (ちいさな　きんぞくせいの\n　 ハンマーと　ろうじんの　しゃしん。\n　 どちらも　ちりに　まみれている)/",
  "obj_readable_room1_slash_Other_10_gml_4607_0": "\\ED＊ クリス…^1　それ^1…\n　 もう　みるの　やめようぜ。/%",
  "obj_readable_room1_slash_Other_10_gml_4611_0": "＊ (ガラスの　いれものだ)/%",
  "obj_readable_room1_slash_Other_10_gml_4627_0": "\\E1＊ なかに　ジャックがいる^1。\n　 あしたとかに\n　 とりにこようぜ。/%",
  "obj_readable_room1_slash_Other_10_gml_4634_0": "＊ (せいかたいの　ローブだ。\n　 クリスのサイズのもある)/",
  "obj_readable_room1_slash_Other_10_gml_4636_0": "\\E7＊ なんで　オレらは　これ\n　 きらんねーの？/",
  "obj_readable_room1_slash_Other_10_gml_4637_0": "\\EK＊ …は？　うたわねーと\n　 ダメなのかよ？/",
  "obj_readable_room1_slash_Other_10_gml_4638_0": "\\E2＊ …てか^1　オレには\n　 ドラムやらせろよな。\n　 ヘヘッ。/%",
  "obj_readable_room1_slash_Other_10_gml_4642_0": "＊ (「わ」っと　おどろくほど\n　 「ローブ」が　はいった　タンスを\n　 ワードローブと　いうらしい)/%",
  "obj_readable_room1_slash_Other_10_gml_4657_0": "\\EN＊ …ドラムたたくの\n　 たのしかったな。/",
  "obj_readable_room1_slash_Other_10_gml_4658_0": "\\E2＊ まちがえようがねえもん。\n　 ブッたたくだけだからさ。/%",
  "obj_readable_room1_slash_Other_10_gml_4673_0": "\\E6＊ …え…/",
  "obj_readable_room1_slash_Other_10_gml_4674_0": "\\E5＊ んだよ^1　カギかかってんじゃ\n　 ねーか！/",
  "obj_readable_room1_slash_Other_10_gml_4675_0": "\\EC＊ …マジかよ^1…\n　 おまえ　カギもってねーの？/",
  "obj_readable_room1_slash_Other_10_gml_4676_0": "\\EK＊ たしか　おまえのママ^1　\n　 きょうかいで　うたの\n　 れんしゅう　してんだよな？/",
  "obj_readable_room1_slash_Other_10_gml_4677_0": "\\E4＊ じゃあ^1　きょうかい　いって\n　 カギもらってこようぜ…/%",
  "obj_readable_room1_slash_Other_10_gml_4681_0": "\\E4＊ …ドアは　あかねーよ^1。\n　 きょうかいで　おまえの\n　 ママに　カギもらおうぜ。/",
  "obj_readable_room1_slash_Other_10_gml_4682_0": "\\EK＊ さすがに　まど　わるのは\n　 やりすぎだろ。/%",
  "obj_readable_room1_slash_Other_10_gml_4692_0": "＊ (おさらの　おやつは　きれいに\n　 さらってある)/%",
  "obj_readable_room1_slash_Other_10_gml_4705_0": "＊ (大扉だ…^1\n　 カギが　かかっていて\n　 びくともしない)/%",
  "obj_readable_room1_slash_Other_10_gml_4721_0": "＊ (ナゾゲーム^1！　現在　建設中！)/%",
  "obj_readable_room1_slash_Other_10_gml_4727_0": "＊ (現在　建設中！)/",
  "obj_readable_room1_slash_Other_10_gml_4728_0": "＊ (TVワールドで\n　 もっと仲間を増やしていたら\n　 完成していたはず！)/%",
  "obj_readable_room1_slash_Other_10_gml_4734_0": "＊ (この受付の担当者を\n　 募集中です！　あー残念！)/%",
  "obj_readable_room1_slash_Other_10_gml_4747_0": "＊ (リズムゲーム^1！　音に合わせて\n　 タイミングよくボタンを押して\n　 ハイスコアを目指せ！)/",
  "obj_readable_room1_slash_Other_10_gml_4748_0": "＊ (くわしい説明は\n　 ピピンズとシャドウガイに\n　 おたずねください！)/%",
  "obj_readable_room1_slash_Other_10_gml_4766_0": "＊ (スージィのベッドだ^1。\n　 スージィ以外の　だれかによって\n　 しっかり整えられている)/%",
  "obj_readable_room1_slash_Other_10_gml_4772_0": "＊ (スージィの冷蔵庫だ^1。\n　 スージィ以外の　だれかによって\n　 しっかり補充されている)/%",
  "obj_readable_room1_slash_Other_10_gml_4778_0": "\\E6＊ おい！　ここに飾ってあった\n　 もんは…？/",
  "obj_readable_room1_slash_Other_10_gml_4780_0": "\\EK＊ 倉庫に　全部しまってあるよ…/",
  "obj_readable_room1_slash_Other_10_gml_4781_0": "\\EJ＊ 今度までに　もとに\n　 もどしておくから\n　 安心して！/%",
  "obj_readable_room1_slash_Other_10_gml_4787_0": "\\E9＊ しゃ！^1　オレのロックな服^1　\n　 まだ　ちゃんとあるな！/%",
  "obj_readable_room1_slash_Other_10_gml_4793_0": "＊ (引き出しだ^1…\n　 緑色のクレヨンが\n　 たくさん入っている)/%",
  "obj_readable_room1_slash_Other_10_gml_4799_0": "＊ (…ここで眠ったら^1 \n　 どんな夢が見られるだろう？)/%",
  "obj_readable_room1_slash_Other_10_gml_4807_0": "\\EA＊ ヘッ。トロフィー\n　 山ほどあるな。/",
  "obj_readable_room1_slash_Other_10_gml_4808_0": "\\E7＊ …でも　いちばんいいヤツが\n　 ねえぞ。/",
  "obj_readable_room1_slash_Other_10_gml_4810_0": "\\EL＊ えっ？^1 \n　 いちばん…いいヤツって…？/",
  "obj_readable_room1_slash_Other_10_gml_4812_0": "\\E2＊ きょう　クリスが　もらった\n　 ちょうぜつ　ヤベえ\n　 ヤツだよ。/",
  "obj_readable_room1_slash_Other_10_gml_4814_0": "\\EH＊ そうなの^1？\n　 クリス^1　おめでとう！/",
  "obj_readable_room1_slash_Other_10_gml_4816_0": "\\E9＊ よかったな。/%",
  "obj_readable_room1_slash_Other_10_gml_4820_0": "\\E1＊ クリス^1　トロフィーが\n　 欲しかったら　いつでも\n　 言ってね…/",
  "obj_readable_room1_slash_Other_10_gml_4821_0": "\\E2＊ ボクが追加して\n　 あげるからね…！/",
  "obj_readable_room1_slash_Other_10_gml_4823_0": "\\E7＊ (あのトロフィーやれんのは\n　 オレだけだぜ)/%",
  "obj_readable_room1_slash_Other_10_gml_4831_0": "＊ (イスだ。名前は　まだない)/%",
  "obj_readable_room1_slash_Other_10_gml_4837_0": "\\E6＊ 食べかけのケーキ…\n　 そのまんまにすんのか？/",
  "obj_readable_room1_slash_Other_10_gml_4839_0": "\\EK＊ えっと…\n　 部屋を出るとき\n　 どうにかするよ！/%",
  "obj_readable_room1_slash_Other_10_gml_4848_0": "\\E7＊ おい！^1\n　 おまえの食べかけのケーキ^1　\n　 もとに　もどってるぜ！/",
  "obj_readable_room1_slash_Other_10_gml_4850_0": "\\EK＊ …食べかけを\n　 そのまんまには\n　 したくなかったから…/",
  "obj_readable_room1_slash_Other_10_gml_4852_0": "\\EK＊ …サイセーさせたのか？/%",
  "obj_readable_room1_slash_Other_10_gml_4856_0": "\\E4＊ 「どうにかする」ってのは\n　 全部食うってことじゃ\n　 ねーのかよ。/",
  "obj_readable_room1_slash_Other_10_gml_4858_0": "\\EQ＊ 食べるよ！^1　…あとでね。/%",
  "obj_rhythmgame_slash_Draw_0_gml_227_0_b": "SCORE",
  "obj_rhythmgame_slash_Draw_0_gml_234_0": "MAX COMBO",
  "obj_room_beach_slash_Step_0_gml_127_0": "\\E0＊ …おまえの　ヘンなともだち^1　\n　 きょうは　いそがしい\n　 みてぇだな。/",
  "obj_room_beach_slash_Step_0_gml_128_0": "\\E1＊ もう　いこうぜ。/%",
  "obj_room_beach_slash_Step_0_gml_200_0": "\\E2＊ …クリス^1。みてろよ？/%",
  "obj_room_beach_slash_Step_0_gml_222_0": "\\E7＊ 「みずうみきり」って\n　 いうんだぜ！/%",
  "obj_room_beach_slash_Step_0_gml_253_0": "\\EK＊ …なに　わらってんだよ^1。\n　 きこえてるぞ。/%",
  "obj_room_beach_slash_Step_0_gml_268_0": "\\EP＊ だったら　こんどは^1　\n　 おまえが　みずうみで\n　 ちからだめししてみろよな。/%",
  "obj_room_castle_2f_slash_Step_0_gml_11_0": "\\E2＊ …じつは^1　\n　 ２人に　サプライズが\n　 あるんだ！/",
  "obj_room_castle_2f_slash_Step_0_gml_12_0": "\\E1＊ お部屋に入ってみて…？/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_85_0": "\\E6＊ …えっ^1　オレらの部屋^1…\n　 くっついちまってる…？/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_87_0": "\\E1＊ うん^1　今日だけ特別ね^1。\n　 広いほうがいいと思って。/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_119_0": "\\EP＊ …ティーパーティだから！/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_138_0": "\\E2＊ …ティーパーティ^1？　\n　 んだよ　茶ぁ　飲むのか？/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_181_0": "\\EL＊ へっ…^1　ま^1　いんじゃね？/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_251_0": "\\E7＊ んー！^1　うめーな　これ！/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_253_0": "\\E2＊ ありがとう！^1　パレッタさんに\n　 手伝ってもらったんだ…/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_297_0": "\\E1＊ そ…そっか^1！\n　 ケーキもあるから^1 \n　 よかったら　食べてね…/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_311_0": "\\E2＊ はい！^1　どうぞ…/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_359_0": "\\EA＊ ほらよ。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_361_0": "\\EK＊ えっと^1…\n　 お茶も　どうぞ。/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_464_0": "\\EN＊ なんつーか^1…茶ぁ飲んで\n　 パーティとか　ダセェと\n　 思ってたけど…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_465_0": "\\E4＊ …てか^1　いまでも\n　 ダセェと思ってっけど…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_466_0": "\\ED＊ おまえらと　いっしょだと…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_467_0": "\\EN＊ べつに　そういうこと\n　 気にしなくなるんだよな。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_469_0": "\\E2＊ …スージィ…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_471_0": "\\E9＊ ラルセイのダセェ菌が\n　 うつったのかもだな。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_472_0": "\\EY＊ べつにさ^1　自分がヘタレに\n　 なってきてるってわけじゃ\n　 ねーけどさ…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_473_0": "\\ED＊ オレって　いっつも^1　\n　 ヘタレっぽく思われねぇ\n　 ようにしてた気がすんだよ。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_474_0": "\\EN＊ でも　いまは^1…\n　 べつの自分でいるときが\n　 あってもいい気がする。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_476_0": "\\E2＊ スージィ…！/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_477_0": "\\E1＊ 出会ったころと比べて\n　 スージィは　ホントに\n　 変わったね。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_478_0": "\\EJ＊ 「変わった」っていうか…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_479_0": "\\E2＊ やっと…本当の自分に\n　 なれたんだね。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_480_0": "\\E1＊ ボク^1…\n　 ボク^1　とってもうれしいよ。/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_578_0": "\\E9＊ おまえだって　変わったぜ？/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_580_0": "\\EQ＊ え…^1　そ…そう？/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_582_0": "\\E0＊ 前は　いっつも\n　 やたら「いいコ」でいて\n　 ばっかだったけどさ…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_583_0": "\\E2＊ いまは^1…ときどき\n　 フツーだよな。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_585_0": "\\E1＊ たぶん^1…スージィのおかげ\n　 じゃないかな。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_586_0": "\\E9＊ 前は　スージィの\n　 ルードバスターを\n　 怖いと思ったけど…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_587_0": "\\E1＊ いまは^1　ク…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_588_0": "\\EK＊ …クゥ～っていうぐらい\n　 かっこいいと思う！/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_590_0": "\\E9＊ フツーに\n　 「クソかっこいい」って\n　 言えよ！/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_644_0": "\\EA＊ てか　おまえ^1　\n　 ケーキ食わねーの？/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_646_0": "\\EJ＊ えっ？　食べないよ^1。\n　 スージィとクリスのだもん。/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_676_0": "\\E2＊ おまえが焼いたんだから\n　 おまえも食えよ。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_678_0": "\\EQ＊ えっと…^1　\n　 うん　わかった！/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_715_0": "\\ED＊ …！/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_716_0": "\\EH＊ わあ^1…すっごく^1…\n　 すごく　おいしいね！！/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_718_0": "\\E6＊ いやいや^1　\n　 おどろきすぎじゃね？/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_737_0": "\\ED＊ ボク^1…ケーキ食べたこと\n　 なかったんだ…/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_738_0": "\\E1＊ いつも^1　２人のために\n　 焼いてたから。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_739_0": "\\E2＊ …ケーキって　こんなに\n　 おいしいんだね！\n　 なんだか信じられないよ！/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_741_0": "\\E9＊ ハハ！　おまえ　ときどき\n　 ホント　ヘンなこと\n　 言うよな。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_742_0": "\\E2＊ 残りも全部　食えよ。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_744_0": "\\ED＊ えっ…^1　で…でも…/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_784_0": "\\E2＊ う…うん。じゃあ^1…\n　 あとで　食べようかな。/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_785_0": "\\E1＊ (こんなに　おいしいなんて…\n　 なんだか　恥ずかしいな…)/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_811_0": "\\E2＊ 落ち着けよ　クリス^1！\n　 ラルセイが　あとで　もっと\n　 作ってくれっから！/",
  "obj_room_castle_kris_susie_slash_Step_0_gml_813_0": "\\EJ＊ えっと…うん^1。\n　 よろこんで！/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_843_0": "\\E9＊ サンキュー　ラルセイ^1。\n　 楽しかったぜ。/%",
  "obj_room_castle_kris_susie_slash_Step_0_gml_879_0": "\\E2＊ (クリス^1　ときどき\n　 ラルセイが　よろこぶことも\n　 いろいろ　やってやろうぜ)/%",
  "obj_room_castle_lancer_slash_Step_0_gml_84_0": "\\E2＊ ゴチューイください\n　 イケてるボーイ^1！\n　 ここは　工事現場です！/",
  "obj_room_castle_lancer_slash_Step_0_gml_86_0": "\\EW＊ どうして　カベが\n　 なくなってるんですか！？/",
  "obj_room_castle_lancer_slash_Step_0_gml_88_0": "\\E1＊ ワカリマセン！\n　 お宝を　ホリあてるまで\n　 ホリつづけるのだ！\\f0/",
  "obj_room_castle_lancer_slash_Step_0_gml_90_0": "\\EU＊ お…お宝！？/%",
  "obj_room_castle_lancer_slash_Step_0_gml_118_0": "\\EN＊ <!--[お城]ノ　[カベ]に\n　 [肉]トカ　[フルーツ]トカ\n　 埋マッテルノ　常識ヨ-->/%/%",
  "obj_room_castle_lancer_slash_Step_0_gml_147_0": "\\EC＊ ご^1…ごめんなさい^1…\n　 ボク　まだ慣れてなくて…！/%",
  "obj_room_castle_queen_slash_Create_0_gml_21_1": "\\ES＊^6^6^6 %%",
  "obj_room_castle_queen_slash_Create_0_gml_22_1": "\\E1＊ <!--[クリス]　[スージィ]\n　 イイデショ　コレ;\n　 [ワタシ]ノ　新シイ：-->/%",
  "obj_room_castle_queen_slash_Create_0_gml_23_1": "\\ES＊^3 %%",
  "obj_room_castle_queen_slash_Create_0_gml_24_1": "\\E1＊ <!--[お部屋]ヨ-->/%",
  "obj_room_castle_queen_slash_Create_0_gml_25_1": "\\ES＊^6^6 %%",
  "obj_room_castle_queen_slash_Create_0_gml_26_1": "\\E9＊ <!--[アンタ]モ　飲ム？-->/%",
  "obj_room_castle_queen_slash_Create_0_gml_27_1": "\\EK＊ いや…^1　それ^1…\n　 酸液だろ？\n　 飲んだら死ぬし。/%",
  "obj_room_castle_queen_slash_Create_0_gml_28_1": "\\E1＊ <!--[無料プール]ニハ\n　 入ラナイシ…-->/%",
  "obj_room_castle_queen_slash_Create_0_gml_29_1": "\\EF＊ <!--[無料プールの水]ハ\n　 飲マナイシ…\n　 ワガママナ　子ネ-->/%",
  "obj_room_castle_queen_slash_Create_0_gml_30_1": "\\ED＊ <!--マア　イイワ\n　 全部　[ワタシ]ガ\n　 イタダキマス-->/%",
  "obj_room_castle_tenna_slash_Step_0_gml_13_0": "＊ なんという\n　 ファンキーで　ファニーな\n　 お部屋でSHOW！！/",
  "obj_room_castle_tenna_slash_Step_0_gml_14_0": "＊ 仮住まいに　なるかもしれませんが^1…\n　 いまのところは　とっても快適^1！\n　 すばらしい　おもてなしスキルです！/",
  "obj_room_castle_tenna_slash_Step_0_gml_15_0": "\\M1＊ (もちろん　視聴者をおもてなしする\n　 スキルなら^1　ワタシが世界イチ\n　 ですがッ！)/%",
  "obj_room_castle_tv_slash_Step_0_gml_30_0": "＊ よう　ボス。\n　 ここは　「TVスタジオ」だ。/",
  "obj_room_castle_tv_slash_Step_0_gml_31_0": "＊ いろんな　ミニゲームで\n　 遊べるぜ。/",
  "obj_room_castle_tv_slash_Step_0_gml_32_0": "＊ 勝っても負けても\n　 なににも影響しねえから\n　 気楽に遊んでくれ。/%",
  "obj_room_church_choir_slash_Step_0_gml_95_0": "\\EJ＊ うわああぁぁ！！\n　 なんだよ　これ！？/%",
  "obj_room_church_choir_slash_Step_0_gml_106_0": "\\EJ＊ …/",
  "obj_room_church_choir_slash_Step_0_gml_107_0": "\\E6＊ …ああ^1　これ　たぶん…\n　 ジャックだな。/",
  "obj_room_church_choir_slash_Step_0_gml_108_0": "\\E1＊ あいつ^1　ハロウィンのかざり\n　 なのかもな。ほかにも\n　 いろいろ　はいってるし。/",
  "obj_room_church_choir_slash_Step_0_gml_109_0": "\\E0＊ でけェから^1　きょうは\n　 キャッスルタウンに\n　 もってくのムリだな。/%",
  "obj_room_church_choir_slash_Step_0_gml_173_0": "＊ (キーボードだ。ピアノか\n　 オルガンの　おとが　でるように\n　 せっていできる)/%",
  "obj_room_church_choir_slash_Step_0_gml_183_0": "\\E0＊ …おまえが　さっき\n　 ピアノひいたときさ…/",
  "obj_room_church_choir_slash_Step_0_gml_184_0": "\\ED＊ はっきりいって^1　\n　 すげーとおもった^1。\n　 ガチで。/",
  "obj_room_church_choir_slash_Step_0_gml_185_0": "\\EK＊ きょうかいで　うたの\n　 ばんそうしろとは\n　 いわねーけどさ…/",
  "obj_room_church_choir_slash_Step_0_gml_186_0": "\\ED＊ もし　おまえが　まいしゅう\n　 ピアノひくなら…/",
  "obj_room_church_choir_slash_Step_0_gml_187_0": "\\EN＊ …きょうかい　かようのも\n　 わるくねえかもって\n　 おもう。/",
  "obj_room_church_choir_slash_Step_0_gml_188_0": "\\ED＊ …/",
  "obj_room_church_choir_slash_Step_0_gml_189_0": "\\ED＊ …てか^1　それで\n　 おもいだしたけどさ…/%",
  "obj_room_church_choir_slash_Step_0_gml_248_0": "＊ まえに　すんでたとこの\n　 はなしだけど…/",
  "obj_room_church_choir_slash_Step_0_gml_249_0": "＊ ひろば　みてぇな　とこがあって…\n　 そこに　だれでも　ひいていい\n　 ピアノが　あったんだ。/",
  "obj_room_church_choir_slash_Step_0_gml_250_0": "＊ で^1　あるひ　ためしに　ひいて\n　 みたんだよ。おもしろそう　とか\n　 おもってさ。/",
  "obj_room_church_choir_slash_Step_0_gml_251_0": "＊ でも…/",
  "obj_room_church_choir_slash_Step_0_gml_252_0": "＊ たぶん　オレが\n　 ヘタクソすぎたからだと\n　 おもうけど…/",
  "obj_room_church_choir_slash_Step_0_gml_253_0": "＊ …それか　たんに^1　オレが\n　 ピアノとか　ひいていいヤツっぽく\n　 なかったからかもだけど…/",
  "obj_room_church_choir_slash_Step_0_gml_254_0": "＊ …ひくなって　いわれたんだ。/",
  "obj_room_church_choir_slash_Step_0_gml_255_0": "＊ だから　ピアノから　はなれた。/",
  "obj_room_church_choir_slash_Step_0_gml_256_0": "＊ そしたら…^1　べつのヤツがきてさ^1　\n　 みんな　そいつに　ひかせたんだよ。/",
  "obj_room_church_choir_slash_Step_0_gml_257_0": "＊ …もっと　うまいヤツな。/",
  "obj_room_church_choir_slash_Step_0_gml_258_0": "＊ …/",
  "obj_room_church_choir_slash_Step_0_gml_259_0": "＊ しょうじき　オレも^1…なんで\n　 じぶんなんかが　ひけると\n　 おもったんだか　わかんなかった。/",
  "obj_room_church_choir_slash_Step_0_gml_260_0": "＊ そんときは…な。/",
  "obj_room_church_choir_slash_Step_0_gml_261_0": "＊ …/",
  "obj_room_church_choir_slash_Step_0_gml_262_0": "＊ そのよる^1…\n　 だれも　いないときに…/",
  "obj_room_church_choir_slash_Step_0_gml_263_0": "＊ …オレ^1　ピアノんところに\n　 もどってさ…/",
  "obj_room_church_choir_slash_Step_0_gml_264_0": "＊ …なにしたとおもう？/",
  "obj_room_church_choir_slash_Step_0_gml_265_0": "＊ …ブッたたいてやった。/",
  "obj_room_church_choir_slash_Step_0_gml_266_0": "＊ そう^1…ピアノをな。/",
  "obj_room_church_choir_slash_Step_0_gml_267_0": "＊ …こわれたかどうかは\n　 わかんねえけど…/",
  "obj_room_church_choir_slash_Step_0_gml_268_0": "＊ …おもいっきり　ブッたたいた^1。\n　 あんだけ　つよく　たたいたら^1　\n　 なんともねえわけねえよ。/",
  "obj_room_church_choir_slash_Step_0_gml_269_0": "＊ …で　はしって　にげた。/",
  "obj_room_church_choir_slash_Step_0_gml_270_0": "＊ …いっしゅうかんまえに\n　 おまえが　ピアノひけるって\n　 しってたら…/",
  "obj_room_church_choir_slash_Step_0_gml_271_0": "＊ …オレ^1　ムカついてたとおもう。/",
  "obj_room_church_choir_slash_Step_0_gml_272_0": "＊ でも　いまは…/",
  "obj_room_church_choir_slash_Step_0_gml_273_0": "＊ おまえが　ひくの^1…\n　 ききたいと　おもうんだよ。/%",
  "obj_room_church_choir_slash_Step_0_gml_286_0": "\\ED＊ …なんか　ヘンな　はなし\n　 しちまったな。/",
  "obj_room_church_choir_slash_Step_0_gml_287_0": "\\ET＊ よけい　ひきたく\n　 なくなったか？/%",
  "obj_room_church_choir_slash_Step_0_gml_321_0": "\\ED＊ …ああ。いまは\n　 そんな　はなししてる\n　 ばあいじゃねぇよな。/%",
  "obj_room_church_choir_slash_Step_0_gml_343_0": "\\E8＊ …ヘヘッ^1…マジ？/",
  "obj_room_church_choir_slash_Step_0_gml_344_0": "\\EA＊ じしんありげだな。/",
  "obj_room_church_choir_slash_Step_0_gml_345_0": "\\E9＊ じつは　うまいってこと\n　 かくしてて^1　おどろかすのが\n　 すきなんだろ？/",
  "obj_room_church_choir_slash_Step_0_gml_346_0": "\\EN＊ …たのしいだろうな。/%",
  "obj_room_church_choir_slash_Step_0_gml_368_0": "\\E6＊ …なに　おこってんだよ？/",
  "obj_room_church_choir_slash_Step_0_gml_369_0": "\\E0＊ だれかに　ひくなって\n　 いわれてんなら…/",
  "obj_room_church_choir_slash_Step_0_gml_370_0": "\\EY＊ …オレが\n　 ブンなぐってやるから。/%",
  "obj_room_church_choir_slash_Step_0_gml_401_0": "\\E6＊ …は？/",
  "obj_room_church_choir_slash_Step_0_gml_402_0": "\\E7＊ …はは^1…　おう^1！\n　 いいぜ！/",
  "obj_room_church_choir_slash_Step_0_gml_403_0": "\\ED＊ …おまえが　おしえて\n　 くれるなら…/",
  "obj_room_church_choir_slash_Step_0_gml_404_0": "\\EN＊ いつか いっしょに\n　 ひこうな。/%",
  "obj_room_church_choir_slash_Step_0_gml_440_0": "\\E6＊ …は？^1　なんて？\n　 せきしながら　いうから\n　 きこえなかったぜ…/",
  "obj_room_church_choir_slash_Step_0_gml_441_0": "\\ED＊ …/",
  "obj_room_church_choir_slash_Step_0_gml_442_0": "\\EN＊ ひくのが　こわいとか\n　 おもうこと　ないぜ。/",
  "obj_room_church_choir_slash_Step_0_gml_443_0": "\\ET＊ おまえは^1…\n　 ちゃんと　ひけるんだ^1。\n　 ヘヘッ。/%",
  "obj_room_church_choir_slash_Step_0_gml_473_0": "＊ クリス！^1　おい！/%",
  "obj_room_church_choir_slash_Step_0_gml_491_0": "\\Ee＊ …どうしたんだよ^1？\n　 なんか　いいかけたと\n　 おもったら…/",
  "obj_room_church_choir_slash_Step_0_gml_492_0": "\\Ec＊ おもいっきり\n　 じぶんの　てを\n　 かむとかさ。/",
  "obj_room_church_choir_slash_Step_0_gml_493_0": "\\Eb＊ それ^1　アザに\n　 なりそうだな…/",
  "obj_room_church_choir_slash_Step_0_gml_494_0": "\\EV＊ …/",
  "obj_room_church_choir_slash_Step_0_gml_495_0": "\\EV＊ …オレが　ヘンな　はなし\n　 したせいだな。/",
  "obj_room_church_choir_slash_Step_0_gml_496_0": "\\EW＊ もう　わすれてくれ。/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_134_0": "\\E1＊ パパ上！^1　泣かないで^1！\n　 このひとを見れば\n　 おなかが　プルプル大笑い！/",
  "obj_room_dungeon_2f_slash_Step_0_gml_136_0": "\\E0＊ 新入りの道化師か^1…\n　 芸を見せてみろ。/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_159_0": "＊ キングちゃんさま！　ワタクシが\n　 最新最先端の抱腹絶倒…\n　 ミスター・アン・テナでございます！/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_170_0": "＊ なんでも　おまかせ！\n　 ダンスも^3！　タンスも！^3\n　 息子さんの　お耳のそうじも！！/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_205_0": "＊ なぞなぞターイム！^1　トランプの\n　 カードは^1　テレビに　なんと言って\n　 声をかけたでしょーかッ！？/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_215_0": "\\E5＊ フム…/",
  "obj_room_dungeon_2f_slash_Step_0_gml_216_0": "\\E4＊ 「帰れ」。/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_232_0": "＊ あー…^1　はい^1。正解でーす！/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_239_0": "＊ ハハッ…　今日のお客さんは\n　 なかなか　手ごわいですねぇ！/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_249_0": "＊ きっとワタクシが　最先端すぎて\n　 存在意義がありすぎるせいでしょう…/%",
  "obj_room_dungeon_2f_slash_Step_0_gml_274_0": "\\E4＊ でかしたぞ　息子よ^1。\n　 こやつ…気に入った。/%",
  "obj_room_schooldoor_slash_Step_0_gml_73_0": "\\E7＊ まった^1！\n　 テナも　つれてこようぜ！/%",
  "obj_room_schooldoor_slash_Step_0_gml_114_0": "\\E9＊ うし！　いこう！/%",
  "obj_room_torhouse_slash_Step_0_gml_77_0": "\\E1＊ そうそう^1。もうすこししたら\n　 おうたの　れんしゅうに\n　 いかなきゃいけないの。/",
  "obj_room_torhouse_slash_Step_0_gml_78_0": "\\E0＊ ようが　あったら^1　\n　 きょうかいまで\n　 きてちょうだいね。/%",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_42_0": "\\ED＊ (クソッ…^1　やみのせかいで\n　 ウデが　やられちまった\n　 せいで　アイツ…)/",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_43_0": "\\EV＊ (クリス^1　どうする…？)/",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_44_0": "\\EV＊ (やみのせかいで\n　 ウデを　かいふくしてやれば\n　 こっちの　せかいでも…)/",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_45_0": "\\E6＊ (いや…　オレらの　やみの\n　 せかいを　アイツにみせたら\n　 ダメなんだよな？)/",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_46_0": "\\E0＊ (…なにも　できねーな^1…\n　 とりあえず^1　よくなるのを\n　 まつしかねえ)/%",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_108_0": "\\E1＊ あ？^1　ひとりで\n　 びょうしつに　はいる？^1　\n　 …すきにしろよ。/%",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_174_0": "\\E0＊ …なかには　バードリーが\n　 いるんだよな？/",
  "obj_room_town_hospital_hallway_slash_Step_0_gml_175_0": "\\E2＊ ヘッ^1…トリインフルとか\n　 もらってくるんじゃねーぞ。/%",
  "obj_room_town_hospital_room2_slash_Step_0_gml_24_0": "＊ (バードリーの　あたまにのっている\n　 おゆの　はいったボトルを\n　 あたらしいボトルに　かえた)/%",
  "obj_room_town_mid_slash_Step_0_gml_76_0": "＊ (とびらを　たたいた…)/",
  "obj_room_town_mid_slash_Step_0_gml_77_0": "＊ おい　ニンゲン！^1　モンスターが\n　 こわくないのか？^1　そいつに\n　 くわれたら　どうするんだ！/",
  "obj_room_town_mid_slash_Step_0_gml_79_0": "\\E9＊ クリスは　しんぱいないぜ。/",
  "obj_room_town_mid_slash_Step_0_gml_80_0": "\\EY＊ オレが　くうのは\n　 ウサギのコだけだ。/%",
  "obj_room_town_mid_slash_Step_0_gml_99_0": "＊ ママあぁぁぁぁぁぁぁぁぁ！！！/%",
  "obj_room_town_south_slash_Step_0_gml_95_0": "\\E0＊ なあ…^1　きょうはまだ\n　 ラルセイに　あってねえな。/%",
  "obj_savepoint_slash_Other_10_gml_20_0": "＊ (再び　見覚えのある町に\n　 やってきた)/",
  "obj_savepoint_slash_Other_10_gml_21_0": "＊ (著しく普通な音楽の\n　 パワーが　みなぎった)/%",
  "obj_savepoint_slash_Other_10_gml_27_0": "＊ (カフェから流れる\n　 ファンキーな音楽が　町を満たす)/",
  "obj_savepoint_slash_Other_10_gml_28_0": "＊ (ファンキータウンの\n　 パワーがみなぎった)/%",
  "obj_savepoint_slash_Other_10_gml_42_0_b": "＊ (ガラスと　香の　かおりがする)/",
  "obj_savepoint_slash_Other_10_gml_43_0": "＊ (ある種の力が　わき起こった)/%",
  "obj_savepoint_slash_Other_10_gml_55_0": "＊ (頭上に揺れるガラスの\n　 タペストリーが^1　キラキラと\n　 音を立てる^1。不思議なことに…)/",
  "obj_savepoint_slash_Other_10_gml_56_0": "＊ (どの向きから見ても\n　 見え方が変わらない)/%",
  "obj_savepoint_slash_Other_10_gml_64_0": "＊ (老人の存在が\n　 ヒゲの生えたラルセイを\n　 想像させた)/",
  "obj_savepoint_slash_Other_10_gml_65_0": "＊ (ヒゲラルセイの概念の\n　 パワーがみなぎった)/%",
  "obj_savepoint_slash_Other_10_gml_83_0_b": "＊ (暖炉の炎が　明るく燃えて^1　\n　 夜の寒さを　押しのけてゆく)/",
  "obj_savepoint_slash_Other_10_gml_84_0": "＊ (なんらかの　パワーが　みなぎった)/%",
  "obj_savepoint_slash_Other_10_gml_94_0": "＊ (暖炉の炎が　明るく輝き^1…\n　 すぐ上の　壁画を照らしている…)/",
  "obj_savepoint_slash_Other_10_gml_95_0_b": "＊ (…調べられる壁画の\n　 パワーが　みなぎった)/%",
  "obj_savepoint_slash_Other_10_gml_117_0_b": "＊ (何冊も積み上がった本たち^1…\n　 書かれた文字は\n　 読むことができない…)/",
  "obj_savepoint_slash_Other_10_gml_118_0_b": "＊ (文章を読んでいるフリをする\n　 パワーが　みなぎった)/%",
  "obj_savepoint_slash_Other_10_gml_136_0": "＊ (ろう下の先に　闇が待ちうける…)/",
  "obj_savepoint_slash_Other_10_gml_137_0": "＊ (その闇にあらがう光は\n　 おのれの目のみに映る)/%",
  "obj_savepoint_slash_Other_10_gml_145_0": "＊ (光の様子が　変化した)/%",
  "obj_savepoint_slash_Other_10_gml_152_0": "＊ (光の具合が　変化した)/",
  "obj_savepoint_slash_Other_10_gml_153_0_b": "＊ (それでも　みなぎる力は\n　 変わらない)/%",
  "obj_savepoint_slash_Other_10_gml_160_0_b": "＊ (炎は　尽きた。\n　 ここに満ちるのは…)/",
  "obj_savepoint_slash_Other_10_gml_161_0_b": "＊ (…あたたかみのない　よどんだ光)/%",
  "obj_savepoint_slash_Other_10_gml_172_0": "＊ (どちらを向いても^1　青いガラスが\n　 クリスタルのように　きらめく)/",
  "obj_savepoint_slash_Other_10_gml_173_0": "＊ (近づくと^1　やわらかい光が\n　 放たれ…)/",
  "obj_savepoint_slash_Other_10_gml_174_0": "＊ (…自分だけに見える\n　 プリズムが　現れた)/%",
  "obj_shop1_slash_Create_0_gml_65_0": "アイテム\n星形の\nキャンディ\n120HP回復",
  "obj_shop1_slash_Draw_0_gml_460_0_b": "\\E0＊ ああ^1。あんたの言いたいことは\n　 わかるよ^1。恥ずかしがるこたぁ\n　 ありゃしない。/",
  "obj_shop1_slash_Draw_0_gml_461_0_b": "\\E2＊ ナイトと戦ったんだろう^1？\n　 あいつにゃ　どうやったって\n　 勝てっこない^1。みんな知ってる\n　 ことさね…/",
  "obj_shop1_slash_Draw_0_gml_462_0": "\\E1＊ …なんと！^1　シャドウジェムを\n　 手に入れたのかい！？/",
  "obj_shop1_slash_Draw_0_gml_467_0": "\\E3＊ …なるほど^1。それじゃあ\n　 シャドウマントを\n　 取りもどせたってことだね？/",
  "obj_shop1_slash_Draw_0_gml_468_0": "\\E1＊ そいつぁ　おかしなことだよ\n　 クリス^1…　いったい　どこで\n　 見つけたんだい？/",
  "obj_shop1_slash_Draw_0_gml_471_0": "\\E1＊ …シャドウマントも使わずに！？/",
  "obj_shop1_slash_Draw_0_gml_472_0_b": "\\E2＊ ヒッヒッヒ^1…　あんたら３人は\n　 あのピエロ小僧よりも\n　 どうかしてるね！/",
  "obj_shop1_slash_Draw_0_gml_473_0_b": "\\E0＊ さぞ　おもしろい戦いだった\n　 だろうねえ！^1　あたしも\n　 見てみたかったよ…/",
  "obj_shop1_slash_Draw_0_gml_477_0_b": "\\E2＊ …ま^1　なんにせよ^1…\n　 あんたらが　シャドウジェムを\n　 手に入れた…　大事なのは　そこさ！/",
  "obj_shop1_slash_Draw_0_gml_478_0_b": "\\E0＊ これで　３つ集まった。\n　 残りは２つ。それだけあれば\n　 十分なはずだよ。/",
  "obj_shop1_slash_Draw_0_gml_479_0_b": "\\E2＊ …それだけあれば^1　いいものを\n　 作れる^1。あんたらも　きっと\n　 気に入るよ^1。がんばることさね^1。\n　 それじゃ^1　そのジェムは\n　 あたしが　預かるよ。/%",
  "obj_shop1_slash_Draw_0_gml_486_0_b": "\\E0＊ しかし　まあ^1　不思議だねぇ。\n　 次にあんたらが戦う相手は\n　 強敵だ。/",
  "obj_shop1_slash_Draw_0_gml_487_0": "\\E1＊ 戦う前から^1　あんたらの負けを\n　 知らせる鐘の音が\n　 鳴り響いてるようなもんさ。/",
  "obj_shop1_slash_Draw_0_gml_488_0": "\\E0＊ それでも　なぜか^1…\n　 あんたらが　勝つような気がして\n　 ならないよ。/",
  "obj_shop1_slash_Draw_0_gml_489_0": "\\E2＊ この感じが…「希望」ってヤツ\n　 なのかねえ…？　ハッハッハ^1！\n　 なんにせよ　おもしろいもんだ！/%",
  "obj_shop1_slash_Draw_0_gml_498_0": "\\E0＊ ああ。あんたの言いたいことは\n　 わかるよ。恥ずかしがるこたぁ\n　 ありゃしない。/",
  "obj_shop1_slash_Draw_0_gml_499_0": "\\E3＊ ナイトと戦ったんだろう？\n　 あいつにゃ　どうやったって\n　 勝てっこない。みんな知ってる\n　 ことさね…/",
  "obj_shop1_slash_Draw_0_gml_503_0_b": "\\E0＊ シャドウマントを着てたんなら^1　\n　 勝てないことも\n　 なかっただろうけども…/",
  "obj_shop1_slash_Draw_0_gml_504_0_b": "\\E3＊ シャドウクリスタルを\n　 手に入れるのは^1…\n　 一筋縄じゃいかないもんさ。/",
  "obj_shop1_slash_Draw_0_gml_507_0_b": "\\E1＊ シャドウマントを着てたらば^1　\n　 少しは勝ち目もあっただろうけども。/",
  "obj_shop1_slash_Draw_0_gml_508_0": "\\E0＊ ま^1　済んだことさね^1。\n　 マントもなけりゃ^1　ジェムもない。/",
  "obj_shop1_slash_Draw_0_gml_511_0": "\\E0＊ そんな　がっかりした顔しなさんな^1。\n　 手に入れたところで^1　なんのイミも\n　 ないのは　わかってたことさ。/",
  "obj_shop1_slash_Draw_0_gml_512_0": "\\E2＊ それでも^1…　さも　イミありげな\n　 フリをするのは　楽しかったよ。/",
  "obj_shop1_slash_Draw_0_gml_513_0": "\\E0＊ ありがとねえ。/%",
  "obj_shop1_slash_Draw_0_gml_529_0": "\\E0＊ おもしろい話をしてあげよう。\n　 アドソンたちが　うちの店を\n　 買い上げようとしてねえ。/",
  "obj_shop1_slash_Draw_0_gml_530_0": "\\E2＊ だから　カードゲームで\n　 賭けをしたのさ。/",
  "obj_shop1_slash_Draw_0_gml_531_0": "\\E3＊ あいつら^1　一手ごとに負けが\n　 込んでいって…^1　それでも強情に\n　 掛け金を倍にしつづけて…/",
  "obj_shop1_slash_Draw_0_gml_532_0": "\\E0＊ そのうち　あいつらの店も^1　\n　 持ち金も^1　着てる服も^1　\n　 全部　あたしのもんに\n　 なっちまった。/",
  "obj_shop1_slash_Draw_0_gml_533_0": "\\E2＊ ハッハッハ！/",
  "obj_shop1_slash_Draw_0_gml_534_0": "\\E0＊ もちろん　最後にゃ笑って\n　 全部　返してやったけども。/",
  "obj_shop1_slash_Draw_0_gml_535_0": "\\E2＊ ちょっと　おどかしてやった\n　 だけさね。いやぁ　楽しかったねぇ。/",
  "obj_shop1_slash_Draw_0_gml_536_0": "\\E3＊ とはいえ^1　あいつらが勝てる\n　 ルールで　やってたら^1　\n　 もっと楽しかっただろうけどねぇ。/%",
  "obj_shop1_slash_Draw_0_gml_540_0": "\\E0＊ いつまで　いるつもりだい^1？\n　 おもしろい客だねえ。/",
  "obj_shop1_slash_Draw_0_gml_541_0": "\\E2＊ 悪いけども^1　新しい商品も\n　 入らないし^1　変わったことも\n　 言わないよ。/",
  "obj_shop1_slash_Draw_0_gml_542_0": "\\E3＊ しかたないから　お茶でもいれて\n　 毛布を出してこようかね^1。\n　 気がすんだら　帰っとくれ。/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_44_0": "クリス！？　聞いてくれ！！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_53_0": "なんかヘンなんだ…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_67_0": "じいさんが…\nじいさんの様子が\nヘンなんだよ/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_81_0": "なんとかして\nオレたちのこと\n気づいてもらわねえと…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_125_0": "じいさん…\nなにやってんだよ？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_126_0": "なっ…\nなにすんだよ！！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_127_0": "たのまれた手紙\nちゃんと書いたよ…\nなんで…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_128_0": "じいさん…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_131_0": "クリス…\nじいさん なんで\nオレらが わからねえんだ？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_132_0": "やっぱりな…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_133_0": "じいさん！ 聞いてくれ！\nわかってる！\nオレは やらかした… でも…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_134_0": "だから こんなの\nもう やめようぜ…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_135_0": "…そうだよ…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_136_0": "... Ralsei...&knows what to do.../%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_137_0": "？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_167_0": "オレを…\nブンなぐるのか？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_168_0": "ひょっとして…\nまた なんか\n教えようとしてる？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_170_0": "オレだよ！\nスージィだよ！\nじいさんの…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_171_0": "じいさんの\nダチ…だろ！？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_173_0": "なんで オレが\nわかんねーの…！？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_174_0": "なんか言えって…\nなあ！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_175_0": "なんか言え\nっつってんだろ！！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_200_0": "オレは アンタを\n傷つけるつもりはねえ…\nだから…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_202_0": "だれかがケガする前に\n止めねえと/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_204_0": "この闇の世界を\n作ったとき…\nオレは なんか\nやらかしたんだ/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_205_0": "じいさんに また会いたくて…\nもう いないって\nわかってたのに…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_207_0": "キャッスルタウンに\n連れてってやっから！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_208_0": "そこへ行けば…\nじいさんも\nもとに もどるからさ！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_210_0": "じいさんが オレらを…\n傷つけるなんてさ！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_212_0": "ラルセイが 来たら\n「スリープ」使えるよな？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_213_0": "だから…\nじいさんが\nくたびれるまで\n待てば…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_215_0": "... But we...&... We can't keep.../%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_216_0": "... We can't keep&waiting for him!/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_217_0": "Not when the old&man's.../%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_218_0": "Trying to kill us!/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_264_0": "＊ あたりの空気に　音が満ちる。",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_364_0": "＊ (話しかけた…\n　 しかし　なにも起こらなかった！)/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_449_0": "は！？\nなに　やらす気だよ！？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_462_0": "オレはイヤだ！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_494_0": "クリス！？\nなにやってんだ！！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_507_0": "じいさんに…なんてこと…！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_518_0": "＊ (こうげきしようとした…)/",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_519_0": "＊ (…しかし　スージィが　立ちはだかった！)/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_555_0": "よし　わかった！\nもういい…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_574_0": "アンタが ホントに\nじいさんなら…/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_594_0": "ぜったい わかるものを\nいま 見せてやる！/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_646_0": "ヘヘッ…見えるか？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_667_0": "オレの「緑のキラキラ」\n忘れてねえよな！？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_791_0": "な…！？/%",
  "obj_sound_of_justice_enemy_slash_Step_0_gml_808_0": "なんだよ　いまの…/%",
  "obj_takingtoolong_slash_Draw_0_gml_19_0": "LONG",
  "obj_takingtoolong_slash_Draw_0_gml_21_0": "YOUR",
  "obj_takingtoolong_slash_Draw_0_gml_25_0": "YOUR ",
  "obj_takingtoolong_slash_Draw_0_gml_69_0": " TOO",
  "obj_takingtoolong_slash_Draw_0_gml_71_0": " TAKING",
  "obj_takingtoolong_slash_Draw_0_gml_73_0": "       ",
  "obj_takingtoolong_slash_Draw_0_gml_78_0": " BRIGHT",
  "obj_takingtoolong_slash_Draw_0_gml_80_0": " TOO",
  "obj_takingtoolong_slash_Draw_0_gml_85_0": " TOO",
  "obj_takingtoolong_slash_Draw_0_gml_87_0": " LONG",
  "obj_takingtoolong_slash_Draw_0_gml_93_0": "TAKING",
  "obj_takingtoolong_slash_Draw_0_gml_97_0": " TOO",
  "obj_takingtoolong_slash_Draw_0_gml_101_0": " LONG",
  "obj_takingtoolong_slash_Draw_0_gml_126_0": "IS",
  "obj_takingtoolong_short_slash_Draw_0_gml_7_0": "LONG",
  "obj_takingtoolong_short_slash_Draw_0_gml_9_0": "TUTU",
  "obj_tem_school_slash_Other_10_gml_85_0": "＊ ﾃﾐｰ　ぃぱーイ　べんきｮした。\n　 ﾃﾐｰ　まなんﾀﾞ…/",
  "obj_tem_school_slash_Other_10_gml_86_0": "＊ ﾃﾐｰ　ｼﾞｮｰｽﾞに　ぅたぅ　ほうほう\n　 まなんﾀﾞ！！/%",
  "obj_titan_enemy_slash_Create_0_gml_163_0": "＊ タマシイが輝く…\n　 新たな「こうどう」を思いついた！",
  "obj_titan_enemy_slash_Other_10_gml_4_0": "＊ タイタンの　DEFが　大きく低下！\n　 こうげきが　きわめて有効になった！",
  "obj_titan_enemy_slash_Other_10_gml_5_0": "＊\\EE 敵の「ぼうぎょ」が\n　 下がってる！\n　 「こうげき」して！",
  "obj_titan_enemy_slash_Other_10_gml_6_0": "＊\\EF いまがチャンスだよ！\n　 \\cRこうげき\\cWして！",
  "obj_titan_enemy_slash_Other_10_gml_8_0": "＊ 闇が這いずる。",
  "obj_titan_enemy_slash_Other_10_gml_9_0": "＊ 闇が満ちる。\n＊ 群れが来る。",
  "obj_titan_enemy_slash_Other_10_gml_10_0": "＊ タイタンの手が　再び動きだした。",
  "obj_titan_enemy_slash_Other_10_gml_11_0": "＊ …",
  "obj_titan_enemy_slash_Other_10_gml_15_0": "＊ 地面が揺れる。\n＊ 群れが来る。",
  "obj_titan_enemy_slash_Other_10_gml_16_0": "＊ 闇は　凝視する。\n　 ヘビが這うような音を立てて。",
  "obj_titan_enemy_slash_Other_10_gml_17_0": "＊ 一瞬…\n＊ 心臓をつかまれるような感触がした。",
  "obj_titan_enemy_slash_Other_10_gml_24_0": "\\EI＊ クソッ！　またシールドが…\n　 クリス！　もっかい光で\n　 あのシールドを　こわせ！",
  "obj_titan_enemy_slash_Other_10_gml_39_0": "\\EJ＊ あと少しだ！\n　 クリス！　その調子で\n　 シールドを　こわせ！",
  "obj_titan_enemy_slash_Step_0_gml_70_0": "＊ …",
  "obj_titan_enemy_slash_Step_0_gml_395_0": "＊ 老人が　~1に\n　 あめちゃんを　くれた！",
  "obj_titan_enemy_slash_Step_0_gml_515_0": "…やったか…？/%",
  "obj_titan_enemy_slash_Step_0_gml_593_0": "なっ…\nアイツ なにを…？/%",
  "obj_titan_enemy_slash_Step_0_gml_617_0": "…回復してる…/%",
  "obj_titan_enemy_slash_Step_0_gml_649_0": "ラルセイ！\nどうやったら\n止められる！？/%",
  "obj_titan_enemy_slash_Step_0_gml_671_0": "…/%",
  "obj_titan_enemy_slash_Step_0_gml_693_0": "わからない…/%",
  "obj_titan_enemy_slash_Step_0_gml_735_0": "ボクたち たぶん…/%",
  "obj_titan_enemy_slash_Step_0_gml_758_0": "外側の殻にしか\nダメージを\n与えられて\nなかったんだ/%",
  "obj_titan_enemy_slash_Step_0_gml_777_0": "内側に\nダメージを\n与えないかぎり…/%",
  "obj_titan_enemy_slash_Step_0_gml_796_0": "このバトルは…\n終わらない…/%",
  "obj_titan_enemy_slash_Step_0_gml_815_0": "…/%",
  "obj_titan_enemy_slash_Step_0_gml_852_0": "このまま…/%",
  "obj_titan_enemy_slash_Step_0_gml_871_0": "戦いつづけるしか…/%",
  "obj_titan_enemy_slash_Step_0_gml_966_0": "おまえさんたち\nあきらめる\nつもりかね？/%",
  "obj_titan_enemy_slash_Step_0_gml_1002_0": "まさか\n策が思いつかん\nわけじゃあるまい？/%",
  "obj_titan_enemy_slash_Step_0_gml_1027_0": "じ…じいさん！\nなんで…\nてっきり…/%",
  "obj_titan_enemy_slash_Step_0_gml_1047_0": "状況が変わるのを\n待っとっただけじゃよ/%",
  "obj_titan_enemy_slash_Step_0_gml_1067_0": "じゃが もう\nだまって\n見てはおれん/%",
  "obj_titan_enemy_slash_Step_0_gml_1106_0": "コイツを\nこらしめるぞい！/%",
  "obj_titan_enemy_slash_Step_0_gml_1126_0": "…おう！/%",
  "obj_titan_enemy_slash_Step_0_gml_1207_0": "デュアルバスター",
  "obj_titan_enemy_slash_Step_0_gml_1244_0": "ガッハッハ！\nなかなかやるのう！/%",
  "obj_titan_enemy_slash_Step_0_gml_1264_0": "ヘヘッ\nだろ？/%",
  "obj_titan_enemy_slash_Step_0_gml_1283_0": "でもやっぱり\n外側しか\n攻撃できねぇな…/%",
  "obj_titan_enemy_slash_Step_0_gml_1302_0": "なら\nやることは\nひとつじゃ/%",
  "obj_titan_enemy_slash_Step_0_gml_1323_0": "…/%",
  "obj_titan_enemy_slash_Step_0_gml_1346_0": "クリス！\nいいこと\n思いついたぜ…/%",
  "obj_titan_enemy_slash_Step_0_gml_1365_0": "ただ…/%",
  "obj_titan_enemy_slash_Step_0_gml_1384_0": "おまえは オレに\n命を あずけねぇと\nダメだ/%",
  "obj_titan_enemy_slash_Step_0_gml_1403_0": "…ガチで/%",
  "obj_titan_enemy_slash_Step_0_gml_1422_0": "…あー クソッ！\nなにを ウダウダ\n言ってんだ オレは！？/%",
  "obj_titan_enemy_slash_Step_0_gml_1464_0": "オレなら　いける！\nだよな！？\nやるぞ！！/%",
  "obj_titan_enemy_slash_Step_0_gml_1491_0": "スージィのアイデア",
  "obj_titan_enemy_slash_Step_0_gml_1525_0": "＊ タイタン - ATK 40 DEF 0\n＊ さまざまな形で顕現する\n　 闇への恐怖。/",
  "obj_titan_enemy_slash_Step_0_gml_1527_0": "\\EZ＊ クリス！！　なにしてるの！？\n　 こうげきして！！/",
  "obj_titan_enemy_slash_Step_0_gml_1528_0": "\\EZ＊ ゴメン…\n　 いまは　一刻を争うんだ…！/%",
  "obj_titan_enemy_slash_Step_0_gml_1532_0": "＊ タイタンを見て　時間をムダにした。/%",
  "obj_titan_enemy_slash_Step_0_gml_1537_0": "＊ タイタン - ATK 40 DEF 800\n＊ さまざまな形で顕現する　 闇への恐怖。/",
  "obj_titan_enemy_slash_Step_0_gml_1538_0": "＊ 「こうどう」して生きのびろ…\n　 光にさらして「勇気」を集め\n　 TPを獲得したのち…/",
  "obj_titan_enemy_slash_Step_0_gml_1539_0": "＊ 「\\cY解放\\c0」で　弱点を暴け！/%",
  "obj_titan_enemy_slash_Step_0_gml_1549_0": "＊ タマシイが輝き\n　 老人とスージィを光の力で照らした！/%",
  "obj_titan_enemy_slash_Step_0_gml_1600_0": "＊ ~1を押して　投げろ！",
  "obj_titan_enemy_slash_Step_0_gml_1627_0": "…いや ちがうな！/%",
  "obj_titan_enemy_slash_Step_0_gml_1643_0": "オレとクリスの\nスーパーダンク\nショットを食らえ！/%",
  "obj_titan_enemy_slash_Step_0_gml_1734_0": "＊ タマシイが　もっと明るく輝いた！/%",
  "obj_titan_enemy_slash_Step_0_gml_1759_0": "＊ タマシイが輝き\n　 ラルセイとスージィを光の力で照らした！/%",
  "obj_titan_enemy_slash_Step_0_gml_1817_0": "＊ タマシイが燦然と輝く！/%",
  "obj_titan_enemy_slash_Step_0_gml_1864_0": "＊ スージィが「ウェイク」を使った！/~1",
  "obj_titan_enemy_slash_Step_0_gml_1865_0": "＊ おい！　起きろ！/%",
  "obj_titan_enemy_slash_Step_0_gml_1904_0": "＊ (しかし　クリスは\n　 ダウンしていない…)/%",
  "obj_titan_enemy_slash_Step_0_gml_1919_0": "＊ ラルセイは「レイズ」を使った！/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_130_0": "＊ 自分の鼓動が　耳に響く。",
  "obj_titan_spawn_enemy_slash_Step_0_gml_131_0": "＊ 自分は　いつから　自分になった？",
  "obj_titan_spawn_enemy_slash_Step_0_gml_132_0": "＊ 敵は　砕けたガラスのような声で\n　 まくしたてた。",
  "obj_titan_spawn_enemy_slash_Step_0_gml_133_0": "＊ ラルセイは　自身に向けて\n　 「落ち着いて」と　つぶやいた。",
  "obj_titan_spawn_enemy_slash_Step_0_gml_134_0": "＊ アドレナリンのニオイがする。",
  "obj_titan_spawn_enemy_slash_Step_0_gml_157_0": "＊ タイタンスポーン -\n　 ATK 30 DEF 200\n＊ 深い闇に現れる　恐怖のかけら。/",
  "obj_titan_spawn_enemy_slash_Step_0_gml_158_0": "＊ 光に　さらして　「勇気」を集め\n　 TPを獲得したのち…/",
  "obj_titan_spawn_enemy_slash_Step_0_gml_159_0": "＊ 「\\cYバニッシュ\\c0」で　とどめをさせ！/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_166_0": "＊ クリスのタマシイが\n　 さらに明るく輝く！/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_188_0": "＊ タマシイが輝き\n　 ラルセイとスージィを光の力で照らした！/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_246_0": "＊ クリスのタマシイが\n　 燦然と輝く！/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_268_0": "＊ スージィが「ウェイク」を使った！/~1",
  "obj_titan_spawn_enemy_slash_Step_0_gml_269_0": "＊ おい！　起きろ！/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_308_0": "＊ (しかし　クリスは\n　 ダウンしていない…)/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_323_0": "＊ ラルセイは「レイズ」を使った！/%",
  "obj_town_burgerpants_slash_Step_0_gml_43_0": "\\E1＊ ああ^1　アンタか！\n　 デートが　どうなったか\n　 きになってるんだろ？/%",
  "obj_town_burgerpants_slash_Step_0_gml_59_0": "\\E9＊ かのじょは\n　 こなかった。/",
  "obj_town_burgerpants_slash_Step_0_gml_60_0": "\\EB＊ あまかったよ…/",
  "obj_town_burgerpants_slash_Step_0_gml_61_0": "\\EB＊ あんなホットな\n　 ピザガールが　オレに\n　 ホレるわけがないんだ。/",
  "obj_town_burgerpants_slash_Step_0_gml_62_0": "\\E7＊ でも^1…かのじょが\n　 おくってくるメッセは\n　 すごく^1…リアルで！/",
  "obj_town_burgerpants_slash_Step_0_gml_63_0": "\\E8＊ それに^1　はなしかたが\n　 すごく^1…キュートで！/",
  "obj_town_burgerpants_slash_Step_0_gml_64_0": "\\E1＊ しかも　きょうは　なぜか\n　 とつぜん　いつもより\n　 もっとキュートになって！！/",
  "obj_town_burgerpants_slash_Step_0_gml_65_0": "\\E9＊ …ハハ…^1　いいさ。\n　 オレは　いつも\n　 こういう　やくまわりさ。/",
  "obj_town_burgerpants_slash_Step_0_gml_66_0": "\\EB＊ ほんみょうで　よばれた\n　 こともない。みんなに\n　 ピザパンて　よばれてるよ。/%",
  "obj_town_burgerpants_slash_Step_0_gml_82_0": "\\ED＊ ！？^1　メッセがきた！？/%",
  "obj_town_burgerpants_slash_Step_0_gml_89_0": "\\E7＊ 「ごめんなさい^1　あなたを\n　 さがしたけど\n　 みつけられなくて」…/",
  "obj_town_burgerpants_slash_Step_0_gml_90_0": "\\EA＊ 「ピザやさんの　そばに\n　 てづくりクッキーを\n　 おいておきました」/%",
  "obj_town_burgerpants_slash_Step_0_gml_115_0": "\\ED＊ いま　いくよ\n　 ピザリナちゃぁ～ん！！/%",
  "obj_town_burgerpants_slash_Step_0_gml_130_0": "\\EE＊ ホントだ！^1！\n　 クッキーあった！^1！\n　 しかも　オレそっくりの！！/",
  "obj_town_burgerpants_slash_Step_0_gml_131_0": "\\ED＊ ってことは！！^1　つまり！^1！\n　 かのじょは\n　 じつざいする！！/%",
  "obj_town_burgerpants_slash_Step_0_gml_144_0": "\\E7＊ ！！^1　クッキーのふくろに\n　 てがみが　はいってる！/",
  "obj_town_burgerpants_slash_Step_0_gml_145_0": "\\E7＊ なになに…？/",
  "obj_town_burgerpants_slash_Step_0_gml_146_0": "\\ED＊ あした　まつりで\n　 オレに　あいたい！？/",
  "obj_town_burgerpants_slash_Step_0_gml_147_0": "\\EC＊ っしゃぁぁぁああ！^1！\n　 オレ　だいしょうりぃい！！/",
  "obj_town_burgerpants_slash_Step_0_gml_148_0": "\\EA＊ ピザリナちゃぁ～ん！^1！\n　 まっててえぇ～～！！/%",
  "obj_town_burgerpants_slash_Step_0_gml_242_0": "＊ …かれが　しあわせなら^1　\n　 ボクは　それで　いいんだ…/%",
  "obj_town_burgerpants_slash_Step_0_gml_258_0": "＊ あ^1！　おきゃくさん^1？　アイス\n　 クリーム^1　つくってあげたいけど\n　 きょうは　もう　へいてんだよ！/",
  "obj_town_burgerpants_slash_Step_0_gml_259_0": "＊ …/%",
  "obj_town_krisyard_slash_Step_0_gml_61_0": "\\EZ＊ テナが　ぬれちまう^1！\n　 がっこうに　もってくから\n　 ちょっと　まっててくれ！/%",
  "obj_town_krisyard_slash_Step_0_gml_85_0": "\\EZ＊ あいつ^1　くしゃみして\n　 ふるえてたぜ…/",
  "obj_town_krisyard_slash_Step_0_gml_86_0": "\\EA＊ ランサーが　ひやけブースに\n　 いれてたから^1　だいじょうぶ\n　 だとおもうけど。/%",
  "obj_town_north_slash_Step_0_gml_40_0": "＊ …え？^1　ボクに^1？\n　 キミのテレビを？/",
  "obj_town_north_slash_Step_0_gml_41_0": "＊ …な^1…なんでだい^1？\n　 なにかのワナ…？/",
  "obj_town_north_slash_Step_0_gml_43_0": "\\EK＊ ボロいし　ふるいし\n　 いろも　なんかヘンだけど…/",
  "obj_town_north_slash_Step_0_gml_44_0": "\\EN＊ それでも^1…\n　 すごく　いいテレビなんだ。/",
  "obj_town_north_slash_Step_0_gml_46_0": "＊ …へえ^1。じゃあ^1　ここへ\n　 もってきてくれるかい？/",
  "obj_town_north_slash_Step_0_gml_48_0": "\\E6＊ え^1。も…もちろん^1！\n　 ちょっと　まってろよな！/%",
  "obj_town_north_slash_Step_0_gml_69_0": "＊ わあ！^1　これは　ハンサムな\n　 テレビだ^1。どこのメーカー？/",
  "obj_town_north_slash_Step_0_gml_71_0": "\\EN＊ わかんねーけど^1　\n　 なまえは　テナだ。/",
  "obj_town_north_slash_Step_0_gml_73_0": "＊ …テレビに　なまえがあるの？/",
  "obj_town_north_slash_Step_0_gml_75_0": "\\EK＊ あー…いや^1。っていうか\n　 まあ^1…　ニックネーム\n　 みたいな？/",
  "obj_town_north_slash_Step_0_gml_77_0": "＊ 「アンテナ」の　りゃくかな^1？\n　 かわいいね^1。じゃあ　えんりょなく\n　 もらうよ。/",
  "obj_town_north_slash_Step_0_gml_79_0": "\\E7＊ マジ！^1？　ったぜ　クリス！\n　 ひきとりてが\n　 みつかったな！/",
  "obj_town_north_slash_Step_0_gml_81_0": "＊ アハハ^1！　キミたち　このテレビが\n　 ほんとうに　だいすきなんだね^1。\n　 しんぱいしないで…/",
  "obj_town_north_slash_Step_0_gml_82_0": "＊ ボクと　ミスター・テナは　\n　 ぼうけいの　ともに\n　 なれそうな　きがするよ。/",
  "obj_town_north_slash_Step_0_gml_84_0": "\\EK＊ ボーケイ？^1　わかんねー\n　 けど…^1　いま^1　なかに\n　 はこんでやるよ。/%",
  "obj_town_school_slash_Step_0_gml_18_0": "\\EV＊ …もう　おそいし…/",
  "obj_town_school_slash_Step_0_gml_19_0": "\\EV＊ いえに　かえらねえ？/%",
  "obj_town_school_slash_Step_0_gml_23_0": "\\EV＊ …/%",
  "obj_treasure_room_slash_Other_10_gml_30_0": "＊ (宝箱を開けた)/",
  "obj_treasure_room_slash_Other_10_gml_31_0": "＊ (なにも入っていない)/%",
  "obj_tutorial_text_slash_Draw_73_gml_13_0": "Jump",
  "obj_tutorial_text_slash_Draw_73_gml_14_0": "やめる",
  "obj_tutorial_text_slash_Draw_73_gml_15_0": "長押し",
  "obj_tutorial_text_slash_Draw_73_gml_16_0": "リセット",
  "obj_tutorial_text_slash_Draw_73_gml_17_0": "弾く",
  "obj_tutorial_text_slash_Draw_73_gml_18_0": "ピアノを弾く",
  "obj_tutorial_text_slash_Draw_73_gml_19_0": "本だなを動かす",
  "obj_tutorial_text_slash_Draw_73_gml_20_0": "ピアノを動かす",
  "obj_tutorial_text_slash_Draw_73_gml_21_0": "オクターブ変更",
  "obj_tutorial_text_slash_Draw_73_gml_22_0": "チャージジャンプ",
  "obj_yourlong_slash_Draw_0_gml_7_0": "LO          NG",
  "obj_yourlong_slash_Draw_0_gml_9_0": "YOUR          LONG",
  "scr_armorinfo_slash_scr_armorinfo_gml_704_0": "ウエハガード",
  "scr_armorinfo_slash_scr_armorinfo_gml_705_0": "もろそうに見えるものの　まほうの力で\n衝撃ダメージを吸収する。DEF+4",
  "scr_armorinfo_slash_scr_armorinfo_gml_706_0": "(食ったらダメだ…)",
  "scr_armorinfo_slash_scr_armorinfo_gml_707_0": "ヨダレがついてる…",
  "scr_armorinfo_slash_scr_armorinfo_gml_708_0": "チーズアーマーと相性よさそう！",
  "scr_armorinfo_slash_scr_armorinfo_gml_725_0": "ミスティバンド",
  "scr_armorinfo_slash_scr_armorinfo_gml_726_0": "こはく色にそめられた銀のアミュレット。\nまりょくのみを強化。MAG+4",
  "scr_armorinfo_slash_scr_armorinfo_gml_727_0": "ルードバスター食らえ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_728_0": "いやしの歌だ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_729_0": "(別の味のほうが好きだな)",
  "scr_armorinfo_slash_scr_armorinfo_gml_746_0": "パワーバンド",
  "scr_armorinfo_slash_scr_armorinfo_gml_747_0": "紅色にそめられた銀のアミュレット。\nこうげきりょくのみを強化。ATK+4",
  "scr_armorinfo_slash_scr_armorinfo_gml_748_0": "ブラッドパワーだぜ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_749_0": "グビグビッ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_750_0": "またアクセサリー？",
  "scr_armorinfo_slash_scr_armorinfo_gml_767_0": "プリティリボン",
  "scr_armorinfo_slash_scr_armorinfo_gml_768_0": "てぶくろとセットのレースのリボン。\nエレガントなシースルー。DEF+4　ATK+2",
  "scr_armorinfo_slash_scr_armorinfo_gml_769_0": "てぶくろ合わねぇ",
  "scr_armorinfo_slash_scr_armorinfo_gml_770_0": "カワイイ！(てぶくろ合わない)",
  "scr_armorinfo_slash_scr_armorinfo_gml_771_0": "てぶくろはクリスにあげるね！",
  "scr_credit_slash_scr_credit_gml_44_0_b": "-メイン チーム-",
  "scr_credit_slash_scr_credit_gml_54_0_b": "Mike Maker (PC ver.)",
  "scr_credit_slash_scr_credit_gml_64_0_b": "-コンセプト アート-\n（背景／コスチューム／タイタン）",
  "scr_credit_slash_scr_credit_gml_71_0": "-老人のテーマ アレンジ-",
  "scr_credit_slash_scr_credit_gml_78_0": "-歌-\n (サンクチュアリ／クレジット)",
  "scr_credit_slash_scr_credit_gml_88_0": "-生ピアノ エディット-",
  "scr_credit_slash_scr_credit_gml_95_0": "-タイタンの手／クリスのピアノ アニメーション-",
  "scr_credit_slash_scr_credit_gml_102_0": "-ピクセル アート アシスタント-",
  "scr_credit_slash_scr_credit_gml_113_0": "-追加 FX-",
  "scr_credit_slash_scr_credit_gml_120_0": "-Wicabel Bullet Pattern-",
  "scr_credit_slash_scr_credit_gml_127_0": "-TBD-",
  "scr_credit_slash_scr_credit_gml_146_0": "-Ch2＆3 ゲスト キャラクターデザイン-",
  "scr_credit_slash_scr_credit_gml_164_0": "-開発ツール (Cool)-",
  "scr_credit_slash_scr_credit_gml_171_0": "-UT キャラクター デザイン-",
  "scr_encountersetup_slash_scr_encountersetup_gml_841_0": "＊ グウェイが　ただよってきた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_864_0": "＊ バルタザードが　ユラッと現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_887_0": "＊ ビブリオクスが　パタッと開いた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_910_0": "＊ ミズルは　目を覚ました！",
  "scr_encountersetup_slash_scr_encountersetup_gml_948_0": "＊ ウィカベルが　カランと現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_971_0": "＊ ウィングレードが　切り込んできた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_995_0": "＊ オルガニックが　近づいてきた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1035_0": "＊ 不協和音が鳴りひびく。",
  "scr_encountersetup_slash_scr_encountersetup_gml_1058_0": "＊ 香りつきキャンドルの\n　 ニオイがする。",
  "scr_encountersetup_slash_scr_encountersetup_gml_1143_0_b": "＊ 羽根の羽ばたきと\n　 ページのめくれる音が\n　 あたりに広がった。",
  "scr_encountersetup_slash_scr_encountersetup_gml_1441_0": "＊ 闇が　締めつける。\n＊ \\cYお宝\\c0以外は　\\cYTP\\c0獲得量が　ダウン！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1450_0": "＊ 闇が締めつける…\n＊ \\cG？？？\\c0以外は\\cYTP\\c0獲得量がダウン。",
  "scr_encountersetup_slash_scr_encountersetup_gml_1474_0": "＊ 闇が　締めつける…\n＊ \\cYTP\\c0獲得量が　ダウン！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1497_0": "＊ 闇が締めつける…\n＊ \\cG？？？\\c0以外は\\cYTP\\c0獲得量がダウン。",
  "scr_encountersetup_slash_scr_encountersetup_gml_1597_0": "＊ これは　よくある\n　 ウォータークーラーではない！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1663_0": "＊ 闇が　締めつける…\n＊ \\cYTP\\c0獲得量が　ダウン！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1745_0": "＊ 不協和音が鳴りひびく！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1787_0": "＊ 水、火、風。",
  "scr_encountersetup_slash_scr_encountersetup_gml_1819_0": "＊ ウィカベルが　カランと現れた！",
  "scr_encountersetup_slash_scr_encountersetup_gml_1848_0": "＊ 鋼の響きが　曲を奏でる。",
  "scr_get_completed_file_name_slash_scr_get_completed_file_name_gml_15_0": "シェルターの外",
  "scr_get_team_name_slash_scr_get_team_name_gml_2_0": "チーム",
  "scr_get_team_name_slash_scr_get_team_name_gml_4_0": "$!$?団",
  "scr_get_team_name_slash_scr_get_team_name_gml_5_0": "ランサー・ファンクラブ",
  "scr_get_team_name_slash_scr_get_team_name_gml_6_0": "たのしみ隊",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_9_0": "時間がたって　甘さが増したキャンディ。\n焼いたマシュマロの味がするらしい。HP+120",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_142_0": "チョコ味のコーンに　まほうのシンボルが\n彫り込まれている。クリス専用。HP+400",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_145_0": "軽い口当たりの銀色ドリンク。注ぐと\nやさしい歌声のような音がする。HP115回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_148_0": "真っ赤なドリンク。甘ったるい\nフルーツフレーバー。HP160回復。",
  "scr_itemdesc_single_slash_scr_itemdesc_single_gml_151_0": "空から降ってきた　苦い水の滴。\n仲間１人のHPを全回復。",
  "scr_iteminfo_slash_scr_iteminfo_gml_16_0_b": "DDキャンディ",
  "scr_iteminfo_slash_scr_iteminfo_gml_17_0": "120HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_291_0": "オールドスイート",
  "scr_iteminfo_slash_scr_iteminfo_gml_292_0": "クリス専用\n400HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_298_0": "ラプソティー",
  "scr_iteminfo_slash_scr_iteminfo_gml_299_0": "115HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_305_0": "スカーレッティー",
  "scr_iteminfo_slash_scr_iteminfo_gml_306_0": "160HP\n回復",
  "scr_iteminfo_slash_scr_iteminfo_gml_312_0": "ビターティア",
  "scr_iteminfo_slash_scr_iteminfo_gml_313_0": "仲間１人の\nHPを\n全回復",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_9_0": "DDキャンディ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_126_0": "オールドスイート",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_129_0": "ラプソティー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_132_0": "スカーレッティー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_135_0": "ビターティア",
  "scr_itemuse_slash_scr_itemuse_gml_741_0": "どんだけ古いんだよ！？",
  "scr_itemuse_slash_scr_itemuse_gml_745_0": "クリスの大好物…でしょ？",
  "scr_itemuse_slash_scr_itemuse_gml_749_0": "お肉食べるほうがマシ…",
  "scr_itemuse_slash_scr_itemuse_gml_760_0": "ノエルが うたう歌のことだろ？",
  "scr_itemuse_slash_scr_itemuse_gml_764_0": "…予言の聖歌。",
  "scr_itemuse_slash_scr_itemuse_gml_768_0": "(クリスは聖歌隊に入らないよね)",
  "scr_itemuse_slash_scr_itemuse_gml_780_0": "っしゃあ！カンパーイ！",
  "scr_itemuse_slash_scr_itemuse_gml_784_0": "お薬の味がする…",
  "scr_itemuse_slash_scr_itemuse_gml_793_0": "…わかった…最後の一滴あげる",
  "scr_itemuse_slash_scr_itemuse_gml_809_0": "…雨水か？",
  "scr_itemuse_slash_scr_itemuse_gml_813_0": "雪を食べたときの味。",
  "scr_itemuse_slash_scr_itemuse_gml_865_0": "＊ ジェムを　目の前にかかげた。/",
  "scr_itemuse_slash_scr_itemuse_gml_866_0": "＊ なぜか^1　どの角度から見ても…/",
  "scr_itemuse_slash_scr_itemuse_gml_867_0": "＊ ジェムの中で　予言の文字が\n　 ゆがんで見えない。/%",
  "scr_itemuse_slash_scr_itemuse_gml_876_0": "＊ ジェムを　目の前にかかげた。/",
  "scr_itemuse_slash_scr_itemuse_gml_877_0": "＊なぜか…/",
  "scr_itemuse_slash_scr_itemuse_gml_878_0": "＊ 予言の文字が　ゆがんで見えない。/",
  "scr_itemuse_slash_scr_itemuse_gml_879_0": "＊ ジェムを振ってみた。/",
  "scr_itemuse_slash_scr_itemuse_gml_880_0": "＊ なにも　変わらなかった。/%",
  "scr_itemuse_slash_scr_itemuse_gml_897_0": "＊ ジェムを　目の前にかかげた。/",
  "scr_itemuse_slash_scr_itemuse_gml_898_0": "＊ なぜか^1　ほんの一瞬…/",
  "scr_itemuse_slash_scr_itemuse_gml_899_0": "＊ 教会のロビーが\n　 見えた気がした。/%",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_177_0": "楽譜",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_178_0": "スージィが　音符を書き写そうとしたもの。\n「つかう」と読める。",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_182_0": "ノボるのツメ",
  "scr_keyiteminfo_slash_scr_keyiteminfo_gml_183_0": "とても小さくて　都合よく目に見えないツメ。\n使えば　いかにも登れそうなカベを登れる。",
  "scr_litemdesc_slash_scr_litemdesc_gml_59_0": "＊ 「ホリデーエンピツ」  - ATK+1\n＊ キャンディステッキのかたち。\n＊ たべられない。/%",
  "scr_litemdesc_slash_scr_litemdesc_gml_62_0": "＊ 「サボテンのトゲ」 - ATK+2\n＊ イタイ…！　…こころが。/%",
  "scr_litemdesc_slash_scr_litemdesc_gml_65_0": "＊ 「ブラックシャード」 - ものすごく\n　 かたいガラスの　ちいさなかけら。\n＊ ほとんど　ふとうめい。/%",
  "scr_litemdesc_slash_scr_litemdesc_gml_68_0": "＊ 「はねペン」 - ATK+1\n＊ えの　ぶぶんが　しろいはねで\n　 できているペン。/%",
  "scr_litemname_slash_scr_litemname_gml_21_0": "ホリデーエンピツ",
  "scr_litemname_slash_scr_litemname_gml_22_0": "サボテンのトゲ",
  "scr_litemname_slash_scr_litemname_gml_23_0": "ブラックシャード",
  "scr_litemuseb_slash_scr_litemuseb_gml_10_0": "＊ なぜか　そうび　できない。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_209_0": "＊ ガラスを　とおして\n　 むこうを　みた。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_210_0": "＊ なぜか^1　ほんの　いっしゅん…/",
  "scr_litemuseb_slash_scr_litemuseb_gml_211_0": "＊ ノエルが　すぐちかくで\n　 なにか　ささやいているのが\n　 みえたきがした。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_212_0": "＊ ガラスを　みみに　あてた。/",
  "scr_litemuseb_slash_scr_litemuseb_gml_213_0": "＊ …もちろん　なにも　おこらなかった。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_221_0": "＊ けしごむを　そうびした。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_228_0": "＊ シャーペンを　そうびした。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_235_0": "＊ ホリデーエンピツを　そうびした。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_242_0": "＊ サボテンのトゲを　そうびした。/%",
  "scr_litemuseb_slash_scr_litemuseb_gml_249_0": "＊ ブラックシャードを　そうびした。/%",
