  "obj_ch4_DCA01_old_slash_Step_0_gml_277_0": "\\EJ* We've got you now...!/%",
  "obj_ch4_DCA02_slash_Step_0_gml_81_0": "\\Eb＊ クソッ^1…\n　 なんでナイトが　ここに…/",
  "obj_ch4_DCA02_slash_Step_0_gml_82_0": "\\Ec＊ 闇の泉を作ったのは\n　 あいつだ…/",
  "obj_ch4_DCA02_slash_Step_0_gml_83_0": "\\Ee＊ …ひょっとして…\n　 また　だれかを\n　 さがしてんのか…/",
  "obj_ch4_DCA02_slash_Step_0_gml_84_0": "\\EV＊ …/",
  "obj_ch4_DCA02_slash_Step_0_gml_85_0": "\\EV＊ …先へ進もうぜ。/%",
  "obj_ch4_DCA02_slash_Step_0_gml_180_0": "\\EZ＊ …クリス！？/%",
  "obj_ch4_DCA02_slash_Step_0_gml_193_0": "\\EZ＊ おまえ^1…ガラスで\n　 ケガしたのかよ^1…\n　 気づかなかったぜ…/",
  "obj_ch4_DCA02_slash_Step_0_gml_194_0": "\\ER＊ 血が出てんな…/",
  "obj_ch4_DCA02_slash_Step_0_gml_195_0": "\\ES＊ …うし^1…まかせろ^1。\n　 いま　オレが回復してやる！/%",
  "obj_ch4_DCA02_slash_Step_0_gml_233_0": "\\ED＊ …クソッ…ダメだ^1。\n　 足りねーな…/%",
  "obj_ch4_DCA02_slash_Step_0_gml_268_0": "\\E8＊ …どこ…だろう…？/%",
  "obj_ch4_DCA02_slash_Step_0_gml_288_0": "\\E7＊ ラルセイ…！　おーい！/",
  "obj_ch4_DCA02_slash_Step_0_gml_290_0": "\\EC＊ …スージィ！？/%",
  "obj_ch4_DCA02_slash_Step_0_gml_310_0": "\\ER＊ 見てくれよ。クリスが…/",
  "obj_ch4_DCA02_slash_Step_0_gml_312_0": "\\EC＊ わあ　大変…！/%",
  "obj_ch4_DCA02_slash_Step_0_gml_331_0": "\\ET＊ ラルセイ　教えてくれよ^1。\n　 どうやったら…/",
  "obj_ch4_DCA02_slash_Step_0_gml_333_0": "\\EQ＊ スージィ^1　ちょっと\n　 どいてくれるかな？/%",
  "obj_ch4_DCA02_slash_Step_0_gml_384_0": "\\EQ＊ クリス　大丈夫？/%",
  "obj_ch4_DCA02_slash_Step_0_gml_399_0": "\\ED＊ …オレが回復しようと\n　 したんだけどさ…/%",
  "obj_ch4_DCA02_slash_Step_0_gml_418_0": "\\Ea＊ うん^1。自分の力で\n　 治したかったんだよね？\n　 でも…/",
  "obj_ch4_DCA02_slash_Step_0_gml_419_0": "\\EQ＊ だれかが　大ケガしたときは…\n　 ひとりで　なんとかしようと\n　 しないでね。/",
  "obj_ch4_DCA02_slash_Step_0_gml_421_0": "\\ES＊ …ああ^1。\n　 わかったよ。/%",
  "obj_ch4_DCA02_slash_Step_0_gml_505_0": "\\E3＊ てかさ^1…　\n　 また　 ~1が\n　 勢ぞろいだな。/",
  "obj_ch4_DCA02_slash_Step_0_gml_506_0": "\\E2＊ …いつものポーズ^1…やるか？/",
  "obj_ch4_DCA02_slash_Step_0_gml_508_0": "\\EQ＊ うん！^1　そうだね…やろう！/%",
  "obj_ch4_DCA02_slash_Step_0_gml_550_0": "\\EQ＊ じゃ^1　行こっか。/%",
  "obj_ch4_DCA02_slash_Step_0_gml_571_0": "\\E0＊ …/%",
  "obj_ch4_DCA04_slash_Step_0_gml_81_0": "\\E7＊ うお！/%",
  "obj_ch4_DCA04_slash_Step_0_gml_115_0": "\\E2＊ これ^1　オレたちのことだよな？/",
  "obj_ch4_DCA04_slash_Step_0_gml_117_0": "\\EQ＊ そうだよ　スージィ^1！\n　 ボクたちは　予言に語られる\n　 勇者で…/",
  "obj_ch4_DCA04_slash_Step_0_gml_124_0": "\\EK＊ …初めて会ったときに\n　 この話をしようと\n　 思ったんだけど…/",
  "obj_ch4_DCA04_slash_Step_0_gml_126_0": "\\EK＊ …ああ^1。聞かなくて\n　 悪かったよ。/",
  "obj_ch4_DCA04_slash_Step_0_gml_133_0": "\\EA＊ そうそう^1。たしか\n　 そんな話してたよな。/",
  "obj_ch4_DCA04_slash_Step_0_gml_137_0": "\\E2＊ …こうやって\n　 あらためて見ると^1…\n　 ヤバくね？/",
  "obj_ch4_DCA04_slash_Step_0_gml_139_0": "\\EN＊ …なんつーか^1…まるで…",
  "obj_ch4_DCA04_slash_Step_0_gml_196_0": "\\EZ＊ ！？/",
  "obj_ch4_DCA04_slash_Step_0_gml_197_0": "\\EH＊ うぉい！！^1　だれだよ^1！\n　 ケンカ売ってんのか！？/%",
