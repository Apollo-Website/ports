  "obj_dw_churchb_bookshelf_slash_Step_0_gml_98_0": "たどった。　",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_99_0": "迷子　",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_100_0": "とがった　",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_101_0": "で　",
  "obj_dw_churchb_bookshelf_slash_Step_0_gml_102_0": "育つ　",
  "obj_minigame_evaluation_slash_Draw_0_gml_22_0": "NO RANK",
  "obj_round_evaluation_slash_Draw_0_gml_22_0_b": "NO RANK",
  "obj_titan_enemy_slash_Step_0_gml_1550_0": "＊ タイタン - \n　 致命傷を負っていないあいだは\n　 体力を回復できるようだ。/%",
  "scr_spelltext_slash_scr_spelltext_gml_357_0": "＊ ~1は&　 テンションビッツを使った！/%",
  "scr_credit_slash_scr_credit_gml_275_0": "Monami Katayama [セールス部]",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_914_0": "\nキャッスル\nタウンに\nもどる",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_915_0": "\nここに\nとどまる",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_920_0": "\\EC＊ なんだこれ^1…？\n　 キャッスルタウンにも\n　 あるヤツか？/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_922_0": "\\E6＊ 光の世界への\n　 帰り道…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_923_0": "\\E5＊ まさか^1…\n　 教会のとびらが\n　 開いた…？/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_925_0": "\\EC＊ どうする？/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_942_0": "\nキャッスル\nタウンに\nもどる",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_943_0": "\nここに\nとどまる",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_948_0": "＊ (光の柱だ…)/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_978_0": "\\ED＊ だな^1…\n　 いま　もどるわけには\n　 いかねえ。/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1025_0": "\\EC＊ は…^1？　いやいや…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1026_0": "\\ED＊ いま　もどったら^1…\n　 トリエルさんが…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1028_0": "\\EQ＊ …スージィ^1…\n　 スージィが行かないなら　\n　 ボクも　残らないと…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1030_0": "\\ED＊ …/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1031_0": "\\E0＊ クリス^1　行くなら…/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1032_0": "\\E1＊ 寄り道ナシで\n　 サクッと行ってこい。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1034_0": "\\EQ＊ 早く　もどってきてね…！/%",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1166_0": "\\EC＊ …待ちくたびれたぜ。/",
  "obj_dw_church_knightclimbpost_slash_Step_0_gml_1168_0": "\\EQ＊ クリス…えっと^1…\n　 楽しかった？/%",
  "obj_miccheck_slash_Other_10_gml_16_0": "* You're using the gamepad!/%",
  "obj_miccheck_slash_Other_10_gml_24_0": "＊ (ナゾめいた\n　 マイクロフォン検知器だ)/",
  "obj_miccheck_slash_Other_10_gml_25_0": "＊ (…マイクロフォンを\n　 検知できないようだ)/",
  "obj_miccheck_slash_Other_10_gml_26_0": "＊ (マイクロフォンさえあれば\n　 検知するだろう)/%",
  "obj_miccheck_slash_Other_10_gml_30_0": "＊ (マイクロフォンを\n　 検知できないようだ…)/",
  "obj_miccheck_slash_Other_10_gml_31_0": "＊ (…ちなみに^1　マイクロフォンを\n　 検知できなくても^1　\n　 責任は　一切負わない…)/",
  "obj_miccheck_slash_Other_10_gml_32_0": "＊ (どうやら　サードパーティの\n　 検知方式…的な　なにかを\n　 使用しているようだ)/%",
  "obj_miccheck_slash_Other_10_gml_44_0": "＊ (マイクロフォンの形をした\n　 ナゾめいた　クリスタルがある)/",
  "obj_miccheck_slash_Other_10_gml_45_0": "＊ (球体を　じっと見つめるうちに^1　\n　 マイクロフォンのことが\n　 頭に浮かんできた…)/%",
  "obj_micmenu_slash_Create_0_gml_39_0": "マイクを選択",
  "obj_micmenu_slash_Create_0_gml_40_0": "音量を調整",
  "obj_micmenu_slash_Create_0_gml_41_0": "終了",
  "obj_micmenu_slash_Draw_0_gml_53_0": "＊ 現在のマイク：  ",
  "obj_micmenu_slash_Draw_0_gml_92_0": "音量",
  "obj_micmenu_slash_Draw_0_gml_94_0": "マイク",
  "obj_micmenu_slash_Draw_0_gml_116_0": "終了",
  "obj_micmenu_slash_Draw_0_gml_165_0": "Loading...",
  "obj_micmenu_slash_Draw_0_gml_213_0": "音量を調整",
  "obj_mike_attack_controller_slash_Create_0_gml_145_0": "＊ マイクは　ナデナデされた！/",
  "obj_mike_attack_controller_slash_Create_0_gml_146_0": "＊ マウスは　フルーツボーナスを\n　 差し出した！/",
  "obj_mike_attack_controller_slash_Create_0_gml_147_0": "＊ マウスは　かみつかれた！/",
  "obj_mike_attack_controller_slash_Create_0_gml_148_0": "＊ ラルセイは　ナデナデされた！/",
  "obj_mike_attack_controller_slash_Create_0_gml_152_0": "＊ マイクは　ふだんと変わらず\n　 大きな声で　しゃべりつづけている。",
  "obj_mike_attack_controller_slash_Create_0_gml_153_0": "＊ マイクは　クシで頭を整えた。",
  "obj_mike_attack_controller_slash_Create_0_gml_154_0": "＊ マイクは　まちがいなく\n　 マイクロフォンだ！",
  "obj_mike_attack_controller_slash_Create_0_gml_157_0": "＊ マイクは　ふだんと変わらず\n　 だまって　おどっている。",
  "obj_mike_attack_controller_slash_Create_0_gml_158_0": "＊ マイクは　じゃっかん\n　 ジャズに　夢中に\n　 なりすぎているようだ。",
  "obj_mike_attack_controller_slash_Create_0_gml_159_0": "＊ マイクは　まちがいなく\n　 ネコだ！",
  "obj_mike_attack_controller_slash_Create_0_gml_162_0": "＊ マイクは　まちがいなく\n　 カウボーイだ！",
  "obj_mike_attack_controller_slash_Create_0_gml_163_0": "＊ マイクは　じゃっかん\n　 ジャケットの着心地が悪そうだ。",
  "obj_mike_attack_controller_slash_Create_0_gml_164_0": "＊ マイクは　音量を調節しようか\n　 考えている。",
  "obj_mike_attack_controller_slash_Create_0_gml_167_0": "＊ マイクは　まちがいなく…！？",
  "obj_mike_attack_controller_slash_Create_0_gml_168_0": "＊ 反響の音がする。",
  "obj_mike_attack_controller_slash_Create_0_gml_169_0": "＊ どれがホンモノのマイク！？",
  "obj_mike_attack_controller_slash_Create_0_gml_171_0": "＊ マイク(たち)は\n　 ボリュームアップの準備をしている！",
  "obj_mike_attack_controller_slash_Create_0_gml_174_0": "＊ 渇いたジェルボールペンの\n　 ニオイがする。",
  "obj_mike_attack_controller_slash_Create_0_gml_176_0": "＊ マイクだ！",
  "obj_mike_attack_controller_slash_Create_0_gml_184_0": "＊ 効果があった！",
  "obj_mike_attack_controller_slash_Create_0_gml_185_0": "＊ まあまあ　効果があった！",
  "obj_mike_attack_controller_slash_Create_0_gml_186_0": "＊ カリカリしていて\n　 あんまりフルーツっぽくなかった！",
  "obj_mike_attack_controller_slash_Create_0_gml_188_0": "＊ オレに　さわったら\n　 指　ブッたぎるからな！",
  "obj_mike_attack_controller_slash_Create_0_gml_189_0": "＊ さわんなよ！",
  "obj_mike_attack_controller_slash_Create_0_gml_190_0": "＊ …",
  "obj_mike_attack_controller_slash_Create_0_gml_192_0": "＊ アハッ！　くすぐったいよ！",
  "obj_mike_attack_controller_slash_Create_0_gml_193_0": "＊ あはは…\n　 ボク　こんなにチヤホヤされて\n　 いいのかな？",
  "obj_mike_attack_controller_slash_Create_0_gml_194_0": "＊ …ナデナデ過剰摂取！",
  "obj_mike_attack_controller_slash_Step_0_gml_35_0": "",
  "obj_mike_attack_controller_slash_Step_0_gml_238_0": "ごっきげんよーう！",
  "obj_mike_attack_controller_slash_Step_0_gml_239_0": "モーターマウス・マイクの\nモータートークショーへ\nようこそ！\nボクが その\nモーターマウス・マイクさ～！",
  "obj_mike_attack_controller_slash_Step_0_gml_240_0": "よ～く来てくれたね～\n歓迎…\nしない！！しないよ！！\nノーノーノー！",
  "obj_mike_attack_controller_slash_Step_0_gml_241_0": "ここはプライベートな\nプライベートルーム！\nわかる！？ わかって！",
  "obj_mike_attack_controller_slash_Step_0_gml_242_0": "オンエア中だから！\n収録中だから！\nノイズはノーサンキュー！\nいますぐ帰って！",
  "obj_mike_attack_controller_slash_Step_0_gml_243_0": "…帰らないと\nこの48Vシステムが\n火を噴くぞ！",
  "obj_mike_attack_controller_slash_Step_0_gml_253_0": "そう！ そのとーり！\nボクが マイクさ～！",
  "obj_mike_attack_controller_slash_Step_0_gml_254_0": "これまで ずっと！\nこれからも ずっと！",
  "obj_mike_attack_controller_slash_Step_0_gml_255_0": "ひと呼んで\nモーターマウス・マイク！\nしゃべり出したら\n止まらない！\nアッハッハ！",
  "obj_mike_attack_controller_slash_Step_0_gml_256_0": "聞こえたね？\nよ～く聞こえたね？",
  "obj_mike_attack_controller_slash_Step_0_gml_257_0": "オフにしようと\nしたってダメダメ～",
  "obj_mike_attack_controller_slash_Step_0_gml_258_0": "いつでもオンエア！\nキミのまわりにも\nキミの中にも\nいつでも いる！\nそれが ボク！",
  "obj_mike_attack_controller_slash_Step_0_gml_259_0": "わかったら\n帰れ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_269_0": "今日もマイク！\n明日もマイク！\n昼でも夜でも\n関係なくマイク！",
  "obj_mike_attack_controller_slash_Step_0_gml_270_0": "だれより いちばん\n愛される\nテナのお気に入り！\nアッハッハ！",
  "obj_mike_attack_controller_slash_Step_0_gml_271_0": "いつでも\nテナの そばにいる！\nいる！\nいなくない！\nいる！",
  "obj_mike_attack_controller_slash_Step_0_gml_272_0": "テナのセラピー\nテナのサイコロジー\nテナのアナロジー\nテナの応急処置\nテナのじっくり処置\nぜんぶ やるよ！",
  "obj_mike_attack_controller_slash_Step_0_gml_273_0": "テナのレモネード\nテナのグレネード\n目薬も 鼻薬も ノド薬も\nぜんぶ ボクが担当！",
  "obj_mike_attack_controller_slash_Step_0_gml_274_0": "夜はベッドに 寝かせてあげて\n寝る前の おやすみ番組 流してあげて\nテナのテーマソングも歌ってあげる\nそれが ボク！",
  "obj_mike_attack_controller_slash_Step_0_gml_275_0": "そして 当然！\nテナが言ったことは\nぜーんぶ録音する！",
  "obj_mike_attack_controller_slash_Step_0_gml_276_0": "ときどき\n言ってないことまで\nぜーんぶ録音する！",
  "obj_mike_attack_controller_slash_Step_0_gml_277_0": "わかったら\n帰れ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_302_0": "…",
  "obj_mike_attack_controller_slash_Step_0_gml_312_0": "そんな ガッカリした顔しない！\nボクは マイク！\n「しゃべるの大好き」で おなじみの\nマイクだよ！",
  "obj_mike_attack_controller_slash_Step_0_gml_313_0": "いまから\nしゃべるから！\nいいね！？",
  "obj_mike_attack_controller_slash_Step_0_gml_324_0": "ちょっと 見た目が\nちがうからって\n細かいことは\n言いっこナシ！",
  "obj_mike_attack_controller_slash_Step_0_gml_325_0": "衣装を変えただけだから！\nさっきの服は\nキツキツすぎたから！",
  "obj_mike_attack_controller_slash_Step_0_gml_326_0": "くたびれたのは\nそのせいだから！\nおかげで まだ\n調子が悪いよ！",
  "obj_mike_attack_controller_slash_Step_0_gml_338_0": "よう！\nオレだ\nビッグマウス・マイクだ",
  "obj_mike_attack_controller_slash_Step_0_gml_339_0": "しゃべりだしたら\n止まらねえから\nそう呼ばれてんだ",
  "obj_mike_attack_controller_slash_Step_0_gml_340_0": "ここはプライベート\nルームだ…\n休みの日に\nのんびりすごす\nプライベートな部屋…",
  "obj_mike_attack_controller_slash_Step_0_gml_341_0": "…だから おまえも\n休みなら\nゆっくりしてけよ",
  "obj_mike_attack_controller_slash_Step_0_gml_351_0": "あー…",
  "obj_mike_attack_controller_slash_Step_0_gml_352_0": "よう！\nまだ ちょっと\n言うことがある\nオレは まだマイクだ",
  "obj_mike_attack_controller_slash_Step_0_gml_353_0": "ビッグマウス・マイク",
  "obj_mike_attack_controller_slash_Step_0_gml_364_0": "よう！\nまだ ちょっと\n言うことがある\nオレは…",
  "obj_mike_attack_controller_slash_Step_0_gml_365_0": "モダン・マイクだ\nしゃべりまくるから\n口がデカい",
  "obj_mike_attack_controller_slash_Step_0_gml_376_0": "いつもは\n役割分担する",
  "obj_mike_attack_controller_slash_Step_0_gml_377_0": "１人のマイクが\nしゃべり担当…",
  "obj_mike_attack_controller_slash_Step_0_gml_388_0": "みんな マイクは\n１人だと思ってる",
  "obj_mike_attack_controller_slash_Step_0_gml_401_0": "…",
  "obj_mike_attack_controller_slash_Step_0_gml_412_0": "このことは\n絶対ヒミツ！\nバレるわけにはいかない…",
  "obj_mike_attack_controller_slash_Step_0_gml_413_0": "マイクが 何人もいるって\n知られたら…",
  "obj_mike_attack_controller_slash_Step_0_gml_414_0": "みんなが マイクに\nなりたがる！！",
  "obj_mike_attack_controller_slash_Step_0_gml_415_0": "それは 絶対に\n阻止する！！",
  "obj_mike_attack_controller_slash_Step_0_gml_416_0": "よーし オマエたち…\n必殺こうげき いくぞ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_523_0": "…",
  "obj_mike_attack_controller_slash_Step_0_gml_530_0": "聞いた いまの！？\nサイコーでしょ！？\n話 長すぎでしょ！？",
  "obj_mike_attack_controller_slash_Step_0_gml_542_0": "…",
  "obj_mike_attack_controller_slash_Step_0_gml_549_0": "「調子が悪い」\n…と言ったんだ\n聞いてたか？",
  "obj_mike_attack_controller_slash_Step_0_gml_555_0": "(´△｀)",
  "obj_mike_attack_controller_slash_Step_0_gml_570_0": "…じゃない！\nモーターマウス・マイク！\nボクの名前は\nモーターマウス・マイクだよ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_577_0": "そうそう\nモダンマウス・マイクな",
  "obj_mike_attack_controller_slash_Step_0_gml_592_0": "モーターマウス！！\nボクの！！名前は！！\nモーターマウス！！マイク！！",
  "obj_mike_attack_controller_slash_Step_0_gml_599_0": "そう\nいま アイツが\n言ったとおりだ",
  "obj_mike_attack_controller_slash_Step_0_gml_600_0": "オレは モーター・マイク",
  "obj_mike_attack_controller_slash_Step_0_gml_607_0": "モーターマウス！！！！",
  "obj_mike_attack_controller_slash_Step_0_gml_620_0": "もう１人のマイクが\n腕力担当…",
  "obj_mike_attack_controller_slash_Step_0_gml_628_0": "…",
  "obj_mike_attack_controller_slash_Step_0_gml_634_0": "もう１人は…\n聞く担当！",
  "obj_mike_attack_controller_slash_Step_0_gml_642_0": "聞くマイクは\n絶対必要！",
  "obj_mike_attack_controller_slash_Step_0_gml_657_0": "…けど ちがう\n本当は…あー…２人",
  "obj_mike_attack_controller_slash_Step_0_gml_665_0": "３人だ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_673_0": "悪りぃ\nコイツ しゃべらねえから\nついつい 忘れちまう",
  "obj_mike_attack_controller_slash_Step_0_gml_1680_0": "ゼェ…ハァ…",
  "obj_mike_attack_controller_slash_Step_0_gml_1681_0": "ちょっと マイクは…\n休けいしてくるから…",
  "obj_mike_attack_controller_slash_Step_0_gml_1682_0": "すぐ…もどるから…",
  "obj_mike_attack_controller_slash_Step_0_gml_1692_0": "よし わかった\nもういい",
  "obj_mike_attack_controller_slash_Step_0_gml_1693_0": "調子が悪いから\n本当に 休けいする！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1704_0": "あー\nマイクは 次に\nなんて言う？",
  "obj_mike_attack_controller_slash_Step_0_gml_1716_0": "効いてねえな",
  "obj_mike_attack_controller_slash_Step_0_gml_1717_0": "なあ ボス\n通常こうげきで いいか？",
  "obj_mike_attack_controller_slash_Step_0_gml_1841_0": "…",
  "obj_mike_attack_controller_slash_Step_0_gml_1848_0": "聞こえたか！？\nマイクは！\n本当に！\n休けいする！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1861_0": "アホッ！ 聞くな！！\nおまえが マイクだろ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1868_0": "ああ そうだった",
  "obj_mike_attack_controller_slash_Step_0_gml_1869_0": "でも\nだったら なんで\n好きにしゃべったら\nダメなんだ？",
  "obj_mike_attack_controller_slash_Step_0_gml_1877_0": "もういい！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1885_0": "そう！ マイクは１人じゃない！\n１人じゃないんだ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1886_0": "知られたからには\n生きて帰すわけには\nいかないぞ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1903_0": "は？\nダメ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1904_0": "…いや　ちがう…\nこれが　ボクらの\n通常こうげきだ！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1912_0": "うし 相棒\n銃を抜け！！",
  "obj_mike_attack_controller_slash_Step_0_gml_1953_0": "なっ… 待て！\nタイム タイム！！",
  "obj_mike_minigame_controller_slash_Create_0_gml_185_0": "＊ ~1\n＊ マイクを　ナデナデしてプレイ\n＊ クリスを　ナデナデして終了",
  "obj_mike_minigame_controller_slash_Step_0_gml_38_0": "",
  "obj_readable_room1_slash_Other_10_gml_4759_0": "＊ (パスワードは　6453^1！\n　 忘れずに…！)/%",
  "obj_room_castle_tv_slash_Step_0_gml_91_0": "＊ (…暗証番号が　ちがいます！)/%",
  "obj_room_castle_tv_slash_Step_0_gml_96_0": "＊ (迷うことなく　番号を入力した)/%",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_22_0": "＊ (像だ)/%",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_37_0": "\\E4＊ …ねえ^1…ここって^1…\n　 入っていいのかな…？/",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_38_0": "\\E5＊ カギ　かかってたよね…/",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_40_0": "\\EA＊ ラルセイ　おまえ^1　\n　 マイクの正体\n　 知りたくねぇの？/",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_41_0": "\\EK＊ 名前だけは\n　 しょっちゅう\n　 聞かされたよな…/",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_43_0": "\\EM＊ んー^1…\n　 じゃあ…ちょっと　のぞく\n　 だけなら…/%",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_57_0": "\nナデナデ\nする",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_58_0": "\nしない",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_63_0": "＊ (像だ…^1　ネコ耳が　ついている)/",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_88_0": "ちょ…\nさわんな！",
  "obj_room_castle_tv_zone_1_slash_Step_0_gml_92_0": "＊ (かわりに　ラルセイとスージィを\n　 ナデナデした)\\f0/%",
  "obj_room_castle_tv_zone_2_slash_Step_0_gml_14_0": "\nナデナデ\nする",
  "obj_room_castle_tv_zone_2_slash_Step_0_gml_15_0": "\nしない",
  "obj_room_castle_tv_zone_2_slash_Step_0_gml_20_0": "＊ (とても背の高い像だ^1…\n　 ネコ耳が　ついている)/",
  "obj_room_castle_tv_zone_2_slash_Step_0_gml_35_0": "＊ (…なんと^1　手が届かない！)/%",
  "obj_room_castle_tv_zone_2_slash_Step_0_gml_45_0": "ヨシヨシ…？",
  "obj_room_castle_tv_zone_2_slash_Step_0_gml_49_0": "＊ (かわりに　ラルセイとスージィを\n　 ナデナデした)\\f0/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_21_0": "＊ (とても背の高い像だ^1…\n　 ネコ耳が　ついている)/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_34_0": "＊ (マウスは　この像が\n　 怖くてしかたがないようだ…)/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_48_0": "\nナデナデ\nする",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_49_0": "\nしない",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_54_0": "＊ (像だ…^1　ネコ耳が　ついている)/",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_149_0": "＊ (マウスを　ネコ像から救った^1…\n　 このマウスにとっての\n　 ヒーローになった)/",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_150_0": "＊ (ヒーローを　あがめる気持ちが\n　 マウスを変身させた…！！)/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_197_0": "＊ (~1と~2で　マウスを\n　 使えるようだ！)/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_202_0": "＊ (マウスで　マウスを\n　 使えるようだ…！)/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_324_0": "＊ (マウスを　ネコ像から救った^1…\n　 このマウスにとっての\n　 ヒーローになった)/",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_325_0": "＊ (ヒーローを　あがめる気持ちが\n　 マウスを変身させた…！！)/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_387_0": "\\EJ＊ (クリス^1　~1と~2で\n　 マウスを　使える\n　 みたいだよ！)/%",
  "obj_room_castle_tv_zone_3_slash_Step_0_gml_392_0": "\\EJ＊ (クリス^1　マウスで\n　 マウスを　使える\n　 みたいだよ…！)/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_148_0": "読んだ\n「マイク」\nって…",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_149_0": "読んでないけど\n「マイク」\nって…",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_154_0": "＊ おい^1！　なんで　入ってきてる！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_155_0": "＊ ドアのサイン^1\n　 読まなかったのか！？\n　 なんて書いてあった！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_186_0": "＊ じゃあ　なんで入ってきた！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_190_0": "＊ 読んでないのに\n　 なんで知ってる！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_199_0": "\nはい\nマイクです",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_200_0": "\nあなたが\nマイクです",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_204_0": "＊ 自分が　マイクだとでも\n　 思ってるのか！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_229_0": "＊ ちがーう！　ちがう^1！\n　 わかってない！　キミは　なんにも\n　 わかってない！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_230_0": "＊ おしゃべりな　ルームノイズめ^1！\n　 エアチェック　エアチェック！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_236_0": "＊ …じゃなくて^1…マイクチェック！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_241_0": "＊ …マーッヒャッヒャッヒャッイク！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_242_0": "＊ バレてしまったら　しかたがない！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_248_0": "＊ ミャァース^1！　マイクニコバーン！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_257_0": "＊ ホンモノのマイクは　ただ１人…/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_275_0": "＊ この　ボクだぁ！！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_510_0": "＊ …^1　\n　 …すまない^1…白状する^1…\n　 見てのとおりだよ…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_511_0": "＊ テナの要求に　１人で\n　 応えつづけるのは\n　 ムリだったんだ…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_512_0": "＊ …だから^1…もっと…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_513_0": "＊ …マイクが　必要だったんだ^1！\n　 そうこうしているうちに　自分が\n　 だれなのか　わからなくなって…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_514_0": "＊ でも！　キミたちのおかげで\n　 思い出せた！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_515_0": "＊ ボクこそが　唯一無二のマイク^1…\n　 ホンモノさ！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_516_0": "＊ この２人は…/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_550_0": "＊ ニセものだ^1！　やっつけろ！！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_551_0": "＊ アホなこと　ばっかり\n　 やらかした罰だ！！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_599_0": "＊ …/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_600_0": "＊ …しゃーない…全部白状しますわ^1…\n　 ワテら３人　みんな\n　 マイク　ちゃいますねん。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_601_0": "＊ ワテらは　ただ…「マイクの部屋」の\n　 管理を　しとっただけです^1。\n　 勝手に。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_602_0": "＊ テナはん^1　いっつも　マイクに\n　 話しかけますやろ…？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_603_0": "＊ そんでもって　ときどき^1…\n　 マイクに「会う」ために^1　\n　 この部屋に来はるんです。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_604_0": "＊ 「TVワールド」が　できてから\n　 ずっと　そんな感じで…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_605_0": "＊ でも^1　部屋にマイクが　おらんと\n　 テナはん　機嫌　悪ぅなって^1…\n　 ワテらに　当たり散らかしますねん。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_606_0": "＊ ほんでも…/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_630_0": "＊ ここに　マイクなんて　おらん！^1！\n　 最初っから！^1　一度も^1！\n　 おったことなんて　ありまへん！！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_631_0": "＊ せやから　テナはんが\n　 ご機嫌　損ねんように…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_632_0": "＊ ワテらで　順番に\n　 マイクのふりを　始めたんですわ。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_633_0": "＊ そしたら　おかしなことに^1…\n　 それが　うまいこと\n　 いきましてな！！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_634_0": "＊ ここに　１人　マイク役が　おれば^1　\n　 テナはんは　そいつが　マイクだと\n　 信じはるんですわ！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_635_0": "＊ アンタは　テナはんに　チクるかも\n　 しれへんから^1　この部屋に\n　 入れんように　しとりましたが…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_636_0": "＊ …こうなったらもう^1　\n　 手おくれですわな^1。\n　 ワテらのヒミツ　バレてもうた…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_637_0": "＊ …テナはんに　チクる前に^1　\n　 １つ　教えてくんなはれ。/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_688_0": "＊ マイクって　だれですのん！^1？\n　 ホンマに　だれやねん！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_689_0": "＊ ワテら　だーれも^1！　だれひとり^1！\n　 マイクを　見たことありまへん！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_690_0": "＊ テナはんが　マイクに\n　 なにか　やれと\n　 言いつけるときは…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_691_0": "＊ テナはんが　自分で　やるか^1　\n　 ワテらが　こっそり　やるか…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_692_0": "＊ …なんや知らんけど　自然と\n　 そうなるか　なんですわ！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_693_0": "＊ じゃあ　マイクって　だれやねん！？\n　 テナはんの　イマジナリーフレンド\n　 ってヤツでっか！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_694_0": "＊ それか　「もう１人のテナはん」\n　 とかでっか？　別の人格　みたいな\n　 ことでっか！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_695_0": "＊ ほんでもって　マイクは　なんで\n　 あんなに^1　テナはんに　好かれて\n　 チヤホヤされてますのん！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_696_0": "＊ お天気コンビが　テナはんの\n　 「右ウデ」なら^1　マイクは\n　 なんですの！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_698_0": "＊ なあ…^1　オレが思うに^1…\n　 マイクって　「オレたち」\n　 なんじゃねえの？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_700_0": "＊ へ？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_702_0": "＊ オレら　ずっと^1　\n　 マイクが　なんかやってる\n　 フリしてきただろ？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_703_0": "＊ だから^1　マイクのフリしてる\n　 あいだは^1　オレらが　ホントに\n　 マイクなんじゃねえの？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_705_0": "＊ なんやて？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_706_0": "＊ ワテらが　ずっと\n　 マイクやった！？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_707_0": "＊ そんじゃあ　そもそも\n　 「マイク」っちゅう考え自体\n　 どっから　わいて出たんや？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_709_0": "＊ さあ？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_711_0": "＊ なんや　イミが　わかりまへんわ！！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_712_0": "＊ アンタらは？　ちゃいますの！？\n　 この部屋　入ってきたってことは…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_713_0": "＊ アンタらが　マイクちゃいますの！^1？\n　 なあ！！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_714_0": "＊ そうなんちゃいますの！？\n　 答えてーな！！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_807_0": "＊ あー　もうええわ^1！\n　 だれかが　マイクやっとるかぎり\n　 うまいこといきますねん！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_812_0": "＊ あー　もうええわ^1！\n　 現実　見まひょ。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_813_0": "＊ とっとと　テナはんに\n　 チクりにいったらどーでっか？/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_817_0": "\\ED＊ テナは…その^1…\n　 この　闇の世界には\n　 いねえんだ。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_821_0": "\\E0＊ テナは　べつのヤツに\n　 あげたから　この\n　 闇の世界には　いねえよ。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_824_0": "＊ はぁ…！^1？\n　 …て^1…ことは…/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_846_0": "＊ 好きなだけ　マイクのフリ\n　 してられるってことかよ！？/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_865_0": "＊ なんでやねん！^1　ワテら\n　 好きこのんで　マイクのフリしてた\n　 ワケちゃいますやろ！！/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_866_0": "＊ とっとと　帰りまひょ！\n　 グズグズしとると　なんやヘンなこと\n　 起きるかもしれへんで！/%",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_945_0": "\\EM＊ ボクたちも^1…\n　 ここには　もう\n　 用は　ないね。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_947_0": "\\EP＊ …ああ。/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_149_0": "＊ …マーッヒャッヒャッヒャッイク！\n　 ボクが　ホンモノのマイクさ！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_162_0": "＊ よう　ボス^3。\n　 オレが　いちばんハイスコアだ。/",
  "scr_roomname_slash_scr_roomname_gml_29_0": "マイクゾーン",
  "scr_text_slash_scr_text_gml_11502_0": "\n番号を\n入力する",
  "scr_text_slash_scr_text_gml_11503_0": "\nしない",
  "scr_text_slash_scr_text_gml_11508_0": "＊ 「マイクの部屋」/",
  "scr_text_slash_scr_text_gml_11509_0": "＊ 暗証番号を入力しないと\n　 カギが　開かないようだ。/",
  "scr_text_slash_scr_text_gml_11510_0": "＊ 入力する？/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_134_0": "\nなに\nしてんの？",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_135_0": "\nなんでもない",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_136_0": "あそびかた",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_137_0": "だれがマイク？",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_151_0": "＊ この部屋から出て　わずか数分^1で\n　 ボクたちは　気づいた^1。\n　 …耐えられない！^1　と！！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_152_0": "＊ マイクがいないなんて　許されない！\n　 マイクが何人もいるのも\n　 許されない！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_153_0": "＊ ボクたちのうちの　だれが\n　 ホンモノの　マイクなのか^1　\n　 たしかめるべきだ！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_154_0": "＊ …で^1　キミの出番というわけだ。/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_155_0": "＊ 最強のモノこそが　ホンモノ^1！\n　 そうだろう！？/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_156_0": "＊ ボクたちが　それぞれ^1　\n　 キミの相手になる^1！\n　 …ミニゲームで！！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_157_0": "＊ キミが勝負して　いちばん高い\n　 スコアを出せた相手が^1 \n　 ホンモノのマイクだ！/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_160_0": "＊ テナはいつも　言っていた。\n　 「あのクソ野郎が　いなくなって\n　 マイクの様子がおかしくなった」と。/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_161_0": "＊ 「あのクソ野郎」って　だれ！^2？\n　 「おかしくなった」って　何！？/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_164_0": "＊ マウスでボクらを　つまみあげて\n　 真ん中に　ドロップすれば\n　 プレイできる！　ゲームは…/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_165_0": "＊ スモール・マイク - プルーイ \n　 ネコをバスケットに　IN！\n　 雨には　ドントタッチ！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_166_0": "＊ カウボーイハット・マイク\n　 - エアウェーブ\n　 毛玉をブロックしつづけろ！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_167_0": "＊ キャット・マイク - オドリテ\n　 タイミングよくポーズを合わせろ！\n　 クリックでウデが伸びるぞ！/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_187_0": "＊ さあ！？　いまのところ同点だ！\n　 いまのうちに　ハイスコアを\n　 ゲットしろ！/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_193_0": " テナのアンテナをマッサージできる",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_194_0": " テナのショックセラピーを\n　 受けられる",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_195_0": " テナのタンスに\n　 「Goodnight Biiby」を歌える",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_196_0": " テナの鼻収納ボックスを\n　 整理整とんできる",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_206_0": "＊ ハハッ！^1　ボクだ^1！\n　 スモール・マイクがホンモノだ^1！\n　 やったぞ！！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_207_0": "＊ これで　思う存分\n　~1…/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_208_0": "＊ …って　なんでやねん^1！\n　 だれか　他のヤツに\n　 勝たせろ！/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_212_0": "＊ は！？　カウボーイハット・マイクが\n　 いちばんハイスコア！？/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_213_0": "＊ これじゃ　みんな^1　マイクは\n　 カウボーイだと思うじゃないか^1！\n　 なにしてくれてんの！？/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_214_0": "＊ このままじゃ　すまさないからな^1！\n　 ボクにはコネがある！^1！\n　 関係者に知り合いがいる！！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_215_0": "＊ …となりにいる\n　 カウボーイ野郎のことだけど。/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_219_0": "＊ なっ…！　キャット・マイクが\n　 いちばんハイスコア！？/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_220_0": "＊ これじゃ　みんな^1　マイクは\n　 ネコだと思うじゃないか^1！\n　 なにしてくれてんの！？/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_221_0": "＊ オマエたちは　みんなそうだ^1！\n　 ピンクと黄色を見たとたん^1\n　 「FRIENDだ！！」…って！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_222_0": "＊ 「FRIEND」って言ってても^1\n　 味方とはかぎらない！^1　するどい歯で\n　 かみついてきたりするんだぞ！/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_263_0": "＊ オレがホンモノってことは^1…\n　 これからは　オレ^1　好きなこと\n　 しゃべっていいのか？/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_265_0": "＊ よう　ボス^3。ちっこいヤツらに\n　 話しかけてくれ。オレは　何が\n　 どうなってんだか　サッパリだ。/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_295_0": "＊ (最高スコア保持者だから^1\n　 たぶん…^1　ホンモノのマイク？)/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_297_0": "＊ (おどっている)/%",
  "obj_mike_minigame_tv_slash_Create_0_gml_10_0": "マウスを使って\nマイクを\nスロットにIN！",
  "obj_mike_minigame_tv_slash_Create_0_gml_16_0": "ネコをバスケットにIN！\n雨には　ドントタッチ！\nネコＸ２ = ボーナス！",
  "obj_mike_minigame_tv_slash_Create_0_gml_17_0": "毛玉をブロック\nしつづけろ！",
  "obj_mike_minigame_tv_slash_Create_0_gml_18_0": "タイミングよくポーズを\n合わせろ！クリック＆\n長押しでウデが伸びるぞ！",
  "obj_mike_minigame_tv_slash_Create_0_gml_22_0": "プルーイ",
  "obj_mike_minigame_tv_slash_Create_0_gml_23_0": "エアウェーブ",
  "obj_mike_minigame_tv_slash_Create_0_gml_24_0": "オドリテ",
  "obj_mike_minigame_tv_slash_Create_0_gml_28_0": "マウスでバタットをよけて\nネコCATCH！VOL&SPEEDで\n青ネコ！マージでレアネコ！\n操作：マウス＆VOL",
  "obj_mike_minigame_tv_slash_Create_0_gml_29_0": "ネコを放り投げてリングへIN！\nVOLにて重力をあやつり給へ！\n同時に複数のネコをINしてコンボ！\n操作：マウス＆VOL",
  "obj_mike_minigame_tv_slash_Create_0_gml_30_0": "シュ～ズでHEY！スプリント！\n降ってくるニャンコのうち\n選ばれし者を箱舟へ導け！\n操作：マウスのみ",
  "obj_mike_minigame_tv_slash_Create_0_gml_33_0": "バタット",
  "obj_mike_minigame_tv_slash_Create_0_gml_34_0": "ジョングラー",
  "obj_mike_minigame_tv_slash_Create_0_gml_35_0": "プルーイ",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_173_0": "＊ スモール・マイク - 「バタット」\n　 マウスで危険なバタットをよけろ。\n　 VOLでスピードアップ！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_174_0": "＊ カウボーイハット・マイク\n　 - 「ジョングラー」\n　 VOLとマウスで　リングへIN！/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_175_0": "＊ キャット・マイク - 「プルーイ」\n　 雨にはドントタッチ！　クリック＆\n　 長押しでネコをバスケットへIN！/%",
  "scr_spelltext_slash_scr_spelltext_gml_383_0": "%%",
  "obj_mike_controller_slash_Draw_0_gml_73_0": "SCORE: ",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_207_0": "\nはい\nマイクです",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_523_0": "＊ でも　キミのおかげで\n　 思い出せた。/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_728_0": "＊ アンタは？　ちゃいますの！？\n　 この部屋　入ってきたってことは…/",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_729_0": "＊ アンタが　マイクちゃいますの！^1？\n　 なあ！！/",
  "obj_mike_controller_slash_Draw_0_gml_75_0_b": "HISCORE: ",
  "obj_mike_controller_slash_Draw_0_gml_78_0": "CATS: ",
  "obj_mike_controller_slash_Draw_0_gml_93_0": "TIME'S UP!",
  "obj_gold_cat_slash_Collision_obj_blue_cat_gml_18_0": "LEVEL ",
  "obj_miccheck_slash_Other_10_gml_58_0": "＊ (マイクロフォンの形をした\n　 ナゾめいた　クリスタルがある)/",
  "obj_miccheck_slash_Other_10_gml_59_0": "＊ (~1の形をしたボタンと^1　\n　 「VOL」という文字が\n　 彫り込まれている)/",
  "obj_miccheck_slash_Other_10_gml_60_0": "＊ (押すと^1　部屋全体に\n　 音が鳴り響くようだ…！)/%",
  "obj_mike_controller_slash_Draw_0_gml_79_0": "CATS: ",
  "obj_mike_controller_slash_Draw_0_gml_84_0": "生まれたー",
  "obj_mike_controller_slash_Draw_0_gml_104_0": "ENERGY",
  "obj_mike_controller_slash_Draw_0_gml_135_0": "COMBO: ",
  "obj_mike_controller_slash_Draw_0_gml_141_0": "TIME'S UP!",
  "obj_mike_controller_slash_Draw_0_gml_143_0": "TIME",
  "obj_mike_minigame_controller_slash_Draw_0_gml_28_0": "* NEW HISCORE! *",
  "obj_mike_minigame_controller_slash_Draw_0_gml_54_0": "MUSIC: ",
  "obj_mike_minigame_controller_slash_Draw_0_gml_70_0": "ON",
  "obj_mike_minigame_controller_slash_Draw_0_gml_87_0": "OFF",
  "obj_mike_minigame_controller_slash_Draw_0_gml_120_0": "RETRY",
  "obj_mike_minigame_controller_slash_Draw_0_gml_137_0": "END",
  "scr_roomname_slash_scr_roomname_gml_30_0": "キャッスルタウン - TVハウス",
  "obj_mike_minigame_controller_slash_Create_0_gml_246_0": "DANGER! プルーイレベル上昇！",
  "obj_minigame_score_slash_Draw_0_gml_4_0": "COMBO",
  "obj_room_castle_tv_zone_battle_slash_Step_0_gml_1115_0": "＊ (この手のものを見るのは\n　 正直　好きじゃない)/%",
  "obj_mike_minigame_controller_slash_Draw_0_gml_109_0": "VOL反転： ",
  "obj_mike_minigame_controller_slash_Draw_0_gml_127_0": "ON",
  "obj_mike_minigame_controller_slash_Draw_0_gml_143_0": "OFF",
  "obj_mike_minigame_tv_slash_Create_0_gml_9_0": "マウスに話しかけて いろんな\nマイク・ミニゲームをプレイ！",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_176_0": "＊ 真ん中のマウスに話しかければ\n　 プレイできる！　ゲームは…/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_342_0": "\nバタット",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_343_0": "\nプルーイ",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_344_0": "ジョングラー",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_345_0": "しない",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_347_0": "＊ (マウスは　いつでもプレイOKだ！)/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_348_0": "＊ (マイク・ミニゲームを\n　 プレイする？)/",
  "obj_micmenu_slash_Draw_0_gml_141_0": "マウス右クリック [非推奨]",
  "obj_miccheck_slash_Other_10_gml_67_0": "＊ (クリスタルが激しく振動している。\n　 ~1か~2に割り振られたアクションを\n　 別のボタンに設定しよう！)/%",
  "obj_room_castle_tv_zone_minigame_slash_Draw_0_gml_4_0": "リセットされた。",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_416_0": "爆破して\nスコアを\nリセット",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_417_0": "\n爆破しない",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_421_0": "＊ (ダイナマイクだ)/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_422_0": "＊ (爆破すると　すべての　マイクの\n　 ハイスコアが　0に　もどる)/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_436_0": "＊ (ダイナマイクの　誘惑に　勝った)/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_446_0": "\nいいから\nやって",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_447_0": "\nやらないで",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_451_0": "＊ (本当に　いいのだろうか)/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_452_0": "＊ (ダイナマイクを　使うと\n　 本当に　ハイスコアが\n　 0になる…！)/",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_466_0": "＊ (ダイナマイクの　誘惑に　勝った)/%",
  "obj_room_castle_tv_zone_minigame_slash_Step_0_gml_474_0": "＊ (ばくだんに\n　 「ダ　イ　ナ　マ　イ　ク」と\n　 入力した！)/%",
  "obj_titan_spawn_enemy_slash_Step_0_gml_143_0": "＊ 空気が　張りつめる…\n＊ (「\\cYバニッシュ\\c0」を　使えるようになった！)",
  "obj_micmenu_slash_Draw_0_gml_172_0": "~1 [こちらも非推奨]"
