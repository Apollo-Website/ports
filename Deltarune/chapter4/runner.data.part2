                if (ccc != " " && ccc != "　" && ccc != ">" && ccc != "<")
                    found = true;
            }
            until (found);
        }
        else if (dy != 0 && YMAX > 0)
        {
            var found = false;
            
            do
            {
                CURY = (CURY + (YMAX + 1) + dy) % (YMAX + 1);
                var move = true;
                var ccc = "";
                
                while (move)
                {
                    ccc = NAME[CURX][CURY];
                    
                    if (ccc == ">")
                        CURX += 1;
                    else if (ccc == "<")
                        CURX -= 1;
                    else
                        move = false;
                }
                
                if (ccc != " " && ccc != "　")
                    found = true;
            }
