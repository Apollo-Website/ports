                global.mercymod[myself] = 0;
            }
            else if (pacifycon == 1)
            {
                scr_spareanim();
                scr_recruit();
                scr_monsterdefeat();
                instance_destroy();
                scr_mnendturn();
                
                with (obj_darkener)
                    darken = 0;
            }
            else
            {
                with (obj_darkener)
                    darken = 0;
                
                scr_mnendturn();
            }
        }
    }
    
    if (global.mnfight == 8)
        exit;
