            star[starcount].sprite_index = particlesprite;
            star[starcount].image_blend = particlecolor;
            starcount += 1;
        }
    }
    
    if (t >= 5 && t <= 30)
    {
        for (i = 0; i < starcount; i += 1)
        {
            with (star[i])
            {
                image_angle -= 10;
                image_alpha -= 0.1;
                
                if (image_alpha <= 0)
                    instance_destroy();
            }
        }
        
        if (t >= 30)
            instance_destroy();
    }
}
else
{
    for (i = 0; i < starcount; i += 1)
    {
        with (star[i])
            instance_destroy();
    }
    
    instance_destroy();
}
