  "scr_text_slash_scr_text_gml_2692_0": "＊ ほうら　ごらんよ^1　面会だ^1。&　 そこに　立ってる３人は…/",
  "scr_text_slash_scr_text_gml_2693_0": "＊ 誰だろナ^1？　誰だろネ？/",
  "scr_text_slash_scr_text_gml_2695_0": "＊ はじめまして^1！　ボクは&　 ラルセイといいます^1。&　 こっちは　クリスと…/",
  "scr_text_slash_scr_text_gml_2697_0": "＊ おい^1　おまえ&　 なんで　こんなとこに&　 入ってんだ？/",
  "scr_text_slash_scr_text_gml_2699_0": "\\TJ＊ 無実だヨ^1？　無実だネ^1…&＊ ボクは　ゲームがしたかった^1。&　 それだけサ^1…　それだけダ…/",
  "scr_text_slash_scr_text_gml_2700_0": "＊ ゲームは　とっても楽しいの^1。でも&　 王様たち^1　とても　つまらない^1。&　 「けしからん」と　怒ったの。/",
  "scr_text_slash_scr_text_gml_2701_0": "＊ それは　望みでした　王たちの^1。　&　 ワタシの体を　罰とし^1て&　 閉じ込める^1。このオリに。/",
  "scr_text_slash_scr_text_gml_2702_0": "＊ ワシは　足が速いぞよ^1？&　 頭もキレる^1。頭が回る。/",
  "scr_text_slash_scr_text_gml_2703_0": "＊ 追いかけっこは　ボクの勝ち^1。&　 王たちが捕えたのは　自分の民。/",
  "scr_text_slash_scr_text_gml_2704_0": "＊ 世界のぐるりを囲むよ^1に&　 大きな　ろう屋を　こしらえた^1。&　 自由の身なのは　私だけ。/",
  "scr_text_slash_scr_text_gml_2706_0": "＊ 自由^1…って…　でも&　 あなたは　どう見ても&　 オリの中ですよね…/",
  "scr_text_slash_scr_text_gml_2708_0": "\\TJ＊ こちら側より　物見れ^1ば&　 そうは見えぬぞ^1　ライトナー！/",
  "scr_text_slash_scr_text_gml_2710_0": "＊ じゃ^1　オレらの助けも&　 いらなそうだな。/",
  "scr_text_slash_scr_text_gml_2712_0": "\\TJ＊ ノン　です　それは^1。&＊ さみしくなります　どんどん　私。&　 この　ささやかな　自由の中で。/",
  "scr_text_slash_scr_text_gml_2713_0": "＊ 遊ぼうヨ^1？　遊ぼうネ^1？&　 ボクと　ゲームをして遊ぼう？/",
  "scr_text_slash_scr_text_gml_2714_0": "＊ 真の自由は　いかなるものか&　 われが　とくと教えてやろう！/",
  "scr_text_slash_scr_text_gml_1758_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_2719_0": "＊ カギを　見つけろ　見つけれ^1ば&　 自由にしてやる　おまえたち。/",
  "scr_text_slash_scr_text_gml_2720_0": "＊ カギは　隠されていましょうね。&　 その目からは^1。年老いた店主が&　 知っています^1。ヒミツ。カギの。/%",
  "scr_text_slash_scr_text_gml_2725_0": "#ゲームを#する",
  "scr_text_slash_scr_text_gml_2726_0": "#ゲームを#しない",
  "scr_text_slash_scr_text_gml_2732_0": "＊ カギを　見つけろ　見つけれ^1ば&　 自由にしてやる　おまえたち。/",
  "scr_text_slash_scr_text_gml_2733_0": "＊ カギは　隠されていましょうね。&　 その目からは^1。年老いた店主が&　 知っています^1。ヒミツ。カギの。/%",
  "scr_text_slash_scr_text_gml_2738_0": "＊ ウェーン　ヒッヒッ^1　ウェンヒッヒ…/",
  "scr_text_slash_scr_text_gml_2739_0": "＊ どうやって　拒否しましょうね^1。&　 もう　しています　ゲーム。&　 あなたたち。/%",
  "scr_text_slash_scr_text_gml_2745_0": "#カギを使う",
  "scr_text_slash_scr_text_gml_2746_0": "#使わない",
  "scr_text_slash_scr_text_gml_2749_0": "＊ ウェーン　ヒッヒッ^1　ウェンヒッヒ^1…&　 カギですヨ？^1　カギですネ？/",
  "scr_text_slash_scr_text_gml_2750_0": "＊ 解き放て！^1　解き放つ^1！&　 マアァベラスな　おたのしミ！/",
  "scr_text_slash_scr_text_gml_2751_0": "＊ さあ　あけるのです　とびら^1。&　 するのです　みずからを　解放。/",
  "scr_text_slash_scr_text_gml_2444_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_2766_0": "＊ (とびらのカギを&　 とびらの前に　おいた)/%",
  "scr_text_slash_scr_text_gml_2771_0": "＊ なくなりました　選択肢^1！&　 ここまで来といて　それはナシ！/%",
  "scr_text_slash_scr_text_gml_2777_0": "＊ DO NOT TARRY!/%",
  "scr_text_slash_scr_text_gml_2780_0": " #Blaze",
  "scr_text_slash_scr_text_gml_2781_0": " #Do Not Blaze",
  "scr_text_slash_scr_text_gml_2784_0": " #Do Not Blaze",
  "scr_text_slash_scr_text_gml_3143_0": "＊ それ^1　ワタシのケーキですネ^1？&＊ 修理したのですネ^1？&＊ 返してくれますネ！？/",
  "scr_text_slash_scr_text_gml_2790_0": " #とにかく#謝る",
  "scr_text_slash_scr_text_gml_2791_0": " #おどす",
  "scr_text_slash_scr_text_gml_2794_0": "＊ あっ^1！ おまえ…&　 さっきオレに　乱暴したヤツらだな！/",
  "scr_text_slash_scr_text_gml_2786_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_2807_0": "＊ さっきは　ごめんなさい。&　 ボクたちが間違ってました。/",
  "scr_text_slash_scr_text_gml_2808_0": "\\E8＊ もう二度としません。&　 約束します！/",
  "scr_text_slash_scr_text_gml_2810_0": "＊ え…^1？　あ…謝るのかよ^1？&　 じゃあ…　オレも許すよ…/",
  "scr_text_slash_scr_text_gml_2811_0": "＊ (モンディ１体に乱暴した罪が&　 許された！)/%",
  "scr_text_slash_scr_text_gml_2823_0": "＊ ずいぶん　でけえ口きいて&　 くれるじゃねえか…/",
  "scr_text_slash_scr_text_gml_2824_0": "\\E3＊ さっさと許さねえと&　 顔面　ヘコますぞ！/",
  "scr_text_slash_scr_text_gml_2826_0": "＊ ご…ごごごごめんなさいッ^1！&　 許します許します！^1　はい…これ！&　 チョコダイヤです…お納めください…/",
  "scr_text_slash_scr_text_gml_2827_0": "＊ (チョコダイヤを　手に入れた)/%",
  "scr_text_slash_scr_text_gml_2832_0": "＊ せっかくですけど^1…&　 持ち物が&　 いっぱいなんです。/",
  "scr_text_slash_scr_text_gml_2834_0": "＊ 安心しろ^1。&　 オレが　もう食ったぜ。/%",
  "scr_text_slash_scr_text_gml_2841_0": " #聴く",
  "scr_text_slash_scr_text_gml_2842_0": " #聴かない",
  "scr_text_slash_scr_text_gml_2845_0": "＊ (音楽プレイヤーだ^1)&＊ (聴く？)/",
  "scr_text_slash_scr_text_gml_1775_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_926_0": "＊ (…)/",
  "scr_text_slash_scr_text_gml_2854_0": "＊ (アニメで使われている&　 「ペチャッ」という効果音が&　 次々と再生される)/%",
  "scr_text_slash_scr_text_gml_2858_0": "＊ (聴くのは　やめておいた)/%",
  "scr_text_slash_scr_text_gml_2863_0": " #ろう屋 B1",
  "scr_text_slash_scr_text_gml_2864_0": " #地上 1F",
  "scr_text_slash_scr_text_gml_2865_0": "？？？？",
  "scr_text_slash_scr_text_gml_2867_0": "＊ (どの階へ行く？)/",
  "scr_text_slash_scr_text_gml_2868_0": "\\C3",
  "scr_text_slash_scr_text_gml_2893_0": "＊ (もう　そこにいる)/%",
  "scr_text_slash_scr_text_gml_2909_0": "＊ (もう　そこにいる)/%",
  "scr_text_slash_scr_text_gml_2925_0": "＊ (もう　そこにいる)/%",
  "scr_text_slash_scr_text_gml_2934_0": " #移動する",
  "scr_text_slash_scr_text_gml_2659_0": " #ねむらない",
  "scr_text_slash_scr_text_gml_2938_0": "＊ (エレベーターで移動する？)/",
  "scr_text_slash_scr_text_gml_691_0": " #よむ",
  "scr_text_slash_scr_text_gml_740_0": " #つっこまない",
  "scr_text_slash_scr_text_gml_2973_0": "\\E0＊ なあ　クリス。/",
  "scr_text_slash_scr_text_gml_2974_0": "\\E0＊ ちょ…^1　ちょっと待てよ。/",
  "scr_text_slash_scr_text_gml_2975_0": "\\E3＊ えーーーーっと^1　だな…/",
  "scr_text_slash_scr_text_gml_2976_0": "\\E1＊ おまえさ。/",
  "scr_text_slash_scr_text_gml_2977_0": "\\E2＊ 帰る前に^1　みんなに&　 別れのあいさつ&　 してーんだろ？/",
  "scr_text_slash_scr_text_gml_2978_0": "\\E3＊ いや^1　オレは　べつに&　 すぐにでも&　 帰りてーんだけどさ…/",
  "scr_text_slash_scr_text_gml_2979_0": "\\E2＊ おまえが　あいさつ&　 してーなら^1　ちょっと&　 引き返したっていいんだぜ？/",
  "scr_text_slash_scr_text_gml_2980_0": "\\C2",
  "scr_text_slash_scr_text_gml_2986_0": "\\E2＊ っしゃ^1　じゃあ決まりだ。/",
  "scr_text_slash_scr_text_gml_2987_0": "\\E9＊ もどろうぜ！/%",
  "scr_text_slash_scr_text_gml_2991_0": "\\E4＊ いやいや　ムリすんなって！/",
  "scr_text_slash_scr_text_gml_2992_0": "\\E9＊ せめてランサーには&　 あいさつしてから&　 帰ろうぜ！/%",
  "scr_text_slash_scr_text_gml_2998_0": " #たたかおう",
  "scr_text_slash_scr_text_gml_2999_0": " #やめよう",
  "scr_text_slash_scr_text_gml_3002_0": "＊ おまえらがオレを倒せた^1ら&　 また「正義の味方」に&　 もどってやるよ。/",
  "scr_text_slash_scr_text_gml_3003_0": "\\E0＊ ただし^1　うちらが&　 勝ったら…/",
  "scr_text_slash_scr_text_gml_3004_0": "\\E2＊ おまえらには　うちらと&　 いっしょに　悪モノを&　 やってもらう。/",
  "scr_text_slash_scr_text_gml_3005_0": "\\E4＊ …そんで&　 うちらの命令　なんでも&　 聞いてもらう。/",
  "scr_text_slash_scr_text_gml_3007_0": "＊ ホッホッホ^1！　そうだ！&　 ボクさまたちの&　 仰せのままにな！/",
  "scr_text_slash_scr_text_gml_3010_0": "\\E1＊ どうだ^1？　やるか？/",
  "scr_text_slash_scr_text_gml_2939_0": "\\C2",
  "scr_text_slash_scr_text_gml_3015_0": "＊ いい^1。答えるな。/",
  "scr_text_slash_scr_text_gml_3016_0": "\\E2＊ どっちにしろ&　 おまえらを　ボコることに&　 変わりは　ねーからな…/",
  "scr_text_slash_scr_text_gml_3017_0": "\\E3＊ …いくぜ！/%",
  "scr_text_slash_scr_text_gml_3022_0": " #じぶんのこと",
  "scr_text_slash_scr_text_gml_3023_0": " #アズリエル#のこと",
  "scr_text_slash_scr_text_gml_3024_0": "パイのこと",
  "scr_text_slash_scr_text_gml_3025_0": "はなたば",
  "scr_text_slash_scr_text_gml_3026_0": "なんでもない",
  "scr_text_slash_scr_text_gml_3027_0": "＊ なあに　クリス？/",
  "scr_text_slash_scr_text_gml_3028_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_1560_0": "\\E0＊ クリスも　すっかり&　 おおきくなっちゃって…/",
  "scr_text_slash_scr_text_gml_1561_0": "\\E9＊ あなたも　じきに&　 だいがくへ&　 いってしまうのね…/",
  "scr_text_slash_scr_text_gml_2511_0": "\\E1＊ …/",
  "scr_text_slash_scr_text_gml_1563_0": "\\E9＊ おぼえているかしら？&　 クリスが　まだ&　 ちいさかったころ…/",
  "scr_text_slash_scr_text_gml_1564_0": "\\E8＊ 「いつになったら&　 ツノが　はえてくるの？」&　 って　きくものだから…/",
  "scr_text_slash_scr_text_gml_1565_0": "\\E0＊ あかいツノがついた&　 カチューシャを&　 かってあげたでしょう？/",
  "scr_text_slash_scr_text_gml_1566_0": "\\E4＊ クリスったら　なんかげつも&　 まいにち　つけて^1！　あれは&　 どこへ　いったかしらねえ？/%",
  "scr_text_slash_scr_text_gml_3044_0": "\\E9＊ クリスと　アズリエルが&　 よくあそんでいた　テレビ&　 ゲームが　あったわねえ。/",
  "scr_text_slash_scr_text_gml_3045_0": "\\E1＊ なんだったかしら^1…&　 「だいらんとう　スマッシュ&　 ファイターズ」？/",
  "scr_text_slash_scr_text_gml_3046_0": "\\E0＊ ちっちゃかったこ^1ろ&　 アズリエルは　あのみどりの&　 トカゲが　おきにいりで…/",
  "scr_text_slash_scr_text_gml_3047_0": "\\E9＊ おたんじょうびパーティの&　 かざりつけも　ぜんぶ&　 みどりのトカゲにしてね…/",
  "scr_text_slash_scr_text_gml_3048_0": "\\E0＊ パパが　タマゴに&　 えのぐで　みどりの&　 みずたまを　かいて…/",
  "scr_text_slash_scr_text_gml_3049_0": "\\E9＊ おにいちゃんの&　 よろこんだこと…！/",
  "scr_text_slash_scr_text_gml_3050_0": "\\E5＊ でも^1　つぎのあさ&　 パパが　ぜーんぶ　わって&　 オムレツにしちゃって。/",
  "scr_text_slash_scr_text_gml_3051_0": "\\E8＊ アズリエルは　おおなき^1。&　 うちにあった　あの　ほんも&　 きらいに　なっちゃって…/",
  "scr_text_slash_scr_text_gml_3052_0": "\\E4＊ ほら　みどりの　たまごを&　 たべる　おはなしの　ほん。&　 ふふ…　なつかしいわねえ！/%",
  "scr_text_slash_scr_text_gml_3056_0": "\\E1＊ このいえに　すんでいるのは&　 もう^1　ママとクリス&　 だけだから…/",
  "scr_text_slash_scr_text_gml_3057_0": "\\E9＊ なんだか　ちょっと^1…&　 さみしいわねえ…/",
  "scr_text_slash_scr_text_gml_3058_0": "\\E0＊ でもね^1　そんなときは&　 やきたての　あたたかい&　 パイを　わけて　たべれば…/",
  "scr_text_slash_scr_text_gml_3059_0": "\\E9＊ すぐに　こころも&　 ほんわか　あたたかく&　 なるものよ。/",
  "scr_text_slash_scr_text_gml_3060_0": "\\E5＊ …ママのぶんも&　 のこっていればの&　 おはなしですけど。/%",
  "scr_text_slash_scr_text_gml_3064_0": "\\E8＊ まあ^1…　おはな^1？&　 ママに　くれるの…？/",
  "scr_text_slash_scr_text_gml_3065_0": "\\E9＊ うれしいわ…/",
  "scr_text_slash_scr_text_gml_3066_0": "\\E9＊ …/",
  "scr_text_slash_scr_text_gml_3069_0": "\\E0＊ しんぱいしないで^1。&　 この　おはな^1は&　 ちゃあんと…/",
  "scr_text_slash_scr_text_gml_3070_0": "\\E5＊ …ふさわしい　ばしょに&　 おきますから。/%",
  "scr_text_slash_scr_text_gml_3078_0": "\\E1＊ クリス^1　きょうは&　 はやく　ねたほうが&　 よさそうよ…/",
  "scr_text_slash_scr_text_gml_3079_0": "＊ なんだか　ちょっと&　 いつもと　かおいろが&　 ちがうもの。/%",
  "scr_text_slash_scr_text_gml_3084_0": " #平原",
  "scr_text_slash_scr_text_gml_3085_0": " #森",
  "scr_text_slash_scr_text_gml_3088_0": "＊ (とびらだ^1)&＊ (どこへ行く？)/",
  "scr_text_slash_scr_text_gml_746_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3092_0": " #森",
  "scr_text_slash_scr_text_gml_3093_0": "スイーツ#即売会",
  "scr_text_slash_scr_text_gml_890_0": "\\C3 ",
  "scr_text_slash_scr_text_gml_972_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_3104_0": "＊ (しかし　なにも起こらなかった)/%",
  "scr_text_slash_scr_text_gml_3125_0": "＊ (どういうわけ^1か&　 もう　そこにいる)/%",
  "scr_text_slash_scr_text_gml_3129_0": "＊ (とびらが　開いた…)/%",
  "scr_text_slash_scr_text_gml_3138_0": " #ケーキを返す",
  "scr_text_slash_scr_text_gml_2935_0": " #移動しない",
  "scr_text_slash_scr_text_gml_3142_0": "＊ マーマ　レード^1！&＊ そのケーキ^1！&＊ すさまじい気を　発しているヨ！/",
  "scr_text_slash_scr_text_gml_2796_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_3152_0": "＊ エーダマーメ^1！&　 ワタシの傑作ケーキ^1！　うれしくって&　 クルクル回っちゃいそうネ！/",
  "scr_text_slash_scr_text_gml_3153_0": "＊ あなたたちに　お礼がしたいヨ^1！&　 失敗作ケーキ　たくさんあるヨ！/",
  "scr_text_slash_scr_text_gml_3154_0": "＊ ケーキ　1つも持っていないな^1ら&　 ワタシのところへ来てヨ^1！&　 ケーキあげるヨ！　何度でも！/",
  "scr_text_slash_scr_text_gml_3156_0": "\\S0＊ (トップケーキを　わたして&　 スピンロールを　手に入れた)/",
  "scr_text_slash_scr_text_gml_3157_0": "＊ それじゃあ^1　ワタシは　ここで&　 クルクル涙を　流すヨ！/%",
  "scr_text_slash_scr_text_gml_3162_0": "＊ ケーキは　こんなに甘～いの^1に&　 せち“辛い”世の中だヨ！/%",
  "scr_text_slash_scr_text_gml_3168_0": " #もらわない",
  "scr_text_slash_scr_text_gml_3174_0": "＊ マーマ　ミーバ^1！&　 返品された菓子パン^1　どうデスカ？&　 おいしいでショウ？/%",
  "scr_text_slash_scr_text_gml_3178_0": "＊ マア　アミーゴ^1！&　 三流ケーキを　もらいにきたのカナ？/",
  "scr_text_slash_scr_text_gml_3187_0": "＊ このケーキ^1　受け取ってヨ^1！&　 どうせクズケーキだヨ！/",
  "scr_text_slash_scr_text_gml_3189_0": "\\S0＊ (スピンロールを　手に入れた)/%",
  "scr_text_slash_scr_text_gml_3192_0": "＊ マーメシーバ^1！　あな^1た&　 ケーキじゃない持ち物で&　 いっぱいだヨ！/%",
  "scr_text_slash_scr_text_gml_3197_0": "＊ わかったヨ^1！　ケーキ食べ過ぎると&　 クルクル涙が　出ちゃうしネ！/%",
  "scr_text_slash_scr_text_gml_3202_0": " #もらう",
  "scr_text_slash_scr_text_gml_3206_0": "＊ (ここに^1　男がいる)/",
  "scr_text_slash_scr_text_gml_3207_0": "＊ (男は　なにかを差し出した)/",
  "scr_text_slash_scr_text_gml_3215_0": "＊ (タマゴを　手に入れた)/%",
  "scr_text_slash_scr_text_gml_3221_0": "＊ (では^1　男が&　 ここにいる必要は　ない)/%",
  "scr_torface_slash_scr_torface_gml_1_0": "\\TX \\F0 \\E~1 \\FT \\TT %",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_33_0": "木刀",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_34_0": "芯にカーボン素材を用いた練習用の木刀。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_35_0": "なんだよこれ！？　わりばしか？",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_40_0": "クリス…これは　キミのでしょ。",
