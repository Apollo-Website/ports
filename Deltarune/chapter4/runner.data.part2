  "obj_darkcontroller_slash_Step_0_gml_141_0": "＊ (マニュアルを　力いっぱい&　 投げ捨てた^1。ページが&　 バラバラになって　風に舞った)/",
  "obj_darkcontroller_slash_Step_0_gml_143_0": "＊ …………/",
  "obj_darkcontroller_slash_Step_0_gml_144_0": "\\E5＊ え…っと^1…&＊ うん　大丈夫だよ^1！&＊ また…/",
  "obj_darkcontroller_slash_Step_0_gml_145_0": "\\E6＊ また　作ればいいしね！&　 今度はもっと&　 わかりやくするから！/%",
  "obj_darkcontroller_slash_Step_0_gml_153_0": "＊ (マニュアルを　床に&　 ドサッと捨てた)/",
  "obj_darkcontroller_slash_Step_0_gml_155_0": "＊ あれ^1　クリス^1！&＊ なにしてるの…？/",
  "obj_darkcontroller_slash_Step_0_gml_156_0": "\\E3＊ ああっ^1！&＊ それ　マニュアルじゃない？/",
  "obj_darkcontroller_slash_Step_0_gml_157_0": "\\E1＊ うっかり&　 落としちゃったみたいだね…/",
  "obj_darkcontroller_slash_Step_0_gml_158_0": "\\E8＊ はい^1　どうぞ^1！&＊ なくさないようにね！/",
  "obj_darkcontroller_slash_Step_0_gml_160_0": "＊ (マニュアルを^1　また^1　手に入れた)/%",
  "obj_darkcontroller_slash_Draw_0_gml_74_0": "せってい",
  "obj_darkcontroller_slash_Draw_0_gml_207_0": "こうげき: ",
  "obj_darkcontroller_slash_Draw_0_gml_208_0": "ぼうぎょ: ",
