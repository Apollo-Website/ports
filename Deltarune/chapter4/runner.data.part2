  "scr_text_slash_scr_text_gml_3674_0": "マウス！！",
  "scr_text_slash_scr_text_gml_3674_1": "キッス！",
  "scr_text_slash_scr_text_gml_4777_0_b": "\\EK＊ …てか　オレがいったら&　 クリスも　ぜったい&　 くるだろ？/",
  "scr_text_slash_scr_text_gml_4778_0_b": "\\E2＊ そんなん^1　わざわざ&　 いうまでもねーだろ。/%",
  "scr_text_slash_scr_text_gml_4931_0_b": "#賞品",
  "scr_text_slash_scr_text_gml_4931_1": "#なんでもない",
  "scr_text_slash_scr_text_gml_4932_0_b": "なんでもない",
  "scr_text_slash_scr_text_gml_4933_0_b": " ",
  "scr_text_slash_scr_text_gml_7046_0": "ごめん#パズル#やるね",
  "scr_text_slash_scr_text_gml_7047_0": "#前進",
  "scr_text_slash_scr_text_gml_7048_0_b": "",
  "scr_text_slash_scr_text_gml_7049_0": "",
  "scr_text_slash_scr_text_gml_7052_0_b": "\\E2＊ クリス…^1？　え^1…&　 本気で&　 わたしを置いてく気…？/",
  "scr_text_slash_scr_text_gml_7053_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7062_0": "\\E3＊ あ^1…　うん^1。&　 ありがとう…/%",
  "scr_text_slash_scr_text_gml_7070_0": "\\EB＊ …え？　いま　なんて…？/",
  "scr_text_slash_scr_text_gml_7071_0": "\\E2＊ ででででも^1…　ネズミが…/",
  "scr_text_slash_scr_text_gml_7072_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7082_0": "\\E3＊ あ^1…　うん^1。&　 ありがとう…/%",
  "scr_text_slash_scr_text_gml_7090_0": "\\EB＊ …だだだ^1…だって…/",
  "scr_text_slash_scr_text_gml_7091_0": "\\EB＊ …/%",
  "scr_text_slash_scr_text_gml_7099_0": "#いっしょに#解こう！",
  "scr_text_slash_scr_text_gml_7100_0": "#前進",
  "scr_text_slash_scr_text_gml_7101_0": "",
  "scr_text_slash_scr_text_gml_7102_0": "",
  "scr_text_slash_scr_text_gml_7104_0": "\\E3＊ み…見て…^1！&　 またパズルだね…/",
  "scr_text_slash_scr_text_gml_7105_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7114_0": "\\E4＊ …うん！^1　そうだね^1！&　 そうしよう！/",
  "scr_text_slash_scr_text_gml_7115_0": "\\E3＊ (クリス^1　なんだか様子が&　 ヘンな気がしたけど…)/",
  "scr_text_slash_scr_text_gml_7116_0": "\\E2＊ (また　いつもの調子で&　 からかわれてた&　 だけかな…？)/%",
  "scr_text_slash_scr_text_gml_7153_0": "#入手",
  "scr_text_slash_scr_text_gml_7154_0": "#いらない",
  "scr_text_slash_scr_text_gml_7155_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7156_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7158_0": "\\E8＊ (でも^1　クリスが&　 わたしに　指輪買ってくれる&　 なんて^1　ありえないよ！)/",
  "scr_text_slash_scr_text_gml_7159_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7166_0": "#入手",
  "scr_text_slash_scr_text_gml_7167_0": "#いらない",
  "scr_text_slash_scr_text_gml_7168_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7169_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7176_0": "\\EF＊ えっ…^1　ホントに…^1？&　 クリス^1　買ってくれるの…？/",
  "scr_text_slash_scr_text_gml_7177_0": "\\E6＊ うん^1　そうだね^1…&　 聞くだけ聞いてみようか。/",
  "scr_text_slash_scr_text_gml_7178_0": "\\E0＊ おいくらですか？/",
  "scr_text_slash_scr_text_gml_7180_0": "＊ たったの　$~1です！/",
  "scr_text_slash_scr_text_gml_7182_0": "\\E2＊ えっ…^1　ご…ごめんなさい&　 わたしたち　そんなに&　 おカネ持ってないです！/",
  "scr_text_slash_scr_text_gml_7183_0": "\\E6＊ (クリスの気持ち^1は&　 うれしいけど…)/",
  "scr_text_slash_scr_text_gml_7184_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7189_0": "\\E4＊ だ…だよね^1。指輪なんて&　 いらないよね。/%",
  "scr_text_slash_scr_text_gml_7201_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7206_0": "\\E4＊ だ…だよね^1。指輪なんて&　 いらないよね。/%",
  "scr_text_slash_scr_text_gml_7217_0": "\\ED＊ ダメだよ　クリス^1…&　 ダメだってば…/",
  "scr_text_slash_scr_text_gml_7218_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7223_0": "\\E4＊ だ…だよね^1。指輪なんて&　 いらないよね。/%",
  "scr_text_slash_scr_text_gml_7234_0": "\\EC＊ ダメ…/%",
  "scr_text_slash_scr_text_gml_7240_0": "\\E4＊ だ…だよね^1。指輪なんて&　 いらないよね。/%",
  "scr_text_slash_scr_text_gml_7247_0": "ノエルの#ちちおやに#あうため",
  "scr_text_slash_scr_text_gml_7248_0": "#ノエルに#あうため",
  "scr_text_slash_scr_text_gml_7249_0": "",
  "scr_text_slash_scr_text_gml_7250_0": "",
  "scr_text_slash_scr_text_gml_7254_0": "＊ (さっきのは^1…　ゆめだよね^1…&　 ぜんぶ^1　ただの　わるい　ゆめ…)/",
  "scr_text_slash_scr_text_gml_7255_0": "＊ (でも^1…　すごくリアルだった^1…&　 あたまに　やきついて&　 はなれない…)/",
  "scr_text_slash_scr_text_gml_7256_0": "＊ (…あの　こえ^1…&　 わたしに　しじしてきた…)/",
  "scr_text_slash_scr_text_gml_7257_0": "＊ (クリスとは　ちがう…)/",
  "scr_text_slash_scr_text_gml_7258_0": "＊ (…とても^1　こわい　こえ)/",
  "scr_text_slash_scr_text_gml_7259_0": "＊ (…)/",
  "scr_text_slash_scr_text_gml_7260_0": "＊ (クリスは…)/",
  "scr_text_slash_scr_text_gml_7261_0": "＊ (さいきん^1　なんだか^1…&　 ようすが　ヘン)/",
  "scr_text_slash_scr_text_gml_7262_0": "＊ (みんな　どうし^1て&　 きづかないの…？)/",
  "scr_text_slash_scr_text_gml_7263_0": "＊ (つきとめなきゃ…)/",
  "scr_text_slash_scr_text_gml_7264_0": "＊ (…どうして　クリスのようすが&　 おかしくなったのか)/",
  "scr_text_slash_scr_text_gml_7265_0": "＊ (どうして^1…&　 なんども　びょういんに　くるのか)/",
  "scr_text_slash_scr_text_gml_7266_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_7273_0": "＊ えっ…！？/",
  "scr_text_slash_scr_text_gml_7274_0": "＊ クリスッ…^1！&　 いつから　そこにいたの！？/",
  "scr_text_slash_scr_text_gml_7275_0": "＊ はぁ^1…&　 はは…　びっくりするじゃない。/",
  "scr_text_slash_scr_text_gml_7276_0": "＊ (しっかりしなきゃ…)/",
  "scr_text_slash_scr_text_gml_7277_0": "＊ (だいじょうぶ^1　こわくない…)/",
