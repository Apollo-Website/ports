        if (abs(angle_difference(direct_dir, scr_at_player(x, y))) > 60 || direct_adjust)
        {
            if (direct_adjust > 0)
            {
                direct_adjust--;
            }
            else
            {
                direct_adjust = ceil(adjust_delay);
                adjust_delay *= 0.9;
            }
            
            direct_spd = 0.99;
            
            if (direct_adjust > 0)
                direct_dir += (angle_difference(scr_at_player(x, y), direct_dir) / direct_adjust);
