  "obj_shop2_slash_Draw_0_gml_85_0": "出る",
  "obj_shop2_slash_Draw_0_gml_115_0": "もどる",
  "obj_shop2_slash_Draw_0_gml_124_0": "\\E0買いたき物を&選ぶべし",
  "obj_shop2_slash_Draw_0_gml_125_0": "\\E2うむ&苦しゅうない",
  "obj_shop2_slash_Draw_0_gml_126_0": "\\E2感謝するぞ&勇者よ！",
  "obj_shop2_slash_Draw_0_gml_127_0": "\\E3では&別のモノは？",
  "obj_shop2_slash_Draw_0_gml_128_0": "\\E6ゼニが&足りぬ",
  "obj_shop2_slash_Draw_0_gml_129_0": "\\E3なんじズ&持ちもの&おおすぎ！",
  "obj_shop2_slash_Draw_0_gml_130_0": "/＊",
  "obj_shop2_slash_Draw_0_gml_144_0": "で買うべし？",
  "obj_shop2_slash_Draw_0_gml_146_0": "はい",
  "obj_shop2_slash_Draw_0_gml_147_0": "いいえ",
