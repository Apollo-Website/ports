if (place_meeting(x + px, y + py, obj_battlesolid))
{
    xymeet = 1;
    bkxy = 0;
    i = px;
    j = py;
    
    while (j != 0 || i != 0)
    {
        if (!place_meeting(x + i, y + j, obj_battlesolid))
        {
            px = i;
            py = j;
            bkxy = 1;
            break;
        }
        
        if (abs(j) >= 1)
        {
            if (j > 0)
                j -= 1;
            
            if (j < 0)
                j += 1;
        }
        else
        {
            j = 0;
        }
        
        if (abs(i) >= 1)
        {
            if (i > 0)
                i -= 1;
            
            if (i < 0)
                i += 1;
        }
        else
        {
            i = 0;
        }
    }
    
    if (bkxy == 0)
    {
        px = 0;
        py = 0;
