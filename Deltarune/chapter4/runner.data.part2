  "obj_readable_room1_slash_Other_10_gml_1831_0": "\\E0＊ …/%",
  "obj_readable_room1_slash_Other_10_gml_1870_0": "＊ (ホットチョコレートだ^1…\n　 あつすぎて　のめない)/%",
  "obj_readable_room1_slash_Other_10_gml_2015_0": "＊ (きのうの　けいさつのテープだ)/%",
  "obj_readable_room1_slash_Other_10_gml_2020_0": "＊ (けいさつのテープは\n　 うすっぺらくて\n　 ぬれそぼっている)/%",
  "obj_readable_room1_slash_Other_10_gml_2030_0": "＊ (ピチピチ　チャプチャプ)\n　 あめは　みずたまりに　さいてきな\n　 おてんきです！/",
