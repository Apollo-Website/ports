speech = [string_hash_to_newline(stringsetloc("Oh my god, so like, the Angel,#that's watching over all of us?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_10_0")), string_hash_to_newline(stringsetloc("It has, like, this COOL prophecy,#like, foretold by time and space.", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_11_0")), string_hash_to_newline(stringsetloc("And, like, um...#ummm... like, like...", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_12_0")), string_hash_to_newline(stringsetloc("OK, so like, I'm kind of#paraphrasing here, but,", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_13_0")), string_hash_to_newline(stringsetloc("There's, like, these heroes,#and they're like, SO cool.", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_14_0")), string_hash_to_newline(stringsetloc("They have like,#swords and stuff?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_15_0")), string_hash_to_newline(stringsetloc("And there's one with like,#ummm, horns?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_16_0")), string_hash_to_newline(stringsetloc("He's honestly SO cute.", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_17_0")), string_hash_to_newline(stringsetloc("I mean, there, like,#aren't any pictures, but like,", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_18_0")), string_hash_to_newline(stringsetloc("IDK why, I just imagine him,#as, like, cute!", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_19_0")), string_hash_to_newline(stringsetloc("Like, OMG, pinch his cheeks and#give him a pumpkin pie!", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_20_0")), string_hash_to_newline(stringsetloc("Give him a, like, a fat-free#cat food coupon clipping!", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_21_0")), string_hash_to_newline(stringsetloc("We, have like, such A HUGE pile#of those to get rid OMG", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_22_0")), string_hash_to_newline(stringsetloc("But, like, what's amazing,#is how, like, these heroes,", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_23_0")), string_hash_to_newline(stringsetloc("Are like,#oh my god, they're like...", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_24_0")), string_hash_to_newline(stringsetloc("The thing is, they could be like,#any one of us, you know?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_25_0")), string_hash_to_newline(stringsetloc("So, like, that's the thing, like,", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_26_0")), string_hash_to_newline(stringsetloc("You gotta keep in mind#we could ALL be!!!", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_27_0")), string_hash_to_newline(stringsetloc("Someone that might#change the world, right?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_28_0")), string_hash_to_newline(stringsetloc("So we should all, like...#be nice to each other, right?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_29_0")), string_hash_to_newline(stringsetloc("That's, like, the main... thingy?#Of our religion, right?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_30_0")), string_hash_to_newline(stringsetloc("Like, just be nice to everyone!#We're all family!", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_31_0")), string_hash_to_newline(stringsetloc("No matter what kinda person#or who they are!", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_32_0")), string_hash_to_newline(stringsetloc("Like, we believe weird crap#but we're totally, like, welcoming!", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_33_0")), string_hash_to_newline(stringsetloc("You don't know who's gonna#grow up to be a hero, right?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_34_0")), string_hash_to_newline(stringsetloc("Like... even maybe, like,#I'm actually a Hero too?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_35_0")), string_hash_to_newline(stringsetloc("Like, maybe I'm keeping#a secret from you guys...?", "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_36_0")), string_hash_to_newline(stringsetloc("Psyche!#It's totally not me hahaha.", "obj_ch4_PDC