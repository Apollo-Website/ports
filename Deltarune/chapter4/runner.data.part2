                show_border();
        }
        
        kris_x = remkrisx;
        kris_y = remkrisy;
        sus_x = remsusx;
        sus_y = remsusy;
        
        if (global.flag[302] == 1)
            global.flag[302] = 2;
        
        scr_become_dark();
        dz = global.darkzone + 1;
        room_goto(nextroom);
    }
    
    if (timer == 27)
    {
        snd_play(snd_him_quick);
        
