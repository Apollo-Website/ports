                scr_lerpvar("image_alpha", image_alpha, 0, fadetime, 2, "out");
        }
        
        angymarker = scr_marker_ext(angyboy.marker.x - 16 - 2, (angyboy.marker.y - 16) + 2, 4466, 2, 2, 0, 0, 16777215, angyboy.marker.depth + 1);
    }
    
