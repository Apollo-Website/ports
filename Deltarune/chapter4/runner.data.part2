  "scr_armorinfo_slash_scr_armorinfo_gml_516_0": "王族のブローチ",
  "scr_armorinfo_slash_scr_armorinfo_gml_517_0": "クイーンの顔が刻まれたブローチ。#するどい針に気をつけて。",
  "scr_armorinfo_slash_scr_armorinfo_gml_518_0": "ブローチってなんだ？　うまいのか？",
  "scr_armorinfo_slash_scr_armorinfo_gml_519_0": "カワイイ掲示板になった気分！",
  "scr_armorinfo_slash_scr_armorinfo_gml_520_0": "クイーンからもらったの…",
  "scr_text_slash_scr_text_gml_7554_0": "＊ あ…　サイバーペディアだ！&　 だれでも編集できるんだよ！&　 ボク　記事を書くね…/",
  "scr_text_slash_scr_text_gml_7556_0": "＊ (ラルセイは&　 「なかまを失うこと」という&　 記事を書いた。読む？)/",
  "scr_text_slash_scr_text_gml_7674_0": "\\EQ＊ クリス^1　ボクが書いた&　 サイバーペディアの記^1事&　 もう一度　読む？/",
  "scr_text_slash_scr_text_gml_7676_0": "＊ (ラルセイは&　 「なかまを失うこと」という&　 記事を書いた。読む？)/",
  "scr_text_slash_scr_text_gml_7685_0": "＊ 今回の冒険以降で^1は&　 ラルセーは　だっせー&　 スージィは　かっけー/",
  "scr_text_slash_scr_text_gml_7687_0": "＊ ボク　そんなこと&　 書いてないよ！\\f0/%",
  "DEVICE_CHOICE_slash_Create_0_gml_7_0": "EGG",
  "DEVICE_CHOICE_slash_Create_0_gml_64_0": "GRAINS",
  "DEVICE_CHOICE_slash_Create_0_gml_65_0": "MEAT",
  "DEVICE_CHOICE_slash_Create_0_gml_66_0": "DAIRY",
