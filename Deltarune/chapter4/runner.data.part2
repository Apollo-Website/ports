  "obj_ch4_LWF03_slash_Step_0_gml_614_0": "\\E4＊ あーっははははー！！/%",
  "obj_ch4_LWF03_slash_Step_0_gml_655_0": "\\E1＊ クリス？　どこいくの？\n　 もう　ねるの？/",
  "obj_ch4_LWF03_slash_Step_0_gml_656_0": "\\E9＊ おなかが　すいてるなら\n　 れいぞうこに\n　 パンケーキが　あるわよ…/",
  "obj_ch4_LWF03_slash_Step_0_gml_657_0": "\\E0＊ おやすみなさい！/%",
  "obj_ch4_LWF04_slash_Step_0_gml_185_0": "＊ クリス…おきている…？/",
  "obj_ch4_LWF04_slash_Step_0_gml_186_0": "＊ …なら　メッセージを。/",
  "obj_ch4_LWF04_slash_Step_0_gml_187_0": "＊ あした　おまつりに　いく？/",
  "obj_ch4_LWF04_slash_Step_0_gml_188_0": "＊ …ひとつ　いっておく。/",
  "obj_ch4_LWF04_slash_Step_0_gml_189_0": "＊ ノエルは…/",
  "obj_ch4_LWF04_slash_Step_0_gml_190_0": "＊ あした　あなたに　あうのを\n　 とても　たのしみに　している。/%",
  "obj_ch4_LWF04A_slash_Step_0_gml_32_0": "\\EV＊ …/%",
  "obj_ch4_LWF04A_slash_Step_0_gml_43_0": "\\EV＊ …あんなことは^1　おきねえ^1。\n　 オレたちが　させねえ…/%",
  "obj_ch4_LWF04A_slash_Step_0_gml_54_0": "\\EV＊ …そうだろ？/%",
  "obj_ch4_LWF04A_phone_slash_Create_0_gml_30_0": "…\nクリス…",
  "obj_ch4_LWF04A_phone_slash_Create_0_gml_31_0": "\n…\nわすれな…",
  "obj_ch4_LWF04A_phone_slash_Create_0_gml_32_0": "…\nやくそくを",
  "obj_ch4_PDC01A_slash_Step_0_gml_52_0": "ナイト…/",
  "obj_ch4_PDC01A_slash_Step_0_gml_53_0": "「咆哮の騎士」…/",
  "obj_ch4_PDC01A_slash_Step_0_gml_54_0": "…/",
  "obj_ch4_PDC01A_slash_Step_0_gml_55_0": "そいつが\n闇を作り出してる。/",
  "obj_ch4_PDC01A_slash_Step_0_gml_56_0": "世界を\nブッ壊そうとしてる。/",
  "obj_ch4_PDC01A_slash_Step_0_gml_57_0": "そいつが^1…\nオレたちの敵なんだな。/%",
  "obj_ch4_PDC01A_slash_Step_0_gml_76_0": "昨日までは…/%",
  "obj_ch4_PDC01A_slash_Step_0_gml_92_0": "どんなにヤバい\n状況になっても…/",
  "obj_ch4_PDC01A_slash_Step_0_gml_93_0": "別の世界のことだって\n思ってた。/%",
  "obj_ch4_PDC01A_slash_Step_0_gml_111_0": "…/",
  "obj_ch4_PDC01A_slash_Step_0_gml_112_0": "けど…アンダイン署長が\nシェルターに連れてかれた。/",
  "obj_ch4_PDC01A_slash_Step_0_gml_113_0": "現実の世界の\nシェルターに。/%",
  "obj_ch4_PDC01A_slash_Step_0_gml_129_0": "早くなんとかしねえと…/%",
  "obj_ch4_PDC01A_slash_Step_0_gml_146_0": "…/",
  "obj_ch4_PDC01A_slash_Step_0_gml_147_0": "…ここで　ウダウダ\n言ってても\nしょうがねぇな。/%",
  "obj_ch4_PDC01A_slash_Step_0_gml_163_0": "よし！^1　クリス^1　\n泉を　封印してくれ！/",
  "obj_ch4_PDC01A_slash_Step_0_gml_164_0": "目を覚ますんだ…/",
  "obj_ch4_PDC01A_slash_Step_0_gml_165_0": "おい^1　聞いてんのか？/%",
  "obj_ch4_PDC01A_slash_Step_0_gml_181_0": "早く…/%",
  "obj_ch4_PDC01B_slash_Step_0_gml_34_0": "＊ (イスを　みているだけで\n　 まぶたが　おもくなってきた…)/%",
  "obj_ch4_PDC01B_slash_Step_0_gml_112_0": "\\E0＊ めを　さまして！/%",
  "obj_ch4_PDC01B_slash_Step_0_gml_124_0": "\\E4＊ ねぼすけさんね^1。\n　 あさごはん　できてるわよ。/%",
  "obj_ch4_PDC01B_slash_Step_0_gml_140_0": "\\E2＊ はやくしろよ　クリス^1！\n　 くわねーなら\n　 オレが　もらうぞ！/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_105_0": "\\E9＊ クリスったら^1 \n　 こいぬ　みたいに\n　 グッスリだったわね…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_106_0": "\\E0＊ よく　ねむれたかしら？/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_115_0": "\\E3＊ そういえば　けさは\n　 とっても　ヘンなゆめを\n　 みたわ。/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_136_0": "\\E4＊ ねるまえに\n　 テレビなんか\n　 みちゃダメね！/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_147_0": "\\E9＊ クリス！^1　こんなにウメえ\n　 あさメシ　あんのに^1 \n　 なんで　すぐおきねーの？/",
  "obj_ch4_PDC01C_slash_Step_0_gml_148_0": "\\E5＊ バタースコッチ\n　 パンケーキに^1\n　 バクもりオムレツ…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_149_0": "\\EL＊ ゼータクすぎて\n　 かみの　ゲキリンに\n　 ふれるぜ。/",
  "obj_ch4_PDC01C_slash_Step_0_gml_151_0": "\\E0＊ バチが　あたるってこと？\n　 それで　おもいだしたわ！/",
  "obj_ch4_PDC01C_slash_Step_0_gml_152_0": "\\E4＊ スージィ^1　よかったら\n　 このあと　いっしょに\n　 きょうかいへ　いかない？/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_203_0": "\\E7＊ ん。/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_215_0": "\\E9＊ そう^1！　よかった^1！\n　 じゃあ　おようふくを\n　 さがしてくるわね…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_217_0": "\\E7＊ わーい。/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_245_0": "\\EH＊ はあぁぁぁ！？\n　 んだよ　きょうかいって！\n　 きいてねーぞ！/",
  "obj_ch4_PDC01C_slash_Step_0_gml_246_0": "\\EC＊ クソッ…^1　パンケーキで\n　 ゆだんしたぜ^1。\n　 やっぱり　ワナだったな…/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_279_0": "\\EK＊ うし^1…\n　 いまのうちに　にげ…/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_292_0": "\\E0＊ いや。まてよ。/",
  "obj_ch4_PDC01C_slash_Step_0_gml_296_0": "\\E1＊ …なあ^1　きのうの\n　 よるのこと^1 \n　 おぼえてるよな？/",
  "obj_ch4_PDC01C_slash_Step_0_gml_300_0": "\\ED＊ アンダインしょちょうが^1…\n　 つれていかれた…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_301_0": "\\E0＊ あのシェルター^1…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_305_0": "\\E1＊ …きょうかいの^1 \n　 すぐそばだよな？/",
  "obj_ch4_PDC01C_slash_Step_0_gml_306_0": "\\E0＊ まあ^1　そんな　つごうよく\n　 いくとは　おもえねえけど^1…\n　 きょうかいに　いったら…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_307_0": "\\E1＊ シェルターに　はいる\n　 ほうほう^1　しってるヤツが\n　 いるかもじゃね？/",
  "obj_ch4_PDC01C_slash_Step_0_gml_308_0": "\\ED＊ はやく　たすけねーと\n　 ガチで　ヤ…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_313_0": "\\E4＊ スージィ^1！　クリス^1！\n　 ちょっと　おようふく\n　 きてみてちょうだい！/",
  "obj_ch4_PDC01C_slash_Step_0_gml_315_0": "\\E7＊ い^1…いま　いきまーす！！/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_380_0": "\\E0＊ はい^1　クリスは　これ^1…\n　 スージィは　こっちね…/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_422_0": "\\E0＊ ごめんなさいね^1　スージィの\n　 サイズに　あうのは\n　 アズリエルの　おさがりで…/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_451_0": "\\E5＊ (うっせえ^1　だまれ！！)/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_458_0": "\\E5＊ (てめェの　せいだろ！！)/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_470_0": "\\E0＊ それじゃ…/",
  "obj_ch4_PDC01C_slash_Step_0_gml_471_0": "\\E1＊ でかけましょうか？/%",
  "obj_ch4_PDC01C_slash_Step_0_gml_500_0": "\\EK＊ さっさと　すまそうぜ。/%",
  "obj_ch4_PDC01D_slash_Step_0_gml_48_0": "\\EC＊ …なんで\n　 アニキばっかり\n　 ひょうしょう　されてんの？/",
  "obj_ch4_PDC01D_slash_Step_0_gml_49_0": "\\EL＊ うし…/%",
  "obj_ch4_PDC01D_slash_Step_0_gml_167_0": "\\EL＊ 「スージィしょう」だ^1。\n　 オレを　いえに　よんだ\n　 ヤツは^1　ゆうしょう　だぜ。/%",
  "obj_ch4_PDC01D_slash_Step_0_gml_228_0": "\\Ee＊ …なっ…^1　なんで\n　 こんなとこに　ちの　あとが\n　 ついてんだよ…？/",
  "obj_ch4_PDC01D_slash_Step_0_gml_229_0": "\\EP＊ こういう　よごれはな^1 \n　 すと　おゆ　つけて\n　 こすれば　とれんだよ。/",
  "obj_ch4_PDC01D_slash_Step_0_gml_230_0": "\\EK＊ …いや^1　いまは\n　 そんなことしてる\n　 じかんは…/%",
  "obj_ch4_PDC01D_slash_Step_0_gml_239_0": "＊ (どういうわけか^1　スージィと\n　 ふたりで　じかんをつくり^1 \n　 シミを　そうじした)/%",
  "obj_ch4_PDC01D_slash_Step_0_gml_248_0": "\\EK＊ クソッ…\n　 こりゃ　ちこくだな…/%",
  "obj_ch4_PDC02_slash_Step_0_gml_20_0": "\\E2＊ (しゃ^1　フケよーぜ！)/",
  "obj_ch4_PDC02_slash_Step_0_gml_21_0": "\\EK＊ (…って　いいてえ\n　 とこだけど^1　トリエルさんの\n　 たのみだからな…)/%",
  "obj_ch4_PDC02_slash_Step_0_gml_67_0": "＊ さ^1　ついたわ！/%",
  "obj_ch4_PDC02_slash_Step_0_gml_130_0": "\\E1＊ スージィ^1　クリス^1 \n　 わたしは　おうたの\n　 じゅんびが　あるから…/",
  "obj_ch4_PDC02_slash_Step_0_gml_131_0": "\\E9＊ ふたりとも\n　 おぎょうぎよくね？/",
  "obj_ch4_PDC02_slash_Step_0_gml_133_0": "\\E7＊ ッス！^1　わかりましたッス^1！\n　 さっきも　いわれたし^1 \n　 だいじょうぶっス！/",
  "obj_ch4_PDC02_slash_Step_0_gml_135_0": "\\E0＊ (クリス^1　どこに　すわるか\n　 スージィに　おしえてあげて\n　 ちょうだいね）/%",
  "obj_ch4_PDC02_slash_Step_0_gml_195_0": "\\E0＊ …その^1…れいはい^1？　は\n　 この　でけェ　とびらの\n　 なかで　やるんだよな？/",
  "obj_ch4_PDC02_slash_Step_0_gml_196_0": "\\EL＊ …そのまえに　いろいろ\n　 みてまわるなら\n　 つきあうぜ。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_68_0": "\\E2＊ しゃ^1！\n　 いちばん　うしろの　せき\n　 ゲット！/",
  "obj_ch4_PDC03_slash_Step_0_gml_69_0": "\\EL＊ ここなら　おまえのママには\n　 ほとんど　みえねーな。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_111_0": "＊ (あっというまに\n　 まぶたが　とじた…)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_137_0": "\\E0＊ …だな。\n　 おまえが　イビキかいたら\n　 すぐバレる。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_152_0": "＊ えー^1…　みなさん^1　ほんじつは\n　 おひがらもよく…^1　こうして\n　 おあつまりいただき　なによりです。/",
  "obj_ch4_PDC03_slash_Step_0_gml_153_0": "＊ しきを　はじめるに　あたりまして\n　 まずは　さんびかを^1…\n　 では^1　ごきりつ　ねがいます。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_267_0": "＊ …ごちゃくせき　ください。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_307_0": "\\EK＊ (なあ^1…\n　 ノエルって　いがいと\n　 うた　うめぇのな…)/",
  "obj_ch4_PDC03_slash_Step_0_gml_308_0": "\\EL＊ (つぎは　サイリウム\n　 もってこようぜ)/",
  "obj_ch4_PDC03_slash_Step_0_gml_310_0": "＊ では^1　せいなる　みことばの\n　 ろうどくに　うつりましょう…/",
  "obj_ch4_PDC03_slash_Step_0_gml_311_0": "＊ はくしゅで　おむかえください。\n　 キャッティ・キャッテンハイマー\n　 さんです。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_335_0": "\\E4＊ ヤダ～^1！　てか\n　 みんなゲンキ～^1？\n　 マイク　テスト　ワンツー！/",
  "obj_ch4_PDC03_slash_Step_0_gml_337_0": "＊ キャッティさん^1…\n　 ろうどくする　げんこうは…？/%",
  "obj_ch4_PDC03_slash_Step_0_gml_360_0": "\\E2＊ ありませ～ん^1！\n　 ぜ～んぶ　おぼえたし～！\n　 きゃは！/%",
  "obj_ch4_PDC03_slash_Step_0_gml_376_0": "＊ ぜんぶ^1…おぼえた…/%",
  "obj_ch4_PDC03_slash_Step_0_gml_385_0": "\\E8＊ そうで～す^1！　それじゃ\n　 みなさん^1　ア～ユ～\n　 レディ～！？　イエーイ！/",
  "obj_ch4_PDC03_slash_Step_0_gml_386_0": "\\E2＊ スリー！^1　ツー！^1　ワン^1！\n　 レッツ　ゴー！/%",
  "obj_ch4_PDC03_slash_Step_0_gml_445_0": "\\EW＊ (んだよ^1　マジメかよ)/",
  "obj_ch4_PDC03_slash_Step_0_gml_446_0": "\\EV＊ (オレだって\n　 ウワサきいたこと\n　 あんだぜ？)/",
  "obj_ch4_PDC03_slash_Step_0_gml_447_0": "\\EW＊ (…おまえ　ガキのころ\n　 キャッティーと　ふたりで^1…)/",
  "obj_ch4_PDC03_slash_Step_0_gml_448_0": "\\EY＊ (アクマしょうかん\n　 しようとしたんだろ？)/",
  "obj_ch4_PDC03_slash_Step_0_gml_449_0": "\\E2＊ (それで　よく\n　 この　きょうかいに　いれて\n　 もらえたな！　ヒヒヒ…)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_477_0": "\\E0＊ (…つっても　まあ^1 \n　 ここは　なんつーか…)/",
  "obj_ch4_PDC03_slash_Step_0_gml_478_0": "\\EK＊ (…だれでも\n　 ウェルカムっぽいけどな)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_487_0": "\\E6＊ (あ？\n　 フルーツジュース？)/",
  "obj_ch4_PDC03_slash_Step_0_gml_488_0": "\\E7＊ (え？^1　おわるまで　たえたら\n　 ジュースもらえんの？)/",
  "obj_ch4_PDC03_slash_Step_0_gml_489_0": "\\EK＊ (…んだよ…　それで\n　 「ちゃんと　きこう」とか\n　 いったのか？)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_506_0": "\\E2＊ (ま^1　そーゆーことなら！)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_546_0": "\\E7＊ お！^1　さすが　クリス！/",
  "obj_ch4_PDC03_slash_Step_0_gml_547_0": "\\EL＊ うし。みしてみろ。/",
  "obj_ch4_PDC03_slash_Step_0_gml_564_0": "＊ においつきシール…",
  "obj_ch4_PDC03_slash_Step_0_gml_592_0": "＊ ミントタブレット…",
  "obj_ch4_PDC03_slash_Step_0_gml_619_0": "＊ こげた　パンくず…",
  "obj_ch4_PDC03_slash_Step_0_gml_640_0": "＊ はがた　つきの　エンピツ…",
  "obj_ch4_PDC03_slash_Step_0_gml_644_0": "＊ イケてるエンピツ…",
  "obj_ch4_PDC03_slash_Step_0_gml_649_0": "＊ シャーペン…",
  "obj_ch4_PDC03_slash_Step_0_gml_654_0": "＊ けしごむ…",
  "obj_ch4_PDC03_slash_Step_0_gml_660_0": "＊ CDの　かけら…",
  "obj_ch4_PDC03_slash_Step_0_gml_682_0": "＊ オレンジキャンディ…",
  "obj_ch4_PDC03_slash_Step_0_gml_700_0": "けしごむ",
  "obj_ch4_PDC03_slash_Step_0_gml_700_1": "エンピツ",
  "obj_ch4_PDC03_slash_Step_0_gml_702_0": "\\EK＊ …~1だけで\n　 かみは　ねーのかよ…/",
  "obj_ch4_PDC03_slash_Step_0_gml_703_0": "\\E6＊ あ？^1　それが…^1 \n　 「つるぎ」？/",
  "obj_ch4_PDC03_slash_Step_0_gml_704_0": "\\E9＊ がーはははは！^1！\n　  マジかよ！？/",
  "obj_ch4_PDC03_slash_Step_0_gml_711_0": "ブラシ",
  "obj_ch4_PDC03_slash_Step_0_gml_715_0": "おもちゃのオノ",
  "obj_ch4_PDC03_slash_Step_0_gml_720_0": "でんどうハブラシ",
  "obj_ch4_PDC03_slash_Step_0_gml_725_0": "ヘンなカード",
  "obj_ch4_PDC03_slash_Step_0_gml_728_0": "\\EK＊ …そういや\n　 オレのポケットにも\n　 ~1が…/",
  "obj_ch4_PDC03_slash_Step_0_gml_729_0": "\\EN＊ …ん？/%",
  "obj_ch4_PDC03_slash_Step_0_gml_774_0": "\\EE＊ ああ^1　そっか^1　さっき\n　 ふく　きがえたんだったな^1。\n　 …あれ？^1　なんだ　これ。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_787_0": "\\E6＊ かみが　はいってた。\n　 なんかかいてある。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_796_0": "\\E7＊ う～わぁ～。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_805_0": "\\E7＊ 「キャッティへ^1。ダンス\n　 パーティに　いっしょに\n　 いってくれて　ありがとう」/",
  "obj_ch4_PDC03_slash_Step_0_gml_806_0": "\\E7＊ 「キミの　めは　まるで\n　 ドロドロにとけた　キャット\n　 フードの　うずのよう」…/",
  "obj_ch4_PDC03_slash_Step_0_gml_807_0": "\\E7＊ …「それも\n　 ペットショップで\n　 うってる　たかいヤツ」/",
  "obj_ch4_PDC03_slash_Step_0_gml_808_0": "\\E7＊ …「アズリエルより」！？/",
  "obj_ch4_PDC03_slash_Step_0_gml_809_0": "\\E9＊ ぎゃはははは^1！\n　 うはははは！！！/%",
  "obj_ch4_PDC03_slash_Step_0_gml_835_0": "\\E3＊ んだよ^1！　おまえも\n　 わらってただろ！~1",
  "obj_ch4_PDC03_slash_Step_0_gml_836_0": "\\EK＊ あー…^1　ほら^1　これも\n　 はいってた。おまえにやるよ^1。\n　 わらって　わるかったよ。/",
  "obj_ch4_PDC03_slash_Step_0_gml_838_0": "＊ (「いつのかわからないチョコ」を\n　 てにいれた。チョコは　「ゴミの\n　 かたまり」に　きゅうしゅうされた)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_862_0": "\\E2＊ きょうだいの\n　 「イケてるほう」も\n　 ラクじゃねえだろーな。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_868_0": "＊ (…)\n＊ (…)\n＊ (うなずいた)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_881_0": "\\E9＊ っしゃー^1！\n　 こんだけありゃ　とうぶん\n　 たのしめるぜ！~1",
  "obj_ch4_PDC03_slash_Step_0_gml_884_0": "\\EL＊ っしゃ^1　こんだけありゃ\n　 じゅうぶんだな。~1",
  "obj_ch4_PDC03_slash_Step_0_gml_890_0": "\\EL＊ まずは　シールで\n　 あそぼうぜ。/",
  "obj_ch4_PDC03_slash_Step_0_gml_892_0": "＊ (シールの　かおりを　かいだ)\n＊ (マシュマロの　においがする)/",
  "obj_ch4_PDC03_slash_Step_0_gml_894_0": "\\EA＊ ホージュンな　かおり^1…\n　 かといって　シュチョー\n　 しすぎることもなく…/",
  "obj_ch4_PDC03_slash_Step_0_gml_895_0": "\\EL＊ …/%",
  "obj_ch4_PDC03_slash_Step_0_gml_937_0": "＊ (シールを　めの　したに　はった)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_945_0": "\\E2＊ ハハハ^1　なんだそれ\n　 きのうの　バンドの\n　 メイクのマネかよ？/",
  "obj_ch4_PDC03_slash_Step_0_gml_946_0": "\\EA＊ じゃあ　こっちの　めにも…/%",
  "obj_ch4_PDC03_slash_Step_0_gml_980_0": "\\EL＊ これで　りょうめとも\n　 ヤベーかんじに　なったぜ。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1036_0": "\\EE＊ …て　うぉい！^1\n　 なんで　オレに\n　 はるんだよ！？/",
  "obj_ch4_PDC03_slash_Step_0_gml_1037_0": "\\EY＊ てめー　かくごしとけよ。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1072_0": "\\E2＊ へへっ^1　シール　ぜんぶ\n　 つかっちまったな。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1141_0": "＊ さいしょの　ろうどくは\n　 いじょうです。/",
  "obj_ch4_PDC03_slash_Step_0_gml_1142_0": "＊ では^1　ほんじつの　おせっぽう…\n　 わたしの　ちち^1…\n　 ガーソン・ブームの　ことばを。/",
  "obj_ch4_PDC03_slash_Step_0_gml_1143_0": "＊ ちちは　わたしたちが　うまく\n　 ことばに　できないことを\n　 かみくだくのが　じょうずでした。/",
  "obj_ch4_PDC03_slash_Step_0_gml_1144_0": "＊ たとえば　こんなふうに…/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1163_0": "＊ 「わすれさられた\n　 よげんの　ことばを\n　 しることは　かなわない」/",
  "obj_ch4_PDC03_slash_Step_0_gml_1164_0": "＊ 「しかし^1　たいせつなことが　すべて\n　 ことばとして　のこされているとは\n　 かぎらないのでは？」/",
  "obj_ch4_PDC03_slash_Step_0_gml_1165_0": "＊ 「わたしは^1　なにも　かかれていない\n　 ページこそ　だいじだと\n　 かんがえる」…/",
  "obj_ch4_PDC03_slash_Step_0_gml_1166_0": "＊ 「そこに　どんな　みらいを\n　 えがくかは」…/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1179_0": "＊ (きいている　うちに^1　\n　 まぶたが　おもくなってきた…)/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1213_0": "\\E5＊ クリス^1！　おい^1！\n　 おきろって！/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1252_0": "\\EH＊ ボサッとしてる\n　 ヒマはねーぞ！/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1263_0": "\\EH＊ オレらには\n　 ちょうジューヨーな\n　 ミッションがある。/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1273_0": "\\E2＊ この^1　うんめぇ～～～\n　 ジュースを　ガブのみ\n　 することだ！/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1337_0": "\\EA＊ ぷはー…！/",
  "obj_ch4_PDC03_slash_Step_0_gml_1338_0": "\\EL＊ きょうかいフレーバーだな。/",
  "obj_ch4_PDC03_slash_Step_0_gml_1339_0": "\\E0＊ うし^1　おまえは　みんなから\n　 シェルターの　あんごうを\n　 ききだせ。/",
  "obj_ch4_PDC03_slash_Step_0_gml_1340_0": "\\E1＊ オレは　べつの　ばしょを\n　 あたってみる…/%",
  "obj_ch4_PDC03_slash_Step_0_gml_1374_0": "\\E7＊ …ここな。/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_15_0": "\\E7＊ おー！^1　そのミックス^1 \n　 さいきょうだな！/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_63_0": "\\E0＊ クリス！^1　きょうかいで\n　 あうなんて　めずらしい\n　 ですね…！^1　えっと…/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_85_0": "\\E4＊ (はぁ^1…ノドが　カラカラ^1…\n　 だけど　スージィが\n　 いるから…)/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_86_0": "\\E9＊ (\\cRあか25％\\cW　\\cYきいろ75％\\cWの\n　 ミックスジュースなんか\n　 つくったら…)/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_87_0": "\\E8＊ (ぜったい^1…ぜったい\n　 バカに　される…)/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_116_0": "\\E9＊ (\\cRあか25％\\cW　\\cYきいろ75％\\cWの\n　 ジュースが　のみたい…)/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_213_0": "\\E0＊ フゥ！^1　たすかりました！/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_277_0": "\\E5＊ …/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_328_0": "\\E0＊ クリス^1…\n　 シェルターについて\n　 しりたいことが　あるなら…/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_329_0": "\\E5＊ ちょうちょうさんか\n　 アンダインしょちょうに\n　 きいてくださいね。/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_335_0": "\\E7＊ …けんちくぶつの\n　 れきしの　ことなら\n　 おしえられますけど！/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_342_0": "\\E4＊ …それと^1　ほしくさの\n　 けんは　あきらめたほうが\n　 いいと　おもいます。/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_354_0": "\\E5＊ …そ…そうですか^1…\n　 それは　なによりです…/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_363_0": "\\E0＊ きのうの　ゆうがた\n　 アンダインしょちょうに\n　 きょうかいに　さそわれて…/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_364_0": "\\E7＊ わたしも　このまちに\n　 ひっこしてきて\n　 たいぶ　たつし…/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_365_0": "\\E5＊ …もっと　ともだち\n　 つくったほうが　いいんじゃ\n　 ないか　って　いわれて…/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_366_0": "\\E4＊ …なのに^1 \n　 さそった　ほんにんが\n　 きてないなんて…/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_367_0": "\\E5＊ じ…じつは^1…\n　 れんらくも　つかなくて…/",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_368_0": "\\E9＊ …/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_435_0": "\\S0＊ (じゅうような\n　 じょうほうの　ようだ)/%",
  "obj_ch4_PDC03A_alphys_juice_slash_Step_0_gml_446_0": "＊ (…じゅうぶんな　じょうほうが\n　 あつまった　きがする。\n　 スージィに　つたえよう)/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_58_0": "\\E2＊ ルーディの　おくさんには\n　 ほんとうに…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_60_0": "\\E0＊ キャロルでいいよ。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_62_0": "\\E1＊ あなたの　おくさんには^1…\n　 かれが　おカネの　ことで\n　 おせわになって…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_63_0": "\\E6＊ ただ…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_64_0": "\\E7＊ かれの…^1　“あのけん”に\n　 ついては…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_66_0": "\\E7＊ “あのけん”？^1　なんのこと\n　 だろう…　いってくれないと\n　 わからないなあ。\n　 /",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_68_0": "\\E5＊ それいじょう　いうと\n　 あたまから　ジュース\n　 かぶってもらうわよ。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_70_0": "\\E2＊ 「それいじょう」！/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_143_0": "\\E3＊ ふはは^1！\n　 そんなふうに　ふられたら^1　\n　 いうしかないじゃないか！/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_223_0": "\\E9＊ ノエルは^1　うたが　とっても\n　 じょうずに　なったわね…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_224_0": "\\E4＊ クリスと　アズリエルと\n　 ３にんで^1　ぜひ\n　 うたってほしいわ！/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_226_0": "\\E3＊ えっ…？^1　そ^1…そうですね^1…\n　 ホリデーシーズンに\n　 うたったら　たのしそう…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_228_0": "\\f0^2\\f1^2\\f2/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_301_0": "\\E2＊ あんごう？　じゃあ^1 \n　 「ライムパイ」と　いって\n　 ごらん。いいはなしを…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_303_0": "\\E3＊ ルーディ^1。しんせいな\n　 きょうかいで　そのはなしは\n　 やめてちょうだい。/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_373_0": "\\E3＊ えっ…^1　あ^1…りがとう^1…\n　 でも…どういう　かぜの\n　 ふきまわし…？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_374_0": "\\E8＊ クリスが　わたしを\n　 ほめてくれたの^1 \n　 はじめてじゃない…？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_375_0": "\\E3＊ …クリスも\n　 “せいかたい”に\n　 はいりたい…？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_376_0": "\\E9＊ クリスのピアノ^1…\n　 ひさしぶりに　ききた^1…\n　 ううん…なんでもない。/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_381_0": "\\E9＊ …ひさしぶりに^1…\n　 クリスの　ピアノが\n　 ききた…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_382_0": "\\E4＊ …ううん。なんでもない^1。\n　 わたし^1　クリスがひく\n　 ピアノが　すきだったよ。/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_448_0": "\\EB＊ え？^1　あ^1…あんごう？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_449_0": "\\EH＊ ひょっとして…^1　わたしが\n　 オンチだったって^1　こっそり\n　 つたえようとしてる？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_451_0": "\\E5＊ クリス^1　ノエルに\n　 いじわるしないの。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_453_0": "\\E3＊ そうだぞ^1　おじさんが\n　 ブッとばしてやる！\\f0/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_455_0": "\\E5＊ ルーディ！/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_456_0": "\\E4＊ …ルーディの　いうとおりよ\n　 クリス。\\f1/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_490_0": "\\E2＊ クリス…^1　わたし^1 \n　 いまは　だいぶ　うたが\n　 じょうずに　なったんだよ。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_491_0": "\\E3＊ むかしは　ジングルベルを\n　 うたうたびに　クリスに\n　 みみ　ふさがれてたけど…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_492_0": "\\E8＊ …あれは　もう\n　 むかしのことだからね？/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_529_0": "\\E3＊ え…？^1　わたしの　いえの\n　 もんが　あかないこと？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_530_0": "\\E4＊ よく　しめだされて^1…\n　 クリスの　おうちに\n　 おじゃましてたよね。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_531_0": "\\E8＊ クリスに　てつだって\n　 もらって^1　じぶんの　へやに\n　 しのびこんだりして。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_532_0": "\\E3＊ そんなことが　あっても^1 \n　 ママは　クリスの　おうちに\n　 あいかぎ　わたさなかった。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_533_0": "\\E4＊ まちやくばの　オフィスに\n　 ものを　おきっぱなしに\n　 することもないの。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_534_0": "\\E8＊ カギとか^1　しょるいとか^1…\n　 てづくりの　プレゼントとか^1　\n　 ぜんぶ…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_535_0": "\\E3＊ だいじな　ものは　みんな…/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_536_0": "\\E9＊ うちに　もってかえってきて^1 \n　 カギを　かけて\n　 しまってるんだ。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_547_0": "\\S0＊ (つかえそうな　じょうほうだ)/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_558_0": "＊ (…じゅうぶんな　じょうほうが\n　 あつまった　きがする。\n　 スージィに　つたえよう)/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_563_0": "\\E4＊ あ^1…　なんだ…^1！\n　 いまのは　しつもんじゃ\n　 なかったんだね！/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_564_0": "\\E8＊ てきとうな　ことばを \n　 イミもなく　くりかえしてる\n　 だけでしょ？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_565_0": "\\EH＊ (マジメに　こたえちゃった…\n　 バカみたい…)/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_610_0": "\\E2＊ …クリス^1？\n　 …わたしの　ようすを\n　 みにきてくれたの…？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_611_0": "\\E3＊ ありがとう…　うれしい。/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_612_0": "\\E4＊ ねえ^1…\n　 あとで　すこし　はなせる？/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_616_0": "\\E4＊ あんごう？　ひょっとして…\n　 わたしが　オンチだって\n　 つたえようとしてる…？/",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_617_0": "\\E8＊ ふはは…^1　しかたないよ。\n　 いろいろ　かんがえちゃって\n　 しゅうちゅうできなくて…/%",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_625_0": "＊ (てがかりは　てにはいった)\n＊ (スージィに　ほうこくしよう)~1",
  "obj_ch4_PDC03A_rudy_toriel_slash_Step_0_gml_630_0": "\\E8＊ …クリス？^1　もしもーし^1？\n　 …ちょっと^1…ちかくない？/%",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_10_0": "きゃ～ヤバ～い！　てか　ウチらを\nみまもってる　てんしさま？　とかが～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_11_0": "なんか　じくう？　とかが　かたる？\nめっちゃヤバい　よげんを　しってて～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_12_0": "そんでそんで～\nえ～～～～っとぉ～…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_13_0": "あ　そうそう　おもいだした！\nわかりやすく　いうと～…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_14_0": "ゆうしゃの　ひとたちが　いて～\nそのひとたちが　めっちゃヤバくて～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_15_0": "つるぎ？　とか　もってて？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_16_0": "あと　ツノ？　とか\nはえてるコも　いて？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_17_0": "そのコが　チョ～かわいくて～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_18_0": "てか　しゃしんとか\nないんだけど…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_19_0": "たぶん　かわいいとおもう！\nわかんないけど！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_20_0": "ほっぺ　プニプニ～！\nパンプキンパイ　あげちゃう～！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_21_0": "ローカロリーキャットフードの\nクーポンも　あげちゃう～！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_22_0": "てか　クーポンたまりすぎて\nマジこまるから　もらって～！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_23_0": "でもでも～　なにが　スゴいってね？\nその　ゆうしゃの　ひとたちってね…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_24_0": "わ～　いってて　ドキドキしてきた！\nフゥ…　そのひとたちって～…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_25_0": "ウチらのなかの　だれかって\nかのうせいも　あるわけ～！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_26_0": "それって　めっちゃ\nだいじなことで～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_27_0": "だってだって\nウチら　み～んな…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_28_0": "せかいを　かえちゃうかも\nしんない　ひとなわけじゃん？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_29_0": "だから～　みんな　おたがいに\nやさしく　しましょ～ね～ってことで～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_30_0": "それが　この　きょうかいの　おしえの\nいちばん　だいじな　とこで～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_31_0": "みんなに　やさしく！\nみんな　ファミリー！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_32_0": "それが　だれでも！\nどんな　ひとでも！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_33_0": "ウチらって～　ヘンなモノ　しんじてるけど～\nみんなに　やさしいよね！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_34_0": "だって　だれが　ゆうしゃになるか\nわかんないじゃん？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_35_0": "てか…ひょっとしたら\nアタシかもじゃん？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_36_0": "みんなに　かくしてる\nヒミツとか　あるかもじゃん…？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_37_0": "って　ウッソで～す！\nアタシは　ちがいま～す！　アハハハハ！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_38_0": "…とか　いって　じつは…？\nホント…？　かも…？？　な～んて！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_39_0": "あ　でもでも～\nそれだけじゃなくて～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_40_0": "その　よげんに　よると～\nガチにヤバいことも　おきるかもで？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_41_0": "えっとね　えっとね…　なんだっけ…\n「やくさい」？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_42_0": "でも　だいじょうぶ～！\nだってね　だってね…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_43_0": "…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_44_0": "ゴメン　わすれちゃった～！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_45_0": "いっつも　ろうどくの　とちゅうで\nねちゃうから～！　ウケる～！！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_46_0": "あ　そだそだ！　ついでに\nみんなに　あいさつしていい？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_47_0": "えっと　まず～…　いつも\nおうえんしてくれる　ママとパパ！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_48_0": "ママ～！　パパ～！　みてる～！？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_49_0": "あとは～　ウチの　いもうと！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_50_0": "きょうは　きてないけど～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_51_0": "いま　なにしてんのか　しらないけど～\nアクマと　おしゃべりとか　かな？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_52_0": "ウチの　いもうとって～　アクマ　よびだすの～\nかわいくない？　ウケる～！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_53_0": "いもうとも　くればいいのにね～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_54_0": "せいなる　ひかりとか\nあびまくれば　いいのに～",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_55_0": "そんで　ネコようの　せいなるボウルに\nはいった　みずを　ペロペロして～…",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_56_0": "え？　あの　みずって\nのんじゃ　ダメなの？",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_57_0": "ヤダ～　アタシ　のみまくってた～！\nノドかわいてたから～！　ウケる～！！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_58_0": "ヤダ～！！　きゃはははは！！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_59_0": "きゃはははは！！",
  "obj_ch4_PDC03_catty_preach_slash_Create_0_gml_61_0": "え？　ろうどく　おわり？\nえ～～～～",
  "obj_ch4_PDC03_choir_song_slash_Alarm_5_gml_6_0": "われら^6　こころより^5\nうまれし^7 %",
  "obj_ch4_PDC03_choir_song_slash_Alarm_5_gml_7_0": "やみと　ゆうしゃの^6\nものがたり^8 %",
  "obj_ch4_PDC03_choir_song_slash_Alarm_5_gml_8_0": "たましい^5　\nそは　げに　う^6つくしい^6 %",
  "obj_ch4_PDC03_choir_song_slash_Alarm_5_gml_9_0": "わすれること^4　なきように^7\nThe tale of DELTARUNE ^9^9^2 %%",
  "obj_ch4_PDC04_slash_Step_0_gml_175_0": "＊ (…ライちゃん…)/%",
  "obj_ch4_PDC04_slash_Step_0_gml_292_0": "\\E2＊ うし^1　\n　 なんか　わかったか？/%",
  "obj_ch4_PDC04_slash_Step_0_gml_302_0": "＊ (スージィに　じょうきょうを\n　 せつめいした)/%",
  "obj_ch4_PDC04_slash_Step_0_gml_314_0": "\\E0＊ なるほど。いまんとこ\n　 てにはいった　てがかりは…/",
  "obj_ch4_PDC04_slash_Step_0_gml_315_0": "\\E1＊ アンダインしょちょうと\n　 ちょうちょうが　なにか\n　 しってるかもってことか。/",
  "obj_ch4_PDC04_slash_Step_0_gml_316_0": "\\ED＊ …シェルターに　あった\n　 ３つのマークを\n　 かんがえると…/",
  "obj_ch4_PDC04_slash_Step_0_gml_317_0": "\\E0＊ …なっとくだな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_318_0": "\\E0＊ １つは　きょうかいの\n　 マークだった。/",
  "obj_ch4_PDC04_slash_Step_0_gml_319_0": "\\E1＊ あんごうは　ここに\n　 あるっぽいと^1　\n　 オレは　おもう。/",
  "obj_ch4_PDC04_slash_Step_0_gml_320_0": "\\EB＊ もう１つの　マークは\n　 けいさつの\n　 バッジっぽかった。/",
  "obj_ch4_PDC04_slash_Step_0_gml_321_0": "\\ED＊ …アンダインしょちょうも\n　 なんか　しってんだろうな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_322_0": "\\E0＊ さいごの１つは\n　 モミのき　だったよな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_323_0": "\\EK＊ ちょうちょうが　いる\n　 まちやくばにも\n　 モミのきが　ある。/",
  "obj_ch4_PDC04_slash_Step_0_gml_324_0": "\\E0＊ …/",
  "obj_ch4_PDC04_slash_Step_0_gml_325_0": "\\E1＊ ナイトが　アンダインを\n　 つれてったのは\n　 そのせいかもしれねぇな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_326_0": "\\E0＊ あんごうを　ききだして\n　 なかに　はいったって\n　 ことか…/",
  "obj_ch4_PDC04_slash_Step_0_gml_327_0": "\\EB＊ …でも　それだと…/",
  "obj_ch4_PDC04_slash_Step_0_gml_328_0": "\\EC＊ のこりの２つの\n　 あんごうも　しらねえと\n　 ダメだよな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_329_0": "\\E0＊ きょうかいに　きてて…\n　 ちょうちょうと\n　 しりあいで…/",
  "obj_ch4_PDC04_slash_Step_0_gml_330_0": "\\EK＊ けいさつとも\n　 かんけいあるヤツ…？/",
  "obj_ch4_PDC04_slash_Step_0_gml_331_0": "\\EC＊ …そんなヤツ　いるか？/",
  "obj_ch4_PDC04_slash_Step_0_gml_332_0": "\\E0＊ …/",
  "obj_ch4_PDC04_slash_Step_0_gml_333_0": "\\ED＊ …とりあえず^1　\n　 まちやくばに\n　 いってみるか…/",
  "obj_ch4_PDC04_slash_Step_0_gml_334_0": "\\E6＊ …あ？^1　ノエルのママは\n　 だいじなものは　ぜんぶ\n　 いえに　もってかえるって？/",
  "obj_ch4_PDC04_slash_Step_0_gml_335_0": "\\E0＊ そっか^1…\n　 いま　おもいだしたけど…/%",
  "obj_ch4_PDC04_slash_Step_0_gml_367_0": "\\E1＊ ちょうちょうは\n　 ノエルのママだったな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_368_0": "\\EC＊ てことは…/",
  "obj_ch4_PDC04_slash_Step_0_gml_370_0": "\\E2＊ ねえ　クリス…^1　\n　 あと　スージィも…/",
  "obj_ch4_PDC04_slash_Step_0_gml_371_0": "\\E3＊ よかったら^1…あとで\n　 うちに　こない…？/",
  "obj_ch4_PDC04_slash_Step_0_gml_372_0": "\\E6＊ がっこうの　かだい^1…\n　 うちで　いっしょに\n　 やろうよ…？/",
  "obj_ch4_PDC04_slash_Step_0_gml_374_0": "\\E7＊ …へ？^1　お^1…おう^1！\n　 もちろん！/",
  "obj_ch4_PDC04_slash_Step_0_gml_376_0": "\\E4＊ よかった！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_419_0": "\\E0＊ …さきに　パパを\n　 びょういんまで　おくって\n　 いくから^1…　あとでね。/",
  "obj_ch4_PDC04_slash_Step_0_gml_421_0": "\\E9＊ そっか　それは^1…\n　 サイコーだな^1！\n　 んじゃ　あとでな！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_440_0": "\\E2＊ ヨユーだったな^1！\n　 ラクショーだぜ！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_469_0": "\\EK＊ …？^1　なんだよ^1？\n　 どうかしたのか？/",
  "obj_ch4_PDC04_slash_Step_0_gml_470_0": "\\EC＊ …ノエルが　なんか\n　 モンダイなのか？/%",
  "obj_ch4_PDC04_slash_Step_0_gml_487_0": "\\E1＊ …/%",
  "obj_ch4_PDC04_slash_Step_0_gml_498_0": "\\E0＊ まあ^1　ちょっと…\n　 ヘンな　てんかいでは\n　 あるけどさ…/",
  "obj_ch4_PDC04_slash_Step_0_gml_499_0": "\\ED＊ ノエルの　ほうから\n　 いえに　さそってくるとか\n　 トウトツすぎるしさ…/",
  "obj_ch4_PDC04_slash_Step_0_gml_500_0": "\\E2＊ でも^1　はなしが　はやくて\n　 たすかるじゃん。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_509_0": "\\ED＊ …だろ？/",
  "obj_ch4_PDC04_slash_Step_0_gml_510_0": "\\E0＊ …/%",
  "obj_ch4_PDC04_slash_Step_0_gml_535_0": "\\E9＊ なあ^1。あかいの\n　 もっと　のまねぇ？/",
  "obj_ch4_PDC04_slash_Step_0_gml_536_0": "\\EA＊ …んだよ^1。あとで\n　 のんどきゃ　よかったって\n　 おもっても　しらねーぞ？/%",
  "obj_ch4_PDC04_slash_Step_0_gml_553_0": "\\E0＊ …もう　いこうぜ。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_579_0": "\\E0＊ ノエルのママが\n　 ちょうちょうだったな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_580_0": "\\E1＊ ノエルんちの　にわにも\n　 モミのきが　すげーいっぱい\n　 はえてる…/",
  "obj_ch4_PDC04_slash_Step_0_gml_581_0": "\\EK＊ あれって^1　ホリデー\n　 シーズンが　こおりづけに\n　 なってるみてえだよな。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_590_0": "\\EA＊ こっそり\n　 しのびこんだら…/",
  "obj_ch4_PDC04_slash_Step_0_gml_591_0": "\\E2＊ なんか　てがかり\n　 みつかるかもだな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_592_0": "\\E9＊ …うし^1　オレに\n　 かんがえがある。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_654_0": "\\EA＊ よ！^1　うた^1　うまかったぜ。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_691_0": "\\EE＊ ス…スージィ！？\n　 どどどどうして…\n　 なな…なんで…/%",
  "obj_ch4_PDC04_slash_Step_0_gml_730_0": "\\EM＊ えっと^1…その^1…\n　 きょうかいに　くるなんて\n　 めずらしいね？/",
  "obj_ch4_PDC04_slash_Step_0_gml_732_0": "\\E6＊ あー…/",
  "obj_ch4_PDC04_slash_Step_0_gml_733_0": "\\E7＊ ジュースのめるし？/",
  "obj_ch4_PDC04_slash_Step_0_gml_735_0": "\\E4＊ ああ！^1　そ…そうだね^1！\n　 わたしも　ジュース\n　 のめるから　きてるし？？/",
  "obj_ch4_PDC04_slash_Step_0_gml_737_0": "\\E2＊ な！/",
  "obj_ch4_PDC04_slash_Step_0_gml_739_0": "\\E8＊ ね！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_774_0": "\\EA＊ まっかで^1　まるで\n　 “ち”　みてえだよな。/",
  "obj_ch4_PDC04_slash_Step_0_gml_776_0": "\\EM＊ だよね！^1　わたしも\n　 ち　みたいに　まっかだから\n　 いつも　のんでるし？？？/",
  "obj_ch4_PDC04_slash_Step_0_gml_778_0": "\\EQ＊ な^1。ざんねんだな。\n　 ぜんぶ　なくなっちまって。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_807_0": "\\EX＊ ち^1。が。/",
  "obj_ch4_PDC04_slash_Step_0_gml_809_0": "\\EI＊ えっと…^1　な…なにが\n　 いいたいの？/%",
  "obj_ch4_PDC04_slash_Step_0_gml_829_0": "\\EY＊ ハッキリいわして\n　 もらうぜ。/",
  "obj_ch4_PDC04_slash_Step_0_gml_831_0": "\\EP＊ うん…/%",
  "obj_ch4_PDC04_slash_Step_0_gml_845_0": "\\EK＊ ノエル…/%",
  "obj_ch4_PDC04_slash_Step_0_gml_864_0": "\\E7＊ いっしょに　やらねえ…^1？\n　 がっこうの　かだい。/",
  "obj_ch4_PDC04_slash_Step_0_gml_865_0": "\\E2＊ オマエんちでさ。/",
  "obj_ch4_PDC04_slash_Step_0_gml_867_0": "\\E2＊ えっ！？/%",
  "obj_ch4_PDC04_slash_Step_0_gml_887_0": "\\E3＊ でででも…^1　そのまえに\n　 まず　ママに…/",
  "obj_ch4_PDC04_slash_Step_0_gml_888_0": "\\EA＊ ママに　きいてみないと^1…\n　 それに^1…ダメって\n　 いわれるかも…/%",
  "obj_ch4_PDC04_slash_Step_0_gml_911_0": "\\E8＊ …ううん^1！　だいじょうぶ^1！\n　 やろう！　いっしょに！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_920_0": "\\E2＊ マジ？　ったぜ！^1！\n　 んだよ　ラクショーだったな。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_933_0": "\\E7＊ っしゃあ！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_964_0": "\\EG＊ ？？？？/%",
  "obj_ch4_PDC04_slash_Step_0_gml_973_0": "\\EL＊ じゃあ^1　あとで　ふたりで\n　 いくわ。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_981_0": "\\E2＊ え^1。ふたり^1？\n　 あ…　クリスも　くるの？/%",
  "obj_ch4_PDC04_slash_Step_0_gml_989_0": "\\E8＊ だ…だよね！^1　がっこうの\n　 かだいだもんね。/%",
  "obj_ch4_PDC04_slash_Step_0_gml_1001_0": "\\E2＊ …それじゃあ^1　\n　 バードリーも　よぶ？/",
  "obj_ch4_PDC04_slash_Step_0_gml_1003_0": "\\E1＊ は？　よばねーよ。/",
  "obj_ch4_PDC04_slash_Step_0_gml_1005_0": "\\E4＊ あ^1。オッケー^1！\n　 あはははは！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_1032_0": "\\E2＊ じゃ…じゃあ^1　\n　 いつでも　きて！/",
  "obj_ch4_PDC04_slash_Step_0_gml_1034_0": "\\EA＊ おう^1！　さきに　ちょっと\n　 がっこう　よってから\n　 いくわ。/",
  "obj_ch4_PDC04_slash_Step_0_gml_1036_0": "\\E2＊ …がっこう^1？\n　 おやすみなのに？/",
  "obj_ch4_PDC04_slash_Step_0_gml_1037_0": "\\E4＊ …う…うん！^1　わかった^1！\n　 ぜんぜん　フツーだよね^1！\n　 それじゃあ　あとでね！/",
  "obj_ch4_PDC04_slash_Step_0_gml_1039_0": "\\E2＊ おう！/%",
  "obj_ch4_PDC04_slash_Step_0_gml_1084_0": "\\E9＊ ハハッ！　カンペキだな！/",
  "obj_ch4_PDC04_slash_Step_0_gml_1085_0": "\\E4＊ じゃ^1　フケようぜ…/%",
  "obj_ch4_PDC04_slash_Step_0_gml_1216_0": "\\EH＊ (クリス^1！　オレおいて\n　 かえんなよ！)/%",
  "obj_ch4_PDC05_slash_Step_0_gml_85_0": "\\E0＊ クリス^1　スージィ^1。\n　 このあと　ダイナーで\n　 ごはんを　たべない？/",
  "obj_ch4_PDC05_slash_Step_0_gml_87_0": "\\E1＊ おうたの　れんしゅうが\n 　あるから^1　きょうかいに\n　 もどらなきゃ　いけないの…/",
  "obj_ch4_PDC05_slash_Step_0_gml_88_0": "\\E0＊ でもまだ　すこし　じかんが\n　 あるから^1　そのまえに\n　 はらごしらえよ。/%",
  "obj_ch4_PDC05_slash_Step_0_gml_124_0": "\\E5＊ やあ^1！　トリィ^1！\n　 こんなところで　あうなんて\n　 きぐうだねえ！/",
  "obj_ch4_PDC05_slash_Step_0_gml_125_0": "\\E6＊ ちょうど　れいはいが\n　 おわったところだね？/%",
  "obj_ch4_PDC05_slash_Step_0_gml_137_0": "\\E1＊ あら…/",
  "obj_ch4_PDC05_slash_Step_0_gml_139_0": "\\E4＊ おやおや^1？\n　 これは　おどろいた！/%",
  "obj_ch4_PDC05_slash_Step_0_gml_163_0": "\\E6＊ こんな　ところに\n　 あまった　はなが…/",
  "obj_ch4_PDC05_slash_Step_0_gml_165_0": "\\E1＊ ごめんなさい…/%",
  "obj_ch4_PDC05_slash_Step_0_gml_187_0": "\\E1＊ わたし　もう　いかないと。\n　 また　こんどで\n　 いいかしら？/",
  "obj_ch4_PDC05_slash_Step_0_gml_189_0": "\\E0＊ もちろん！/%",
  "obj_ch4_PDC05_slash_Step_0_gml_229_0": "\\E2＊ …はぁ。/",
