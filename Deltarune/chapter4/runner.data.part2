                    if (i == 1)
                        global.msg[0] = stringsetsubloc("* You put the ~1 on the ground and gave it a little pat.", global.litemname[global.menucoord[1]], "obj_overworldc_slash_Step_0_gml_34_0");
                    
                    if (i == 2)
