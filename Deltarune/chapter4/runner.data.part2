    with (bullet[i])
    {
        angle += other.turn;
        dist = scr_approach(dist, (15 + (10 * other.bullets)) * other.widthmod, (other.widthmod * 3) / sqrt(dist + 1));
        x = other.x + lengthdir_x(dist, angle);
        y = other.y + lengthdir_y(dist * 0.66, angle);
    }
}

