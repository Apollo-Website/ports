  "obj_unusedclassevent_slash_Step_0_gml_96_0": "\\E3＊ How'd we get here...?/%",
  "obj_unusedclassevent_slash_Step_0_gml_123_0": "＊ ... Hey, Kris.../",
  "obj_unusedclassevent_slash_Step_0_gml_124_0": "\\E1＊ What.../",
  "obj_unusedclassevent_slash_Step_0_gml_125_0": "\\E0＊ What just happened...?/",
  "obj_unusedclassevent_slash_Step_0_gml_126_0": "\\E3＊ Like^1, that wasn't a dream or anything^1, was it...?/%",
  "obj_unusedclassevent_slash_Step_0_gml_141_0": "\\E0＊ .../",
  "obj_unusedclassevent_slash_Step_0_gml_142_0": "\\E3＊ Anyway, as I was SAYING,/",
  "obj_unusedclassevent_slash_Step_0_gml_143_0": "\\E2＊ Let's just tell Alphys we couldn't find any chalk./%",
  "scr_actinfo_slash_scr_actinfo_gml_21_0": "Compliment",
  "scr_actinfo_slash_scr_actinfo_gml_28_0": "DualBuster",
  "scr_armorinfo_slash_scr_armorinfo_gml_8_0": "さわんなよ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_28_0": "アンバーカード",
  "scr_armorinfo_slash_scr_armorinfo_gml_29_0": "うすっぺらい正方形の護符。#体に張りつけ　ぼうぎょ力を上げる。",
  "scr_armorinfo_slash_scr_armorinfo_gml_30_0": "…ま　ないよりマシだな",
  "scr_armorinfo_slash_scr_armorinfo_gml_31_0": "クリス…なんかベタベタするよ…",
  "scr_armorinfo_slash_scr_armorinfo_gml_49_0": "ダイスブレス",
  "scr_armorinfo_slash_scr_armorinfo_gml_50_0": "いろんな記号が刻まれた立方体を#つなげたブレスレット。",
  "scr_armorinfo_slash_scr_armorinfo_gml_51_0": "…わかったよ。",
  "scr_armorinfo_slash_scr_armorinfo_gml_52_0": "「なかよし！」って書いてある！",
  "scr_armorinfo_slash_scr_armorinfo_gml_70_0": "ピンクリボン",
  "scr_armorinfo_slash_scr_armorinfo_gml_71_0": "頭につける　かわいいリボン。弾をギリギリ#よけたときにTPがたまる範囲が広くなる。",
  "scr_armorinfo_slash_scr_armorinfo_gml_72_0": "はぁー？　小学生じゃねーっつの",
  "scr_armorinfo_slash_scr_armorinfo_gml_73_0": "ど…どう？　かわいいかな…？",
  "scr_armorinfo_slash_scr_armorinfo_gml_98_0": "ホワイトリボン",
  "scr_armorinfo_slash_scr_armorinfo_gml_99_0": "髪にかざる　シワシワのリボン。#ぼうぎょ力が　少し上がる。",
  "scr_armorinfo_slash_scr_armorinfo_gml_100_0": "はぁー？　小学生じゃねーっつの",
  "scr_armorinfo_slash_scr_armorinfo_gml_101_0": "ど…どう？　かわいいかな…？",
  "scr_armorinfo_slash_scr_armorinfo_gml_118_0": "かわいさ",
  "scr_armorinfo_slash_scr_armorinfo_gml_125_0": "はがねの手かせ",
  "scr_armorinfo_slash_scr_armorinfo_gml_126_0": "盗っ人にはめる“スティール”製のかせ。#こうげき力と　ぼうぎょ力があがる。",
  "scr_armorinfo_slash_scr_armorinfo_gml_127_0": "(ヤベ…　かっこいいじゃん…)",
  "scr_armorinfo_slash_scr_armorinfo_gml_128_0": "＊ジャラジャラ＊　あはは！",
  "scr_armorinfo_slash_scr_armorinfo_gml_146_0": "マウスコイン",
  "scr_armorinfo_slash_scr_armorinfo_gml_147_0": "金色のコイン。かつて勢力をふるった#ネズミの魔術師の絵が彫ってある。",
  "scr_armorinfo_slash_scr_armorinfo_gml_148_0": "こいつ…どっかで見たことあるな…",
  "scr_armorinfo_slash_scr_armorinfo_gml_149_0": "チュウチュウ！　回復パワーアップ！",
  "scr_armorinfo_slash_scr_armorinfo_gml_167_0": "ジェビルテール",
  "scr_armorinfo_slash_scr_armorinfo_gml_168_0": "アルファベットの「J」の形をしたしっぽ。#デビルパワーを授けてくれる。",
  "scr_armorinfo_slash_scr_armorinfo_gml_169_0": "いつか生えてくると思ってたぜ",
  "scr_armorinfo_slash_scr_armorinfo_gml_170_0": "ボクは　いいデビルだからね！",
  "scr_asgface_slash_scr_asgface_gml_1_0": "\\TX \\F0 \\E~1 \\FA \\TA %",
  "scr_encountersetup_slash_scr_encountersetup_gml_98_0": "＊ モンディが　にじりよってきた！",
