        with (pink)
            scr_lerpvar("image_alpha", 0, 1, fadeintime, 2, "out");
        
        snd_play_delay(319, fadeintime);
        myinteract = 4.1;
        scr_delay_var("myinteract", 5, fadeintime + pausetime);
