  "scr_weaponinfo_slash_scr_weaponinfo_gml_60_0": "子ドラゴンのたてがみで作った#初心者用のアックス。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_61_0": "こんなのは　もう卒業したぜ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_62_0": "ええぇ…ちょっと大きいな…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_81_0": "レッドマフラー",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_82_0": "わずかに魔力を帯びた毛糸で編んだ#シンプルなマフラー。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_83_0": "フン…誰が",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_84_0": "フカフカだ！　触ってみて！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_97_0": "EverybodyWeapon",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_98_0": "It felt right for everyone.",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_99_0": "Uhhh... Ok.",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_100_0": "A perfect fit!",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_128_0": "柄にコウモリをあしらった#黒とオレンジ色のソード。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_129_0": "ちっこすぎるぜ！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_130_0": "ええぇ…怖いよ！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_149_0": "ブレイブアクス",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_150_0": "ブロック戦士たちが持っていたテカテカのオノ。#勇者にふさわしい武器。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_151_0": "ま　どーしてもっつうなら…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_152_0": "ちょっと重すぎるよ…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_171_0": "デビルズナイフ",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_172_0": "ドクロのマークが刻まれた大ガマのような#形状のアックス。ルードバスターのコスト10減。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_173_0": "さあ　ゲームを始めよう！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_174_0": "ええぇ…悪モノっぽすぎるよ…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_181_0": "Trefoil",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_182_0": "Mossy rapier with a clover emblem.#Increases $ found by 5%.",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_183_0": "That tacky thing? No!",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_184_0": "Not my shade of green...",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_197_0": "ボクの好みの緑色じゃないな…",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_215_0": "ダガーマフラー",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_216_0": "ダガーのように敵を突くボロボロのマフラー。",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_217_0": "やだね！　チクチクしそうだし！",
  "scr_weaponinfo_slash_scr_weaponinfo_gml_218_0": "チクチクする…　最高！",
