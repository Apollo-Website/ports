  "obj_ch4_DCA05_slash_Step_0_gml_207_0": "\\E2＊ うん！　いいよ！/%",
  "obj_ch4_DCA05_slash_Step_0_gml_230_0": "\\EH＊ おじいさん^1　\n　 ここに　ちょうどいい\n　 踏み台が　ありますよ！/%",
