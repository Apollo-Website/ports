        lastfade.y = cameray() - 20;
        lastfade.image_xscale *= 3;
        lastfade.image_yscale *= 2;
        lastfade.depth = -900000;
        
        with (obj_border_controller)
            hide_border(0.05);
    }
    
    if (quittimer >= 50)
        game_restart_true();
}
