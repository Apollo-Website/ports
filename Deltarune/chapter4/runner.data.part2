  "scr_itemnamelist_slash_scr_itemnamelist_gml_20_0": "こわれたケーキ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_23_0": "トップケーキ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_26_0": "スピンロール",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_29_0": "ダークバーガー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_32_0": "ランサークッキー",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_35_0": "ギガサラダ",
  "scr_itemnamelist_slash_scr_itemnamelist_gml_38_0": "クラブサンド",
