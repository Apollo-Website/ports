    if (activatethrow == 1)
    {
        activatethrow = 0;
        throwready = 0;
        image_index = 0;
        image_speed = 0.5;
        sprite_index = spr_susieb_attack_unarmed;
        angledraw = 0;
        throwcon = 2;
        snd_play(snd_ultraswing);
        ral = instance_create(rx, ry, obj_ralseithrown);
        ral.speed = mypower;
        ral.mypower = mypower;
        ral.image_xscale = 2;
        ral.image_yscale = 2;
        ral.direction = angle;
        ral.image_angle = angle;
        ral.gravity = ralgrav;
    }
    
    if (throwready == 1)
    {
        mypower += (powerdir * powerspeed);
        
        if (mypower >= maxpower)
            powerdir = -1;
        
        if (mypower <= minpower)
            powerdir = 1;
    }
}

if (throwcon == 2)
{
    if (image_index >= 5)
        image_speed = 0;
}

if (angledraw == 1)
{
    lx = lengthdir_x(mypower, angle);
    ly = lengthdir_y(mypower, angle);
    
    for (i = 0; i < 42; i += 1)
    {
        ralyadd = ralgrav + (ralgrav * i);
        
        if (i > 0)
            ralyoff[i] = ralyoff[i - 1] + ralyadd;
        else
            ralyoff[0] = ralyadd;
    }
}
