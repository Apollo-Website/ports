                        mascot[i].y += 10;
                        mascot[i].x -= 30 * facing[i];
                    }
                }
            }
            
            if (attacktype == 3)
            {
                chasecon = 0;
                
                for (var i = 0; i < 2; i++)
                {
                    if (favored == i)
                    {
                        mascot[i].image_xscale = 2;
                        mascot[i].image_yscale = 2;
                        mascot[i].sprite_index = ms[i][2];
                        mascot[i].y -= 16;
