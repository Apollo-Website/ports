    var rightx = (obj_growtangle.x + (_sprite_width / 2)) - width;
    bottomy = (obj_growtangle.y + (_sprite_height / 2)) - (sprite_height / 2);
    
    if (x < leftx)
    {
        hspeed = abs(hspeed);
        x += 2;
    }
    
    if (x > rightx)
    {
        hspeed = -abs(hspeed);
        x -= 2;
    }
    
