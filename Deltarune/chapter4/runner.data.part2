  "obj_ch4_DCA04_slash_Step_0_gml_203_0": "\\E1＊ (返事がねぇ…)/",
  "obj_ch4_DCA04_slash_Step_0_gml_204_0": "\\E0＊ …気をつけて進もうぜ。/%",
  "obj_ch4_DCA04_slash_Step_0_gml_365_0": "\\E7＊ 見ろ！^1　明かりだ！/%",
