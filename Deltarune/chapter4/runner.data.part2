  "obj_shop1_slash_Draw_0_gml_143_0": "$~1",
  "obj_shop1_slash_Draw_0_gml_159_0": "\\E2ありがとね&そうこに&送っとくよ",
  "obj_shop1_slash_Draw_0_gml_177_0": "$~1",
  "obj_shop1_slash_Draw_0_gml_255_0": "\\E0つき合うよ&どうせ&ヒマだしね",
  "obj_shop1_slash_Draw_0_gml_292_0": "そうこのアイテムを売る",
  "obj_shop1_slash_Draw_0_gml_293_0": "もどる",
  "obj_shop1_slash_Draw_0_gml_407_0": "$~1",
  "obj_shop2_slash_Draw_0_gml_113_0": "$~1",
  "obj_shop2_slash_Draw_0_gml_147_0_b": "$~1？",
  "obj_shop2_slash_Draw_0_gml_328_0": "$~1？",
  "obj_shop2_slash_Draw_0_gml_482_0": "空き:~1",
  "obj_shop_ch2_music_slash_Create_0_gml_79_0": "歯ごたえある#ミュージック#フード#80HP回復",
  "obj_shop_ch2_music_slash_Create_0_gml_80_0": "ぼうぐ#みどりの#ケーブル製",
  "obj_shop_ch2_music_slash_Create_0_gml_81_0": "ぶき#柄を押すと#伸びる",
  "obj_shop_ch2_music_slash_Create_0_gml_82_0": "ぶき#充電を#忘れずに",
  "obj_shop_ch2_music_slash_Draw_0_gml_168_0": "\\m3　 なんか　買ってけよ！&\\m1　 もし必要ならばッ！&\\m2　 ボクも　なんか&　 買ってい～い？",
  "obj_shop_ch2_music_slash_Draw_0_gml_170_0": "\\m1　 YO！&\\m3　 チョーシはドーダイ？&\\m2　 ヘイヘーイ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_174_0": "\\m1　 ウェルカム！　ここは…&\\m3　 ミュージックルームだ！&\\m2　 な～んにも&　 売ってないよ～",
  "obj_shop_ch2_music_slash_Draw_0_gml_175_0": "\\m1　 ドン！&\\m3　 ガラ！&\\m2　 ガッシャン！",
  "obj_shop_ch2_music_slash_Draw_0_gml_176_0": "\\m2　 ん～　イイネ～",
  "obj_shop_ch2_music_slash_Draw_0_gml_194_0": "曲をかける",
  "obj_shop_ch2_music_slash_Draw_0_gml_195_0": "ランサー",
  "obj_shop_ch2_music_slash_Draw_0_gml_250_0": "$~1",
  "obj_shop_ch2_music_slash_Draw_0_gml_262_0": "\\m3　 どれに&する！？",
  "obj_shop_ch2_music_slash_Draw_0_gml_266_0": "\\m1　 助かる&ぞッ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_267_0": "\\m2　 わー前が&見えないよ～",
  "obj_shop_ch2_music_slash_Draw_0_gml_270_0": "\\m3　 んだよ！&なんで&やめんだよ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_271_0": "\\m3　 カネが&足りないぜ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_272_0": "\\m3　 もちもの&が&いっぱいだぜ",
  "obj_shop_ch2_music_slash_Draw_0_gml_273_0": "\\m3　 まいどあり！&「そうこ」に&送ったぜ",
  "obj_shop_ch2_music_slash_Draw_0_gml_291_0": "$~1",
  "obj_shop_ch2_music_slash_Draw_0_gml_344_0": "１曲聴きたい",
  "obj_shop_ch2_music_slash_Draw_0_gml_345_0": "クイーンについて",
  "obj_shop_ch2_music_slash_Draw_0_gml_346_0": "ショップの仕事",
  "obj_shop_ch2_music_slash_Draw_0_gml_357_0": "\\m1　 情報&交換だ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_394_0": "そうこのアイテムを売る",
  "obj_shop_ch2_music_slash_Draw_0_gml_395_0": "もどる",
  "obj_shop_ch2_music_slash_Draw_0_gml_399_0": "\\m1　 買い&取らせて&もらおう！",
  "obj_shop_ch2_music_slash_Draw_0_gml_400_0": "\\m2　 ぜんぶ&買い取った&よ～？",
  "obj_shop_ch2_music_slash_Draw_0_gml_401_0": "\\m2　 なにも&ないよ～！",
  "obj_shop_ch2_music_slash_Draw_0_gml_487_0": "\\m1　 よし！&アイテム&見せてみろ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_488_0": "\\m1　 OK！&ぶきを&見せてくれ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_489_0": "\\m1　 OK！&ぼうぐを&見せてみろ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_490_0": "\\m1　 こいつは&いい&スクラップに&なるッ！",
  "obj_shop_ch2_music_slash_Draw_0_gml_491_0": "\\m1　 そうか&なら&返そう",
  "obj_shop_ch2_music_slash_Draw_0_gml_492_0": "\\m1　 それは&持っていた&ほうが&いいのでは？",
  "obj_shop_ch2_music_slash_Draw_0_gml_493_0": "\\m3　 はぁ？&なんも&ねえじゃん！",
  "obj_shop_ch2_music_slash_Draw_0_gml_508_0": "$~1",
  "obj_shop_ch2_music_slash_Draw_0_gml_532_0": "\\m3　 チーフ^1　なかなか　いい町じゃん。&\\m1　 気に入ったぞッ！&\\m2　 この町　イイネ～/",
  "obj_shop_ch2_music_slash_Draw_0_gml_533_0": "\\m1　 お礼に^1　この店で　いろんな曲を&　 聞かせてやろう。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_534_0": "\\m3　 ただし　それなりの出費は&　 覚悟しろよ！&\\m2　 タダだよ～&\\m3　 は！？/%",
  "obj_shop_ch2_music_slash_Draw_0_gml_540_0": "\\m1　 また会おう！&\\m3　 またな！&\\m2　 またに～/%",
  "obj_shop_ch2_music_slash_Draw_0_gml_546_0": "\\m1　 オレは　スイートだ。&\\m3　 キャップって呼んでくれ！&\\m2　 K_Kだよー。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_547_0": "\\m1　 オレたちは　この町の　音楽担当だった。&\\m3　 …クイーンが　現れるまではな。&\\m2　 (K_Kは　「ケーキ」の略だよ～)/",
  "obj_shop_ch2_music_slash_Draw_0_gml_548_0": "\\m1　 クイーンは　音楽を違法化した。&\\m2　 自分が好きな音楽以外はねー。&\\m3　 クイーンの好みは　クズだぜ…/",
  "obj_shop_ch2_music_slash_Draw_0_gml_549_0": "\\m1　 シンガーが自虐し^1て&　 クイーンのことは　ほめまく^1る&　 逆ディスりソングしか認められない。&\\m3　 …それと　ノイズミュージックな。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_550_0": "\\m1　 だが　クイーンに　どれだけ&　 リミッターを　かけられようと…/",
  "obj_shop_ch2_music_slash_Draw_0_gml_551_0": "\\m1　 オレたちの音楽は　不滅だッ！&\\m3　 アンダーグラウンドで　暴れてやるぜ！&\\m2　 ドン　ガラ　ガッシャ～ン。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_552_0": "\\m1　 その地下活動の拠点として&　 このジャンクショップをつくったッ！&\\m3　 活動資金　稼がねーとだからな！&\\m2　 ノイズミュージックも作ってい～い？/%",
  "obj_shop_ch2_music_slash_Draw_0_gml_565_0": "\\m1　 オレらの本気を　見せろって！？&\\m3　 いっちょ　ブチかましますか！？&\\m2　 みんな　しっかりフンばってー。/%",
  "obj_shop_ch2_music_slash_Draw_0_gml_571_0": "\\m1　 クイーンも^1　以前から　あそこまで&　 “ハンパなかった”わけではない。&\\m3　 いや　前からだろ^1！&　 いまは　前よりもっと&　 ハンパなくなっただけだ！/",
  "obj_shop_ch2_music_slash_Draw_0_gml_572_0": "\\m1　 闇の泉が出現して以来…&\\m3　 すっかり　オーバードライブ・モードだ。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_573_0": "\\m1　 「騎士」が　どうし^1た&　 「泉」が　こうした^1…&\\m3　 その騎士野郎の&　 なにが　そんなに　いいんだ！^1？&　 オレと　なにが違うんだ！？/",
  "obj_shop_ch2_music_slash_Draw_0_gml_574_0": "\\m1　 以前は　いまよ^1り&　 いくらか　マシだったのだ^1。&　 スイーツをくれたこともある^1。&　 オレは「スイートな坊や」だから　と。&\\m3　 は…！？^1　オレは　もらってねえ！/",
  "obj_shop_ch2_music_slash_Draw_0_gml_575_0": "\\m1　 キャップ^1　おまえは　いつも&　 クイーンを　「ホットなママ」などと&　 呼んでいたから…&\\m3　 だってあいつ^1　オーバーヒートしまくりの&　 ママ系キャラじゃん！/",
  "obj_shop_ch2_music_slash_Draw_0_gml_576_0": "\\m3　 K_K！　おまえも　なんか言えよ！&\\m1　 K_K！　おまえは　どう思う？&\\m2　 えー？　ボクー？/",
  "obj_shop_ch2_music_slash_Draw_0_gml_577_0": "\\m2　 …ボクは　スイーツ好きー。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_578_0": "\\m1　 そうだとも　K_K！^1　オレたちは&　 もっと重要なことに集中せねばッ！&\\m3　 ケンカしてちゃ&　 いいグルーブ出せないもんな！&\\m2　 レモンゼリー　食べたいなあ～。/%",
  "obj_shop_ch2_music_slash_Draw_0_gml_584_0": "\\m1　 オレたちの　おもな資金源は&　 スクラップから造る　マシンの販売だ。&\\m3　 クライアントには&　 ちょっと　ヘンなヤカラも　いるけどな。&\\m2　 うん。ヘンなニオイのヤツらねー。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_585_0": "\\m1　 前に来た　チンケな男が　いい例だ。&\\m3　 クイーンの館に　忍び込めって&　 言われてさ…&\\m2　 ボクたち　ただの反乱分子だもん。&　 やっかいごとは　ゴメンだよ～。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_586_0": "\\m1　 だが最近^1　ホンモノの上客から&　 依頼を受けた。&\\m3　 ガチに　センスいい男！&　 言葉使いが　最高にイケてたよな！&\\m2　 ぜんぜんイミわかんなかったよー。/",
  "obj_shop_ch2_music_slash_Draw_0_gml_587_0": "\\m1　 たしか^1　受け取った設計図どおりに&　 組み立てればいいんだったか？&\\m3　 そ！　いっちょ派手に　ブチあげようぜ！&\\m2　 きっと派手に　ブチこわれるねー！/%",
  "obj_shop_ch2_music_slash_Draw_0_gml_616_0": "\\m3　 YO！　どうだった！？&\\m1　 最高に　アツかっただろうッ！？&\\m2　 ボクたちの曲って&　 どれも４秒しかないんだ～。/%",
  "obj_shop_ch2_music_slash_Draw_0_gml_677_0": "空き:~1",
  "obj_tasque_manager_enemy_slash_Step_0_gml_15_0": "",
  "obj_tasque_manager_enemy_slash_Step_0_gml_19_0": "プロセス！　サービス！&ディテール！&パフォーマンス！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_23_0": "",
  "obj_tasque_manager_enemy_slash_Step_0_gml_27_0": "お洋服がシワシワ？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_30_0": "ネコ背？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_33_0": "サボりグセ？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_36_0": "ほどけたクツひも？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_39_0": "~1&ワタシのムチで&たたき直しましょう！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_46_0": "執事嬢…&ジツジジョウ…&…じゃなくて&秩序です！秩序なのです！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_46_1": "秩序です！&秩序なのです！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_53_0": "かかりなさい&ニャンコたち！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_53_1": "このニャンコたち&おりこうでしょう？",
  "obj_tasque_manager_enemy_slash_Step_0_gml_68_0": "カオスです…！？&いいえ！　秩序です！&そんなしっぽ&着けてはダメ！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_74_0": "カオスです…！？&いいえ！　秩序です！&デビルズナイフなんて&使ってはダメ！",
  "obj_tasque_manager_enemy_slash_Step_0_gml_161_0": "",
  "obj_tasque_manager_enemy_slash_Step_0_gml_164_0": "＊ タスクマネージャーは&　 来年着る服のリストを作った。&　 しかし　服は１着しか持っていない。",
  "obj_tasque_manager_enemy_slash_Step_0_gml_167_0": "＊ タスクマネージャーは&　 スケジュール帳の全部の日付に&　 「タスク管理」と記入した。",
  "obj_tasque_manager_enemy_slash_Step_0_gml_170_0": "＊ タスクマネージャーは　ムチを&　 ヘアアイロンで　まっすぐに　のばした。",
  "obj_tasque_manager_enemy_slash_Step_0_gml_173_0": "＊ タスクマネージャーは　自分の優先順位を&　 いちばん上に設定した。",
  "obj_tasque_manager_enemy_slash_Step_0_gml_176_0": "＊ 電気の流れる　ニオイがする。",
  "obj_tasque_manager_enemy_slash_Step_0_gml_181_0": "＊ タスクマネージャーが&　 自分でキッチリ設定した&　 就寝時間になった。",
  "obj_tasque_manager_enemy_slash_Step_0_gml_186_0": "＊ タスクマネージャーは&　 「キッチリ整とんされた」と満足した。",
  "obj_tasque_manager_enemy_slash_Step_0_gml_205_0": "＊ タスクマネージャー -&　 整理整とんマニア。カオスが&　 なにより大キライ。…キッチリ！/%",
  "obj_tasque_manager_enemy_slash_Step_0_gml_231_0": "Hush, puppy!&No growling...",
  "obj_tasque_manager_enemy_slash_Step_0_gml_231_1": "Oh, what a&perfect little&puppy you are!",
  "obj_tasque_manager_enemy_slash_Step_0_gml_236_0": "＊ タスクマネージャーは&　 整理整とん具合に&　 ちょっと満足げだ！/%",
  "obj_tasque_manager_enemy_slash_Step_0_gml_256_0": "＊ Susie was trained like an animal.../",
  "obj_tasque_manager_enemy_slash_Step_0_gml_265_0": "A treat!! Somebody give her a treat!!",
  "obj_tasque_manager_enemy_slash_Step_0_gml_269_0": "\\EH＊ Play dead!? I'll teach YOU to play dead!!~1",
  "obj_tasque_manager_enemy_slash_Step_0_gml_274_0": "＊ Susie got managed!/%",
  "obj_tasque_manager_enemy_slash_Step_0_gml_284_0": "What a wonderfully crafted&signpost^1! I'm giving it an&obedience medal!",
  "obj_tasque_manager_enemy_slash_Step_0_gml_299_0": "＊ Ralsei got trained like an animal!!/",
  "obj_tasque_manager_enemy_slash_Step_0_gml_307_0": "Why the hell do YOU get one of those!!",
  "obj_tasque_manager_enemy_slash_Step_0_gml_311_0": "＊ Due to good behavior^1, he received an obedience badge.~1",
  "obj_tasque_manager_enemy_slash_Step_0_gml_316_0": "＊ Ralsei got managed!/%",
  "obj_tasque_manager_enemy_slash_Step_0_gml_326_0": "He really&loves to do&what he's told^1,&doesn't he?/%",
  "obj_tem_school_slash_Other_10_gml_59_0": "＊ 手ミー^1　まだ　べんきｮ^1…&　 べんきｮ　ｶﾞﾝﾊﾞﾃﾙ！！/",
  "obj_tem_school_slash_Other_10_gml_60_0": "＊ 手ミー^1　ょぃアタマ　なる^1！&　 でぇがく　ぃくﾝ^1！&　 ゅめ　かなぇるﾝ！！/",
  "obj_tem_school_slash_Other_10_gml_61_0": "＊ 手ミー^1　そしたら^1…&　 そしたら…！！/",
  "obj_tem_school_slash_Other_10_gml_62_0": "＊ ふふふ^1…　なぁんてね。&　 さきのことなんて　だれにも&　 わかりはしないわ。/%",
  "obj_tem_school_slash_Other_10_gml_66_0": "＊ (これまでに　てにいれたタマゴ。&　 ~1コだ)/%",
  "obj_tensionbar_slash_Draw_0_gml_18_0": "%",
  "obj_tensionbar_slash_Draw_0_gml_25_0": "M",
  "obj_tensionbar_slash_Draw_0_gml_26_0": "A",
  "obj_tensionbar_slash_Draw_0_gml_27_0": "X",
  "obj_throwralsei_slash_Step_0_gml_26_0": "＊ ~1を押して&　 力加減を決めろ！",
  "obj_unusedclassevent_slash_Step_0_gml_186_0": "＊ ゆかに　ちらばっている　ガラクタを&　 ぜんぶ　ひろいあつめた…/%",
  "obj_unusedclassevent_slash_Step_0_gml_225_0": "＊ …ガラクタは　おおきな&　 ゴミのかたまりに　なった。/%",
