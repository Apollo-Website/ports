                    y -= 4;
            }
            else
            {
                hspeed = 0;
            }
        }
    }
    else
    {
        var xpos = obj_npc_king.xstart;
        var ypos = obj_npc_king.ystart;
        
        with (ki_actor)
        {
            if (x > xpos)
            {
                if (y <= ypos)
                    y = clamp(y + 4, 0, ypos);
                
                hspeed -= 1;
            }
            else
            {
                hspeed = 0;
                x = xpos;
            }
        }
    }
}
