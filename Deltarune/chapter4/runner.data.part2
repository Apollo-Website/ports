  "obj_readable_room1_slash_Other_10_gml_372_0": "＊ (ボロボロになった　ぬいぐるみだ)/%",
  "obj_readable_room1_slash_Other_10_gml_373_0": "＊ (あかりの　スイッチだ)/%",
