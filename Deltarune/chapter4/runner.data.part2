  "obj_krisroom_slash_Step_0_gml_283_0": "＊ (しかし^1　めを　あけると…)/%",
  "obj_npc_room_slash_Other_10_gml_237_0": "＊ あなたも　招待されたの^1？&＊ されてないでしょ！^1！&＊ だって　私たちに乱暴したから…/",
  "obj_npc_room_slash_Other_10_gml_247_0": "＊ (ハーティは&　 ２人目のパーティメンバー^1で&　 ヒーラーだ)/",
  "obj_npc_sign_slash_Other_10_gml_27_0": "＊ (~1の　はなだ^1。&　 ケースで　まもられている…)/%",
  "obj_overworldc_slash_Draw_0_gml_88_0": "？？？",
  "obj_rudy_slash_Step_0_gml_84_0": "\\E2＊ ああ^1　きをつけてな^1。/%",
  "scr_text_slash_scr_text_gml_232_0": "＊ ねえ　クリス^1…&　 [~1]を長押しすると&　 走れることは　知ってる？/",
  "scr_text_slash_scr_text_gml_250_0": "＊ そうなの^1！&＊ [~1]を長押しすると&　 速く移動できるんだよ！/",
  "scr_text_slash_scr_text_gml_262_0": "＊ ねえクリス^1…/",
  "scr_text_slash_scr_text_gml_646_0": "\\E4＊ ノエルは　ほんとうに&　 いいコだ^1。クリスも&　 そうおもうだろう？/",
  "scr_text_slash_scr_text_gml_647_0": "\\E0＊ かしこくて^1　やさしくて^1…&　 おじさんには　もったいない&　 ぐらいの　むすめだよ。/",
  "scr_text_slash_scr_text_gml_648_0": "\\E5＊ ただなあ…^1　こわがりな&　 ところだけは　おじさんも&　 きがかりでねえ。/",
  "scr_text_slash_scr_text_gml_649_0": "\\E1＊ ホラーえいがに^1　ムシ^1に&　 サンタクロース^1…　とにかく&　 なんでもこわがって…/",
  "scr_text_slash_scr_text_gml_650_0": "\\E5＊ ヘッドライトに　てらされた&　 シカみたいに&　 かたまってしまうだろう？/",
  "scr_text_slash_scr_text_gml_651_0": "\\E0＊ ちいさいころは　ベッドの&　 したに　ニンゲンがいると&　 いって　こわがってたしな。/",
  "scr_text_slash_scr_text_gml_652_0": "\\E7＊ (クリスも^1　かくれて&　 こわがらせたりするから^1…&　 この　イタズラっこめ！)/",
  "scr_text_slash_scr_text_gml_653_0": "\\E1＊ とにかく^1　にゅういん&　 してると^1　そればっかりが&　 なやみのタネだよ。/",
  "scr_text_slash_scr_text_gml_654_0": "\\E4＊ じぶんの　からだのこと&　 なんかよりね。/",
  "scr_text_slash_scr_text_gml_655_0": "\\E5＊ ノエルを　ちかくで&　 まもってやれない^1…&　 それが　なにより　つらい。/",
  "scr_text_slash_scr_text_gml_656_0": "\\E3＊ あのコのこと&　 よろしく　たのむよ？/%",
  "scr_text_slash_scr_text_gml_678_0": "\\E2＊ うちの　にわの　でんしょくの&　 コードに　からまったクリスを&　 どなりつけたり　できるさ！/%",
  "scr_text_slash_scr_text_gml_1314_0": "＊ 「けいこく」はもう&　 いらなくなったァ。/%",
  "scr_text_slash_scr_text_gml_1343_0": "＊ 大ダメージ与える&　 [~1]を押せばァ！/%",
  "scr_text_slash_scr_text_gml_2056_0": "\\E2＊ …そいつが　なにか&　 はんざいでも&　 おかしたのか！？/",
  "scr_text_slash_scr_text_gml_2057_0": "\\E5＊ そうか^1！　なら&　 こんど　みかけた^1ら&　 たいあたり　してやるぞ！/",
  "scr_text_slash_scr_text_gml_2058_0": "＊ ククククク…^1！&＊ アルフィーとやらめ…&　 かくごしておけ！！/%",
  "scr_text_slash_scr_text_gml_2070_0": "\\E5＊ だれかに　ぎんこうを&　 おそわせろ！^1　わたしが&　 スープレックスきめてやる！/",
  "scr_text_slash_scr_text_gml_2526_0": " #サイアク",
  "scr_text_slash_scr_text_gml_2527_0": "チョーク食べる",
  "scr_text_slash_scr_text_gml_2536_0": "\\E4＊ スージィって^1…&　 どんなコなのかなーって…/",
  "scr_text_slash_scr_text_gml_2537_0": "\\E8＊ だ…だって^1　スージィって&　 だれとも　はなさないから&　 きになるでしょ？/",
  "scr_text_slash_scr_text_gml_2538_0": "\\E4＊ だから^1…　もしよかったら^1…&　 どんなコなのか&　 おしえて…？/",
  "scr_text_slash_scr_text_gml_2571_0": "\\E0＊ アズくんに　よろしくね！/%",
  "scr_text_slash_scr_text_gml_2584_0": "\\E2＊ え…^1？&＊ いいコ…なの？/",
  "scr_text_slash_scr_text_gml_2585_0": "＊ ホントに！^1？&　 ウソじゃなくて！^1？&　 ホントにホントに！？/",
  "scr_text_slash_scr_text_gml_2586_0": "\\E4＊ あ^1　えと^1　わたしもね&　 そうだったらいいなーって&　 おもってたんだけどね…/",
  "scr_text_slash_scr_text_gml_2587_0": "\\E2＊ まって^1…　ひょっとして^1…&　 また　わたしを&　 からってる…？/",
  "scr_text_slash_scr_text_gml_2588_0": "\\E8＊ まえに^1　ケチャップを&　 うでに　ぬって　“ち”が&　 でた　フリした　みたいに！/",
  "scr_text_slash_scr_text_gml_2589_0": "\\E2＊ …ホントなのね^1？&　 ホントに　ホント^1に&　 ホントなのね？？/",
  "scr_text_slash_scr_text_gml_2590_0": "\\E6＊ …そっか^1　じゃあ&　 わたしも　ゆうきを　だして&　 はなしかけて　みようかな…/",
  "scr_text_slash_scr_text_gml_2591_0": "\\E8＊ ウソだったら^1　わたし&　 しんじゃうかも^1…　そしたら&　 クリスのせいだからね！/",
  "scr_text_slash_scr_text_gml_2592_0": "\\E6＊ (でも^1　スージィが　いいコ&　 だったら^1　それはそれで&　 しんじゃいそう…)/%",
  "scr_text_slash_scr_text_gml_2596_0": "\\E2＊ ええぇ…^1？　スージィが？&　 クリスを　ロッカーに&　 たたきつけたの…？/",
  "scr_text_slash_scr_text_gml_2597_0": "\\E7＊ それは^1…ひどいね。/",
  "scr_text_slash_scr_text_gml_2598_0": "\\E3＊ わたし^1…&　 スージィは　ホントは&　 いいコだと　おもってた…/",
  "scr_text_slash_scr_text_gml_2599_0": "\\E6＊ いいところに　きづいて&　 あげられるひとが^1　まだ&　 あらわれてないだけだって…/",
  "scr_text_slash_scr_text_gml_2600_0": "\\E7＊ でも…^1　やっぱり&　 ほんとうに　サイアクなコ&　 だったんだね…/",
  "scr_text_slash_scr_text_gml_2601_0": "\\E7＊ クリスも&　 たいへんだね…/",
  "scr_text_slash_scr_text_gml_2602_0": "\\E4＊ そうだ^1…&　 いいこと　おもいついた。/",
  "scr_text_slash_scr_text_gml_2603_0": "\\E3＊ アルフィーせんせいに&　 たのんで^1　わたしと　ペアを&　 こうかん　できないかな？/",
  "scr_text_slash_scr_text_gml_2604_0": "\\E2＊ そうすれば^1…&　 クリスは　もう…/",
  "scr_text_slash_scr_text_gml_2605_0": "\\E3＊ ロッカーに　「ドン！」って&　 してもらわなくて&　 すむでしょ？/",
  "scr_text_slash_scr_text_gml_2606_0": "\\E8＊ (あ^1…あれ^1？&　 なんか　ヘンな　いいかたに&　 なっちゃった…)/%",
  "scr_text_slash_scr_text_gml_2610_0": "\\E2＊ え^1？&＊ スージィが　チョークを…？/",
  "scr_text_slash_scr_text_gml_2611_0": "＊ ほ…^1　ホントに…？/",
  "scr_text_slash_scr_text_gml_2612_0": "\\E8＊ あ^1！　わかった！&　 また　からかってるでしょ！/",
  "scr_text_slash_scr_text_gml_2613_0": "\\E3＊ むかし^1　「ぶるどっ君は&　 ホントにいて　こどもをたべる&　 」って　いったときみたく。/",
  "scr_text_slash_scr_text_gml_2614_0": "\\E8＊ ディセおねえちゃんに&　 「ウソつくな！」って&　 ブンなぐられたでしょ？/",
  "scr_text_slash_scr_text_gml_2615_0": "\\E2＊ …え^1？　ウソじゃない？/",
  "scr_text_slash_scr_text_gml_2616_0": "\\E5＊ …/",
  "scr_text_slash_scr_text_gml_2617_0": "\\E0＊ そ…^1　そうなんだ^1…&　 なにいろの　チョークが&　 すきなのかな…？/",
  "scr_text_slash_scr_text_gml_2618_0": "\\E4＊ ふとめのと　ほそめのと&　 どっちがすきとか&　 あるのかな…？/",
  "scr_text_slash_scr_text_gml_2619_0": "\\E8＊ (んー…^1　おべんとうの&　 おかずに　チョークいれて&　 あげるって　ヘンかな…)/%",
  "scr_text_slash_scr_text_gml_2623_0": "\\E2＊ え…^1　どうして^1？&　 わたし　いつも　クリスに&　 しんせつに　してるよね！？/",
  "scr_text_slash_scr_text_gml_2624_0": "\\E8＊ すこしぐらい&　 おしえてくれても&　 いいじゃない！/",
  "scr_text_slash_scr_text_gml_2625_0": "\\E2＊ たとえば^1　スージィは&　 メタル系の　おんがくとか&　 すきなのか　とか…/",
  "scr_text_slash_scr_text_gml_2626_0": "\\E2＊ かんぜん　にくしょく系&　 なのか　とか…/",
  "scr_text_slash_scr_text_gml_2628_0": "\\E3＊ それから^1…　えと…　その…/",
  "scr_text_slash_scr_text_gml_2629_0": "\\E4＊ あ…^1　ゴメン^1　やっぱり&　 わたしには　かんけいない&　 ことだよね…？/",
  "scr_text_slash_scr_text_gml_2658_0": " #ねむる",
  "scr_text_slash_scr_text_gml_2662_0": "＊ (じぶんの　ベッドだ)/",
  "scr_text_slash_scr_text_gml_2641_0": "＊ (ねむりますか？)/",
  "scr_text_slash_scr_text_gml_2671_0": " #ねる！！",
  "scr_text_slash_scr_text_gml_2672_0": " #ねない！！",
