create_object_to_draw = function(arg0, arg1, arg2)
{
    var obj = instance_create(arg0, arg1, obj_marker_fancy);
    
    with (obj)
    {
        scr_darksize();
        sprite_index = arg2;
        
        draw_func = function()
        {
        };
    }
    
    ds_list_add(to_draw, obj);
    return obj;
};

