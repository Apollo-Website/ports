        draw_sprite_ext(chsprite, chnum, (x + (w / 2)) - (sin((siner / 8) + (i / 2)) * (i * factor2)), ((chyoffset - 17) + y + (h / 2)) - (cos((siner / 8) + (i / 2)) * (i * factor2)), image_xscale, image_yscale, 0, c_white, mina * AA);
        draw_sprite_ext(chsprite, chnum, x + (w / 2) + (sin((siner / 8) + (i / 2)) * (i * factor2)), ((chyoffset - 17) + y + (h / 2)) - (cos((siner / 8) + (i / 2)) * (i * factor2)), image_xscale, image_yscale, 0, c_white, mina * AA);
