{
    var _lifeD = 10;
    var _t = scr_ease_out(timer / _lifeD, 2);
    sprite_index = spr_gradient_ring;
    image_xscale = (_t * 0.8) + 0.2;
    image_yscale = (_t * 0.8) + 0.2;
    image_blend = c_black;
    image_alpha = 1 - _t;
    speed = 0;
    
    if (timer >= _lifeD)
        instance_destroy();
    
    exit;
