                {
                    healamt = 2;
                    star = 0;
                }
                
                scr_healitemspell(healamt);
            }
            
            if (damage > 0)
            {
                if (i_ex(obj_titan_enemy) || i_ex(obj_titan_spawn_enemy) || i_ex(obj_jackenstein_enemy) || i_ex(obj_sound_of_justice_enemy))
                    scr_tensionheal(round(points / 26));
