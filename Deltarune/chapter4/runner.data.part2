  "obj_ch4_DCC03_slash_Step_0_gml_837_0": "\\Ej＊  …/%",
  "obj_ch4_DCC03_slash_Step_0_gml_910_0": "\\E0＊ ねえ…クリス。/",
  "obj_ch4_DCC03_slash_Step_0_gml_911_0": "\\EI＊ さっき…/%",
  "obj_ch4_DCC03_slash_Step_0_gml_927_0": "\\EQ＊ …さっき　かっこよかったよ！\n　 ピアノ弾いてたときの\n　 クリス！/%",
