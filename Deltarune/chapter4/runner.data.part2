            msgnextloc("\\m1\t\t*That's why we made this junk&\tshop!&\\m3\tWe'll fund our musical rebellion!&\\m2\tCan we make noise music, too?/%", "obj_shop_ch2_music_slash_Draw_0_gml_552_0");
