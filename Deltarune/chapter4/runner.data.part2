  "scr_text_slash_scr_text_gml_370_0": "＊ (木の枝に　キャンディが１つ&　 ぶらさがっている)/",
  "scr_text_slash_scr_text_gml_371_0": "＊ (１つ取る？)/ ",
  "scr_text_slash_scr_text_gml_372_0": "\\C2",
