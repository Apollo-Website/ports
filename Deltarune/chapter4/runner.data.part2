        draw_sprite(spr_heart, 0, 450, 350 + (menuc[2] * 30));
        
        if (button2_p() && twobuffer < 0)
        {
            menu = 1;
            sidemessage = 2;
            twobuffer = 2;
            onebuffer = 2;
        }
        
        if (button1_p() && onebuffer < 0 && twobuffer < 0)
        {
            if (menuc[2] == 0)
            {
                afford = 0;
                
                if (global.gold >= buyvalue[menuc[1]])
                    afford = 1;
                
                if (afford == 1)
                {
                    _pocketed = 0;
                    
                    if (itemtype[menuc[1]] == "item")
                        scr_itemget(item[menuc[1]]);
                    
                    if (itemtype[menuc[1]] == "weapon")
                        scr_weaponget(item[menuc[1]]);
                    
                    if (itemtype[menuc[1]] == "armor")
                        scr_armorget(item[menuc[1]]);
                    
                    if (noroom == 0)
                    {
                        global.gold -= buyvalue[menuc[1]];
                        snd_play(snd_locker);
                        
                        if (_pocketed == 1)
                            sidemessage = 5;
                        else
                            sidemessage = 1;
                    }
                    
                    if (noroom == 1)
                        sidemessage = 4;
                }
                else
                {
                    sidemessage = 3;
                }
            }
            
            if (menuc[2] == 1)
                sidemessage = 2;
            
            menu = 1;
        }
    }
    
    if (menuc[1] != 4)
    {
        if (minimenuy <= 20)
            minimenuy = 20;
        
        if (minimenuy > 20)
            minimenuy -= 5;
        
        if (minimenuy > 50)
            minimenuy -= 5;
        
        if (minimenuy > 100)
            minimenuy -= 8;
        
        if (minimenuy > 150)
            minimenuy -= 10;
    }
    else if (minimenuy < 200)
    {
        minimenuy += 40;
    }
    
    if (minimenuy >= 200)
        minimenuy = 200;
}

