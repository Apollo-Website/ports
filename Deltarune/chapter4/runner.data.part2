  "scr_text_slash_scr_text_gml_832_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_1300_0": "＊ またな。/%",
  "scr_text_slash_scr_text_gml_1303_0": "＊ クリスが　「けいこく」する^1と&　 スージィのこうげき　当たらないィ^1。&＊ だから…/",
  "scr_text_slash_scr_text_gml_1305_0": "＊ …「けいこく」なんて&　 するイミねーってことだな。/",
  "scr_text_slash_scr_text_gml_1307_0": "\\M1＊ でも^1…&＊ 敵を　こうげきしたくないときは…/",
  "scr_text_slash_scr_text_gml_1309_0": "＊ だから&　 「けいこく」なんて&　 するイミねーよな！/%",
  "scr_text_slash_scr_text_gml_1313_0": "＊ スージィ消えたァ^1。ケタタタタァ。/",
  "scr_text_slash_scr_text_gml_1318_0": "＊ 「けいこく」の日々は&　 過去のモノォ。/",
  "scr_text_slash_scr_text_gml_1319_0": "＊ 状況変わるよ　どんどんとォ。/%",
  "scr_text_slash_scr_text_gml_1326_0": "＊ スージィは　いつも必ず^1ゥ&　 いちばん上の敵　こうげきするゥ。/",
  "scr_text_slash_scr_text_gml_1327_0": "＊ ブッつぶすゥ^1。ブッたぎるゥ。/",
  "scr_text_slash_scr_text_gml_1328_0": "＊ スージィは　いつも必ず^1ゥ&　 最初に　目に入ったもの&　 こうげきするゥ…/",
  "scr_text_slash_scr_text_gml_966_0": "＊ …/",
  "scr_text_slash_scr_text_gml_1332_0": "\\M1＊ あわ^1…あわわわわ^1！&＊ スージィが　こっち見てるゥゥ！/%",
  "scr_text_slash_scr_text_gml_1336_0": "＊ スージィいないよ。&　 こうげきしないィ。/",
  "scr_text_slash_scr_text_gml_1337_0": "＊ キミたち２人が&　 すりゃいんじゃないィ？/%",
  "scr_text_slash_scr_text_gml_1342_0": "＊ 「ルードバスター」&　 スージィの技ァ…/",
  "scr_text_slash_scr_text_gml_1349_0": "＊ スージィよろこぶ　どんなときィ？&　 キミが　ボクらに　おカn…/",
  "scr_text_slash_scr_text_gml_1351_0": "＊ ベツに^1。&　 どーでもいいな。/",
  "scr_text_slash_scr_text_gml_1353_0": "\\M1＊ ボク　なんか&　 ヘンなこと言った！？/%",
  "scr_text_slash_scr_text_gml_1356_0": "＊ スージィいないよ^1。&　 マメ知識も　ないよォ。/",
  "scr_text_slash_scr_text_gml_1357_0": "＊ キミたち２人が&　 すりゃいんじゃないォ？/%",
  "scr_text_slash_scr_text_gml_1361_0": "＊ スージィ変わった　毛ほどの変化ァ。/",
  "scr_text_slash_scr_text_gml_1362_0": "＊ そんな成長　かなりレアァ！/%",
