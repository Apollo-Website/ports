  "scr_text_slash_scr_text_gml_410_0": "＊ (木の枝に　なにかが２つ&　 ぶらさがっている)/",
  "scr_text_slash_scr_text_gml_411_0": "＊ (１つ取る？)/",
  "scr_text_slash_scr_text_gml_296_0": " \\C2",
  "scr_text_slash_scr_text_gml_416_0": "＊ (木の枝に　キャンディが１つ&　 ぶらさがっている)/",
  "scr_text_slash_scr_text_gml_338_0": " \\C2",
  "scr_text_slash_scr_text_gml_423_0": "＊ (手の届く高さに&　 ぶらさがっているものはない)/%",
  "scr_text_slash_scr_text_gml_434_0": "＊ (ダークキャンディを　手に入れた)/%",
  "scr_text_slash_scr_text_gml_478_0": "＊ (持ちものが　いっぱいだ)/%",
  "scr_text_slash_scr_text_gml_445_0": "＊ (そのまま　木に持たせておく&　 ことにした)/%",
  "scr_text_slash_scr_text_gml_404_0": "#取る",
  "scr_text_slash_scr_text_gml_405_0": "#取らない",
  "scr_text_slash_scr_text_gml_456_0": "＊ (ケーキの残がいからは&　 まだ　煙が立ちのぼっている…)/",
  "scr_text_slash_scr_text_gml_457_0": "＊ (１切れ取る？)/",
  "scr_text_slash_scr_text_gml_264_0": " \\C2",
  "scr_text_slash_scr_text_gml_462_0": "＊ (ケーキの残がいからは&　 まだ　煙が立ちのぼっている…)/%",
  "scr_text_slash_scr_text_gml_473_0": "＊ (「こわれたケーキ」が&　 \\cYだいじなもの\\cWに加わった)/%",
  "scr_text_slash_scr_text_gml_439_0": "＊ (持ちものが　いっぱいだ)/%",
  "scr_text_slash_scr_text_gml_484_0": "＊ (ケーキは　ポケットに&　 入れないほうが　よさそうだ)/%",
  "scr_text_slash_scr_text_gml_2223_0": "#ひく",
  "scr_text_slash_scr_text_gml_2224_0": "#ひかない",
  "scr_text_slash_scr_text_gml_3098_0": "城",
  "scr_text_slash_scr_text_gml_492_0": " #クシャ#クシャ#の紙",
  "scr_text_slash_scr_text_gml_493_0": " #ランサーと#書いて#ある紙",
  "scr_text_slash_scr_text_gml_494_0": "きっちり#した紙",
  "scr_text_slash_scr_text_gml_496_0": "＊ はい^1！&　 みんな入れたな！/",
  "scr_text_slash_scr_text_gml_497_0": "\\E2＊ んじゃあ&　 そこの　青いおまえ^1！&　 選べ。/",
  "scr_text_slash_scr_text_gml_498_0": "\\E1＊ なんかおまえ^1「自分&　 どーでもいいっすわー」&　 みたいな顔してるから！/",
  "scr_text_slash_scr_text_gml_499_0": "\\C3 ",
  "scr_text_slash_scr_text_gml_508_0": "＊ (クシャクシャに丸められた&　 紙切れを　手に取った)/",
  "scr_text_slash_scr_text_gml_509_0": "＊ (広げてみた)/",
  "scr_text_slash_scr_text_gml_511_0": "＊ 発表します！&＊ おまえたちの&　 チーム名は…！/",
  "scr_text_slash_scr_text_gml_512_0": "\\E6＊ …う。/",
  "scr_text_slash_scr_text_gml_513_0": "\\E7＊ これは…&　 ボクさまは　言っちゃダメな&　 言葉だと思う…/",
  "scr_text_slash_scr_text_gml_517_0": "＊ おわわ^1！　お下品レベル２の&　 言葉^1！　ボクさまは&　 言っちゃダメなヤツ！/",
  "scr_text_slash_scr_text_gml_518_0": "\\E3＊ おまえたち３人の&　 共同パパ^1は　怒らないの？&　 うらやましい。/",
  "scr_text_slash_scr_text_gml_520_0": "＊ あの^1…&　 やっぱり　別の名前に&　 しませんか？/",
  "scr_text_slash_scr_text_gml_522_0": "＊ ラルセイ^1　イヤなら&　 抜けてもらっていいんだぜ？/",
  "scr_text_slash_scr_text_gml_524_0": "＊ そうだそうだ！　代わりに&　 ボクさまが入る！　そんで&　 おまえが悪モノやればいい。/",
  "scr_text_slash_scr_text_gml_525_0": "\\E1＊ ほら^1。&＊ パパ上に　電話しろ。/",
  "scr_text_slash_scr_text_gml_526_0": "＊ 「新しい息子です」って。/",
  "scr_text_slash_scr_text_gml_527_0": "\\E3＊ 「汚い言葉を言うたびに&　 シャワー浴びにいく&　 いいコちゃんです」ってな。/",
  "scr_text_slash_scr_text_gml_529_0": "＊ わ…わかりましたよ^1！&＊ その名前で　いいです^1！&＊ でも　ボクは　言わないぞ！/",
  "scr_text_slash_scr_text_gml_531_0": "＊ ハハハ^1　ボクさまも&　 言わないぞ！/",
  "scr_text_slash_scr_text_gml_532_0": "\\E1＊ さらばだ^1　敗者さんたち^1！&＊ 早くシャワー浴びなきゃ！/%",
  "scr_text_slash_scr_text_gml_540_0": "＊ (表に「ランサー」と書いてある紙を&　 手に取った)/",
  "scr_text_slash_scr_text_gml_541_0": "＊ (広げてみた)/",
  "scr_text_slash_scr_text_gml_542_0": "＊ (中には…)&＊ (「ランサー」と書いてある)/",
  "scr_text_slash_scr_text_gml_544_0": "＊ おおお^1　これは　誰のだ^1？&＊ とっても　いい名前だ！/",
  "scr_text_slash_scr_text_gml_546_0": "＊ 待ってください^1。どうして&　 あなたが　ボクたちの&　 チーム名を決めるの…？/",
  "scr_text_slash_scr_text_gml_548_0": "＊ いや^1。&＊ 決めたのは　クリスだぜ。/",
  "scr_text_slash_scr_text_gml_550_0": "＊ そうだぞ^1！　仮^1に&　 それを　書いたのが&　 ボクさまだったとしても…/",
  "scr_text_slash_scr_text_gml_551_0": "\\E1＊ だからなんだというのだ^1！ &　 いずれにせよ　ランサーは&　 滅ぶ運命なのだ！/",
  "scr_text_slash_scr_text_gml_552_0": "\\E6＊ …う^1。&　 やっぱり　この名^1前&　 ヘンな感じだな。/",
  "scr_text_slash_scr_text_gml_553_0": "\\E4＊ ううぅぅむ…/",
  "scr_text_slash_scr_text_gml_554_0": "\\E3＊ よし^1！　略して&　 「ランサー・ファンクラブ」&　 にしよう！/",
  "scr_text_slash_scr_text_gml_555_0": "\\E3＊ では　また会お^1う&　 ボクさま！/%",
  "scr_text_slash_scr_text_gml_563_0": "＊ (きちんと　たたまれた紙を&　 手に取った)/",
  "scr_text_slash_scr_text_gml_564_0": "＊ (広げてみた)/",
  "scr_text_slash_scr_text_gml_566_0": "＊ 「伝説の勇者たち：&　 楽しい友情の予感」/",
  "scr_text_slash_scr_text_gml_568_0": "＊ あ^1！　はい^1！&＊ それ　ボクのです！/",
  "scr_text_slash_scr_text_gml_569_0": "\\E0＊ 個人的には　ボクたちに&　 ぴったりの名前だと&　 思うな…/",
  "scr_text_slash_scr_text_gml_570_0": "\\E6＊ だってボクたち３人は&　 友だちだし^1　楽しいことが&　 大好きだし…/",
  "scr_text_slash_scr_text_gml_572_0": "＊ いや^1　長すぎだろ。/",
  "scr_text_slash_scr_text_gml_573_0": "＊ それに^1　敵が聞いたら&　 どう思う？/",
  "scr_text_slash_scr_text_gml_574_0": "\\E2＊ ヤツらとダチに&　 なりたがってると&　 かんちがいされっぞ？/",
  "scr_text_slash_scr_text_gml_575_0": "＊ もっと短くて^1　敵が聞いたら&　 ふるえあがるようなのに&　 しようぜ！/",
  "scr_text_slash_scr_text_gml_576_0": "\\E4＊ インパクトあって&　 すんげー強そうなヤツな！/",
  "scr_text_slash_scr_text_gml_578_0": "＊ …たとえば？/",
  "scr_text_slash_scr_text_gml_580_0": "＊ たとえば^1…　あー…/",
  "scr_text_slash_scr_text_gml_581_0": "\\E0＊ そうだな^1…&＊ えっと…/",
  "scr_text_slash_scr_text_gml_582_0": "\\E6＊ た…「たのしみ隊」とか。/",
  "scr_text_slash_scr_text_gml_583_0": "\\E6＊ ほら^1　アレだ^1よ&　 「たのしい」の部分に&　 的を　しぼったんだよ。/",
  "scr_text_slash_scr_text_gml_585_0": "＊ すばらしい！！/",
  "scr_text_slash_scr_text_gml_586_0": "＊ んじゃ^1　また^1な&　 たのしみ隊！/",
  "scr_text_slash_scr_text_gml_587_0": "＊ ボクさまは&　 アフタヌーンミルクを&　 吸収する時間だ！/%",
  "scr_text_slash_scr_text_gml_2435_0": " #いいよ",
  "scr_text_slash_scr_text_gml_1122_0": " #いらない",
  "scr_text_slash_scr_text_gml_600_0": "\\E2＊ こりゃ　ジングルべらぼうに&　 おどろいた^1！　ことしはもう&　 “クリス”マスかい！？/",
  "scr_text_slash_scr_text_gml_601_0": "\\E1＊ なあんて^1　じょうだんは&　 さておき…　きょうはまた&　 どうしたんだい？/",
  "scr_text_slash_scr_text_gml_602_0": "\\E2＊ ママに　いわれて&　 きたのかい^1？/",
  "scr_text_slash_scr_text_gml_2179_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_608_0": " #ノエル",
  "scr_text_slash_scr_text_gml_609_0": " #かぞく",
  "scr_text_slash_scr_text_gml_610_0": "びょうき",
  "scr_text_slash_scr_text_gml_2031_0": "とくにない",
  "scr_text_slash_scr_text_gml_612_0": "\\E0＊ ほかにも　はなしたいことが&　 あるのかな？/",
  "scr_text_slash_scr_text_gml_613_0": "\\E2＊ えんりょは　いらないぞ^1。&　 おじさん　いま^1　ヒマだけは&　 たーっぷりあるからねえ！/",
  "scr_text_slash_scr_text_gml_2095_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_619_0": "\\E2＊ ははは^1　やっぱり^1！&＊ あのひとは…そう^1　“モモ”&　 みたいな　ひとだからなあ…/",
  "scr_text_slash_scr_text_gml_620_0": "\\E7＊ そとは　フワフワで&　 スイート^1…　でも　しんは&　 ゴツゴツの　カッチカチだ！/",
  "scr_text_slash_scr_text_gml_621_0": "\\E0＊ ん？^1　きみのパパかい^1？&　 アズゴアも　やっぱり&　 フルーツみたいなヤツだよ。/",
  "scr_text_slash_scr_text_gml_622_0": "\\E7＊ どのフルーツかって^1？&　 うーん^1　けむくじゃら&　 だから…^1　キウイ　かな？/",
  "scr_text_slash_scr_text_gml_625_0": "\\E7＊ わっはっはっはっは！/",
  "scr_text_slash_scr_text_gml_635_0": "\\E0＊ ま^1　じょうだんは&　 さておき^1　はなしたいこと&　 でも　あるのかな？/",
  "scr_text_slash_scr_text_gml_630_0": "\\E1＊ へえ^1？&＊ クリスも　ずいぶん&　 オトナに　なったなあ。/",
  "scr_text_slash_scr_text_gml_631_0": "\\E4＊ おじさんも　うれしいよ。/",
  "scr_text_slash_scr_text_gml_632_0": "\\E5＊ ちょっと　まえまで　なにを&　 かんがえてるのか　わからん&　 おとなりのコ　だったのに。/",
  "scr_text_slash_scr_text_gml_633_0": "\\E7＊ いまじゃ^1　なにを&　 かんがえてるのか　わからん&　 めのまえのコだ！/",
  "scr_text_slash_scr_text_gml_634_0": "＊ わっはっはっはっは！/",
  "scr_text_slash_scr_text_gml_626_0": "\\E0＊ ま^1　じょうだんは&　 さておき^1　はなしたいこと&　 でも　あるのかな？/",
  "scr_text_slash_scr_text_gml_2091_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_1597_0": "＊ ん？/%",
  "scr_text_slash_scr_text_gml_660_0": "\\E3＊ うちの一家は　みん^1な&　 いまでも　クリスのかぞくが&　 だいすきだ。/",
  "scr_text_slash_scr_text_gml_661_0": "\\E1＊ そういえば^1…&　 アズ坊も　もう&　 だいがくせいか…/",
  "scr_text_slash_scr_text_gml_674_0": "\\E1＊ おじさんが&　 にゅういんしてる&　 りゆうかい…？/",
  "scr_text_slash_scr_text_gml_675_0": "\\E4＊ ちょっと^1　マズいもんが&　 みつかったんで^1　くわしく&　 けんさしてもらってるんだ。/",
  "scr_text_slash_scr_text_gml_676_0": "\\E3＊ なあに　しんぱいないさ^1。&　 ホリデー家のオトコたるもの&　 これぐらい　よゆうだよ。/",
