  "scr_text_slash_scr_text_gml_1787_0": " #さよなら",
  "scr_text_slash_scr_text_gml_1788_0": " #体を治して",
  "scr_text_slash_scr_text_gml_1790_0": "＊ わが名はマリウス。鍛冶を極めし者^1。&　 私に直せぬものはない。&　 武器だろうと　防具だろうと…/",
  "scr_text_slash_scr_text_gml_1791_0": "＊ …おぬしの体であろうとな^1！&　 さて^1　今日は　なにをお望みか？/",
  "scr_text_slash_scr_text_gml_1476_0": "\\C3 ",
  "scr_text_slash_scr_text_gml_1796_0": "＊ うむ^1　何用だ？/%",
  "scr_text_slash_scr_text_gml_1813_0": "＊ はて^1…&　 直すべき物を&　 持っておられぬようだが。/",
  "scr_text_slash_scr_text_gml_1814_0": "＊ 「こわれた」物を見つけたなら^1ば&　 再び私を訪ねてきなさい。/",
  "scr_text_slash_scr_text_gml_1815_0": "＊ 私に直せぬものはない…/",
  "scr_text_slash_scr_text_gml_1816_0": "＊ …ただひとつ&　 「こわれた心」を　のぞいてはな。/%",
  "scr_text_slash_scr_text_gml_1821_0": "＊ なんと…^1！　そのケーキからは&　 すさまじい気が　感じられる^1！&　 よろこんで直させていただこう！/",
  "scr_text_slash_scr_text_gml_1822_0": "＊ フッ^1！　ハッ^1！&　 わが究極の技^1　とくと見よ！/%",
  "scr_text_slash_scr_text_gml_1828_0": "＊ なんと…^1！　そのケーキからは&　 すさまじい気が　感じられる^1！&　 よろこんで直させていただこう！/",
  "scr_text_slash_scr_text_gml_1829_0": "＊ …が^1　まずは「アイテム」の&　 空きスペースを作るのだ。よいな？/%",
  "scr_text_slash_scr_text_gml_1834_0": "＊ なんと…^1！　そのカギからは&　 すさまじい気が　感じられる^1！&　 よろこんで直させていただこう！/",
  "scr_text_slash_scr_text_gml_1835_0": "＊ フッ^1！　ハッ^1！&　 わが究極の技^1　とくと見よ！/%",
  "scr_text_slash_scr_text_gml_1842_0": "＊ さようか^1。&　 では　よき旅を^1。/%",
  "scr_text_slash_scr_text_gml_1846_0": "＊ おぬしの体もまた^1　武器である^1。&　 こまめに手入れを　せねばならぬぞ。/",
  "scr_text_slash_scr_text_gml_1847_0": "＊ フッ^1！　ハッ^1！&　 わが究極の技^1　とくと見よ！/%",
  "scr_text_slash_scr_text_gml_2715_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_1854_0": " #買う",
  "scr_text_slash_scr_text_gml_1685_0": " #保持しない",
  "scr_text_slash_scr_text_gml_1858_0": "＊ チョコダイヤ^1　いかがですか？/",
  "scr_text_slash_scr_text_gml_781_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_798_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_1878_0": "＊ まいどあり^1…かな^1。&＊ (チョコダイヤが&　 「アイテム」に加わった)/%",
  "scr_text_slash_scr_text_gml_1882_0": "＊ …これ以上　アイテムを&　 持てない^1…のかな。/%",
  "scr_text_slash_scr_text_gml_1887_0": "＊ おカネが足りない^1…のかな。/%",
  "scr_text_slash_scr_text_gml_1892_0": "＊ それは残念…かな。/%",
  "scr_text_slash_scr_text_gml_1901_0": " #買う",
  "scr_text_slash_scr_text_gml_1715_0": " #取らない",
  "scr_text_slash_scr_text_gml_1077_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_1919_0": "＊ (ハーティは　うれしそうだ^1)&＊ (ハートドーナツが&　 「アイテム」に加わった)/%",
  "scr_text_slash_scr_text_gml_1923_0": "＊ (これ以上　アイテムを持てない^1)&＊ (ハーティは　悲しそうだ)/%",
  "scr_text_slash_scr_text_gml_1928_0": "＊ (おカネが　足りない^1)&＊ (ハーティは　悲しそうだ)/%",
  "scr_text_slash_scr_text_gml_1933_0": "＊ (ハーティは&　 こちらの選択を　受け入れた)/%",
  "scr_text_slash_scr_text_gml_1939_0": " #買う",
  "scr_text_slash_scr_text_gml_1855_0": " #買わない",
  "scr_text_slash_scr_text_gml_1946_0": "＊ いらっしゃいま^1せ&　 ジェントルピエロさま。/",
  "scr_text_slash_scr_text_gml_1947_0": "\\E1＊ ランサークッキーは&　 いかがですか？/",
  "scr_text_slash_scr_text_gml_1949_0": "＊ 売上で　おまえらを&　 ボコってやるぜ。/",
  "scr_text_slash_scr_text_gml_1112_0": "\\C2 ",
  "scr_text_slash_scr_text_gml_1969_0": "＊ キヒヒ^1…　助かるぜ…/",
  "scr_text_slash_scr_text_gml_1971_0": "＊ (ランサークッキーが&　 「アイテム」に加わった)/",
  "scr_text_slash_scr_text_gml_1973_0": "\\E2＊ …まんまと　だまされて&　 くれたな！/",
  "scr_text_slash_scr_text_gml_1975_0": "＊ これで　悪だくみ資金が&　 できたぞ！！/%",
  "scr_text_slash_scr_text_gml_1985_0": "＊ (ランサークッキーを　買った^1)&＊ (しかし　持ち物が&　 いっぱいだった)/",
  "scr_text_slash_scr_text_gml_1986_0": "＊ (ランサーは　クッキーを&　 地面に落とした。クッキーは　割れた)/",
  "scr_text_slash_scr_text_gml_1988_0": "＊ おっと。/",
  "scr_text_slash_scr_text_gml_1990_0": "＊ あーあ^1。ま　しゃーない。&　 「売ったモン勝ち」だ。/",
  "scr_text_slash_scr_text_gml_1992_0": "＊ …んでも　寄付は寄付だぞ。&　 どうもありがとう&　 ございますッ！/",
  "scr_text_slash_scr_text_gml_1994_0": "＊ …だな^1。まんまと&　 ひっかかってくれて&　 助かったぜ！/",
  "scr_text_slash_scr_text_gml_1996_0": "＊ よーし！　悪だくみ資金が&　 できたぞ！！/%",
  "scr_text_slash_scr_text_gml_2007_0": "＊ …おカネが足りないぞ。/",
  "scr_text_slash_scr_text_gml_2009_0": "＊ んだと^1？　てめえ&　 菓子パンとか　買ったんじゃ&　 ねーだろーな！？/",
  "scr_text_slash_scr_text_gml_2011_0": "＊ この無責任さんめ。/%",
  "scr_text_slash_scr_text_gml_2019_0": "＊ なっ…^1！　ダメだ！&　 買わない選択肢の選択は&　 選択できないのだ！/",
  "scr_text_slash_scr_text_gml_2021_0": "＊ ざけんなよ^1…&＊ 売上は　いいことに&　 使うっつってんだろーが！/",
  "scr_text_slash_scr_text_gml_2023_0": "＊ (クリス…&　 ひとつ買ってあげよう？)/%",
  "scr_text_slash_scr_text_gml_2028_0": "#アルフィー",
  "scr_text_slash_scr_text_gml_2029_0": "#やみの#せかい",
  "scr_text_slash_scr_text_gml_2030_0": "てつだう",
  "scr_text_slash_scr_text_gml_2034_0": "\\E2＊ おい^1　おまえッ^1！&＊ しゃどうを　あるくな！/",
  "scr_text_slash_scr_text_gml_2035_0": "＊ クルマが&　 とおれないだろう！！/",
  "scr_text_slash_scr_text_gml_2036_0": "\\E1＊ …ああ^1　なんだ^1。&　 アズゴアの　おチビじゃ&　 ないか。/",
  "scr_text_slash_scr_text_gml_2037_0": "\\E7＊ すまない^1　さいきんどう^1も&　 イライラしててな。/",
  "scr_text_slash_scr_text_gml_2038_0": "\\E2＊ しごとが　たいくつすぎる&　 んだ^1。このまちじゃ&　 じけんも　おきやしない！/",
  "scr_text_slash_scr_text_gml_2039_0": "\\E4＊ …はぁ^1　なにか&　 さわぎに　なるようなことは&　 ないものかな！/",
  "scr_text_slash_scr_text_gml_2040_0": "\\E7＊ …どうした^1？&＊ なにか　つうほうしたい&　 ことでも　あるのか？/",
  "scr_text_slash_scr_text_gml_1024_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_2045_0": "\\E1＊ なにか　つうほうしたい&　 ことでも　あるのか？/",
  "scr_text_slash_scr_text_gml_1208_0": "\\C4 ",
  "scr_text_slash_scr_text_gml_2054_0": "\\E0＊ …アルフィー？/",
  "scr_text_slash_scr_text_gml_2055_0": "\\E3＊ だれのことだ　それは？/",
  "scr_text_slash_scr_text_gml_2062_0": "\\E1＊ なんだって^1？&＊ がっこうの　なかに&　 「やみのせかい」が　ある？/",
  "scr_text_slash_scr_text_gml_2063_0": "\\E2＊ あー…^1　う^1ん&　 そうかそうか。/",
  "scr_text_slash_scr_text_gml_2064_0": "\\E5＊ ま^1　やみのせかいを&　 とりしまる　ほうりつは&　 ないからな！/",
  "scr_text_slash_scr_text_gml_2065_0": "＊ それは&　 きょういく　いいんかいの&　 かんかつだ！/%",
  "scr_text_slash_scr_text_gml_2069_0": "\\E6＊ そうかそうか^1　てつだって&　 くれるのか^1！　なら…/",
  "scr_text_slash_scr_text_gml_2071_0": "\\E1＊ …いや　まてよ^1。そもそも&　 このまちに　ぎんこうなんて&　 あったか？/",
  "scr_text_slash_scr_text_gml_2072_0": "\\E5＊ よし^1　だれかに&　 ぎんこう　つくらせろ！/%",
  "scr_text_slash_scr_text_gml_2076_0": "\\E6＊ ほうりつ　いはんは&　 しちゃダメだぞ～！/",
  "scr_text_slash_scr_text_gml_2077_0": "\\E3＊ それと^1　ムラサキの&　 おんなのコに　こころあたり&　 あったら　おしえてくれ。/",
  "scr_text_slash_scr_text_gml_2078_0": "\\E4＊ 「ギリギリなイタズラ」の&　 つうほうが　なんけんか&　 はいってるんだ。/%",
  "scr_text_slash_scr_text_gml_2083_0": "#アズリエル",
