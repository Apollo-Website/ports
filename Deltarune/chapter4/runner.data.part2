    image_xscale = 0.8;

if (_angle >= 210 && _angle < 270)
    image_xscale = lerp(1, 1.3, (_angle - 210) / 60);
else if (_angle >= 270 && _angle < 330)
    image_xscale = lerp(1.3, 1, (_angle - 270) / 60);
else if (_angle >= 180 && _angle < 360)
    image_xscale = 1;

