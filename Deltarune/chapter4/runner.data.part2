                if (global.submenucoord[11] == -1)
                    global.submenucoord[11] = 2;
            }
            
            if (down_p())
            {
                movenoise = 1;
                global.submenucoord[11] += 1;
                
                if (global.submenucoord[11] == 3)
                    global.submenucoord[11] = 0;
