  "DEVICE_NAMER_slash_Other_10_gml_37_0": "RUDY",
  "DEVICE_NAMER_slash_Other_10_gml_38_0": "BERDLY",
  "DEVICE_NAMER_slash_Other_10_gml_39_0": "CATTY",
