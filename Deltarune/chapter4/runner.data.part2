    factor2 += 0.05;
    
    for (i = 0; i < 10; i += 1)
    {
        draw_sprite_ext(IMAGE_LOGO_CENTER, image_index, (x + (w / 2)) - (sin((siner / 8) + (i / 2)) * (i * factor2)), (y + (h / 2)) - (cos((siner / 8) + (i / 2)) * (i * factor2)), image_xscale, image_yscale, 0, c_white, mina * AA);
