if (state == 3)
{
    scr_enemyhurt_tired_after_damage(0.5);
    hurttimer -= 1;
    
    if (hurttimer < 0)
    {
        state = 0;
    }
    else
    {
        if (global.monster[myself] == 0)
        {
            defeatanim = instance_create(x, y, obj_launchanim);
