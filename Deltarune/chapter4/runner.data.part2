if (charcon == 1)
{
    drawchar = 1;
    bpy = 60;
    tpy = 80;
    
    if (global.interact == 5)
    {
        if (tp < (tpy - 1))
        {
            if ((tpy - tp) <= 40)
                tp += round((tpy - tp) / 2.5);
            else
                tp += 30;
        }
        else
        {
            tp = tpy;
        }
    }
    
    if (bp < (bpy - 1) && charcon == 1)
    {
        if ((bpy - bp) <= 40)
            bp += round((bpy - bp) / 2.5);
        else
            bp += 30;
    }
    else
    {
        bp = bpy;
    }
}

if (charcon == 0)
{
    if (tp > 0)
    {
        if (tp >= 80)
            tp -= round(tp / 2.5);
        else
            tp -= 30;
    }
    else
    {
        tp = 0;
    }
    
    if (bp > 0)
    {
        if (bp >= 40)
            bp -= round(bp / 2.5);
        else
            bp -= 30;
    }
    else
    {
        bp = 0;
    }
    
    if (bp == 0)
        drawchar = 0;
}

